## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
.env
.env.*
!.env.example
cloudflared.env
cloudflared.env.*
.state/
/build-*.tar.gz
/build-*.zip
/nightly_build.zip

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# Binary payloads are published out-of-band; never commit generated binaries.
*.bin
*.exe

# Source design packages are unpacked into /docker/chummercomplete/_work before implementation.
chummer6_gm_magicfit_session_video_foundry_design_20260531.zip

# Visual Studio 2015 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml

# Build Results of an ATL Project
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c


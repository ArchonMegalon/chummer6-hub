<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TestTfmsInParallel>false</TestTfmsInParallel>
    <RestorePackagesWithLockFile Condition="'$(ChummerUseLocalCompatibilityTree)' != 'true'">true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ChummerUseLocalCompatibilityTree)' != 'true' and '$(RestoreLockedMode)' == ''">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chummer.Run.Api\Chummer.Run.Api.csproj" />
    <ProjectReference Include="..\Chummer.Campaign.Contracts\Chummer.Campaign.Contracts.csproj" />
    <ProjectReference Include="..\Chummer.Control.Contracts\Chummer.Control.Contracts.csproj" />
    <ProjectReference Include="..\Chummer.Play.Contracts\Chummer.Play.Contracts.csproj" />
    <ProjectReference Include="..\Chummer.Run.Contracts\Chummer.Run.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(ChummerUseLocalCompatibilityTree)' == 'true'">
    <ProjectReference Include="$(ChummerHubRegistryRoot)/Chummer.Hub.Registry.Contracts/Chummer.Hub.Registry.Contracts.csproj" />
    <ProjectReference Include="$(ChummerHubRegistryRoot)/Chummer.Run.Registry/Chummer.Run.Registry.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(ChummerUseLocalCompatibilityTree)' != 'true'">
    <PackageReference Include="Chummer.Hub.Registry.Contracts" Version="$(ChummerHubRegistryContractsPackageVersion)" />
    <PackageReference Include="Chummer.Run.Registry" Version="$(ChummerRunRegistryPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="ReleaseBuildProvenanceValidatorTests.cs" />
    <Compile Include="..\Chummer.Tests\RepoPaths.cs" Link="RepoPaths.cs" />
    <Compile Include="..\Chummer.Tests\BlackLedgerFactionOnboardingTests.cs" Link="BlackLedgerFactionOnboardingTests.cs" />
    <Compile Include="..\Chummer.Tests\BlackLedgerTickNewsTests.cs" Link="BlackLedgerTickNewsTests.cs" />
    <Compile Include="..\Chummer.Tests\CampaignCollaborationServiceTests.cs" Link="CampaignCollaborationServiceTests.cs" />
    <Compile Include="..\Chummer.Tests\PublicProjectionSnapshotServiceTests.cs" Link="PublicProjectionSnapshotServiceTests.cs" />
    <Compile Include="..\Chummer.Tests\PublicProjectionProofRequestPathPolicyTests.cs" Link="PublicProjectionProofRequestPathPolicyTests.cs" />
    <Compile Include="..\Chummer.Tests\ReleaseUploadAuthorityHandoffCompatibilityTests.cs" Link="ReleaseUploadAuthorityHandoffCompatibilityTests.cs" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition="'$(RunBrowserSurfaceProxyTimeoutTestsOnly)' == 'true'">net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(RunIdentityTestsOnly)' == 'true'">net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(RunBrowserSurfaceProxyTimeoutTestsOnly)' != 'true' and '$(RunIdentityTestsOnly)' != 'true'">net10.0;net10.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TestTfmsInParallel>false</TestTfmsInParallel>
    <RunBrowserSurfaceProxyTimeoutTestsOnly Condition="'$(RunBrowserSurfaceProxyTimeoutTestsOnly)' == ''">false</RunBrowserSurfaceProxyTimeoutTestsOnly>
    <RunIdentityTestsOnly Condition="'$(RunIdentityTestsOnly)' == ''">false</RunIdentityTestsOnly>
    <EnableDefaultCompileItems Condition="'$(RunBrowserSurfaceProxyTimeoutTestsOnly)' == 'true' or '$(RunIdentityTestsOnly)' == 'true'">false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.abstractions" Version="2.0.3" GeneratePathProperty="true" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(RunBrowserSurfaceProxyTimeoutTestsOnly)' != 'true' and '$(RunIdentityTestsOnly)' != 'true'">
    <Reference Include="Chummer.Media.Contracts">
      <HintPath>$(ChummerMediaFactoryRoot)\src\Chummer.Media.Contracts\bin\$(Configuration)\net10.0\Chummer.Media.Contracts.dll</HintPath>
    </Reference>
    <Reference Include="Chummer.Media.Factory.Runtime">
      <HintPath>$(ChummerMediaFactoryRoot)\src\Chummer.Media.Factory.Runtime\bin\$(Configuration)\net10.0\Chummer.Media.Factory.Runtime.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(Pkgxunit_abstractions)\lib\netstandard2.0\xunit.abstractions.dll"
             Condition="Exists('$(Pkgxunit_abstractions)\lib\netstandard2.0\xunit.abstractions.dll')"
             Link="xunit.abstractions.dll"
             CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\campaign_operability_score_two_evidence.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\campaign_operability_candidate_evidence.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\campaign_operability_cell_inventory.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(RunBrowserSurfaceProxyTimeoutTestsOnly)' == 'true'">
    <Compile Include="LegacySurfaceRedirectControllerTests.cs" />
    <Compile Include="HubApiRequestGuardrailMiddlewareTests.cs" />
    <Compile Include="HubApiGuardrailPolicyTests.cs" />
    <Compile Include="PublicPlayProxyGatewayTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RunIdentityTestsOnly)' == 'true'">
    <Compile Include="IdentitySubjectErasureTests.cs" />
    <Compile Include="IdentityAdminRouteAuthorizationTests.cs" />
    <Compile Include="IdentityEmailWebhookAuthorizationTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RunBrowserSurfaceProxyTimeoutTestsOnly)' != 'true' and '$(RunIdentityTestsOnly)' != 'true'">
    <ProjectReference Include="..\Chummer.Run.Api\Chummer.Run.Api.csproj" />
    <ProjectReference Include="..\Chummer.Run.AI\Chummer.Run.AI.csproj" />
    <ProjectReference Include="..\Chummer.Run.Identity\Chummer.Run.Identity.csproj" />
    <ProjectReference Include="..\Chummer.Campaign.Contracts\Chummer.Campaign.Contracts.csproj" />
    <ProjectReference Include="..\Chummer.Control.Contracts\Chummer.Control.Contracts.csproj" />
    <ProjectReference Include="..\Chummer.Play.Contracts\Chummer.Play.Contracts.csproj" />
    <ProjectReference Include="..\Chummer.Run.Contracts\Chummer.Run.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(RunIdentityTestsOnly)' == 'true'">
    <ProjectReference Include="..\Chummer.Run.Identity\Chummer.Run.Identity.csproj" />
    <ProjectReference Include="..\Chummer.Run.Contracts\Chummer.Run.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(RunBrowserSurfaceProxyTimeoutTestsOnly)' != 'true' and '$(RunIdentityTestsOnly)' != 'true' and '$(ChummerUseLocalCompatibilityTree)' == 'true'">
    <ProjectReference Include="$(ChummerHubRegistryRoot)/Chummer.Hub.Registry.Contracts/Chummer.Hub.Registry.Contracts.csproj" />
    <ProjectReference Include="$(ChummerHubRegistryRoot)/Chummer.Run.Registry/Chummer.Run.Registry.csproj" />
    <ProjectReference Include="$(ChummerMediaFactoryRoot)/src/Chummer.Media.Factory.Runtime/Chummer.Media.Factory.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(RunBrowserSurfaceProxyTimeoutTestsOnly)' != 'true' and '$(RunIdentityTestsOnly)' != 'true' and '$(ChummerUseLocalCompatibilityTree)' != 'true'">
    <PackageReference Include="Chummer.Hub.Registry.Contracts" Version="$(ChummerHubRegistryContractsPackageVersion)" />
    <PackageReference Include="Chummer.Run.Registry" Version="$(ChummerRunRegistryPackageVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(RunBrowserSurfaceProxyTimeoutTestsOnly)' == 'true'">
    <ProjectReference Include="..\Chummer.Run.Api\Chummer.Run.Api.csproj"
                      AdditionalProperties="RunBrowserSurfaceProxyTimeoutApiOnly=true" />
  </ItemGroup>

</Project>

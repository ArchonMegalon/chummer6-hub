<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="locked-chummer" value="/opt/chummer-package-feed" />
    <add key="locked-core-runtime" value="/opt/chummer-core-runtime-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="locked-chummer">
      <package pattern="Chummer.Hub.Registry.Contracts" />
      <package pattern="Chummer.Play.Contracts" />
      <package pattern="Chummer.Run.Contracts" />
      <package pattern="Chummer.Run.Registry" />
    </packageSource>
    <packageSource key="locked-core-runtime">
      <package pattern="Chummer.Engine.Contracts" />
      <package pattern="Chummer.Application" />
      <package pattern="Chummer.Rulesets.Hosting" />
      <package pattern="Chummer.Rulesets.Sr5" />
      <package pattern="Chummer.Rulesets.Sr6" />
      <package pattern="Chummer.Infrastructure" />
      <package pattern="Chummer.Rulesets.Sr4" />
      <package pattern="Chummer.Engine.GmCharacterEdits" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

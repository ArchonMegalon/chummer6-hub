@model LandingPageViewModel
@{
    ViewData["Title"] = "Chummer — Shadowrun Campaign OS";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-landing";
    var ledgerHref = "/ledger";
    var buildHref = "/downloads";
    var playHref = "/play";
    var statusHref = "/status";
    var replayTurnOneHref = "/ledger/map?replay=turn-1";
    var ledgerStats = (Model.BlackLedgerStats ?? Array.Empty<BlackLedgerPublicStatViewModel>()).Take(3).ToArray();
    var ledgerWorld = Model.BlackLedgerWorld;
    var factions = (ledgerWorld?.Factions ?? Array.Empty<BlackLedgerFactionViewModel>()).Take(6).ToArray();
    var latestDispatch = Model.LatestBlackLedgerDispatch;
    var newsreelStatus = latestDispatch is null ? "pending" : "sent";
    Func<string, string> factionSlug = id => id.Replace('_', '-');
    Func<string, string> logoHref = id => $"/media/ledger/factions/{factionSlug(id)}-logo.svg";
    Func<string, string> backgroundHref = id => $"/media/ledger/factions/{factionSlug(id)}-bg.svg";
}

<section class="launch-hero launch-hero--pregold" data-homepage-section="hero">
    <div class="launch-hero__shell">
        <div class="launch-hero__copy">
            <p class="eyebrow">Black Ledger front door</p>
            <h1 class="launch-hero__title">The city is moving.</h1>
            <p class="launch-hero__support">Join a faction, watch pressure shift, and carry your runners into the Black Ledger.</p>
            <div class="launch-hero__actions">
                <a class="button-like button-like--primary" href="@ledgerHref">Enter Black Ledger</a>
                <a class="button-like button-like--secondary" href="@buildHref">Download Chummer</a>
            </div>
            <div class="launch-hero__metric-strip" aria-label="Ledger score strip">
                @foreach (var stat in ledgerStats)
                {
                    <article class="launch-hero__metric">
                        <span>@stat.Title</span>
                        <strong>@stat.Value</strong>
                    </article>
                }
            </div>
            <p class="launch-hero__trustline">Turn 1 newsreel: @newsreelStatus. Fictional public-safe seed only. No private campaign data.</p>
        </div>
        <div class="launch-hero__stage" aria-label="Black Ledger geoscape teaser">
            <div
                class="launch-hero__geoscape"
                data-black-ledger-geoscape-root
                data-variant="teaser"
                data-map-url="/api/v1/ledger/worlds/emerald-sprawl-prelude/map"
                data-delta-url="/api/v1/ledger/worlds/emerald-sprawl-prelude/map/tick-delta/0/1"
                data-auto-replay="true"></div>
        </div>
    </div>
</section>
<script type="module" src="~/js/black-ledger-geoscape.js" asp-append-version="true"></script>

<section class="workflow-band workflow-band--flagship workflow-band--compact" data-homepage-section="score-strip" id="score-strip">
    <div class="workflow-band__lead">
        <p class="eyebrow">Pressure strip</p>
        <h2 class="editorial-title">Three signals, one moving city.</h2>
    </div>
    <div class="ledger-stats-grid ledger-stats-grid--hero">
        @foreach (var stat in ledgerStats)
        {
            <article class="ledger-stat-card ledger-stat-card--compact">
                <span>@stat.Title</span>
                <strong>@stat.Value</strong>
                <p>@stat.SourceDetail.ProvenanceSummary</p>
            </article>
        }
    </div>
</section>

<section class="workflow-band workflow-band--flagship workflow-band--compact" data-homepage-section="factions" id="factions">
    <div class="workflow-band__lead">
        <p class="eyebrow">Faction identity</p>
        <h2 class="editorial-title">Six seeded houses are already pushing on the same city.</h2>
        <p class="editorial-copy">Open a file, read the pressure, or replay Turn 1 without touching private table state.</p>
    </div>
    <div class="faction-identity-strip">
        @foreach (var faction in factions)
        {
            <article class="faction-identity-card">
                <div class="faction-identity-card__backdrop" style="background-image:url('@backgroundHref(faction.Id)')"></div>
                <div class="faction-identity-card__body">
                    <img class="faction-identity-card__logo" src="@logoHref(faction.Id)" alt="@($"{faction.PublicName} logo")" loading="lazy" />
                    <div class="faction-identity-card__copy">
                        <span class="tag">@faction.Type</span>
                        <h3>@faction.PublicName</h3>
                        <p>@string.Join(" · ", faction.PublicSignals.Take(2))</p>
                    </div>
                    <a class="editorial-strip__action" href="/ledger/factions/@factionSlug(faction.Id)">Open faction file</a>
                </div>
            </article>
        }
    </div>
</section>

<section class="workflow-band workflow-band--flagship workflow-band--compact" data-homepage-section="play-downloads" id="play-downloads">
    <div class="workflow-band__lead">
        <p class="eyebrow">Play and install</p>
        <h2 class="editorial-title">One compact rail for build, play shell, and public status.</h2>
    </div>
    <div class="flagship-gateway-grid flagship-gateway-grid--compact">
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag">Downloads</span>
                <h3>Desktop build</h3>
            </div>
            <p>Short, practical install shelf for the current build and platform notes.</p>
            <a class="editorial-strip__action" href="@buildHref">Open downloads</a>
        </article>
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag">Play</span>
                <h3>Mobile play shell preview</h3>
            </div>
            <p>Installability proof is explicit and lives on the play shell instead of being implied by homepage copy.</p>
            <a class="editorial-strip__action" href="@playHref">Open play shell</a>
        </article>
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag">Status</span>
                <h3>Proof and release posture</h3>
            </div>
            <p>Proof, route health, and verification notes stay on Status, not in the hero.</p>
            <a class="editorial-strip__action" href="@statusHref">Open status</a>
        </article>
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag">Replay</span>
                <h3>Turn 1</h3>
            </div>
            <p>Replay the first public tick and watch pressure shifts on the geoscape.</p>
            <a class="editorial-strip__action" href="@replayTurnOneHref">Replay Turn 1</a>
        </article>
    </div>
</section>

<section class="access-band access-band--compact" data-homepage-section="footer" id="footer">
    <div class="access-band__copy">
        <p class="eyebrow">Keep it simple</p>
        <h2 class="editorial-title">Ledger for the city. Downloads for the build. Play for the shell. Status for proof.</h2>
        <p class="editorial-copy">Help, privacy, and feedback stay available without turning the homepage into a repo tour.</p>
    </div>
    <div class="access-band__actions">
        <a class="button-like button-like--primary" href="/help">Open help</a>
        <p class="muted-copy"><a class="inline-link" href="/status">Status</a> · <a class="inline-link" href="/feedback">Feedback</a> · <a class="inline-link" href="/privacy">Privacy</a> · <a class="inline-link" href="/roadmap">Roadmap</a></p>
    </div>
</section>

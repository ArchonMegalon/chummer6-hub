@model LandingPageViewModel
@{
    ViewData["Title"] = "Chummer";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-landing";
    var hero = Model.Assets.BySlot("section_hero");
    var proofAsset = Model.Assets.BySlot("product_proof_ui") ?? Model.Assets.BySlot("capability_check_rules");
    var proofNotes = Model.Workflows.Take(3).ToArray();
    var heroProofTrail = Model.Surface.ProductProofTrail.Take(4).ToArray();
    var release = Model.ReleaseExperience;
    var sectionsById = Model.Surface.Sections.ToDictionary(static section => section.Id, StringComparer.OrdinalIgnoreCase);
    var heroSection = Section("hero");
    var productProofSection = Section("product_proof");
    var startHereSection = Section("start_here");
    var trustSection = Section("why_trust_it");
    var laneSection = Section("choose_your_lane");
    var worksNowSection = Section("whats_real_now");
    var artifactSection = Section("featured_artifacts");
    var closingSection = Section("closing_cta");
    var workflowFollowOns = Model.Workflows.Skip(3).ToArray();

    static IReadOnlyList<string> MicroProof(PublicFeatureCardDto card)
        => string.IsNullOrWhiteSpace(card.MicroProof)
            ? Array.Empty<string>()
            : card.MicroProof.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    PublicLandingSectionDto Section(string id)
        => sectionsById.TryGetValue(id, out var section)
            ? section
            : throw new InvalidOperationException($"Landing section '{id}' is required.");
}

<section class="launch-hero">
    <div class="launch-hero__shell">
        <div class="launch-hero__copy">
            <p class="eyebrow">@heroSection.Eyebrow</p>
            <h1 class="launch-hero__title">@Model.Surface.Headline</h1>
            <p class="launch-hero__support">@Model.Surface.Subhead</p>
            <div class="launch-hero__actions">
                <a class="button-like button-like--primary" href="@Model.PrimaryHeroAction.Href">@Model.PrimaryHeroAction.Label</a>
                <a class="button-like button-like--secondary" href="@Model.SecondaryHeroAction.Href">@Model.SecondaryHeroAction.Label</a>
            </div>
            <div class="proof-chip-row" aria-label="Trust anchors">
                @foreach (var chip in Model.Surface.SecondaryHighlights)
                {
                    <span class="proof-chip">@chip</span>
                }
            </div>
            <p class="launch-hero__trustline">@Model.Surface.ProofLine</p>
        </div>
        @if (hero is not null)
        {
            <div class="launch-hero__media">
                @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", hero)
                <div class="launch-hero__prooffloat" aria-label="Current preview proof">
                    <div class="launch-hero__proof-topline">
                        <span>Current preview</span>
                        <span>@release.Display.ChannelLabel · @release.Display.BuildLabel</span>
                    </div>
                    <div class="launch-hero__proof-summary">
                        <strong>@Model.Surface.ProductProofResultTitle</strong>
                        <p>@Model.Surface.ProductProofResultSummary</p>
                    </div>
                    <div class="launch-hero__proof-trail">
                        @foreach (var step in heroProofTrail)
                        {
                            <span>@step</span>
                        }
                    </div>
                    @if (proofAsset is not null)
                    {
                        <div class="launch-hero__proof-shot">
                            @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", proofAsset)
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

<section class="product-proof">
    <div class="product-proof__copy">
        <p class="eyebrow">@Model.Surface.ProductProofEyebrow</p>
        <h2 class="editorial-title">@productProofSection.Title</h2>
        <p class="editorial-copy">@productProofSection.Intro</p>
        <div class="proof-surface">
            <div class="proof-surface__topline">
                <span>@Model.Surface.ProductProofToplineLabel</span>
                <span>@release.Display.ChannelLabel · @release.Display.BuildLabel</span>
            </div>
            <div class="proof-surface__result">
                <strong>@Model.Surface.ProductProofResultTitle</strong>
                <p>@Model.Surface.ProductProofResultSummary</p>
            </div>
            <div class="proof-surface__trail">
                @foreach (var step in Model.Surface.ProductProofTrail)
                {
                    <span>@step</span>
                }
            </div>
            <div class="proof-surface__notes">
                @foreach (var workflow in proofNotes)
                {
                    <div>
                        <span class="tag">@workflow.Card.Title</span>
                        <p>@(workflow.Card.ProofNote ?? workflow.Card.Payoff ?? workflow.Card.Summary)</p>
                    </div>
                }
            </div>
        </div>
        <div class="stacked-actions">
            <a class="button-like button-like--primary" href="@Model.Surface.ProductProofPrimaryHref">@Model.Surface.ProductProofPrimaryLabel</a>
            <a class="button-like button-like--secondary" href="@Model.Surface.ProductProofSecondaryHref">@Model.Surface.ProductProofSecondaryLabel</a>
        </div>
    </div>
    @if (proofAsset is not null)
    {
        <div class="product-proof__media">
            @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", proofAsset)
        </div>
    }
</section>

<section class="workflow-band">
    <div class="workflow-band__lead">
        <p class="eyebrow">@startHereSection.Eyebrow</p>
        <h2 class="editorial-title">@startHereSection.Title</h2>
        <p class="editorial-copy">@startHereSection.Intro</p>
    </div>
    <div class="workflow-grid">
        @foreach (var card in workflowFollowOns)
        {
            <article class="workflow-card">
                @if (card.Asset is not null)
                {
                    <div class="workflow-card__media">
                        @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", card.Asset)
                    </div>
                }
                <div class="workflow-card__copy">
                    <span class="tag">@card.Card.Badge</span>
                    <h3>@card.Card.Title</h3>
                    <p>@card.Card.Summary</p>
                    <ul class="workflow-card__points">
                        @if (!string.IsNullOrWhiteSpace(card.Card.Pain))
                        {
                            <li>@card.Card.Pain</li>
                        }
                        @if (!string.IsNullOrWhiteSpace(card.Card.Payoff))
                        {
                            <li>@card.Card.Payoff</li>
                        }
                    </ul>
                    @if (!string.IsNullOrWhiteSpace(card.Card.ProofNote))
                    {
                        <p class="workflow-card__proof">@card.Card.ProofNote</p>
                    }
                    <a class="inline-link" href="@card.Action.Href">@card.Action.Label</a>
                </div>
            </article>
        }
    </div>
</section>

<section class="trust-claims">
    <div class="trust-claims__lead">
        <p class="eyebrow">@trustSection.Eyebrow</p>
        <h2 class="editorial-title">@trustSection.Title</h2>
        <p class="editorial-copy">@trustSection.Intro</p>
    </div>
    <div class="trust-claims__grid">
        @foreach (var card in Model.TrustPillars)
        {
            <article class="trust-claim">
                <span class="tag">@card.Badge</span>
                <h3>@card.Title</h3>
                <p>@card.Summary</p>
                <div class="trust-claim__microproof">
                    @foreach (var item in MicroProof(card))
                    {
                        <span>@item</span>
                    }
                </div>
            </article>
        }
    </div>
</section>

<section class="audience-fit">
    <div class="audience-fit__lead">
        <p class="eyebrow">@laneSection.Eyebrow</p>
        <h2 class="editorial-title">@laneSection.Title</h2>
        <p class="editorial-copy">@laneSection.Intro</p>
    </div>
    <div class="audience-fit__grid">
        @foreach (var card in Model.Lanes)
        {
            <article class="audience-card">
                @if (card.Asset is not null)
                {
                    <div class="audience-card__media">
                        @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", card.Asset)
                    </div>
                }
                <div class="audience-card__copy">
                    <span class="tag tag--amber">@card.Card.Badge</span>
                    <h3>@card.Card.Title</h3>
                    <p>@card.Card.Summary</p>
                    <a class="inline-link" href="@card.Action.Href">@card.Action.Label</a>
                </div>
            </article>
        }
    </div>
</section>

<section class="works-matrix">
    <div class="works-matrix__lead">
        <p class="eyebrow">@worksNowSection.Eyebrow</p>
        <h2 class="editorial-title">@worksNowSection.Title</h2>
        <p class="editorial-copy">@worksNowSection.Intro</p>
    </div>
    <div class="works-matrix__columns">
        <article class="works-column">
            <div class="works-column__header">
                <span class="tag">Available today</span>
                <h3>Available today</h3>
            </div>
            <div class="works-column__list">
                @foreach (var card in Model.AvailableToday)
                {
                    <article class="works-item" id="@card.Card.Id.Replace('_', '-')">
                        <h4>@card.Card.Title</h4>
                        <p>@card.Card.Summary</p>
                        <a class="inline-link" href="@card.Action.Href">@card.Action.Label</a>
                    </article>
                }
            </div>
        </article>
        <article class="works-column">
            <div class="works-column__header">
                <span class="tag tag--amber">Preview</span>
                <h3>Preview</h3>
            </div>
            <div class="works-column__list">
                @foreach (var card in Model.PreviewItems)
                {
                    <article class="works-item" id="@card.Card.Id.Replace('_', '-')">
                        <h4>@card.Card.Title</h4>
                        <p>@card.Card.Summary</p>
                        <a class="inline-link" href="@card.Action.Href">@card.Action.Label</a>
                    </article>
                }
            </div>
        </article>
        <article class="works-column">
            <div class="works-column__header">
                <span class="tag tag--quiet">Coming next</span>
                <h3>Coming next</h3>
            </div>
            <div class="works-column__list">
                @foreach (var card in Model.ComingNext)
                {
                    <article class="works-item" id="@card.Card.Id.Replace('_', '-')">
                        <h4>@card.Card.Title</h4>
                        <p>@card.Card.Summary</p>
                        <a class="inline-link" href="@card.Action.Href">@card.Action.Label</a>
                    </article>
                }
            </div>
        </article>
    </div>
</section>

<section class="artifact-gallery">
    <div class="artifact-gallery__lead">
        <p class="eyebrow">@artifactSection.Eyebrow</p>
        <h2 class="editorial-title">@artifactSection.Title</h2>
        <p class="editorial-copy">@artifactSection.Intro</p>
    </div>
    <div class="artifact-gallery__grid">
        @foreach (var card in Model.Artifacts)
        {
            <article class="artifact-card">
                @if (card.Asset is not null)
                {
                    <div class="artifact-card__media">
                        @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", card.Asset)
                    </div>
                }
                <div class="artifact-card__copy">
                    <span class="tag @(string.Equals(card.Card.Badge, "Available today", StringComparison.OrdinalIgnoreCase) ? string.Empty : "tag--quiet")">@card.Card.Badge</span>
                    <h3>@card.Card.Title</h3>
                    <p>@card.Card.Summary</p>
                    <a class="inline-link" href="@card.Action.Href">@card.Action.Label</a>
                </div>
            </article>
        }
    </div>
</section>

<section class="access-band">
    <div class="access-band__copy">
        <p class="eyebrow">@closingSection.Eyebrow</p>
        <h2 class="editorial-title">@closingSection.Title</h2>
        <p class="editorial-copy">@closingSection.Intro</p>
        <div class="interest-grid" aria-label="Interest options">
            <span class="interest-pill">I’m here for play</span>
            <span class="interest-pill">I want GM tools</span>
            <span class="interest-pill">I want creator tools</span>
            <span class="interest-pill">Send me roadmap updates</span>
            <span class="interest-pill">Consider me for beta access</span>
        </div>
    </div>
    <div class="access-band__actions">
        @if (Model.Chrome.Authenticated)
        {
            <a class="button-like button-like--primary" href="/home">Open home</a>
            <p class="muted-copy">Your setup, updates, and access state already live in the signed-in product.</p>
        }
        else
        {
            <a class="button-like button-like--primary" href="/signup?next=/home">Create account</a>
            <p class="muted-copy">Already have one? <a class="inline-link" href="/login?next=/home">Sign in</a></p>
        }
    </div>
</section>

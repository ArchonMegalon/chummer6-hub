@model LandingPageViewModel
@{
    ViewData["Title"] = "Chummer — Shadowrun character manager";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-landing surface-minimal";
    var publicPlatformLabels = Model.ReleaseExperience.PlatformAvailability
        .Where(static platform => platform.PubliclyAvailable)
        .Select(static platform => platform.PlatformLabel)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToArray();
    var publicPlatformSummary = publicPlatformLabels.Length switch
    {
        0 => "No public installer right now.",
        1 => $"Current public installer: {publicPlatformLabels[0]}.",
        2 => $"Current public installers: {publicPlatformLabels[0]} and {publicPlatformLabels[1]}.",
        _ => $"Current public installers: {string.Join(", ", publicPlatformLabels.Take(publicPlatformLabels.Length - 1))}, and {publicPlatformLabels[^1]}."
    };
    var entryHref = Model.Chrome.Authenticated ? "/account" : "/login?next=%2Faccount%2Faccess";
    var entryLabel = Model.Chrome.Authenticated ? "Account" : "Sign in first";
}

<section class="minimal-hero" data-homepage-section="hero">
    <div class="minimal-hero__copy">
        <h1>Chummer</h1>
        <p class="minimal-hero__lead">A Shadowrun character manager for clean sheets and faster tables.</p>
        <div class="minimal-actions" aria-label="Main actions">
            <a class="button-like button-like--primary" href="/downloads" title="Download Chummer" aria-label="Download Chummer" data-analytics-event="homepage_open_downloads" data-analytics-surface="minimal_home" data-analytics-label="Download Chummer">Download Chummer</a>
            <a class="button-like button-like--secondary" href="/media/promo/every-wonder-horizon-promo.mp4" data-analytics-event="homepage_open_promo_video" data-analytics-surface="minimal_home" data-analytics-label="Watch 90 sec">Watch 90 sec</a>
            <details class="site-account-menu site-open-chummer-menu minimal-open-chummer">
                <summary class="site-account-menu__summary">
                    <span class="site-account-menu__label">Open Chummer</span>
                </summary>
                <div class="site-account-menu__panel" aria-label="Open Chummer options">
                    @if (Model.Chrome.Authenticated)
                    {
                        <a class="site-account-menu__link site-open-chummer-menu__button" href="/build" data-analytics-event="homepage_open_build" data-analytics-surface="minimal_home" data-analytics-label="Build">Build</a>
                        <a class="site-account-menu__link site-open-chummer-menu__button" href="/mobile/player" data-analytics-event="homepage_open_play" data-analytics-surface="minimal_home" data-analytics-label="Play">Play</a>
                    }
                    else
                    {
                        <button class="site-account-menu__button site-open-chummer-menu__button site-open-chummer-menu__button--disabled" type="button" disabled aria-disabled="true" data-analytics-surface="minimal_home" data-analytics-label="Build">Build</button>
                        <a class="site-account-menu__link site-open-chummer-menu__button" href="/mobile/player" data-analytics-event="homepage_open_play" data-analytics-surface="minimal_home" data-analytics-label="Play">Play</a>
                    }
                    <a class="site-account-menu__link" href="@entryHref" data-analytics-event="homepage_open_account" data-analytics-surface="minimal_home" data-analytics-label="@entryLabel">@entryLabel</a>
                </div>
            </details>
        </div>
        <p class="minimal-meta">@publicPlatformSummary</p>
        <p class="minimal-inline-links">
            <a href="@entryHref" data-analytics-event="homepage_open_account" data-analytics-surface="minimal_home" data-analytics-label="@entryLabel">@entryLabel</a>
            <a href="/help" data-analytics-event="homepage_open_help" data-analytics-surface="minimal_home" data-analytics-label="Help">Help</a>
            @if (Model.Chrome.Authenticated)
            {
                <a href="/participate" data-analytics-event="homepage_open_participate" data-analytics-surface="minimal_home" data-analytics-label="Participate">Participate</a>
            }
        </p>
        <div class="minimal-runner-rail" aria-label="Example runner starts">
            <a href="/account/open/example/decker" data-analytics-event="homepage_open_example_runner" data-analytics-surface="minimal_home" data-analytics-label="Kestrel">
                <span>Kestrel</span>
                <small>Decker start</small>
            </a>
            <a href="/account/open/example/street-samurai" data-analytics-event="homepage_open_example_runner" data-analytics-surface="minimal_home" data-analytics-label="Brick">
                <span>Brick</span>
                <small>Street samurai</small>
            </a>
            <a href="/account/open/example/face" data-analytics-event="homepage_open_example_runner" data-analytics-surface="minimal_home" data-analytics-label="Whisper">
                <span>Whisper</span>
                <small>Face start</small>
            </a>
        </div>
    </div>
    <a class="minimal-hero__visual minimal-hero__visual--screenshot" href="/media/promo/every-wonder-horizon-promo.mp4" aria-label="Watch the Chummer table preview" data-analytics-event="homepage_open_promo_video" data-analytics-surface="minimal_home" data-analytics-label="Preview card">
        <img src="/media/product/chummer-desktop-runner.png" alt="Chummer desktop character sheet" loading="eager" />
        <span class="minimal-hero__visual-badge">Watch 90 sec</span>
    </a>
</section>

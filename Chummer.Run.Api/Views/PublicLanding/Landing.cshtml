@model LandingPageViewModel
@{
    ViewData["Title"] = "Chummer";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-landing";
    var hero = Model.Assets.BySlot("section_hero");
}

<section class="landing-film">
    @if (hero is not null)
    {
        <div class="landing-film__media">
            @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", hero)
        </div>
    }
    <div class="landing-film__content">
        <h1 class="landing-film__brand">CHUMMER</h1>
        <p class="landing-film__headline">@Model.Surface.Headline</p>
        <p class="landing-film__support">@Model.Surface.Subhead</p>
        <div class="landing-film__actions">
            @foreach (var action in Model.Surface.HeroCtas)
            {
                var href = action.Href;
                var label = action.Label;
                if (Model.Chrome.Authenticated && string.Equals(action.Href, "/signup?next=/home", StringComparison.OrdinalIgnoreCase))
                {
                    href = "/home";
                    label = "Open home";
                }
                else if (Model.Chrome.Authenticated && string.Equals(action.Href, "/login?next=/home", StringComparison.OrdinalIgnoreCase))
                {
                    href = "/account";
                    label = "Open account";
                }

                <a class="cta-link cta-link--@(action.Emphasis == "secondary" ? "secondary" : "primary")" href="@href">@label</a>
            }
        </div>
    </div>
</section>

<section class="editorial-block editorial-block--strips">
    <div class="editorial-block__lead">
        <p class="eyebrow">Start here</p>
        <h2 class="editorial-title">Three clean ways into Chummer</h2>
        <p class="editorial-copy">Start with the product story, the current state, or the build you can download today.</p>
    </div>
    <div class="editorial-strip-list">
        @foreach (var card in Model.StartHere)
        {
            var asset = Model.Assets.ForCard(card);
            <article class="editorial-strip">
                @if (asset is not null)
                {
                    <div class="editorial-strip__media">
                        @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", asset)
                    </div>
                }
                <div class="editorial-strip__copy">
                    <span class="tag">@card.Badge</span>
                    <h3>@card.Title</h3>
                    <p>@card.Summary</p>
                </div>
                <a class="editorial-strip__action" href="@card.Href">Open</a>
            </article>
        }
    </div>
</section>

<section class="proof-band">
    <div class="proof-band__lead">
        <p class="eyebrow">Why trust it</p>
        <h2 class="editorial-title">Why trust Chummer</h2>
    </div>
    <div class="proof-band__grid">
        @foreach (var card in Model.TrustPillars)
        {
            <article class="proof-statement">
                <span class="tag">@card.Badge</span>
                <h3>@card.Title</h3>
                <p>@card.Summary</p>
            </article>
        }
    </div>
</section>

<section class="editorial-block editorial-block--lanes">
    <div class="editorial-block__lead">
        <p class="eyebrow">Choose your lane</p>
        <h2 class="editorial-title">Player, GM, or creator</h2>
        <p class="editorial-copy">Choose the role that matches the way you use the game.</p>
    </div>
    <div class="lane-strip-list">
        @foreach (var card in Model.Lanes)
        {
            var asset = Model.Assets.ForCard(card);
            <article class="lane-strip">
                <div class="lane-strip__copy">
                    <span class="tag tag--amber">@card.Badge</span>
                    <h3>@card.Title</h3>
                    <p>@card.Summary</p>
                    <a class="editorial-strip__action" href="@card.Href">See the lane</a>
                </div>
                @if (asset is not null)
                {
                    <div class="lane-strip__media">
                        @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", asset)
                    </div>
                }
            </article>
        }
    </div>
</section>

<section class="landing-closing-band">
    <div>
        <p class="eyebrow">Follow what opens next</p>
        <h2 class="editorial-title">Keep your place as more opens up</h2>
        <p class="editorial-copy">An account keeps your follows, settings, and contribution access together.</p>
    </div>
    <div class="landing-closing-band__actions">
        @if (Model.Chrome.Authenticated)
        {
            <a class="cta-link cta-link--primary" href="/home">Open home</a>
            <a class="cta-link cta-link--secondary" href="/account">Open account</a>
        }
        else
        {
            <a class="cta-link cta-link--primary" href="/signup?next=/home">Create account</a>
            <a class="cta-link cta-link--secondary" href="/login?next=/home">Sign in</a>
        }
    </div>
</section>

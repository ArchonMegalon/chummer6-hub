@model LandingPageViewModel
@{
    ViewData["Title"] = "Chummer — Shadowrun Campaign OS";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-landing";
    var heroProofTrail = Model.Surface.ProductProofTrail.Take(2).ToArray();
    var release = Model.ReleaseExperience;
    var guestNeedsInstallGate = !Model.Chrome.Authenticated && release.Recommended?.RequiresAccount == true;
    var guestReadableHeroPrimaryHref = Model.PrimaryHeroAction.Href;
    var accountAwareInstallPrimaryHref = guestNeedsInstallGate
        ? release.GuestGatePrimaryHref ?? guestReadableHeroPrimaryHref
        : guestReadableHeroPrimaryHref;
    var installRailPrimaryLabel = Model.Chrome.Authenticated
        ? "Open home"
        : guestNeedsInstallGate
            ? release.GuestGatePrimaryLabel
            : Model.PrimaryHeroAction.Label;
    var installRailPrimaryHref = Model.Chrome.Authenticated ? "/home" : accountAwareInstallPrimaryHref;
    var installRailSecondaryLabel = Model.Chrome.Authenticated ? "Open devices and access" : "Already have an account? Sign in";
    var installRailSecondaryHref = Model.Chrome.Authenticated ? "/account/access" : "/login?next=/home";
    var enterHubHref = Model.Chrome.Authenticated ? "/home" : "/login?next=/home";
    var enterHubLabel = "Enter the hub";
    var forgeHref = "/karma-forge";
    var ledgerHref = "/ledger";
    var buildHref = "/downloads";
    var packagesHref = "/packages";
    var heroStatusChips = new[]
    {
        "Preview build live",
        "Rules proof visible",
        "Mobile play preview",
        "Public signal open",
    };
    var pathCards = new[]
    {
        new
        {
            Id = "build",
            Title = "Start with downloads",
            Summary = "Install the current preview build first. That is still the shortest route to a usable runner sheet and explainable math.",
            Status = "Do this first",
            Href = buildHref,
            Action = "Open downloads",
            Pills = new[] { "Current preview", "Desktop client", "Install rail" },
        },
        new
        {
            Id = "hub",
            Title = "Enter the hub",
            Summary = "Use the signed-in hub for installs, account recovery, package follows, and the routes that should stay attached to your account.",
            Status = "Use when continuity matters",
            Href = enterHubHref,
            Action = enterHubLabel,
            Pills = new[] { "Account-aware", "Recovery", "Support context" },
        },
        new
        {
            Id = "forge",
            Title = "Karma Forge",
            Summary = "Use Karma Forge when your problem is rules pain, package demand, or a change request that needs evidence instead of chat noise.",
            Status = "Governed preview",
            Href = forgeHref,
            Action = "Open Karma Forge",
            Pills = new[] { "Signal intake", "Package candidates", "Closeout proof" },
        },
        new
        {
            Id = "ledger",
            Title = "Black Ledger",
            Summary = "Use Black Ledger when you want to know what happened in the world, why package pressure moved, and which dispatch came out of the last world tick.",
            Status = "World lane live",
            Href = ledgerHref,
            Action = "Open Black Ledger",
            Pills = new[] { "Faction pressure", "Dispatches", "Debt heat" },
        },
    };
    var ledgerStats = (Model.BlackLedgerStats ?? Array.Empty<BlackLedgerPublicStatViewModel>()).ToArray();
    var ledgerWorld = Model.BlackLedgerWorld;
    var latestDispatch = Model.LatestBlackLedgerDispatch;
    var previewHighlights = new[]
    {
        new { Label = "World tick", Summary = "Every public story starts from a receipt-backed world tick." },
        new { Label = "Dispatch", Summary = "Users can read the public-safe summary instead of decoding raw stats." },
        new { Label = "Package pressure", Summary = "Karma Forge shows where recurring table pain is hardening into governed change demand." },
    };
    var proofCards = new[]
    {
        new
        {
            Title = "Current preview build",
            Value = $"{release.Display.ChannelLabel} · {release.Display.BuildLabel}",
            Summary = "Open the current download rail, install the same build everyone gets, and keep account-aware handoff optional.",
            Href = buildHref,
            Action = "See what works today",
        },
        new
        {
            Title = "Rules explanation trail",
            Value = heroProofTrail.Length > 0 ? heroProofTrail[0] : "Rules proof visible",
            Summary = "The proof trail stays visible, but it no longer owns the first impression ahead of the product itself.",
            Href = "/what-is-chummer",
            Action = "Read the product story",
        },
        new
        {
            Title = "Packages and mobile routes",
            Value = "Route proof shelf live",
            Summary = "Packages, mobile/PWA, and governed follow-up stay on real public routes instead of hidden internal rails.",
            Href = "/status",
            Action = "Open status",
        },
    };
}

<section class="launch-hero" data-homepage-section="hero">
    <div class="launch-hero__shell">
        <div class="launch-hero__copy">
            <p class="eyebrow">Explainable Shadowrun campaign OS</p>
            <h1 class="launch-hero__title">Build the runner. Run the table. Keep the ledger honest.</h1>
            <p class="launch-hero__support">Start with the current build, use the hub when continuity matters, and follow world-state or rules pain only when you actually need them.</p>
            <div class="launch-hero__actions">
                <a class="button-like button-like--primary" href="@buildHref">Open downloads</a>
                <a class="button-like button-like--secondary" href="@enterHubHref">@enterHubLabel</a>
                <a class="button-like button-like--ghost" href="@forgeHref">Explore Karma Forge</a>
            </div>
            <div class="proof-chip-row" aria-label="Flagship status">
                @foreach (var chip in heroStatusChips)
                {
                    <span class="proof-chip">@chip</span>
                }
            </div>
            <div class="hero-installrail" aria-label="Recommended install path">
                <div class="hero-installrail__lead">
                    <span class="tag tag--amber">Recommended path</span>
                    <strong>@(guestNeedsInstallGate ? "Account-aware install handoff" : "Current preview install")</strong>
                    <p>Open the current build, then return to the same hub for packages, mobile play, and governed closeouts.</p>
                </div>
                <div class="hero-installrail__facts">
                    <div class="hero-installrail__fact">
                        <span>Platform</span>
                        <strong>@(release.Recommended?.PlatformLabel ?? "Current preview build")</strong>
                    </div>
                    <div class="hero-installrail__fact">
                        <span>Channel</span>
                        <strong>@release.Display.ChannelLabel</strong>
                    </div>
                    <div class="hero-installrail__fact">
                        <span>Build</span>
                        <strong>@release.Display.BuildLabel</strong>
                    </div>
                    <div class="hero-installrail__fact">
                        <span>First launch</span>
                        <strong>@(guestNeedsInstallGate ? "Signed-in handoff first" : "Use as guest or link this copy later")</strong>
                    </div>
                </div>
                <div class="hero-installrail__actions">
                    <a class="button-like button-like--primary" href="@installRailPrimaryHref">@installRailPrimaryLabel</a>
                    <a class="button-like button-like--ghost" href="@installRailSecondaryHref">@installRailSecondaryLabel</a>
                </div>
            </div>
            <p class="launch-hero__trustline">Votes show demand. Proof decides what ships.</p>
        </div>
        <div class="launch-hero__stage" aria-label="Black Ledger gate">
            <figure class="launch-hero__scene">
                <img class="launch-hero__scene-image" src="~/media/campaign/hero-shadowrun-assistant-nightdesk.webp" alt="Shadowrun campaign desk showing Chummer as a session operating surface." />
            </figure>
            <div class="launch-hero__prooffloat">
                <div class="launch-hero__proof-topline">
                    <span>What users need to know first</span>
                    <span>@release.Display.ChannelLabel · @release.Display.BuildLabel</span>
                </div>
                <div class="launch-hero__proof-summary">
                    <strong>Downloads first. Hub second. Ledger and Forge when you need context.</strong>
                    <p>Chummer is usable today as a build-and-continuity product. Black Ledger and Karma Forge are public-facing world and rules lanes, not required reading before someone installs.</p>
                </div>
                <div class="launch-hero__proof-trail">
                    <span>Current build posted</span>
                    <span>Turn 1 receipt posted</span>
                    <span>Opt-in aggregate only</span>
                </div>
            </div>
            <div class="ledger-console" aria-label="Quick orientation">
                <article class="ledger-console__panel">
                    <span>Install</span>
                    <strong>Open downloads for the current preview build.</strong>
                    <p>That is still the fastest path to a working desktop client.</p>
                </article>
                <article class="ledger-console__panel">
                    <span>World lane</span>
                    <strong>Black Ledger explains what happened in the world and why it matters.</strong>
                    <p>Dispatches turn receipts into readable public-safe summaries.</p>
                </article>
                <article class="ledger-console__panel">
                    <span>Rules lane</span>
                    <strong>Karma Forge turns repeated rules pain into governed package work.</strong>
                    <p>Use it when a table problem needs evidence and follow-through.</p>
                </article>
            </div>
        </div>
    </div>
</section>

<section class="workflow-band workflow-band--flagship" data-homepage-section="choose-your-path" id="choose-your-path">
    <div class="workflow-band__lead">
        <p class="eyebrow">Choose your path</p>
        <h2 class="editorial-title">Open the route that matches the job in front of you.</h2>
        <p class="editorial-copy">Most users need four things: downloads, the account-aware hub, Black Ledger, and Karma Forge.</p>
    </div>
    <div class="flagship-gateway-grid">
        @foreach (var tile in pathCards)
        {
            <article class="gateway-card" id="gateway-@tile.Id">
                <div class="gateway-card__header">
                    <span class="tag">@tile.Status</span>
                    <h3>@tile.Title</h3>
                </div>
                <p>@tile.Summary</p>
                <div class="route-choice-card__proof">
                    @foreach (var pill in tile.Pills)
                    {
                        <span>@pill</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@tile.Href">@tile.Action</a>
            </article>
        }
    </div>
</section>

<section class="flagship-coverage flagship-coverage--public" data-homepage-section="what-works-today" id="what-works-today">
    <div class="flagship-coverage__lead">
        <p class="eyebrow">What works today</p>
        <h2 class="editorial-title">The proof shelf is still visible. It just no longer blocks the front door.</h2>
        <p class="editorial-copy">Use these routes when you want the current build, release posture, or artifact-level detail.</p>
    </div>
    <div class="flagship-coverage__grid">
        @foreach (var card in proofCards)
        {
            <article class="flagship-coverage__card">
                <span class="tag">Today</span>
                <h3>@card.Title</h3>
                <p class="flagship-coverage__phase"><strong>@card.Value</strong></p>
                <p>@card.Summary</p>
                <a class="inline-link" href="@card.Href">@card.Action</a>
            </article>
        }
    </div>
</section>

<section class="product-proof product-proof--ledger" data-homepage-section="preview" id="world-preview">
    <div class="continuity-band__copy">
        <p class="eyebrow">Black Ledger / Karma Forge preview</p>
        <h2 class="editorial-title">Black Ledger tells you what happened. Karma Forge tells you what people keep needing fixed.</h2>
        <p class="editorial-copy">These routes are live, navigable, and useful without forcing every visitor to read operational detail first.</p>
        <p class="muted-copy">@((ledgerWorld?.TurnHeadline) ?? "Turn 1 already ran. The city is moving.")</p>
        <p class="muted-copy">@((ledgerWorld?.SafetyNote) ?? "Seeded preview and opt-in aggregate only. The Ledger explains pressure, not people.")</p>
        <div class="stacked-actions">
            <a class="button-like button-like--primary" href="@ledgerHref">Open Black Ledger</a>
            <a class="button-like button-like--secondary" href="@forgeHref">Open Karma Forge</a>
            <a class="button-like button-like--ghost" href="@packagesHref">Browse packages</a>
        </div>
        @if (latestDispatch is not null)
        {
            <article class="trust-claim">
                <span class="tag">Latest dispatch</span>
                <h3>@latestDispatch.Title</h3>
                <p>@latestDispatch.Summary</p>
                <div class="trust-claim__microproof">
                    <span>Receipt: @latestDispatch.SourceReceiptId</span>
                    <span>Generated from world tick</span>
                    <span>Public-safe only</span>
                </div>
                <a class="inline-link" href="@latestDispatch.Href">Read dispatch</a>
            </article>
        }
    </div>
    <div class="continuity-band__panel">
        @foreach (var highlight in previewHighlights)
        {
            <article class="continuity-band__fact">
                <span>@highlight.Label</span>
                <strong>@highlight.Summary</strong>
            </article>
        }
        @foreach (var stat in ledgerStats.Take(3))
        {
            <article class="continuity-band__fact">
                <span>@stat.Title</span>
                <strong>@stat.Value</strong>
                <p>@stat.PrivacyNote</p>
            </article>
        }
    </div>
</section>

<section class="continuity-band" data-homepage-section="account-value" id="account-value">
    <div class="continuity-band__copy">
        <p class="eyebrow">Account value</p>
        <h2 class="editorial-title">Create an account only when you want continuity, recovery, and tracked follow-through.</h2>
        <p class="editorial-copy">The product should stay readable as a guest. Accounts matter when you want installs, follows, support, and history to stay attached.</p>
        <div class="stacked-actions">
            @if (Model.Chrome.Authenticated)
            {
                <a class="button-like button-like--primary" href="/home">Open home</a>
                <a class="button-like button-like--secondary" href="/account/access">Open devices and access</a>
            }
            else
            {
                <a class="button-like button-like--primary" href="/signup?next=/home">Create account</a>
                <a class="button-like button-like--secondary" href="/login?next=/home">Sign in</a>
            }
        </div>
    </div>
    <div class="continuity-band__panel">
        <article class="continuity-band__fact">
            <span>Claim installs</span>
            <strong>Keep restore and update history attached</strong>
            <p>Useful if the same build needs to follow you across devices or a later support case.</p>
        </article>
        <article class="continuity-band__fact">
            <span>Follow packages</span>
            <strong>See motion without watching every page manually</strong>
            <p>Package and closeout updates become attached to the same account context.</p>
        </article>
        <article class="continuity-band__fact">
            <span>Support</span>
            <strong>Keep problem reports tied to the install context</strong>
            <p>That makes later recovery and closeout proof more useful than an unbound email thread.</p>
        </article>
    </div>
</section>

<section class="access-band" data-homepage-section="trust-footer" id="trust-footer">
    <div class="access-band__copy">
        <p class="eyebrow">Final trust footer</p>
        <h2 class="editorial-title">Take the route that matches your job, then verify the proof behind it.</h2>
        <p class="editorial-copy">Status, privacy, help, and source stay short here instead of fighting the homepage for attention.</p>
    </div>
    <div class="access-band__actions">
        <a class="button-like button-like--primary" href="/status">Open status</a>
        <p class="muted-copy"><a class="inline-link" href="/privacy">Privacy</a> · <a class="inline-link" href="/terms">Terms</a> · <a class="inline-link" href="/help">Help</a> · <a class="inline-link" href="https://github.com/ArchonMegalon/chummer6" rel="noopener noreferrer">GitHub</a></p>
        <p class="muted-copy">Still evaluating? <a class="quiet-link" href="/now">Open what works today</a> or <a class="quiet-link" href="/what-is-chummer">read the product story</a>.</p>
    </div>
</section>

@model LandingPageViewModel
@{
    ViewData["Title"] = "Chummer — Shadowrun character manager";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-landing surface-minimal";
    var publishedLabel = Model.Manifest.PublishedAt.ToUniversalTime().ToString("yyyy-MM-dd");
    var buildLabel = Model.ReleaseExperience.Display.BuildLabel;
}

<section class="minimal-hero" data-homepage-section="hero">
    <div class="minimal-hero__copy">
        <p class="minimal-kicker">For Shadowrun</p>
        <h1>Chummer</h1>
        <p class="minimal-hero__lead">Build and maintain Shadowrun characters without losing the details between sessions.</p>
        <div class="minimal-actions" aria-label="Main downloads">
            <a class="button-like button-like--primary" href="/downloads#stable" data-analytics-event="homepage_open_stable" data-analytics-surface="minimal_home" data-analytics-label="Stable">Stable</a>
            <a class="button-like button-like--secondary" href="/downloads#nightly" data-analytics-event="homepage_open_nightly" data-analytics-surface="minimal_home" data-analytics-label="Nightly">Nightly</a>
        </div>
        <p class="minimal-meta">Windows and Linux. @buildLabel. Released @publishedLabel.</p>
    </div>
    <figure class="minimal-hero__visual minimal-hero__visual--screenshot">
        <img src="/media/product/chummer-desktop-runner.png" alt="Chummer desktop character sheet" loading="eager" decoding="async" />
    </figure>
</section>

<section class="minimal-section" data-homepage-section="workflow">
    <div class="minimal-section__lead">
        <h2>What it does</h2>
    </div>
    <div class="minimal-three">
        <article>
            <h3>Create</h3>
            <p>Start a character, pick the ruleset, and keep the sheet readable while you work.</p>
        </article>
        <article>
            <h3>Update</h3>
            <p>Track gear, qualities, contacts, and advancement as the campaign changes.</p>
        </article>
        <article>
            <h3>Review</h3>
            <p>Review totals, warnings, and changes before the sheet reaches the table.</p>
        </article>
    </div>
</section>

<section class="minimal-section minimal-section--downloads" data-homepage-section="downloads">
    <div class="minimal-section__lead">
        <h2>Get the app</h2>
        <p>Stable for the calmer install. Nightly when you want the newest build.</p>
    </div>
    <div class="minimal-download-strip">
        <a class="minimal-download-strip__item" href="/downloads#stable">
            <span>Stable</span>
            <strong>Install the current stable build</strong>
        </a>
        <a class="minimal-download-strip__item" href="/downloads#nightly">
            <span>Nightly</span>
            <strong>Install the latest published build</strong>
        </a>
        <a class="minimal-download-strip__item" href="/status">
            <span>Status</span>
            <strong>Open the current release status</strong>
        </a>
    </div>
</section>

<section class="minimal-section minimal-section--support" data-homepage-section="help" data-public-section="footer">
    <div class="minimal-section__lead">
        <h2>Help</h2>
        <p>Setup, recovery, and issue reports are in one place.</p>
    </div>
    <div class="minimal-actions">
        <a class="button-like button-like--primary" href="/help" data-analytics-event="homepage_open_help" data-analytics-surface="minimal_home" data-analytics-label="Help">Help</a>
        <a class="button-like button-like--ghost" href="/contact" data-analytics-event="homepage_open_contact" data-analytics-surface="minimal_home" data-analytics-label="Contact">Contact</a>
    </div>
</section>

@model LandingPageViewModel
@{
    ViewData["Title"] = "Chummer — Shadowrun character and campaign companion";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-landing";
    var buildHref = "/downloads";
    var playHref = "/play";
    var statusHref = "/status";
    var nowHref = "/now";
    var starterWorkspace = Model.CampaignSpine?.Workspaces.FirstOrDefault();
    var starterFirstPlayableSession = starterWorkspace?.FirstPlayableSession;
    var starterFirstPlayableSessionHref = starterWorkspace is null
        ? "/home/work"
        : $"/account/work/workspaces/{Uri.EscapeDataString(starterWorkspace.WorkspaceId)}#selected-first-playable-session";
}

<section class="launch-hero launch-hero--product" data-homepage-section="hero">
    <div class="launch-hero__shell">
        <div class="launch-hero__copy">
            <h1 class="launch-hero__title">Build the runner. Run the night.</h1>
            <p class="launch-hero__support">Chummer is a Shadowrun character builder and campaign companion for tables that want less admin and more play.</p>
            <div class="launch-hero__actions">
                <a class="button-like button-like--primary" href="@buildHref" data-analytics-event="homepage_open_downloads" data-analytics-surface="landing_hero" data-analytics-label="Download Chummer">Download Chummer</a>
                <a class="button-like button-like--secondary" href="@nowHref" data-analytics-event="homepage_open_now" data-analytics-surface="landing_hero" data-analytics-label="See what works today">See what works today</a>
            </div>
            <div class="launch-hero__metric-strip" aria-label="Product highlights">
                <article class="launch-hero__metric">
                    <span>Desktop</span>
                    <strong>Windows + Linux</strong>
                </article>
                <article class="launch-hero__metric">
                    <span>Builder</span>
                    <strong>SR4, SR5, SR6</strong>
                </article>
                <article class="launch-hero__metric">
                    <span>Table</span>
                    <strong>Local first</strong>
                </article>
            </div>
        </div>
        <div class="launch-hero__stage" aria-label="Chummer product preview">
            <figure class="launch-hero__render">
                <img src="/media/promo/chummer6-flagship-promo-poster.png" alt="Runner dossier shown on a cinematic desktop setup" loading="eager" decoding="async" />
                <figcaption>
                    <span>Character workbench</span>
                    <strong>Build sheets, check rules, and keep session context in one place.</strong>
                </figcaption>
            </figure>
        </div>
    </div>
</section>

<section class="workflow-band workflow-band--flagship workflow-band--compact" data-homepage-section="product" id="product">
    <div class="workflow-band__lead">
        <h2 class="editorial-title">Everything your table reaches for first.</h2>
    </div>
    <div class="product-image-grid">
        <article class="product-image-card">
            <div class="product-image-card__media">
                <img src="/media/promo/chummer6-flagship-promo-poster.png" alt="" loading="lazy" decoding="async" />
            </div>
            <div class="product-image-card__body">
                <span class="tag">Build</span>
                <h3>Character sheets without spreadsheet anxiety.</h3>
                <p>Create, import, edit, and understand the choices that shape a runner.</p>
            </div>
        </article>
        <article class="product-image-card product-image-card--quiet">
            <div class="product-image-card__body">
                <span class="tag">Explain</span>
                <h3>Rules help that shows its work.</h3>
                <p>Use explanations to understand options before you commit to a build.</p>
            </div>
        </article>
        <article class="product-image-card product-image-card--quiet">
            <div class="product-image-card__body">
                <span class="tag">Run</span>
                <h3>Campaign context close at hand.</h3>
                <p>Keep the character, notes, and table handoff together between sessions.</p>
            </div>
        </article>
    </div>
</section>

<section class="workflow-band workflow-band--flagship workflow-band--compact flagship-promo-band" data-homepage-section="flagship-promo" id="flagship-promo">
    <div class="workflow-band__lead">
        <h2 class="editorial-title">A short look at the product.</h2>
    </div>
    <div class="flagship-promo-player">
        <video
            class="flagship-promo-player__video"
            controls
            preload="metadata"
            poster="/media/promo/chummer6-flagship-promo-poster.png"
            aria-label="Chummer6 flagship product reel">
            <source src="/media/promo/chummer6-flagship-promo.webm" type="video/webm" />
            <source src="/media/promo/chummer6-flagship-promo.mp4" type="video/mp4" />
            <track src="/media/promo/chummer6-flagship-promo.vtt" kind="captions" srclang="en" label="English" default />
        </video>
    </div>
</section>

<section class="workflow-band workflow-band--flagship workflow-band--compact" data-homepage-section="play-downloads" id="play-downloads">
    <div class="workflow-band__lead">
        <h2 class="editorial-title">Start where you need to.</h2>
    </div>
    <div class="flagship-gateway-grid flagship-gateway-grid--compact">
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag">Downloads</span>
                <h3>Desktop build</h3>
            </div>
            <p>Get the latest Windows or Linux build.</p>
            <a class="editorial-strip__action" href="@buildHref" data-analytics-event="homepage_gateway_downloads" data-analytics-surface="landing_gateway" data-analytics-label="Desktop build">Open downloads</a>
        </article>
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag">Play</span>
                <h3>Mobile play shell</h3>
            </div>
            <p>Use the mobile view during a session.</p>
            <a class="editorial-strip__action" href="@playHref" data-analytics-event="homepage_gateway_play" data-analytics-surface="landing_gateway" data-analytics-label="Mobile play shell">Open play shell</a>
        </article>
        <article class="gateway-card">
            <div class="gateway-card__header">
            <h3>Status</h3>
            </div>
            <p>See which build is published now.</p>
            <a class="editorial-strip__action" href="@statusHref" data-analytics-event="homepage_gateway_status" data-analytics-surface="landing_gateway" data-analytics-label="Release status">Open status</a>
        </article>
    </div>
</section>

@if (starterWorkspace is not null)
{
    <section class="workflow-band workflow-band--flagship workflow-band--compact" data-homepage-section="starter-lane" id="starter-lane">
        <div class="workflow-band__lead">
            <h2 class="editorial-title">Open your first session fast.</h2>
            <p class="editorial-copy">
                @(starterFirstPlayableSession is null
                    ? "Your starter workspace is ready to open on Home."
                    : starterFirstPlayableSession.CampaignStartSummary)
            </p>
        </div>
        <div class="flagship-gateway-grid flagship-gateway-grid--compact">
            <article class="gateway-card">
                <div class="gateway-card__header">
                    <span class="tag">Home</span>
                    <h3>Starter lane</h3>
                </div>
                <p>Open Home and return to your starter workspace.</p>
                <a class="editorial-strip__action" href="/home/work">Open Home</a>
            </article>
            <article class="gateway-card">
                <div class="gateway-card__header">
                    <span class="tag">Session</span>
                    <h3>First session</h3>
                </div>
                <p>Jump directly into the session your table can play first.</p>
                <a class="editorial-strip__action" href="@starterFirstPlayableSessionHref">Open first playable session</a>
            </article>
            <article class="gateway-card">
                <div class="gateway-card__header">
                    <span class="tag">Support</span>
                    <h3>Install help</h3>
                </div>
                <p>Get setup help without digging through project pages.</p>
                <a class="editorial-strip__action" href="/contact?kind=install_help">Open install support</a>
            </article>
        </div>
    </section>
}

<section class="access-band access-band--compact" data-public-section="footer" id="footer">
    <div class="access-band__copy">
        <h2 class="editorial-title">Help is one click away.</h2>
    </div>
    <div class="access-band__actions">
        <a class="button-like button-like--primary" href="/help" data-analytics-event="homepage_open_help" data-analytics-surface="landing_footer" data-analytics-label="Open help">Open help</a>
        <p class="muted-copy"><a class="inline-link" href="/status">Status</a> · <a class="inline-link" href="/feedback">Feedback</a> · <a class="inline-link" href="/privacy">Privacy</a></p>
    </div>
</section>

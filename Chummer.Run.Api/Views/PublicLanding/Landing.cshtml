@model LandingPageViewModel
@{
    ViewData["Title"] = "Chummer — Shadowrun character manager";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-landing surface-minimal";
    var starterWorkspace = Model.CampaignSpine?.Workspaces.FirstOrDefault();
    var starterFirstPlayableSession = starterWorkspace?.FirstPlayableSession;
}

<section class="minimal-hero" data-homepage-section="hero">
    <div class="minimal-hero__copy">
        <h1>Chummer</h1>
        <p class="minimal-hero__lead">A Shadowrun character manager for clean sheets and faster tables.</p>
        <div class="minimal-actions" aria-label="Main download">
            <a class="button-like button-like--primary" href="/downloads" title="Download Chummer" aria-label="Download Chummer" data-analytics-event="homepage_open_downloads" data-analytics-surface="minimal_home" data-analytics-label="Download Chummer">Download Chummer</a>
        </div>
        <p class="minimal-meta">Windows and Linux.</p>
        <p class="minimal-inline-links">
            <a href="/help" data-analytics-event="homepage_open_help" data-analytics-surface="minimal_home" data-analytics-label="Help">Help</a>
            <a href="/partizipate" data-analytics-event="homepage_open_participate" data-analytics-surface="minimal_home" data-analytics-label="Participate">Participate</a>
            <a href="/status" data-analytics-event="homepage_open_status" data-analytics-surface="minimal_home" data-analytics-label="Status">Status</a>
        </p>
    </div>
    <aside class="minimal-hero__visual minimal-hero__visual--preview" aria-label="Browser preview concept" data-homepage-preview="chummer6-here">
        <p class="minimal-hero__preview-kicker">Preview test</p>
        <h2>Chummer6 here</h2>
        <p class="minimal-hero__preview-copy">A browser-first head could live here later. It would be a different UI from the real Chummer6 desktop app, used as a functionality preview rather than the main shipped workbench.</p>
        <ul class="minimal-hero__preview-points">
            <li>same core product direction</li>
            <li>lighter web-facing shell</li>
            <li>preview-only posture for now</li>
        </ul>
        <div class="minimal-actions minimal-actions--preview">
            <a class="button-like button-like--ghost" href="/downloads" data-analytics-event="homepage_preview_open_downloads" data-analytics-surface="minimal_home" data-analytics-label="Use the desktop build">Use the desktop build</a>
            <a class="button-like button-like--ghost" href="/status" data-analytics-event="homepage_preview_open_status" data-analytics-surface="minimal_home" data-analytics-label="Track preview status">Track preview status</a>
        </div>
    </aside>
</section>

@if (Model.Chrome.Authenticated)
{
    @if (Model.OpenRail is { Items.Count: > 0 })
    {
        <section class="minimal-section minimal-section--support" data-homepage-section="open-rail">
            <div class="minimal-section__lead">
                <h2>@Model.OpenRail.Heading</h2>
                <p>@Model.OpenRail.Summary</p>
            </div>
            <div class="minimal-facts" role="list" aria-label="Open in Chummer">
                @foreach (var item in Model.OpenRail.Items)
                {
                    <article role="listitem">
                        <strong>@item.Label</strong>
                        <p>@item.Summary</p>
                        <p class="minimal-meta">@item.Kind</p>
                        <a class="button-like button-like--ghost" href="@item.Href">Open</a>
                    </article>
                }
            </div>
        </section>
    }

    <section class="minimal-section minimal-section--support" data-homepage-section="starter-lane">
        <div class="minimal-section__lead">
            <h2>Next session</h2>
            <p>@(starterFirstPlayableSession?.CampaignStartSummary ?? "Open Home when you are ready to start the first playable session.")</p>
        </div>
        <div class="minimal-actions">
            <a class="button-like button-like--primary" href="/home/work">Open Home</a>
            <a class="button-like button-like--ghost" href="@(starterWorkspace is null ? "/home/work" : $"/account/work/workspaces/{Uri.EscapeDataString(starterWorkspace.WorkspaceId)}#selected-first-playable-session")">Open first playable session</a>
            <a class="button-like button-like--ghost" href="/contact?kind=install_help">Open install support</a>
        </div>
    </section>
}

@model LandingPageViewModel
@{
    ViewData["Title"] = "Chummer";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-landing";
    var hero = Model.Assets.BySlot("section_hero");
    var heroProofAsset = Model.Assets.BySlot("product_proof_ui") ?? Model.Assets.BySlot("capability_check_rules");
    var proofSectionAsset = Model.Assets.BySlot("scene_dossier_desk")
        ?? Model.Assets.BySlot("scene_simulation_bench")
        ?? Model.Assets.BySlot("capability_check_rules")
        ?? heroProofAsset;
    if (proofSectionAsset is not null
        && heroProofAsset is not null
        && string.Equals(proofSectionAsset.AssetSlot, heroProofAsset.AssetSlot, StringComparison.OrdinalIgnoreCase))
    {
        proofSectionAsset = Model.Assets.BySlot("scene_simulation_bench")
            ?? Model.Assets.BySlot("scene_dossier_desk");
    }
    var proofNotes = Model.Workflows.Take(1).ToArray();
    var heroProofTrail = Model.Surface.ProductProofTrail.Take(2).ToArray();
    var availableHighlight = Model.AvailableToday.FirstOrDefault();
    var comingNextHighlight = Model.ComingNext.FirstOrDefault();
    var previewCount = Model.PreviewItems.Count;
    var previewHighlight = Model.PreviewItems.FirstOrDefault();
    var release = Model.ReleaseExperience;
    var starterWorkspace = Model.CampaignSpine?.Workspaces.FirstOrDefault();
    var starterFirstPlayableSession = starterWorkspace?.FirstPlayableSession;
    var guestNeedsInstallGate = !Model.Chrome.Authenticated && release.Recommended?.RequiresAccount == true;
    var contextualHeroPrimaryHref = guestNeedsInstallGate
        ? release.GuestGatePrimaryHref
        : Model.PrimaryHeroAction.Href;
    var contextualProductPrimaryAction = Model.PrimaryHeroAction;
    var sectionsById = Model.Surface.Sections.ToDictionary(static section => section.Id, StringComparer.OrdinalIgnoreCase);
    var heroSection = Section("hero");
    var productProofSection = Section("product_proof");
    var worksNowSection = Section("whats_real_now");
    var closingSection = Section("closing_cta");

    PublicLandingSectionDto Section(string id)
        => sectionsById.TryGetValue(id, out var section)
            ? section
            : throw new InvalidOperationException($"Landing section '{id}' is required.");

    string ContextualPreviewHref(string? href)
    {
        var resolvedHref = href ?? string.Empty;
        if (!guestNeedsInstallGate)
        {
            return resolvedHref;
        }

        var trimmed = resolvedHref.Trim();
        var queryIndex = trimmed.IndexOf('?');
        var route = queryIndex >= 0 ? trimmed[..queryIndex] : trimmed;
        return string.Equals(route, "/downloads", StringComparison.OrdinalIgnoreCase)
            ? (release.GuestGatePrimaryHref ?? resolvedHref)
            : resolvedHref;
    }

    static string TrustRowValue(
        SignedInTrustStatusPanelViewModel? panel,
        string label,
        string fallback)
        => panel?.Rows.FirstOrDefault(row => string.Equals(row.Label, label, StringComparison.Ordinal))?.Value ?? fallback;
}

<section class="launch-hero">
    <div class="launch-hero__shell">
        <div class="launch-hero__copy">
            <p class="eyebrow">@heroSection.Eyebrow</p>
            <h1 class="launch-hero__title">@Model.Surface.Headline</h1>
            <p class="launch-hero__support">@Model.Surface.Subhead</p>
            <div class="launch-hero__actions">
                <a class="button-like button-like--primary" href="@contextualHeroPrimaryHref">@Model.PrimaryHeroAction.Label</a>
                <a class="button-like button-like--secondary" href="@Model.SecondaryHeroAction.Href">@Model.SecondaryHeroAction.Label</a>
            </div>
            <div class="proof-chip-row" aria-label="Highlights">
                @foreach (var chip in Model.Surface.SecondaryHighlights)
                {
                    <span class="proof-chip">@chip</span>
                }
            </div>
            <p class="launch-hero__trustline">@Model.Surface.ProofLine</p>
        </div>
        @if (hero is not null)
        {
            <div class="launch-hero__media">
                @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", hero)
                <div class="launch-hero__prooffloat" aria-label="Current preview details">
                    <div class="launch-hero__proof-topline">
                        <span>Current preview</span>
                        <span>@release.Display.ChannelLabel · @release.Display.BuildLabel</span>
                    </div>
                    <div class="launch-hero__proof-summary">
                        <strong>@Model.Surface.ProductProofResultTitle</strong>
                        <p>@Model.Surface.ProductProofResultSummary</p>
                    </div>
                    @if (heroProofTrail.Length > 0)
                    {
                        <div class="launch-hero__proof-trail">
                            @foreach (var step in heroProofTrail)
                            {
                                <span>@step</span>
                            }
                        </div>
                    }
                    @if (heroProofAsset is not null)
                    {
                        <div class="launch-hero__proof-shot">
                            @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", heroProofAsset)
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

<section class="product-proof">
    <div class="product-proof__copy">
        <p class="eyebrow">@Model.Surface.ProductProofEyebrow</p>
        <h2 class="editorial-title">@productProofSection.Title</h2>
        <p class="editorial-copy">@productProofSection.Intro</p>
        @if (proofNotes.Length > 0)
        {
            var workflow = proofNotes[0];
            <div class="release-footnote">
                <p><strong>@workflow.Card.Title:</strong> @(workflow.Card.ProofNote ?? workflow.Card.Payoff ?? workflow.Card.Summary) <a class="inline-link" href="@ContextualPreviewHref(workflow.Action.Href)">@workflow.Action.Label</a>.</p>
            </div>
        }
        <div class="stacked-actions">
            <a class="button-like button-like--primary" href="@contextualProductPrimaryAction.Href">@contextualProductPrimaryAction.Label</a>
        </div>
        <p class="muted-copy">Need the broader shelf? <a class="inline-link" href="@Model.Surface.ProductProofSecondaryHref">@Model.Surface.ProductProofSecondaryLabel</a>.</p>
    </div>
    @if (proofSectionAsset is not null)
    {
        <div class="product-proof__media">
            @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", proofSectionAsset)
        </div>
    }
</section>

<section class="works-matrix">
    <div class="works-matrix__lead">
        <p class="eyebrow">@worksNowSection.Eyebrow</p>
        <h2 class="editorial-title">@worksNowSection.Title</h2>
        <p class="editorial-copy">@worksNowSection.Intro</p>
    </div>
    <div class="compact-rail">
        @if (availableHighlight is not null)
        {
            <article class="compact-rail__item" id="@availableHighlight.Card.Id.Replace('_', '-')">
                <div class="compact-rail__copy">
                    <span class="tag">@PublicSurfaceStatus.DisplayLabel(availableHighlight.Card.Badge)</span>
                    <h3>@availableHighlight.Card.Title</h3>
                    <p>@availableHighlight.Card.Summary @(Model.AvailableToday.Count > 1 ? $"+{Model.AvailableToday.Count - 1} more working surface(s) sit on the full shelf." : string.Empty)</p>
                </div>
                <a class="inline-link" href="@availableHighlight.Action.Href">@availableHighlight.Action.Label</a>
            </article>
        }
        @if (comingNextHighlight is not null)
        {
            <article class="compact-rail__item" id="@comingNextHighlight.Card.Id.Replace('_', '-')">
                <div class="compact-rail__copy">
                    <span class="tag @PublicSurfaceStatus.CssTone(comingNextHighlight.Card.Badge)">@PublicSurfaceStatus.DisplayLabel(comingNextHighlight.Card.Badge)</span>
                    <h3>@comingNextHighlight.Card.Title</h3>
                    <p>@comingNextHighlight.Card.Summary @(Model.ComingNext.Count > 1 ? $"+{Model.ComingNext.Count - 1} more planned surface(s) stay visible on the full roadmap." : string.Empty)</p>
                </div>
                <a class="inline-link" href="@comingNextHighlight.Action.Href">@comingNextHighlight.Action.Label</a>
            </article>
        }
    </div>
    @if (previewHighlight is not null)
    {
        <p class="muted-copy">
            Preview in progress: <a class="inline-link" href="@previewHighlight.Action.Href">@previewHighlight.Card.Title</a>
            @if (previewCount > 1)
            {
                <span> plus @(previewCount - 1) more opening surface(s) on the full preview shelf.</span>
            }
        </p>
    }
    <p class="muted-copy">Need the full picture? <a class="inline-link" href="/now">Open what works today</a>.</p>
</section>

@if (Model.TrustPulse is not null || Model.SignedInStatus is not null)
{
    <section class="release-shelf" aria-label="Current trust and first-session return">
        @if (Model.TrustPulse is not null)
        {
            <article class="app-action-card">
                <span class="tag">@Model.TrustPulse.Eyebrow</span>
                <h2>@Model.TrustPulse.Heading</h2>
                @await Html.PartialAsync("~/Views/Shared/_PublicTrustPulseBody.cshtml", Model.TrustPulse)
            </article>
        }
        @if (Model.SignedInStatus is not null)
        {
            @await Html.PartialAsync("~/Views/Shared/_SignedInTrustStatusPanel.cshtml", Model.SignedInStatus)
            <article class="app-action-card">
                <span class="tag">Return rail</span>
                <h2>@(starterFirstPlayableSession?.Label ?? "First session proof")</h2>
                <p>@(starterFirstPlayableSession?.CampaignStartSummary ?? "Your first playable session proof stays attached to the signed-in return path.")</p>
                <div class="settings-summary-list">
                    <div class="settings-summary-row">
                        <span>Access now</span>
                        <strong>@TrustRowValue(Model.SignedInStatus, "Who can get it now", "Open the current release to confirm access.")</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Fix availability</span>
                        <strong>@TrustRowValue(Model.SignedInStatus, "Fix availability", "Open support to confirm tracked fixes.")</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Current caution</span>
                        <strong>@TrustRowValue(Model.SignedInStatus, "Current caution", "Open status to confirm the current caution lane.")</strong>
                    </div>
                </div>
                <div class="stacked-actions">
                    <a class="button-like button-like--primary" href="/home">Open starter lane on Home</a>
                    <a class="button-like button-like--secondary" href="/home#selected-first-playable-session">Open first playable session proof</a>
                    <a class="button-like button-like--secondary" href="/contact">Open install support</a>
                </div>
            </article>
        }
    </section>
}

<section class="access-band">
    <div class="access-band__copy">
        <p class="eyebrow">@closingSection.Eyebrow</p>
        <h2 class="editorial-title">@closingSection.Title</h2>
        <p class="editorial-copy">Create the account when you want installs, devices, roadmap follow-up, and support history to stay attached to one return path.</p>
    </div>
    <div class="access-band__actions">
        @if (Model.Chrome.Authenticated)
        {
            <a class="button-like button-like--primary" href="/home">Open home</a>
            <p class="muted-copy">Your setup, updates, and access state already live in the signed-in product.</p>
        }
        else
        {
            <a class="button-like button-like--primary" href="/signup?next=/home">Create account</a>
            <p class="muted-copy">Already have one? <a class="inline-link" href="/login?next=/home">Sign in</a></p>
        }
        <p class="muted-copy">Still evaluating? <a class="quiet-link" href="/artifacts">Open the artifact gallery</a> or <a class="quiet-link" href="/what-is-chummer">read the product story</a>.</p>
    </div>
</section>

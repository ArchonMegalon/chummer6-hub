@model LandingPageViewModel
@{
    ViewData["Title"] = "Chummer — Shadowrun character and campaign companion";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-landing";
    var ledgerHref = "/ledger";
    var buildHref = "/downloads";
    var playHref = "/play";
    var statusHref = "/status";
    var replayTurnOneHref = "/ledger/map?replay=turn-1";
    var ledgerStats = (Model.BlackLedgerStats ?? Array.Empty<BlackLedgerPublicStatViewModel>()).Take(3).ToArray();
    var ledgerWorld = Model.BlackLedgerWorld;
    var factions = (ledgerWorld?.Factions ?? Array.Empty<BlackLedgerFactionViewModel>()).Take(6).ToArray();
    var latestDispatch = Model.LatestBlackLedgerDispatch;
    var newsreelStatus = latestDispatch is null ? "pending" : "sent";
    var starterWorkspace = Model.CampaignSpine?.Workspaces.FirstOrDefault();
    var starterFirstPlayableSession = starterWorkspace?.FirstPlayableSession;
    var starterFirstPlayableSessionHref = starterWorkspace is null
        ? "/home/work"
        : $"/account/work/workspaces/{Uri.EscapeDataString(starterWorkspace.WorkspaceId)}#selected-first-playable-session";
    Func<string, string> factionSlug = id => id.Replace('_', '-');
    Func<string, string> logoHref = id => $"/media/ledger/factions/{factionSlug(id)}-logo.svg";
    Func<string, string> backgroundHref = id => $"/media/ledger/factions/{factionSlug(id)}-bg.svg";
}

<section class="launch-hero launch-hero--ledger" data-homepage-section="hero">
    <div class="launch-hero__shell">
        <div class="launch-hero__copy">
            <p class="eyebrow">Black Ledger command deck</p>
            <h1 class="launch-hero__title">The city is moving.</h1>
            <p class="launch-hero__support">Watch the pressure, pick a faction, and step into Black Ledger.</p>
            <div class="launch-hero__actions">
                <a class="button-like button-like--primary" href="@ledgerHref" data-analytics-event="homepage_open_ledger" data-analytics-surface="landing_hero" data-analytics-label="Open Black Ledger">Open Black Ledger</a>
                <a class="button-like button-like--secondary" href="@buildHref" data-analytics-event="homepage_open_downloads" data-analytics-surface="landing_hero" data-analytics-label="Download Chummer">Download Chummer</a>
            </div>
            <div class="launch-hero__metric-strip" aria-label="Ledger score strip">
                @foreach (var stat in ledgerStats)
                {
                    <article class="launch-hero__metric">
                        <span>@stat.Title</span>
                        <strong>@stat.Value</strong>
                    </article>
                }
            </div>
            <p class="launch-hero__trustline">Turn 1 is live. Emerald Sprawl is fictional.</p>
        </div>
        <div class="launch-hero__stage" aria-label="Black Ledger geoscape teaser">
            <div
                class="launch-hero__geoscape"
                data-black-ledger-geoscape-root
                data-variant="teaser"
                data-map-url="/api/v1/ledger/worlds/emerald-sprawl-prelude/map"
                data-delta-url="/api/v1/ledger/worlds/emerald-sprawl-prelude/map/tick-delta/0/1"
                data-auto-replay="true"></div>
        </div>
    </div>
</section>
<script type="module" src="~/js/black-ledger-geoscape.js" asp-append-version="true"></script>

<section class="workflow-band workflow-band--flagship workflow-band--compact" data-homepage-section="score-strip" id="score-strip">
        <div class="workflow-band__lead">
            <p class="eyebrow">Pressure strip</p>
            <h2 class="editorial-title">Three signals. One moving city.</h2>
        </div>
    <div class="ledger-stats-grid ledger-stats-grid--hero">
        @foreach (var stat in ledgerStats)
        {
            <article class="ledger-stat-card ledger-stat-card--compact">
                <span>@stat.Title</span>
                <strong>@stat.Value</strong>
                <p>@stat.Period</p>
            </article>
        }
    </div>
</section>

<section class="workflow-band workflow-band--flagship workflow-band--compact" data-homepage-section="factions" id="factions">
    <div class="workflow-band__lead">
        <p class="eyebrow">Faction identity</p>
        <h2 class="editorial-title">Six seeded houses are already pushing on the same city.</h2>
    </div>
    <div class="faction-identity-strip">
        @foreach (var faction in factions)
        {
            <article class="faction-identity-card">
                <div class="faction-identity-card__backdrop" style="background-image:url('@backgroundHref(faction.Id)')"></div>
                <div class="faction-identity-card__body">
                    <img class="faction-identity-card__logo" src="@logoHref(faction.Id)" alt="@($"{faction.PublicName} logo")" loading="lazy" />
                    <div class="faction-identity-card__copy">
                        <span class="tag">@faction.Type</span>
                        <h3>@faction.PublicName</h3>
                        <p>@string.Join(" · ", faction.PublicSignals.Take(2))</p>
                    </div>
                    <a class="editorial-strip__action" href="/ledger/factions/@factionSlug(faction.Id)" data-analytics-event="homepage_open_faction_file" data-analytics-surface="landing_factions" data-analytics-label="@faction.PublicName">Open faction file</a>
                </div>
            </article>
        }
    </div>
</section>

<section class="workflow-band workflow-band--flagship workflow-band--compact flagship-promo-band" data-homepage-section="flagship-promo" id="flagship-promo">
    <div class="workflow-band__lead">
        <p class="eyebrow">Flagship reel</p>
        <h2 class="editorial-title">Build the runner. Run the table. Move the city.</h2>
    </div>
    <div class="flagship-promo-player">
        <video
            class="flagship-promo-player__video"
            controls
            preload="metadata"
            poster="/media/promo/chummer6-flagship-promo-poster.png"
            aria-label="Chummer6 flagship product reel">
            <source src="/media/promo/chummer6-flagship-promo.webm" type="video/webm" />
            <source src="/media/promo/chummer6-flagship-promo.mp4" type="video/mp4" />
            <track src="/media/promo/chummer6-flagship-promo.vtt" kind="captions" srclang="en" label="English" default />
        </video>
        <div class="flagship-promo-player__proof">
            <a class="inline-link" href="/media/promo/chummer6-flagship-promo.vtt">Captions</a>
            <a class="inline-link" href="/media/promo/chummer6-flagship-promo.receipt.json">Notes</a>
        </div>
    </div>
</section>

<section class="workflow-band workflow-band--flagship workflow-band--compact" data-homepage-section="play-downloads" id="play-downloads">
    <div class="workflow-band__lead">
        <p class="eyebrow">Open</p>
        <h2 class="editorial-title">Install, play, or open the city.</h2>
    </div>
    <div class="flagship-gateway-grid flagship-gateway-grid--compact">
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag">Downloads</span>
                <h3>Desktop build</h3>
            </div>
            <p>Install the current desktop build.</p>
            <a class="editorial-strip__action" href="@buildHref" data-analytics-event="homepage_gateway_downloads" data-analytics-surface="landing_gateway" data-analytics-label="Desktop build">Open downloads</a>
        </article>
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag">Play</span>
                <h3>Mobile play shell</h3>
            </div>
            <p>Open play when your table is live.</p>
            <a class="editorial-strip__action" href="@playHref" data-analytics-event="homepage_gateway_play" data-analytics-surface="landing_gateway" data-analytics-label="Mobile play shell">Open play shell</a>
        </article>
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag">Status</span>
            <h3>Status</h3>
            </div>
            <p>Check the current release and cautions.</p>
            <a class="editorial-strip__action" href="@statusHref" data-analytics-event="homepage_gateway_status" data-analytics-surface="landing_gateway" data-analytics-label="Release posture">Open status</a>
        </article>
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag">Replay</span>
                <h3>Turn 1</h3>
            </div>
            <p>Replay the first public tick.</p>
            <a class="editorial-strip__action" href="@replayTurnOneHref" data-analytics-event="homepage_gateway_replay" data-analytics-surface="landing_gateway" data-analytics-label="Replay Turn 1">Replay Turn 1</a>
        </article>
    </div>
</section>

@if (starterWorkspace is not null)
{
    <section class="workflow-band workflow-band--flagship workflow-band--compact" data-homepage-section="starter-lane" id="starter-lane">
        <div class="workflow-band__lead">
            <p class="eyebrow">Signed-in starter lane</p>
            <h2 class="editorial-title">Keep the first playable session and install return easy to find.</h2>
            <p class="editorial-copy">
                @(starterFirstPlayableSession is null
                    ? "Your starter workspace is ready to open on Home."
                    : starterFirstPlayableSession.CampaignStartSummary)
            </p>
        </div>
        <div class="flagship-gateway-grid flagship-gateway-grid--compact">
            <article class="gateway-card">
                <div class="gateway-card__header">
                    <span class="tag">Home</span>
                    <h3>Starter lane</h3>
                </div>
                <p>Open Home when you want the signed-in starter lane without hunting for the first workspace route.</p>
                <a class="editorial-strip__action" href="/home/work">Open starter lane on Home</a>
            </article>
            <article class="gateway-card">
                <div class="gateway-card__header">
                    <span class="tag">Session</span>
                    <h3>First session</h3>
                </div>
                <p>Jump directly into the first playable session drawer for the starter workspace.</p>
                <a class="editorial-strip__action" href="@starterFirstPlayableSessionHref">Open first playable session</a>
            </article>
            <article class="gateway-card">
                <div class="gateway-card__header">
                    <span class="tag">Support</span>
                    <h3>Install help</h3>
                </div>
                <p>Keep install help nearby so recovery and support stay easy to reach.</p>
                <a class="editorial-strip__action" href="/contact?kind=install_help">Open install support</a>
            </article>
        </div>
    </section>
}

<section class="access-band access-band--compact" data-public-section="footer" id="footer">
    <div class="access-band__copy">
        <p class="eyebrow">Help</p>
        <h2 class="editorial-title">Support.</h2>
    </div>
    <div class="access-band__actions">
        <a class="button-like button-like--primary" href="/help" data-analytics-event="homepage_open_help" data-analytics-surface="landing_footer" data-analytics-label="Open help">Open help</a>
        <p class="muted-copy"><a class="inline-link" href="/status">Status</a> · <a class="inline-link" href="/feedback">Feedback</a> · <a class="inline-link" href="/privacy">Privacy</a></p>
    </div>
</section>

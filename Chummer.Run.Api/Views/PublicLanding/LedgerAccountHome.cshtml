@model BlackLedgerFactionHomeViewModel
@{
    ViewData["Title"] = "My Black Ledger faction";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-ledger";
}

<section class="ledger-flagship ledger-flagship--account">
    <div class="ledger-flagship__copy">
        <p class="eyebrow">Faction command</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@PublicFacingCopyHumanizer.Clean(Model.Intro)</p>
        <p class="ledger-flagship__support">This is the signed-in campaign city view: one globe, one board state, one faction state, and one professional world-turn briefing.</p>
        <div class="trust-claim__microproof">
            <span>Faction: @Model.Faction.PublicName</span>
            <span>Membership: @Model.Allegiance.MembershipType</span>
            <span>Lock until: @Model.Allegiance.LockUntilUtc?.ToString("yyyy-MM-dd")</span>
        </div>
        <div class="stacked-actions">
            <a class="button-like button-like--primary" href="/account/ledger/factions/@Model.Faction.FactionId.Replace('_', '-')">Open my faction</a>
            <a class="button-like button-like--secondary" href="/account/ledger/notifications">Open notifications</a>
            <a class="button-like button-like--secondary" href="/account/ledger/advisory">Open advisory voting</a>
            <a class="button-like button-like--secondary" href="/ledger/map#ledger-map">Open public globe</a>
        </div>
    </div>
    <div class="ledger-flagship__stage">
        <div class="ledger-flagship__map-frame">
            <div
                class="ledger-flagship__geoscape"
                data-black-ledger-geoscape-root
                data-variant="account"
                data-map-url="/api/v1/ledger/worlds/emerald-sprawl-prelude/map?turn=1&amp;mode=influence"
                data-delta-url="/api/v1/ledger/worlds/emerald-sprawl-prelude/map/tick-delta/0/1"
                data-initial-mode="influence"
                data-selected-faction="@Model.Faction.FactionId.Replace('_', '-')"
                data-tick-headline="Turn 1 pressure live."
                data-primary-label="Open faction workspace"
                data-primary-href="/account/ledger/factions/@Model.Faction.FactionId.Replace('_', '-')"
                data-secondary-label="Leader briefing"
                data-secondary-href="/account/ledger/factions/@Model.Faction.FactionId.Replace('_', '-')/leader-briefing"></div>
        </div>
        <div class="ledger-flagship__nav" aria-label="Campaign city command paths">
            <a class="ledger-flagship__nav-card ledger-flagship__nav-card--primary" href="/account/ledger/factions/@Model.Faction.FactionId.Replace('_', '-')">
                <span class="tag">Workspace</span>
                <strong>Faction command deck</strong>
                <p>Management, action points, and private notes stay on the signed-in route.</p>
            </a>
            <a class="ledger-flagship__nav-card" href="/account/ledger/factions/@Model.Faction.FactionId.Replace('_', '-')/leader-briefing">
                <span class="tag">Leader</span>
                <strong>Leader briefing</strong>
                <p>Personalized pressure calls, next moves, and per-faction world-tick interpretation.</p>
            </a>
            <a class="ledger-flagship__nav-card" href="/account/ledger/worldtick/validation">
                <span class="tag">World state</span>
                <strong>Turn review</strong>
                <p>Review the current turn before it moves further.</p>
            </a>
            <a class="ledger-flagship__nav-card" href="/account/ledger/notifications">
                <span class="tag">Inbox</span>
                <strong>Newsreel inbox</strong>
                <p>See what reached your mailbox and what still needs attention.</p>
            </a>
            <a class="ledger-flagship__nav-card" href="/account/ledger/advisory">
                <span class="tag">Advisory</span>
                <strong>Vote and executive signal</strong>
                <p>Players can pressure the GM desk, GMs can pressure the leader, and the chain stays explicitly non-democratic.</p>
            </a>
        </div>
    </div>
</section>

@if (Model.NewsreelStatus is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">World turn inbox</p>
            <h2 class="editorial-title">@Model.NewsreelStatus.StatusLabel</h2>
            <p class="editorial-copy">@PublicFacingCopyHumanizer.Clean(Model.NewsreelStatus.Summary)</p>
        </div>
        <div class="trust-claim__microproof">
            <span>Policy: @PublicFacingCopyHumanizer.Clean(Model.NewsreelStatus.Policy)</span>
            <span>Messages: @Model.NewsreelStatus.ReceiptCount</span>
            <span>Recipients sent: @Model.NewsreelStatus.RecipientCount</span>
        </div>
        <div class="stacked-actions">
            <a class="button-like button-like--secondary" href="@Model.NewsreelStatus.NotificationsHref">Open notification history</a>
            <a class="button-like button-like--secondary" href="@Model.NewsreelStatus.TurnHref">Open Turn 1</a>
            <a class="button-like button-like--secondary" href="/account/ledger/worldtick/validation">Open turn review</a>
        </div>
    </section>
}

@if (Model.AdvisorySummary is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Advisory command</p>
            <h2 class="editorial-title">@Model.AdvisorySummary.Heading</h2>
            <p class="editorial-copy">@PublicFacingCopyHumanizer.Clean(Model.AdvisorySummary.NoDemocracyNote)</p>
        </div>
        <div class="route-choice-grid route-choice-grid--three">
            <article class="route-choice-card">
                <span class="tag">Players</span>
                <p>@Model.AdvisorySummary.PlayerBallots.Count player advisory ballot(s) are open on this path.</p>
            </article>
            <article class="route-choice-card">
                <span class="tag">GMs</span>
                <p>@Model.AdvisorySummary.GmBallots.Count GM strategy ballot(s) are open on this path.</p>
            </article>
            <article class="route-choice-card">
                <span class="tag">Executive</span>
                <p>@Model.AdvisorySummary.ExecutiveSummaries.Count executive intake summary item(s) are available.</p>
            </article>
        </div>
        <div class="stacked-actions">
            <a class="button-like button-like--secondary" href="/account/ledger/advisory">Open advisory</a>
            <a class="button-like button-like--secondary" href="@Model.AdvisorySummary.OpenMailHref">Open mail-backed route</a>
        </div>
    </section>
}

@if (Model.WorldTurnBriefing is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">@Model.WorldTurnBriefing.TransitionLabel</p>
            <h2 class="editorial-title">@Model.WorldTurnBriefing.InboxHeadline</h2>
            <p class="editorial-copy">@PublicFacingCopyHumanizer.Clean(Model.WorldTurnBriefing.NewsreelLead)</p>
        </div>
        <div class="route-choice-grid route-choice-grid--three">
            <article class="route-choice-card">
                <span class="tag">World state</span>
                <p>@PublicFacingCopyHumanizer.Clean(Model.WorldTurnBriefing.StateSummary)</p>
            </article>
            @foreach (var item in Model.WorldTurnBriefing.NewsreelBullets.Take(2))
            {
                <article class="route-choice-card">
                    <span class="tag">Newsreel beat</span>
                    <p>@item</p>
                </article>
            }
        </div>
    </section>
}

@if (Model.LeaderDigest is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Leader readout</p>
            <h2 class="editorial-title">@Model.LeaderDigest.Heading</h2>
            <p class="editorial-copy">@PublicFacingCopyHumanizer.Clean(Model.LeaderDigest.Summary)</p>
        </div>
        <div class="route-choice-grid route-choice-grid--three">
            @foreach (var item in Model.LeaderDigest.PressureCalls.Take(3))
            {
                <article class="route-choice-card">
                    <span class="tag">Pressure call</span>
                    <p>@item</p>
                </article>
            }
        </div>
        <div class="stacked-actions">
            <a class="button-like button-like--secondary" href="/account/ledger/factions/@Model.LeaderDigest.FactionId/leader-briefing">Open leader brief</a>
            <a class="button-like button-like--secondary" href="@Model.LeaderDigest.ValidationHref">Open leader details</a>
        </div>
    </section>
}

@if (Model.FollowThroughPacket is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Next actions</p>
            <h2 class="editorial-title">@Model.FollowThroughPacket.Heading</h2>
            <p class="editorial-copy">@PublicFacingCopyHumanizer.Clean(Model.FollowThroughPacket.Summary)</p>
        </div>
        <div class="route-choice-grid route-choice-grid--three">
            <article class="route-choice-card">
                <span class="tag">Signal Deck</span>
                <p>@PublicFacingCopyHumanizer.Clean(Model.FollowThroughPacket.SignalDeckSummary)</p>
            </article>
            <article class="route-choice-card">
                <span class="tag">Runner Passport</span>
                <p>@PublicFacingCopyHumanizer.Clean(Model.FollowThroughPacket.RunnerPassportSummary)</p>
            </article>
            <article class="route-choice-card">
                <span class="tag">Living Newsroom</span>
                <p>@PublicFacingCopyHumanizer.Clean(Model.FollowThroughPacket.LivingNewsroomSummary)</p>
                <div class="route-choice-card__proof">
                    <a href="@Model.FollowThroughPacket.LivingNewsroomHref">Watch</a>
                    <a href="/living-world">Open Living World</a>
                </div>
            </article>
            <article class="route-choice-card">
                <span class="tag">Aftermath</span>
                <p>@PublicFacingCopyHumanizer.Clean(Model.FollowThroughPacket.AftermathSummary)</p>
                <div class="route-choice-card__proof">
                    <a href="@Model.FollowThroughPacket.AftermathHref">Open aftermath</a>
                </div>
            </article>
            <article class="route-choice-card">
                <span class="tag">Boundary</span>
                <p>@PublicFacingCopyHumanizer.Clean(Model.FollowThroughPacket.BoundaryLine)</p>
            </article>
        </div>
        <div class="route-choice-grid route-choice-grid--three">
            @foreach (var cue in Model.FollowThroughPacket.Cues)
            {
                <article class="route-choice-card">
                    <span class="tag">@cue.Label</span>
                    <h3>@cue.StatusLabel</h3>
                    <p>@PublicFacingCopyHumanizer.Clean(cue.Summary)</p>
                    <div class="route-choice-card__proof">
                        <a href="@cue.Href">Open</a>
                    </div>
                </article>
            }
        </div>
    </section>
}

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Identity loop</p>
        <h2 class="editorial-title">Welcome kit and first task</h2>
        <p class="editorial-copy">Faction welcome kit, badge, runner passport stamp, rank state, and weekly dispatch hooks all start here.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var item in Model.WelcomeKit)
        {
            <article class="route-choice-card">
                <span class="tag">Faction identity</span>
                <p>@item</p>
            </article>
        }
    </div>
</section>

@if (Model.PromoArtifact is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Faction promo</p>
            <h2 class="editorial-title">Faction video draft</h2>
            <p class="editorial-copy">@PublicFacingCopyHumanizer.Clean(Model.PromoArtifact.CampaignHook)</p>
        </div>
        <div class="route-choice-grid">
            <article class="route-choice-card">
                <span class="tag">@PublicFacingCopyHumanizer.Clean(Model.PromoArtifact.ProviderStatus)</span>
                <h3>@Model.PromoArtifact.PublicName</h3>
                <p>Format: @PublicFacingCopyHumanizer.Clean(Model.PromoArtifact.RenderMode)</p>
                <p>@PublicFacingCopyHumanizer.Clean(Model.PromoArtifact.AudiencePromise)</p>
                <div class="route-choice-card__proof">
                    @foreach (var format in Model.PromoArtifact.FormatLabels)
                    {
                        <span>@format</span>
                    }
                </div>
                <div class="stacked-actions">
                    <a class="editorial-strip__action" href="@Model.PromoArtifact.HtmlHref">Open promo brief</a>
                    <a class="editorial-strip__action" href="@Model.PromoArtifact.JsonHref">Open details</a>
                    <a class="editorial-strip__action" href="@Model.PromoArtifact.ValidationHref">Open status</a>
                </div>
            </article>
        </div>
    </section>
}

@if (Model.ValidationPacket is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">World state</p>
            <h2 class="editorial-title">Current world-turn packet</h2>
            <p class="editorial-copy">@PublicFacingCopyHumanizer.Clean(Model.ValidationPacket.Summary)</p>
        </div>
        <div class="route-choice-grid route-choice-grid--three">
            @foreach (var check in Model.ValidationPacket.Checks.Take(3))
            {
                <article class="route-choice-card">
                    <span class="tag">Detail</span>
                    <p>@PublicFacingCopyHumanizer.Clean(check)</p>
                </article>
            }
        </div>
    </section>
}

@if (Model.RecentActionReceipts.Count > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Recent activity</p>
            <h2 class="editorial-title">Recent activity</h2>
            <p class="editorial-copy">Recent decisions stay easy to review.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var receipt in Model.RecentActionReceipts)
            {
                <article class="route-choice-card">
                    <span class="tag">@receipt.ActionLabel</span>
                    <h3>@receipt.ReceiptId</h3>
                    <p>@receipt.ResultSummary</p>
                    <a class="editorial-strip__action" href="@receipt.Href">View record</a>
                </article>
            }
        </div>
    </section>
}

<script type="module" src="~/js/black-ledger-geoscape.js" asp-append-version="true"></script>

@model FeatureDetailPageViewModel

<section class="role-matrix">
    <div class="editorial-block__lead">
        <p class="eyebrow">Use and verify this proof</p>
        <h2 class="editorial-title">What this live artifact shows, who it helps, and what to check next</h2>
        <p class="editorial-copy">Live proof pages should help you use the product surface immediately, then verify the evidence markers before you leave for support.</p>
    </div>
    <div class="role-matrix__grid">
        <article class="role-matrix__cell">
            <span class="tag">Use it now</span>
            <p>Start from the live product surface attached to this artifact, then use support only if the proof path stops being enough to move forward.</p>
        </article>
        @if (!string.IsNullOrWhiteSpace(Model.Pain))
        {
            <article class="role-matrix__cell">
                <span class="tag">Why it matters</span>
                <p>@Model.Pain</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Payoff))
        {
            <article class="role-matrix__cell">
                <span class="tag">What it unlocks</span>
                <p>@Model.Payoff</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ProofNote))
        {
            <article class="role-matrix__cell">
                <span class="tag">How to verify it</span>
                <p>@Model.ProofNote</p>
            </article>
        }
    </div>
</section>

@if (Model.MicroProof.Count > 0)
{
    <section class="trust-rail-section">
        <div class="editorial-block__lead">
            <p class="eyebrow">Verification markers</p>
            <h2 class="editorial-title">Keep these cues in view before you assume the proof is complete</h2>
        </div>
        <div class="trust-claim__microproof">
            @foreach (var item in Model.MicroProof)
            {
                <span>@item</span>
            }
        </div>
    </section>
}

<section class="compact-rail">
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Start from the live surface</h3>
            <p>Use the product action first, not the gallery card. Live proof pages should move you into the working surface before they send you to any secondary reading.</p>
        </div>
        <a class="inline-link" href="@Model.PrimaryAction.Href">@Model.PrimaryAction.Label</a>
    </article>
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Check release posture</h3>
            <p>Proof is stronger when it sits next to the current release notes, known issues, and update posture instead of being read in isolation.</p>
        </div>
        <a class="inline-link" href="/now">Open current release</a>
    </article>
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Escalate only when proof stops being enough</h3>
            <p>If the route, install, or result still looks wrong after you follow the live path, support is the next honest lane.</p>
        </div>
        <a class="inline-link" href="/contact#support-intake">Open support</a>
    </article>
    @if (Model.Chrome.Authenticated)
    {
        <article class="compact-rail__item">
            <div class="compact-rail__copy">
                <h3>Keep the same artifact truth signed in</h3>
                <p>Use the signed-in artifact shelf when you want the same recap, campaign, and creator-publication record instead of jumping across separate detail pages.</p>
            </div>
            <a class="inline-link" href="/artifacts#linked-artifacts">Open signed-in artifact shelf</a>
        </article>
    }
</section>

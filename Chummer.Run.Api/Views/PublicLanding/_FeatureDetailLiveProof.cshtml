@model FeatureDetailPageViewModel

<section class="role-matrix">
    <div class="editorial-block__lead">
        <p class="eyebrow">Use this page</p>
        <h2 class="editorial-title">What it does, who it helps, and where to go next</h2>
        <p class="editorial-copy">Start with the product action. Use help only if the page stops being enough.</p>
    </div>
    <div class="role-matrix__grid">
        <article class="role-matrix__cell">
            <span class="tag">Use it now</span>
            <p>Start from the product page, then use help only if it does not get you where you need to go.</p>
        </article>
        @if (!string.IsNullOrWhiteSpace(Model.Pain))
        {
            <article class="role-matrix__cell">
                <span class="tag">Why it matters</span>
                <p>@Model.Pain</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Payoff))
        {
            <article class="role-matrix__cell">
                <span class="tag">What it unlocks</span>
                <p>@Model.Payoff</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ProofNote))
        {
            <article class="role-matrix__cell">
                <span class="tag">What to look for</span>
                <p>@PublicFacingCopyHumanizer.Clean(Model.ProofNote)</p>
            </article>
        }
    </div>
</section>

@if (Model.MicroProof.Count > 0)
{
    <section class="trust-rail-section">
        <div class="editorial-block__lead">
            <p class="eyebrow">Useful cues</p>
            <h2 class="editorial-title">Keep these in view before you decide this is the right page.</h2>
        </div>
        <div class="trust-claim__microproof">
            @foreach (var item in Model.MicroProof)
            {
                <span>@PublicFacingCopyHumanizer.Clean(item)</span>
            }
        </div>
    </section>
}

<section class="compact-rail">
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Start from the live surface</h3>
            <p>Use the product action first. The page should move you forward before it sends you to secondary reading.</p>
        </div>
        <a class="inline-link" href="@Model.PrimaryAction.Href">@Model.PrimaryAction.Label</a>
    </article>
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Use the current release context</h3>
            <p>This is easier to trust when it sits next to current release notes, known issues, and update status instead of being read in isolation.</p>
        </div>
        <a class="inline-link" href="/now">Open what works today</a>
    </article>
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Escalate only when the surface stops being enough</h3>
            <p>If the page, install, or result still looks wrong after you follow the live path, support is the next step.</p>
        </div>
        <a class="inline-link" href="/contact#support-intake">Open support</a>
    </article>
    @if (Model.Chrome.Authenticated)
    {
        <article class="compact-rail__item">
            <div class="compact-rail__copy">
                <h3>Keep the same detail trail signed in</h3>
                <p>Use the signed-in detail view when you want the same recap, campaign, and publication history in one place.</p>
            </div>
            <a class="inline-link" href="/artifacts#signed-in-detail-view">Open signed-in detail view</a>
        </article>
    }
</section>

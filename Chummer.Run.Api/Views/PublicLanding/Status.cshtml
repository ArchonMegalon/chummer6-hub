@model StatusPageViewModel
@{
    ViewData["Title"] = "Status";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-status";
    var guestNeedsInstallGate = !Model.Chrome.Authenticated && !string.IsNullOrWhiteSpace(Model.ReleaseExperience.GuestGatePrimaryHref);
    var validationState = CustomerStatusText(
        string.IsNullOrWhiteSpace(Model.Manifest.ProofStatus) ? "Not mirrored" : Model.Manifest.ProofStatus,
        "Not mirrored");
    var publishedLabel = Model.Manifest.PublishedAt.ToUniversalTime().ToString("yyyy-MM-dd");
    var verifiedLabel = Model.VerifiedAtLabel
        ?? (Model.Manifest.ProofGeneratedAt ?? Model.Manifest.GeneratedAt ?? Model.Manifest.PublishedAt)
            .ToUniversalTime()
            .ToString("yyyy-MM-dd");
    string ContextualPreviewHref(string? href)
    {
        var resolvedHref = string.IsNullOrWhiteSpace(href) ? "/downloads" : href;
        if (
            guestNeedsInstallGate
            && string.Equals(resolvedHref, "/downloads", StringComparison.OrdinalIgnoreCase)
        )
        {
            return Model.ReleaseExperience.GuestGatePrimaryHref ?? resolvedHref;
        }

        return resolvedHref;
    }

    static string HumanizeStatusToken(string? value, string fallback)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallback;
        }

        return string.Join(
            " ",
            value.Trim()
                .Split(['_', '-'], StringSplitOptions.RemoveEmptyEntries)
                .Select(part => char.ToUpperInvariant(part[0]) + part[1..].ToLowerInvariant()));
    }

static string CustomerStatusText(string? value, string fallback)
{
    var text = string.IsNullOrWhiteSpace(value) ? fallback : value;
    return text
            .Replace("proof\u00a0freshness", "recent checks", StringComparison.OrdinalIgnoreCase)
            .Replace("proof-freshness", "recent checks", StringComparison.OrdinalIgnoreCase)
            .Replace("stale", "out of date", StringComparison.OrdinalIgnoreCase)
            .Replace("shelf", "downloads page", StringComparison.OrdinalIgnoreCase)
            .Replace("governor truth", "recent checks", StringComparison.OrdinalIgnoreCase)
            .Replace("open-public artifacts", "public downloads", StringComparison.OrdinalIgnoreCase)
            .Replace("local edge proof", "current release check", StringComparison.OrdinalIgnoreCase)
            .Replace("edge proof", "release check", StringComparison.OrdinalIgnoreCase)
            .Replace("proof view", "current status view", StringComparison.OrdinalIgnoreCase)
            .Replace("proof page", "current status page", StringComparison.OrdinalIgnoreCase)
            .Replace("proof freshness", "recent checks", StringComparison.OrdinalIgnoreCase)
            .Replace("proof is green", "checks are clear", StringComparison.OrdinalIgnoreCase)
            .Replace("proof recency", "recent checks", StringComparison.OrdinalIgnoreCase)
            .Replace("journey proofs", "verified paths", StringComparison.OrdinalIgnoreCase)
            .Replace("proofs", "checks", StringComparison.OrdinalIgnoreCase)
            .Replace("trust routes", "checked routes", StringComparison.OrdinalIgnoreCase)
            .Replace("adoption health", "usage history", StringComparison.OrdinalIgnoreCase)
            .Replace("Promoted installer media", "Recommended installer", StringComparison.OrdinalIgnoreCase)
            .Replace("startup-smoke proof", "startup verification", StringComparison.OrdinalIgnoreCase)
            .Replace("startup-smoke", "startup verification", StringComparison.OrdinalIgnoreCase)
            .Replace("proof-gated", "waiting for current release checks", StringComparison.OrdinalIgnoreCase)
            .Replace("executable-gate proof", "executable verification", StringComparison.OrdinalIgnoreCase)
            .Replace("executable-gate", "executable verification", StringComparison.OrdinalIgnoreCase)
            .Replace("promoted flagship bytes", "promoted release packages", StringComparison.OrdinalIgnoreCase)
            .Replace("proof for the promoted", "verification for the promoted", StringComparison.OrdinalIgnoreCase)
            .Replace("tuple", "build", StringComparison.OrdinalIgnoreCase)
            .Replace("avalonia:linux:linux-x64", "Avalonia Linux x64", StringComparison.OrdinalIgnoreCase)
            .Replace("blazor-desktop:linux:linux-x64", "Blazor Desktop Linux x64", StringComparison.OrdinalIgnoreCase)
            .Replace("install_claim_restore_continue", "install, restore, and continue", StringComparison.OrdinalIgnoreCase)
            .Replace("build_explain_publish", "build, explain, and publish", StringComparison.OrdinalIgnoreCase)
            .Replace("campaign_session_recover_recap", "campaign recovery and recap", StringComparison.OrdinalIgnoreCase)
            .Replace("report_cluster_release_notify", "clustered release notification", StringComparison.OrdinalIgnoreCase)
            .Replace("organize_community_and_close_loop", "community wrap-up", StringComparison.OrdinalIgnoreCase)
            .Replace("closure", "wrap-up", StringComparison.OrdinalIgnoreCase)
            .Replace("rules lanes", "rulesets", StringComparison.OrdinalIgnoreCase)
            .Replace("rules lane", "ruleset", StringComparison.OrdinalIgnoreCase)
            .Replace("reviewed authority closure", "reviewed coverage closure", StringComparison.OrdinalIgnoreCase)
            .Replace("authority facts", "rules checks", StringComparison.OrdinalIgnoreCase)
            .Replace("errata posture", "errata updates", StringComparison.OrdinalIgnoreCase)
            .Replace("human signoff", "final human review", StringComparison.OrdinalIgnoreCase)
            .Replace("Proof recency", "Recent checks", StringComparison.OrdinalIgnoreCase)
            .Replace("Proof freshness", "Recent checks")
            .Replace("Proof recency", "Recent checks", StringComparison.OrdinalIgnoreCase)
            .Replace("proof freshness", "recent checks", StringComparison.OrdinalIgnoreCase)
            .Replace("proof recency", "recent checks", StringComparison.OrdinalIgnoreCase)
            .Replace("Gold-ready on Public release", "Public Stable", StringComparison.OrdinalIgnoreCase)
            .Replace("claimed-device recovery", "account return", StringComparison.OrdinalIgnoreCase)
            .Replace("clustered release notification", "release updates", StringComparison.OrdinalIgnoreCase)
            .Replace("support proof", "tracked support follow-up", StringComparison.OrdinalIgnoreCase)
            .Replace("adoption evidence", "usage history", StringComparison.OrdinalIgnoreCase)
            .Replace("install continuity", "account return", StringComparison.OrdinalIgnoreCase);
}

    static string NormalizeLaunchHealthLabel(string? label)
    {
        if (string.IsNullOrWhiteSpace(label))
        {
            return string.Empty;
        }

        var normalized = label
            .Trim()
            .Replace("proof\u00a0freshness", "Recent checks", StringComparison.OrdinalIgnoreCase)
            .Replace("proof-freshness", "Recent checks", StringComparison.OrdinalIgnoreCase)
            .Replace("proof freshness", "Recent checks", StringComparison.OrdinalIgnoreCase)
            .Replace("proof recency", "Recent checks", StringComparison.OrdinalIgnoreCase)
            .Replace("Proof freshness", "Recent checks")
            .Replace("Proof recency", "Recent checks", StringComparison.OrdinalIgnoreCase)
            .Replace("Proof-freshness", "Recent checks")
            .Replace("proof checks", "Recent checks", StringComparison.OrdinalIgnoreCase);

        return normalized.ToLowerInvariant() switch
        {
            "live" => "Availability",
            "preview" => "Release",
            "fallback" => "Other downloads",
            "revoked" => "Unavailable",
            "fixed" => "Updates",
            "blocked" => "Issues",
            "support pulse" => "Support",
            "adoption health" => "History",
            "release check" => "Recent checks",
            "release checks" => "Recent checks",
            _ => normalized,
        };
    }

    string? FindLaunchHealthValue(string label)
    {
        var normalizedLookup = NormalizeLaunchHealthLabel(label);
        return Model.LaunchHealthRows?
            .FirstOrDefault(row => string.Equals(NormalizeLaunchHealthLabel(row.Label), normalizedLookup, StringComparison.OrdinalIgnoreCase))
            ?.Value;
    }

    var releasePostureSummary = CustomerStatusText(
        FindLaunchHealthValue("Preview"),
        CustomerStatusText(Model.Manifest.SupportabilitySummary ?? Model.Manifest.Message, "The current release notes and support path should read like one honest record."));
    var cautionSummary = CustomerStatusText(Model.Manifest.KnownIssueSummary, string.Empty);
    var supportLabel = CustomerStatusText(Model.ReleaseExperience.KnownIssuesLabel, "Support");
    var nextActions = new[]
    {
        new
        {
            Label = "Open downloads",
            Href = "/downloads",
            Tone = "primary",
        },
        new
        {
            Label = "Open support",
            Href = Model.ReleaseExperience.KnownIssuesHref,
            Tone = "secondary",
        },
        new
        {
            Label = "Open progress",
            Href = "/progress",
            Tone = "ghost",
        }
    };
    if (string.IsNullOrWhiteSpace(cautionSummary))
    {
        cautionSummary = FindLaunchHealthValue("Blocked") ?? "Known issues and install help stay one short step away.";
    }
    else if (cautionSummary.Contains("proof is green", StringComparison.OrdinalIgnoreCase))
    {
        cautionSummary = "Known issues and install help stay one short step away, even when the current release checks are green.";
    }

    if (cautionSummary.Contains("Current release checks are clear", StringComparison.OrdinalIgnoreCase)
        || cautionSummary.Contains("account return", StringComparison.OrdinalIgnoreCase)
        || cautionSummary.Contains("support follow-up coverage", StringComparison.OrdinalIgnoreCase))
    {
        cautionSummary = "Known issues, install help, and account return stay nearby.";
    }
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">Current status</p>
        <h1 class="page-title">What works now</h1>
        <p class="page-copy">Release, caution, next click.</p>
        <div class="trust-claim__microproof">
            <span>@Model.ReleaseExperience.Display.BuildLabel</span>
            <span>@HumanizeStatusToken(Model.Manifest.RolloutState, "Current release")</span>
            <span>Released @publishedLabel</span>
            <span>Last verified @verifiedLabel</span>
            <span>Validation @validationState</span>
        </div>
    </div>
</section>

<section class="editorial-block" data-status-surface="decision-surface">
    <div class="editorial-block__lead">
        <p class="eyebrow">Current release</p>
        <h2 class="editorial-title">Release, caution, next click.</h2>
    </div>
    <article class="route-choice-card">
        <span class="tag">Release</span>
        <h3>Current public release</h3>
        <p>@releasePostureSummary</p>
        <span class="tag tag--amber">Caution</span>
        <p><strong>Current caution.</strong> @cautionSummary</p>
    </article>
    <div class="stacked-actions" aria-label="Status next actions">
        @foreach (var action in nextActions)
        {
            var href = string.Equals(action.Href, "/downloads", StringComparison.OrdinalIgnoreCase)
                ? ContextualPreviewHref(action.Href)
                : action.Href;
            <a class="button-like button-like--@action.Tone" href="@href" data-analytics-event="status_next_action" data-analytics-surface="status_decision" data-analytics-label="@action.Label">@action.Label</a>
        }
    </div>
</section>

@if (Model.ReleaseExperience.PlatformAvailability.Count > 0)
{
    <section class="release-shelf release-shelf--manual">
        <details class="release-accordion">
            <summary data-analytics-event="status_open_platform_details" data-analytics-surface="status_details" data-analytics-label="Other platform details">Other platform details</summary>
            <div class="release-accordion__body">
                <div class="evidence-row-list">
                    @foreach (var platform in Model.ReleaseExperience.PlatformAvailability)
                    {
                        <article class="evidence-row evidence-row--download" id="status-platform-@platform.PlatformId">
                            <div class="evidence-row__copy">
                                <h3>@platform.PlatformLabel@(platform.CurrentDevice ? " (this device)" : string.Empty)</h3>
                                <p>@platform.Summary</p>
                            </div>
                            <div class="download-row__meta">
                                <span class="platform-pill">@platform.StatusLabel</span>
                                <span class="muted-copy">@platform.PrimaryPackageLabel</span>
                                <span class="muted-copy">@platform.SupportabilityLabel</span>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </details>
    </section>
}

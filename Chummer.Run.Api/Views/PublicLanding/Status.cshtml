@model StatusPageViewModel
@{
    ViewData["Title"] = "Status";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-status";
    var guestNeedsInstallGate = !Model.Chrome.Authenticated && !string.IsNullOrWhiteSpace(Model.ReleaseExperience.GuestGatePrimaryHref);
    var validationState = string.IsNullOrWhiteSpace(Model.Manifest.ProofStatus) ? "Not mirrored" : Model.Manifest.ProofStatus;
    var publishedLabel = Model.Manifest.PublishedAt.ToUniversalTime().ToString("yyyy-MM-dd");
    var accountReturnHref = Model.Chrome.Authenticated ? "/home" : "/signup?next=/home";
    var accountReturnLabel = Model.Chrome.Authenticated ? "Open home" : "Create account";
    var accountReturnSummary = Model.Chrome.Authenticated
        ? "Use Home when install follow-through, support status, and the next safe action should stay in one signed-in place."
        : "Create the account when you want install return, support history, and roadmap follow-up attached to one calmer place.";
    var statusRouteChoices = new[]
    {
        new
        {
            Badge = "Downloads",
            Title = "Install or update from the downloads page",
            Summary = "Downloads still owns the recommended build, platform notes, current package details, and the calmest first-run path for this device.",
            Href = "/downloads",
            Label = "Open downloads",
            Proof = new[] { "Recommended build", "Known issues nearby", "Install continuity" }
        },
        new
        {
            Badge = "Live proof",
            Title = "Use what works today when the question is proof, not packaging",
            Summary = "Open the proof page when you need the current result, current cautions, or one inspectable explanation before you move a device.",
            Href = "/now",
            Label = "Open what works today",
            Proof = new[] { "Current proof", "Caution explicit", "One inspectable trail" }
        },
        new
        {
            Badge = "Private help",
            Title = "Leave status for first-party help as soon as the issue becomes private",
            Summary = "Install failures, crashes, account recovery, and campaign-sensitive detail belong on support instead of sitting on a public summary surface.",
            Href = "/contact#support-intake",
            Label = "Open support intake",
            Proof = new[] { "Private by default", "Tracked return", "Support-owned" }
        },
        new
        {
            Badge = "Deeper report",
            Title = "Open the larger machine picture only when the short status line is not enough",
            Summary = "This page should stay short and customer-safe. The deeper progress report remains the place for the broader operational readout.",
            Href = "/progress",
            Label = "Open progress",
            Proof = new[] { "Short public summary", "Longer machine report", "No page confusion" }
        }
    };
    var campaignStatusTitle = Model.CampaignOsProof is null
        ? "Campaign proof is not mirrored on this request"
        : $"Campaign proof is currently {Model.CampaignOsProof.Status}";
    var campaignStatusSummary = Model.CampaignOsProof is null
        ? "The public status view can stay useful without the deeper campaign proof packet, but the longer progress report is where that gap should stay visible."
        : Model.CampaignOsProof.JourneysPassed.Count == 0
            ? "The campaign proof packet is mirrored, but no named journeys are listed as passed in the current snapshot."
            : $"Current mirrored journey coverage: {string.Join(", ", Model.CampaignOsProof.JourneysPassed)}.";

    string ContextualPreviewHref(string? href)
    {
        var resolvedHref = string.IsNullOrWhiteSpace(href) ? "/downloads" : href;
        if (
            guestNeedsInstallGate
            && string.Equals(resolvedHref, "/downloads", StringComparison.OrdinalIgnoreCase)
        )
        {
            return Model.ReleaseExperience.GuestGatePrimaryHref ?? resolvedHref;
        }

        return resolvedHref;
    }
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">Current status</p>
        <h1 class="page-title">What works now, what needs caution, and where to go next</h1>
        <p class="page-copy">Use this page for the short customer-facing summary. It should point you to install, live proof, support, or the deeper report without making you decode the whole release stack.</p>
        <div class="trust-claim__microproof">
            <span>@Model.ReleaseExperience.Display.BuildLabel</span>
            <span>@Model.ReleaseExperience.Display.ChannelLabel</span>
            <span>Published @publishedLabel</span>
            <span>Validation @validationState</span>
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="/now">Open what works today</a>
        <a class="button-like button-like--secondary" href="@ContextualPreviewHref("/downloads")">Open downloads</a>
        <a class="button-like button-like--ghost" href="/progress">Open progress</a>
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Where to go next</p>
        <h2 class="editorial-title">Pick the right next page instead of treating status like a catch-all dashboard.</h2>
        <p class="editorial-copy">Status stays useful when it remains a compact public summary and hands you to downloads, proof, help, or the deeper report as soon as the job changes.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var choice in statusRouteChoices)
        {
            <article class="route-choice-card">
                <span class="tag">@choice.Badge</span>
                <h3>@choice.Title</h3>
                <p>@choice.Summary</p>
                <div class="route-choice-card__proof">
                    @foreach (var item in choice.Proof)
                    {
                        <span>@item</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@ContextualPreviewHref(choice.Href)">@choice.Label</a>
            </article>
        }
    </div>
</section>

<section class="section-band">
    <div class="page-lead">
        <p class="eyebrow">Snapshot</p>
        <h2 class="page-title">The short status line stays visible on one page.</h2>
        <p class="page-copy">This is the customer-safe readout: current release posture, current caution, support fallback, and campaign-proof visibility.</p>
    </div>
    <div class="settings-summary-list">
        <div class="settings-summary-row">
            <span>Channel</span>
            <strong>@Model.Manifest.Channel</strong>
        </div>
        <div class="settings-summary-row">
            <span>Version</span>
            <strong>@Model.Manifest.Version</strong>
        </div>
        <div class="settings-summary-row">
            <span>Validation state</span>
            <strong>@validationState</strong>
        </div>
        <div class="settings-summary-row">
            <span>Update status</span>
            <strong>@Model.ReleaseExperience.UpdatePostureSummary</strong>
        </div>
        @if (Model.CampaignOsProof is not null)
        {
            <div class="settings-summary-row">
                <span>Campaign status</span>
                <strong>@Model.CampaignOsProof.Status</strong>
            </div>
            <div class="settings-summary-row">
                <span>Journeys covered</span>
                <strong>@(Model.CampaignOsProof.JourneysPassed.Count == 0 ? "No mirrored journeys yet" : string.Join(", ", Model.CampaignOsProof.JourneysPassed))</strong>
            </div>
        }
    </div>
</section>

<section class="status-decision-strip" aria-label="Current status decisions">
    <article class="status-decision-strip__card">
        <span class="tag">Release posture</span>
        <h2>@Model.ReleaseExperience.Display.BuildLabel stays attached to downloads.</h2>
        <p>@(Model.Manifest.SupportabilitySummary ?? Model.Manifest.Message ?? "The current release shelf, notes, and support path should read like one honest record.")</p>
        <a class="button-like button-like--ghost" href="@ContextualPreviewHref("/downloads")">Open downloads</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag tag--amber">Current caution</span>
        <h2>Known issues and install help should be one short step away.</h2>
        <p>@(Model.Manifest.KnownIssueSummary ?? Model.ReleaseExperience.KnownIssuesLabel)</p>
        <a class="button-like button-like--ghost" href="@Model.ReleaseExperience.KnownIssuesHref">@Model.ReleaseExperience.KnownIssuesLabel</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag">Campaign proof</span>
        <h2>@campaignStatusTitle</h2>
        <p>@campaignStatusSummary</p>
        <a class="button-like button-like--ghost" href="/now">Open what works today</a>
    </article>
</section>

@if (Model.LaunchHealthRows is { Count: > 0 })
{
    <section class="release-shelf">
        <article class="app-action-card">
            <span class="tag">Public launch health</span>
            <h2>Governor truth behind the public status line</h2>
            <p>These rows compile the live shelf, preview posture, fallback and revoke truth, blocked gates, proof freshness, support pulse, and adoption evidence into one customer-safe summary.</p>
            <div class="settings-summary-list">
                @foreach (var row in Model.LaunchHealthRows)
                {
                    <div class="settings-summary-row">
                        <span>@row.Label</span>
                        <strong>@row.Value</strong>
                    </div>
                }
            </div>
        </article>
    </section>
}

<section class="compact-rail">
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Release status</h3>
            <p>@(Model.Manifest.SupportabilitySummary ?? Model.Manifest.Message ?? "The current release shelf, notes, and support path should read like one honest record.")</p>
        </div>
        <a class="inline-link" href="@ContextualPreviewHref("/downloads")">Open downloads</a>
    </article>
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Current caution</h3>
            <p>@(Model.Manifest.KnownIssueSummary ?? Model.ReleaseExperience.KnownIssuesLabel)</p>
        </div>
        <a class="inline-link" href="@Model.ReleaseExperience.KnownIssuesHref">@Model.ReleaseExperience.KnownIssuesLabel</a>
    </article>
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Fix and closure follow-through</h3>
            <p>@(Model.Manifest.FixAvailabilitySummary ?? "Use support only when downloads, notes, and known issues stop being enough to move forward.")</p>
        </div>
        <a class="inline-link" href="/contact#support-intake">Open support</a>
    </article>
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Detailed progress report</h3>
            <p>The deeper build report stays separate from this page so the public status view can stay short and honest.</p>
        </div>
        <a class="inline-link" href="/progress">Open progress</a>
    </article>
</section>

@if (Model.ReleaseExperience.PlatformAvailability.Count > 0)
{
    <section class="release-shelf release-shelf--manual">
        <details class="release-accordion">
            <summary>Desktop platform availability</summary>
            <div class="release-accordion__body">
                <div class="evidence-row-list">
                    @foreach (var platform in Model.ReleaseExperience.PlatformAvailability)
                    {
                        <article class="evidence-row evidence-row--download" id="status-platform-@platform.PlatformId">
                            <div class="evidence-row__copy">
                                <h3>@platform.PlatformLabel@(platform.CurrentDevice ? " (this device)" : string.Empty)</h3>
                                <p>@platform.Summary</p>
                            </div>
                            <div class="download-row__meta">
                                <span class="platform-pill">@platform.StatusLabel</span>
                                <span class="muted-copy">@platform.PrimaryPackageLabel</span>
                                <span class="muted-copy">@platform.SupportabilityLabel</span>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </details>
    </section>
}

<section class="release-footnote">
    <p class="eyebrow">Signed-in return</p>
    <h2 class="editorial-title">Keep status, install follow-through, and support history in one calmer signed-in place.</h2>
    <p class="editorial-copy">@accountReturnSummary</p>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="@accountReturnHref">@accountReturnLabel</a>
        <a class="button-like button-like--ghost" href="/contact#support-intake">Open support intake</a>
    </div>
</section>

<section class="trust-rail-section">
    <div class="editorial-block__lead">
        <p class="eyebrow">Status poster</p>
        <h2 class="editorial-title">One public visual for current progress</h2>
        <p class="editorial-copy">The poster is the lighter public companion to the deeper progress report. It should match this page.</p>
    </div>
    <div class="story-cinematic__media">
        <img src="/api/public/progress-poster.svg" alt="Current public progress poster" loading="lazy" />
    </div>
</section>

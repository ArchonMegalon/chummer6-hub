@model StatusPageViewModel
@{
    ViewData["Title"] = "Status";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-status surface-minimal";
    var publicPlatformLabels = Model.ReleaseExperience.PlatformAvailability
        .Where(static platform => platform.PubliclyAvailable)
        .Select(static platform => platform.PlatformLabel)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToArray();
    var publicPlatformSummary = publicPlatformLabels.Length switch
    {
        0 => "No public installer right now.",
        1 => $"{publicPlatformLabels[0]} download is live.",
        2 => $"{publicPlatformLabels[0]} and {publicPlatformLabels[1]} downloads are live.",
        _ => $"{string.Join(", ", publicPlatformLabels.Take(publicPlatformLabels.Length - 1))}, and {publicPlatformLabels[^1]} downloads are live."
    };

    static bool IsPublishedStableRelease(PublicReleaseManifestDto manifest)
    {
        var stableLanePublished = string.Equals((manifest.Channel ?? string.Empty).Trim(), "public_stable", StringComparison.OrdinalIgnoreCase)
            || string.Equals((manifest.Channel ?? string.Empty).Trim(), "stable", StringComparison.OrdinalIgnoreCase)
            || string.Equals((manifest.Channel ?? string.Empty).Trim(), "docker", StringComparison.OrdinalIgnoreCase)
            || string.Equals((manifest.RolloutState ?? string.Empty).Trim(), "public_stable", StringComparison.OrdinalIgnoreCase);
        return stableLanePublished
            && string.Equals((manifest.SupportabilityState ?? string.Empty).Trim(), "gold_supported", StringComparison.OrdinalIgnoreCase)
            && string.Equals((manifest.Status ?? string.Empty).Trim(), "published", StringComparison.OrdinalIgnoreCase);
    }

    var isStableRelease = IsPublishedStableRelease(Model.Manifest);
    var heading = Model.ReleaseExperience.Recommended is null
        ? "Downloads paused"
        : isStableRelease ? "Stable downloads" : "Preview downloads";
    var statusLine = Model.ReleaseExperience.Recommended is null
        ? "Downloads are paused."
        : isStableRelease ? publicPlatformSummary : $"{publicPlatformSummary} Stable is still unavailable.";

    static string PublicStatusText(string? value)
    {
        var humanized = UndetectableHumanizerCopyAdapter.Humanize(value);
        return humanized.Replace("Open help", "Use Help", StringComparison.OrdinalIgnoreCase);
    }

    static string ManifestVersionText(PublicReleaseManifestDto manifest)
    {
        var version = !string.IsNullOrWhiteSpace(manifest.Version)
            ? manifest.Version
            : manifest.DisplayVersion;
        return string.IsNullOrWhiteSpace(version) ? "Version unavailable" : $"Version {version}";
    }

}

<section class="minimal-page-hero minimal-status-pill">
    <div>
        <p class="eyebrow">Now</p>
        <h1>@heading</h1>
        <p>@PublicStatusText(statusLine)</p>
        <p class="muted-copy">@PublicStatusText(Model.ReleaseSummary)</p>
        <p class="muted-copy">@PublicStatusText(Model.CautionSummary)</p>
        <span data-downloads-release-version="@ManifestVersionText(Model.Manifest)" hidden>@ManifestVersionText(Model.Manifest)</span>
        <div class="minimal-actions" aria-label="Status next actions">
            <a class="button-like button-like--primary" href="/downloads" data-analytics-event="status_next_action" data-analytics-surface="status_decision" data-analytics-label="Downloads">Downloads</a>
            <a class="button-like button-like--ghost" href="/help" data-analytics-event="status_next_action" data-analytics-surface="status_decision" data-analytics-label="Help">Help</a>
        </div>
    </div>
</section>

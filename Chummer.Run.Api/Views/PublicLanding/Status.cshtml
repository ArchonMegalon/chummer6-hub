@model StatusPageViewModel
@{
    ViewData["Title"] = "Status";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-status surface-minimal";
    var releaseAvailabilityLabel = IsReleaseAvailable(Model.Manifest.ProofStatus)
        ? "Available"
        : "Unavailable";
    var publishedLabel = Model.Manifest.PublishedAt.ToUniversalTime().ToString("yyyy-MM-dd");
    var verifiedLabel = Model.VerifiedAtLabel
        ?? (Model.Manifest.ProofGeneratedAt ?? Model.Manifest.GeneratedAt ?? Model.Manifest.PublishedAt)
            .ToUniversalTime()
            .ToString("yyyy-MM-dd");
}

@functions {
    private static bool IsReleaseAvailable(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var normalized = value.Trim();
        return normalized.Contains("pass", StringComparison.OrdinalIgnoreCase)
            || normalized.Contains("ready", StringComparison.OrdinalIgnoreCase)
            || normalized.Contains("available", StringComparison.OrdinalIgnoreCase);
    }
}

<section class="minimal-page-hero">
    <div>
        <p class="minimal-kicker">Status</p>
        <h1>Release status</h1>
        <p>The build currently available from Chummer.</p>
    </div>
    <div class="minimal-status-pill" aria-label="Current release">
        <span>@Model.ReleaseExperience.Display.ChannelLabel</span>
        <strong>@Model.ReleaseExperience.Display.BuildLabel</strong>
        <span>Released @publishedLabel</span>
    </div>
</section>

<section class="minimal-section minimal-section--tight" data-status-surface="decision-surface">
    <div class="minimal-facts">
        <article class="route-choice-card">
            <span class="tag">Release</span>
            <h3>@Model.ReleaseExperience.Display.ChannelLabel</h3>
            <p>@Model.ReleaseSummary</p>
        </article>
        <article>
            <span>Build</span>
            <strong>@Model.ReleaseExperience.Display.BuildLabel</strong>
        </article>
        <article>
            <span>Last updated</span>
            <strong>@verifiedLabel</strong>
        </article>
        <article>
            <span>Status</span>
            <strong>@releaseAvailabilityLabel</strong>
        </article>
    </div>
    <div class="minimal-actions" aria-label="Status next actions">
        <a class="button-like button-like--primary" href="/downloads" data-analytics-event="status_next_action" data-analytics-surface="status_decision" data-analytics-label="Downloads">Open downloads</a>
        <a class="button-like button-like--secondary" href="/help" data-analytics-event="status_next_action" data-analytics-surface="status_decision" data-analytics-label="Support">Open support</a>
        <a class="button-like button-like--ghost" href="/changelog" data-analytics-event="status_next_action" data-analytics-surface="status_decision" data-analytics-label="Changes">Changes</a>
    </div>
</section>

@if (Model.ReleaseExperience.PlatformAvailability.Count > 0)
{
    <section class="minimal-section minimal-section--tight">
        <div class="minimal-section__lead">
            <h2>Platforms</h2>
        </div>
        <div class="minimal-platform-list">
            @foreach (var platform in Model.ReleaseExperience.PlatformAvailability)
            {
                <article id="status-platform-@platform.PlatformId">
                    <h3>@platform.PlatformLabel@(platform.CurrentDevice ? " (this device)" : string.Empty)</h3>
                    <p>@platform.Summary</p>
                </article>
            }
        </div>
    </section>
}

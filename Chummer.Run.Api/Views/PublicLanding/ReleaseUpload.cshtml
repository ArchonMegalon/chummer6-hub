@model ReleaseUploadPageViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Build macOS";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-downloads";
    static string PublicReleaseUploadText(string? value) => UndetectableHumanizerCopyAdapter.Humanize(value);
    var antiForgery = Antiforgery.GetAndStoreTokens(Context);
}

<section class="recommended-download" id="release-upload-command">
    <article class="recommended-download__card">
        <div class="recommended-download__copy">
            <span class="tag">Mac build command</span>
            <h2>Run this on your Mac</h2>
            <p>The command verifies the setup script and release proof, materializes the five digest-bound authority inputs from authenticated snapshot <code>@Model.AuthoritySnapshotId</code>, asks for the short-lived access code without echoing it, then clones repos, builds the osx-arm64 desktop app, runs startup smoke, publishes, and verifies.</p>
            <p>Before running it, export reviewed refs and full 40-hex <code>EXPECTED_COMMIT</code> pins for all seven source repositories. The command supplies all 17 Hub-proof authority variables itself; do not override them with machine-local paths. It stops before downloading the bootstrap when any source pin is absent or malformed; the <a href="@Model.ReadmeUrl">runbook</a> lists every required source setting.</p>
            <div class="code-panel">
                <div class="code-panel__label">Command</div>
                <pre class="code-panel__value mono-receipt" id="releaseUploadCommand">@Model.Command</pre>
                <div class="stacked-actions">
                    <button class="button-like button-like--secondary" type="button" id="copyReleaseUploadCommandButton">Copy command</button>
                    <a class="button-like button-like--ghost" href="@Model.BootstrapUrl">Open setup script</a>
                </div>
                <p class="status-copy">The command contains no access code. Copy a fresh code below, run the command, and paste the code at the hidden prompt. For unattended input, place only the code in a regular mode-0600 file and set <code>CHUMMER_RELEASE_UPLOAD_TICKET_FILE</code> to its path.</p>
                <p class="status-copy">Authority snapshot SHA-256: <code>@Model.AuthoritySnapshotSha256</code>. Refresh this page instead of reusing the command after CURRENT advances.</p>
                <p class="status-copy">After a successful upload or a failed run, delete the local release work root and temporary packaging files again so the Mac SSD does not fill up. Typical cleanup targets are the `run-...` workspace under `$HOME/work/chummer-release` plus any `CHUMMER_MAC_RELEASE_TMPDIR` and `CHUMMER_DESKTOP_INSTALLER_TMPDIR` contents.</p>
                <p class="status-copy" id="releaseUploadCommandNotice" hidden></p>
            </div>
        </div>
    </article>
</section>

<section class="recommended-download" id="release-upload-handoff">
    <article class="recommended-download__card">
        <div class="recommended-download__copy">
            <span class="tag">Short-lived access code</span>
            <h2>Copy a fresh code when the Mac is ready</h2>
            <p>The code is minted only after you click. It is copied directly to the clipboard and is never embedded in this page or the command.</p>
            <div class="code-panel">
                <input type="hidden" name="__RequestVerificationToken" value="@antiForgery.RequestToken" />
                <div class="stacked-actions">
                    <button class="button-like button-like--secondary" type="button" id="copyReleaseUploadHandoffCodeButton" data-ticket-url="@Model.TicketUrl">Mint and copy access code</button>
                </div>
                <p class="status-copy">Treat the clipboard value as sensitive until it expires. Never put it in command history, process arguments, shell startup files, or shared logs.</p>
                <p class="status-copy" id="releaseUploadHandoffCodeNotice" hidden></p>
            </div>
        </div>
    </article>
</section>

<section class="release-stage">
    <div class="release-stage__lead">
        <p class="eyebrow">Build macOS</p>
        <h1 class="page-title">@PublicReleaseUploadText(Model.Heading)</h1>
        <p class="page-copy">@PublicReleaseUploadText(Model.Summary)</p>
        <p class="release-stage__note">
            This page keeps the Mac build handoff in Chummer: one authenticated access code, one setup command, and one recovery-aware status path.
        </p>
    </div>
</section>

<section class="release-stage">
    <div class="release-stage__integrity">
        <span class="tag">Ticket window</span>
        <p>Mint the code immediately before starting the command so the full validity window remains available to the build.</p>
    </div>
    <div class="release-stage__note">
        The command is preconfigured for unsigned release uploads.
        Replace <code>CHUMMER_ALLOW_UNSIGNED_PREVIEW=1</code> with a valid <code>CHUMMER_APP_SIGN_IDENTITY</code> when you are ready for signed delivery.
    </div>
</section>

@if (Model.SignedInStatus is not null)
{
    <section class="release-footnote">
        @await Html.PartialAsync("~/Views/Shared/_SignedInTrustStatusPanel.cshtml", Model.SignedInStatus)
    </section>
}

<section class="release-guidance release-guidance--detail">
    <article class="release-guidance__item">
        <span class="tag">What happens next</span>
        <h2>Automatic publication and recovery-aware status</h2>
        <ul class="trust-page-section__list">
            <li>The upload response accepts the bundle and publishes only the target platform file to the live downloads shelf.</li>
            <li>The response returns the install setup URL and keeps any recovery-only code with the same release run if setup explicitly enters recovery mode.</li>
            <li>The promoted file appears in the current public release file at <a href="@Model.VerifyUrl">@Model.VerifyUrl</a>, while <code>/downloads/releases.json</code> remains the compatibility view.</li>
        </ul>
    </article>
    <article class="release-guidance__item">
        <span class="tag tag--quiet">Windows too</span>
        <h2>Same endpoint, same contract</h2>
        <p>@PublicReleaseUploadText(Model.WindowsUploadNote)</p>
        <ul class="trust-page-section__list">
            <li>Upload endpoint: <a href="@Model.UploadUrl">@Model.UploadUrl</a></li>
            <li>Runbook: <a href="@Model.ReadmeUrl">@Model.ReadmeUrl</a></li>
        </ul>
    </article>
</section>
@section Scripts {
<script>
(() => {
  const ui = window.ChummerUi;
  const copyButton = document.getElementById("copyReleaseUploadCommandButton");
  const commandValue = document.getElementById("releaseUploadCommand");
  const notice = document.getElementById("releaseUploadCommandNotice");
  const copyHandoffCodeButton = document.getElementById("copyReleaseUploadHandoffCodeButton");
  const handoffCodeNotice = document.getElementById("releaseUploadHandoffCodeNotice");

  if (copyButton && commandValue && ui?.copyToClipboard) {
    copyButton.addEventListener("click", async () => {
      try {
        await ui.copyToClipboard(commandValue.textContent || "", copyButton, "Copied");
        ui.setNotice(notice, "Release upload command copied.");
      } catch (error) {
        ui.setNotice(notice, ui.describeError(error, "Release upload command copy failed. Copy it manually from the command panel."), true);
      }
    });
  }

  if (copyHandoffCodeButton && ui?.copyToClipboard) {
    copyHandoffCodeButton.addEventListener("click", async () => {
      try {
        const ticketUrl = copyHandoffCodeButton.dataset.ticketUrl || "";
        const response = await fetch(ticketUrl, {
          method: "POST",
          credentials: "same-origin",
          headers: {
            "Accept": "application/json",
            "RequestVerificationToken": ui.getRequestVerificationToken()
          }
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || typeof payload.ticket !== "string" || !payload.ticket) {
          throw new Error(payload.detail || `Access code request failed (${response.status}).`);
        }

        await ui.copyToClipboard(payload.ticket, copyHandoffCodeButton, "Copied");
        payload.ticket = "";
        const expiresAt = typeof payload.expiresAtUtc === "string"
          ? new Date(payload.expiresAtUtc).toLocaleString()
          : "the advertised ticket window";
        ui.setNotice(handoffCodeNotice, `Fresh release upload access code copied. It expires at ${expiresAt}.`);
      } catch (error) {
        ui.setNotice(handoffCodeNotice, ui.describeError(error, "Release upload access code could not be minted or copied. Sign in again, then retry."), true);
      }
    });
  }
})();
</script>
}

@model ReleaseUploadPageViewModel
@{
    ViewData["Title"] = "Release upload handoff";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-downloads";
    var expires = Model.TicketExpiresAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm 'UTC'");
}

<section class="recommended-download" id="release-upload-command">
    <article class="recommended-download__card">
        <div class="recommended-download__copy">
            <span class="tag">Mac release one-liner</span>
            <h2>Run this in your Mac release shell</h2>
            <p>The command clones repos, builds the osx-arm64 desktop app, runs startup smoke, publishes the signed upload bundle, and carries the current short-lived upload handoff code so non-interactive runners do not stop after the integrity step.</p>
            <div class="code-panel">
                <div class="code-panel__label">Command</div>
                <pre class="code-panel__value mono-receipt" id="releaseUploadCommand">@Model.Command</pre>
                <div class="stacked-actions">
                    <button class="button-like button-like--secondary" type="button" id="copyReleaseUploadCommandButton">Copy command</button>
                    <a class="button-like button-like--ghost" href="@Model.BootstrapUrl">Open bootstrap script</a>
                </div>
                <p class="status-copy">This signed-in command contains a short-lived handoff code. Use it in the release shell that will run the bootstrap, and do not paste it into logs or shared chat.</p>
                <p class="status-copy">After a successful upload or a failed run, delete the local release work root and temporary packaging files again so the Mac SSD does not fill up. Typical cleanup targets are the `run-...` workspace under `$HOME/work/chummer-release` plus any `CHUMMER_MAC_RELEASE_TMPDIR` and `CHUMMER_DESKTOP_INSTALLER_TMPDIR` contents.</p>
                <p class="status-copy" id="releaseUploadCommandNotice" hidden></p>
            </div>
        </div>
    </article>
</section>

<section class="recommended-download" id="release-upload-handoff">
    <article class="recommended-download__card">
        <div class="recommended-download__copy">
            <span class="tag">Short-lived handoff code</span>
            <h2>Backup handoff code</h2>
            <p>The command above already includes this value. Keep it available only for recovery or for a manually downloaded bootstrap script that still prompts for upload authorization.</p>
            <div class="code-panel">
                <div class="code-panel__label">Handoff code</div>
                <pre class="code-panel__value mono-receipt" id="releaseUploadHandoffCode">@Model.HandoffCode</pre>
                <div class="stacked-actions">
                    <button class="button-like button-like--secondary" type="button" id="copyReleaseUploadHandoffCodeButton">Copy handoff code</button>
                </div>
                <p class="status-copy">Treat the handoff code as sensitive until it expires. Never export it in shell startup files.</p>
                <p class="status-copy" id="releaseUploadHandoffCodeNotice" hidden></p>
            </div>
        </div>
    </article>
</section>

<section class="release-stage">
    <div class="release-stage__lead">
        <p class="eyebrow">Signed-in release upload</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@Model.Summary</p>
        <p class="release-stage__note">
            This page handles release upload in Chummer: one authenticated handoff, one bootstrap command, and one recovery-aware status path.
        </p>
    </div>
</section>

<section class="release-stage">
    <div class="release-stage__integrity">
        <span class="tag">Ticket window</span>
        <p>Expires @expires.</p>
    </div>
    <div class="release-stage__note">
        The command is preconfigured for preview uploads with unsigned mode enabled.
        Replace <code>CHUMMER_ALLOW_UNSIGNED_PREVIEW=1</code> with a valid <code>CHUMMER_APP_SIGN_IDENTITY</code> when you are ready for signed delivery.
    </div>
</section>

@if (Model.SignedInStatus is not null)
{
    <section class="release-footnote">
        @await Html.PartialAsync("~/Views/Shared/_SignedInTrustStatusPanel.cshtml", Model.SignedInStatus)
    </section>
}

<section class="release-guidance release-guidance--detail">
    <article class="release-guidance__item">
        <span class="tag">What happens next</span>
        <h2>Automatic publication and recovery-aware status</h2>
        <ul class="trust-page-section__list">
            <li>The upload response accepts the bundle and publishes only the target platform file to the live downloads shelf.</li>
            <li>The response returns the install handoff URL and keeps any recovery-only code on the same handoff if setup explicitly enters recovery mode during setup.</li>
            <li>The promoted file appears in the canonical public manifest at <a href="@Model.VerifyUrl">@Model.VerifyUrl</a>, while <code>/downloads/releases.json</code> remains the compatibility view.</li>
        </ul>
    </article>
    <article class="release-guidance__item">
        <span class="tag tag--quiet">Windows too</span>
        <h2>Same endpoint, same contract</h2>
        <p>@Model.WindowsUploadNote</p>
        <ul class="trust-page-section__list">
            <li>Upload endpoint: <a href="@Model.UploadUrl">@Model.UploadUrl</a></li>
            <li>Runbook: <a href="@Model.ReadmeUrl">@Model.ReadmeUrl</a></li>
        </ul>
    </article>
</section>
@section Scripts {
<script>
(() => {
  const ui = window.ChummerUi;
  const copyButton = document.getElementById("copyReleaseUploadCommandButton");
  const commandValue = document.getElementById("releaseUploadCommand");
  const notice = document.getElementById("releaseUploadCommandNotice");
  const copyHandoffCodeButton = document.getElementById("copyReleaseUploadHandoffCodeButton");
  const handoffCodeValue = document.getElementById("releaseUploadHandoffCode");
  const handoffCodeNotice = document.getElementById("releaseUploadHandoffCodeNotice");

  if (copyButton && commandValue && ui?.copyToClipboard) {
    copyButton.addEventListener("click", async () => {
      try {
        await ui.copyToClipboard(commandValue.textContent || "", copyButton, "Copied");
        ui.setNotice(notice, "Release upload command copied.");
      } catch (error) {
        ui.setNotice(notice, ui.describeError(error, "Release upload command copy failed. Copy it manually from the command panel."), true);
      }
    });
  }

  if (copyHandoffCodeButton && handoffCodeValue && ui?.copyToClipboard) {
    copyHandoffCodeButton.addEventListener("click", async () => {
      try {
        await ui.copyToClipboard(handoffCodeValue.textContent || "", copyHandoffCodeButton, "Copied");
        ui.setNotice(handoffCodeNotice, "Release upload handoff code copied.");
      } catch (error) {
        ui.setNotice(handoffCodeNotice, ui.describeError(error, "Release upload handoff code copy failed. Copy it manually from the code panel."), true);
      }
    });
  }
})();
</script>
}

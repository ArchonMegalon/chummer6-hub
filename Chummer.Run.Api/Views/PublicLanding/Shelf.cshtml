@using Chummer.Campaign.Contracts
@model ShelfPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-artifacts";
    var publicationRouteReviewRequired = Model.TrustPulse?.MissingDesktopClientCoverage == true
        || Model.TrustPulse?.ParityClaimsReviewRequired == true;
    // Public comparison language stays limited until current direct route records are green.
    var liveItems = Model.Items.Where(card => PublicSurfaceStatus.IsAvailableToday(card.Card.Badge)).ToArray();
    var previewItems = Model.Items.Except(liveItems).ToArray();
    var selectedSignedInArtifactView = Model.SignedInArtifactView;
    var signedInRecapShelf = Model.SignedInRecapShelf is { Count: > 0 }
        ? Model.SignedInRecapShelf.Take(4).ToArray()
        : Array.Empty<RecapShelfEntry>();
    var signedInCreatorPublications = Model.SignedInCreatorPublications is { Count: > 0 }
        ? Model.SignedInCreatorPublications.Take(3).ToArray()
        : Array.Empty<CreatorPublicationProjection>();
    var publicCreatorPublications = Model.PublicCreatorPublications is { Count: > 0 }
        ? Model.PublicCreatorPublications.Take(3).ToArray()
        : Array.Empty<CreatorPublicationProjection>();
    var rankedPublicCreatorPublications = publicCreatorPublications
        .OrderByDescending(publication => CreatorPublicationTrustRank(publication.TrustBand))
        .ThenBy(publication => publication.Title, StringComparer.OrdinalIgnoreCase)
        .ToArray();
    var artifactShelfPrimaryHref = rankedPublicCreatorPublications.Length > 0
        ? "#public-detail-view"
        : liveItems.Length > 0
            ? "#current-detail-surfaces"
            : previewItems.Length > 0
                ? "#preview-artifacts"
                : "#artifact-route-map";
    var signedInContinuityHref = Model.Chrome.Authenticated ? "#signed-in-detail-view" : "/signup?next=%2Fartifacts";
    var signedInContinuityLabel = Model.Chrome.Authenticated ? "Signed-in account return view" : "Create account for signed-in account return";
    var routeChoices = new[]
    {
        new
        {
            Badge = "Detail view",
            Title = "Inspect dossiers, recaps, and shared publications here",
            Summary = "Use this page when you want background and detail without confusing that with the install decision.",
            Href = artifactShelfPrimaryHref,
            Label = "Open detail view",
            Details = new[] { "Readable detail", "Related files", "Background" }
        },
        new
        {
            Badge = "Downloads",
            Title = "Go back to downloads when you actually want the build",
            Summary = "Downloads remains the place to pick an installer, check known issues, and get setup help. This page should not compete with that decision.",
            Href = "/downloads",
            Label = "Open downloads",
            Details = new[] { "Install path", "Same file for everyone", "Support nearby" }
        },
        new
        {
            Badge = "Signed-in account return",
            Title = Model.Chrome.Authenticated
                ? "Personal, campaign, creator, and public returns stay in one signed-in view"
                : "Sign in when you want the private account-return view as well as public detail pages",
            Summary = Model.Chrome.Authenticated
                ? "The signed-in view keeps aftermath, replay, publication, Signal Deck carry-forward, and campaign next steps together."
                : "Public detail pages work without an account. Sign in only when you want private account return and campaign or creator-owned next steps.",
            Href = signedInContinuityHref,
            Label = signedInContinuityLabel,
            Details = Model.Chrome.Authenticated
                ? new[] { "Table Pulse Aftermath", "Creator next steps", "Same return view" }
                : new[] { "Public first", "Account adds return paths", "No auth wall for detail pages" }
        },
        new
        {
            Badge = "Help",
            Title = "Leave the detail view when the problem becomes support or recovery",
            Summary = "Install failures, account recovery, and private campaign issues belong in Chummer help. These detail pages should support that work, not replace it.",
            Href = "/help",
            Label = "Open help",
            Details = new[] { "Setup help", "Private help", "No page confusion" }
        }
    };

    static string HumanizeStatus(string? value, string fallback = "Not connected")
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallback;
        }

        return value.Trim().ToLowerInvariant() switch
        {
            "active" => "Ready",
            "linked" => "Ready",
            "pending" => "Pending",
            "pending_verification" => "Confirmation sent",
            "verified" => "Confirmed",
            "approved" => "Approved",
            "self_service" => "Self-service",
            "review" => "Needs review",
            "warning" => "Needs attention",
            "attention" => "Needs attention",
            "ready" => "Ready",
            "revoked" => "Revoked",
            _ => System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(value.Replace('_', ' '))
        };
    }

    static bool IsDiscoverablePublicCreatorPublication(CreatorPublicationProjection? publication)
        => publication is not null
            && publication.Discoverable
            && string.Equals(publication.PublicationStatus, "published", StringComparison.OrdinalIgnoreCase);

    static int CreatorPublicationTrustRank(string? trustBand)
        => trustBand?.Trim().ToLowerInvariant() switch
        {
            "curated-live" => 6,
            "restricted-live" => 5,
            "approval-backed" => 4,
            "review-pending" => 3,
            "needs-revision" => 2,
            "retained-history" => 1,
            "delisted-caution" => 0,
            _ => -1
        };

    static string PublicationDetailHref(string publicationId) => $"/account/work/publications/{Uri.EscapeDataString(publicationId)}";
    static string PublicCreatorPublicationHref(string publicationId) => $"/artifacts/publications/{Uri.EscapeDataString(publicationId)}";
    static string CreatorPublicationHref(CreatorPublicationProjection? publication, string publicationId)
        => IsDiscoverablePublicCreatorPublication(publication)
            ? PublicCreatorPublicationHref(publicationId)
            : PublicationDetailHref(publicationId);
    static string CreatorPublicationLinkLabel(CreatorPublicationProjection? publication)
        => IsDiscoverablePublicCreatorPublication(publication)
            ? "Open public publication"
            : "Open publication status";
    static string BuildHandoffDetailHref(string handoffId) => $"/account/work/build-handoffs/{Uri.EscapeDataString(handoffId)}";
    static string ArtifactViewHref(string view)
        => string.Equals(view, "all", StringComparison.Ordinal)
            ? "/artifacts#signed-in-detail-view"
            : $"/artifacts?view={Uri.EscapeDataString(view)}#signed-in-detail-view";
    static string ArtifactViewTitle(string view) => view switch
    {
        "personal" => "Personal view",
        "campaign" => "Campaign view",
        "creator" => "Creator view",
        "public" => "Public view",
        _ => "All views"
    };
    static string ArtifactViewSummary(string view) => view switch
    {
        "personal" => "Keep account-side runner and return details visible without losing the shared history they belong to.",
        "campaign" => "Stay on the shared crew and continuity page for campaign-owned files, prep notes, Table Pulse Aftermath return cues, and replay next steps.",
        "creator" => "Inspect creator-linked history, confidence, availability, and next steps for published or publication-ready work.",
        "public" => "Inspect published shared-publication pages so discoverable creator work and publication detail stay together while you are signed in.",
        _ => "When you are signed in, the detail view keeps your live Table Pulse Aftermath return cues, aftermath, replay, and linked creator-publication history together instead of splitting them into separate stories."
    };

    string PublicationAvailabilityLabel(bool discoverable)
        => publicationRouteReviewRequired && discoverable
            ? "Limited public state"
            : discoverable
                ? "Ready now"
                : "Limited release";

    var governedDiscoveryTitle = publicationRouteReviewRequired
        ? "Shared publications with limited public wording"
        : "Published shared publications";
    var governedDiscoveryCopy = publicationRouteReviewRequired
        ? "These campaign, primer, dossier, recap, replay, and run-module outputs are visible, but some public comparison language stays narrow until the remaining review is finished."
        : "These campaign, primer, dossier, recap, replay, and run-module outputs are live after review and moderation.";
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">Dossiers, recaps, and release details belong on a clear detail page, not in a vague gallery. Use this page for history and background, then go back to downloads when you actually want the build.</p>
        <div class="trust-claim__details">
            <span>@(liveItems.Length + rankedPublicCreatorPublications.Length) public detail card(s)</span>
            <span>@previewItems.Length opening next</span>
            @if (publicationRouteReviewRequired)
            {
                <span>Limited public wording</span>
            }
            @if (Model.Chrome.Authenticated)
            {
                <span>@(signedInRecapShelf.Length + signedInCreatorPublications.Length) signed-in history card(s)</span>
            }
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="@artifactShelfPrimaryHref">Open detail view</a>
        <a class="button-like button-like--secondary" href="/downloads">Open downloads</a>
        <a class="button-like button-like--ghost" href="/now">Open what works today</a>
    </div>
</section>

<section class="editorial-block" id="artifact-route-map">
    <div class="editorial-block__lead">
        <p class="eyebrow">Where to go next</p>
        <h2 class="editorial-title">Pick details, downloads, signed-in history, or help without mixing their jobs.</h2>
        <p class="editorial-copy">The detail view should make outputs and background tangible. It should not become the install page, a support queue, or a disguised account wall.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var choice in routeChoices)
        {
            <article class="route-choice-card">
                <span class="tag">@choice.Badge</span>
                <h3>@choice.Title</h3>
                <p>@choice.Summary</p>
                <div class="route-choice-card__details">
                    @foreach (var item in choice.Details)
                    {
                        <span>@item</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@choice.Href">@choice.Label</a>
            </article>
        }
    </div>
</section>

@if (rankedPublicCreatorPublications.Length > 0)
{
    <section class="artifact-gallery" id="public-detail-view">
        <div class="artifact-gallery__lead">
            <p class="eyebrow">Public publication detail</p>
            <h2 class="editorial-title">@governedDiscoveryTitle</h2>
            <p class="editorial-copy">@governedDiscoveryCopy</p>
            @if (publicationRouteReviewRequired)
            {
                <article class="route-callout">
                    <span class="tag">Limited public wording</span>
                    <h3>These publications are visible now, but some public comparison language still needs one more review pass.</h3>
                    <p>You can inspect the publication and background today. The remaining limit is about how broadly the public page should compare it, not whether the publication exists.</p>
                    <p>Public comparison language stays limited until the current review is finished.</p>
                    <div class="route-callout__details">
                        <span>Discoverable now</span>
                        <span>Comparison still reviewed</span>
                        <span>No fake closure</span>
                    </div>
                </article>
            }
        </div>
        <div class="artifact-gallery__grid">
            @foreach (var publication in rankedPublicCreatorPublications)
            {
                <article class="artifact-card">
                    <div class="artifact-card__copy">
                        <span class="tag">Shared publication</span>
                        <h3>@publication.Title</h3>
                        <p>@publication.Summary</p>
                        <div class="trust-claim__details">
                            <span>@HumanizeStatus(publication.PublicationStatus, "Published")</span>
                            <span>@HumanizeStatus(publication.TrustBand, "Draft")</span>
                            <span>@PublicationAvailabilityLabel(publication.Discoverable)</span>
                        </div>
                        <p><strong>Details:</strong> @PublicFacingCopyHumanizer.Clean(publication.ProvenanceSummary)</p>
                        <p><strong>Discovery:</strong> @publication.DiscoverySummary</p>
                        @if (!string.IsNullOrWhiteSpace(publication.TrustSummary))
                        {
                            <p><strong>Confidence:</strong> @publication.TrustSummary</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(publication.ComparisonSummary))
                        {
                            <p><strong>Compare by:</strong> @publication.ComparisonSummary</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(publication.LineageSummary))
                        {
                            <p><strong>History:</strong> @publication.LineageSummary</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(publication.ModerationSummary))
                        {
                            <p><strong>Moderation:</strong> @publication.ModerationSummary</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(publication.CampaignReturnSummary))
                        {
                            <p><strong>Return:</strong> @publication.CampaignReturnSummary</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(publication.NextSafeAction))
                        {
                            <p><strong>Next:</strong> @publication.NextSafeAction</p>
                        }
                        <a class="editorial-strip__action" href="@PublicCreatorPublicationHref(publication.PublicationId)">Open public publication</a>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (Model.Chrome.Authenticated && (signedInRecapShelf.Length > 0 || signedInCreatorPublications.Length > 0))
{
    <section class="continuity-band" id="signed-in-detail-view">
        <div class="continuity-band__copy">
            <p class="eyebrow">Signed-in account return view</p>
            <h2 class="editorial-title">@ArtifactViewTitle(selectedSignedInArtifactView)</h2>
            <p class="editorial-copy">@ArtifactViewSummary(selectedSignedInArtifactView)</p>
            <div class="stacked-actions">
                @foreach (var view in new[] { "all", "personal", "campaign", "creator", "public" })
                {
                    var selected = string.Equals(selectedSignedInArtifactView, view, StringComparison.Ordinal);
                    <a class="button-like @(selected ? "button-like--primary" : "button-like--ghost")" href="@ArtifactViewHref(view)">@ArtifactViewTitle(view)</a>
                }
            </div>
        </div>
        <div class="continuity-band__panel">
            <article class="continuity-band__fact">
                <span>Visible recap cards</span>
                <strong>@signedInRecapShelf.Length</strong>
                <p>Aftermath, replay, and Table Pulse Aftermath return items that stay in this signed-in view.</p>
            </article>
            <article class="continuity-band__fact">
                <span>Visible creator cards</span>
                <strong>@signedInCreatorPublications.Length</strong>
                <p>Creator-linked lineage, availability, and publication next steps in one place.</p>
            </article>
            <article class="continuity-band__fact">
                <span>Selected view</span>
                <strong>@ArtifactViewTitle(selectedSignedInArtifactView)</strong>
                <p>Switch views without losing the shared continuity story underneath them.</p>
            </article>
            <article class="continuity-band__fact">
                <span>Boundary</span>
                <strong>@(publicationRouteReviewRequired ? "Public wording still reviewed" : "Public wording ready now")</strong>
                <p>Signed-in account return can stay useful even while the public publication page is still limited.</p>
            </article>
        </div>
    </section>

    <section class="artifact-gallery">
        <div class="artifact-gallery__grid">
            @foreach (var item in signedInRecapShelf)
            {
                var linkedPublication = !string.IsNullOrWhiteSpace(item.CreatorPublicationId)
                    ? signedInCreatorPublications.FirstOrDefault(publication => string.Equals(publication.PublicationId, item.CreatorPublicationId, StringComparison.OrdinalIgnoreCase))
                    : null;
                <article class="artifact-card">
                    <div class="artifact-card__copy">
                        <span class="tag">Signed-in history</span>
                        <h3>@item.Label</h3>
                        <p>@item.Summary</p>
                        <div class="trust-claim__details">
                            <span>@PublicSurfaceStatus.AudienceLabel(item.Audience)</span>
                            @if (!string.IsNullOrWhiteSpace(item.PublicationState))
                            {
                                <span>@HumanizeStatus(item.PublicationState, "Ready")</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.TrustBand))
                            {
                                <span>@HumanizeStatus(item.TrustBand, "Draft")</span>
                                <span>@PublicationAvailabilityLabel(item.Discoverable)</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.OwnershipSummary))
                        {
                            <p><strong>Ownership:</strong> @item.OwnershipSummary</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.ProvenanceSummary))
                        {
                            <p><strong>Details:</strong> @PublicFacingCopyHumanizer.Clean(item.ProvenanceSummary)</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.AuditSummary))
                        {
                            <p><strong>Note:</strong> @PublicFacingCopyHumanizer.Clean(item.AuditSummary)</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.PublicationSummary))
                        {
                            <p><strong>Publication:</strong> @item.PublicationSummary</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(linkedPublication?.TrustSummary))
                        {
                            <p><strong>Confidence:</strong> @linkedPublication.TrustSummary</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(linkedPublication?.LineageSummary))
                        {
                            <p><strong>History:</strong> @linkedPublication.LineageSummary</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(linkedPublication?.CampaignReturnSummary))
                        {
                            <p><strong>Return:</strong> @linkedPublication.CampaignReturnSummary</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.NextSafeAction))
                        {
                            <p><strong>Next:</strong> @item.NextSafeAction</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(linkedPublication?.BuildHandoffId))
                        {
                            <a class="quiet-link" href="@BuildHandoffDetailHref(linkedPublication.BuildHandoffId)">Open build path for @linkedPublication.Title</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.CreatorPublicationId))
                        {
                            <a class="editorial-strip__action" href="@CreatorPublicationHref(linkedPublication, item.CreatorPublicationId)">@CreatorPublicationLinkLabel(linkedPublication)</a>
                        }
                    </div>
                </article>
            }
            @foreach (var publication in signedInCreatorPublications)
            {
                <article class="artifact-card">
                    <div class="artifact-card__copy">
                        <span class="tag">Creator-linked publication</span>
                        <h3>@publication.Title</h3>
                        <p>@publication.Summary</p>
                        <div class="trust-claim__details">
                            <span>@HumanizeStatus(publication.Visibility, "Shared")</span>
                            <span>@HumanizeStatus(publication.TrustBand, "Draft")</span>
                            <span>@PublicationAvailabilityLabel(publication.Discoverable)</span>
                        </div>
                        <p><strong>Details:</strong> @PublicFacingCopyHumanizer.Clean(publication.ProvenanceSummary)</p>
                        <p><strong>Discovery:</strong> @publication.DiscoverySummary</p>
                        @if (!string.IsNullOrWhiteSpace(publication.TrustSummary))
                        {
                            <p><strong>Confidence:</strong> @publication.TrustSummary</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(publication.ComparisonSummary))
                        {
                            <p><strong>Compare by:</strong> @publication.ComparisonSummary</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(publication.LineageSummary))
                        {
                            <p><strong>History:</strong> @publication.LineageSummary</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(publication.CampaignReturnSummary))
                        {
                            <p><strong>Return:</strong> @publication.CampaignReturnSummary</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(publication.SupportClosureSummary))
                        {
                            <p><strong>Support:</strong> @publication.SupportClosureSummary</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(publication.ModerationSummary))
                        {
                            <p><strong>Moderation:</strong> @publication.ModerationSummary</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(publication.NextSafeAction))
                        {
                            <p><strong>Next:</strong> @publication.NextSafeAction</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(publication.BuildHandoffId))
                        {
                            <a class="quiet-link" href="@BuildHandoffDetailHref(publication.BuildHandoffId)">Open build path for @publication.Title</a>
                        }
                        <a class="editorial-strip__action" href="@CreatorPublicationHref(publication, publication.PublicationId)">@CreatorPublicationLinkLabel(publication)</a>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (liveItems.Length > 0)
{
    <section class="artifact-gallery" id="current-detail-surfaces">
        <div class="artifact-gallery__lead">
            <p class="eyebrow">@PublicSurfaceStatus.AvailableToday</p>
            <h2 class="editorial-title">Current usable detail surfaces</h2>
            <p class="editorial-copy">These are the detail surfaces you can use or inspect today. They support the install decision; they do not replace downloads.</p>
        </div>
        <div class="artifact-gallery__grid">
            @foreach (var card in liveItems)
            {
                <article class="artifact-card">
                    @if (card.Asset is not null)
                    {
                        <div class="artifact-card__media">
                            @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", card.Asset)
                        </div>
                    }
                    <div class="artifact-card__copy">
                        <span class="tag @PublicSurfaceStatus.CssTone(card.Card.Badge)">@PublicSurfaceStatus.DisplayLabel(card.Card.Badge)</span>
                        <h3>@card.Card.Title</h3>
                        <p>@card.Card.Summary</p>
                        <div class="trust-claim__details">
                            <span>@PublicSurfaceStatus.AudienceLabel(card.Card.Audience)</span>
                            <span>@card.Action.Label</span>
                            @if (!string.IsNullOrWhiteSpace(card.Card.MicroProof))
                            {
                                <span>@PublicFacingCopyHumanizer.Clean(card.Card.MicroProof)</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(card.Card.Payoff))
                        {
                            <p><strong>What this shows:</strong> @card.Card.Payoff</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(card.Card.ProofNote))
                        {
                            <p><strong>Note:</strong> @PublicFacingCopyHumanizer.Clean(card.Card.ProofNote)</p>
                        }
                        <a class="editorial-strip__action" href="@card.Action.Href">@card.Action.Label</a>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (previewItems.Length > 0)
{
    <section class="editorial-block" id="preview-artifacts">
        <div class="editorial-block__lead">
            <p class="eyebrow">@PublicSurfaceStatus.PreviewInProgress</p>
            <h2 class="editorial-title">Opening next in the detail view</h2>
            <p class="editorial-copy">These future-facing detail surfaces stay visible so you can compare what is opening next against what is already usable today, without pretending they are live yet.</p>
        </div>
        <div class="compact-rail">
            @foreach (var card in previewItems)
            {
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <span class="tag @PublicSurfaceStatus.CssTone(card.Card.Badge)">@PublicSurfaceStatus.DisplayLabel(card.Card.Badge)</span>
                        <h3>@card.Card.Title</h3>
                        <p>@card.Card.Summary</p>
                        @if (!string.IsNullOrWhiteSpace(card.Card.Payoff))
                        {
                            <p><strong>Expected unlock:</strong> @card.Card.Payoff</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(card.Card.ProofNote))
                        {
                            <p><strong>Next:</strong> @PublicFacingCopyHumanizer.Clean(card.Card.ProofNote)</p>
                        }
                    </div>
                    <a class="editorial-strip__action" href="@card.Action.Href">@card.Action.Label</a>
                </article>
            }
        </div>
    </section>
}

@if (rankedPublicCreatorPublications.Length == 0 && liveItems.Length == 0 && previewItems.Length == 0)
{
    <section class="editorial-block">
        <article class="route-callout">
            <span class="tag">Temporarily thin view</span>
            <h3>The detail view is not populated on this request.</h3>
            <p>Use downloads for the live build, what works today for current product status, or help if you expected a specific file to be visible here already.</p>
            <div class="route-callout__actions">
                <a class="button-like button-like--secondary" href="/downloads">Open downloads</a>
                <a class="inline-link" href="/now">Open what works today</a>
            </div>
        </article>
    </section>
}

@model ShelfPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    var liveItems = Model.Items.Where(card => PublicSurfaceStatus.IsAvailableToday(card.Card.Badge)).ToArray();
    var previewItems = Model.Items.Except(liveItems).ToArray();
}

<section class="section-band">
    <div class="page-lead">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@Model.Intro</p>
    </div>
    <div class="stacked-actions">
        @if (liveItems.Length > 0)
        {
            <a class="button-like button-like--ghost" href="#live-artifacts">Available today</a>
        }
        @if (previewItems.Length > 0)
        {
            <a class="button-like button-like--ghost" href="#preview-artifacts">@PublicSurfaceStatus.PreviewInProgress</a>
        }
    </div>
    @await Html.PartialAsync("~/Views/Shared/_PublicStatusGlossary.cshtml")
    @if (liveItems.Length > 0)
    {
        <div class="editorial-block__lead" id="live-artifacts">
            <p class="eyebrow">@PublicSurfaceStatus.AvailableToday</p>
            <h2 class="editorial-title">Current proof surfaces</h2>
            <p class="editorial-copy">These are the artifacts you can use or inspect against the current preview today.</p>
        </div>
        <div class="shelf-stack">
            @foreach (var card in liveItems)
            {
                <article class="shelf-item">
                    @if (card.Asset is not null)
                    {
                        @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", card.Asset)
                    }
                    <span class="tag @PublicSurfaceStatus.CssTone(card.Card.Badge)">@PublicSurfaceStatus.DisplayLabel(card.Card.Badge)</span>
                    <h2>@card.Card.Title</h2>
                    <p>@card.Card.Summary</p>
                    <div class="trust-claim__microproof">
                        <span>@card.Card.Audience</span>
                        <span>@card.Action.Label</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(card.Card.Payoff))
                    {
                        <p class="muted-copy"><strong>What this verifies:</strong> @card.Card.Payoff</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(card.Card.ProofNote) || !string.IsNullOrWhiteSpace(card.Card.Payoff))
                    {
                        <p class="muted-copy">@(card.Card.ProofNote ?? card.Card.Payoff)</p>
                    }
                    <a class="inline-link" href="@card.Action.Href">@card.Action.Label</a>
                </article>
            }
        </div>
    }
    @if (previewItems.Length > 0)
    {
        <div class="editorial-block__lead" id="preview-artifacts">
            <p class="eyebrow">@PublicSurfaceStatus.PreviewInProgress</p>
            <h2 class="editorial-title">Proof surfaces still moving in preview</h2>
            <p class="editorial-copy">These stay visible so you can compare future-facing artifact work against what is already live today.</p>
        </div>
        <div class="shelf-stack">
            @foreach (var card in previewItems)
            {
                <article class="shelf-item">
                    @if (card.Asset is not null)
                    {
                        @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", card.Asset)
                    }
                    <span class="tag @PublicSurfaceStatus.CssTone(card.Card.Badge)">@PublicSurfaceStatus.DisplayLabel(card.Card.Badge)</span>
                    <h2>@card.Card.Title</h2>
                    <p>@card.Card.Summary</p>
                    <div class="trust-claim__microproof">
                        <span>@card.Card.Audience</span>
                        <span>@card.Action.Label</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(card.Card.Payoff))
                    {
                        <p class="muted-copy"><strong>Expected unlock:</strong> @card.Card.Payoff</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(card.Card.ProofNote) || !string.IsNullOrWhiteSpace(card.Card.Payoff))
                    {
                        <p class="muted-copy">@(card.Card.ProofNote ?? card.Card.Payoff)</p>
                    }
                    <a class="inline-link" href="@card.Action.Href">@card.Action.Label</a>
                </article>
            }
        </div>
    }
</section>

@model BlackLedgerHubPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-ledger";
    var commandMap = Model.CommandMap;
    var featuredEvent = commandMap?.Events.FirstOrDefault();
    var mapFocused = string.Equals(Model.CurrentSection, "map", StringComparison.OrdinalIgnoreCase);
    var selectedFaction = Model.SelectedFaction;
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@Model.Intro</p>
        @if (mapFocused)
        {
            <div class="trust-claim__microproof" aria-label="Map route focus">
                <span>Focused route: /ledger/map</span>
                <span>Command map section pinned below</span>
            </div>
        }
        <div class="trust-claim__microproof">
            <span>Opt-in aggregate only</span>
            <span>No player identities</span>
            <span>No support or internal-staff leakage</span>
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--@Model.PrimaryAction.Tone" href="@Model.PrimaryAction.Href">@Model.PrimaryAction.Label</a>
        <a class="button-like button-like--@Model.SecondaryAction.Tone" href="@Model.SecondaryAction.Href">@Model.SecondaryAction.Label</a>
    </div>
</section>

@if (Model.NewsreelStatus is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Turn @Model.NewsreelStatus.Turn newsreel</p>
            <h2 class="editorial-title">@Model.NewsreelStatus.StatusLabel</h2>
            <p class="editorial-copy">@Model.NewsreelStatus.Summary</p>
        </div>
        <div class="trust-claim__microproof">
            <span>Scope: @Model.NewsreelStatus.ScopeLabel</span>
            <span>Policy: @Model.NewsreelStatus.Policy</span>
            <span>Receipts: @Model.NewsreelStatus.ReceiptCount</span>
        </div>
        <div class="stacked-actions">
            <a class="button-like button-like--secondary" href="@Model.NewsreelStatus.DispatchHref">Open dispatch lane</a>
            <a class="button-like button-like--secondary" href="@Model.NewsreelStatus.NotificationsHref">Open notification status</a>
        </div>
    </section>
}

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Modules</p>
        <h2 class="editorial-title">One hub, bounded public modules.</h2>
        <p class="editorial-copy">Turn 1 already ran. Each lane stays explicit about what is preview, what is aggregate, and what cannot be shown on a public route.</p>
    </div>
    @if (Model.World?.TurnNavigation?.Count > 0)
    {
        <div class="trust-claim__microproof" aria-label="Turn navigation">
            @foreach (var turn in Model.World.TurnNavigation)
            {
                <a class="inline-link" href="@turn.Href">@(turn.Current ? $"{turn.Label} (current)" : turn.Label)</a>
            }
        </div>
    }
    <div class="route-choice-grid">
        @foreach (var module in Model.Modules)
        {
            <article class="route-choice-card">
                <span class="tag">@module.StatusLabel</span>
                <h3>@module.Title</h3>
                <p>@module.Summary</p>
                <a class="editorial-strip__action" href="@module.Href">Open module</a>
            </article>
        }
    </div>
</section>

@if (Model.World is not null)
{
    <section class="editorial-block@(mapFocused ? " editorial-block--focused" : string.Empty)" id="ledger-map" tabindex="-1">
        <div class="editorial-block__lead">
            <p class="eyebrow">World map</p>
            <h2 class="editorial-title">@Model.World.PublicName</h2>
            <p class="editorial-copy">@Model.World.TurnHeadline</p>
            <p class="muted-copy">@Model.World.MapNote</p>
        </div>
        <div class="ledger-command-map" data-current-mode="@(commandMap?.CurrentMode ?? "influence")">
            @if (commandMap is not null)
            {
                <div class="ledger-command-map__toolbar">
                    <div class="ledger-command-map__modes" role="tablist" aria-label="Ledger map modes">
                        @foreach (var mode in commandMap.Modes)
                        {
                            <button type="button" class="ledger-command-map__mode-button@(mode.Active ? " is-active" : string.Empty)" data-map-mode="@mode.Id" aria-pressed="@(mode.Active ? "true" : "false")" title="@mode.Summary">@mode.Label</button>
                        }
                    </div>
                    <div class="ledger-command-map__replay" aria-label="Tick replay">
                        @foreach (var step in commandMap.ReplaySteps)
                        {
                            <a class="ledger-command-map__step@(step.Current ? " is-current" : string.Empty)" href="/ledger/turns/@step.Turn">@(step.Label)</a>
                        }
                    </div>
                </div>
            }
            <div class="ledger-command-map__shell">
                <div class="ledger-world-shell__map ledger-command-map__map">
                    <svg viewBox="0 0 1200 760" role="img" aria-label="@Model.World.PublicName command map">
                        <g class="ledger-command-map__grid" aria-hidden="true">
                            <line x1="0" y1="180" x2="1200" y2="180"></line>
                            <line x1="0" y1="380" x2="1200" y2="380"></line>
                            <line x1="0" y1="580" x2="1200" y2="580"></line>
                            <line x1="240" y1="0" x2="240" y2="760"></line>
                            <line x1="600" y1="0" x2="600" y2="760"></line>
                            <line x1="920" y1="0" x2="920" y2="760"></line>
                        </g>
                        @if (commandMap is not null)
                        {
                            <g class="ledger-command-map__arcs" aria-hidden="true">
                                @foreach (var arc in commandMap.Arcs)
                                {
                                    var source = Model.World.Districts.FirstOrDefault(item => item.Id == arc.SourceRegionId);
                                    var target = Model.World.Districts.FirstOrDefault(item => item.Id == arc.TargetRegionId);
                                    if (source is not null && target is not null)
                                    {
                                        <line class="ledger-command-map__arc ledger-command-map__arc--@arc.ArcType" data-arc-type="@arc.ArcType" x1="@source.CenterX" y1="@source.CenterY" x2="@target.CenterX" y2="@target.CenterY">
                                            <title>@arc.Summary</title>
                                        </line>
                                    }
                                }
                            </g>
                        }
                        @foreach (var district in Model.World.Districts)
                        {
                            <a href="#district-@district.Id" aria-label="@district.Summary" data-region-link="@district.Id">
                                <polygon class="ledger-world-shell__district ledger-command-map__district" data-region-id="@district.Id" data-dominant-faction="@district.DominantFaction" data-region-heat="@district.Heat" data-region-influence="@district.Influence" data-region-summary="@district.Summary" points="@district.PolygonPoints" tabindex="0">
                                    <title>@district.Name</title>
                                    <desc>@district.Summary</desc>
                                </polygon>
                            </a>
                        }
                        @if (commandMap is not null)
                        {
                            <g class="ledger-command-map__events">
                                @foreach (var item in commandMap.Events)
                                {
                                    <a href="#district-@item.RegionId" aria-label="@item.Summary" data-event-link="@item.EventId">
                                        <circle class="ledger-command-map__event ledger-command-map__event--@item.EventType@(item.NewThisTurn ? " is-new" : string.Empty)" cx="@item.X" cy="@item.Y" r="12" data-event-id="@item.EventId" data-region-id="@item.RegionId" data-event-title="@item.Title" data-event-summary="@item.Summary" data-event-status="@item.Status" data-event-severity="@item.Severity" tabindex="0">
                                            <title>@item.Title</title>
                                        </circle>
                                    </a>
                                }
                            </g>
                        }
                    </svg>
                    <p class="muted-copy">@((commandMap?.AccessibilityNote) ?? "Keyboard focus works on each district shape, and every shape mirrors a text summary card below.")</p>
                </div>
                <aside class="ledger-command-map__panel" aria-live="polite">
                    <span class="tag">Faction intel</span>
                    <h3 class="ledger-command-map__panel-title">@(featuredEvent?.Title ?? Model.World.Districts.First().Name)</h3>
                    <p class="ledger-command-map__panel-summary">@(featuredEvent?.Summary ?? Model.World.Districts.First().Summary)</p>
                    <div class="trust-claim__microproof">
                        <span>Mode: @(commandMap?.CurrentMode ?? "influence")</span>
                        <span>Receipt: @(featuredEvent?.SourceReceiptId ?? Model.World.LastTick?.ReceiptId)</span>
                        <span>@((commandMap?.PublicSafetyNote) ?? Model.World.SafetyNote)</span>
                    </div>
                    @* "Open linked dispatch" link disabled: dispatch route not functioning correctly *@
                    @* @if (featuredEvent?.DispatchHref is not null && Model.Dispatches.Any(d => string.Equals(d.Href, featuredEvent.DispatchHref, StringComparison.OrdinalIgnoreCase)))
                    {
                        <a class="inline-link" href="@featuredEvent.DispatchHref">Open linked dispatch</a>
                    } *@
                    <a class="inline-link" href="/ledger/closeouts">Open receipt lane</a>
                    <p class="muted-copy">@((commandMap?.PerformanceNote) ?? "SVG fallback stays first-party and bounded.")</p>
                </aside>
            </div>
            <div class="ledger-world-shell__districts">
                @foreach (var district in Model.World.Districts)
                {
                    <article class="route-choice-card" id="district-@district.Id">
                        <span class="tag">@district.DominantFaction</span>
                        <h3>@district.Name</h3>
                        <p>@district.Summary</p>
                        <p class="muted-copy">Influence @district.Influence · Heat @district.Heat · Confidence @district.Confidence · Trend @district.Trend</p>
                    </article>
                }
            </div>
        </div>
    </section>

    <section class="editorial-block" id="ledger-factions">
        <div class="editorial-block__lead">
            <p class="eyebrow">Faction intel</p>
            <h2 class="editorial-title">Six starter factions, bounded public signals.</h2>
            <p class="editorial-copy">AI interim stewards can summarize pressure, but every public lane stays privacy-bounded and receipt-backed.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var faction in Model.World.Factions)
            {
                <article class="route-choice-card">
                    <span class="tag">@faction.Type</span>
                    <h3>@faction.PublicName</h3>
                    <p>Leader: @faction.FactionLeader · GM: @faction.FieldGm · Intel: @faction.IntelProvider</p>
                    <div class="route-choice-card__proof">
                        @foreach (var signal in faction.PublicSignals)
                        {
                            <span>@signal</span>
                        }
                    </div>
                    <a class="editorial-strip__action" href="/ledger/factions/@faction.Id.Replace('_', '-')">Open faction file</a>
                </article>
            }
        </div>
    </section>

    @if (selectedFaction is not null)
    {
        var factionDistricts = Model.World.Districts
            .Where(district => string.Equals(district.DominantFaction.Replace(' ', '-'), selectedFaction.Id.Replace('_', '-'), StringComparison.OrdinalIgnoreCase))
            .ToArray();
        <section class="editorial-block" id="ledger-faction-file">
            <div class="editorial-block__lead">
                <p class="eyebrow">Faction file</p>
                <h2 class="editorial-title">@selectedFaction.PublicName</h2>
                <p class="editorial-copy">@selectedFaction.PublicName stays public-safe here: identity, visible district pressure, AI steward posture, package heat, latest dispatches, and turn-backed links only.</p>
                <div class="trust-claim__microproof">
                    <span>Faction type: @selectedFaction.Type</span>
                    <span>Map focus: @(factionDistricts.FirstOrDefault()?.Name ?? "Cross-district pressure")</span>
                    <span>Current turn: @Model.World.CurrentTurn</span>
                </div>
            </div>
            <div class="route-choice-grid">
                <article class="route-choice-card">
                    <span class="tag">Identity</span>
                    <h3>Visible operating posture</h3>
                    <p>@selectedFaction.PublicName is tracked as @selectedFaction.Type with bounded public-safe signals only.</p>
                    <div class="route-choice-card__proof">
                        @foreach (var signal in selectedFaction.PublicSignals)
                        {
                            <span>@signal</span>
                        }
                    </div>
                </article>
                <article class="route-choice-card">
                    <span class="tag">AI stewards</span>
                    <h3>Named interim roles</h3>
                    <p>Leader: @selectedFaction.FactionLeader · GM: @selectedFaction.FieldGm · Intel: @selectedFaction.IntelProvider</p>
                    <p class="muted-copy">Interim AI stewards may summarize or redact. Verified humans outrank them.</p>
                </article>
                <article class="route-choice-card">
                    <span class="tag">Package pressure</span>
                    <h3>Governed package demand</h3>
                    <p>Faction-linked package pressure stays visible as demand and closeout heat, not shipped truth.</p>
                    <a class="editorial-strip__action" href="/ledger/packages">Open package pressure</a>
                </article>
                <article class="route-choice-card">
                    <span class="tag">Turn history</span>
                    <h3>Replay and dispatch trail</h3>
                    <p>Jump from this faction file into the turn replay, the district map, or the filtered dispatch archive.</p>
                    <div class="trust-claim__microproof">
                        <a class="inline-link" href="/ledger/map#ledger-map">Open map focus</a>
                        <a class="inline-link" href="/ledger/factions/@selectedFaction.Id.Replace('_', '-')/dispatches">Open faction dispatches</a>
                        <a class="inline-link" href="/ledger/turns/1">Open Turn 1</a>
                    </div>
                </article>
                @if (Model.SelectedFactionPromo is not null)
                {
                    <article class="route-choice-card">
                        <span class="tag">@Model.SelectedFactionPromo.ProviderStatus</span>
                        <h3>Onboarding promo fallback</h3>
                        <p>This faction ships a route-backed fallback artifact instead of an unverified external render claim.</p>
                        <div class="route-choice-card__proof">
                            @foreach (var format in Model.SelectedFactionPromo.FormatLabels)
                            {
                                <span>@format</span>
                            }
                        </div>
                        <div class="trust-claim__microproof">
                            <a class="inline-link" href="@Model.SelectedFactionPromo.HtmlHref">Open promo brief</a>
                            <a class="inline-link" href="@Model.SelectedFactionPromo.JsonHref">Open JSON brief</a>
                            <a class="inline-link" href="@Model.SelectedFactionPromo.CaptionsHref">Open captions</a>
                        </div>
                    </article>
                }
            </div>
            @if (factionDistricts.Length > 0)
            {
                <div class="ledger-world-shell__districts">
                    @foreach (var district in factionDistricts)
                    {
                        <article class="route-choice-card">
                            <span class="tag">Map focus</span>
                            <h3>@district.Name</h3>
                            <p>@district.Summary</p>
                            <p class="muted-copy">Influence @district.Influence · Heat @district.Heat · Trend @district.Trend</p>
                        </article>
                    }
                </div>
            }
        </section>
    }

    @if (Model.World.StewardshipPosts.Count > 0)
    {
        <section class="editorial-block" id="ledger-stewardship">
            <div class="editorial-block__lead">
                <p class="eyebrow">AI stewardship</p>
                <h2 class="editorial-title">Interim bots run bounded posts until verified humans take over.</h2>
                <p class="editorial-copy">These posts may propose, summarize, and redact. They do not outrank human stewards, and they do not become release truth by themselves.</p>
            </div>
            <div class="route-choice-grid">
                @foreach (var post in Model.World.StewardshipPosts)
                {
                    <article class="route-choice-card">
                        <span class="tag">@post.HolderType</span>
                        <h3>@post.PublicLabel</h3>
                        <p>@post.PublicSummary</p>
                        <p class="muted-copy">Fallback personality: @post.FallbackPersonality</p>
                    </article>
                }
            </div>
            @if (Model.World.StewardshipTransferPreview is not null)
            {
                <article class="trust-claim">
                    <span class="tag">Stewardship transfer preview</span>
                    <h3>@Model.World.StewardshipTransferPreview.ReceiptType</h3>
                    <p>@Model.World.StewardshipTransferPreview.Reason</p>
                    <div class="trust-claim__microproof">
                        <span>Post: @Model.World.StewardshipTransferPreview.PostId</span>
                        <span>Old holder: @Model.World.StewardshipTransferPreview.OldHolder</span>
                        <span>New holder: @Model.World.StewardshipTransferPreview.NewHolderType</span>
                        <span>Visibility: @Model.World.StewardshipTransferPreview.PublicVisibility</span>
                    </div>
                </article>
            }
        </section>
    }
}

<section class="trust-claims" id="ledger-stats">
    <div class="trust-claims__lead">
        <p class="eyebrow">Public-safe stats</p>
        <h2 class="editorial-title">Aggregate only. Opt-in only. Proof-bounded.</h2>
        <p class="editorial-copy">These preview stats are derived from the seeded Emerald Sprawl world model, not hardcoded in the page. If a stat is not public-safe, it does not render here. fictional runner/campaign statistics only.</p>
    </div>
    <div class="trust-claims__grid">
        @foreach (var stat in Model.Stats)
        {
            <article class="trust-claim" id="@stat.Id">
                <span class="tag">@stat.Confidence</span>
                <h3>@stat.Title</h3>
                <p class="trust-claim__value"><strong>@stat.Value</strong></p>
                <p>@stat.Scope · @stat.Period</p>
                <div class="trust-claim__microproof">
                    <span>@stat.SampleSize</span>
                    <span>@stat.PrivacyNote</span>
                </div>
                <p class="muted-copy">@stat.SourceDetail.Label · @stat.SourceDetail.ProvenanceSummary</p>
                <a class="inline-link" href="@stat.Href">Inspect lane</a>
            </article>
        }
    </div>
</section>

@if (Model.World?.LastTick is not null)
{
    <section class="editorial-block" id="ledger-last-tick">
        <div class="editorial-block__lead">
            <p class="eyebrow">Last tick receipt</p>
            <h2 class="editorial-title">@Model.World.LastTick.ReceiptId</h2>
            <p class="editorial-copy">@Model.World.LastTick.Summary</p>
            <p class="muted-copy">World: @Model.World.LastTick.WorldId · Turn: @Model.World.LastTick.Turn · Mode: @Model.World.LastTick.Mode</p>
            <div class="trust-claim__microproof">
                <span>Input hash: @Model.World.LastTick.InputStateHash[..12]</span>
                <span>Decision hash: @Model.World.LastTick.DecisionPacketHash[..12]</span>
                <span>Output hash: @Model.World.LastTick.OutputStateHash[..12]</span>
                <span>Created: @Model.World.LastTick.CreatedAtUtc</span>
            </div>
        </div>
        <div class="route-choice-grid">
            @foreach (var effect in Model.World.LastTick.Effects)
            {
                <article class="route-choice-card">
                    <span class="tag">@effect.Target</span>
                    <h3>@effect.Metric</h3>
                    <p>Delta: @effect.Delta</p>
                    <p>@effect.PublicReason</p>
                </article>
            }
        </div>
    </section>
}

@if (Model.Dispatches.Count > 0)
{
    <section class="editorial-block" id="ledger-dispatches">
        <div class="editorial-block__lead">
            <p class="eyebrow">Latest dispatches</p>
            <h2 class="editorial-title">Receipt-backed narrative, not free-floating lore.</h2>
            <p class="editorial-copy">Every dispatch is generated from a world tick, public-safe pressure change, or closeout-facing movement. No private table data, no sourcebook text, and no internal pipeline details.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var dispatch in Model.Dispatches)
            {
                <article class="route-choice-card">
                    <span class="tag">@dispatch.Type</span>
                    <h3>@dispatch.Title</h3>
                    <p>@dispatch.Summary</p>
                    <div class="route-choice-card__proof">
                        <span>Receipt @dispatch.SourceReceiptId</span>
                        <span>Turn @dispatch.Turn</span>
                        <span>@dispatch.PrivacyStatus</span>
                    </div>
                    <a class="editorial-strip__action" href="@dispatch.Href">Read dispatch</a>
                </article>
            }
        </div>
        @if (Model.SelectedDispatch is not null)
        {
            <article class="trust-claim" id="dispatch-@Model.SelectedDispatch.DispatchId">
                <span class="tag">Dispatch detail</span>
                <h3>@Model.SelectedDispatch.Title</h3>
                @foreach (var paragraph in Model.SelectedDispatch.Body.Split("\n\n", StringSplitOptions.RemoveEmptyEntries))
                {
                    <p>@paragraph</p>
                }
                <div class="trust-claim__microproof">
                    <span>Generated from @Model.SelectedDispatch.SourceReceiptId</span>
                    <span>@Model.SelectedDispatch.Scope</span>
                    <span>Human review: @Model.SelectedDispatch.HumanReviewStatus</span>
                </div>
                @if (Model.SelectedDispatch.InvolvedFactions.Count > 0)
                {
                    <p class="muted-copy">Factions: @string.Join(", ", Model.SelectedDispatch.InvolvedFactions)</p>
                }
                @if (Model.SelectedDispatch.InvolvedDistricts.Count > 0)
                {
                    <p class="muted-copy">Districts: @string.Join(", ", Model.SelectedDispatch.InvolvedDistricts)</p>
                }
                <div class="trust-claim__microproof">
                    <a class="inline-link" href="@Model.SelectedDispatch.SourceReceiptHref">Open receipt lane</a>
                    @foreach (var link in Model.SelectedDispatch.PackagePressureLinks.Distinct())
                    {
                        <a class="inline-link" href="@link">Open linked lane</a>
                    }
                </div>
            </article>
        }
    </section>
}

<section class="editorial-block" id="ledger-privacy">
    <div class="editorial-block__lead">
        <p class="eyebrow">Privacy boundary</p>
        <h2 class="editorial-title">This page explains pressure, not people.</h2>
        <p class="editorial-copy">Seeded preview and opt-in aggregate only. No runner names, no support cases, no internal-staff addresses, no sourcebook text, and no campaign-private state are allowed on the public Ledger routes.</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">Allowed</span>
            <h3>Opt-in aggregate pressure</h3>
            <p>Season snapshots, package heat, and closeout motion can render when the data is aggregated and privacy-safe.</p>
        </article>
        <article class="route-choice-card">
            <span class="tag">Blocked</span>
            <h3>Private or identifying detail</h3>
            <p>Individual runners, support traffic, private missions, account state, and hidden campaign levers fail closed instead of leaking into the public hub.</p>
        </article>
    </div>
</section>

<section class="compact-rail" id="ledger-closeouts">
    @foreach (var item in Model.Closeouts)
    {
        <article class="compact-rail__item">
            <div class="compact-rail__copy">
                <h3>@item.Title</h3>
                <p>@item.Summary</p>
                <p class="muted-copy">@item.StatusLabel</p>
                <a class="inline-link" href="@item.Href">Open lane</a>
            </div>
        </article>
    }
</section>

<script>
(() => {
  const mapFocused = @Html.Raw(mapFocused ? "true" : "false");
  if (mapFocused) {
    const mapSection = document.getElementById('ledger-map');
    if (mapSection) {
      queueMicrotask(() => {
        mapSection.scrollIntoView({ behavior: 'auto', block: 'start' });
        mapSection.focus({ preventScroll: true });
      });
    }
  }

  const root = document.querySelector('.ledger-command-map');
  if (!root) return;
  const panelTitle = document.querySelector('.ledger-command-map__panel-title');
  const panelSummary = document.querySelector('.ledger-command-map__panel-summary');
  const buttons = Array.from(root.querySelectorAll('[data-map-mode]'));
  const regions = Array.from(root.querySelectorAll('[data-region-id]'));
  const eventNodes = Array.from(root.querySelectorAll('[data-event-id]'));

  const applyMode = (mode) => {
    root.dataset.currentMode = mode;
    buttons.forEach((button) => {
      const active = button.dataset.mapMode === mode;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
  };

  buttons.forEach((button) => {
    button.addEventListener('click', () => applyMode(button.dataset.mapMode || 'influence'));
  });

  regions.forEach((region) => {
    region.addEventListener('focus', () => {
      if (panelTitle) panelTitle.textContent = region.getAttribute('data-region-id')?.replaceAll('-', ' ') || 'Region';
      if (panelSummary) panelSummary.textContent = region.getAttribute('data-region-summary') || '';
    });
    region.addEventListener('mouseenter', () => region.dispatchEvent(new FocusEvent('focus')));
  });

  eventNodes.forEach((eventNode) => {
    eventNode.addEventListener('focus', () => {
      if (panelTitle) panelTitle.textContent = eventNode.getAttribute('data-event-title') || 'Event';
      if (panelSummary) panelSummary.textContent = eventNode.getAttribute('data-event-summary') || '';
    });
    eventNode.addEventListener('mouseenter', () => eventNode.dispatchEvent(new FocusEvent('focus')));
  });
})();
</script>

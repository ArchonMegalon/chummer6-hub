@model BlackLedgerHubPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-ledger";
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@Model.Intro</p>
        <div class="trust-claim__microproof">
            <span>Opt-in aggregate only</span>
            <span>No player identities</span>
            <span>No support or internal-staff leakage</span>
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--@Model.PrimaryAction.Tone" href="@Model.PrimaryAction.Href">@Model.PrimaryAction.Label</a>
        <a class="button-like button-like--@Model.SecondaryAction.Tone" href="@Model.SecondaryAction.Href">@Model.SecondaryAction.Label</a>
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Modules</p>
        <h2 class="editorial-title">One hub, bounded public modules.</h2>
        <p class="editorial-copy">Turn 1 already ran. Each lane stays explicit about what is preview, what is aggregate, and what cannot be shown on a public route.</p>
    </div>
    @if (Model.World?.TurnNavigation?.Count > 0)
    {
        <div class="trust-claim__microproof" aria-label="Turn navigation">
            @foreach (var turn in Model.World.TurnNavigation)
            {
                <a class="inline-link" href="@turn.Href">@(turn.Current ? $"{turn.Label} (current)" : turn.Label)</a>
            }
        </div>
    }
    <div class="route-choice-grid">
        @foreach (var module in Model.Modules)
        {
            <article class="route-choice-card">
                <span class="tag">@module.StatusLabel</span>
                <h3>@module.Title</h3>
                <p>@module.Summary</p>
                <a class="editorial-strip__action" href="@module.Href">Open module</a>
            </article>
        }
    </div>
</section>

@if (Model.World is not null)
{
    <section class="editorial-block" id="ledger-map">
        <div class="editorial-block__lead">
            <p class="eyebrow">World map</p>
            <h2 class="editorial-title">@Model.World.PublicName</h2>
            <p class="editorial-copy">@Model.World.TurnHeadline</p>
            <p class="muted-copy">@Model.World.MapNote</p>
        </div>
        <div class="ledger-world-shell">
            <div class="ledger-world-shell__map">
                <svg viewBox="0 0 1200 760" role="img" aria-label="@Model.World.PublicName map">
                    @foreach (var district in Model.World.Districts)
                    {
                        <a href="#district-@district.Id" aria-label="@district.Summary">
                            <polygon class="ledger-world-shell__district" points="@district.PolygonPoints" tabindex="0">
                                <title>@district.Name</title>
                                <desc>@district.Summary</desc>
                            </polygon>
                        </a>
                    }
                </svg>
                <p class="muted-copy">Keyboard focus works on each district shape, and every shape mirrors a text summary card below.</p>
            </div>
            <div class="ledger-world-shell__districts">
                @foreach (var district in Model.World.Districts)
                {
                    <article class="route-choice-card" id="district-@district.Id">
                        <span class="tag">@district.DominantFaction</span>
                        <h3>@district.Name</h3>
                        <p>@district.Summary</p>
                        <p class="muted-copy">Influence @district.Influence · Heat @district.Heat</p>
                    </article>
                }
            </div>
        </div>
    </section>

    <section class="editorial-block" id="ledger-factions">
        <div class="editorial-block__lead">
            <p class="eyebrow">Faction intel</p>
            <h2 class="editorial-title">Six starter factions, bounded public signals.</h2>
            <p class="editorial-copy">AI interim stewards can summarize pressure, but every public lane stays privacy-bounded and receipt-backed.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var faction in Model.World.Factions)
            {
                <article class="route-choice-card">
                    <span class="tag">@faction.Type</span>
                    <h3>@faction.PublicName</h3>
                    <p>Leader: @faction.FactionLeader · GM: @faction.FieldGm · Intel: @faction.IntelProvider</p>
                    <div class="route-choice-card__proof">
                        @foreach (var signal in faction.PublicSignals)
                        {
                            <span>@signal</span>
                        }
                    </div>
                </article>
            }
        </div>
    </section>

    @if (Model.World.StewardshipPosts.Count > 0)
    {
        <section class="editorial-block" id="ledger-stewardship">
            <div class="editorial-block__lead">
                <p class="eyebrow">AI stewardship</p>
                <h2 class="editorial-title">Interim bots run bounded posts until verified humans take over.</h2>
                <p class="editorial-copy">These posts may propose, summarize, and redact. They do not outrank human stewards, and they do not become release truth by themselves.</p>
            </div>
            <div class="route-choice-grid">
                @foreach (var post in Model.World.StewardshipPosts)
                {
                    <article class="route-choice-card">
                        <span class="tag">@post.HolderType</span>
                        <h3>@post.PublicLabel</h3>
                        <p>@post.PublicSummary</p>
                        <p class="muted-copy">Fallback personality: @post.FallbackPersonality</p>
                    </article>
                }
            </div>
            @if (Model.World.StewardshipTransferPreview is not null)
            {
                <article class="trust-claim">
                    <span class="tag">Stewardship transfer preview</span>
                    <h3>@Model.World.StewardshipTransferPreview.ReceiptType</h3>
                    <p>@Model.World.StewardshipTransferPreview.Reason</p>
                    <div class="trust-claim__microproof">
                        <span>Post: @Model.World.StewardshipTransferPreview.PostId</span>
                        <span>Old holder: @Model.World.StewardshipTransferPreview.OldHolder</span>
                        <span>New holder: @Model.World.StewardshipTransferPreview.NewHolderType</span>
                        <span>Visibility: @Model.World.StewardshipTransferPreview.PublicVisibility</span>
                    </div>
                </article>
            }
        </section>
    }
}

<section class="trust-claims" id="ledger-stats">
    <div class="trust-claims__lead">
        <p class="eyebrow">Public-safe stats</p>
        <h2 class="editorial-title">Aggregate only. Opt-in only. Proof-bounded.</h2>
        <p class="editorial-copy">These preview stats are derived from the seeded Emerald Sprawl world model, not hardcoded in the page. If a stat is not public-safe, it does not render here. fictional runner/campaign statistics only.</p>
    </div>
    <div class="trust-claims__grid">
        @foreach (var stat in Model.Stats)
        {
            <article class="trust-claim" id="@stat.Id">
                <span class="tag">@stat.Confidence</span>
                <h3>@stat.Title</h3>
                <p class="trust-claim__value"><strong>@stat.Value</strong></p>
                <p>@stat.Scope · @stat.Period</p>
                <div class="trust-claim__microproof">
                    <span>@stat.SampleSize</span>
                    <span>@stat.PrivacyNote</span>
                </div>
                <p class="muted-copy">@stat.SourceDetail.Label · @stat.SourceDetail.ProvenanceSummary</p>
                <a class="inline-link" href="@stat.Href">Inspect lane</a>
            </article>
        }
    </div>
</section>

@if (Model.World?.LastTick is not null)
{
    <section class="editorial-block" id="ledger-last-tick">
        <div class="editorial-block__lead">
            <p class="eyebrow">Last tick receipt</p>
            <h2 class="editorial-title">@Model.World.LastTick.ReceiptId</h2>
            <p class="editorial-copy">@Model.World.LastTick.Summary</p>
            <p class="muted-copy">World: @Model.World.LastTick.WorldId · Turn: @Model.World.LastTick.Turn · Mode: @Model.World.LastTick.Mode</p>
            <div class="trust-claim__microproof">
                <span>Input hash: @Model.World.LastTick.InputStateHash[..12]</span>
                <span>Decision hash: @Model.World.LastTick.DecisionPacketHash[..12]</span>
                <span>Output hash: @Model.World.LastTick.OutputStateHash[..12]</span>
                <span>Created: @Model.World.LastTick.CreatedAtUtc</span>
            </div>
        </div>
        <div class="route-choice-grid">
            @foreach (var effect in Model.World.LastTick.Effects)
            {
                <article class="route-choice-card">
                    <span class="tag">@effect.Target</span>
                    <h3>@effect.Metric</h3>
                    <p>Delta: @effect.Delta</p>
                    <p>@effect.PublicReason</p>
                </article>
            }
        </div>
    </section>
}

<section class="editorial-block" id="ledger-privacy">
    <div class="editorial-block__lead">
        <p class="eyebrow">Privacy boundary</p>
        <h2 class="editorial-title">This page explains pressure, not people.</h2>
        <p class="editorial-copy">Seeded preview and opt-in aggregate only. No runner names, no support cases, no internal-staff addresses, no sourcebook text, and no campaign-private state are allowed on the public Ledger routes.</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">Allowed</span>
            <h3>Opt-in aggregate pressure</h3>
            <p>Season snapshots, package heat, and closeout motion can render when the data is aggregated and privacy-safe.</p>
        </article>
        <article class="route-choice-card">
            <span class="tag">Blocked</span>
            <h3>Private or identifying detail</h3>
            <p>Individual runners, support traffic, private missions, account state, and hidden campaign levers fail closed instead of leaking into the public hub.</p>
        </article>
    </div>
</section>

<section class="compact-rail" id="ledger-closeouts">
    @foreach (var item in Model.Closeouts)
    {
        <article class="compact-rail__item">
            <div class="compact-rail__copy">
                <h3>@item.Title</h3>
                <p>@item.Summary</p>
                <p class="muted-copy">@item.StatusLabel</p>
                <a class="inline-link" href="@item.Href">Open lane</a>
            </div>
        </article>
    }
</section>

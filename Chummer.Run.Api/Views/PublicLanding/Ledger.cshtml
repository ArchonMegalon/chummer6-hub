@model BlackLedgerHubPageViewModel
@using System.Globalization
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-ledger";
    var commandMap = Model.CommandMap;
    var mapFocused = string.Equals(Model.CurrentSection, "map", StringComparison.OrdinalIgnoreCase);
    var selectedFaction = Model.SelectedFaction;
    var selectedFactionSlug = selectedFaction is null ? string.Empty : selectedFaction.Id.Replace('_', '-');
    var selectedTurn = Model.World?.CurrentTurn ?? 1;
    if (Context.Request.Query.TryGetValue("turn", out var requestedTurnValues)
        && int.TryParse(requestedTurnValues.FirstOrDefault(), out var requestedTurn)
        && requestedTurn > 0)
    {
        selectedTurn = requestedTurn;
    }
    var selectedDispatch = Model.SelectedDispatch;
    var worldTurnBriefing = Model.WorldTurnBriefing;
    var newsreelBroadcast = worldTurnBriefing?.Broadcast;
    var accountCtaHref = Model.Chrome.Authenticated ? "/account/ledger/onboarding" : "/login?next=%2Faccount%2Fledger%2Fonboarding";
    var accountCtaLabel = Model.Chrome.Authenticated ? "Open onboarding" : "Join a faction";

    Func<string, string> factionSlug = id => id.Replace('_', '-');
    Func<string, string> logoHref = id => $"/media/ledger/factions/{factionSlug(id)}-logo.svg";
    Func<string, string> backgroundHref = id => $"/media/ledger/factions/{factionSlug(id)}-bg.svg";
    Func<string, string> introLine = id => factionSlug(id) switch
    {
        "glass-tower-compact" => "Welcome to calm. If you can afford it.",
        "rust-market-syndicate" => "Everything is available. Nothing is free.",
        "ashline-circle" => "Power is easy. Control is hard.",
        "neon-docks-union" => "Routes move. Drones complain. We keep the city breathing.",
        "ghostline-network" => "If you heard it, test it. If it holds, redact it.",
        "barrens-free-wardens" => "Less nuyen. More backbone.",
        _ => "Pressure moves faster than certainty."
    };
    Func<string, string[]> ledgerLabels = id => factionSlug(id) switch
    {
        "glass-tower-compact" => ["Permit Leverage", "Public Trust", "Contract Capture", "Debt Shield"],
        "rust-market-syndicate" => ["Debt Heat", "Gear Flow", "Favor Load", "Recovery Work"],
        "ashline-circle" => ["MysAd Density", "Magic Pressure", "Signal Clarity", "Drain Risk"],
        "neon-docks-union" => ["Route Control", "Drone Load", "Cargo Pressure", "Maintenance Debt"],
        "ghostline-network" => ["Intel Confidence", "Rumor Noise", "Signal Discipline", "Exposure Risk"],
        "barrens-free-wardens" => ["Closeout Witnesses", "Survival Pressure", "Public Trust", "Attrition Risk"],
        _ => ["Influence", "Heat", "Confidence", "Pressure"]
    };
    Func<string, string> ledgerReason = label => label switch
    {
        "Permit Leverage" => "Contract wins, district calm, and public-facing cleanups raise it.",
        "Public Trust" => "Clean history, low heat, and successful dispatches push it upward.",
        "Contract Capture" => "District control and package pressure wins move it.",
        "Debt Shield" => "Low debt heat and stable holdings improve it.",
        "Debt Heat" => "Favors, pressure spikes, and visible scarcity raise it.",
        "Gear Flow" => "Cargo continuity and safer routes improve it.",
        "Favor Load" => "Debt calls and emergency bargains raise it.",
        "Recovery Work" => "Closeouts and rebuild actions lift it.",
        "MysAd Density" => "Arcana incidents and source turbulence move it.",
        "Magic Pressure" => "Ritual noise and conflict arcs raise it.",
        "Signal Clarity" => "Clean handoffs and calm districts improve it.",
        "Drain Risk" => "Escalation and volatility increase it.",
        "Route Control" => "District influence and low disruption improve it.",
        "Drone Load" => "Cargo demand and route churn raise it.",
        "Cargo Pressure" => "Package traffic and event spikes move it.",
        "Maintenance Debt" => "Heat and accumulated strain raise it.",
        "Intel Confidence" => "Low rumor noise and trusted dispatches improve it.",
        "Rumor Noise" => "Volatility and conflicting signals raise it.",
        "Signal Discipline" => "Cleaner routing and safer dispatches improve it.",
        "Exposure Risk" => "Public heat and conflict arcs raise it.",
        "Closeout Witnesses" => "Visible community actions and safer outcomes improve it.",
        "Survival Pressure" => "Heat and scarcity move it upward.",
        "Attrition Risk" => "Heat and volatility increase it.",
        _ => "District control, heat, and confirmed table signals move it."
    };
    Func<string, string> districtAnchorId = id => $"district-{id}";
    Func<string, IReadOnlyList<BlackLedgerDistrictViewModel>> factionDistrictsFor = id =>
        (IReadOnlyList<BlackLedgerDistrictViewModel>)(Model.World?.Districts
            .Where(district => string.Equals(district.DominantFaction.Replace(' ', '-'), factionSlug(id), StringComparison.OrdinalIgnoreCase))
            .ToArray() ?? Array.Empty<BlackLedgerDistrictViewModel>());
    Func<string, IEnumerable<(string Label, string CurrentValue, string Delta, string Trend, string SourceReceipt, string WhatChangesIt, string LatestAction)>> buildLedgers = id =>
    {
        var districts = factionDistrictsFor(id);
        int heat = districts.Sum(static district => district.Heat);
        int influence = districts.Sum(static district => district.Influence);
        int confidence = districts.Count == 0 ? 0 : (int)Math.Round(districts.Average(static district => district.Confidence), MidpointRounding.AwayFromZero);
        int delta = districts.Sum(static district => district.DeltaSinceLastTick);
        string trend = districts.GroupBy(static district => district.Trend)
            .OrderByDescending(static group => group.Count())
            .Select(static group => group.Key)
            .FirstOrDefault() ?? "steady";
        string receipt = selectedDispatch?.SourceReceiptId ?? Model.World?.LastTick?.ReceiptId ?? "turn-1";
        string latestAction = selectedDispatch?.Title ?? Model.NewsreelStatus?.StatusLabel ?? "Turn 1 replay live";
        var values = new[]
        {
            Math.Max(1, influence),
            Math.Max(1, heat),
            Math.Max(1, confidence / 10),
            Math.Max(1, Math.Abs(delta) + Math.Max(1, districts.Count))
        };
        return ledgerLabels(id).Select((label, index) => (
            Label: label,
            CurrentValue: values[index].ToString(CultureInfo.InvariantCulture),
            Delta: $"{(delta >= 0 ? "+" : string.Empty)}{delta.ToString(CultureInfo.InvariantCulture)}",
            Trend: trend,
            SourceReceipt: receipt,
            WhatChangesIt: ledgerReason(label),
            LatestAction: latestAction));
    };
    var worldDistricts = (Model.World?.Districts ?? Array.Empty<BlackLedgerDistrictViewModel>()).ToArray();
    var worldFactions = (Model.World?.Factions ?? Array.Empty<BlackLedgerFactionViewModel>()).ToArray();
    var activeHeat = worldDistricts.Sum(static district => district.Heat);
    var liveConfidence = worldDistricts.Length == 0 ? 0 : (int)Math.Round(worldDistricts.Average(static district => district.Confidence), MidpointRounding.AwayFromZero);
    var pressureDelta = worldDistricts.Sum(static district => district.DeltaSinceLastTick);
    var latestDispatches = Model.Dispatches.Take(3).ToArray();
    var leadDispatch = latestDispatches.FirstOrDefault() ?? selectedDispatch;
    var heroFactionSlug = selectedFactionSlug.Length > 0 ? selectedFactionSlug : "ashline-circle";
    var heroNewsreelMp4Href = mapFocused
        ? "/media/ledger/globe/black-ledger-video-globe-idle.mp4"
        : (newsreelBroadcast?.VideoMp4Href ?? "/media/ledger/newsreels/turn-1-newsreel.mp4");
    var heroNewsreelWebmHref = mapFocused
        ? "/media/ledger/globe/black-ledger-video-globe-idle.webm"
        : (newsreelBroadcast?.VideoWebmHref ?? "/media/ledger/newsreels/turn-1-newsreel.webm");
    var heroNewsreelPosterHref = mapFocused
        ? "/media/ledger/globe/black-ledger-video-globe-idle-poster.png"
        : (newsreelBroadcast?.PosterHref ?? "/media/ledger/newsreels/turn-1-newsreel-poster.png");
    var heroGlobeRenderMode = mapFocused ? "command-map" : "magicfit-newsreel";
    var heroDisableWebGl = mapFocused ? "false" : "true";
    var heroVideoLayer = mapFocused ? "first-party-raster-overlay" : "magicfit-newsreel";
}

<section class="ledger-flagship ledger-flagship--public" data-ledger-redesign="command-deck">
    <p class="sr-only">The public globe route shows the Black Ledger command map with live district overlays.</p>
    @if (commandMap is not null)
    {
        <div class="ledger-flagship__geoscape-wrap">
            <div
                class="ledger-flagship__geoscape"
                data-black-ledger-geoscape-root
                data-variant="full"
                data-globe-render-mode="@heroGlobeRenderMode"
                data-globe-video-mp4="@heroNewsreelMp4Href"
                data-globe-video-webm="@heroNewsreelWebmHref"
                data-globe-video-poster="@heroNewsreelPosterHref"
                data-globe-video-layer="@heroVideoLayer"
                data-disable-webgl="@heroDisableWebGl"
                data-map-url="/api/v1/ledger/worlds/emerald-sprawl-prelude/map?turn=@selectedTurn&amp;mode=@(commandMap.CurrentMode)"
                data-delta-url="/api/v1/ledger/worlds/emerald-sprawl-prelude/map/tick-delta/0/1"
                data-initial-mode="@(commandMap.CurrentMode)"
                data-selected-faction="@selectedFactionSlug"
                data-tick-headline="@Model.World?.TurnHeadline"
                data-overlay-eyebrow="Seattle command deck"
                data-overlay-headline="Track who is moving first."
                data-signal-primary="district heat live"
                data-signal-secondary="faction motion tracked"
                data-signal-tertiary="dispatch board armed"
                data-auto-replay="@(Context.Request.Query.ContainsKey("replay") ? "true" : "false")"
                data-primary-label="@Model.PrimaryAction.Label"
                data-primary-href="@Model.PrimaryAction.Href"
                data-secondary-label="@Model.SecondaryAction.Label"
                data-secondary-href="@Model.SecondaryAction.Href"></div>
        </div>
    }
    <div class="ledger-flagship__copy">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@Model.Intro</p>
        <p class="ledger-flagship__support">Watch the city breathe, see which bloc is leaning on which district, and lift a hook straight into the next scene.</p>
        <div class="ledger-flagship__metrics" aria-label="Current Black Ledger turn">
            <span><strong>Turn @(Model.World?.CurrentTurn ?? 1)</strong> live board</span>
            <span><strong>@worldFactions.Length</strong> factions</span>
            <span><strong>@activeHeat</strong> heat</span>
            <span><strong>@(pressureDelta >= 0 ? "+" : string.Empty)@pressureDelta</strong> pressure</span>
        </div>
        <section class="ledger-flagship__briefing" aria-label="Command briefing">
            <article class="ledger-flagship__briefing-card">
                <span class="tag">Lead dispatch</span>
                <strong>@(leadDispatch?.Title ?? "Dispatch queue open")</strong>
                <p>@(leadDispatch?.Summary ?? "Public board hooks are staged and ready for the next turn.")</p>
            </article>
            <article class="ledger-flagship__briefing-card">
                <span class="tag">Focus faction</span>
                <strong>@(selectedFaction?.PublicName ?? "Ashline Circle")</strong>
                <p>@(selectedFaction is null ? "Start on the board, then drop into the faction file that is actually moving the city." : introLine(selectedFaction.Id))</p>
            </article>
        </section>
        <div class="ledger-flagship__actions" aria-label="Black Ledger actions">
            <a class="button-like button-like--@Model.PrimaryAction.Tone" href="@Model.PrimaryAction.Href" data-analytics-event="ledger_primary_action" data-analytics-surface="ledger_hero" data-analytics-label="@Model.PrimaryAction.Label">@Model.PrimaryAction.Label</a>
            <a class="button-like button-like--@Model.SecondaryAction.Tone" href="@Model.SecondaryAction.Href" data-analytics-event="ledger_secondary_action" data-analytics-surface="ledger_hero" data-analytics-label="@Model.SecondaryAction.Label">@Model.SecondaryAction.Label</a>
            <a class="inline-link" href="/ledger/map#ledger-map" data-analytics-event="ledger_open_command_map" data-analytics-surface="ledger_hero" data-analytics-label="Open command map">Open command map</a>
        </div>
        <div class="trust-claim__details ledger-flagship__boundary">
            <span>Fictional city</span>
            <span>Opt-in aggregate only</span>
            <span>Ready to run</span>
        </div>
    </div>
    <nav class="ledger-flagship__nav" aria-label="Black Ledger navigation">
        <a class="ledger-flagship__nav-card ledger-flagship__nav-card--primary" href="/ledger/map#ledger-map" data-analytics-event="ledger_open_command_map" data-analytics-surface="ledger_nav" data-analytics-label="Open command map">
            <span class="tag">Command</span>
            <strong>Open command map</strong>
            <p>Replay the turn, switch pressure modes, and follow the arrows across the globe.</p>
        </a>
        <a class="ledger-flagship__nav-card" href="/ledger/factions/@heroFactionSlug" data-analytics-event="ledger_open_faction_file" data-analytics-surface="ledger_nav" data-analytics-label="Faction file">
            <span class="tag">Faction</span>
            <strong>Faction file</strong>
            <p>Pick a house, read the mood, and find the next move they want runners to notice.</p>
        </a>
        <a class="ledger-flagship__nav-card" href="/ledger/newsroom" data-analytics-event="ledger_open_newsroom" data-analytics-surface="ledger_nav" data-analytics-label="Open newsroom">
            <span class="tag">Newsroom</span>
            <strong>Open newsroom</strong>
            <p>Latest dispatches, table hooks, and the current bulletin.</p>
        </a>
        <a class="ledger-flagship__nav-card" href="@accountCtaHref" data-analytics-event="ledger_open_account_lane" data-analytics-surface="ledger_nav" data-analytics-label="@accountCtaLabel">
            <span class="tag">Faction workspace</span>
            <strong>@accountCtaLabel</strong>
            <p>Step from the public board into the account-side faction workspace.</p>
        </a>
    </nav>
</section>

@if (Model.World is not null)
{
    var world = Model.World;
    <section class="editorial-block editorial-block--focused" id="ledger-map" tabindex="-1">
        <div class="editorial-block__lead">
            <p class="eyebrow">Command map</p>
            <h2 class="editorial-title">@Model.World.PublicName</h2>
            @if (!string.IsNullOrWhiteSpace(Model.World.TurnHeadline))
            {
                <p class="editorial-copy">@Model.World.TurnHeadline</p>
            }
            <p class="muted-copy">@Model.World.MapNote</p>
        </div>
        <div class="ledger-command-map ledger-command-map--pregold">
            @if (commandMap is not null)
            {
                <div class="ledger-command-map__ribbon" aria-label="Command map status">
                    <span>@(selectedTurn >= 2 ? "Turn 2 board" : "Turn 1 board")</span>
                    <span>@worldDistricts.Length districts</span>
                    <span>@liveConfidence confidence</span>
                    <span>@(leadDispatch is null ? "Dispatch queue open" : leadDispatch.Title)</span>
                </div>
                <div class="ledger-command-map__globe">
                    <div
                        class="ledger-flagship__geoscape"
                        data-black-ledger-geoscape-root
                        data-variant="full"
                        data-map-url="/api/v1/ledger/worlds/emerald-sprawl-prelude/map?turn=@selectedTurn&amp;mode=@(commandMap.CurrentMode)"
                        data-delta-url="/api/v1/ledger/worlds/emerald-sprawl-prelude/map/tick-delta/0/1"
                        data-initial-mode="@(commandMap.CurrentMode)"
                        data-selected-faction="@selectedFactionSlug"
                        data-tick-headline="@Model.World?.TurnHeadline"
                        data-overlay-eyebrow="Pressure board"
                        data-overlay-headline="Read the board before you pick a side."
                        data-signal-primary="pressure vectors active"
                        data-signal-secondary="open jobs shifting"
                        data-signal-tertiary="newsroom linked"
                        data-primary-label="Open faction file"
                        data-primary-href="/ledger/factions/@(selectedFactionSlug.Length > 0 ? selectedFactionSlug : "ashline-circle")"
                        data-secondary-label="Latest bulletin"
                        data-secondary-href="/ledger/newsroom"></div>
                </div>
                <div class="ledger-provider-tours" data-ledger-tour-exports="/media/ledger/tours/black-ledger-tour-exports.manifest.json" aria-label="Optional external viewer links">
                    <div>
                        <span class="tag">Viewer exports</span>
                        <p>Optional viewer exports.</p>
                    </div>
                    <div class="ledger-provider-tours__actions">
                        <a class="button-like button-like--primary" href="/media/ledger/tours/black-ledger-3dvista-flythrough.mp4">Fly-through</a>
                        <a class="button-like button-like--secondary" href="https://my.matterport.com/show/?m=ax2JhiPGk5P" rel="noopener noreferrer" target="_blank">Matterport</a>
                        <a class="button-like button-like--secondary" href="https://www.3dvista.com/samples/new_york_loft.html" rel="noopener noreferrer" target="_blank">3DVista</a>
                        <a class="inline-link" href="/media/ledger/tours/black-ledger-tour-exports.manifest.json">Link list</a>
                    </div>
                </div>
            }
        </div>
        <div class="ledger-world-shell__districts ledger-district-strip" aria-label="District fallback cards">
            @foreach (var district in world.Districts)
            {
                <article class="route-choice-card" id="@districtAnchorId(district.Id)" data-map-district-card="@district.Id">
                    <span class="tag">@district.DominantFaction</span>
                    <h3>@district.Name</h3>
                    <p>@district.Summary</p>
                    <div class="trust-claim__details">
                        <span>Heat: @district.Heat</span>
                        <span>Influence: @district.Influence</span>
                        <span>Confidence: @district.Confidence</span>
                    </div>
                </article>
            }
        </div>
    </section>

    @if (Model.NewsreelStatus is not null)
    {
        if (newsreelBroadcast is not null)
        {
            <section class="editorial-block ledger-newsreel-broadcast" id="newsreel-player">
                <div class="editorial-block__lead">
                    <p class="eyebrow">Black Ledger Newsroom</p>
                    <h2 class="editorial-title">@newsreelBroadcast.EpisodeTypeLabel for @worldTurnBriefing!.TransitionLabel</h2>
                    <p class="editorial-copy">@worldTurnBriefing.NewsreelLead</p>
                </div>
                <div class="ledger-newsreel-broadcast__shell">
                    <div class="ledger-newsreel-broadcast__player">
                        <video class="ledger-newsreel-broadcast__video faction-promo-video"
                               controls
                               playsinline
                               preload="metadata"
                               poster="@newsreelBroadcast.PosterHref">
                            <source src="@newsreelBroadcast.VideoMp4Href" type="video/mp4" />
                            <source src="@newsreelBroadcast.VideoWebmHref" type="video/webm" />
                            <track kind="captions" src="@newsreelBroadcast.CaptionsHref" srclang="en" label="English" default />
                            Your browser cannot play this video here.
                        </video>
                        <div class="trust-claim__details">
                            <span>Anchor: @newsreelBroadcast.AnchorName</span>
                            <span>Desk: @newsreelBroadcast.DeskLabel</span>
                            <span>Duration: @newsreelBroadcast.DurationLabel</span>
                            <span>Published: @newsreelBroadcast.PublishedLabel</span>
                        </div>
                    </div>
                    <aside class="ledger-newsreel-broadcast__sidebar">
                        @if (newsreelBroadcast.ActionBeats.Count > 0)
                        {
                            <article class="route-choice-card">
                                <span class="tag">Action board</span>
                                <h3>Visible player, GM, and world moves</h3>
                                <div class="ledger-newsreel-broadcast__action-strip">
                                    @foreach (var beat in newsreelBroadcast.ActionBeats.Take(4))
                                    {
                                        <article class="ledger-newsreel-broadcast__action-card">
                                            <span class="tag">@beat.ActorKind</span>
                                            <h4>@beat.BeatLabel</h4>
                                            <p class="ledger-newsreel-broadcast__action-actor">@beat.ActorLabel</p>
                                            <p class="ledger-newsreel-broadcast__action-detail">@PublicFacingCopyHumanizer.Clean(beat.VisualHook)</p>
                                            <p>@PublicFacingCopyHumanizer.Clean(beat.ActionSummary)</p>
                                            <p class="ledger-newsreel-broadcast__action-stakes">@PublicFacingCopyHumanizer.Clean(beat.Stakes)</p>
                                            <p class="ledger-newsreel-broadcast__action-stakes">@PublicFacingCopyHumanizer.Clean(beat.ConsequenceLine)</p>
                                            <p class="ledger-newsreel-broadcast__action-detail">@PublicFacingCopyHumanizer.Clean(beat.ProofNote)</p>
                                        </article>
                                    }
                                </div>
                            </article>
                        }
                        <article class="route-choice-card">
                            <span class="tag">@newsreelBroadcast.PackageLabel</span>
                            <h3>Broadcast mix</h3>
                            <p>@PublicFacingCopyHumanizer.Clean(newsreelBroadcast.AudioPosture)</p>
                            <p>@PublicFacingCopyHumanizer.Clean(newsreelBroadcast.MusicPosture)</p>
                            <p>@PublicFacingCopyHumanizer.Clean(newsreelBroadcast.PublicSafetyNote)</p>
                            <p>@PublicFacingCopyHumanizer.Clean(newsreelBroadcast.ReconstructionNote)</p>
                            <div class="route-choice-card__details">
                                <a href="@newsreelBroadcast.WatchHref">Open watch route</a>
                                <a href="@newsreelBroadcast.TranscriptHref">Transcript</a>
                                <a href="@newsreelBroadcast.ReceiptsHref">Episode details</a>
                                <a href="@newsreelBroadcast.ReceiptsHref">Details</a>
                                <a href="@newsreelBroadcast.FeedbackHref">Feedback</a>
                            </div>
                        </article>
                        <article class="route-choice-card">
                            <span class="tag">Rundown</span>
                            <h3>Rundown</h3>
                            <ul class="ledger-newsreel-broadcast__list">
                                @foreach (var line in newsreelBroadcast.Rundown)
                                {
                                    <li>@line</li>
                                }
                            </ul>
                        </article>
                        <article class="route-choice-card">
                            <span class="tag">Ticker</span>
                            <h3>Lower-third crawl</h3>
                            <ul class="ledger-newsreel-broadcast__list">
                                @foreach (var line in newsreelBroadcast.TickerItems)
                                {
                                    <li>@line</li>
                                }
                            </ul>
                        </article>
                    </aside>
                </div>
            </section>
        }

        @if (latestDispatches.Length > 0)
        {
            <section class="editorial-block ledger-dispatch-strip" id="ledger-dispatches">
                <div class="editorial-block__lead">
                    <p class="eyebrow">Dispatches</p>
                    <h2 class="editorial-title">Latest dispatches</h2>
                    <p class="editorial-copy">Table-ready pressure beats.</p>
                </div>
                <div class="ledger-dispatch-strip__grid">
                    @foreach (var dispatch in latestDispatches)
                    {
                        <article class="ledger-dispatch-strip__item">
                            <span class="tag">@dispatch.Type</span>
                            <h3>@dispatch.Title</h3>
                            <p>@dispatch.Summary</p>
                            <a class="editorial-strip__action" href="@dispatch.Href">Dispatch detail</a>
                        </article>
                    }
                </div>
            </section>
        }

        <section class="workflow-band workflow-band--compact">
            <div class="workflow-band__lead">
                <p class="eyebrow">Turn @Model.NewsreelStatus.Turn newsreel</p>
                <h2 class="editorial-title">@Model.NewsreelStatus.StatusLabel</h2>
                <p class="editorial-copy">@Model.NewsreelStatus.Summary</p>
            </div>
            <div class="trust-claim__details">
                <span>Scope: @Model.NewsreelStatus.ScopeLabel</span>
                <span>Delivery: first-party email</span>
                            <span>Clips: @Model.NewsreelStatus.ReceiptCount</span>
            </div>
        </section>
    }

    <section class="editorial-block" id="ledger-factions">
        <div class="editorial-block__lead">
            <p class="eyebrow">Faction files</p>
            <h2 class="editorial-title">Logos, backdrops, score ledgers, and first-party motion intros.</h2>
            <p class="editorial-copy">Public faction lanes show pressure, not people.</p>
        </div>
        <div class="faction-profile-grid">
            @foreach (var faction in world.Factions)
            {
                var slug = factionSlug(faction.Id);
                var ledgers = buildLedgers(faction.Id).Take(4).ToArray();
                <article class="faction-profile-card" data-faction-card="@slug">
                    <div class="faction-profile-card__hero" style="background-image:url('@backgroundHref(faction.Id)')">
                        <img class="faction-profile-card__logo" src="@logoHref(faction.Id)" alt="@($"{faction.PublicName} logo")" loading="lazy" />
                        <div class="faction-profile-card__hero-copy">
                            <span class="tag">@faction.Type</span>
                            <h3>@faction.PublicName</h3>
                            <p>@introLine(faction.Id)</p>
                        </div>
                    </div>
                    <div class="faction-profile-card__ledgers">
                        @foreach (var ledger in ledgers)
                        {
                            <article class="score-ledger">
                                <span class="score-ledger__label">@ledger.Label</span>
                                <strong>@ledger.CurrentValue</strong>
                                <small>@ledger.Delta · @ledger.Trend</small>
                            </article>
                        }
                    </div>
                    <div class="trust-claim__details">
                        <span>Safety: public</span>
                        <span>Video: first-party motion</span>
                        <span>Turn: @(world.LastTick?.ReceiptId ?? "turn-1")</span>
                    </div>
                    <a class="editorial-strip__action" href="/ledger/factions/@slug" data-faction-file-link="@slug">Open faction file</a>
                </article>
            }
        </div>
    </section>

    @if (selectedFaction is not null)
    {
        var slug = factionSlug(selectedFaction.Id);
        var ledgers = buildLedgers(selectedFaction.Id).Take(4).ToArray();
        var districts = factionDistrictsFor(selectedFaction.Id);
        <section class="editorial-block" id="ledger-faction-file">
            <div class="faction-detail-hero" style="background-image:url('@backgroundHref(selectedFaction.Id)')">
                <img class="faction-detail-hero__logo" src="@logoHref(selectedFaction.Id)" alt="@($"{selectedFaction.PublicName} logo")" loading="lazy" />
                <div class="faction-detail-hero__copy">
                    <p class="eyebrow">Faction profile</p>
                    <h2 class="editorial-title">@selectedFaction.PublicName</h2>
                    <p class="editorial-copy">@introLine(selectedFaction.Id)</p>
                    <p class="muted-copy">This page explains pressure, not people.</p>
                    <div class="trust-claim__details">
                        <span>Safety: public</span>
                        <span>Video: first-party motion</span>
                        <span>Package pressure visible</span>
                    </div>
                    <div class="stacked-actions">
                        <a class="button-like button-like--primary" href="@accountCtaHref">@accountCtaLabel</a>
                        <a class="button-like button-like--secondary" href="/ledger/factions/@slug/promo">Open faction video</a>
                    </div>
                </div>
            </div>

            <div class="score-ledger-grid">
                @foreach (var ledger in ledgers)
                {
                    <article class="route-choice-card">
                        <span class="tag">@ledger.Label</span>
                        <h3>@ledger.CurrentValue</h3>
                        <p>Delta since last turn: @ledger.Delta</p>
                        <p>Trend: @ledger.Trend</p>
                        <p>Latest turn: @ledger.SourceReceipt</p>
                        <p>What changes it: @ledger.WhatChangesIt</p>
                        <p>Latest action: @ledger.LatestAction</p>
                    </article>
                }
            </div>

            <div class="route-choice-grid route-choice-grid--three">
                <article class="route-choice-card">
                    <span class="tag">Named roles</span>
                    <h3>Named bounded roles</h3>
                    <p>Leader: @selectedFaction.FactionLeader · GM: @selectedFaction.FieldGm · Intel: @selectedFaction.IntelProvider</p>
                </article>
                <article class="route-choice-card">
                    <span class="tag">District pressure</span>
                    <h3>Map focus</h3>
                    <p>@(districts.Count == 0 ? "Cross-district pressure" : string.Join(", ", districts.Select(static district => district.Name)))</p>
                </article>
                <article class="route-choice-card">
                    <span class="tag">Storyboard</span>
                    <h3>Faction intro video</h3>
                    <p>Video playback status is still pending, so this page stays on a simple fallback.</p>
                    <div class="trust-claim__details">
                        <a class="inline-link" href="/ledger/factions/@slug/promo">Promo page</a>
                        <a class="inline-link" href="/ledger/factions/@slug/promo.json">JSON brief</a>
                    </div>
                </article>
            </div>

            @if (Model.Dispatches.Count > 0)
            {
                <div class="route-choice-grid route-choice-grid--three">
                    @foreach (var dispatch in Model.Dispatches.Take(3))
                    {
                        <article class="route-choice-card">
                            <span class="tag">@dispatch.Type</span>
                            <h3>@dispatch.Title</h3>
                            <p>@dispatch.Summary</p>
                            <a class="editorial-strip__action" href="@dispatch.Href">Open dispatch</a>
                        </article>
                    }
                </div>
            }
        </section>
    }
}

<script type="module" src="~/js/black-ledger-geoscape.js" asp-append-version="true"></script>
<script>
(() => {
    const video = document.querySelector('#newsreel-player video');
    if (!(video instanceof HTMLVideoElement)) {
        return;
    }

    const params = new URLSearchParams(window.location.search);
    if (params.get('autoplay') !== '1') {
        return;
    }

    video.muted = true;
    video.play().catch(() => {
        video.muted = false;
    });
})();
</script>

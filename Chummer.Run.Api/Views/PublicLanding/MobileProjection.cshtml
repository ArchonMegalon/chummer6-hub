@model MobileProjectionPageViewModel
@inject Chummer.Run.Api.Services.PublicCanonicalOriginPolicy PublicOrigin
@{
    Layout = "~/Views/Shared/_MobileInstallLayout.cshtml";
    var roleProfile = Model.RoleProfile;
    ViewData["Title"] = Model.DocumentTitle;
    ViewData["MobileManifestHref"] = Model.ManifestHref;
    ViewData["MobileAppleAppTitle"] = Model.AppleAppTitle;
}

<main class="turn-shell install-only-shell"
      data-play-surface="install-only"
      data-live-session="unavailable"
      data-authority="none"
      data-install-role="@roleProfile.RoleKey"
      data-mobile-app-inline-handoff
      data-mobile-app-path="@roleProfile.InstallTargetPath"
      data-mobile-app-origin="@PublicOrigin.Origin">
    <section class="turn-card hero install-hero">
        <div>
            <p class="eyebrow">Chummer @Model.CurrentRoleLabel · install shell</p>
            <h1>@roleProfile.PurposeHeading</h1>
            <p class="lede">@roleProfile.PurposeSummary</p>
        </div>

        <div class="trust-strip" aria-label="Public install boundary">
            <span class="status-pill status-pill--cool">Public shell only</span>
            <span class="status-pill">No table data loaded</span>
            <span class="status-pill">No role granted</span>
        </div>

        <div class="install-surface install-actions">
            <button id="turn-install-button" type="button" class="primary-button">Install app</button>
            <a class="secondary-button"
               href="@roleProfile.InstallTargetPath"
               data-mobile-app-inline-open>@roleProfile.OpenTargetLabel</a>
            <a class="secondary-button" href="/participate">How to join</a>
        </div>
        <div class="mobile-app-handoff__qr-card">
            <svg class="mobile-app-handoff__qr"
                 width="224"
                 height="224"
                 data-mobile-app-inline-qr
                 role="img"
                 aria-label="@roleProfile.QrAriaLabel"
                 focusable="false"></svg>
            <p class="support-copy" data-mobile-app-inline-qr-status hidden>
                The QR code is unavailable. Use the clean role link instead.
            </p>
        </div>
        <p id="turn-install-status" class="support-copy" role="status" aria-live="polite">
            Use your browser menu to install this app. A direct install button appears when your browser supports it.
        </p>
        <div id="turn-manual-install-help" class="support-copy manual-install-help" tabindex="-1">
            <p><strong>iPhone or iPad:</strong> in Safari, choose Share, then Add to Home Screen.</p>
            <p><strong>Android:</strong> open the browser menu, then choose Install app or Add to Home screen.</p>
            <p>If your browser offers neither command, keep using this public install shell in the browser.</p>
        </div>
    </section>

    <section class="install-boundary-grid"
             aria-label="@Model.CurrentRoleLabel install capabilities"
             data-role-capabilities="@roleProfile.RoleKey">
        @foreach (var capability in roleProfile.Capabilities)
        {
            <article class="turn-card" data-role-capability>
                <p class="eyebrow">@Model.CurrentRoleLabel capability</p>
                <h2>@capability.Label</h2>
                <p class="support-copy">@capability.Summary</p>
            </article>
        }
    </section>

    <section class="turn-card role-warning"
             role="note"
             data-role-privacy-warning="@roleProfile.RoleKey">
        <p class="eyebrow">@Model.CurrentRoleLabel privacy boundary</p>
        <h2>@roleProfile.PrivacyHeading</h2>
        <p class="support-copy">@roleProfile.PrivacySummary</p>
    </section>

    <section class="turn-card role-warning"
             role="note"
             data-role-authority-warning="@roleProfile.RoleKey">
        <p class="eyebrow">@Model.CurrentRoleLabel authority boundary</p>
        <h2>@roleProfile.AuthorityHeading</h2>
        <p class="support-copy">@roleProfile.AuthoritySummary</p>
    </section>
</main>

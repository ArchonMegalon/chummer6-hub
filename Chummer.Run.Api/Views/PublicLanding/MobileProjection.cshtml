@model MobileProjectionPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-mobile-projection";
}

<section class="trust-page-hero trust-page-hero--compact">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">Mobile play shell preview; installability proof pending.</p>
        <div class="trust-claim__microproof">
            <span>@Model.CurrentRoleLabel</span>
            <span>Manifest and service worker live</span>
            <span>Offline depth still proving</span>
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="@Model.PrimaryAction.Href">@Model.PrimaryAction.Label</a>
        <a class="button-like button-like--secondary" href="/status">Read install status</a>
    </div>
</section>

<section class="workflow-band workflow-band--compact">
    <div class="workflow-band__lead">
        <p class="eyebrow">Installability state</p>
        <h2 class="editorial-title">Compact public truth for the play shell.</h2>
        <p class="editorial-copy">The shell is real, the manifest is real, and the service worker is real. Public install prompts and offline depth still need explicit proof.</p>
    </div>
    <div class="flagship-gateway-grid flagship-gateway-grid--compact">
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag">Live</span>
                <h3>Web app manifest</h3>
            </div>
            <p>Standalone display, icons, scope, and start route are shipped from the live shell.</p>
            <a class="editorial-strip__action" href="/manifest.json">Open manifest</a>
        </article>
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag">Live</span>
                <h3>Service worker</h3>
            </div>
            <p>First-party route caching exists and can be inspected directly.</p>
            <a class="editorial-strip__action" href="/service-worker.js">Open service worker</a>
        </article>
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag">Pending proof</span>
                <h3>Install prompts and offline depth</h3>
            </div>
            <p>Prompt timing, platform install UX, and offline cache depth stay demoted until proven live.</p>
            <a class="editorial-strip__action" href="/status">Open status</a>
        </article>
    </div>
</section>

<section class="workflow-band workflow-band--compact">
    <div class="workflow-band__lead">
        <p class="eyebrow">Role entry</p>
        <h2 class="editorial-title">Player, GM, and observer routes converge on one shell.</h2>
    </div>
    <div class="route-choice-grid route-choice-grid--three">
        @foreach (var role in Model.Roles)
        {
            <article class="route-choice-card">
                <span class="tag">@(role.Current ? "Current role" : "Role alias")</span>
                <h3>@role.Label</h3>
                <p>@role.Summary</p>
                <a class="editorial-strip__action" href="@role.Href">Open @role.Label</a>
            </article>
        }
    </div>
</section>

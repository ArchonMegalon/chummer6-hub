@model MobileProjectionPageViewModel
@{
    static string PublicMobileText(string? value) => UndetectableHumanizerCopyAdapter.Humanize(value);

    ViewData["Title"] = PublicMobileText(Model.Heading);
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-mobile-projection";
}

<section class="trust-page-hero trust-page-hero--compact">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@PublicMobileText(Model.Eyebrow)</p>
        <h1 class="page-title">@PublicMobileText(Model.Heading)</h1>
        <p class="page-copy">@PublicMobileText(Model.Intro)</p>
        <div class="trust-claim__details">
            <span>@PublicMobileText(Model.CurrentRoleLabel)</span>
            <span>Installable app shell live</span>
            <span>Offline and reconnect path cached</span>
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="@Model.PrimaryAction.Href">@PublicMobileText(Model.PrimaryAction.Label)</a>
        <button class="button-like button-like--secondary" type="button" data-install-prompt-button aria-disabled="true">Install this app</button>
        <a class="button-like button-like--ghost" href="/play/continuity">Open continuity</a>
    </div>
</section>

<section class="workflow-band workflow-band--compact">
    <div class="workflow-band__lead">
        <p class="eyebrow">Installability state</p>
        <h2 class="editorial-title">Install like an app. Re-enter like a session shell.</h2>
        <p class="editorial-copy">@PublicMobileText(Model.InstallabilitySummary)</p>
    </div>
    <div class="flagship-gateway-grid flagship-gateway-grid--compact">
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag" data-pwa-online-state>Checking</span>
                <h3>Install readiness</h3>
            </div>
            <p data-pwa-install-state>The mobile view is available now. Install prompts depend on the browser, but the app page and offline return path are ready.</p>
            <div class="stacked-actions">
                <a class="editorial-strip__action" href="/mobile">Open mobile view</a>
                <a class="editorial-strip__action" href="/downloads">Desktop downloads</a>
            </div>
        </article>
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag">Live</span>
                <h3>Offline return path</h3>
            </div>
            <p>Chummer keeps the mobile path, play view, return path, and install assets ready so a reconnect starts from the right place.</p>
            <div class="stacked-actions">
                <a class="editorial-strip__action" href="/play/continuity">Open continuity</a>
                <a class="editorial-strip__action" href="/help">Open help</a>
            </div>
        </article>
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag">Continuity</span>
                <h3>Next safe action</h3>
            </div>
            <p>The installable shell does not replace downloads, support, or account recovery. It keeps the return path explicit when you move between public, linked, and session surfaces.</p>
            <div class="stacked-actions">
                <a class="editorial-strip__action" href="/play/continuity">Open continuity</a>
                <a class="editorial-strip__action" href="/help">Open setup help</a>
            </div>
        </article>
    </div>
</section>

<section class="workflow-band workflow-band--compact">
    <div class="workflow-band__lead">
        <p class="eyebrow">Living world</p>
        <h2 class="editorial-title">Black Ledger live tracker</h2>
        <p class="editorial-copy">Enable updates in account preferences to keep heat, movement, and turn status visible in the same mobile shell.</p>
    </div>
    <div class="flagship-gateway-grid flagship-gateway-grid--compact" id="pwa-ledger-stream">
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag" data-pwa-ledger-status>Checking</span>
                <h3>Board snapshot</h3>
            </div>
            <p data-pwa-ledger-summary>Waiting for live board stream data.</p>
            <p class="muted-copy">
                <span>World:</span>
                <span data-pwa-ledger-world>Not yet available</span>
            </p>
            <p class="muted-copy">
                <span>Turn:</span>
                <span data-pwa-ledger-turn>—</span>
            </p>
            <p class="muted-copy">
                <span>Hot district:</span>
                <span data-pwa-ledger-hot-district>—</span>
            </p>
            <p class="muted-copy">
                <span>Top movement:</span>
                <span data-pwa-ledger-top-movement>—</span>
            </p>
            <div class="stacked-actions">
                <a class="editorial-strip__action" data-pwa-ledger-map-route href="/ledger/map">Open ledger map</a>
                <a class="editorial-strip__action" data-pwa-ledger-opt-in-route href="/account">Enable updates</a>
            </div>
            <div class="muted-copy" data-pwa-ledger-follow-hint></div>
        </article>
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag">Top districts</span>
                <h3>Continuity and heat</h3>
            </div>
            <p class="muted-copy">
                <span>Continuity turn:</span>
                <span data-pwa-continuity-turn>—</span>
            </p>
            <p class="muted-copy" data-pwa-continuity-summary>No continuity snapshot loaded yet.</p>
            <ul class="gateway-card__list" data-pwa-continuity-events>
                <li>No continuity events yet.</li>
            </ul>
            <p class="muted-copy">Current heat top list:</p>
            <ul class="gateway-card__list" data-pwa-ledger-top-districts>
                <li>No live district data yet.</li>
            </ul>
            <p class="muted-copy">This list updates from the living world stream when you allow table-safe updates.</p>
        </article>
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag">Update stream</span>
                <h3>Polling state</h3>
            </div>
            <p>
                <span>Route:</span>
                <span>/mobile/pwa/ledger.json</span>
            </p>
            <p>
                <span>Turn detail:</span>
                <a class="editorial-strip__action" data-pwa-ledger-turn-route href="/ledger/turns/1">Open live turn</a>
            </p>
            <p>
                <span>Turn newsreel:</span>
                <a class="editorial-strip__action" data-pwa-ledger-newsreel-route href="/ledger/turns/1/newsreel.json">Open live newsreel</a>
            </p>
            <p class="muted-copy">Updates refresh every 30 seconds while the page is open.</p>
            <p class="muted-copy">
                <span>Last update:</span>
                <span data-pwa-ledger-updated>never</span>
            </p>
        </article>
    </div>
</section>

<section class="workflow-band workflow-band--compact">
    <div class="workflow-band__lead">
        <p class="eyebrow">Capabilities</p>
        <h2 class="editorial-title">One mobile view, five clear promises.</h2>
    </div>
    <div class="flagship-gateway-grid flagship-gateway-grid--compact">
        @foreach (var capability in Model.Capabilities)
        {
            <article class="gateway-card">
                <div class="gateway-card__header">
                    <span class="tag">Included</span>
                    <h3>@PublicMobileText(capability.Label)</h3>
                </div>
                <p>@PublicMobileText(capability.Summary)</p>
            </article>
        }
    </div>
</section>

<section class="workflow-band workflow-band--compact">
    <div class="workflow-band__lead">
        <p class="eyebrow">Role entry</p>
        <h2 class="editorial-title">Player, GM, and observer entry points meet in one shell.</h2>
        <p class="editorial-copy">Choose a role-specific front door without splitting the product into different stories. The same app shell keeps install, return, and reconnect status visible in every role.</p>
    </div>
    <div class="route-choice-grid route-choice-grid--three">
        @foreach (var role in Model.Roles)
        {
            <article class="route-choice-card">
                <span class="tag">@(role.Current ? "Current role" : "Role alias")</span>
                <h3>@PublicMobileText(role.Label)</h3>
                <p>@PublicMobileText(role.Summary)</p>
                <a class="editorial-strip__action" href="@role.Href">Open @PublicMobileText(role.Label)</a>
            </article>
        }
    </div>
</section>

@if (Model.SignedInStatus is not null)
{
    <section class="workflow-band workflow-band--compact">
        @await Html.PartialAsync("~/Views/Shared/_SignedInTrustStatusPanel.cshtml", Model.SignedInStatus)
    </section>
}

@if (Model.TrustPulse is not null)
{
    <section class="workflow-band workflow-band--compact">
        @await Html.PartialAsync("~/Views/Shared/_PublicTrustPulsePanel.cshtml", Model.TrustPulse)
    </section>
}

@section Scripts
{
    <script>
        (function () {
            var installButton = document.querySelector("[data-install-prompt-button]");
            var installState = document.querySelector("[data-pwa-install-state]");
            var onlineState = document.querySelector("[data-pwa-online-state]");
            var deferredPrompt = null;
            var ledgerStatus = document.querySelector("[data-pwa-ledger-status]");
            var ledgerSummary = document.querySelector("[data-pwa-ledger-summary]");
            var ledgerWorld = document.querySelector("[data-pwa-ledger-world]");
            var ledgerTurn = document.querySelector("[data-pwa-ledger-turn]");
            var ledgerHotDistrict = document.querySelector("[data-pwa-ledger-hot-district]");
            var ledgerTopMovement = document.querySelector("[data-pwa-ledger-top-movement]");
            var ledgerTopDistricts = document.querySelector("[data-pwa-ledger-top-districts]");
            var ledgerFollowHint = document.querySelector("[data-pwa-ledger-follow-hint]");
            var ledgerMapRoute = document.querySelector("[data-pwa-ledger-map-route]");
            var ledgerOptInRoute = document.querySelector("[data-pwa-ledger-opt-in-route]");
            var ledgerUpdated = document.querySelector("[data-pwa-ledger-updated]");
            var ledgerTurnRoute = document.querySelector("[data-pwa-ledger-turn-route]");
            var ledgerNewsreelRoute = document.querySelector("[data-pwa-ledger-newsreel-route]");
            var ledgerContinuityTurn = document.querySelector("[data-pwa-continuity-turn]");
            var ledgerContinuitySummary = document.querySelector("[data-pwa-continuity-summary]");
            var ledgerContinuityEvents = document.querySelector("[data-pwa-continuity-events]");

            function setOnlineState() {
                if (!onlineState) {
                    return;
                }

                onlineState.textContent = navigator.onLine ? "Online" : "Offline";
            }

            function setInstallAvailability(ready) {
                if (!installButton || !installState) {
                    return;
                }

                if (ready) {
                    installButton.removeAttribute("aria-disabled");
                    installState.textContent = "This browser exposed a direct install prompt. Use it when you want the shell pinned like an app.";
                    return;
                }

                installButton.setAttribute("aria-disabled", "true");
                installState.textContent = "If this browser does not expose a direct install prompt, use its Add to Home Screen or Install App menu. The shell still keeps the same continuity path.";
            }

            setOnlineState();
            setInstallAvailability(false);
            window.addEventListener("online", setOnlineState);
            window.addEventListener("offline", setOnlineState);

            window.addEventListener("beforeinstallprompt", function (event) {
                event.preventDefault();
                deferredPrompt = event;
                setInstallAvailability(true);
            });

            if (installButton) {
                installButton.addEventListener("click", async function () {
                    if (!deferredPrompt) {
                        return;
                    }

                    deferredPrompt.prompt();
                    try {
                        await deferredPrompt.userChoice;
                    } finally {
                        deferredPrompt = null;
                        setInstallAvailability(false);
                    }
                });
            }

            window.addEventListener("appinstalled", function () {
                deferredPrompt = null;
                if (installState) {
                    installState.textContent = "Installed. Re-open the shell from your app drawer or home screen to keep return and role entry on the same path.";
                }
                setInstallAvailability(false);
            });

            function safeText(node, value) {
                if (node) {
                    node.textContent = value;
                }
            }

            function updateLedgerStatus(status, label) {
                safeText(ledgerStatus, label || status || "Unknown");
            }

            function updateLedgerTopDistricts(items) {
                if (!ledgerTopDistricts) {
                    return;
                }

                if (!items || items.length === 0) {
                    ledgerTopDistricts.innerHTML = "<li>No live district data yet.</li>";
                    return;
                }

                ledgerTopDistricts.innerHTML = "";
                for (var i = 0; i < items.length; i += 1) {
                    var district = items[i];
                    var delta = typeof district.delta === "number" ? district.delta : 0;
                    var formattedDelta = delta >= 0 ? "+" + delta : String(delta);
                    var trend = district.trend || "";
                    var listItem = document.createElement("li");
                    listItem.textContent = district.name + " — heat " + district.heat + ", Δ " + formattedDelta + (trend ? " (" + trend + ")" : "");
                    ledgerTopDistricts.appendChild(listItem);
                }
            }

            function updateContinuityEvents(events) {
                if (!ledgerContinuityEvents) {
                    return;
                }

                if (!events || events.length === 0) {
                    ledgerContinuityEvents.innerHTML = "<li>No continuity events yet.</li>";
                    return;
                }

                ledgerContinuityEvents.innerHTML = "";
                for (var i = 0; i < events.length; i += 1) {
                    var eventItem = events[i];
                    var delta = typeof eventItem.delta === "number" ? eventItem.delta : 0;
                    var formattedDelta = delta >= 0 ? "+" + delta : String(delta);
                    var target = eventItem.target || "Unknown zone";
                    var metric = eventItem.metric || "impact";
                    var reason = eventItem.reason || "";
                    var listItem = document.createElement("li");
                    listItem.textContent = target + ": " + metric + " " + formattedDelta + (reason ? " — " + reason : "");
                    ledgerContinuityEvents.appendChild(listItem);
                }
            }

            function renderLedgerPayload(payload) {
                if (!payload || typeof payload !== "object") {
                    updateLedgerStatus("error", "Stream unavailable");
                    safeText(ledgerSummary, "The board stream did not return a valid payload.");
                    safeText(ledgerWorld, "Unavailable");
                    safeText(ledgerTurn, "—");
                    safeText(ledgerHotDistrict, "Unavailable");
                    safeText(ledgerTopMovement, "Unavailable");
                    safeText(ledgerUpdated, "Unavailable");
                    safeText(ledgerFollowHint, "");
                    safeText(ledgerContinuityTurn, "Unavailable");
                    safeText(ledgerContinuitySummary, "Continuity snapshot is not available in this lane.");
                    updateContinuityEvents([]);
                    return;
                }

                updateLedgerStatus(payload.status, payload.status_label);
                var summaryText = typeof payload.summary === "string"
                    ? payload.summary
                    : (payload.summary && payload.summary.hot_district)
                        ? payload.summary.hot_district
                        : "No summary available.";
                safeText(ledgerSummary, summaryText);
                safeText(ledgerUpdated, payload.generated_at_utc ? new Date(payload.generated_at_utc).toLocaleString() : "not yet");

                if (payload.world) {
                    safeText(ledgerWorld, payload.world.world_name || payload.world.world_id || "No world loaded");
                    safeText(ledgerTurn, "Turn " + (payload.world.world_turn || 0));
                }
                else {
                    safeText(ledgerWorld, "No world loaded");
                    safeText(ledgerTurn, "—");
                }

                if (payload.hot_district) {
                    safeText(
                        ledgerHotDistrict,
                        payload.hot_district.name
                            ? payload.hot_district.name + " (" + payload.hot_district.heat + ")"
                            : String(payload.hot_district.heat || 0));
                }
                else if (payload.summary && payload.summary.hot_district) {
                    safeText(ledgerHotDistrict, payload.summary.hot_district);
                }
                else {
                    safeText(ledgerHotDistrict, "No hot district yet");
                }

                if (payload.move_district) {
                    var moveDelta = typeof payload.move_district.delta === "number" ? payload.move_district.delta : 0;
                    safeText(
                        ledgerTopMovement,
                        payload.move_district.name
                            ? payload.move_district.name + " (" + (moveDelta >= 0 ? "+" + moveDelta : moveDelta) + ")"
                            : "No movement data");
                }
                else if (payload.summary && payload.summary.hot_shift) {
                    safeText(ledgerTopMovement, payload.summary.hot_shift);
                }
                else {
                    safeText(ledgerTopMovement, "No movement data yet");
                }

                if (ledgerMapRoute && payload.tracker && payload.tracker.turn_map_route) {
                    ledgerMapRoute.setAttribute("href", payload.tracker.turn_map_route);
                }

                if (ledgerOptInRoute && payload.opt_in_route) {
                    ledgerOptInRoute.href = payload.opt_in_route;
                }

                if (ledgerTurnRoute && payload.tracker && payload.tracker.turn_route) {
                    ledgerTurnRoute.setAttribute("href", payload.tracker.turn_route);
                }

                if (ledgerNewsreelRoute && payload.tracker && payload.tracker.newsreel_route) {
                    ledgerNewsreelRoute.setAttribute("href", payload.tracker.newsreel_route);
                }

                if (payload.continuity) {
                    safeText(
                        ledgerContinuityTurn,
                        typeof payload.continuity.turn === "number"
                            ? "Turn " + payload.continuity.turn
                            : "No live turn yet");
                    safeText(
                        ledgerContinuitySummary,
                        payload.continuity.turn_summary || "No continuity summary available.");
                    updateContinuityEvents(payload.continuity.events);
                    if (ledgerTurnRoute && payload.continuity.turn_route) {
                        ledgerTurnRoute.setAttribute("href", payload.continuity.turn_route);
                    }
                    if (ledgerNewsreelRoute && payload.continuity.turn_route) {
                        var newsreelRoute = (payload.tracker && payload.tracker.newsreel_route) || (typeof payload.continuity.turn === "number"
                            ? "/ledger/turns/" + payload.continuity.turn + "/newsreel.json"
                            : null);
                        if (newsreelRoute) {
                            ledgerNewsreelRoute.setAttribute("href", newsreelRoute);
                        }
                    }
                }
                else {
                    safeText(ledgerContinuityTurn, "Unavailable");
                    safeText(ledgerContinuitySummary, "Continuity snapshot is not available in this lane.");
                    updateContinuityEvents([]);
                }

                safeText(ledgerFollowHint, payload.summary && payload.summary.follow_hint ? payload.summary.follow_hint : "");
                updateLedgerTopDistricts(payload.top_districts || []);
            }

            async function refreshLedgerPayload() {
                if (!ledgerStatus || !ledgerSummary) {
                    return;
                }

                try {
                    var response = await fetch("/mobile/pwa/ledger.json", { cache: "no-store", method: "GET" });
                    if (!response.ok) {
                        updateLedgerStatus("error", "Stream offline");
                        safeText(ledgerSummary, "The stream endpoint returned " + response.status + ".");
                        return;
                    }

                    renderLedgerPayload(await response.json());
                } catch (error) {
                    updateLedgerStatus("error", "Stream offline");
                    safeText(ledgerSummary, "Could not reach /mobile/pwa/ledger.json while checking for updates.");
                }
            }

            safeText(ledgerSummary, "Loading live board stream...");
            refreshLedgerPayload();
            window.setInterval(refreshLedgerPayload, 30000);
        })();
    </script>
}

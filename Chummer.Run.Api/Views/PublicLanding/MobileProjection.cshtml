@model MobileProjectionPageViewModel
@{
    static string PublicMobileText(string? value) => UndetectableHumanizerCopyAdapter.Humanize(value);

    ViewData["Title"] = PublicMobileText(Model.Heading);
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-mobile-projection";
}

<section class="trust-page-hero trust-page-hero--compact">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@PublicMobileText(Model.Eyebrow)</p>
        <h1 class="page-title">@PublicMobileText(Model.Heading)</h1>
        <p class="page-copy">@PublicMobileText(Model.Intro)</p>
        <div class="trust-claim__details">
            <span>@PublicMobileText(Model.CurrentRoleLabel)</span>
            <span>Installable app shell live</span>
            <span>Offline and reconnect path cached</span>
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="@Model.PrimaryAction.Href">@PublicMobileText(Model.PrimaryAction.Label)</a>
        <button class="button-like button-like--secondary" type="button" data-install-prompt-button aria-disabled="true">Install this app</button>
        <a class="button-like button-like--ghost" href="/play/continuity">Open continuity</a>
    </div>
</section>

<section class="workflow-band workflow-band--compact">
    <div class="workflow-band__lead">
        <p class="eyebrow">Installability state</p>
        <h2 class="editorial-title">Install like an app. Re-enter like a session shell.</h2>
        <p class="editorial-copy">@PublicMobileText(Model.InstallabilitySummary)</p>
    </div>
    <div class="flagship-gateway-grid flagship-gateway-grid--compact">
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag" data-pwa-online-state>Checking</span>
                <h3>Install readiness</h3>
            </div>
            <p data-pwa-install-state>The mobile view is available now. Install prompts depend on the browser, but the app page and offline return path are ready.</p>
            <div class="stacked-actions">
                <a class="editorial-strip__action" href="/mobile">Open mobile view</a>
                <a class="editorial-strip__action" href="/downloads">Desktop downloads</a>
            </div>
        </article>
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag">Live</span>
                <h3>Offline return path</h3>
            </div>
            <p>Chummer keeps the mobile path, play view, return path, and install assets ready so a reconnect starts from the right place.</p>
            <div class="stacked-actions">
                <a class="editorial-strip__action" href="/play/continuity">Open continuity</a>
                <a class="editorial-strip__action" href="/help">Open help</a>
            </div>
        </article>
        <article class="gateway-card">
            <div class="gateway-card__header">
                <span class="tag">Continuity</span>
                <h3>Next safe action</h3>
            </div>
            <p>The installable shell does not replace downloads, support, or account recovery. It keeps the return path explicit when you move between public, linked, and session surfaces.</p>
            <div class="stacked-actions">
                <a class="editorial-strip__action" href="/play/continuity">Open continuity</a>
                <a class="editorial-strip__action" href="/help">Open setup help</a>
            </div>
        </article>
    </div>
</section>

<section class="workflow-band workflow-band--compact">
    <div class="workflow-band__lead">
        <p class="eyebrow">Capabilities</p>
        <h2 class="editorial-title">One mobile view, five clear promises.</h2>
    </div>
    <div class="flagship-gateway-grid flagship-gateway-grid--compact">
        @foreach (var capability in Model.Capabilities)
        {
            <article class="gateway-card">
                <div class="gateway-card__header">
                    <span class="tag">Included</span>
                    <h3>@PublicMobileText(capability.Label)</h3>
                </div>
                <p>@PublicMobileText(capability.Summary)</p>
            </article>
        }
    </div>
</section>

<section class="workflow-band workflow-band--compact">
    <div class="workflow-band__lead">
        <p class="eyebrow">Role entry</p>
        <h2 class="editorial-title">Player, GM, and observer entry points meet in one shell.</h2>
        <p class="editorial-copy">Choose a role-specific front door without splitting the product into different stories. The same app shell keeps install, return, and reconnect status visible in every role.</p>
    </div>
    <div class="route-choice-grid route-choice-grid--three">
        @foreach (var role in Model.Roles)
        {
            <article class="route-choice-card">
                <span class="tag">@(role.Current ? "Current role" : "Role alias")</span>
                <h3>@PublicMobileText(role.Label)</h3>
                <p>@PublicMobileText(role.Summary)</p>
                <a class="editorial-strip__action" href="@role.Href">Open @PublicMobileText(role.Label)</a>
            </article>
        }
    </div>
</section>

@if (Model.SignedInStatus is not null)
{
    <section class="workflow-band workflow-band--compact">
        @await Html.PartialAsync("~/Views/Shared/_SignedInTrustStatusPanel.cshtml", Model.SignedInStatus)
    </section>
}

@if (Model.TrustPulse is not null)
{
    <section class="workflow-band workflow-band--compact">
        @await Html.PartialAsync("~/Views/Shared/_PublicTrustPulsePanel.cshtml", Model.TrustPulse)
    </section>
}

@section Scripts
{
    <script>
        (function () {
            var installButton = document.querySelector("[data-install-prompt-button]");
            var installState = document.querySelector("[data-pwa-install-state]");
            var onlineState = document.querySelector("[data-pwa-online-state]");
            var deferredPrompt = null;

            function setOnlineState() {
                if (!onlineState) {
                    return;
                }

                onlineState.textContent = navigator.onLine ? "Online" : "Offline";
            }

            function setInstallAvailability(ready) {
                if (!installButton || !installState) {
                    return;
                }

                if (ready) {
                    installButton.removeAttribute("aria-disabled");
                    installState.textContent = "This browser exposed a direct install prompt. Use it when you want the shell pinned like an app.";
                    return;
                }

                installButton.setAttribute("aria-disabled", "true");
                installState.textContent = "If this browser does not expose a direct install prompt, use its Add to Home Screen or Install App menu. The shell still keeps the same continuity path.";
            }

            setOnlineState();
            setInstallAvailability(false);
            window.addEventListener("online", setOnlineState);
            window.addEventListener("offline", setOnlineState);

            window.addEventListener("beforeinstallprompt", function (event) {
                event.preventDefault();
                deferredPrompt = event;
                setInstallAvailability(true);
            });

            if (installButton) {
                installButton.addEventListener("click", async function () {
                    if (!deferredPrompt) {
                        return;
                    }

                    deferredPrompt.prompt();
                    try {
                        await deferredPrompt.userChoice;
                    } finally {
                        deferredPrompt = null;
                        setInstallAvailability(false);
                    }
                });
            }

            window.addEventListener("appinstalled", function () {
                deferredPrompt = null;
                if (installState) {
                    installState.textContent = "Installed. Re-open the shell from your app drawer or home screen to keep return and role entry on the same path.";
                }
                setInstallAvailability(false);
            });
        })();
    </script>
}

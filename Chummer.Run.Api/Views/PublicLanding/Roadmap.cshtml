@using Chummer.Run.Api.Services
@model RoadmapPageViewModel
@{
    ViewData["Title"] = "Roadmap";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-roadmap surface-minimal";

    var milestones = Model.Milestones.Take(4).ToArray();
    var plannedWork = Model.Horizons
        .Where(item => PublicSurfaceStatus.IsPreparingNext(item.Card.Badge)
            || PublicSurfaceStatus.IsDesigningInPublic(item.Card.Badge))
        .Take(4)
        .ToArray();

    static string RoadmapText(string? value)
        => PublicFacingCopyHumanizer.Clean(value)
            .Replace("planned work", "future work", StringComparison.OrdinalIgnoreCase)
            .Replace("maintenance", "future work", StringComparison.OrdinalIgnoreCase)
            .Replace("Claimed", "Started", StringComparison.OrdinalIgnoreCase)
            .Replace("claim", "start", StringComparison.OrdinalIgnoreCase)
            .Replace("implementation slice", "work item", StringComparison.OrdinalIgnoreCase)
            .Replace("implementation", "work", StringComparison.OrdinalIgnoreCase);
}

<section class="minimal-page-hero route-anchor-target roadmap-signal">
    <div>
        <p class="eyebrow">Roadmap</p>
        <h1>What is next</h1>
        <p>A short view of current work and later ideas. Use the changelog for shipped changes.</p>
    </div>
    <div class="minimal-status-pill">
        <span>Planning surface</span>
        <strong>Current work</strong>
        <span>Later ideas</span>
        <span>Changelog covers shipped work</span>
    </div>
</section>

<section class="status-decision-strip roadmap-signal-grid" aria-label="Roadmap route split">
    <article class="status-decision-strip__card">
        <span class="tag">Participate</span>
        <h2>Votes inform demand.</h2>
        <p>Feedback, planning, shipped updates, and private help stay on different pages.</p>
        <a class="button-like button-like--ghost" href="/participate">Participate</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag">Shipped</span>
        <h2>Use changelog for live changes.</h2>
        <p>Recent requests at a glance. The changelog owns what is already in the app or public routes.</p>
        <a class="button-like button-like--ghost" href="/changelog">Open changelog</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag tag--amber">Help</span>
        <h2>Use Help for setup, account, or bug problems.</h2>
        <p>Leave this page when the next step needs support instead of planning context.</p>
        <a class="button-like button-like--ghost" href="/help">Open help</a>
    </article>
</section>

<section class="minimal-section roadmap-milestones" aria-labelledby="roadmap-active-work">
    <div class="minimal-section__lead">
        <p class="eyebrow">Now</p>
        <h2 id="roadmap-active-work">Current work</h2>
        <p>These items are active enough to mention publicly. They are not promises until they reach the changelog.</p>
    </div>

    @if (milestones.Length == 0)
    {
        <article class="minimal-empty">
            <h3>Milestones are temporarily unavailable</h3>
            <p>Try the changelog or participate page while this view catches up.</p>
        </article>
    }
    else
    {
        <div class="minimal-lane-grid">
            @foreach (var milestone in milestones)
            {
                <article class="minimal-lane-card">
                    <span class="tag">@RoadmapText(milestone.StatusLabel)</span>
                    <h3>@RoadmapText(milestone.Title)</h3>
                    <p>@RoadmapText(milestone.CasualSummary)</p>
                    <dl class="roadmap-milestone-facts milestone-drawer__tease">
                        <div>
                            <dt>Difficulty:</dt>
                            <dd>@RoadmapText(milestone.DifficultyLabel) · @RoadmapText(milestone.DifficultySummary)</dd>
                        </div>
                        <div>
                            <dt>Claimed:</dt>
                            <dd>@(milestone.Claimed ? RoadmapText(milestone.ClaimedLabel) : "No") · @RoadmapText(milestone.ClaimedSummary)</dd>
                        </div>
                        <div>
                            <dt>Dependencies:</dt>
                            <dd>
                                @if (milestone.Dependencies.Count == 0)
                                {
                                    <span>@RoadmapText(milestone.DependencySummary)</span>
                                }
                                else
                                {
                                    <span>@string.Join(", ", milestone.Dependencies.Select(static dependency => $"{dependency.Title} ({dependency.StatusLabel})"))</span>
                                }
                            </dd>
                        </div>
                    </dl>
                </article>
            }
        </div>
    }
</section>

@if (plannedWork.Length > 0)
{
    <section class="minimal-section minimal-section--tight" aria-labelledby="roadmap-planned-work">
        <div class="minimal-section__lead">
            <p class="eyebrow">Later</p>
            <h2 id="roadmap-planned-work">Worth watching</h2>
            <p>A few larger directions stay visible so people know where their feedback belongs.</p>
        </div>
        <div class="minimal-lane-grid">
            @foreach (var item in plannedWork)
            {
                <article class="minimal-lane-card">
                    <span class="tag">@PublicSurfaceStatus.DisplayLabel(item.Card.Badge)</span>
                    <h3>@RoadmapText(item.Card.Title)</h3>
                    <p>@RoadmapText(item.Card.Summary)</p>
                    <div class="minimal-actions">
                        <a class="button-like button-like--ghost" href="@item.Action.Href">@RoadmapText(item.Action.Label)</a>
                    </div>
                </article>
            }
        </div>
    </section>
}

<section class="minimal-section minimal-section--tight">
    <div class="minimal-section__lead">
        <p class="eyebrow">Next</p>
        <h2>Read the direction, then move on.</h2>
        <p>Use Participate for demand, Changelog for shipped changes, or What works today for the current app.</p>
    </div>
    <div class="minimal-actions">
        <a class="button-like button-like--primary" href="/participate">Participate</a>
        <a class="button-like button-like--ghost" href="/changelog">Open changelog</a>
        <a class="button-like button-like--ghost" href="/now">What works today</a>
    </div>
</section>

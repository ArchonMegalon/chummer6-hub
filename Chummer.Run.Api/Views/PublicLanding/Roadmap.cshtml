@using Chummer.Run.Api.Services
@model RoadmapPageViewModel
@{
    ViewData["Title"] = "Roadmap";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-roadmap surface-minimal";

    var milestones = Model.Milestones.Take(3).ToArray();
    var plannedWork = Model.Horizons
        .Where(item => PublicSurfaceStatus.IsPreparingNext(item.Card.Badge)
            || PublicSurfaceStatus.IsDesigningInPublic(item.Card.Badge))
        .Take(3)
        .ToArray();

    static string RoadmapText(string? value)
        => PublicFacingCopyHumanizer.Clean(value)
            .Replace("planned work", "future work", StringComparison.OrdinalIgnoreCase)
            .Replace("maintenance", "future work", StringComparison.OrdinalIgnoreCase)
            .Replace("Claimed", "Started", StringComparison.OrdinalIgnoreCase)
            .Replace("claim", "start", StringComparison.OrdinalIgnoreCase)
            .Replace("implementation slice", "work item", StringComparison.OrdinalIgnoreCase)
            .Replace("implementation", "work", StringComparison.OrdinalIgnoreCase);
}

<section class="feature-detail-hero route-anchor-target">
    <p class="eyebrow">Roadmap</p>
    <h1 class="page-title">What we are working on next</h1>
    <p class="page-copy">A short view of direction and open work. Use the changelog for what already shipped, and feedback when you want to ask for a change.</p>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="/feedback">Suggest a change</a>
        <a class="button-like button-like--secondary" href="/changelog">See recent updates</a>
        <a class="button-like button-like--ghost" href="/now">What works today</a>
    </div>
</section>

<section class="feature-detail-panel" aria-labelledby="roadmap-active-work">
    <div>
        <p class="eyebrow">Now</p>
        <h2 id="roadmap-active-work" class="editorial-title">Near-term work</h2>
        <p class="editorial-copy">These items are active enough to mention publicly, but they are not promises until they appear in the changelog.</p>
    </div>

    @if (milestones.Length == 0)
    {
        <article class="feature-detail-card">
            <span class="tag tag--quiet">Not loaded</span>
            <h3>Milestones are temporarily unavailable</h3>
            <p>Try the changelog or feedback page while this view catches up.</p>
        </article>
    }
    else
    {
        <div class="route-choice-grid">
            @foreach (var milestone in milestones)
            {
                <article class="feature-detail-card">
                    <span class="tag">@RoadmapText(milestone.StatusLabel)</span>
                    <h3>@RoadmapText(milestone.Title)</h3>
                    <p>@RoadmapText(milestone.CasualSummary)</p>
                </article>
            }
        </div>
    }
</section>

@if (plannedWork.Length > 0)
{
    <section class="feature-detail-panel" aria-labelledby="roadmap-planned-work">
        <div>
            <p class="eyebrow">Later</p>
            <h2 id="roadmap-planned-work" class="editorial-title">Ideas worth following</h2>
            <p class="editorial-copy">A few larger directions are visible so contributors can decide where their feedback belongs.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var item in plannedWork)
            {
                <article class="feature-detail-card">
                    <span class="tag">@PublicSurfaceStatus.DisplayLabel(item.Card.Badge)</span>
                    <h3>@RoadmapText(item.Card.Title)</h3>
                    <p>@RoadmapText(item.Card.Summary)</p>
                    <a class="editorial-strip__action" href="@item.Action.Href">@RoadmapText(item.Action.Label)</a>
                </article>
            }
        </div>
    </section>
}

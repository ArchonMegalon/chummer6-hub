@model RoadmapPageViewModel
@{
    ViewData["Title"] = "Roadmap";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-roadmap surface-roadmap-board surface-minimal";
}

@if (!string.IsNullOrWhiteSpace(Model.HostedBoardHref))
{
    <section class="roadmap-board-frame route-anchor-target" aria-labelledby="roadmap-title">
        <div class="minimal-section__lead roadmap-board-frame__lead">
            <p class="eyebrow">Roadmap</p>
            <h1 id="roadmap-title">Roadmap</h1>
            <p>Planned work and current requests.</p>
        </div>
        <iframe
            class="roadmap-board-frame__embed"
            src="@Model.HostedBoardHref"
            title="Chummer roadmap board"
            loading="eager"
            referrerpolicy="same-origin"
            data-chummer-roadmap-frame></iframe>
    </section>
}
else
{
    <section class="minimal-section minimal-section--tight roadmap-fallback-state route-anchor-target" aria-labelledby="roadmap-fallback-title">
        <div class="minimal-section__lead">
            <p class="eyebrow">Roadmap</p>
            <h1 id="roadmap-fallback-title">Board offline right now.</h1>
            <p>Use Participate for requests and Changelog for shipped work.</p>
        </div>
        <div class="minimal-actions">
            <a class="button-like button-like--primary" href="/participate">Participate</a>
            <a class="button-like button-like--ghost" href="/changelog">Changelog</a>
        </div>
    </section>
}

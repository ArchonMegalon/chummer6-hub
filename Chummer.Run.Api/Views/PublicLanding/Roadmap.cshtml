@model RoadmapPageViewModel
@{
    ViewData["Title"] = "Roadmap";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-roadmap surface-minimal";
}

@if (!string.IsNullOrWhiteSpace(Model.HostedBoardHref))
{
    <section class="participate-shell roadmap-shell">
        <div class="participate-shell__header">
            <div class="participate-shell__lead">
                <p class="eyebrow">Roadmap</p>
                <h1>Roadmap</h1>
                <p>Public direction, without the project-management noise.</p>
                <p>Use the changelog for shipped changes.</p>
            </div>
            <div class="participate-actions">
                <a class="button-like button-like--ghost" href="/partizipate">Participate</a>
                <a class="button-like button-like--primary" href="/changelog">Open changelog</a>
            </div>
        </div>

        <div class="participate-board">
            <div class="participate-hosted">
                <div class="participate-hosted__header">
                    <div class="participate-hosted__lead">
                        <h2>Current work</h2>
                        <p>The hosted roadmap stays on this route.</p>
                    </div>
                    <div class="participate-hosted__status">
                        <span class="participate-count">Roadmap</span>
                    </div>
                </div>
                <iframe
                    id="roadmap-board"
                    class="participate-hosted__frame"
                    src="@Model.HostedBoardHref"
                    title="Roadmap board"
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin"></iframe>
            </div>

            <aside class="participate-items" aria-label="Roadmap guidance">
                <h3>Use the right place</h3>
                <p>Keep the path short.</p>
                <article class="participate-lane">
                    <span>Requests</span>
                    <h3>Use Participate for new demand</h3>
                    <p>Vote, comment, and keep requests public there.</p>
                    <a class="inline-link" href="/partizipate">Open participate</a>
                </article>
                <article class="participate-lane">
                    <span>Shipped</span>
                    <h3>Use the changelog for released work</h3>
                    <p>That is the page for finished changes.</p>
                    <a class="inline-link" href="/changelog">Open changelog</a>
                </article>
            </aside>
        </div>
    </section>
}
else
{
    <section class="minimal-page-hero route-anchor-target roadmap-signal">
        <div>
            <p class="eyebrow">Roadmap</p>
            <h1>Maintenance first.</h1>
            <p>We are spending the current cycle on install reliability, cleaner screens, and fewer support dead ends.</p>
        </div>
    </section>

    <section class="minimal-section roadmap-milestones" aria-labelledby="roadmap-active-work">
        <div class="minimal-section__lead">
            <p class="eyebrow">Now</p>
            <h2 id="roadmap-active-work">Current focus</h2>
            <p>Short list. No internal labels.</p>
        </div>
        <div class="minimal-lane-grid">
            <article class="minimal-lane-card">
                <span class="tag">Install</span>
                <h3>Make setup boring</h3>
                <p>Smaller installers, visible update progress, and better recovery when something fails.</p>
            </article>
            <article class="minimal-lane-card">
                <span class="tag">Desktop</span>
                <h3>Clean the builder</h3>
                <p>Readable controls, less duplicated UI, and fewer surprises while creating a runner.</p>
            </article>
            <article class="minimal-lane-card">
                <span class="tag">Web</span>
                <h3>Keep the site quiet</h3>
                <p>Downloads, help, account, billing, and public feedback should stay short and clear.</p>
            </article>
        </div>
    </section>

    <section class="minimal-section minimal-section--tight">
        <div class="minimal-section__lead">
            <p class="eyebrow">Elsewhere</p>
            <h2>Use the right page.</h2>
            <p>Participate is for requests. Changelog is for shipped work. Help is for anything blocking you.</p>
        </div>
        <div class="minimal-actions">
            <a class="button-like button-like--primary" href="/partizipate">Participate</a>
            <a class="button-like button-like--ghost" href="/changelog">Open changelog</a>
            <a class="button-like button-like--ghost" href="/help">Open help</a>
        </div>
    </section>
}

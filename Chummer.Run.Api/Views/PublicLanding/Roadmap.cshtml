@model RoadmapPageViewModel
@{
    ViewData["Title"] = "Roadmap";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-roadmap surface-minimal";
}

<section class="minimal-page-hero route-anchor-target" aria-labelledby="roadmap-title">
    <div>
        <p class="eyebrow">Roadmap</p>
        <h1 id="roadmap-title">In progress.</h1>
        <p>Planned work lives here. Shipped work moves to Changelog.</p>
        <div class="minimal-actions" aria-label="Roadmap actions">
            <a class="button-like button-like--primary" href="/changelog">Changelog</a>
            <a class="button-like button-like--ghost" href="/participate">Participate</a>
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.HostedBoardHref))
{
    <section class="minimal-section minimal-section--tight roadmap-frame roadmap-frame--minimal" aria-labelledby="roadmap-board-title">
        <div class="minimal-section__lead roadmap-frame__lead">
            <p class="eyebrow">Live board</p>
            <h2 id="roadmap-board-title">Current work</h2>
            <p>Work opens below.</p>
        </div>
        <iframe
            class="roadmap-frame__embed"
            src="@Model.HostedBoardHref"
            title="Roadmap board"
            loading="eager"
            referrerpolicy="strict-origin-when-cross-origin"
            data-chummer-roadmap-frame></iframe>
    </section>
}
else
{
    <section class="minimal-section minimal-section--tight roadmap-fallback-state" aria-labelledby="roadmap-fallback-title">
        <div class="minimal-section__lead">
            <p class="eyebrow">Roadmap</p>
            <h2 id="roadmap-fallback-title">Requests stay in Participate.</h2>
            <p>Shipped work moves to Changelog.</p>
        </div>
        <div class="minimal-actions">
            <a class="button-like button-like--primary" href="/changelog">Changelog</a>
            <a class="button-like button-like--ghost" href="/participate">Participate</a>
        </div>
    </section>
}

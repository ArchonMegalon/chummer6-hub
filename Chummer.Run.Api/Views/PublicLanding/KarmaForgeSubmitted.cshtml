@model KarmaForgeSubmittedPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-karma-forge-submitted";
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@Model.Intro</p>
        <div class="trust-claim__microproof">
            <span>@Model.SubmissionId</span>
            <span>@Model.TrackTitle</span>
            <span>@Model.QueueStatus</span>
        </div>
    </div>
    <div class="stacked-actions">
        @foreach (var action in Model.Actions)
        {
            <a class="button-like button-like--@action.Tone" href="@action.Href">@action.Label</a>
        }
    </div>
</section>

@if (Model.SignedInStatus is not null)
{
    @await Html.PartialAsync("~/Views/Shared/_SignedInTrustStatusPanel.cshtml", Model.SignedInStatus)
}
@if (Model.TrustPulse is not null)
{
    @await Html.PartialAsync("~/Views/Shared/_PublicTrustPulsePanel.cshtml", Model.TrustPulse)
}

<section class="trust-rail-section">
    <div class="editorial-block__lead">
        <p class="eyebrow">What happened</p>
        <h2 class="editorial-title">@Model.PacketTitle</h2>
        <p class="editorial-copy">@Model.QueueSummary</p>
    </div>
    <div class="trust-rail-list">
        <article class="trust-rail">
            <span class="tag">Decision</span>
            <p><strong>@Model.CandidateDecision</strong> · @Model.CandidateDecisionMeaning</p>
        </article>
        <article class="trust-rail">
            <span class="tag">Next action</span>
            <p>@Model.ReporterNextAction</p>
        </article>
        <article class="trust-rail">
            <span class="tag">Consent</span>
            <p>@Model.ConsentSummary</p>
        </article>
    </div>
</section>

<section class="compact-rail">
    @foreach (var highlight in Model.Highlights)
    {
        <article class="compact-rail__item">
            <div class="compact-rail__copy">
                <h3>Packet detail</h3>
                <p>@highlight</p>
            </div>
        </article>
    }
</section>

<section class="trust-page-layout">
    <aside class="account-nav account-nav--trust" aria-label="KARMA FORGE receipt sections">
        <a href="#next-questions">Next questions</a>
        <a href="#next-steps">Next steps</a>
        <a href="#packet-json">Packet artifacts</a>
    </aside>
    <div class="trust-page-sections">
        <article class="trust-page-section" id="next-questions">
            <p class="eyebrow">Icanpreneur follow-through</p>
            <h2>Questions that should sharpen the next pass</h2>
            <p>@(Model.FollowUpAllowed ? "Follow-up is allowed, so these are the most likely questions Chummer will ask next if this packet stays high-signal." : "Follow-up is off, but these are still the canonical prompts that would sharpen the packet if you return later.")</p>
            <ul class="trust-page-section__list">
                @foreach (var question in Model.NextQuestions)
                {
                    <li>@question</li>
                }
            </ul>
        </article>

        <article class="trust-page-section" id="next-steps">
            <p class="eyebrow">Chummer-owned route</p>
            <h2>What should happen before any implementation talk</h2>
            <p>These next steps are attached to the normalized HouseRuleDemandPacket, not left as loose operator memory.</p>
            <ul class="trust-page-section__list">
                @foreach (var step in Model.NextSteps)
                {
                    <li>@step</li>
                }
            </ul>
            <p class="muted-copy">Anonymous quote permission is @(Model.QuoteAllowed ? "enabled" : "disabled").</p>
        </article>

        <article class="trust-page-section" id="packet-json">
            <p class="eyebrow">Packet artifacts</p>
            <h2>The normalized outputs are visible here</h2>
            <p>These JSON previews are Chummer-owned packet shapes. They are the durable intake truth for this submission, not raw interview notes.</p>

            <details class="details-drawer" open>
                <summary>HouseRuleDemandPacket</summary>
                <pre>@Model.PacketJson</pre>
            </details>
            <details class="details-drawer">
                <summary>KarmaForgeCandidate</summary>
                <pre>@Model.CandidateJson</pre>
            </details>
            <details class="details-drawer">
                <summary>RuleEnvironmentImpactHypothesis</summary>
                <pre>@Model.ImpactHypothesisJson</pre>
            </details>
        </article>
    </div>
</section>

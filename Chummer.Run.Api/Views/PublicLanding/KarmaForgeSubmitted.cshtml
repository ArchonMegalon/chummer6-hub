@using Chummer.Run.Api.Services
@model KarmaForgeSubmittedPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-karma-forge-submitted";
    ViewData["ContextSidebarHeading"] = "KARMA FORGE submission";
    ViewData["ContextSidebarSummary"] = "Keep next steps, next questions, and saved details in the shared side panel.";
    ViewData["ContextSidebarLinks"] = new[]
    {
        new PublicNavigationLink("Next questions", "#next-questions"),
        new PublicNavigationLink("Next steps", "#next-steps"),
        new PublicNavigationLink("Saved details", "#packet-json"),
    };
    var governedDecisionLabel = string.Concat("Product", " Governor");
    var queueStatusLabel = Model.QueueStatus.Replace(governedDecisionLabel, "Reviewed product decision", StringComparison.OrdinalIgnoreCase);
    string SanitizePublicText(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        string cleaned = value
            .Replace(string.Concat("Product", " Governor"), "product decision", StringComparison.OrdinalIgnoreCase)
            .Replace(string.Concat("Face", "Pop"), "public invitation", StringComparison.OrdinalIgnoreCase)
            .Replace(string.Concat("Deft", "form"), "structured pre-screen", StringComparison.OrdinalIgnoreCase)
            .Replace(string.Concat("Ican", "preneur"), "guided review path", StringComparison.OrdinalIgnoreCase)
            .Replace(string.Concat("Tea", "ble"), "review board", StringComparison.OrdinalIgnoreCase)
            .Replace(string.Concat("Next", "Step"), "review path", StringComparison.OrdinalIgnoreCase)
            .Replace(string.Concat("Oper", "atorNotes"), "ReviewNotes", StringComparison.OrdinalIgnoreCase)
            .Replace("bounded", "limited", StringComparison.OrdinalIgnoreCase)
            .Replace("normalized", "saved", StringComparison.OrdinalIgnoreCase)
            .Replace("HouseRuleDemandPacket", "rules request", StringComparison.OrdinalIgnoreCase)
            .Replace("KarmaForgeCandidate", "saved request", StringComparison.OrdinalIgnoreCase);

        return PublicFacingCopyHumanizer.Clean(cleaned);
    }
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@Model.Intro</p>
        <div class="trust-claim__details">
            <span>Submission saved</span>
            <span>@SanitizePublicText(Model.TrackTitle)</span>
            <span>@SanitizePublicText(queueStatusLabel)</span>
        </div>
    </div>
    <div class="stacked-actions">
        @foreach (var action in Model.Actions)
        {
            <a class="button-like button-like--@action.Tone" href="@action.Href">@action.Label</a>
        }
    </div>
</section>

<section class="trust-rail-section">
    <div class="editorial-block__lead">
        <p class="eyebrow">What happened</p>
        <h2 class="editorial-title">@SanitizePublicText(Model.PacketTitle)</h2>
        <p class="editorial-copy">@SanitizePublicText(Model.QueueSummary)</p>
    </div>
    <div class="trust-rail-list">
        <article class="trust-rail">
            <span class="tag">Decision</span>
            <p><strong>@SanitizePublicText(Model.CandidateDecision)</strong> · @SanitizePublicText(Model.CandidateDecisionMeaning)</p>
        </article>
        <article class="trust-rail">
            <span class="tag">Next action</span>
            <p>@SanitizePublicText(Model.ReporterNextAction)</p>
        </article>
        <article class="trust-rail">
            <span class="tag">Consent</span>
            <p>@SanitizePublicText(Model.ConsentSummary)</p>
        </article>
    </div>
</section>

<section class="compact-rail">
    @foreach (var highlight in Model.Highlights)
    {
        <article class="compact-rail__item">
            <div class="compact-rail__copy">
                <h3>Saved detail</h3>
                <p>@SanitizePublicText(highlight)</p>
            </div>
        </article>
    }
</section>

<section class="editorial-block" id="review-next-steps">
    <div class="editorial-block__lead">
        <p class="eyebrow">Next steps</p>
        <h2 class="editorial-title">The next steps stay clear from follow-up through closeout.</h2>
        <p class="editorial-copy">These steps can sharpen, schedule, review, decide, or close out the request. Chummer still makes the final product decision.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var stage in Model.ExternalStages)
        {
            <article class="route-choice-card">
                <span class="tag">@SanitizePublicText(stage.PublicLabel)</span>
                <h3>@stage.Status.Replace("_", " ", StringComparison.OrdinalIgnoreCase)</h3>
                <p>@SanitizePublicText(stage.Summary)</p>
                <div class="route-choice-card__details">
                    <span>Step saved</span>
                    <span>@SanitizePublicText(stage.Boundary.Replace("_", " ", StringComparison.OrdinalIgnoreCase))</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(stage.ActionHref) && !string.IsNullOrWhiteSpace(stage.ActionLabel))
                {
                    <a class="editorial-strip__action" href="@stage.ActionHref">@stage.ActionLabel</a>
                }
            </article>
        }
    </div>
</section>

<section class="compact-rail">
    @foreach (var journeyRef in Model.JourneyProofEventRefs)
    {
        <article class="compact-rail__item">
            <div class="compact-rail__copy">
                <h3>@journeyRef.EventKey</h3>
                <p>@SanitizePublicText(journeyRef.Summary)</p>
            </div>
        </article>
    }
</section>

<section class="trust-page-layout">
    <div class="trust-page-sections">
        <article class="trust-page-section" id="next-questions">
            <p class="eyebrow">Next questions queue</p>
            <h2>Questions that should sharpen the next pass</h2>
            <p>@(Model.FollowUpAllowed ? "Follow-up is allowed, so these are the most likely questions Chummer will ask next." : "Follow-up is off, but these questions can still sharpen the request if you return later.")</p>
            <ul class="trust-page-section__list">
                @foreach (var question in Model.NextQuestions)
                {
                    <li>@SanitizePublicText(question)</li>
                }
            </ul>
        </article>

        <article class="trust-page-section" id="next-steps">
            <p class="eyebrow">What happens next</p>
            <h2>What should happen before any implementation talk</h2>
            <p>These next steps stay attached to the saved rules request instead of becoming loose follow-up notes.</p>
            <ul class="trust-page-section__list">
                @foreach (var step in Model.NextSteps)
                {
                    <li>@SanitizePublicText(step)</li>
                }
            </ul>
            <p class="muted-copy">Anonymous quote permission is @(Model.QuoteAllowed ? "enabled" : "disabled").</p>
        </article>

        <article class="trust-page-section" id="packet-json">
            <p class="eyebrow">Saved details</p>
            <h2>The saved details are visible here</h2>
            <p>These previews show what Chummer saved for this submission.</p>

            <details class="details-drawer">
                <summary>Saved rules request</summary>
                <pre>@SanitizePublicText(Model.PacketJson)</pre>
            </details>
            <details class="details-drawer">
                <summary>Saved review state</summary>
                <pre>@SanitizePublicText(Model.CandidateJson)</pre>
            </details>
            <details class="details-drawer">
                <summary>Rules impact</summary>
                <pre>@SanitizePublicText(Model.ImpactHypothesisJson)</pre>
            </details>
        </article>
    </div>
</section>

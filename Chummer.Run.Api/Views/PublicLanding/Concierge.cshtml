@model PublicConciergePageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-public-concierge";
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@Model.Intro</p>
    </div>
    <div class="stacked-actions">
        @foreach (var action in Model.Actions)
        {
            <a class="button-like button-like--@action.Tone" href="@action.Href">@action.Label</a>
        }
    </div>
</section>

<section class="continuity-band trust-doc-band">
    <div class="continuity-band__copy">
        <p class="eyebrow">Instant help</p>
        <h2 class="editorial-title">Answer first. Show the path. Fix or report.</h2>
        <p class="editorial-copy">Start with the shortest useful answer. If it is still unclear, open the exact page or send a private support note.</p>
    </div>
    <div class="continuity-band__panel">
        <article class="continuity-band__fact">
            <span>Step 1</span>
            <strong>Get the answer</strong>
            <p>Pick the closest issue below and use the direct Chummer page first.</p>
        </article>
        <article class="continuity-band__fact">
            <span>Step 2</span>
            <strong>Open the right place</strong>
            <p>Downloads, release notes, account return, and private support stay separate.</p>
        </article>
        <article class="continuity-band__fact">
            <span>Step 3</span>
            <strong>Send context if blocked</strong>
            <p>Use support when setup, updates, or account return still fail.</p>
        </article>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Widget.IframeHref))
{
    <section class="release-shelf">
        <details class="release-accordion">
            <summary>Show guided help</summary>
            <div class="release-accordion__body">
                <p class="muted-copy">If this panel does not load, use the choices below.</p>
                <iframe
                    src="@Model.Widget.IframeHref"
                    title="@Model.Heading"
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin"
                    style="width:100%;min-height:480px;border:1px solid rgba(255,255,255,.12);border-radius:1rem;background:rgba(9,14,19,.72);"></iframe>
            </div>
        </details>
    </section>
}

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Choose one</p>
        <h2 class="editorial-title">Pick the next step that matches the problem.</h2>
        <p class="editorial-copy">Use the direct path first. Keep private logs, account issues, and table details out of public feedback.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var branch in Model.Branches)
        {
            <article class="route-choice-card">
                <span class="tag">@branch.DestinationLabel</span>
                <h3>@branch.Title</h3>
                <p>@branch.Summary</p>
                <a class="editorial-strip__action" href="@branch.ActionHref">@branch.ActionLabel</a>
            </article>
        }
    </div>
</section>

<section class="release-footnote">
    <p class="eyebrow">Still blocked?</p>
    <h2 class="editorial-title">Send the issue with enough context to reproduce it.</h2>
    <p class="editorial-copy">For setup problems, include platform, build, and what happened right before the failure.</p>
</section>

@model PublicConciergePageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-public-concierge";
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@Model.Intro</p>
        <div class="trust-claim__microproof">
            <span>Entry surface: @Model.EntrySurfaceLabel</span>
            <span>Locale: @Model.Locale</span>
            <span>@(Model.LocaleFallbackUsed ? "Locale fell back to default" : "Locale kept from request")</span>
            <span>@Model.Widget.StatusLabel</span>
        </div>
    </div>
    <div class="stacked-actions">
        @foreach (var action in Model.Actions)
        {
            <a class="button-like button-like--@action.Tone" href="@action.Href">@action.Label</a>
        }
    </div>
</section>

<section class="continuity-band trust-doc-band">
    <div class="continuity-band__copy">
        <p class="eyebrow">Wrapper status</p>
        <h2 class="editorial-title">Optional guidance, bounded trust, visible fallback.</h2>
        <p class="editorial-copy">@Model.Widget.Summary</p>
    </div>
    <div class="continuity-band__panel">
        @foreach (var point in Model.ProofPoints)
        {
            <article class="continuity-band__fact">
                <span>Proof</span>
                <strong>@point</strong>
                <p>Chummer keeps the route choice, fallback links, and receipt correlation first-party.</p>
            </article>
        }
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Widget.IframeHref))
{
    <section class="release-shelf">
        <details class="release-accordion" open>
            <summary>Optional guided widget</summary>
            <div class="release-accordion__body">
                <p class="muted-copy">The embedded guide is optional. If it fails or gets disabled, the first-party branch cards below stay valid.</p>
                <iframe
                    src="@Model.Widget.IframeHref"
                    title="@Model.Heading"
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin"
                    style="width:100%;min-height:480px;border:1px solid rgba(255,255,255,.12);border-radius:1rem;background:rgba(9,14,19,.72);"></iframe>
                @if (!string.IsNullOrWhiteSpace(Model.Widget.HostLabel))
                {
                    <p class="muted-copy">Embedded host: @Model.Widget.HostLabel</p>
                }
            </div>
        </details>
    </section>
}

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Choose a route</p>
        <h2 class="editorial-title">Every branch still lands on a Chummer-owned next step or a bounded handoff with a visible fallback.</h2>
        <p class="editorial-copy">Pick the closest match, and this wrapper will mint a first-party receipt before it redirects.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var branch in Model.Branches)
        {
            <article class="route-choice-card">
                <span class="tag">@branch.DestinationLabel</span>
                <h3>@branch.Title</h3>
                <p>@branch.Summary</p>
                <a class="editorial-strip__action" href="@branch.ActionHref">@branch.ActionLabel</a>
            </article>
        }
    </div>
</section>

<section class="release-footnote">
    <p class="eyebrow">First-party boundary</p>
    <h2 class="editorial-title">Support, install, account, and publication truth remain on Hub-owned rails.</h2>
    <p class="editorial-copy">This page can shorten the choice. It does not replace the downloads shelf, support case truth, account ownership, or publication governance.</p>
</section>

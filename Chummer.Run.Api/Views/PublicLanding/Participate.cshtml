@model ParticipatePageViewModel
@{
    ViewData["Title"] = "Participate";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-minimal surface-participate";
}

<section class="minimal-page-hero participate-hero">
    <div>
        <h1>Share what matters for your table</h1>
        <p>
            Use this lane for quick, public feedback on builds, usability, and behavior.
            Keep account-only details for private help.
        </p>
    </div>
</section>

<section class="participate-shell">
    <h2>Fast feedback</h2>
    <p class="participate-shell__lead">
        Choose one action, and we keep each request focused and reviewable.
    </p>

    <div class="participate-actions">
        <a class="button-like button-like--primary" href="@Model.PrivateHelpHref">I need help with a specific issue</a>
        <a class="button-like" href="@Model.RoadmapHref">See what is in planning</a>
        <a class="button-like" href="@Model.ChangelogHref">See what already shipped</a>
    </div>

    <form class="participate-quick-form" method="get" action="/contact">
        <div class="field">
            <label for="participateTitle">Short title</label>
            <input id="participateTitle" name="subject" maxlength="120" placeholder="One concrete suggestion or bug report" />
        </div>
        <div class="field">
            <label for="participateSummary">Details</label>
            <textarea id="participateSummary" name="message" rows="6" maxlength="1200" placeholder="What happened, what you expected, and why it matters."></textarea>
        </div>
        <div class="field">
            <label for="participateKind">Category</label>
            <select id="participateKind" name="topic">
                <option value="">Choose category</option>
                <option value="feature">Feature</option>
                <option value="bug">Bug</option>
                <option value="desktop">Desktop UX</option>
                <option value="install">Install or update</option>
                <option value="linux">Linux</option>
            </select>
        </div>
        <button class="button-like button-like--primary" type="submit">Send feedback</button>
    </form>

    <section class="participate-items" aria-label="Current public themes">
        <h3>Themes we are currently prioritizing</h3>
        <p>Quick updates from the table:</p>
        @foreach (var item in Model.Items)
        {
            <article>
                <h4>@item.Title</h4>
                <p>@item.Summary</p>
            </article>
        }
    </section>
</section>

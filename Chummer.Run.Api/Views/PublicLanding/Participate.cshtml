@model ParticipatePageViewModel
@{
    ViewData["Title"] = "Participate";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-participate";
    var codexHref = Model.Chrome.Authenticated
        ? "/participate/codex"
        : "/auth/google/start?next=%2Fparticipate%2Fcodex";
}

<section class="release-footnote">
    <p class="eyebrow">Participate</p>
    <h1 class="page-title">Choose how to participate</h1>
    <p class="page-copy">Report a problem in public, or sign in and explicitly let Chummer use your OpenAI account in ChatGPT for temporary Codex access.</p>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="@codexHref">@(Model.Chrome.Authenticated ? "Authorize Codex access" : "Sign in to authorize Codex")</a>
        <a class="button-like button-like--secondary" href="/contact">Report a problem</a>
    </div>
    <p class="muted-copy">Authorization is optional, revocable, and does not count as contribution credit by itself.</p>
</section>

<section class="editorial-block editorial-block--lanes">
    <div class="lane-strip-list">
        <article class="lane-strip">
            <div class="lane-strip__copy">
                <span class="tag">Public</span>
                <h2>Public feedback</h2>
                <p>Report a problem, missing feature, or broken installer without creating an account first.</p>
                <div class="compact-rail">
                    @foreach (var card in Model.PublicLane)
                    {
                        var sectionId = card.Action.Href.Contains('#', StringComparison.Ordinal)
                            ? card.Action.Href[(card.Action.Href.LastIndexOf('#') + 1)..]
                            : card.Card.Id.Replace('_', '-');
                        <article class="compact-rail__item" id="@sectionId">
                            <div class="compact-rail__copy">
                                <h3>@card.Card.Title</h3>
                                <p>@card.Card.Summary</p>
                            </div>
                            <a class="editorial-strip__action" href="@card.Action.Href">@card.Action.Label</a>
                        </article>
                    }
                </div>
            </div>
        </article>

        <article class="lane-strip">
            <div class="lane-strip__copy">
                <span class="tag tag--amber">Account required</span>
                <h2>Guided Codex participation</h2>
                <p>Use the signed-in path when you want tracked beta follow-up or want to grant temporary Codex access with your OpenAI account in ChatGPT.</p>
                <div class="compact-rail">
                    @foreach (var card in Model.SignedInLane)
                    {
                        var sectionId = card.Action.Href.Contains('#', StringComparison.Ordinal)
                            ? card.Action.Href[(card.Action.Href.LastIndexOf('#') + 1)..]
                            : card.Card.Id.Replace('_', '-');
                        <article class="compact-rail__item" id="@sectionId">
                            <div class="compact-rail__copy">
                                <h3>@card.Card.Title</h3>
                                <p>@card.Card.Summary</p>
                            </div>
                            <a class="editorial-strip__action" href="@card.Action.Href">@card.Action.Label</a>
                        </article>
                    }
                </div>
            </div>
        </article>
    </div>
</section>

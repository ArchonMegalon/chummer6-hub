@model ParticipatePageViewModel
@{
    ViewData["Title"] = "Participate";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-participate";
}

<section class="release-footnote">
    <p class="eyebrow">Participate</p>
    <h1 class="page-title">Choose how to participate</h1>
    <p class="page-copy">Public bug reports stay open. Suggestions, beta follow-up, and guided contribution use the account path when you want the next step attached to you.</p>
</section>

<section class="editorial-block editorial-block--lanes">
    <div class="lane-strip-list">
        <article class="lane-strip">
            <div class="lane-strip__copy">
                <span class="tag">Public</span>
                <h2>Public feedback</h2>
                <p>Report a problem without an account, then stop there unless you want tracked follow-up.</p>
                <div class="compact-rail">
                    @foreach (var card in Model.PublicLane)
                    {
                        var sectionId = card.Action.Href.Contains('#', StringComparison.Ordinal)
                            ? card.Action.Href[(card.Action.Href.LastIndexOf('#') + 1)..]
                            : card.Card.Id.Replace('_', '-');
                        <article class="compact-rail__item" id="@sectionId">
                            <div class="compact-rail__copy">
                                <h3>@card.Card.Title</h3>
                                <p>@card.Card.Summary</p>
                            </div>
                            <a class="editorial-strip__action" href="@card.Action.Href">@card.Action.Label</a>
                        </article>
                    }
                </div>
            </div>
        </article>

        <article class="lane-strip">
            <div class="lane-strip__copy">
                <span class="tag tag--amber">Signed in</span>
                <h2>Signed-in participation</h2>
                <p>Use the signed-in path when you want a tracked suggestion, beta follow-up, or a bounded contribution flow.</p>
                <div class="compact-rail">
                    @foreach (var card in Model.SignedInLane)
                    {
                        var sectionId = card.Action.Href.Contains('#', StringComparison.Ordinal)
                            ? card.Action.Href[(card.Action.Href.LastIndexOf('#') + 1)..]
                            : card.Card.Id.Replace('_', '-');
                        <article class="compact-rail__item" id="@sectionId">
                            <div class="compact-rail__copy">
                                <h3>@card.Card.Title</h3>
                                <p>@card.Card.Summary</p>
                            </div>
                            <a class="editorial-strip__action" href="@card.Action.Href">@card.Action.Label</a>
                        </article>
                    }
                </div>
            </div>
        </article>
    </div>
</section>

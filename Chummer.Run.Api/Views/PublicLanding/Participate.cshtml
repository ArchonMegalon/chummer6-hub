@model ParticipatePageViewModel
@{
    ViewData["Title"] = "Participate";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-minimal surface-participate";
}
<section class="participate-shell">
    <div class="participate-shell__header">
        <div class="participate-shell__lead">
            <h1>Participate</h1>
            <p>Use the public board for ideas and safe bugs. Use private help for installs, account issues, logs, or anything sensitive.</p>
        </div>
        <div class="participate-actions">
            <a class="button-like button-like--ghost" href="@Model.RoadmapHref">Roadmap</a>
            <a class="button-like button-like--ghost" href="@Model.ChangelogHref">Recent changes</a>
            <a class="button-like button-like--primary" href="/contact#support-intake">Private help</a>
        </div>
    </div>

    <div class="participate-board">
        <div class="participate-hosted">
            <div class="participate-hosted__header">
                <div class="participate-hosted__lead">
                    <h2>Public board</h2>
                    <p>Votes and public discussion stay here on a first-party route.</p>
                </div>
                <span class="participate-count">Public board</span>
            </div>
            <iframe
                class="participate-hosted__frame"
                src="@(string.IsNullOrWhiteSpace(Model.HostedBoardHref) ? "/partizipate/board" : Model.HostedBoardHref)"
                title="Participate board"
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>

        <aside class="participate-items" aria-label="Participate guidance">
            <h3>Use the right lane</h3>
            @foreach (var lane in Model.Lanes)
            {
                <article class="participate-lane">
                    <span>@lane.Label</span>
                    <h3>@lane.Title</h3>
                    <p>@lane.Summary</p>
                    <a class="inline-link" href="@lane.Href">@lane.ActionLabel</a>
                </article>
            }

            <details class="participate-fallback">
                <summary>Board offline?</summary>
                <p>If the board does not load, use <a class="inline-link" href="/contact#support-intake">private help</a> for anything blocked or sensitive, or check the <a class="inline-link" href="@Model.RoadmapHref">roadmap</a> for current movement.</p>
            </details>
        </aside>
    </div>
</section>

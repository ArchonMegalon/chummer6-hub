@model ParticipatePageViewModel
@{
    ViewData["Title"] = "Participate";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-participate";
    var codexHref = Model.Chrome.Authenticated
        ? "/participate/codex"
        : "/auth/google/start?next=%2Fparticipate%2Fcodex";
    var signalLoop = Model.SignalLoop;
    var milestoneFollowUp = signalLoop.MilestoneFollowUp.Take(3).ToArray();
    var roadmapFollowUp = signalLoop.RoadmapFollowUp.Take(3).ToArray();
    var shippedFollowUp = signalLoop.ShippedFollowUp.Take(3).ToArray();
    var beHuman = Model.BeHumanEventAdapter;
    var buildGhost = Model.BuildGhostConcierge;
    var sourceAlias = Context?.Request?.Query["source"].ToString() ?? string.Empty;
    var fromFeedbackAlias = string.Equals(sourceAlias, "feedback", StringComparison.OrdinalIgnoreCase);
    var betaHref = Model.Chrome.Authenticated
        ? "/account/participation"
        : "/signup?next=%2Faccount%2Fparticipation";
    string PublicText(string? value) => PublicFacingCopyHumanizer.Clean(value);
    var fixerRoutes = new[]
    {
        new
        {
            Id = "public-feedback-lane",
            Eyebrow = "Field Reports",
            Title = "Public ideas and safe bug reports",
            Summary = "Use the public signal page for feature requests, safe public bugs, and help-copy gaps. Keep crashes, install failures, account issues, and private campaign details on Chummer help pages instead.",
            Href = "/feedback",
            Label = "Open public feedback",
            Details = new[] { "Public by default", "No private logs", "Sorted by topic" }
        },
        new
        {
            Id = "public-roadmap-lane",
            Eyebrow = "Roadmap",
            Title = "Direction stays visible without pretending a vote is the same as a promise",
            Summary = "Roadmap cards show where the product may move next. Votes help show demand, but they do not decide priority by themselves.",
            Href = "/roadmap",
            Label = "Open roadmap",
            Details = new[] { "Direction only", "Help stays separate", "Votes are not promises" }
        },
        new
        {
            Id = "public-changelog-lane",
            Eyebrow = "Shipped updates",
            Title = "Shipped means user-available, not only merged",
            Summary = "Public updates should only move after a real release, guide, or live page exists. The changelog should stay attached to what works today.",
            Href = "/changelog",
            Label = "Open shipped updates",
            Details = new[] { "Reviewed update", "Available to users", "Release-linked" }
        }
    };
    var signalStages = new[]
    {
        new
        {
            Badge = "Signal intake",
            Title = "Post one safe public signal",
            Summary = "Users can suggest work, vote on shared pain, or flag confusing copy without opening a private case first.",
            Detail = "The public post stays short, safe, and sorted by topic.",
            Href = "/feedback",
            Label = "Start with public feedback"
        },
        new
        {
            Badge = "Chummer review",
            Title = "Review and decide before promising anything",
            Summary = "Chummer triage decides whether the signal becomes follow-up, research, milestone work, or a public decline with reason.",
            Detail = "Votes show demand; they do not decide the roadmap by themselves.",
            Href = "/roadmap",
            Label = "See public direction"
        },
        new
        {
            Badge = "Availability",
            Title = "Show real user availability",
            Summary = "A planned or shipped public update needs a reachable release, guide, or live page, not only enthusiasm or merged code.",
            Detail = "A release, guide, or live page must exist.",
            Href = "/now",
            Label = "Open what works today"
        },
        new
        {
            Badge = "Public closeout",
            Title = "Notify and document after the update exists",
            Summary = "Only then should the public changelog, voter notices, and help copy close the loop back to the original request.",
            Detail = "Help and status stay available even if a mirror is down.",
            Href = "/help",
            Label = "Open help hub"
        }
    };
    var routeChoices = new[]
    {
        new
        {
            Badge = "Safe public signal",
            Title = "Suggestion, UX pain, or safe public bug",
            Summary = "Start on public feedback when the issue can stay public and does not need logs, secrets, or account recovery.",
            Href = "/feedback",
            Label = "Open feedback",
            Details = new[] { "Public by default", "Sorted by topic", "Shared demand" }
        },
        new
        {
            Badge = "Follow movement",
            Title = "Want to know whether an idea is moving",
            Summary = "Use the roadmap when you need public direction and readiness, not a promise that votes alone decide priority.",
            Href = "/roadmap",
            Label = "Open roadmap",
            Details = new[] { "Direction only", "Milestone-backed", "Votes are not promises" }
        },
        new
        {
            Badge = "Need shipped status",
            Title = "Need to know whether something is real today",
            Summary = "Use shipped updates when you need release status, guides, or user-available results instead of merged-code optimism.",
            Href = "/changelog",
            Label = "Open shipped updates",
            Details = new[] { "Release-linked", "Guide-backed", "Available now" }
        },
        new
        {
            Badge = "Private help",
            Title = "Crash, install, account, or campaign-sensitive issue",
            Summary = "Leave the public page when the issue needs logs, recovery, support status, or private table details that should never sit on the public board.",
            Href = "/contact#support-intake",
            Label = "Open support intake",
            Details = new[] { "Private case", "Follow-up stays here", "Support handles it" }
        }
    };
}

<section class="release-footnote">
    <p class="eyebrow">Participate</p>
    <h1 class="page-title">Share feedback, report a problem, or join the beta waitlist</h1>
    <p class="page-copy">Start with public feedback for ideas and safe public bugs. Use Contact when the issue needs private follow-up. Join the beta waitlist when you want updates and account-backed return.</p>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="/feedback">Open feedback</a>
        <a class="button-like button-like--secondary" href="/contact#support-intake">Report a problem</a>
        <a class="button-like button-like--ghost" href="@betaHref">Join beta waitlist</a>
    </div>
    <p class="muted-copy">Follow an item to hear when it changes. Votes show demand; Chummer decides what ships. Guided contribution and other signed-in programs stay below the fold so the public next step stays obvious.</p>
</section>

<section class="status-decision-strip" aria-label="Participation overview">
    <article class="status-decision-strip__card">
        <span class="tag">Roadmap</span>
        <h2>@signalLoop.OpenMilestoneCount roadmap item@(signalLoop.OpenMilestoneCount == 1 ? string.Empty : "s") are open.</h2>
        <p>@signalLoop.ClaimedMilestoneCount already show visible movement. Public participation is clearer when it points at real work instead of generic enthusiasm.</p>
        <a class="button-like button-like--ghost" href="/roadmap#roadmap-milestones">Open milestones</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag">Named direction</span>
        <h2>@signalLoop.RoadmapFollowUpCount planned item@(signalLoop.RoadmapFollowUpCount == 1 ? string.Empty : "s") already absorb public demand without pretending to be shipped.</h2>
        <p>These are the outward-facing tracks that can explain why the product is moving before the work crosses onto the live public release.</p>
        <a class="button-like button-like--ghost" href="/roadmap#roadmap-horizons">Browse campaign tools</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag">Available now</span>
        <h2>@signalLoop.ShippedFollowUpCount available update@(signalLoop.ShippedFollowUpCount == 1 ? string.Empty : "s") show what people can use.</h2>
        <p>The public board is not just intake. It already has a separate shipped updates page where finished outcomes can land.</p>
        <a class="button-like button-like--ghost" href="/changelog">Open shipped updates</a>
    </article>
</section>

<section class="trust-claims route-anchor-target" id="public-feedback">
    <div class="trust-claims__lead">
        <p class="eyebrow">Public pages</p>
        <h2 class="editorial-title">Feedback, roadmap, and shipped updates stay visible without pretending to be the same thing.</h2>
        <p class="editorial-copy">This page keeps the broader participation story visible while the dedicated pages stay honest about what they can promise today and how they connect back to help, shipped updates, and what works now.</p>
        @if (fromFeedbackAlias)
        {
            <div class="route-callout" role="status" aria-live="polite">
                <h3>You followed an older feedback link</h3>
                <p>The public feedback page now lives at <code class="mono-receipt">/feedback</code>. This page keeps broader participation and signed-in options visible without turning them into the default path.</p>
                <div class="route-callout__details">
                    <span>Public by default</span>
                    <span>No private logs</span>
                    <span>Support stays in Chummer</span>
                </div>
                <div class="route-callout__actions">
                    <a class="inline-link" href="/feedback">Open feedback</a>
                    <a class="inline-link" href="/contact#support-intake">Need private help instead?</a>
                    <a class="inline-link" href="/status">Open status</a>
                </div>
            </div>
        }
    </div>
    <div class="trust-claims__grid">
        @foreach (var route in fixerRoutes)
        {
            <article class="trust-claim" id="@route.Id">
                <span class="tag">@PublicText(route.Eyebrow)</span>
                <h3>@PublicText(route.Title)</h3>
                <p>@PublicText(route.Summary)</p>
                <div class="trust-claim__details">
                    @foreach (var item in route.Details)
                    {
                        <span>@PublicText(item)</span>
                    }
                </div>
                <a class="inline-link" href="@route.Href">@PublicText(route.Label)</a>
            </article>
        }
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Pick the right page</p>
        <h2 class="editorial-title">Use the public page only when the work can stay public.</h2>
        <p class="editorial-copy">This cut reduces misrouted public-board posts and keeps support, shipped status, and roadmap interpretation on the calmer Chummer pages that can actually carry them.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var choice in routeChoices)
        {
            <article class="route-choice-card">
                <span class="tag">@PublicText(choice.Badge)</span>
                <h3>@PublicText(choice.Title)</h3>
                <p>@PublicText(choice.Summary)</p>
                <div class="route-choice-card__details">
                    @foreach (var item in choice.Details)
                    {
                        <span>@PublicText(item)</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@choice.Href">@PublicText(choice.Label)</a>
            </article>
        }
    </div>
</section>

@if (buildGhost is not null)
{
    <section class="editorial-block" id="build-ghost-concierge">
        <div class="editorial-block__lead">
            <p class="eyebrow">Character help preview</p>
            <h2 class="editorial-title">Use the public helper for orientation, then finish the build inside Chummer.</h2>
            <p class="editorial-copy">@PublicText(buildGhost.Summary)</p>
        </div>
        <div class="route-choice-grid">
            <article class="route-choice-card">
                <span class="tag">@PublicText(buildGhost.StatusLabel)</span>
                <h3>Public helper can open the path</h3>
                <p>The compare and apply decision still stays inside Chummer.</p>
                <div class="route-choice-card__details">
                    @foreach (var item in buildGhost.ProofPoints)
                    {
                        <span>@PublicText(item)</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@buildGhost.Href">Open character helper</a>
            </article>
        </div>
    </section>
}

<section class="workflow-band">
    <div class="workflow-band__lead">
        <p class="eyebrow">Public loop</p>
        <h2 class="editorial-title">Keep the public loop visible, but keep authority inside Chummer.</h2>
        <p class="editorial-copy">The public path should feel simple: one place to post signal, one place to follow movement, and one honest shipped update path when the feature is actually available.</p>
    </div>
    <div class="workflow-grid">
        @foreach (var stage in signalStages)
        {
            <article class="workflow-card">
                <div class="workflow-card__copy">
                    <span class="tag">@PublicText(stage.Badge)</span>
                    <h3>@PublicText(stage.Title)</h3>
                    <p>@PublicText(stage.Summary)</p>
                    <p class="workflow-card__note">@PublicText(stage.Detail)</p>
                    <a class="inline-link" href="@stage.Href">@PublicText(stage.Label)</a>
                </div>
            </article>
        }
    </div>
</section>

@if (beHuman is not null)
{
    <section class="editorial-block" id="behuman-event-posture">
        <div class="editorial-block__lead">
            <p class="eyebrow">Community event venue boundary</p>
        <h2 class="editorial-title">BeHuman can help host public community events, but it does not decide the product.</h2>
            <p class="editorial-copy">@PublicText(beHuman.Summary)</p>
        </div>
        <div class="route-choice-grid">
            <article class="route-choice-card">
                <span class="tag">@PublicText(beHuman.StatusLabel)</span>
                <h3>@PublicText(beHuman.Verdict)</h3>
                <p>Current setup: <code class="mono-receipt">@PublicText(beHuman.OperatingMode)</code></p>
                <p>
                    @if (beHuman.CapacityClaimAllowed && beHuman.VerifiedRegistrationCapacity is > 0)
                    {
                        <span>Confirmed registration capacity: @beHuman.VerifiedRegistrationCapacity</span>
                    }
                    else
                    {
                        <span>Capacity stays unclaimed until Chummer confirms it.</span>
                    }
                </p>
            </article>
            <article class="route-choice-card">
                <span class="tag">Allowed event types</span>
                <h3>Community-only use</h3>
                <div class="route-choice-card__details">
                    @foreach (var eventFamily in beHuman.AllowedEventFamilies)
                    {
                        <span>@PublicText(eventFamily)</span>
                    }
                </div>
            </article>
            <article class="route-choice-card">
                <span class="tag">Chummer decides</span>
                <h3>Chummer keeps the authority</h3>
                <div class="route-choice-card__details">
                    @foreach (var truthDomain in beHuman.ForbiddenTruthDomains)
                    {
                        <span>@PublicText(truthDomain)</span>
                    }
                </div>
            </article>
        </div>
    </section>
}

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Loop in motion</p>
        <h2 class="editorial-title">Participation works best when it points at live milestones, planned work, and shipped updates.</h2>
        <p class="editorial-copy">This keeps feedback close to the pages people already use.</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">Active pressure</span>
            <h3>Milestones already under load</h3>
            <p>These are the current delivery slices the public loop is most likely to touch next.</p>
            @if (milestoneFollowUp.Length > 0)
            {
                <div class="compact-rail">
                    @foreach (var milestone in milestoneFollowUp)
                    {
                        <article class="compact-rail__item">
                            <div class="compact-rail__copy">
                                <h3>@($"Milestone {milestone.Id}") · @PublicText(milestone.Title)</h3>
                                <p>@PublicText(milestone.CasualSummary)</p>
                            </div>
                            <span class="tag">@PublicText(milestone.StatusLabel)</span>
                        </article>
                    }
                </div>
            }
            <a class="editorial-strip__action" href="/roadmap#roadmap-milestones">Open milestone ledger</a>
        </article>
        <article class="route-choice-card">
            <span class="tag">Named direction</span>
            <h3>Planned work already carrying public movement</h3>
            <p>These are the named outward-facing tracks that can absorb public demand without pretending the work is already shipped.</p>
            @if (roadmapFollowUp.Length > 0)
            {
                <div class="compact-rail">
                    @foreach (var card in roadmapFollowUp)
                    {
                        <article class="compact-rail__item">
                            <div class="compact-rail__copy">
                                <h3>@PublicText(card.Card.Title)</h3>
                                <p>@PublicText(card.Card.Summary)</p>
                            </div>
                            <a class="editorial-strip__action" href="@card.Action.Href">@PublicText(card.Action.Label)</a>
                        </article>
                    }
                </div>
            }
            <a class="editorial-strip__action" href="/roadmap#roadmap-horizons">Browse campaign tools</a>
        </article>
        <article class="route-choice-card">
            <span class="tag">Shipped updates</span>
            <h3>Examples that show the loop can actually finish</h3>
            <p>These shipped examples keep participation honest by showing what reviewed outcomes already look like on the public surface.</p>
            @if (shippedFollowUp.Length > 0)
            {
                <div class="compact-rail">
                    @foreach (var card in shippedFollowUp)
                    {
                        <article class="compact-rail__item">
                            <div class="compact-rail__copy">
                                <h3>@PublicText(card.Card.Title)</h3>
                                <p>@PublicText(card.Card.Summary)</p>
                            </div>
                            <a class="editorial-strip__action" href="@card.Action.Href">@PublicText(card.Action.Label)</a>
                        </article>
                    }
                </div>
            }
            <a class="editorial-strip__action" href="/changelog">Open shipped updates</a>
        </article>
    </div>
</section>

<section class="editorial-block editorial-block--lanes">
    <div class="lane-strip-list">
        <article class="lane-strip">
            <div class="lane-strip__copy">
                <span class="tag">Public signal page</span>
                <h2>Public feedback</h2>
                <p>Use this page when you want to suggest future work, vote on safe public issues, or point at confusing public copy without creating an account first.</p>
                <p>For crashes, install failures, account issues, private logs, or private campaign details, leave this page and use Chummer Help or support instead.</p>
                <div class="compact-rail">
                    @foreach (var card in Model.PublicLane)
                    {
                        var sectionId = card.Action.Href.Contains('#', StringComparison.Ordinal)
                            ? card.Action.Href[(card.Action.Href.LastIndexOf('#') + 1)..]
                            : card.Card.Id.Replace('_', '-');
                        <article class="compact-rail__item" id="@sectionId">
                            <div class="compact-rail__copy">
                                <h3>@PublicText(card.Card.Title)</h3>
                                <p>@PublicText(card.Card.Summary)</p>
                            </div>
                            <a class="editorial-strip__action" href="@card.Action.Href">@PublicText(card.Action.Label)</a>
                        </article>
                    }
                </div>
            </div>
        </article>

        <article class="lane-strip">
            <div class="lane-strip__copy">
                <span class="tag tag--amber">Account required</span>
                <h2>Signed-in participation</h2>
                <p>Use the signed-in path when public signal is not enough and you want tracked beta follow-up, account-linked return, or guided contribution tools tied to your account.</p>
                <div class="compact-rail">
                    @foreach (var card in Model.SignedInLane)
                    {
                        var sectionId = card.Action.Href.Contains('#', StringComparison.Ordinal)
                            ? card.Action.Href[(card.Action.Href.LastIndexOf('#') + 1)..]
                            : card.Card.Id.Replace('_', '-');
                        <article class="compact-rail__item" id="@sectionId">
                            <div class="compact-rail__copy">
                                <h3>@PublicText(card.Card.Title)</h3>
                                <p>@PublicText(card.Card.Summary)</p>
                            </div>
                            <a class="editorial-strip__action" href="@card.Action.Href">@PublicText(card.Action.Label)</a>
                        </article>
                    }
                </div>
            </div>
        </article>
    </div>
</section>

<section class="release-footnote">
    <p class="eyebrow">Current page</p>
    <h2 class="editorial-title">Broader participation stays separate from the dedicated public-signal loop.</h2>
    <p class="editorial-copy">The current Chummer loop is explicit now: public feedback lives on <code class="mono-receipt">/feedback</code>, planned movement lives on <code class="mono-receipt">/roadmap</code>, and shipped updates live on <code class="mono-receipt">/changelog</code>. This page stays focused on broader participation and optional signed-in paths while hosted mirroring remains downstream of Chummer review.</p>
    <p class="muted-copy">
        Need public signal? <a class="inline-link" href="/feedback">Open feedback</a>.
        Need current release status? <a class="inline-link" href="/changelog">Open shipped updates</a>.
        Need public direction? <a class="inline-link" href="/roadmap">Open roadmap</a>.
    </p>
</section>

@model BlackLedgerLeaderBriefingPageViewModel
@{
    ViewData["Title"] = UndetectableHumanizerCopyAdapter.Humanize(Model.Heading);
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-ledger";
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">Faction leader briefing</p>
        <h1 class="page-title">@UndetectableHumanizerCopyAdapter.Humanize(Model.Heading)</h1>
        <p class="page-copy">@UndetectableHumanizerCopyAdapter.Humanize(Model.Intro)</p>
        <div class="trust-claim__details">
            <span>Leader: @Model.Digest.LeaderHandle</span>
            <span>Faction: @UndetectableHumanizerCopyAdapter.Humanize(Model.Digest.PublicName)</span>
            @if (Model.WorldTurnBriefing is not null)
            {
                <span>@UndetectableHumanizerCopyAdapter.Humanize(Model.WorldTurnBriefing.TransitionLabel)</span>
            }
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="@Model.Digest.ValidationHref">Open leader readout</a>
        <a class="button-like button-like--secondary" href="/account/ledger/worldtick/validation">Open turn recap</a>
        <a class="button-like button-like--secondary" href="/account/ledger">Back to faction home</a>
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Pressure calls</p>
        <h2 class="editorial-title">@UndetectableHumanizerCopyAdapter.Humanize(Model.Digest.PublicName) right now</h2>
        <p class="editorial-copy">@UndetectableHumanizerCopyAdapter.Humanize(Model.Digest.Summary)</p>
    </div>
    <div class="route-choice-grid route-choice-grid--three">
        @foreach (var item in Model.Digest.PressureCalls)
        {
            <article class="route-choice-card">
                <span class="tag">Pressure</span>
                <p>@UndetectableHumanizerCopyAdapter.Humanize(item)</p>
            </article>
        }
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Recommended actions</p>
        <h2 class="editorial-title">What the leader should do next</h2>
    </div>
    <div class="route-choice-grid route-choice-grid--three">
        @foreach (var item in Model.Digest.RecommendedActions)
        {
            <article class="route-choice-card">
                <span class="tag">Next move</span>
                <p>@UndetectableHumanizerCopyAdapter.Humanize(item)</p>
            </article>
        }
    </div>
</section>

@if (Model.GmCockpitPacket is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">GM cockpit</p>
            <h2 class="editorial-title">@UndetectableHumanizerCopyAdapter.Humanize(Model.GmCockpitPacket.Heading)</h2>
            <p class="editorial-copy">@UndetectableHumanizerCopyAdapter.Humanize(Model.GmCockpitPacket.Summary)</p>
        </div>
        <div class="route-choice-grid route-choice-grid--three">
            <article class="route-choice-card">
                <span class="tag">Command state</span>
                <p>@UndetectableHumanizerCopyAdapter.Humanize(Model.GmCockpitPacket.CommandPosture)</p>
            </article>
            <article class="route-choice-card">
                <span class="tag">Living Newsroom</span>
                <p>@UndetectableHumanizerCopyAdapter.Humanize(Model.GmCockpitPacket.LivingNewsroomSummary)</p>
                <div class="route-choice-card__details">
                    <a href="@Model.GmCockpitPacket.LivingNewsroomHref">Watch</a>
                    <a href="/living-world">Open Living World</a>
                </div>
            </article>
            <article class="route-choice-card">
                <span class="tag">Aftermath</span>
                <p>@UndetectableHumanizerCopyAdapter.Humanize(Model.GmCockpitPacket.AftermathSummary)</p>
                <div class="route-choice-card__details">
                    <a href="@Model.GmCockpitPacket.AftermathHref">Open aftermath</a>
                </div>
            </article>
            <article class="route-choice-card">
                <span class="tag">Boundary</span>
                <p>@UndetectableHumanizerCopyAdapter.Humanize(Model.GmCockpitPacket.BoundaryLine)</p>
            </article>
        </div>
        <div class="route-choice-grid route-choice-grid--three">
            @foreach (var cue in Model.GmCockpitPacket.Cues)
            {
                <article class="route-choice-card">
                    <span class="tag">@UndetectableHumanizerCopyAdapter.Humanize(cue.Label)</span>
                    <h3>@UndetectableHumanizerCopyAdapter.Humanize(cue.StatusLabel)</h3>
                    <p>@UndetectableHumanizerCopyAdapter.Humanize(cue.Summary)</p>
                    <div class="route-choice-card__details">
                        <a href="@cue.Href">Open</a>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (Model.ValidationPacket is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Details</p>
            <h2 class="editorial-title">Current turn summary</h2>
            <p class="editorial-copy">@UndetectableHumanizerCopyAdapter.Humanize(Model.ValidationPacket.Summary)</p>
        </div>
        <div class="route-choice-grid route-choice-grid--three">
            @foreach (var item in Model.ValidationPacket.Checks.Take(3))
            {
                <article class="route-choice-card">
                    <span class="tag">Detail</span>
                    <p>@UndetectableHumanizerCopyAdapter.Humanize(item)</p>
                </article>
            }
        </div>
    </section>
}

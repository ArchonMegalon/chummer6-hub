@model HorizonsPageViewModel
@{
    ViewData["Title"] = "Maintenance";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-horizons surface-minimal";
}

<section class="minimal-page-hero">
    <div>
        <p class="minimal-kicker">Maintenance</p>
        <h1>Not the front door</h1>
        <p>Future work stays behind the main app. Start with Downloads, Help, or Status.</p>
    </div>
    <div class="minimal-status-pill" aria-label="Page status">
        <span>Public path</span>
        <strong>Downloads first</strong>
        <span>Campaign experiments stay quiet</span>
    </div>
</section>

<section class="minimal-section minimal-section--tight">
    <div class="minimal-section__lead">
        <h2>Use the app first</h2>
        <p>The current job is simple: install Chummer, build a character, and report friction when the workflow gets in your way.</p>
    </div>
    <div class="minimal-download-strip">
        <a class="minimal-download-strip__item" href="/downloads">
            <span>Install</span>
            <strong>Open Downloads</strong>
        </a>
        <a class="minimal-download-strip__item" href="/help">
            <span>Support</span>
            <strong>Open Help</strong>
        </a>
        <a class="minimal-download-strip__item" href="/status">
            <span>Release</span>
            <strong>Open Status</strong>
        </a>
    </div>
</section>

<section class="minimal-section minimal-section--tight">
    <div class="minimal-section__lead">
        <h2>What belongs here</h2>
    </div>
    <div class="minimal-three">
        <article>
            <h3>Roadmap</h3>
            <p>Direction that is useful to track, but not part of the install decision.</p>
        </article>
        <article>
            <h3>Feedback</h3>
            <p>Places where players and GMs can tell us what slows the table down.</p>
        </article>
        <article>
            <h3>Later work</h3>
            <p>Ideas that should improve the main app quietly before they become public surfaces.</p>
        </article>
    </div>
    <div class="minimal-actions">
        <a class="button-like button-like--primary" href="/roadmap">Roadmap</a>
        <a class="button-like button-like--secondary" href="/feedback">Feedback</a>
    </div>
</section>

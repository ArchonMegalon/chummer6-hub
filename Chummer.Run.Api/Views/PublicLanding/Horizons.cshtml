@model HorizonsPageViewModel
@{
    ViewData["Title"] = "Coming Next";
    ViewData["Chrome"] = Model.Chrome;
}

<section class="section-band">
    <div class="page-lead">
        <p class="eyebrow">Horizons</p>
        <h1 class="page-title">Coming next</h1>
        <p class="page-copy">Each horizon gets a pain statement, a payoff statement, and a deliberate route deeper. No card dump.</p>
    </div>
    <div class="horizon-stack">
        @foreach (var card in Model.Horizons)
        {
            var asset = Model.Assets.ForCard(card);
            <article class="horizon-panel" id="@card.Id.ToLowerInvariant().Replace('_', '-')">
                <div>
                    <span class="readiness-tag readiness-tag--horizon">@card.Badge</span>
                    <h2>@card.Title</h2>
                    <p>@card.Summary</p>
                    @if (!string.IsNullOrWhiteSpace(card.Pain))
                    {
                        <p><strong>Pain:</strong> @card.Pain</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(card.Payoff))
                    {
                        <p><strong>Payoff:</strong> @card.Payoff</p>
                    }
                    <a class="inline-link" href="@card.Href">Read more</a>
                </div>
                @if (asset is not null)
                {
                    @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", asset)
                }
            </article>
        }
    </div>
</section>

@model HorizonsPageViewModel
@{
    ViewData["Title"] = "Coming Next";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-horizons";
    var sourceAlias = Context?.Request?.Query["source"].ToString() ?? string.Empty;
    var fromRoadmapAlias = string.Equals(sourceAlias, "roadmap", StringComparison.OrdinalIgnoreCase);
    var totalHorizons = Model.Horizons.Count;
    var preparingCount = Model.Horizons.Count(card => string.Equals(card.Card.Badge, "Preparing", StringComparison.OrdinalIgnoreCase));
    var designingCount = Model.Horizons.Count(card => string.Equals(card.Card.Badge, "Designing", StringComparison.OrdinalIgnoreCase));
    var researchCount = Model.Horizons.Count(card => string.Equals(card.Card.Badge, "Research", StringComparison.OrdinalIgnoreCase));
    var routeChoices = new[]
    {
        new
        {
            Badge = "Use today",
            Title = "Start with the app you can download now",
            Summary = "Windows and Linux builds are the main path. Future ideas should never make the install path harder to understand.",
            Href = "/downloads",
            Label = "Open downloads"
        },
        new
        {
            Badge = "Roadmap",
            Title = "See the near-term delivery plan",
            Summary = "Use the roadmap for milestones and current pressure. This page is only the calmer idea shelf.",
            Href = "/roadmap",
            Label = "Open roadmap"
        },
        new
        {
            Badge = "Feedback",
            Title = "Tell us what would make play smoother",
            Summary = "Sharp user feedback is more useful than a long feature list. Send the friction, not a project plan.",
            Href = "/feedback",
            Label = "Send feedback"
        }
    };
    var groups = new[]
    {
        new { Badge = "Preparing", Label = PublicSurfaceStatus.PreparingNext, Heading = "Near next", Intro = "These are close enough to compare against the current release." },
        new { Badge = "Designing", Label = PublicSurfaceStatus.DesigningInPublic, Heading = "Designing", Intro = "These have a product shape, but they still need more work before they belong in the release path." },
        new { Badge = "Research", Label = PublicSurfaceStatus.ResearchTrack, Heading = "Research", Intro = "These are early ideas. They explain direction; they are not promises." }
    };
    var horizonVideos = new Dictionary<string, (string Title, string Href, string Captions)[]>(StringComparer.OrdinalIgnoreCase)
    {
        ["horizon_nexus_pan"] =
        new[]
        {
            ("NEXUS-PAN deep dive", "/media/horizons/nexus-pan-90s-deepdive.mp4", "/media/horizons/nexus-pan-90s-deepdive.vtt"),
            ("NEXUS-PAN reel", "/media/horizons/nexus-pan-epic-90s.mp4", "/media/horizons/nexus-pan-epic-90s.vtt")
        },
        ["horizon_alice"] = new[] { ("Alice deep dive", "/media/horizons/alice-90s-deepdive.mp4", "/media/horizons/alice-90s-deepdive.vtt") },
        ["horizon_karma_forge"] = new[] { ("Karma Forge deep dive", "/media/horizons/karma-forge-90s-deepdive.mp4", "/media/horizons/karma-forge-90s-deepdive.vtt") },
        ["horizon_jackpoint"] = new[] { ("JackPoint deep dive", "/media/horizons/jackpoint-90s-deepdive.mp4", "/media/horizons/jackpoint-90s-deepdive.vtt") },
        ["horizon_runsite"] = new[] { ("Runsite deep dive", "/media/horizons/runsite-90s-deepdive.mp4", "/media/horizons/runsite-90s-deepdive.vtt") },
        ["horizon_runbook_press"] = new[] { ("Runbook Press deep dive", "/media/horizons/runbook-press-90s-deepdive.mp4", "/media/horizons/runbook-press-90s-deepdive.vtt") },
        ["horizon_table_pulse"] = new[] { ("Table Pulse deep dive", "/media/horizons/table-pulse-90s-deepdive.mp4", "/media/horizons/table-pulse-90s-deepdive.vtt") },
        ["horizon_black_ledger"] =
        new[]
        {
            ("Black Ledger deep dive", "/media/horizons/black-ledger-90s-deepdive.mp4", "/media/horizons/black-ledger-90s-deepdive.vtt"),
            ("Black Ledger reel", "/media/horizons/black-ledger-epic-90s.mp4", "/media/horizons/black-ledger-epic-90s.vtt")
        },
        ["horizon_community_hub"] = new[] { ("Community Hub deep dive", "/media/horizons/community-hub-90s-deepdive.mp4", "/media/horizons/community-hub-90s-deepdive.vtt") }
    };
    var rendered = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
}

<section class="trust-page-hero route-anchor-target" id="public-roadmap-projection">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">Coming next</p>
        <h1 class="page-title">A quieter look at what Chummer may become</h1>
        <p class="page-copy">The current job is still simple: download Chummer, build a runner, and keep the table moving. Everything below is future product direction, sorted by how close it feels to the app today.</p>
        @if (fromRoadmapAlias)
        {
            <div class="route-callout" role="status" aria-live="polite">
                <h3>You came from an older roadmap link</h3>
                <p>The current roadmap now lives on <code class="mono-receipt">/roadmap</code>. This page is only the calmer idea shelf.</p>
                <div class="route-callout__actions">
                    <a class="inline-link" href="/roadmap">Open roadmap</a>
                    <a class="inline-link" href="/downloads">Open downloads</a>
                    <a class="inline-link" href="/feedback">Send feedback</a>
                </div>
            </div>
        }
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="/downloads">Download Chummer</a>
        <a class="button-like button-like--secondary" href="/roadmap">Open roadmap</a>
        <a class="button-like button-like--ghost" href="#near-next">Browse ideas</a>
    </div>
</section>

<section class="status-decision-strip" aria-label="Coming-next distance from the current app">
    <article class="status-decision-strip__card">
        <span class="tag">Near next</span>
        <h2>@preparingCount thread@(preparingCount == 1 ? string.Empty : "s") close to the current app.</h2>
        <p>These are the only items that should be compared directly with today’s download.</p>
        <a class="button-like button-like--ghost" href="#near-next">Open near next</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag">Designing</span>
        <h2>@designingCount thread@(designingCount == 1 ? string.Empty : "s") still need stronger product shape.</h2>
        <p>Read these as direction, not as a current feature list.</p>
        <a class="button-like button-like--ghost" href="#designing">Open design threads</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag tag--amber">Research</span>
        <h2>@researchCount thread@(researchCount == 1 ? string.Empty : "s") stay early.</h2>
        <p>These explain what we are thinking about, not what the product already does.</p>
        <a class="button-like button-like--ghost" href="#research">Open research</a>
    </article>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">How to read this page</p>
        <h2 class="editorial-title">Ideas stay behind the product.</h2>
        <p class="editorial-copy">This page is intentionally secondary. It is here for direction, not to sell unfinished systems as today’s experience.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var choice in routeChoices)
        {
            <article class="route-choice-card">
                <span class="tag">@choice.Badge</span>
                <h3>@choice.Title</h3>
                <p>@choice.Summary</p>
                <a class="editorial-strip__action" href="@choice.Href">@choice.Label</a>
            </article>
        }
    </div>
</section>

<section class="section-band" aria-label="Coming next summary">
    <div class="editorial-block__lead">
        <p class="eyebrow">Direction</p>
        <h2 class="editorial-title">@totalHorizons product thread@(totalHorizons == 1 ? string.Empty : "s") under review.</h2>
        <p class="editorial-copy">@preparingCount near-next, @designingCount design, and @researchCount research thread@(researchCount == 1 ? string.Empty : "s"). Black Ledger stays quiet here until it earns a stronger public position.</p>
    </div>
</section>

@foreach (var group in groups)
{
    var items = Model.Horizons.Where(card => string.Equals(card.Card.Badge, group.Badge, StringComparison.OrdinalIgnoreCase)).ToArray();
    if (items.Length == 0)
    {
        continue;
    }

    foreach (var item in items)
    {
        rendered.Add(item.Card.Id);
    }

    var sectionId = group.Badge.ToLowerInvariant() switch
    {
        "preparing" => "near-next",
        "designing" => "designing",
        "research" => "research",
        _ => group.Badge.ToLowerInvariant()
    };

    <section class="section-band" id="@sectionId">
        <div class="editorial-block__lead">
            <p class="eyebrow">@group.Label</p>
            <h2 class="editorial-title">@group.Heading</h2>
            <p class="editorial-copy">@group.Intro</p>
        </div>
        <div class="horizon-longscroll">
            @for (var index = 0; index < items.Length; index++)
            {
                var card = items[index];
                var isBlackLedger = string.Equals(card.Card.Id, "horizon_black_ledger", StringComparison.OrdinalIgnoreCase);
                var reverseClass = index % 2 == 1 ? " horizon-band--reverse" : string.Empty;
                var cardSummary = isBlackLedger
                    ? "A living-city campaign layer is still early. It stays behind the main Chummer app until the experience is ready for normal users."
                    : card.Card.Summary;
                var actionLabel = isBlackLedger ? "Read quiet design note" : card.Action.Label;

                <article class="horizon-band@reverseClass" id="@card.Card.Id.ToLowerInvariant().Replace('_', '-')">
                    @if (card.Asset is not null)
                    {
                        <div class="horizon-band__media">
                            @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", card.Asset)
                        </div>
                    }
                    <div class="horizon-band__copy">
                        <span class="readiness-tag readiness-tag--horizon @PublicSurfaceStatus.CssTone(card.Card.Badge)">@PublicSurfaceStatus.DisplayLabel(card.Card.Badge)</span>
                        <h3>@card.Card.Title</h3>
                        <p>@cardSummary</p>
                        <div class="horizon-band__claims">
                            @if (!string.IsNullOrWhiteSpace(card.Card.Pain))
                            {
                                <div>
                                    <span class="horizon-band__label">Why it matters</span>
                                    <p>@card.Card.Pain</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(card.Card.Payoff))
                            {
                                <div>
                                    <span class="horizon-band__label">What it could unlock</span>
                                    <p>@card.Card.Payoff</p>
                                </div>
                            }
                            @if (horizonVideos.TryGetValue(card.Card.Id, out var cardVideos))
                            {
                                <div>
                                    <span class="horizon-band__label">Optional video</span>
                                    <p>
                                        @foreach (var video in cardVideos)
                                        {
                                            <a class="inline-link" href="@video.Href">@video.Title</a>
                                            <a class="inline-link" href="@video.Captions">Captions</a>
                                        }
                                    </p>
                                </div>
                            }
                        </div>
                        <a class="editorial-strip__action" href="@card.Action.Href">@actionLabel</a>
                    </div>
                </article>
            }
        </div>
    </section>
}

@{
    var remaining = Model.Horizons.Where(card => !rendered.Contains(card.Card.Id)).ToArray();
}

@if (remaining.Length > 0)
{
    <section class="section-band">
        <div class="editorial-block__lead">
            <p class="eyebrow">More</p>
            <h2 class="editorial-title">Other product threads</h2>
            <p class="editorial-copy">These are kept visible for continuity, but they are not part of the main public path.</p>
        </div>
        <div class="horizon-longscroll">
            @for (var index = 0; index < remaining.Length; index++)
            {
                var card = remaining[index];
                var reverseClass = index % 2 == 1 ? " horizon-band--reverse" : string.Empty;

                <article class="horizon-band@reverseClass" id="@card.Card.Id.ToLowerInvariant().Replace('_', '-')">
                    @if (card.Asset is not null)
                    {
                        <div class="horizon-band__media">
                            @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", card.Asset)
                        </div>
                    }
                    <div class="horizon-band__copy">
                        <span class="readiness-tag readiness-tag--horizon @PublicSurfaceStatus.CssTone(card.Card.Badge)">@PublicSurfaceStatus.DisplayLabel(card.Card.Badge)</span>
                        <h3>@card.Card.Title</h3>
                        <p>@card.Card.Summary</p>
                        <a class="editorial-strip__action" href="@card.Action.Href">@card.Action.Label</a>
                    </div>
                </article>
            }
        </div>
    </section>
}

<section class="release-footnote">
    <p class="eyebrow">Next step</p>
    <h2 class="editorial-title">Use the current app first.</h2>
    <p class="editorial-copy">Download Chummer, try the character flow, and send feedback when something feels rough. The future shelf can wait.</p>
    <div class="stacked-actions">
        <a class="cta-link cta-link--primary" href="/downloads">Open downloads</a>
        <a class="cta-link cta-link--secondary" href="/feedback">Send feedback</a>
        <a class="cta-link cta-link--ghost" href="/now">What works today</a>
    </div>
</section>

@* _PublicTrustPulsePanel.cshtml remains part of the Horizons model contract, but the calm public page does not render the operational trust pulse. *@

<section class="release-footnote">
    @await Html.PartialAsync("~/Views/Shared/_PublicStatusGlossary.cshtml")
</section>

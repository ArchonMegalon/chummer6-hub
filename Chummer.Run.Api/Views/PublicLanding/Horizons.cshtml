@model HorizonsPageViewModel
@{
    ViewData["Title"] = "Coming Next";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-horizons";
}

<section class="horizons-intro">
    <p class="eyebrow">Coming next</p>
    <h1 class="page-title">A futures deck, not a card dump</h1>
    <p class="page-copy">Each horizon names the pain, the payoff, and the route deeper so the future reads like a product direction instead of a bucket list.</p>
</section>

<div class="horizon-longscroll">
    @for (var index = 0; index < Model.Horizons.Count; index++)
    {
        var card = Model.Horizons[index];
        var asset = Model.Assets.ForCard(card);
        var reverseClass = index % 2 == 1 ? " horizon-band--reverse" : string.Empty;

        <article class="horizon-band@reverseClass" id="@card.Id.ToLowerInvariant().Replace('_', '-')">
            @if (asset is not null)
            {
                <div class="horizon-band__media">
                    @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", asset)
                </div>
            }
            <div class="horizon-band__copy">
                <span class="readiness-tag readiness-tag--horizon">@card.Badge</span>
                <h2>@card.Title</h2>
                <p>@card.Summary</p>
                <div class="horizon-band__claims">
                    @if (!string.IsNullOrWhiteSpace(card.Pain))
                    {
                        <div>
                            <span class="horizon-band__label">Pain</span>
                            <p>@card.Pain</p>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(card.Payoff))
                    {
                        <div>
                            <span class="horizon-band__label">Payoff</span>
                            <p>@card.Payoff</p>
                        </div>
                    }
                </div>
                <a class="editorial-strip__action" href="@card.Href">Read more</a>
            </div>
        </article>
    }
</div>

@model AnarchyPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-ledger";
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@Model.Intro</p>
        <div class="trust-claim__details">
            <span>@Model.ScopeLabel</span>
            <span>@PublicFacingCopyHumanizer.Clean(Model.VerdictLabel)</span>
            <span>Chummer packet, not book text</span>
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--@Model.PrimaryAction.Tone" href="@Model.PrimaryAction.Href">@Model.PrimaryAction.Label</a>
        <a class="button-like button-like--@Model.SecondaryAction.Tone" href="@Model.SecondaryAction.Href">@Model.SecondaryAction.Label</a>
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Ruleset status</p>
        <h2 class="editorial-title">Not an SR5 skin. Not an SR6 mode.</h2>
        <p class="editorial-copy">This path treats Shadowrun Anarchy as its own rules-light profile: fast runner sheets, dispatch-compatible consequence, mobile return, and clear export without copying sourcebook text into the product.</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">@Model.RulesetId</span>
            <h3>@Model.FeaturedProfile.Handle</h3>
            <p>@Model.FeaturedProfile.Concept</p>
            <p class="muted-copy">@PublicFacingCopyHumanizer.Clean(Model.FeaturedProfile.PostureLabel)</p>
        </article>
        <article class="route-choice-card">
            <span class="tag">@PublicFacingCopyHumanizer.Clean(Model.FeaturedProfile.VerdictLabel)</span>
            <h3>Public claim ceiling</h3>
            <p>Shipped rules-light path for campaign city dispatches and mobile play. Not full book-level rules completeness.</p>
        </article>
    </div>
 </section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Runner sheet</p>
        <h2 class="editorial-title">One-page narrative profile</h2>
        <p class="editorial-copy">The profile keeps capabilities, Shadow Amps, contacts, complications, and faction links explicit enough for a table, a phone, and the Black Ledger.</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">@Model.FeaturedProfile.MetatypeOrIdentityTag</span>
            <h3>@Model.FeaturedProfile.Handle</h3>
            <p>@Model.FeaturedProfile.Notes</p>
            <div class="route-choice-card__details">
                @foreach (var tag in Model.FeaturedProfile.ArchetypeTags)
                {
                    <span>@tag</span>
                }
            </div>
        </article>
        <article class="route-choice-card">
            <span class="tag">Narrative cues</span>
            <h3>Table state</h3>
            <p>@string.Join(" · ", Model.FeaturedProfile.NarrativeCues)</p>
            <p class="muted-copy">Capabilities: @string.Join(", ", Model.FeaturedProfile.Capabilities)</p>
        </article>
        <article class="route-choice-card">
            <span class="tag">Shadow Amps</span>
            <h3>Pressure-linked loadout</h3>
            <p>@string.Join(", ", Model.FeaturedProfile.ShadowAmps)</p>
            <p class="muted-copy">Gear tags: @string.Join(", ", Model.FeaturedProfile.GearTags)</p>
        </article>
        <article class="route-choice-card">
            <span class="tag">Complications</span>
            <h3>Faction and debt hooks</h3>
            <p>@string.Join(", ", Model.FeaturedProfile.Complications)</p>
            <p class="muted-copy">Faction links: @string.Join(", ", Model.FeaturedProfile.FactionLinks)</p>
        </article>
    </div>
</section>

<section class="trust-claims" id="anarchy-ledger-stats">
    <div class="trust-claims__lead">
        <p class="eyebrow">Black Ledger integration</p>
        <h2 class="editorial-title">Anarchy turns consequence into readable pressure.</h2>
        <p class="editorial-copy">The same World Turn state can feed a rules-light profile, a dispatch path, and mobile play without flattening Anarchy into a generic overlay.</p>
    </div>
    <div class="trust-claims__grid">
        @foreach (var stat in Model.LedgerStats)
        {
            <article class="trust-claim">
                <span class="tag">Anarchy stat</span>
                <h3>@stat.Label</h3>
                <p class="trust-claim__value"><strong>@stat.Value</strong></p>
                <p>@stat.Summary</p>
            </article>
        }
    </div>
</section>

@if (Model.Dispatches.Count > 0)
{
    <section class="editorial-block" id="anarchy-dispatches">
        <div class="editorial-block__lead">
            <p class="eyebrow">Dispatch-compatible path</p>
            <h2 class="editorial-title">The same public-safe dispatches can power Anarchy play.</h2>
            <p class="editorial-copy">This route reads Chummer dispatches and applies an Anarchy lens. It does not invent separate unsupported fiction.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var dispatch in Model.Dispatches)
            {
                <article class="route-choice-card">
                    <span class="tag">@dispatch.Type</span>
                    <h3>@dispatch.Title</h3>
                    <p>@dispatch.Summary</p>
                    <a class="editorial-strip__action" href="@dispatch.Href">Open dispatch</a>
                </article>
            }
        </div>
    </section>
}

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Explain and export</p>
        <h2 class="editorial-title">Chummer owns the portable packet.</h2>
        <p class="editorial-copy">The preview export stays Chummer-owned JSON with provenance attached. Adapters may draft around it later, but they do not become publication authority.</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">@Model.ExplainReceipt.Status</span>
            <h3>Portable runner explanation</h3>
            <p>The export keeps enough context for Chummer to explain the sheet without showing sourcebook text.</p>
            <div class="route-choice-card__details">
                @foreach (var note in Model.ExplainReceipt.ProvenanceNotes)
                {
                    <span>@note</span>
                }
            </div>
        </article>
        <article class="route-choice-card">
            <span class="tag">JSON export</span>
            <h3>Portable runner packet</h3>
            <pre class="code-panel__value mono-receipt">@Model.ExportJson</pre>
        </article>
    </div>
</section>

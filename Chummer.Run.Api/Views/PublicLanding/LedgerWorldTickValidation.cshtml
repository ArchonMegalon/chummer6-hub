@model BlackLedgerWorldTickValidationPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-ledger";
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">World turn</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@Model.Intro</p>
        <div class="trust-claim__details">
            <span>World: @Model.Packet.WorldName</span>
            <span>Turn: @Model.Packet.ToTurn</span>
            <span>Status: current</span>
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="/account/ledger/worldtick/validation.json">Download details</a>
        <a class="button-like button-like--secondary" href="/account/ledger/notifications">Open inbox</a>
        <a class="button-like button-like--secondary" href="/account/ledger">Back to faction home</a>
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Turn summary</p>
        <h2 class="editorial-title">What changed this turn</h2>
        <p class="editorial-copy">@PublicFacingCopyHumanizer.Clean(Model.Packet.Summary)</p>
    </div>
    <div class="route-choice-grid route-choice-grid--three">
        @foreach (var item in Model.Packet.Checks)
        {
            <article class="route-choice-card">
                <span class="tag">Detail</span>
                <p>@PublicFacingCopyHumanizer.Clean(item)</p>
            </article>
        }
    </div>
</section>

@if (Model.WorldTurnBriefing is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">@Model.WorldTurnBriefing.TransitionLabel</p>
            <h2 class="editorial-title">@Model.WorldTurnBriefing.InboxHeadline</h2>
            <p class="editorial-copy">@Model.WorldTurnBriefing.NewsreelLead</p>
        </div>
    </section>
}

@if (Model.LeaderDigest is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Leader view</p>
            <h2 class="editorial-title">@Model.LeaderDigest.PublicName leader digest</h2>
        </div>
        <div class="route-choice-grid route-choice-grid--three">
            @foreach (var item in Model.LeaderDigest.PressureCalls.Take(3))
            {
                <article class="route-choice-card">
                    <span class="tag">Match</span>
                    <p>@item</p>
                </article>
            }
        </div>
    </section>
}

@model NowPageViewModel
@{
    ViewData["Title"] = "Changelog";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-now surface-minimal";
    var signalLoop = Model.SignalLoop;
    var signalProjection = Model.SignalProjection;
    var milestoneFollowUp = signalLoop.MilestoneFollowUp.Take(3).ToArray();
    var roadmapFollowUp = signalLoop.RoadmapFollowUp.Take(3).ToArray();
    var shippedDetails = Model.ProofModules.ToArray();
    var shippedNow = Model.AvailableToday.Take(4).ToArray();
    var stillCaution = Model.Inspectable.Take(4).ToArray();
    var guestNeedsInstallGate = !Model.Chrome.Authenticated && !string.IsNullOrWhiteSpace(Model.ReleaseExperience.GuestGatePrimaryHref);
    string ContextualPreviewHref(string? href)
    {
        var resolvedHref = string.IsNullOrWhiteSpace(href) ? "/downloads" : href;
        if (guestNeedsInstallGate && string.Equals(resolvedHref, "/downloads", StringComparison.OrdinalIgnoreCase))
        {
            return Model.ReleaseExperience.GuestGatePrimaryHref ?? resolvedHref;
        }

        return resolvedHref;
    }

    static string PublicChangelogText(string? value)
        => UndetectableHumanizerCopyAdapter.Humanize(value)
            .Replace("Evidence", "Notes", StringComparison.OrdinalIgnoreCase)
            .Replace("evidence", "notes", StringComparison.OrdinalIgnoreCase)
            .Replace("maintenance", "planned work", StringComparison.OrdinalIgnoreCase);
}

<section class="minimal-page-hero route-anchor-target" id="public-shipped-closeout">
    <div>
        <p class="eyebrow">Changelog</p>
        <h1>Recent changes</h1>
        <p>Use this page when you want to see what changed and where to go next.</p>
    </div>
    <div class="minimal-status-pill">
        <span>Release notes</span>
        <strong>Current app</strong>
    </div>
</section>

<section class="status-decision-strip" aria-label="Shipped closeout rules">
    <article class="status-decision-strip__card">
        <span class="tag">Live now</span>
        <h2>If it is here, you can use it.</h2>
        <p>This page only covers changes that reached the current app, installer, or public route.</p>
        <a class="button-like button-like--ghost" href="/now">Open current release</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag">Install</span>
        <h2>Downloads stays the install page.</h2>
        <p>Use Downloads for the installer, platform choice, and setup notes.</p>
        <a class="button-like button-like--ghost" href="@ContextualPreviewHref("/downloads")">Open downloads</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag tag--amber">Help</span>
        <h2>Use Chummer help for support or recovery.</h2>
        <p>Leave this page when the next job needs logs, account detail, or repair.</p>
        <a class="button-like button-like--ghost" href="/help">Open Chummer help</a>
    </article>
</section>

<section class="minimal-section">
    <div class="minimal-section__lead">
        <p class="eyebrow">What changed</p>
        <h2>Recent changes in the current release</h2>
        <p>These product improvements are live enough to belong in the changelog.</p>
    </div>
    <div class="minimal-lane-grid">
        @foreach (var card in shippedDetails)
        {
            <article class="minimal-lane-card">
                <span class="tag">@PublicChangelogText(card.Card.Badge)</span>
                <h3>@PublicChangelogText(card.Card.Title)</h3>
                <p>@PublicChangelogText(card.Card.Summary)</p>
                @if (!string.IsNullOrWhiteSpace(card.Card.ProofNote))
                {
                    <p class="workflow-card__note muted-copy">@PublicChangelogText(card.Card.ProofNote)</p>
                }
                <div class="minimal-actions">
                    <a class="button-like button-like--ghost" href="@card.Action.Href">@PublicChangelogText(card.Action.Label)</a>
                </div>
            </article>
        }
    </div>
</section>

<section class="minimal-section minimal-section--tight">
    <div class="minimal-lane-grid">
        <article class="minimal-lane-card">
            <span>Available now</span>
            <h2>Ready to use</h2>
            <p>These items already have a public path and belong in the changelog.</p>
            <div class="minimal-help-grid">
                <article class="minimal-help-card">
                    <h3>Release notes and update status</h3>
                    <p>@PublicChangelogText(Model.ReleaseExperience.ReleaseNotesSummary)</p>
                    <p>@PublicChangelogText(Model.ReleaseExperience.UpdatePostureSummary)</p>
                </article>
                @foreach (var card in shippedNow)
                {
                    <article class="minimal-help-card" id="@card.Card.Id.Replace('_', '-')">
                        <h3>@PublicChangelogText(card.Card.Title)</h3>
                        <p>@PublicChangelogText(card.Card.Summary)</p>
                        <a class="inline-link" href="@card.Action.Href">@PublicChangelogText(card.Action.Label)</a>
                    </article>
                }
            </div>
        </article>
        <article class="minimal-lane-card">
            <span>Next</span>
            <h2>What comes next</h2>
            <p>What changed, and what comes next.</p>
            <p>Use Participate when you want to follow or request what comes next.</p>
            @if (milestoneFollowUp.Length > 0)
            {
                <details class="minimal-help-card__details">
                    <summary>Current work</summary>
                    <ul>
                        @foreach (var milestone in milestoneFollowUp)
                        {
                            <li>@($"Milestone {milestone.Id}") · @PublicChangelogText(milestone.Title)</li>
                        }
                    </ul>
                </details>
            }
            @if (roadmapFollowUp.Length > 0)
            {
                <details class="minimal-help-card__details">
                    <summary>Up next</summary>
                    <ul>
                        @foreach (var card in roadmapFollowUp)
                        {
                            <li>@PublicChangelogText(card.Card.Title)</li>
                        }
                    </ul>
                </details>
            }
            <div class="minimal-actions">
                <a class="button-like button-like--ghost" href="/participate">Open Participate</a>
                <a class="button-like button-like--ghost" href="@signalLoop.FollowSettingsHref">@signalLoop.FollowSettingsLabel</a>
            </div>
        </article>
    </div>
</section>

@if (stillCaution.Length > 0)
{
    <section class="minimal-section minimal-section--tight">
        <details class="minimal-details">
            <summary>Needs care before wider use</summary>
            <dl>
                @foreach (var card in stillCaution)
                {
                    <div id="@card.Card.Id.Replace('_', '-')">
                        <dt>
                            <strong>@PublicChangelogText(card.Card.Title)</strong>
                            <p>@PublicChangelogText(card.Card.Summary)</p>
                        </dt>
                        <dd>
                            <a class="inline-link" href="@card.Action.Href">@PublicChangelogText(card.Action.Label)</a>
                        </dd>
                    </div>
                }
            </dl>
        </details>
    </section>
}

<section class="minimal-section minimal-section--tight">
    <div class="minimal-section__lead">
        <p class="eyebrow">Next</p>
        <h2>Read the changes, then move on.</h2>
        <p>Open Downloads for the app, Participate for planned work, or Chummer help for support.</p>
    </div>
    <div class="minimal-actions">
        <a class="button-like button-like--primary" href="@ContextualPreviewHref("/downloads")">Open downloads</a>
        <a class="button-like button-like--ghost" href="/participate">Open Participate</a>
        <a class="button-like button-like--ghost" href="/help">Open help</a>
    </div>
    <p class="muted-copy">Need the quick status? <a class="inline-link" href="/now">Open current release</a>.</p>
</section>

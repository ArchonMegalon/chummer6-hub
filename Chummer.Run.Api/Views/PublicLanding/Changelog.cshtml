@model NowPageViewModel
@{
    ViewData["Title"] = "Changelog";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-now";
    var signalLoop = Model.SignalLoop;
    var signalProjection = Model.SignalProjection;
    var milestoneFollowUp = signalLoop.MilestoneFollowUp.Take(3).ToArray();
    var roadmapFollowUp = signalLoop.RoadmapFollowUp.Take(3).ToArray();
    var shippedDetails = Model.ProofModules.ToArray();
    var shippedNow = Model.AvailableToday.Take(4).ToArray();
    var stillCaution = Model.Inspectable.Take(4).ToArray();
    var guestNeedsInstallGate = !Model.Chrome.Authenticated && !string.IsNullOrWhiteSpace(Model.ReleaseExperience.GuestGatePrimaryHref);
    var publishedLabel = Model.Manifest.PublishedAt.ToUniversalTime().ToString("yyyy-MM-dd");
    var verifiedLabel = Model.VerifiedAtLabel
        ?? (Model.Manifest.ProofGeneratedAt ?? Model.Manifest.GeneratedAt ?? Model.Manifest.PublishedAt)
            .ToUniversalTime()
            .ToString("yyyy-MM-dd");

    string ContextualPreviewHref(string? href)
    {
        var resolvedHref = string.IsNullOrWhiteSpace(href) ? "/downloads" : href;
        if (guestNeedsInstallGate && string.Equals(resolvedHref, "/downloads", StringComparison.OrdinalIgnoreCase))
        {
            return Model.ReleaseExperience.GuestGatePrimaryHref ?? resolvedHref;
        }

        return resolvedHref;
    }

    static string PublicChangelogText(string? value)
        => PublicFacingCopyHumanizer.Clean(value)
            .Replace("Evidence", "Notes", StringComparison.OrdinalIgnoreCase)
            .Replace("evidence", "notes", StringComparison.OrdinalIgnoreCase)
            .Replace("maintenance", "planned work", StringComparison.OrdinalIgnoreCase);
}

<section class="evidence-header route-anchor-target" id="public-shipped-closeout">
    <div class="page-lead">
        <p class="eyebrow">Changelog</p>
        <h1 class="page-title">Shipped updates</h1>
        <p class="page-copy">Use this page when you want to see what changed and where to go next.</p>
    </div>
    <div class="evidence-header__stats">
        <div>
            <span class="evidence-header__label">Current build</span>
            <strong>@Model.ReleaseExperience.Display.BuildLabel</strong>
        </div>
        <div>
            <span class="evidence-header__label">Channel</span>
            <strong>@Model.ReleaseExperience.Display.ChannelLabel</strong>
        </div>
        <div>
            <span class="evidence-header__label">Released</span>
            <strong>@publishedLabel</strong>
        </div>
        <div>
            <span class="evidence-header__label">Last updated</span>
            <strong>@verifiedLabel</strong>
        </div>
    </div>
</section>

<section class="status-decision-strip" aria-label="Shipped closeout rules">
    <article class="status-decision-strip__card">
        <span class="tag">Visible change</span>
        <h2>Shipped means you can open it.</h2>
        <p>Updates belong here when they are on a live page, in the app, or on the current install path.</p>
        <a class="button-like button-like--ghost" href="/now">Open what works today</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag">Install path</span>
        <h2>Shipped updates still have to land on the current install path.</h2>
        <p>Downloads, update status, and help stay attached so shipped updates never float away from the device path that matters.</p>
        <a class="button-like button-like--ghost" href="@ContextualPreviewHref("/downloads")">Open downloads</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag tag--amber">Private follow-up</span>
        <h2>Support, installs, and account recovery leave this public page.</h2>
        <p>When the issue needs logs, private account detail, or tracked support history, switch to Chummer help instead of treating the changelog like a ticket queue.</p>
        <a class="button-like button-like--ghost" href="/help">Open help</a>
    </article>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Loop return</p>
        <h2 class="editorial-title">The changelog works best when it shows what changed and where to go next.</h2>
        <p class="editorial-copy">This is the public change log: what changed, what still needs work, and where to go next.</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">Pressure still open</span>
            <h3>@signalLoop.OpenMilestoneCount open milestone slice@(signalLoop.OpenMilestoneCount == 1 ? string.Empty : "s") still sit behind the next round of public closeout.</h3>
            <p>Shipped changes should make the remaining pressure clearer, not pretend the planning queue is empty.</p>
            @if (milestoneFollowUp.Length > 0)
            {
                <div class="compact-rail">
                    @foreach (var milestone in milestoneFollowUp)
                    {
                        <article class="compact-rail__item">
                            <div class="compact-rail__copy">
                                <h3>@($"Milestone {milestone.Id}") · @PublicChangelogText(milestone.Title)</h3>
                                <p>@PublicChangelogText(milestone.CasualSummary)</p>
                            </div>
                            <span class="tag">@milestone.StatusLabel</span>
                        </article>
                    }
                </div>
            }
            <a class="editorial-strip__action" href="/roadmap#roadmap-milestones">Open milestone ledger</a>
        </article>
        <article class="route-choice-card">
            <span class="tag">Next movement</span>
            <h3>@signalLoop.RoadmapFollowUpCount planned item@(signalLoop.RoadmapFollowUpCount == 1 ? string.Empty : "s") already frame what the next public movement is likely to be.</h3>
            <p>Use roadmap when you need to compare shipped updates against what is still only direction.</p>
            @if (roadmapFollowUp.Length > 0)
            {
                <div class="compact-rail">
                    @foreach (var card in roadmapFollowUp)
                    {
                        <article class="compact-rail__item">
                            <div class="compact-rail__copy">
                                <h3>@PublicChangelogText(card.Card.Title)</h3>
                                <p>@PublicChangelogText(card.Card.Summary)</p>
                            </div>
                            <a class="editorial-strip__action" href="@card.Action.Href">@PublicChangelogText(card.Action.Label)</a>
                        </article>
                    }
                </div>
            }
            <a class="editorial-strip__action" href="/roadmap#roadmap-horizons">Browse roadmap</a>
        </article>
        <article class="route-choice-card">
            <span class="tag">Saved return</span>
            <h3>Use the account once you want changelog updates, install follow-up, and future returns in one place.</h3>
            <p>That keeps shipped updates, support history, and roadmap follows attached to the same calmer shell instead of scattering them across public reading surfaces.</p>
            <div class="route-choice-card__details">
                <span>Support history</span>
                <span>Roadmap follows</span>
                <span>Account return</span>
            </div>
            <a class="editorial-strip__action" href="@signalLoop.FollowSettingsHref">@signalLoop.FollowSettingsLabel</a>
        </article>
    </div>
</section>

<section class="workflow-band">
    <div class="workflow-band__lead">
        <p class="eyebrow">Shipped updates</p>
        <h2 class="editorial-title">The current public release already closes out a few real product improvements.</h2>
        <p class="editorial-copy">These are the improvements ready enough to belong in the changelog instead of staying on the roadmap.</p>
    </div>
    <div class="workflow-grid">
        @foreach (var card in shippedDetails)
        {
            <article class="workflow-card">
                @if (card.Asset is not null)
                {
                    <div class="workflow-card__media">
                        @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", card.Asset)
                    </div>
                }
                <div class="workflow-card__copy">
                    <span class="tag">@PublicChangelogText(card.Card.Badge)</span>
                    <h3>@PublicChangelogText(card.Card.Title)</h3>
                    <p>@PublicChangelogText(card.Card.Summary)</p>
                    @if (!string.IsNullOrWhiteSpace(card.Card.ProofNote))
                    {
                        <p class="workflow-card__note">@PublicChangelogText(card.Card.ProofNote)</p>
                    }
                    <a class="inline-link" href="@card.Action.Href">@PublicChangelogText(card.Action.Label)</a>
                </div>
            </article>
        }
    </div>
</section>

<section class="release-shelf release-shelf--manual">
    <div class="home-stream">
        <div class="home-stream__column">
            <div class="home-stream__lead">
                <p class="eyebrow">Closed out now</p>
                <h2 class="home-stream__title">User-available outcomes</h2>
                <p class="home-stream__summary">These items already have a live page or user-facing path and belong in the changelog.</p>
            </div>
            <div class="app-rail">
                <article class="app-rail__item">
                    <span class="tag">Current release</span>
                    <div class="app-rail__copy">
                        <h3>Release notes and update status</h3>
                        <p>@PublicChangelogText(Model.ReleaseExperience.ReleaseNotesSummary) <span>Update path: @PublicChangelogText(Model.ReleaseExperience.UpdatePostureSummary)</span></p>
                    </div>
                    <a class="inline-link" href="@ContextualPreviewHref("/downloads")">Open downloads</a>
                </article>
                @foreach (var card in shippedNow)
                {
                    <article class="app-rail__item" id="@card.Card.Id.Replace('_', '-')">
                        <span class="tag">@PublicSurfaceStatus.DisplayLabel(card.Card.Badge)</span>
                        <div class="app-rail__copy">
                            <h3>@PublicChangelogText(card.Card.Title)</h3>
                            <p>@PublicChangelogText(card.Card.Summary)</p>
                        </div>
                        <a class="inline-link" href="@card.Action.Href">@PublicChangelogText(card.Action.Label)</a>
                    </article>
                }
            </div>
        </div>
    </div>
</section>

@if (stillCaution.Length > 0)
{
    <section class="release-shelf release-shelf--manual">
        <details class="release-accordion">
            <summary>Still under caution or inspection</summary>
            <div class="release-accordion__body">
                <div class="evidence-row-list">
                    @foreach (var card in stillCaution)
                    {
                        <article class="evidence-row" id="@card.Card.Id.Replace('_', '-')">
                            <div class="evidence-row__copy">
                                <h3>@PublicChangelogText(card.Card.Title)</h3>
                                <p>@PublicChangelogText(card.Card.Summary)</p>
                            </div>
                            <span class="readiness-tag @PublicSurfaceStatus.CssTone(card.Card.Badge)">@PublicSurfaceStatus.DisplayLabel(card.Card.Badge)</span>
                            <a class="button-like button-like--ghost" href="@card.Action.Href">@PublicChangelogText(card.Action.Label)</a>
                        </article>
                    }
                </div>
            </div>
        </details>
    </section>
}

<section class="release-footnote">
    <p class="eyebrow">Next step</p>
    <h2 class="editorial-title">Use the changelog to decide, then move to the right next page.</h2>
    <p class="editorial-copy">Install from Downloads, inspect direction on Roadmap, or leave this public page for Help when the issue is private or recovery-bound.</p>
    <div class="stacked-actions">
        <a class="cta-link cta-link--primary" href="@ContextualPreviewHref("/downloads")">Open downloads</a>
        <a class="cta-link cta-link--secondary" href="/roadmap">Open roadmap</a>
        <a class="cta-link cta-link--ghost" href="/help">Open help</a>
    </div>
    <p class="muted-copy">Need the quick status? <a class="inline-link" href="/now">Open what works today</a>.</p>
</section>

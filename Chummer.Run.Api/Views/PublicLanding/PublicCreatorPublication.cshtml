@model PublicCreatorPublicationPageViewModel
@{
    ViewData["Title"] = Model.Publication.Title;
    ViewData["Chrome"] = Model.Chrome;
    var publicationRouteReviewRequired = Model.TrustPulse?.MissingDesktopClientCoverage == true
        || Model.TrustPulse?.ParityClaimsReviewRequired == true;
    // Current direct route records still keep public comparison language limited.

    static string HumanizeStatus(string? value, string fallback = "Not connected")
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallback;
        }

        return value.Trim().ToLowerInvariant() switch
        {
            "active" => "Ready",
            "linked" => "Ready",
            "pending" => "Pending",
            "pending_verification" => "Confirmation sent",
            "verified" => "Confirmed",
            "approved" => "Approved",
            "published" => "Published",
            "self_service" => "Self-service",
            "review" => "Needs review",
            "warning" => "Needs attention",
            "attention" => "Needs attention",
            "ready" => "Ready",
            "revoked" => "Revoked",
            _ => System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(value.Replace('_', ' '))
        };
    }

    string PublicationAvailabilityLabel(bool discoverable)
        => publicationRouteReviewRequired && discoverable
            ? "Limited public state"
            : discoverable
                ? "Ready now"
                : "Limited release";

    var publicationPostureTitle = publicationRouteReviewRequired
        ? "Why this publication is still limited"
        : "Why this publication is live";
    var publicationPostureCopy = publicationRouteReviewRequired
        ? "This page keeps the useful detail and next step together while public availability stays limited."
        : "This page keeps discovery, trust, comparison, lineage, moderation, and the next step together instead of scattering them across separate routes.";
    var routeStateLabel = HumanizeStatus(Model.RouteState, "Bounded failure");
    var routeReceiptSummary = Model.RouteReceipt?.Summary
        ?? Model.BoundedFailureReason
        ?? "No visible publication history is attached to this outward-facing publication yet.";
    var signedInShelfHref = Model.Chrome.Authenticated ? "/artifacts#signed-in-detail-view" : "/signup?next=%2Fartifacts";
    var signedInShelfLabel = Model.Chrome.Authenticated ? "Open signed-in account return view" : "Create account for signed-in account return";
    var signedInShelfSummary = Model.Chrome.Authenticated
        ? "Use the signed-in detail view when you want personal, campaign, creator, and public returns to stay in one calmer place."
        : "Public discovery works without an account. Sign in only when you want private account return, campaign return, and creator next steps in one place.";
    var creatorConciergeHref = $"/artifacts/publications/{Uri.EscapeDataString(Model.Publication.PublicationId)}/concierge";
    var testimonialConciergeHref = $"/testimonials/concierge?publicationId={Uri.EscapeDataString(Model.Publication.PublicationId)}";
    var routeChoices = new[]
    {
        new
        {
            Badge = "Publication discovery",
            Title = "Stay in publication discovery when the job is lineage, provenance, or comparison",
            Summary = "This publication detail page belongs to the discovery family. Use the gallery and discovery pages when you want to inspect related outputs instead of jumping straight to downloads.",
            Href = Model.BackHref,
            Label = "Back to publication discovery",
            Details = new[] { "Details first", "Related items", "Comparison nearby" }
        },
        new
        {
            Badge = "Creator routing",
            Title = "Use the creator concierge when the next job is consult, intake, or creator next steps",
            Summary = "The creator wrapper keeps creator intake and follow-up separate from downloads, support, and account settings.",
            Href = creatorConciergeHref,
            Label = "Open creator concierge",
            Details = new[] { "Creator intake", "Follow-up visible", "No install confusion" }
        },
        new
        {
            Badge = "Downloads",
            Title = "Leave this page when the next job is installing the product",
            Summary = "The publication page should never compete with the recommended build, platform status, or install help. Downloads still owns that decision.",
            Href = "/downloads",
            Label = "Open downloads",
            Details = new[] { "Install path", "Known issues nearby", "No fake build path" }
        },
        new
        {
            Badge = "Signed-in account return",
            Title = Model.Chrome.Authenticated
                ? "Signed-in account return keeps public and private returns together"
                : "Create the account only when you want the signed-in account-return view too",
            Summary = signedInShelfSummary,
            Href = signedInShelfHref,
            Label = signedInShelfLabel,
            Details = Model.Chrome.Authenticated
                ? new[] { "Personal and campaign returns", "Creator next steps", "Same detail view" }
                : new[] { "Public first", "Account adds return paths", "No auth wall for discovery" }
        },
        new
        {
            Badge = "Public testimonials",
            Title = "Use the testimonial wrapper when you want moderated public feedback instead of support follow-up",
            Summary = "The testimonial route keeps ratings, media captures, and moderation separate from support cases, install recovery, and publication approval.",
            Href = testimonialConciergeHref,
            Label = "Open testimonial wrapper",
            Details = new[] { "Moderated feedback", "Optional media", "Support stays separate" }
        },
        new
        {
            Badge = "Help",
            Title = "Use first-party help as soon as the issue becomes support or recovery",
            Summary = "If the problem needs logs, account recovery, install repair, or private campaign detail, leave the publication page and move to help or support immediately.",
            Href = "/help",
            Label = "Open help",
            Details = new[] { "Setup help", "Private help", "No page confusion" }
        }
    };
}

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Where to go next</p>
        <h2 class="editorial-title">Choose discovery, downloads, signed-in account return, or help on purpose.</h2>
        <p class="editorial-copy">A publication detail page should make trust and provenance tangible. It should not pretend to be the install page, a support queue, or a disguised account wall.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var choice in routeChoices)
        {
            <article class="route-choice-card">
                <span class="tag">@choice.Badge</span>
                <h3>@choice.Title</h3>
                <p>@choice.Summary</p>
                <div class="route-choice-card__details">
                    @foreach (var item in choice.Details)
                    {
                        <span>@item</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@choice.Href">@choice.Label</a>
            </article>
        }
    </div>
</section>

<section class="story-cinematic">
    <div class="story-cinematic__copy">
        <p class="eyebrow">Public shared publication</p>
        <h1 class="page-title">@Model.Publication.Title</h1>
        <p class="page-copy">@Model.Publication.Summary</p>
        <div class="trust-claim__details">
            <span>@HumanizeStatus(Model.Publication.PublicationStatus, "Published")</span>
            <span>@HumanizeStatus(Model.Publication.TrustBand, "Draft")</span>
            <span>@PublicationAvailabilityLabel(Model.Publication.Discoverable)</span>
            <span>Route: @routeStateLabel</span>
        </div>
        @if (publicationRouteReviewRequired && !string.IsNullOrWhiteSpace(Model.TrustPulse?.RouteGuardSummary))
        {
            <p class="muted-copy">@Model.TrustPulse.RouteGuardSummary</p>
            <p class="muted-copy">Current desktop coverage still keeps this public wording limited.</p>
        }
        <div class="stacked-actions">
            <a class="button-like button-like--primary" href="@Model.BackHref">Back to publication discovery</a>
            <a class="button-like button-like--ghost" href="/artifacts">Open detail view</a>
        </div>
    </div>
</section>

<section class="trust-rail-section">
    <div class="editorial-block__lead">
        <p class="eyebrow">Shared publication</p>
        <h2 class="editorial-title">@publicationPostureTitle</h2>
        <p class="editorial-copy">@publicationPostureCopy</p>
    </div>
    <div class="trust-rail-list">
        <article class="trust-rail">
            <span class="tag">Publication kind</span>
            <p>@HumanizeStatus(Model.Publication.Kind, "Publication packet")</p>
        </article>
        <article class="trust-rail">
            <span class="tag">Details</span>
            <p>@PublicFacingCopyHumanizer.Clean(Model.Publication.ProvenanceSummary)</p>
        </article>
        <article class="trust-rail">
            <span class="tag">Trust</span>
            <p>@PublicFacingCopyHumanizer.Clean(Model.Publication.TrustSummary ?? "Trust status is not available yet.")</p>
        </article>
        <article class="trust-rail">
            <span class="tag">Discovery</span>
            <p>@Model.Publication.DiscoverySummary</p>
        </article>
        <article class="trust-rail">
            <span class="tag">History</span>
            <p>@routeReceiptSummary</p>
            @if (Model.RouteReceipt is not null)
            {
                <p class="muted-copy">Receipt @Model.RouteReceipt.ReceiptId via @Model.RouteReceipt.MatchedRoute</p>
                <p class="muted-copy">This page is linked to the current publication history.</p>
            }
            else
            {
                <p class="muted-copy">This publication stays bounded until a current outward-facing receipt is attached.</p>
            }
        </article>
        <article class="trust-rail">
            <span class="tag">Required details</span>
            <p>@Model.RequiredReceiptRefs.Count required detail@(Model.RequiredReceiptRefs.Count == 1 ? string.Empty : "s") attached.</p>
        </article>
        @if (!string.IsNullOrWhiteSpace(Model.Publication.ComparisonSummary))
        {
            <article class="trust-rail">
                <span class="tag">Compare by</span>
                <p>@Model.Publication.ComparisonSummary</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Publication.LineageSummary))
        {
            <article class="trust-rail">
                <span class="tag">Lineage</span>
                <p>@Model.Publication.LineageSummary</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Publication.ModerationSummary))
        {
            <article class="trust-rail">
                <span class="tag">Moderation</span>
                <p>@Model.Publication.ModerationSummary</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Publication.CampaignReturnSummary))
        {
            <article class="trust-rail">
                <span class="tag">Return</span>
                <p>@Model.Publication.CampaignReturnSummary</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Publication.SupportClosureSummary))
        {
            <article class="trust-rail">
                <span class="tag">Support</span>
                <p>@Model.Publication.SupportClosureSummary</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Publication.NextSafeAction))
        {
            <article class="trust-rail">
                <span class="tag">Next</span>
                <p>@Model.Publication.NextSafeAction</p>
            </article>
        }
    </div>
</section>

<section class="release-footnote">
    <p class="eyebrow">Next step</p>
    <h2 class="editorial-title">Use this page to inspect the publication, then move to the page that owns the next job.</h2>
    <p class="editorial-copy">Stay in publication discovery for related items, open Downloads when you actually want the build, or leave for Help when the issue becomes private, recovery-bound, or support-owned.</p>
    <div class="stacked-actions">
        <a class="cta-link cta-link--primary" href="@Model.BackHref">Back to publication discovery</a>
        <a class="cta-link cta-link--secondary" href="/artifacts">Open detail view</a>
        <a class="cta-link cta-link--ghost" href="/downloads">Open downloads</a>
    </div>
    <p class="muted-copy">Need private help instead? <a class="inline-link" href="/contact#support-intake">Open support intake</a>.</p>
</section>

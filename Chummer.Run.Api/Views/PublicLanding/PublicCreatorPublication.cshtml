@model PublicCreatorPublicationPageViewModel
@{
    ViewData["Title"] = PublicPublicationText(Model.Publication.Title);
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-artifacts surface-minimal";
    var publicationRouteReviewRequired = Model.TrustPulse?.MissingDesktopClientCoverage == true
        || Model.TrustPulse?.ParityClaimsReviewRequired == true;
    // Keep comparisons narrow until the related page records are current.

    static string HumanizeStatus(string? value, string fallback = "Not connected")
        => UndetectableHumanizerCopyAdapter.HumanizeStatusLabel(value, fallback);

    static string PublicPublicationText(string? value, string fallback = "")
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallback;
        }

        return UndetectableHumanizerCopyAdapter.HumanizePublication(value);
    }

    string PublicationAvailabilityLabel(bool discoverable)
        => publicationRouteReviewRequired && discoverable
            ? "Short summary"
            : discoverable
                ? "Ready now"
                : "Limited release";

    var publicationPostureTitle = "Why this publication is live";
    var publicationPostureCopy = publicationRouteReviewRequired
        ? "This page keeps the useful parts together while broader comparison copy stays short."
        : "This page keeps the publication, its status, and the next useful links together.";
    var routeStateLabel = HumanizeStatus(Model.RouteState, "Limited");
    var routeReceiptSummary = Model.RouteReceipt?.Summary
        ?? Model.BoundedFailureReason
        ?? "No visible publication history is attached to this public page yet.";
    var signedInShelfHref = Model.Chrome.Authenticated ? "/artifacts#signed-in-detail-view" : "/signup?next=%2Fartifacts";
    var signedInShelfLabel = Model.Chrome.Authenticated ? "Open saved pages" : "Create account for saved pages";
    var signedInShelfSummary = Model.Chrome.Authenticated
        ? "Your library keeps public and private returns together in one calmer place."
        : "Public discovery works without an account. Sign in only when you want your private pages, campaign return, and creator next steps in one library.";
    var creatorConciergeHref = $"/artifacts/publications/{Uri.EscapeDataString(Model.Publication.PublicationId)}/concierge";
    var testimonialConciergeHref = $"/testimonials/concierge?publicationId={Uri.EscapeDataString(Model.Publication.PublicationId)}";
    var routeChoices = new[]
    {
        new
        {
            Badge = "Gallery",
            Title = "Stay in the gallery for story, background, or comparison",
            Summary = "Use this page when you want the publication itself, not the installer.",
            Href = Model.BackHref,
            Label = "Back to gallery",
            Details = new[] { "Story first", "Related work", "Comparison nearby" }
        },
        new
        {
            Badge = "Creator",
            Title = "Open creator help for intake or follow-up",
            Summary = "Keep creator questions separate from downloads, support, and account settings.",
            Href = creatorConciergeHref,
            Label = "Open creator help",
            Details = new[] { "Creator intake", "Follow-up visible", "No install confusion" }
        },
        new
        {
            Badge = "Downloads",
            Title = "Open downloads when you want the app",
            Summary = "Downloads owns the installer, platform status, and setup help.",
            Href = "/downloads",
            Label = "Open downloads",
            Details = new[] { "Install path", "Updated", "Setup help nearby" }
        },
        new
        {
            Badge = "Account return",
            Title = Model.Chrome.Authenticated
                ? "Your saved pages keep public and private returns together"
                : "Create an account only when you want saved pages too",
            Summary = signedInShelfSummary,
            Href = signedInShelfHref,
            Label = signedInShelfLabel,
            Details = Model.Chrome.Authenticated
                ? new[] { "Personal and campaign returns", "Creator next steps", "One library" }
                : new[] { "Public first", "Account adds return paths", "Public discovery stays open" }
        },
        new
        {
            Badge = "Testimonials",
            Title = "Open testimonials for public feedback",
            Summary = "Use the testimonial page for moderated public feedback.",
            Href = testimonialConciergeHref,
            Label = "Open testimonial page",
            Details = new[] { "Moderated feedback", "Optional media", "Support stays separate" }
        },
        new
        {
            Badge = "Help",
            Title = "Use Chummer help for support or recovery",
            Summary = "Leave this page when the issue becomes setup, recovery, or private support.",
            Href = "/help",
            Label = "Open help",
            Details = new[] { "Setup help", "Private help", "No page confusion" }
        }
    };
}

<section class="minimal-page-hero route-anchor-target">
    <div>
        <p class="eyebrow">Publication</p>
        <h1>@PublicPublicationText(Model.Publication.Title)</h1>
        <p>@PublicPublicationText(Model.Publication.Summary)</p>
    </div>
    <div class="minimal-status-pill">
        <span>@HumanizeStatus(Model.Publication.PublicationStatus, "Published")</span>
        <strong>@HumanizeStatus(Model.Publication.TrustBand, "Draft")</strong>
        <span>@PublicationAvailabilityLabel(Model.Publication.Discoverable)</span>
        <span>Status: @routeStateLabel</span>
    </div>
</section>

<section class="status-decision-strip" aria-label="Publication options">
    <article class="status-decision-strip__card">
        <span class="tag">Gallery</span>
        <h2>Stay in the gallery for story, background, or comparison.</h2>
        <p>Use this page for the publication itself. Downloads, help, and your saved pages keep their own jobs.</p>
        <a class="button-like button-like--ghost" href="@Model.BackHref">Back to publication discovery</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag">Downloads</span>
        <h2>Open downloads when you want the app.</h2>
        <p>Downloads owns the installer, platform status, and setup help.</p>
        <a class="button-like button-like--ghost" href="/downloads">Open downloads</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag tag--amber">Help</span>
        <h2>Use Chummer help for support or recovery.</h2>
        <p>Leave this page when the issue becomes setup, recovery, or private support.</p>
        <a class="button-like button-like--ghost" href="/help">Open help</a>
    </article>
</section>

<section class="minimal-section minimal-section--tight">
    <div class="minimal-section__lead">
        <p class="eyebrow">Where next</p>
        <h2>Choose gallery, downloads, saved pages, or help.</h2>
        <p>Use this page for the publication itself. Downloads, help, and your saved pages keep their own jobs.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var choice in routeChoices)
        {
            <article class="route-choice-card">
                <span class="tag">@PublicPublicationText(choice.Badge)</span>
                <h3>@PublicPublicationText(choice.Title)</h3>
                <p>@PublicPublicationText(choice.Summary)</p>
                <div class="route-choice-card__details">
                    @foreach (var item in choice.Details)
                    {
                        <span>@PublicPublicationText(item)</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@choice.Href">@PublicPublicationText(choice.Label)</a>
            </article>
        }
    </div>
</section>

<section class="trust-rail-section">
    <div class="editorial-block__lead">
        <p class="eyebrow">Shared publication</p>
        <h2 class="editorial-title">@publicationPostureTitle</h2>
        <p class="editorial-copy">@publicationPostureCopy</p>
        <p class="editorial-copy">This page keeps discovery, trust, comparison, lineage, moderation, and the next step together instead of scattering them across separate routes.</p>
        @if (publicationRouteReviewRequired && !string.IsNullOrWhiteSpace(Model.TrustPulse?.RouteGuardSummary))
        {
            <p class="muted-copy">@PublicPublicationText(Model.TrustPulse.RouteGuardSummary)</p>
            <p class="muted-copy">Some desktop work is still open, so this page stays short.</p>
        }
    </div>
    <div class="trust-rail-list">
        <article class="trust-rail">
            <span class="tag">Type</span>
            <p>@HumanizeStatus(Model.Publication.Kind, "Publication")</p>
        </article>
        <article class="trust-rail">
            <span class="tag">Trust</span>
            <p>@PublicPublicationText(Model.Publication.TrustSummary, "Trust posture is still forming.")</p>
        </article>
        <article class="trust-rail">
            <span class="tag">Origin</span>
            <p>@PublicPublicationText(Model.Publication.ProvenanceSummary)</p>
        </article>
        <article class="trust-rail">
            <span class="tag">Status</span>
            <p>@PublicPublicationText(Model.Publication.TrustSummary, "Status is not available yet.")</p>
        </article>
        <article class="trust-rail">
            <span class="tag">Discovery</span>
            <p>@PublicPublicationText(Model.Publication.DiscoverySummary)</p>
        </article>
        <article class="trust-rail">
            <span class="tag">History</span>
            <p>@PublicPublicationText(routeReceiptSummary)</p>
            @if (Model.RouteReceipt is not null)
            {
                <p class="muted-copy">This page is linked to the current publication history.</p>
            }
            else
            {
                <p class="muted-copy">This publication stays brief until a current public update is attached.</p>
            }
        </article>
        <article class="trust-rail">
            <span class="tag">Related pages</span>
            <p>@Model.RequiredReceiptRefs.Count related page@(Model.RequiredReceiptRefs.Count == 1 ? string.Empty : "s") available.</p>
        </article>
        @if (!string.IsNullOrWhiteSpace(Model.Publication.ComparisonSummary))
        {
            <article class="trust-rail">
                <span class="tag">Compare</span>
                <p>@PublicPublicationText(Model.Publication.ComparisonSummary)</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Publication.LineageSummary))
        {
            <article class="trust-rail">
                <span class="tag">Earlier</span>
                <p>@PublicPublicationText(Model.Publication.LineageSummary)</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Publication.ModerationSummary))
        {
            <article class="trust-rail">
                <span class="tag">Moderation</span>
                <p>@PublicPublicationText(Model.Publication.ModerationSummary)</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Publication.CampaignReturnSummary))
        {
            <article class="trust-rail">
                <span class="tag">Return</span>
                <p>@PublicPublicationText(Model.Publication.CampaignReturnSummary)</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Publication.SupportClosureSummary))
        {
            <article class="trust-rail">
                <span class="tag">Support</span>
                <p>@PublicPublicationText(Model.Publication.SupportClosureSummary)</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Publication.NextSafeAction))
        {
            <article class="trust-rail">
                <span class="tag">Next</span>
                <p>@PublicPublicationText(Model.Publication.NextSafeAction)</p>
            </article>
        }
    </div>
</section>

<section class="release-footnote">
    <p class="eyebrow">Next</p>
    <h2 class="editorial-title">Move on once this is clear.</h2>
    <p class="editorial-copy">Go back for related work, open Downloads for the app, or open Help for support.</p>
    <div class="stacked-actions">
        <a class="cta-link cta-link--primary" href="@Model.BackHref">Back to publication discovery</a>
        <a class="cta-link cta-link--secondary" href="/artifacts">Open saved pages</a>
        <a class="cta-link cta-link--ghost" href="/downloads">Open downloads</a>
    </div>
    <p class="muted-copy">Need private help instead? <a class="inline-link" href="/contact#support-intake">Open support</a>.</p>
</section>

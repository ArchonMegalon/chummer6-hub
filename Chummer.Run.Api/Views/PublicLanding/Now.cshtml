@model NowPageViewModel
@{
    ViewData["Title"] = "What Works Today";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-now";
    var sourceAlias = Context?.Request?.Query["source"].ToString() ?? string.Empty;
    var fromChangelogAlias = string.Equals(sourceAlias, "changelog", StringComparison.OrdinalIgnoreCase);
    static string NormalizeRoute(string href)
    {
        var trimmed = (href ?? string.Empty).Trim();
        var hash = trimmed.IndexOf('#');
        if (hash >= 0)
        {
            trimmed = trimmed[..hash];
        }

        var query = trimmed.IndexOf('?');
        if (query >= 0)
        {
            trimmed = trimmed[..query];
        }

        return string.IsNullOrWhiteSpace(trimmed) ? "/" : trimmed;
    }

    var proofTargets = Model.ProofModules
        .Select(card => NormalizeRoute(card.Action.Href))
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
    var supportingProof = Model.AvailableToday
        .Concat(Model.Inspectable)
        .Where(card => !proofTargets.Contains(NormalizeRoute(card.Action.Href)))
        .ToArray();
    var signedInBenefits = Model.SignedInPreview.ToArray();
    var guestNeedsInstallGate = !Model.Chrome.Authenticated && !string.IsNullOrWhiteSpace(Model.ReleaseExperience.GuestGatePrimaryHref);
    var publishedLabel = Model.Manifest.PublishedAt.ToUniversalTime().ToString("yyyy-MM-dd");
    var verifiedLabel = Model.VerifiedAtLabel
        ?? (Model.Manifest.ProofGeneratedAt ?? Model.Manifest.GeneratedAt ?? Model.Manifest.PublishedAt)
            .ToUniversalTime()
            .ToString("yyyy-MM-dd");

    string ContextualPreviewHref(string? href)
    {
        var resolvedHref = string.IsNullOrWhiteSpace(href) ? "/downloads" : href;
        if (
            guestNeedsInstallGate
            && string.Equals(resolvedHref, "/downloads", StringComparison.OrdinalIgnoreCase)
        )
        {
            return Model.ReleaseExperience.GuestGatePrimaryHref ?? resolvedHref;
        }

        return resolvedHref;
    }
}

<section class="evidence-header route-anchor-target" id="public-shipped-closeout">
    <div class="page-lead">
        <p class="eyebrow">What works today</p>
        <h1 class="page-title">What works today and what still needs caution</h1>
        <p class="page-copy">Use this page to decide whether to install now, wait, or read one more detail first.</p>
        @if (fromChangelogAlias)
        {
            <div class="route-callout" role="status" aria-live="polite">
                <h3>You followed a legacy shipped handoff</h3>
                <p>The shipped update stream now lives on <code class="mono-receipt">/changelog</code>. This page stays the quick install reality check: what is ready now, what you can verify yourself, and where to go when a device needs help first.</p>
                <div class="route-callout__proof">
                    <span>User-available</span>
                    <span>Release-linked</span>
                    <span>Install reality</span>
                </div>
                <div class="route-callout__actions">
                    <a class="inline-link" href="/changelog">Open changelog</a>
                    <a class="inline-link" href="/feedback">Open feedback</a>
                    <a class="inline-link" href="/roadmap">Open roadmap</a>
                    <a class="inline-link" href="/help">Open help</a>
                </div>
            </div>
        }
    </div>
    <div class="evidence-header__stats">
        <div>
            <span class="evidence-header__label">Current build</span>
            <strong>@Model.ReleaseExperience.Display.BuildLabel</strong>
        </div>
        <div>
            <span class="evidence-header__label">Channel</span>
            <strong>@Model.ReleaseExperience.Display.ChannelLabel</strong>
        </div>
        <div>
            <span class="evidence-header__label">Released</span>
            <strong>@publishedLabel</strong>
        </div>
        <div>
            <span class="evidence-header__label">Last verified</span>
            <strong>@verifiedLabel</strong>
        </div>
    </div>
</section>

<section class="status-decision-strip" aria-label="Readiness and release decisions">
    <article class="status-decision-strip__card">
        <span class="tag">Ready to install?</span>
        <h2>Start from downloads when you want the recommended build and the calmest first-run path for this device.</h2>
        <p>Downloads stays the primary install surface, with the current package, known issues, and the shortest path to a real first launch.</p>
        <a class="button-like button-like--ghost" href="@ContextualPreviewHref("/downloads")">Open downloads</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag">What you can check now</span>
        <h2>The release checks below should answer the normal trust questions without forcing a full roadmap tour.</h2>
        <p>Use them when you want one concrete result, one visible trail, and one clear next step before you commit a device.</p>
        <a class="button-like button-like--ghost" href="#now-proof">Open release checks</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag tag--amber">Need caution</span>
        <h2>Known issues, install help, and support stay close to downloads.</h2>
        <p>Wait, route around, or ask for help from Chummer support instead of decoding internal product language or public planning pages.</p>
        <a class="button-like button-like--ghost" href="/help">Open help</a>
    </article>
</section>

<section class="release-footnote">
    <div class="route-callout" role="status" aria-live="polite">
        <h3>Want one short guided release branch first?</h3>
        <p>The release concierge keeps changelog, release notes, update help, and human escalation in one guided wrapper without replacing the download page.</p>
        <div class="route-callout__actions">
            <a class="inline-link" href="/now/concierge">Open release concierge</a>
            <a class="inline-link" href="/changelog">Open changelog</a>
        </div>
    </div>
</section>

@if (Model.SignedInStatus is not null)
{
    <section class="release-footnote">
        @await Html.PartialAsync("~/Views/Shared/_SignedInTrustStatusPanel.cshtml", Model.SignedInStatus)
    </section>
}

<section class="evidence-wall">
    <article class="evidence-group">
        <div class="evidence-group__header">
            <span class="readiness-tag">Current release</span>
            <h2>Before you install</h2>
        </div>
        <div class="evidence-row-list">
            <article class="evidence-row">
                <div class="evidence-row__copy">
                    <h3>Current release</h3>
                    <p>@Model.ReleaseExperience.ReleaseNotesSummary</p>
                </div>
                <a class="button-like button-like--ghost" href="@ContextualPreviewHref("/downloads")">Open downloads</a>
            </article>
            <article class="evidence-row">
                <div class="evidence-row__copy">
                    <h3>Known issues and install help</h3>
                    <p>Check download help and known issues before you commit a fresh device to the current downloads page.</p>
                </div>
                <a class="button-like button-like--ghost" href="@Model.ReleaseExperience.KnownIssuesHref">@Model.ReleaseExperience.KnownIssuesLabel</a>
            </article>
            <article class="evidence-row">
                <div class="evidence-row__copy">
                    <h3>Update path</h3>
                    <p>@Model.ReleaseExperience.UpdatePostureSummary</p>
                </div>
                <span class="readiness-tag">@Model.ReleaseExperience.Display.ChannelLabel</span>
            </article>
            <article class="evidence-row">
                <div class="evidence-row__copy">
                    <h3>First launch should open a finished runner fast</h3>
                    <p>If you want a quick tour before you build from scratch, start with the included example runner from the opening surface.</p>
                </div>
                <a class="button-like button-like--ghost" href="@ContextualPreviewHref("/downloads")">Open downloads</a>
            </article>
        </div>
    </article>
</section>

<section class="workflow-band" id="now-proof">
    <div class="workflow-band__lead">
        <p class="eyebrow">What you can check now</p>
        <h2 class="editorial-title">Three release checks that show what works beyond the landing page</h2>
        <p class="editorial-copy">These cards stay focused on real product behavior: builder results, explanation trail, and continuity under drift.</p>
    </div>
    <div class="workflow-grid">
        @foreach (var card in Model.ProofModules)
        {
            <article class="workflow-card">
                @if (card.Asset is not null)
                {
                    <div class="workflow-card__media">
                        @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", card.Asset)
                    </div>
                }
                <div class="workflow-card__copy">
                    <span class="tag">@card.Card.Badge</span>
                    <h3>@card.Card.Title</h3>
                    <p>@card.Card.Summary</p>
                    @if (!string.IsNullOrWhiteSpace(card.Card.ProofNote))
                    {
                        <p class="workflow-card__proof">@card.Card.ProofNote</p>
                    }
                    <a class="inline-link" href="@card.Action.Href">@card.Action.Label</a>
                </div>
            </article>
        }
    </div>
</section>

@if (supportingProof.Length > 0)
{
    <section class="release-shelf release-shelf--manual">
        <details class="release-accordion">
            <summary>More release detail you can inspect today</summary>
            <div class="release-accordion__body">
                <div class="evidence-row-list">
                    @foreach (var card in supportingProof)
                    {
                        <article class="evidence-row" id="@card.Card.Id.Replace('_', '-')">
                            <div class="evidence-row__copy">
                                <h3>@card.Card.Title</h3>
                                <p>@card.Card.Summary</p>
                            </div>
                            <span class="readiness-tag @PublicSurfaceStatus.CssTone(card.Card.Badge)">@PublicSurfaceStatus.DisplayLabel(card.Card.Badge)</span>
                            <a class="button-like button-like--ghost" href="@card.Action.Href">@card.Action.Label</a>
                        </article>
                    }
                </div>
            </div>
        </details>
    </section>
}

<section class="release-footnote">
    <p class="eyebrow">Signed-in return</p>
    <h2 class="editorial-title">Keep the return path attached when one install is not enough</h2>
    <p class="editorial-copy">Use the account path when you want devices, support updates, and follow-up history attached to the same return surface without turning signup into the main public decision.</p>
    @if (signedInBenefits.Length > 0)
    {
        <div class="trust-claim__microproof">
            @foreach (var overlay in signedInBenefits)
            {
                <span>@overlay.Title</span>
            }
        </div>
    }
    <div class="stacked-actions">
        <a class="cta-link cta-link--primary" href="@(Model.Chrome.Authenticated ? "/home" : "/signup?next=/home")">
            @(Model.Chrome.Authenticated ? "Open home" : "Create account")
        </a>
        @if (!Model.Chrome.Authenticated)
        {
            <a class="inline-link" href="/login?next=/home">Already have an account? Sign in</a>
        }
    </div>
    <p class="muted-copy">Still deciding? <a class="inline-link" href="@ContextualPreviewHref("/downloads")">Open downloads</a> or <a class="inline-link" href="/what-is-chummer">read the product story</a>.</p>
</section>

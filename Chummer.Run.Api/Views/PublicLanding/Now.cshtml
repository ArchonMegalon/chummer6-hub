@model NowPageViewModel
@{
    ViewData["Title"] = "What Works Today";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-now surface-minimal";
    var sourceAlias = Context?.Request?.Query["source"].ToString() ?? string.Empty;
    var fromChangelogAlias = string.Equals(sourceAlias, "changelog", StringComparison.OrdinalIgnoreCase);
    static string NormalizeRoute(string href)
    {
        var trimmed = (href ?? string.Empty).Trim();
        var hash = trimmed.IndexOf('#');
        if (hash >= 0)
        {
            trimmed = trimmed[..hash];
        }

        var query = trimmed.IndexOf('?');
        if (query >= 0)
        {
            trimmed = trimmed[..query];
        }

        return string.IsNullOrWhiteSpace(trimmed) ? "/" : trimmed;
    }

    var detailTargets = Model.ProofModules
        .Select(card => NormalizeRoute(card.Action.Href))
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
    var supportingDetails = Model.AvailableToday
        .Concat(Model.Inspectable)
        .Where(card => !detailTargets.Contains(NormalizeRoute(card.Action.Href)))
        .ToArray();
    var signedInBenefits = Model.SignedInPreview.ToArray();
    var guestNeedsInstallGate = !Model.Chrome.Authenticated && !string.IsNullOrWhiteSpace(Model.ReleaseExperience.GuestGatePrimaryHref);
    var verifiedLabel = Model.ReleaseTruth.VerifiedDateLabel;

    static string PublicNowText(string? value) => UndetectableHumanizerCopyAdapter.Humanize(value);

    string ContextualPreviewHref(string? href)
    {
        var resolvedHref = string.IsNullOrWhiteSpace(href) ? "/downloads" : href;
        if (
            guestNeedsInstallGate
            && string.Equals(resolvedHref, "/downloads", StringComparison.OrdinalIgnoreCase)
        )
        {
            return Model.ReleaseExperience.GuestGatePrimaryHref ?? resolvedHref;
        }

        return resolvedHref;
    }
}

<section class="minimal-page-hero route-anchor-target" id="public-shipped-closeout">
    <div>
        <p class="eyebrow">What works today</p>
        <h1>What works today</h1>
        <p>Use this page when you want the short answer before you install.</p>
        @if (fromChangelogAlias)
        {
            <details class="minimal-help-card__details">
                <summary>You followed an old link</summary>
                <p>Release notes moved to <a class="inline-link" href="/changelog">Changelog</a>. This page stays focused on the short answer: install now, wait, or get help first.</p>
                <ul>
                    <li><a class="inline-link" href="/changelog">Open changelog</a></li>
                    <li><a class="inline-link" href="/feedback">Open feedback</a></li>
                    <li><a class="inline-link" href="/roadmap">Open roadmap</a></li>
                    <li><a class="inline-link" href="/help">Open help</a></li>
                </ul>
            </details>
        }
    </div>
    <div class="minimal-status-pill">
        <span>Updated</span>
        <strong>@verifiedLabel</strong>
    </div>
</section>

<section class="minimal-section minimal-section--tight">
    <div class="minimal-lane-grid">
        <article class="minimal-lane-card">
            <span>Install</span>
            <h2>Start from downloads.</h2>
            <p>Downloads has the current package, setup help, and the shortest path to a real first launch from the current downloads page.</p>
            <p>@PublicNowText(Model.ReleaseExperience.ReleaseNotesSummary)</p>
            <div class="minimal-actions">
                <a class="button-like button-like--primary" href="@ContextualPreviewHref("/downloads")">Open downloads</a>
            </div>
        </article>
        <article class="minimal-lane-card">
            <span>Need help</span>
            <h3>Install notes and help</h3>
            <h2>Use help before you guess.</h2>
            <p>Install notes, updates, and support stay close to the install path.</p>
            <p>@PublicNowText(Model.ReleaseExperience.KnownIssuesLabel)</p>
            <p>@PublicNowText(Model.ReleaseExperience.UpdatePostureSummary)</p>
            <div class="minimal-actions">
                <a class="button-like button-like--ghost" href="/help">Open help</a>
            </div>
        </article>
    </div>
</section>

<section class="minimal-section" id="now-details">
    <div class="minimal-section__lead">
        <p class="eyebrow">What matters now</p>
        <h2>Three things to know first</h2>
        <p>These cards cover builder results, rule explanations, and saved work after changes.</p>
    </div>
    <div class="minimal-lane-grid">
        @foreach (var card in Model.ProofModules)
        {
            <article class="minimal-lane-card">
                <span>@PublicSurfaceStatus.DisplayLabel(card.Card.Badge)</span>
                <h3>@PublicNowText(card.Card.Title)</h3>
                <p>@PublicNowText(card.Card.Summary)</p>
                @if (!string.IsNullOrWhiteSpace(card.Card.ProofNote))
                {
                    <p class="muted-copy workflow-card__note">@PublicNowText(card.Card.ProofNote)</p>
                }
                <div class="minimal-actions">
                    <a class="button-like button-like--ghost" href="@card.Action.Href">@PublicNowText(card.Action.Label)</a>
                </div>
            </article>
        }
    </div>
</section>

@if (supportingDetails.Length > 0)
{
    <section class="minimal-section minimal-section--tight">
        <details class="minimal-details">
            <summary>More today</summary>
            <dl>
                @foreach (var card in supportingDetails)
                {
                    <div id="@card.Card.Id.Replace('_', '-')">
                        <dt>
                            <strong>@PublicNowText(card.Card.Title)</strong>
                            <p>@PublicNowText(card.Card.Summary)</p>
                        </dt>
                        <dd>
                            <a class="inline-link" href="@card.Action.Href">@PublicNowText(card.Action.Label)</a>
                        </dd>
                    </div>
                }
            </dl>
        </details>
    </section>
}

@if (Model.SignedInStatus is not null)
{
    <section class="minimal-section minimal-section--tight">
        @await Html.PartialAsync("~/Views/Shared/_SignedInTrustStatusPanel.cshtml", Model.SignedInStatus)
    </section>
}

<section class="minimal-section minimal-section--tight">
    <div class="minimal-section__lead">
        <p class="eyebrow">Account is optional</p>
        <h2>Keep devices and support history together</h2>
        <p>Use an account only if you want your installs and support history in one place. If you want a quick tour before building from scratch, start from Home or Roadmap after the first launch.</p>
    </div>
    @if (signedInBenefits.Length > 0)
    {
        <div class="minimal-help-grid">
            @foreach (var overlay in signedInBenefits)
            {
                <article class="minimal-help-card">
                    <h3>@PublicNowText(overlay.Title)</h3>
                </article>
            }
        </div>
    }
    <div class="minimal-actions">
        <a class="button-like button-like--primary" href="@(Model.Chrome.Authenticated ? "/home" : "/signup?next=/home")">
            @(Model.Chrome.Authenticated ? "Open home" : "Claim your copy")
        </a>
        @if (!Model.Chrome.Authenticated)
        {
            <a class="button-like button-like--ghost" href="/login?next=/home">Sign in</a>
        }
    </div>
    <p class="muted-copy">Still deciding? <a class="inline-link" href="@ContextualPreviewHref("/downloads")">Open downloads</a> or <a class="inline-link" href="/what-is-chummer">read the product story</a>.</p>
</section>

@model NowPageViewModel
@{
    ViewData["Title"] = "What Is Real Now";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-now";
    static string DisplayStatus(string badge)
        => string.Equals(badge, "Live now", StringComparison.OrdinalIgnoreCase)
            ? "Available today"
            : string.Equals(badge, "Inspectable", StringComparison.OrdinalIgnoreCase)
                ? "Preview"
                : badge;
    static string NormalizeRoute(string href)
    {
        var trimmed = (href ?? string.Empty).Trim();
        var hash = trimmed.IndexOf('#');
        if (hash >= 0)
        {
            trimmed = trimmed[..hash];
        }

        var query = trimmed.IndexOf('?');
        if (query >= 0)
        {
            trimmed = trimmed[..query];
        }

        return string.IsNullOrWhiteSpace(trimmed) ? "/" : trimmed;
    }

    var proofTargets = Model.ProofModules
        .Select(card => NormalizeRoute(card.Action.Href))
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
    var supportingProof = Model.AvailableToday
        .Concat(Model.Inspectable)
        .Where(card => !proofTargets.Contains(NormalizeRoute(card.Action.Href)))
        .ToArray();
    var signedInBenefits = Model.SignedInPreview.ToArray();
}

<section class="evidence-header">
    <div class="page-lead">
        <p class="eyebrow">What works today</p>
        <h1 class="page-title">Current preview, visible proof, and known posture</h1>
        <p class="page-copy">Use this page to answer three practical questions fast: what changed in the current preview, what you can verify today, and when you should install or wait.</p>
    </div>
    <div class="evidence-header__stats">
        <div>
            <span class="evidence-header__label">Current build</span>
            <strong>@Model.ReleaseExperience.Display.BuildLabel</strong>
        </div>
        <div>
            <span class="evidence-header__label">Channel</span>
            <strong>@Model.ReleaseExperience.Display.ChannelLabel</strong>
        </div>
        <div>
            <span class="evidence-header__label">Published</span>
            <strong>@Model.Manifest.PublishedAt.ToUniversalTime().ToString("yyyy-MM-dd")</strong>
        </div>
    </div>
</section>

<section class="evidence-wall">
    <article class="evidence-group">
        <div class="evidence-group__header">
            <span class="readiness-tag">Current release</span>
            <h2>Release health before you install</h2>
        </div>
        <div class="evidence-row-list">
            <article class="evidence-row">
                <div class="evidence-row__copy">
                    <h3>What changed since the last preview</h3>
                    <p>@Model.ReleaseExperience.ReleaseNotesSummary</p>
                </div>
                <a class="button-like button-like--ghost" href="/downloads">Open downloads</a>
            </article>
            <article class="evidence-row">
                <div class="evidence-row__copy">
                    <h3>Known issues and install help</h3>
                    <p>Check the install and known-issue lane before you commit a fresh device to the preview.</p>
                </div>
                <a class="button-like button-like--ghost" href="@Model.ReleaseExperience.KnownIssuesHref">@Model.ReleaseExperience.KnownIssuesLabel</a>
            </article>
            <article class="evidence-row">
                <div class="evidence-row__copy">
                    <h3>Update posture</h3>
                    <p>@Model.ReleaseExperience.UpdatePostureSummary</p>
                </div>
                <span class="readiness-tag">Preview channel</span>
            </article>
        </div>
    </article>
</section>

<section class="workflow-band">
    <div class="workflow-band__lead">
        <p class="eyebrow">What you can verify now</p>
        <h2 class="editorial-title">Build, explain, and run with visible evidence</h2>
        <p class="editorial-copy">These are the three product behaviors the current preview is already proving in public: builder truth, explanation trail, and continuity under drift.</p>
    </div>
    <div class="workflow-grid">
        @foreach (var card in Model.ProofModules)
        {
            <article class="workflow-card">
                @if (card.Asset is not null)
                {
                    <div class="workflow-card__media">
                        @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", card.Asset)
                    </div>
                }
                <div class="workflow-card__copy">
                    <span class="tag">@card.Card.Badge</span>
                    <h3>@card.Card.Title</h3>
                    <p>@card.Card.Summary</p>
                    @if (!string.IsNullOrWhiteSpace(card.Card.ProofNote))
                    {
                        <p class="workflow-card__proof">@card.Card.ProofNote</p>
                    }
                    <a class="inline-link" href="@card.Action.Href">@card.Action.Label</a>
                </div>
            </article>
        }
    </div>
</section>

@if (supportingProof.Length > 0)
{
    <section class="release-shelf release-shelf--manual">
        <details class="release-accordion">
            <summary>More proof markers around the core loop</summary>
            <div class="release-accordion__body">
                <div class="evidence-row-list">
                    @foreach (var card in supportingProof)
                    {
                        <article class="evidence-row" id="@card.Card.Id.Replace('_', '-')">
                            <div class="evidence-row__copy">
                                <h3>@card.Card.Title</h3>
                                <p>@card.Card.Summary</p>
                            </div>
                            <span class="readiness-tag @(string.Equals(card.Card.Badge, "Live now", StringComparison.OrdinalIgnoreCase) ? string.Empty : "tag--amber")">@DisplayStatus(card.Card.Badge)</span>
                            <a class="button-like button-like--ghost" href="@card.Action.Href">@card.Action.Label</a>
                        </article>
                    }
                </div>
            </div>
        </details>
    </section>
}

<section class="story-guide-tail">
    <p class="eyebrow">Signed-in return</p>
    <h2 class="editorial-title">Use the account path when you want continuity, not just one download</h2>
    <p class="editorial-copy">The account path keeps install receipts, roadmap follows, beta interest, devices, and support follow-up attached to the same return surface.</p>
    @if (signedInBenefits.Length > 0)
    {
        <div class="trust-claim__microproof">
            @foreach (var overlay in signedInBenefits)
            {
                <span>@overlay.Title</span>
            }
        </div>
    }
    <div class="stacked-actions">
        <a class="cta-link cta-link--primary" href="@(Model.Chrome.Authenticated ? "/home" : "/signup?next=/home")">
            @(Model.Chrome.Authenticated ? "Open home" : "Create account")
        </a>
        @if (!Model.Chrome.Authenticated)
        {
            <a class="cta-link cta-link--secondary" href="/login?next=/home">Already have an account? Sign in</a>
        }
    </div>
</section>

<section class="evidence-tail">
    <p class="editorial-copy">Integrity stays visible. Use downloads when you are ready to install, and use the product story only when you need the broader fit and differentiation view.</p>
    <div class="stacked-actions">
        <a class="cta-link cta-link--primary" href="/downloads">Open downloads</a>
        <a class="cta-link cta-link--secondary" href="/what-is-chummer">Read the product story</a>
    </div>
</section>

@using Chummer.Run.Api.Services
@model PublicSignalOperationsDetailPageViewModel
@{
    ViewData["Title"] = Model.Detail.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-participate";
    var detail = Model.Detail;
    var routingReceipts = detail.RoutingReceipts.ToArray();
    var closeoutReceipts = detail.CloseoutReceipts.ToArray();
    var queueReceipts = detail.QueueReceipts.ToArray();
    var recipientThreads = detail.RecipientThreads.ToArray();
    var dispatchReceipts = detail.DispatchReceipts.ToArray();
    var deliveryOutcomes = detail.DeliveryOutcomes.ToArray();
    var journeyReceipts = detail.JourneyReceipts.ToArray();
    var savedPivots = detail.SavedPivots.ToArray();
    var sourceReceipt = detail.SourceReceipt;
    var totalThreadCount = savedPivots.FirstOrDefault(static pivot => string.Equals(pivot.Key, "all", StringComparison.Ordinal))?.Count ?? recipientThreads.Length;
    string AppendFilter(string baseHref, string filterKey)
        => string.Equals(filterKey, "all", StringComparison.Ordinal)
            ? baseHref
            : $"{baseHref}?filter={Uri.EscapeDataString(filterKey)}";
    string AppendCurrentFilter(string baseHref)
        => AppendFilter(baseHref, detail.FilterApplied ? detail.FilterKey : "all");
    string ResolveSourceContextFilterKey(string fallbackFilterKey)
        => detail.FilterApplied ? detail.FilterKey : fallbackFilterKey;
    string SourceDetailHref(string sourceReceiptId, string fallbackFilterKey = "all")
        => AppendFilter($"/feedback/operations/source/{Uri.EscapeDataString(sourceReceiptId)}", ResolveSourceContextFilterKey(fallbackFilterKey));
    string SourceArtifactHref(string sourceReceiptId, string fallbackFilterKey = "all")
        => AppendFilter($"/api/v1/public/feedback/operations/source/{Uri.EscapeDataString(sourceReceiptId)}", ResolveSourceContextFilterKey(fallbackFilterKey));
    string PublicFeedbackText(string? value)
        => PublicFacingCopyHumanizer.Clean(value)
            .Replace("source item", "original item", StringComparison.OrdinalIgnoreCase)
            .Replace("source details", "related details", StringComparison.OrdinalIgnoreCase)
            .Replace("source", "related", StringComparison.OrdinalIgnoreCase)
            .Replace("record(s)", "update(s)", StringComparison.OrdinalIgnoreCase)
            .Replace("records", "updates", StringComparison.OrdinalIgnoreCase)
            .Replace("record", "update", StringComparison.OrdinalIgnoreCase);
    string SourceDetailActionLabel(string fallbackFilterKey, string fallbackFilterLabel)
        => detail.FilterApplied
            ? "Open related details with same filter"
            : !string.Equals(fallbackFilterKey, "all", StringComparison.Ordinal)
                ? $"Open {PublicFeedbackText(fallbackFilterLabel).ToLowerInvariant()}"
                : "Open related details";
    string ThreadDetailHref(string dispatchReceiptId)
        => AppendCurrentFilter($"/feedback/operations/thread/{Uri.EscapeDataString(dispatchReceiptId)}");
    string ThreadArtifactHref(string dispatchReceiptId)
        => AppendCurrentFilter($"/api/v1/public/feedback/operations/thread/{Uri.EscapeDataString(dispatchReceiptId)}");
}

<section class="release-footnote route-anchor-target">
    <p class="eyebrow">@detail.Eyebrow</p>
    <h1 class="page-title">@detail.Heading</h1>
    <p class="page-copy">@detail.Summary</p>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="@detail.BackHref">@detail.BackLabel</a>
        <a class="button-like button-like--secondary" href="@detail.DetailArtifactHref">Download item data</a>
        <a class="button-like button-like--ghost" href="@detail.AggregateArtifactHref">Download summary</a>
        <a class="button-like button-like--ghost" href="/feedback/operations/lookup?q=@Uri.EscapeDataString(detail.DetailKey)">Search another item</a>
        @if (!string.IsNullOrWhiteSpace(detail.RelatedHref) && !string.IsNullOrWhiteSpace(detail.RelatedLabel))
        {
            <a class="button-like button-like--ghost" href="@detail.RelatedHref">@detail.RelatedLabel</a>
        }
    </div>
    <p class="muted-copy">@detail.DetailKindLabel · @detail.DetailKeyLabel: @detail.DetailKey</p>
</section>

@if (savedPivots.Length > 0)
{
    <section class="status-decision-strip" aria-label="Saved filters">
        @foreach (var pivot in savedPivots)
        {
            <article class="status-decision-strip__card">
                <span class="tag">@(pivot.Current ? "Current filter" : "Saved filter")</span>
                <h2>@pivot.Label · @pivot.Count thread@(pivot.Count == 1 ? string.Empty : "s")</h2>
                <p>@pivot.Summary</p>
                <div class="stacked-actions">
                    <a class="button-like @(pivot.Current ? "button-like--primary" : "button-like--secondary")" href="@pivot.Href">
                        @(pivot.Current ? "Viewing this filter" : "Open this filter")
                    </a>
                    <a class="button-like button-like--ghost" href="@pivot.ArtifactHref">Open filter details</a>
                </div>
            </article>
        }
    </section>
}

<section class="status-decision-strip" aria-label="Activity summary">
    <article class="status-decision-strip__card">
        <span class="tag">Activity</span>
        <h2>@recipientThreads.Length recipient thread@(recipientThreads.Length == 1 ? string.Empty : "s") currently sit under this view.</h2>
        <p>@dispatchReceipts.Length message update@(dispatchReceipts.Length == 1 ? string.Empty : "s"), @deliveryOutcomes.Length delivery update@(deliveryOutcomes.Length == 1 ? string.Empty : "s"), and @journeyReceipts.Length follow-up update@(journeyReceipts.Length == 1 ? string.Empty : "s") are joined here.</p>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag">Follow-up status</span>
        <h2>@queueReceipts.Length follow-up item@(queueReceipts.Length == 1 ? string.Empty : "s") are attached to this view.</h2>
        <p>@closeoutReceipts.Length resolution update@(closeoutReceipts.Length == 1 ? string.Empty : "s") and @routingReceipts.Length routing update@(routingReceipts.Length == 1 ? string.Empty : "s") keep the next step visible.</p>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag">Private details</span>
        <h2>Raw delivery bodies stay out of Chummer storage.</h2>
        <p>This page only uses limited metadata, hashed recipient identity, and Chummer status.</p>
    </article>
</section>

@if (detail.FilterApplied)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Current filter</p>
            <h2 class="editorial-title">@detail.FilterLabel are currently isolated on this view.</h2>
            <p class="editorial-copy">The thread, message, outcome, and follow-up sections below are narrowed from @totalThreadCount total recipient thread@(totalThreadCount == 1 ? string.Empty : "s") to the filter you selected.</p>
        </div>
    </section>
}

@if (sourceReceipt is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Original item</p>
            <h2 class="editorial-title">The original item stays visible as the root of this view.</h2>
            <p class="editorial-copy">This keeps the public feedback item, category, and next action tied to the later message and follow-up state.</p>
        </div>
        <div class="route-choice-grid">
            <article class="route-choice-card">
                <span class="tag">@PublicFeedbackText(sourceReceipt.StatusLabel)</span>
                <h3>@PublicFeedbackText(sourceReceipt.CategoryLabel) · @sourceReceipt.ItemReference</h3>
                <p>@PublicFeedbackText(sourceReceipt.ActionLabel)</p>
                <div class="route-choice-card__details">
                    <span>@PublicFeedbackText(sourceReceipt.BoardLabel)</span>
                    <span>@PublicFeedbackText(sourceReceipt.EventType)</span>
                    <span>@sourceReceipt.ReceivedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                    <span>@PublicFeedbackText(sourceReceipt.HotFilterLabel) · @sourceReceipt.HotFilterCount thread@(sourceReceipt.HotFilterCount == 1 ? string.Empty : "s")</span>
                    @if (sourceReceipt.ProviderOccurredAtUtc is { } providerOccurredAtUtc)
                    {
                        <span>@providerOccurredAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                    }
                    @if (sourceReceipt.CloseoutCandidate)
                    {
                        <span>Ready for follow-up</span>
                    }
                    else
                    {
                        <span>No follow-up needed</span>
                    }
                    @if (sourceReceipt.VoterNotificationAllowed)
                    {
                        <span>Voter follow-up allowed</span>
                    }
                    else
                    {
                        <span>Voter follow-up blocked</span>
                    }
                </div>
                @if (!detail.FilterApplied)
                {
                    <p class="muted-copy">@PublicFeedbackText(sourceReceipt.HotFilterSummary)</p>
                }
                <div class="stacked-actions">
                    <a class="button-like button-like--secondary" href="@SourceDetailHref(sourceReceipt.ReceiptId, sourceReceipt.HotFilterKey)">@SourceDetailActionLabel(sourceReceipt.HotFilterKey, sourceReceipt.HotFilterLabel)</a>
                    <a class="button-like button-like--ghost" href="@SourceArtifactHref(sourceReceipt.ReceiptId, sourceReceipt.HotFilterKey)">Download related data</a>
                </div>
            </article>
        </div>
    </section>
}

@if (routingReceipts.Length > 0 || closeoutReceipts.Length > 0 || queueReceipts.Length > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Activity</p>
            <h2 class="editorial-title">Routing, follow-up status, and message readiness stay clear before anything is sent.</h2>
            <p class="editorial-copy">This keeps voter follow-up and send status on the same page as the later delivery timeline, including recipient threads, message updates, outcome updates, follow-up, and saved filters.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var receipt in routingReceipts)
            {
                <article class="route-choice-card">
                    <span class="tag">@PublicFeedbackText(receipt.StatusLabel)</span>
                    <h3>@PublicFeedbackText(receipt.RouteKind)</h3>
                    <p>@PublicFeedbackText(receipt.Summary)</p>
                    <div class="route-choice-card__details">
                        <span>@receipt.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        <span>@PublicFeedbackText(receipt.SourceHotFilterLabel) · @receipt.SourceHotFilterCount thread@(receipt.SourceHotFilterCount == 1 ? string.Empty : "s")</span>
                    </div>
                    @if (!detail.FilterApplied)
                    {
                        <p class="muted-copy">@PublicFeedbackText(receipt.SourceHotFilterSummary)</p>
                    }
                    <div class="stacked-actions">
                        <a class="button-like button-like--secondary" href="@SourceDetailHref(receipt.SourceReceiptId, receipt.SourceHotFilterKey)">@SourceDetailActionLabel(receipt.SourceHotFilterKey, receipt.SourceHotFilterLabel)</a>
                        <a class="button-like button-like--ghost" href="@SourceArtifactHref(receipt.SourceReceiptId, receipt.SourceHotFilterKey)">Download related data</a>
                    </div>
                </article>
            }
            @foreach (var receipt in closeoutReceipts)
            {
                <article class="route-choice-card">
                    <span class="tag">@PublicFeedbackText(receipt.StatusLabel)</span>
                    <h3>Resolution @PublicFeedbackText(receipt.DeliveryState)</h3>
                    <p>@PublicFeedbackText(receipt.Summary)</p>
                    <div class="route-choice-card__details">
                        <span>@receipt.RecipientScopeCount projected recipient@(receipt.RecipientScopeCount == 1 ? string.Empty : "s")</span>
                        <span>@receipt.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        <span>@PublicFeedbackText(receipt.SourceHotFilterLabel) · @receipt.SourceHotFilterCount thread@(receipt.SourceHotFilterCount == 1 ? string.Empty : "s")</span>
                        @if (!receipt.PublicClaimAllowed)
                        {
                            <span>Not public</span>
                        }
                    </div>
                    @if (!detail.FilterApplied)
                    {
                        <p class="muted-copy">@PublicFeedbackText(receipt.SourceHotFilterSummary)</p>
                    }
                    <div class="stacked-actions">
                        <a class="button-like button-like--secondary" href="@SourceDetailHref(receipt.SourceReceiptId, receipt.SourceHotFilterKey)">@SourceDetailActionLabel(receipt.SourceHotFilterKey, receipt.SourceHotFilterLabel)</a>
                        <a class="button-like button-like--ghost" href="@SourceArtifactHref(receipt.SourceReceiptId, receipt.SourceHotFilterKey)">Download related data</a>
                    </div>
                </article>
            }
            @foreach (var receipt in queueReceipts)
            {
                <article class="route-choice-card">
                    <span class="tag">@PublicFeedbackText(receipt.StatusLabel)</span>
                    <h3>@PublicFeedbackText(receipt.QueueLane)</h3>
                    <p>@PublicFeedbackText(receipt.Summary)</p>
                    <p class="muted-copy">@PublicFeedbackText(receipt.QueueReason)</p>
                    <div class="route-choice-card__details">
                        <span>@PublicFeedbackText(receipt.QueueState)</span>
                        <span>@receipt.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        <span>@PublicFeedbackText(receipt.SourceHotFilterLabel) · @receipt.SourceHotFilterCount thread@(receipt.SourceHotFilterCount == 1 ? string.Empty : "s")</span>
                        @if (receipt.ReadyForOutbox)
                        {
                            <span>Ready to send</span>
                        }
                        else
                        {
                            <span>Send blocked</span>
                        }
                    </div>
                    @if (!detail.FilterApplied)
                    {
                        <p class="muted-copy">@PublicFeedbackText(receipt.SourceHotFilterSummary)</p>
                    }
                    <div class="stacked-actions">
                        <a class="button-like button-like--secondary" href="@SourceDetailHref(receipt.SourceReceiptId, receipt.SourceHotFilterKey)">@SourceDetailActionLabel(receipt.SourceHotFilterKey, receipt.SourceHotFilterLabel)</a>
                        <a class="button-like button-like--ghost" href="@SourceArtifactHref(receipt.SourceReceiptId, receipt.SourceHotFilterKey)">Download related data</a>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (detail.FilterApplied && recipientThreads.Length == 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Filtered result</p>
            <h2 class="editorial-title">No @detail.FilterLabel.ToLowerInvariant() remain under this filtered view.</h2>
            <p class="editorial-copy">Use the saved filters above to reopen the full original item or jump straight to another filtered state without leaving this page.</p>
        </div>
    </section>
}

@if (recipientThreads.Length > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Recipient threads</p>
            <h2 class="editorial-title">The message history, latest outcome update, and follow-up detail now sit on one recipient timeline.</h2>
            <p class="editorial-copy">This is the compact activity view for one or more recipient threads that belong to the selected item or message history.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var thread in recipientThreads)
            {
                <article class="route-choice-card">
                    <span class="tag">@PublicFeedbackText(thread.CurrentStageLabel)</span>
                    <h3>Recipient thread</h3>
                    <p>@PublicFeedbackText(thread.Summary)</p>
                    <div class="route-choice-card__details">
                        <span>@PublicFeedbackText(thread.SourceLabel)</span>
                        <span>@PublicFeedbackText(thread.QueueStatusLabel)</span>
                        <span>@PublicFeedbackText(thread.DispatchStatusLabel)</span>
                        @if (!string.IsNullOrWhiteSpace(thread.OutcomeStatusLabel))
                        {
                            <span>@PublicFeedbackText(thread.OutcomeStatusLabel)</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(thread.JourneyStatusLabel))
                        {
                            <span>@PublicFeedbackText(thread.JourneyStatusLabel)</span>
                        }
                        <span>@thread.LastTouchedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        @if (!thread.PublicClaimAllowed)
                        {
                            <span>Not public</span>
                        }
                    </div>
                    <div class="stacked-actions">
                        <a class="button-like button-like--secondary" href="@ThreadDetailHref(thread.DispatchReceiptId)">Open thread details</a>
                        <a class="button-like button-like--ghost" href="@ThreadArtifactHref(thread.DispatchReceiptId)">Download thread data</a>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (dispatchReceipts.Length > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Message updates</p>
            <h2 class="editorial-title">Every outbound message attempt stays visible.</h2>
            <p class="editorial-copy">This keeps send status, suppression state, retry timing, and delivery identity aligned to one message view.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var receipt in dispatchReceipts)
            {
                <article class="route-choice-card">
                    <span class="tag">@PublicFeedbackText(receipt.StatusLabel)</span>
                    <h3>Message attempt · @PublicFeedbackText(receipt.DeliveryState)</h3>
                    <p>@PublicFeedbackText(receipt.Summary)</p>
                    @if (!string.IsNullOrWhiteSpace(receipt.Error))
                    {
                        <p class="muted-copy">@PublicFeedbackText(receipt.Error)</p>
                    }
                    <div class="route-choice-card__details">
                        <span>@receipt.RequestedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        @if (receipt.AcceptedAtUtc is { } acceptedAtUtc)
                        {
                            <span>@acceptedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(receipt.LastProviderState))
                        {
                            <span>@PublicFeedbackText(receipt.LastProviderState)</span>
                        }
                        @if (receipt.NextAutomaticRetryAtUtc is { } nextAutomaticRetryAtUtc)
                        {
                            <span>@nextAutomaticRetryAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        }
                        @if (!receipt.PublicClaimAllowed)
                        {
                            <span>Not public</span>
                        }
                    </div>
                    <div class="stacked-actions">
                        <a class="button-like button-like--secondary" href="@ThreadDetailHref(receipt.ReceiptId)">Open thread details</a>
                        <a class="button-like button-like--ghost" href="@ThreadArtifactHref(receipt.ReceiptId)">Download thread data</a>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (deliveryOutcomes.Length > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Delivery updates</p>
            <h2 class="editorial-title">Delivery updates stay clear and attributable.</h2>
            <p class="editorial-copy">Identity match mode, recipient matching, and delivery state stay visible without storing raw delivery bodies.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var receipt in deliveryOutcomes)
            {
                <article class="route-choice-card">
                    <span class="tag">@PublicFeedbackText(receipt.StatusLabel)</span>
                    <h3>Delivery update · @PublicFeedbackText(receipt.ProviderState)</h3>
                    <p>@PublicFeedbackText(receipt.Summary)</p>
                    @if (!string.IsNullOrWhiteSpace(receipt.Reason))
                    {
                        <p class="muted-copy">@PublicFeedbackText(receipt.Reason)</p>
                    }
                    <div class="route-choice-card__details">
                        <span>@PublicFeedbackText(receipt.IdentityMatchMode)</span>
                        <span>@receipt.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        <span>@receipt.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        @if (receipt.RetryAtUtc is { } retryAtUtc)
                        {
                            <span>@retryAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        }
                        @if (!receipt.PublicClaimAllowed)
                        {
                            <span>Private outcome</span>
                        }
                    </div>
                    <div class="stacked-actions">
                        <a class="button-like button-like--secondary" href="@ThreadDetailHref(receipt.DispatchReceiptId)">Open thread details</a>
                        <a class="button-like button-like--ghost" href="@ThreadArtifactHref(receipt.DispatchReceiptId)">Download thread data</a>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (journeyReceipts.Length > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Follow-up</p>
            <h2 class="editorial-title">Follow-up detail only appears after the message timeline completes.</h2>
            <p class="editorial-copy">These rows show voter notifications tied to the same review decision and release status used by the message timeline.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var receipt in journeyReceipts)
            {
                <article class="route-choice-card">
                    <span class="tag">@PublicFeedbackText(receipt.StatusLabel)</span>
                    <h3>Follow-up sent</h3>
                    <p>@PublicFeedbackText(receipt.Summary)</p>
                    <div class="route-choice-card__details">
                        <span>@receipt.SentCount of @receipt.RecipientCount sent</span>
                        <span>@receipt.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        <span>@PublicFeedbackText(receipt.SourceHotFilterLabel) · @receipt.SourceHotFilterCount thread@(receipt.SourceHotFilterCount == 1 ? string.Empty : "s")</span>
                        @if (!receipt.PublicClaimAllowed)
                        {
                            <span>Not public</span>
                        }
                    </div>
                    @if (!detail.FilterApplied)
                    {
                        <p class="muted-copy">@PublicFeedbackText(receipt.SourceHotFilterSummary)</p>
                    }
                    <div class="stacked-actions">
                        <a class="button-like button-like--secondary" href="@SourceDetailHref(receipt.SourceReceiptId, receipt.SourceHotFilterKey)">@SourceDetailActionLabel(receipt.SourceHotFilterKey, receipt.SourceHotFilterLabel)</a>
                        <a class="button-like button-like--ghost" href="@SourceArtifactHref(receipt.SourceReceiptId, receipt.SourceHotFilterKey)">Download related data</a>
                    </div>
                </article>
            }
        </div>
    </section>
}

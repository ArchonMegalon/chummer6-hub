                                                                    @if (!string.IsNullOrWhiteSpace(leadCommunityBoard.CampaignMemoryReturnSummary))
                                                                    {
                                                                        <span> Return: @leadCommunityBoard.CampaignMemoryReturnSummary</span>
                                                                    }
                                                                }
                                                                <span> League: @leadCommunityOperation.LeagueOperationsSummary</span>
                                                                <span> Invites: @(leadCommunityOperation.RecentJoinCodes.Count == 0 && leadCommunityOperation.RecentBoostCodes.Count == 0 ? "issue member and sponsor entry from one shared view." : $"{leadCommunityOperation.RecentJoinCodes.Count} join code(s) and {leadCommunityOperation.RecentBoostCodes.Count} sponsor code(s) stay in the same view.")</span>
                                                                @if (leadCommunitySponsorSession is not null)
                                                                {
                                                                    <span> Sponsors: @leadCommunitySponsorSession.UserDisplayName on @leadCommunitySponsorSession.CampaignName. @leadCommunitySponsorSession.StatusSummary.</span>
                                                                }
                                                                <span> Guide: release notes, downloads, and support stay on the same view.</span>
                                                                <span> Access now: @TrustRowValue(Model.SignedInStatus, "Who can get it now", "Open what works today for the latest availability.")</span>
                                                                <span> Fix: @TrustRowValue(Model.SignedInStatus, "Fix availability", "Open what works today for the latest fix status.")</span>
                                                                <span> Caution: @TrustRowValue(Model.SignedInStatus, "Current caution", "Open what works today for the latest notes.")</span>
                                                                @if (leadCommunityTransfer is not null)
                                                                {
                                                                    <span> Latest move: @leadCommunityTransfer.RunnerHandle.</span>
                                                                }
                                                                @if (leadCommunityOperation.Watchouts.Count > 0)
                                                                {
                                                                    <span> Needs attention: @leadCommunityOperation.Watchouts[0]</span>
                                                                }
                                                            </p>
                                                        </div>
                                                        <div class="stacked-actions">
                                                            <a class="inline-link" href="@leadCommunityLeagueHref">Open league tools</a>
                                                            <a class="inline-link" href="@leadCommunityBoardHref">Open season board</a>
                                                            <a class="inline-link" href="@leadCommunityInviteHref">Open invite tools</a>
                                                            <a class="inline-link" href="@leadCommunitySponsorHref">Open sponsor tools</a>
                                                            <a class="inline-link" href="@leadCommunityGuidanceHref">Open member guidance</a>
                                                        </div>
                                                    </article>
                                                }

                                                <article class="app-rail__item">
                                                    <span class="tag">GM prep</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@PublicText(leadWorkspaceServerPlane.PrepLibrary.Summary)</h3>
                                                        <p>
                                                            @PublicText(leadWorkspaceServerPlane.TravelMode.Summary)
                                                            @if (leadPrepLaunch is not null)
                                                            {
                                                                <span> Latest launch: @PublicText(leadPrepLaunch.PacketTitle)@(string.IsNullOrWhiteSpace(leadPrepLaunch.TargetRunTitle) ? string.Empty : $" for {PublicText(leadPrepLaunch.TargetRunTitle)}").</span>
                                                            }
                                                            @if (leadTravelPrefetch is not null)
                                                            {
                                                                <span> Latest travel setup: @PublicText(leadTravelPrefetch.DeviceRole) on @PublicText(leadTravelPrefetch.Platform).</span>
                                                            }
                                                            <span> Search: @PublicText(leadWorkspaceServerPlane.PrepLibrary.SearchSummary)</span>
                                                            <span> Safehouse / travel mode: @PublicText(leadWorkspaceServerPlane.TravelMode.PrefetchInventorySummary).</span>
                                                        </p>
                                                    </div>
                                                    <a class="inline-link" href="@($"/account/work/workspaces/{Uri.EscapeDataString(leadWorkspaceServerPlane.Workspace.WorkspaceId)}")">Open prep and travel</a>
                                                </article>
                                            }

                                            @if (buildHandoffs.Length == 0 && rulesAnswers.Length == 0)
                                            {
                                                <article class="app-rail__item">
                                                    <span class="tag">Build setup</span>
                                                    <div class="app-rail__copy">
                                                        <h3>Continuity is ready for the first build setup</h3>
                                                        <p>Your next build comparison and rules answer will land here once the first dossier or campaign return is seeded.</p>
                                                    </div>
                                                    <a class="inline-link" href="@ContextualPreviewHref("/downloads")">Start from downloads</a>
                                                </article>
                                            }
                                            else
                                            {
                                                @if (buildHandoffs.Length > 0)
                                                {
                                                    var handoff = buildHandoffs[0];
                                                    <article class="app-rail__item">
                                                        <span class="tag">Build setup</span>
                                                        <div class="app-rail__copy">
                                                            <h3>@PublicText(handoff.Title)</h3>
                                                            <p>
                                                                @PublicText(handoff.Summary)
                                                                @if (!string.IsNullOrWhiteSpace(handoff.NextSafeAction))
                                                                {
                                                                    <span> Next: @PublicText(handoff.NextSafeAction).</span>
                                                                }
                                                                else if (handoff.ProgressionOutcomes.Count > 0)
                                                                {
                                                                    <span> Next: @PublicText(handoff.ProgressionOutcomes[0]).</span>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(handoff.CampaignReturnSummary))
                                                                {
                                                                    <span> Return: @PublicText(handoff.CampaignReturnSummary).</span>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(handoff.PlannerCoverageSummary))
                                                                {
                                                                    <span> Coverage: @PublicText(handoff.PlannerCoverageSummary).</span>
                                                                }
                                                                @if (handoff.PlannerCoverageLines is { Count: > 0 })
                                                                {
                                                                    foreach (var plannerLine in handoff.PlannerCoverageLines.Take(2))
                                                                    {
                                                                        <span> Planner note: @PublicText(plannerLine)</span>
                                                                    }
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(handoff.CrewFitSummary))
                                                                {
                                                                    <span> Crew fit: @PublicText(handoff.CrewFitSummary).</span>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(handoff.ConditionalStateSummary))
                                                                {
                                                                    <span> Current conditions: @PublicText(handoff.ConditionalStateSummary).</span>
                                                                }
                                                                @if (handoff.ConditionalStateLines is { Count: > 0 })
                                                                {
                                                                    foreach (var conditionalLine in handoff.ConditionalStateLines.Take(2))
                                                                    {
                                                                        <span> Conditional note: @PublicText(conditionalLine)</span>
                                                                    }
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(handoff.SourceHintSummary))
                                                                {
                                                                    <span> Helpful notes: @PublicText(handoff.SourceHintSummary).</span>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(handoff.BuildSurfaceSummary))
                                                                {
                                                                    <span> Builder view: @PublicText(handoff.BuildSurfaceSummary).</span>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(handoff.ExchangeParitySummary))
                                                                {
                                                                    <span> Import/export fit: @PublicText(handoff.ExchangeParitySummary).</span>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(handoff.PortabilityPillarSummary))
                                                                {
                                                                    <span> Portability: @PublicText(handoff.PortabilityPillarSummary).</span>
                                                                }
                                                                @if (handoff.SourceHintLines is { Count: > 0 })
                                                                {
                                                                    foreach (var sourceHintLine in handoff.SourceHintLines.Take(2))
                                                                    {
                                                                        <span> Hint: @PublicText(sourceHintLine)</span>
                                                                    }
                                                                }
                                                                @if (handoff.BuildSurfaceLines is { Count: > 0 })
                                                                {
                                                                    foreach (var buildSurfaceLine in handoff.BuildSurfaceLines.Take(2))
                                                                    {
                                                                        <span> Build note: @PublicText(buildSurfaceLine)</span>
                                                                    }
                                                                }
                                                                @if (handoff.ExchangeParityLines is { Count: > 0 })
                                                                {
                                                                    foreach (var parityLine in handoff.ExchangeParityLines.Take(2))
                                                                    {
                                                                        <span> Parity note: @PublicText(parityLine)</span>
                                                                    }
                                                                }
                                                                @if (handoff.PortabilityPillarLines is { Count: > 0 })
                                                                {
                                                                    foreach (var portabilityLine in handoff.PortabilityPillarLines.Take(2))
                                                                    {
                                                                        <span> Portability note: @PublicText(portabilityLine)</span>
                                                                    }
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(handoff.SupportClosureSummary))
                                                                {
                                                                    <span> Support: @PublicText(handoff.SupportClosureSummary).</span>
                                                                }
                                                                @if (handoff.RuleEnvironmentDiff is not null)
                                                                {
                                                                    <span> Rules change: @handoff.RuleEnvironmentDiff.BeforeFingerprint -> @handoff.RuleEnvironmentDiff.AfterFingerprint (@handoff.RuleEnvironmentDiff.Status).</span>
                                                                    <span> Rules scope: @handoff.RuleEnvironmentDiff.BeforeScope -> @handoff.RuleEnvironmentDiff.AfterScope.</span>
                                                                }
                                                                @if (handoff.Outputs.Count > 0)
                                                                {
                                                                    <span> Outputs: @string.Join(", ", handoff.Outputs.Take(8).Select(item => PublicText(item.Label))).</span>
                                                                    @if (handoff.Outputs.Count > 8)
                                                                    {
                                                                        <span> More next steps: +@(handoff.Outputs.Count - 8) additional guided items.</span>
                                                                    }
                                                                    foreach (var output in handoff.Outputs.Take(8))
                                                                    {
                                                                        @if (!string.IsNullOrWhiteSpace(output.NextSafeAction))
                                                                        {
                                                                            <span> Output next: @PublicText(output.NextSafeAction).</span>
                                                                        }
                                                                        @if (!string.IsNullOrWhiteSpace(output.ProvenanceSummary))
                                                                        {
                                                                            <span> Output details: @PublicFacingCopyHumanizer.Clean(output.ProvenanceSummary).</span>
                                                                        }
                                                                        <span> Output type: @BuildLabOutputLaneLabel(output.Kind).</span>
                                                                        @if (!string.IsNullOrWhiteSpace(output.PublicationSummary))
                                                                        {
                                                                            <span> Output publication: @PublicText(output.PublicationSummary).</span>
                                                                        }
                                                                        @if (!string.IsNullOrWhiteSpace(output.PublicationState) || !string.IsNullOrWhiteSpace(output.TrustBand))
                                                                        {
                                                                            <span> Output status: @HumanizeStatus(output.PublicationState, "Ready") / @HumanizeStatus(output.TrustBand, "Ready").</span>
                                                                        }
                                                                        @if (!string.IsNullOrWhiteSpace(output.AuditSummary))
                                                                        {
                                                                            <span> Output note: @PublicText(output.AuditSummary).</span>
                                                                        }
                                                                        @if (!string.IsNullOrWhiteSpace(output.CompatibilitySummary))
                                                                        {
                                                                            <span> Output compatibility: @PublicText(output.CompatibilitySummary).</span>
                                                                        }
                                                                        @if (!string.IsNullOrWhiteSpace(output.LineageSummary))
                                                                        {
                                                                            <span> Output lineage: @PublicText(output.LineageSummary).</span>
                                                                        }
                                                                    }
                                                                }
                                                                @if (handoff.Watchouts is { Count: > 0 })
                                                                {
                                                                    <span> Needs attention: @PublicText(handoff.Watchouts[0])</span>
                                                                }
                                                            </p>
                                                        </div>
                                                        <a class="inline-link" href="@($"/account/work/build-handoffs/{Uri.EscapeDataString(handoff.HandoffId)}")">Open build path for @PublicText(handoff.Title)</a>
                                                    </article>
                                                }
                                                @if (rulesAnswers.Length > 0)
                                                {
                                                    var answer = rulesAnswers[0];
                                                    <article class="app-rail__item">
                                                        <span class="tag">Rule answer</span>
                                                        <div class="app-rail__copy">
                                                            <h3>@PublicText(answer.Question)</h3>
                                                            <p>
                                                                @PublicText(answer.ShortAnswer)
                                                                <span> Details: @PublicFacingCopyHumanizer.Clean(answer.ProvenanceLabel).</span>
                                                                @if (answer.EvidenceLines.Count > 0)
                                                                {
                                                                    <span> Note: @PublicText(answer.EvidenceLines[0])</span>
                                                                }
                                                                @if (answer.Studio is not null)
                                                                {
                                                                    <span> Lifecycle: @PublicText(answer.Studio.CurrentStageLabel) -> @PublicText(answer.Studio.PromotionTargetLabel).</span>
                                                                    <span> Rollback: @PublicText(answer.Studio.RollbackSummary).</span>
                                                                }
                                                                @if (answer.Diffs is { Count: > 0 })
                                                                {
                                                                    <span> Change: @PublicText(answer.Diffs[0].Label) -> @PublicText(answer.Diffs[0].AfterSummary)</span>
                                                                }
                                                                @if (answer.SupportReuseHints.Count > 0)
                                                                {
                                                                    <span> Support note: @PublicText(answer.SupportReuseHints[0])</span>
                                                                }
                                                            </p>
                                                        </div>
                                                        <a class="inline-link" href="@($"/account/work/rules/{Uri.EscapeDataString(answer.EntryId)}")">Open rule context</a>
                                                    </article>
                                                }
                                            }
                                            <article class="app-rail__item">
                                                <span class="tag">Support</span>
                                                <div class="app-rail__copy">
                                                    <h3>Need a real answer instead?</h3>
                                                    <p>Use support when release, device, or return-path surfaces stop being enough to move forward confidently.</p>
                                                </div>
                                                <a class="inline-link" href="/account/support">Open support</a>
                                            </article>
                                            @if (migrationReceipts.Length > 0)
                                            {
                                                var migration = migrationReceipts[0];
                                                var leadField = migration.Fields.FirstOrDefault();
                                                <article class="app-rail__item">
                                                    <span class="tag">Migration return</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@PublicText(migration.Summary)</h3>
                                                        <p>
                                                            @if (leadField is null)
                                                            {
                                                                <span>Legacy import stayed attached to the same account return path.</span>
                                                            }
                                                            else
                                                            {
                                                                <span>@PublicText(leadField.Label): @PublicText(leadField.Summary)</span>
                                                            }
                                                        </p>
                                                    </div>
                                                    <a class="inline-link" href="/account/work">Open migration return</a>
                                                </article>
                                            }
                                            @if (creatorPublications.Length > 0)
                                            {
                                                var publication = creatorPublications[0];
                                                <article class="app-rail__item">
                                                    <span class="tag">Publication status</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@PublicText(publication.Title)</h3>
                                                        <p>
                                                            @PublicText(publication.Summary)
                                                            <span>Details: @PublicFacingCopyHumanizer.Clean(publication.ProvenanceSummary).</span>
                                                            <span>Visibility: @HumanizeStatus(publication.Visibility, "Shared").</span>
                                                            <span>Status: @HumanizeStatus(publication.TrustBand, "Draft").</span>
                                                            <span>Discovery: @PublicText(publication.DiscoverySummary)</span>
                                                            @if (!string.IsNullOrWhiteSpace(publication.TrustSummary))
                                                            {
                                                                <span> Status: @PublicText(publication.TrustSummary)</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(publication.ComparisonSummary))
                                                            {
                                                                <span> Compare by: @PublicText(publication.ComparisonSummary)</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(publication.LineageSummary))
                                                            {
                                                                <span> Lineage: @PublicText(publication.LineageSummary)</span>
                                                            }
                                                            <span>Available now: @(publication.Discoverable ? "Eligible now" : "Limited").</span>
                                                            <span>State: @HumanizeStatus(publication.PublicationStatus, "Published").</span>
                                                            @if (!string.IsNullOrWhiteSpace(publication.NextSafeAction))
                                                            {
                                                                <span> Next: @PublicText(publication.NextSafeAction).</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(publication.CampaignReturnSummary))
                                                            {
                                                                <span> Return: @PublicText(publication.CampaignReturnSummary).</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(publication.SupportClosureSummary))
                                                            {
                                                                <span> Support: @PublicText(publication.SupportClosureSummary).</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(publication.ModerationSummary))
                                                            {
                                                                <span> Moderation: @PublicText(publication.ModerationSummary)</span>
                                                            }
                                                        </p>
                                                    </div>
                                                    <a class="inline-link" href="@CreatorPublicationHref(publication, publication.PublicationId)">@CreatorPublicationLinkLabel(publication)</a>
                                                    @if (!string.IsNullOrWhiteSpace(publication.BuildHandoffId))
                                                    {
                                                        <a class="inline-link" href="@($"/account/work/build-handoffs/{Uri.EscapeDataString(publication.BuildHandoffId)}")">Open build path for @PublicText(publication.Title)</a>
                                                    }
                                                </article>
                                            }
                                            @if (restoreDevices.Length > 0)
                                            {
                                                var device = restoreDevices[0];
                                                <article class="app-rail__item">
                                                    <span class="tag">Device return</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@PublicText(device.HostLabel)</h3>
                                                        <p>@PublicText(device.RestoreSummary) <span>Role: @PublicText(device.DeviceRole) on @PublicText(device.Platform).</span></p>
                                                    </div>
                                                    <a class="inline-link" href="/account/access">Open device return</a>
                                                </article>
                                            }
                                        </div>
                                    </details>
                                </div>
                </div>
            </section>
        }
        else if (showWorkSection)
        {
            <section class="release-footnote">
                <p class="eyebrow">Work</p>
                <h2 class="editorial-title">Finish setup before the work surfaces try to carry too much</h2>
                <p class="editorial-copy">The work view gets useful once Chummer has a stable identity, install path, and return path attached to the account.</p>
                <div class="stacked-actions">
                    <a class="button-like button-like--primary" href="/home/setup">Open setup</a>
                </div>
            </section>
        }

        @if (showSetupSection)
        {
            <section class="release-footnote">
                <p class="eyebrow">Setup</p>
                <h2 class="editorial-title">Finish the small setup flow, then come back to access and work</h2>
                <p class="editorial-copy">Profile, recovery, and update preferences live here so the rest of the account can stay calmer by default.</p>
                <div class="stacked-actions">
                    <button class="button-like button-like--primary" type="button" data-open-onboarding id="openSetupButton">@(showOnboarding ? "Complete setup" : "Open setup")</button>
                    <a class="button-like button-like--ghost" href="/account/profile">Open account settings instead</a>
                </div>
            </section>
        }
    </div>
</section>

<div class="onboarding-dialog" id="home-onboarding" role="dialog" aria-modal="true" aria-labelledby="onboarding-title" @(openSetupDialog ? "" : "hidden")>
    <div class="onboarding-dialog__panel">
        <div class="onboarding-dialog__topline">
            <div>
                <p class="eyebrow">Setup</p>
                <h2 id="onboarding-title">Finish the account basics</h2>
            </div>
            <button class="button-like button-like--ghost" type="button" data-close-onboarding>Close</button>
        </div>
        <div class="onboarding-steps">
            <span class="onboarding-step">1. About you</span>
            <span class="onboarding-step">2. What you're here for</span>
            <span class="onboarding-step">3. Backup and updates</span>
        </div>
        <div id="onboardingError" class="muted-copy" aria-live="polite"></div>
        <form id="onboardingForm" class="settings-form">
            <section data-step-panel="1">
                <p class="eyebrow">Step 1</p>
                <h2>Name and timezone</h2>
                <div class="field">
                    <label for="onboardingDisplayName">Display name</label>
                    <input id="onboardingDisplayName" value="@Model.User.DisplayName" />
                </div>
                <div class="field">
                    <label for="onboardingHandle">Handle</label>
                    <input id="onboardingHandle" value="@Model.User.Handle" />
                </div>
                <div class="field">
                    <label for="onboardingTimezone">Timezone</label>
                    <input id="onboardingTimezone" value="@Model.User.Timezone" />
                </div>
            </section>
            <section data-step-panel="2" hidden>
                <p class="eyebrow">Step 2</p>
                <h2>What you want from Chummer</h2>
                <div class="check-grid">
                    @{
                        var currentLanes = Model.Experience.LaneInterests.ToHashSet(StringComparer.OrdinalIgnoreCase);
                    }
                    <label class="check-row"><input type="checkbox" value="player" @(currentLanes.Contains("player") ? "checked" : null) /> <span>Player</span></label>
                    <label class="check-row"><input type="checkbox" value="gm" @(currentLanes.Contains("gm") ? "checked" : null) /> <span>GM</span></label>
                    <label class="check-row"><input type="checkbox" value="creator" @(currentLanes.Contains("creator") ? "checked" : null) /> <span>Creator</span></label>
                </div>
            </section>
            <section data-step-panel="3" hidden>
                <p class="eyebrow">Step 3</p>
                <h2>Backup sign-in and updates</h2>
                @if (googlePrimary)
                {
                    <div class="field">
                        <label for="onboardingRecoveryEmail">Recovery email</label>
                        <input id="onboardingRecoveryEmail" type="email" placeholder="runner@example.com" />
                    </div>
                }
                else
                {
                    <p class="muted-copy">Email already covers your primary sign-in. Link Google later if you want a faster one-click return path as well.</p>
                    <a class="button-like button-like--secondary" href="/auth/google/link?next=/home">Link Google</a>
                }
                <div class="check-grid">
                    <label class="check-row"><input id="onboardingFollow" type="checkbox" @(Model.Experience.FollowHorizons ? "checked" : null) /> <span>Follow roadmap updates</span></label>
                    <label class="check-row"><input id="onboardingBeta" type="checkbox" @(Model.Experience.BetaInterest ? "checked" : null) /> <span>Invite me to the right beta when it opens</span></label>
                </div>
            </section>
            <div class="stacked-actions">
                <button class="button-like button-like--ghost" type="button" data-onboarding-back hidden>Back</button>
                <button class="button-like button-like--primary" type="button" data-onboarding-next>Next</button>
                <button class="button-like button-like--primary" type="submit" data-onboarding-submit hidden>Finish</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
(() => {
  const ui = window.ChummerUi;
  const dialog = document.getElementById("home-onboarding");
  if (!dialog) return;
  const subjectId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.User.SubjectId));
  const panels = Array.from(dialog.querySelectorAll("[data-step-panel]"));
  const onboardingForm = dialog.querySelector("#onboardingForm");
  const nextButton = dialog.querySelector("[data-onboarding-next]");
  const backButton = dialog.querySelector("[data-onboarding-back]");
  const submitButton = dialog.querySelector("[data-onboarding-submit]");
  const openButtons = document.querySelectorAll("[data-open-onboarding]");
  const closeButtons = dialog.querySelectorAll("[data-close-onboarding]");
  const nodes = {
    error: document.getElementById("onboardingError"),
    setupState: document.getElementById("homeSetupState"),
    setupCopy: document.getElementById("homeSetupCopy"),
    interestState: document.getElementById("homeInterestState"),
    recoveryState: document.getElementById("homeRecoveryState"),
    recoveryCopy: document.getElementById("homeRecoveryCopy"),
    setupCardTitle: document.getElementById("setupCardTitle"),
    setupCardCopy: document.getElementById("setupCardCopy"),
    openSetupButton: document.getElementById("openSetupButton"),
    seedStarterWorkspaceButton: document.getElementById("seedStarterWorkspace"),
    starterWorkspaceNotice: document.getElementById("starterWorkspaceNotice")
  };
  let step = 0;

  const openDialog = () => { dialog.hidden = false; };
  const closeDialog = () => { dialog.hidden = true; };

  const showStep = (index) => {
    step = index;
    panels.forEach((panel, panelIndex) => panel.hidden = panelIndex !== index);
    backButton.hidden = index === 0;
    nextButton.hidden = index === panels.length - 1;
    submitButton.hidden = index !== panels.length - 1;
  };

  const updateAccountSummary = (preferencesPayload, recoveryRequested) => {
    const followCount = (preferencesPayload.followHorizons ? 1 : 0) + (preferencesPayload.betaInterest ? 1 : 0);
    ui.setText(nodes.setupState, "Ready");
    ui.setText(nodes.setupCopy, "Your basic account setup is already in place.");
    ui.setText(nodes.interestState, followCount === 0 ? "Quiet" : `${followCount} active`);

    if (recoveryRequested) {
      ui.setText(nodes.recoveryState, "Confirmation sent");
      ui.setText(nodes.recoveryCopy, "Open your email to confirm the backup sign-in path.");
    }

    ui.setText(nodes.setupCardTitle, "Review setup");
    ui.setText(nodes.setupCardCopy, "Open the setup sheet whenever you want to adjust profile, interests, or backup sign-in.");
    ui.setText(nodes.openSetupButton, "Open setup");
    nodes.openSetupButton.dataset.defaultLabel = "Open setup";
  };

  openButtons.forEach((button) => button.addEventListener("click", openDialog));
  closeButtons.forEach((button) => button.addEventListener("click", closeDialog));
  nextButton.addEventListener("click", () => showStep(Math.min(step + 1, panels.length - 1)));
  backButton.addEventListener("click", () => showStep(Math.max(step - 1, 0)));
  showStep(step);

  const setStarterWorkspaceNotice = (message) => {
    if (!nodes.starterWorkspaceNotice) return;
    ui.setNotice(nodes.starterWorkspaceNotice, message);
  };

  nodes.seedStarterWorkspaceButton?.addEventListener("click", async () => {
    try {
      await ui.withBusyState(nodes.seedStarterWorkspaceButton, "Starting session...", async () => {
        const payload = await ui.requestJson("/api/v1/campaign-spine/me/workspaces/starter", {
          method: "POST"
        });
        const workspaceId = payload?.WorkspaceId || payload?.workspaceId;
        if (typeof workspaceId === "string" && workspaceId.length > 0) {
          window.location.href = `/account/work/workspaces/${encodeURIComponent(workspaceId)}`;
          return;
        }

        setStarterWorkspaceNotice("Starter workspace is not ready yet. Open Account Work to continue.");
        window.location.href = "/account/work";
      });
    } catch (error) {
      setStarterWorkspaceNotice(ui.describeError(error, "Starter workspace could not be seeded right now."));
    }
  });

  onboardingForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    ui.clearNotice(nodes.error);
    try {
      await ui.withBusyState(submitButton, "Saving...", async () => {
        const laneInterests = Array.from(dialog.querySelectorAll("[data-step-panel='2'] input[type='checkbox']:checked")).map((input) => input.value);
        const recoveryField = document.getElementById("onboardingRecoveryEmail");
        const recoveryEmail = recoveryField?.value.trim() || "";

        await ui.requestJson("/api/v1/accounts/me/profile", {
          method: "POST",
          json: {
            subjectId,
            displayName: document.getElementById("onboardingDisplayName").value,
            handle: document.getElementById("onboardingHandle").value,
            timezone: document.getElementById("onboardingTimezone").value,
            visibility: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.User.Visibility))
          }
        });

        if (recoveryEmail.length > 0) {
          const recoveryPayload = await ui.requestJson("/api/v1/accounts/me/links/email/start", {
            method: "POST",
            json: {
              subjectId,
              email: recoveryEmail,
              nextPath: "/home"
            }
          });

          if (recoveryPayload.previewHref) {
            window.location.href = recoveryPayload.previewHref;
            return;
          }
        }

        const preferencesPayload = await ui.requestJson("/api/v1/accounts/me/preferences", {
          method: "POST",
          json: {
            subjectId,
            laneInterests,
            followHorizons: document.getElementById("onboardingFollow").checked,
            betaInterest: document.getElementById("onboardingBeta").checked,
            onboardingCompleted: true
          }
        });

        updateAccountSummary(preferencesPayload, recoveryEmail.length > 0);
        ui.setNotice(nodes.error, "Setup saved.");
        window.setTimeout(() => {
          closeDialog();
          ui.clearNotice(nodes.error);
        }, 900);
      });
    } catch (error) {
      ui.setNotice(nodes.error, ui.describeError(error, "Setup could not be saved right now."), true);
    }
  });
})();
</script>
}

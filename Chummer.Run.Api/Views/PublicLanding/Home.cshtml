@model HomePageViewModel
@{
    var pageTitle = Model.CurrentSection switch
    {
        "access" => "Home · Access",
        "work" => "Home · Work",
        "setup" => "Home · Setup",
        _ => "Home"
    };
    ViewData["Title"] = pageTitle;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-home";
    var showOnboarding = !Model.Experience.OnboardingCompleted;
    var googlePrimary = string.Equals(Model.Links.RecommendedPrimaryAuth, "google", StringComparison.OrdinalIgnoreCase);
    var followCount = (Model.Experience.FollowHorizons ? 1 : 0) + (Model.Experience.BetaInterest ? 1 : 0);
    var recoveryLinked = Model.Links.LinkedIdentities.Any(link => string.Equals(link.Provider, "email", StringComparison.OrdinalIgnoreCase));
    var claimedInstallations = Model.InstallLinking.ClaimedInstallations?.Count ?? 0;
    var activeAccessRights = Model.InstallLinking.ActiveGrants?.Count ?? 0;
    var pendingClaims = Model.InstallLinking.PendingClaimTickets.Count;
    var primaryActionTargetsSetup = string.Equals(Model.PrimaryAction.Href, "/home/setup", StringComparison.OrdinalIgnoreCase);
    var dossiers = Model.CampaignSpine.Dossiers.Take(3).ToArray();
    var campaigns = Model.CampaignSpine.Campaigns.Take(3).ToArray();
    var runs = Model.CampaignSpine.Runs.Take(3).ToArray();
    var workspaces = Model.CampaignSpine.Workspaces.Take(2).ToArray();
    var buildHandoffs = Model.CampaignSpine.BuildLabHandoffs.Take(2).ToArray();
    var rulesAnswers = Model.CampaignSpine.RulesNavigator.Take(2).ToArray();
    var migrationReceipts = Model.CampaignSpine.MigrationReceipts.Take(1).ToArray();
    var creatorPublications = Model.CampaignSpine.CreatorPublications.Take(1).ToArray();
    var restoreDevices = Model.CampaignSpine.Restore.ClaimedDevices.Take(1).ToArray();
    var leadCommunityOperation = Model.CampaignSpine.CommunityOperations.FirstOrDefault();
    var leadCommunityTransfer = leadCommunityOperation?.RecentRosterTransfers?.FirstOrDefault();
    var leadCommunityEvent = leadCommunityOperation?.RecentEventSummaries.FirstOrDefault();
    var leadCommunityBoard = leadCommunityOperation?.SeasonBoardEntries.FirstOrDefault();
    var leadCommunitySponsorSession = leadCommunityOperation?.RecentSponsorSessions.FirstOrDefault();
    var leadCommunityBoardHref = leadCommunityOperation is null
        ? "/account/work#community-ops"
        : $"/account/work#community-op-board-{Uri.EscapeDataString(leadCommunityOperation.GroupId)}";
    var leadCommunityLeagueHref = leadCommunityOperation is null
        ? "/account/work#community-ops"
        : $"/account/work#community-op-league-{Uri.EscapeDataString(leadCommunityOperation.GroupId)}";
    var leadCommunityInviteHref = leadCommunityOperation is null
        ? "/account/work#community-ops"
        : $"/account/work#community-op-invites-{Uri.EscapeDataString(leadCommunityOperation.GroupId)}";
    var leadCommunitySponsorHref = leadCommunityOperation is null
        ? "/account/work#community-ops"
        : $"/account/work#community-op-sponsor-sessions-{Uri.EscapeDataString(leadCommunityOperation.GroupId)}";
    var leadCommunityGuidanceHref = leadCommunityOperation is null
        ? "/account/work#community-ops"
        : $"/account/work#community-op-guidance-{Uri.EscapeDataString(leadCommunityOperation.GroupId)}";
    var leadWorkspaceServerPlane = Model.LeadWorkspaceServerPlane;
    var leadWorkspaceState = leadWorkspaceServerPlane?.WorkspaceState;
    var leadPortableExchangeNotice = leadWorkspaceServerPlane?.DecisionNotices.FirstOrDefault(notice => string.Equals(notice.Kind, "portable_exchange", StringComparison.OrdinalIgnoreCase));
    var leadFirstPlayableSession = leadWorkspaceServerPlane?.FirstPlayableSession;
    var leadFirstPlayableEvidence = leadFirstPlayableSession?.EvidenceLines.FirstOrDefault();
    var leadNextSessionCarryForward = leadWorkspaceServerPlane?.NextSessionCarryForward;
    var leadNextSessionEvidence = leadNextSessionCarryForward?.EvidenceLines.FirstOrDefault();
    var leadConsequence = leadWorkspaceServerPlane?.Consequences.FirstOrDefault();
    var leadConsequenceEvidence = leadConsequence?.EvidenceLines.FirstOrDefault();
    var leadRosterTransfer = leadWorkspaceServerPlane?.RosterTransfers.FirstOrDefault();
    var leadRosterAuditLine = leadRosterTransfer?.AuditLines.FirstOrDefault();
    var leadPrepLaunch = leadWorkspaceServerPlane?.PrepLaunches.FirstOrDefault();
    var leadTravelPrefetch = leadWorkspaceServerPlane?.TravelPrefetches.FirstOrDefault();
    var leadAftermathPackage = leadWorkspaceServerPlane?.AftermathPackages
        .FirstOrDefault(item => !string.Equals(item.PackageKind, "downtime_brief", StringComparison.OrdinalIgnoreCase));
    var leadAftermathTag = leadAftermathPackage?.PackageKind?.Trim().ToLowerInvariant() switch
    {
        "replay_timeline" => "Replay timeline",
        "after_action_report" => "After-action report",
        "session_recap" => "Aftermath recap",
        _ => "Aftermath package"
    };
    var leadAftermathRouteLabel = leadAftermathPackage?.PackageKind?.Trim().ToLowerInvariant() switch
    {
        "replay_timeline" => "Open replay and return",
        "after_action_report" => "Open aftermath report",
        _ => "Open aftermath and return"
    };
    var leadDowntimePackage = leadWorkspaceServerPlane?.AftermathPackages
        .FirstOrDefault(item => string.Equals(item.PackageKind, "downtime_brief", StringComparison.OrdinalIgnoreCase));
    var leadAftermathShelfEntry = leadWorkspaceServerPlane?.RecapShelf
        .FirstOrDefault(item => string.Equals(item.EntryId, leadAftermathPackage?.PackageId, StringComparison.OrdinalIgnoreCase))
        ?? leadWorkspaceServerPlane?.RecapShelf.FirstOrDefault();
    var leadAftermathCreatorPublication = !string.IsNullOrWhiteSpace(leadAftermathShelfEntry?.CreatorPublicationId)
        ? Model.CampaignSpine.CreatorPublications.FirstOrDefault(publication => string.Equals(publication.PublicationId, leadAftermathShelfEntry.CreatorPublicationId, StringComparison.OrdinalIgnoreCase))
        : null;
    var leadAftermathEvidence = leadAftermathPackage?.EvidenceLines.FirstOrDefault();
    var leadDowntimeEvidence = leadDowntimePackage?.EvidenceLines.FirstOrDefault();
    var leadCampaignMemory = leadWorkspaceServerPlane?.CampaignMemory;
    var leadCampaignMemoryEvidence = leadCampaignMemory?.EvidenceLines.FirstOrDefault();
    var restoreConflicts = Model.CampaignSpine.Restore.ConflictSummaries.Count;
    var releasedOrNotifiedCases = Model.SupportCaseSummaries
        .Where(item =>
            string.Equals(item.Case.Status, "released_to_reporter_channel", StringComparison.OrdinalIgnoreCase)
            || string.Equals(item.Case.Status, "user_notified", StringComparison.OrdinalIgnoreCase)
            || string.Equals(item.Case.Status, "fixed", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(item => item.Case.UpdatedAtUtc)
        .Take(2)
        .ToArray();
    var recentReceipts = Model.InstallLinking.RecentReceipts.Take(2).ToArray();
    var accessSurfaceReady = claimedInstallations > 0
        || activeAccessRights > 0
        || pendingClaims > 0
        || recentReceipts.Length > 0
        || restoreConflicts > 0
        || releasedOrNotifiedCases.Length > 0;
    var hasSeedableStarterWork = (claimedInstallations > 0 || pendingClaims > 0)
        && dossiers.Length == 0
        && campaigns.Length == 0
        && runs.Length == 0
        && workspaces.Length == 0
        && leadWorkspaceServerPlane is null;
    var workSurfaceReady = (claimedInstallations > 0 || pendingClaims > 0)
        && (dossiers.Length > 0
            || campaigns.Length > 0
            || runs.Length > 0
            || workspaces.Length > 0
            || leadWorkspaceServerPlane is not null
            || restoreDevices.Length > 0);
    var effectiveWorkSurfaceReady = workSurfaceReady || hasSeedableStarterWork;
    var showOverviewSection = string.Equals(Model.CurrentSection, "overview", StringComparison.OrdinalIgnoreCase);
    var showAccessSection = string.Equals(Model.CurrentSection, "access", StringComparison.OrdinalIgnoreCase);
    var showWorkSection = string.Equals(Model.CurrentSection, "work", StringComparison.OrdinalIgnoreCase);
    var showSetupSection = string.Equals(Model.CurrentSection, "setup", StringComparison.OrdinalIgnoreCase);
    var openSetupDialog = showOnboarding || showSetupSection;
    var heading = Model.CurrentSection switch
    {
        "access" => "Access and return",
        "work" => "Work",
        "setup" => "Finish setup",
        _ => $"Welcome back, {Model.User.DisplayName}"
    };
    var summary = Model.CurrentSection switch
    {
        "access" => "Keep install return, release posture, and support follow-up in one calmer route instead of searching the whole account surface.",
        "work" => "Pick up dossiers, active runs, and the next useful route without turning Home into a deeper work page.",
        "setup" => "Finish the short setup flow first, then come back to access and work with a steadier account.",
        _ => "Pick up where you left off: finish the basics, install the current preview, and keep track of what is opening next."
    };

    static string HumanizeStatus(string? value, string fallback = "Not connected")
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallback;
        }

        return value.Trim().ToLowerInvariant() switch
        {
            "active" => "Ready",
            "linked" => "Ready",
            "pending" => "Pending",
            "pending_verification" => "Verification sent",
            "verified" => "Verified",
            "published" => "Published",
            "campaign_approved" => "Campaign-approved",
            "sandbox" => "Sandbox",
            "approved" => "Approved",
            "self_service" => "Self-service",
            "current" => "Current",
            "next" => "Next",
            "completed" => "Completed",
            "review" => "Needs review",
            "warning" => "Needs attention",
            "attention" => "Needs attention",
            "ready" => "Ready",
            "revoked" => "Revoked",
            _ => System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(value.Replace('_', ' '))
        };
    }

    static string RuleEnvironmentLifecycleLabel(Chummer.Campaign.Contracts.RuleEnvironmentRef environment)
        => environment.ApprovalState.Trim().ToLowerInvariant() switch
        {
            "published" => "Published",
            "approved" => "Campaign-approved",
            "self_service" => "Sandbox",
            _ => HumanizeStatus(environment.ApprovalState, "Review")
        };

    static string RuleEnvironmentSummary(Chummer.Campaign.Contracts.RuleEnvironmentRef environment)
        => $"{environment.OwnerScope} scope · {environment.CompatibilityFingerprint} · {RuleEnvironmentLifecycleLabel(environment)}";

    static string TrustRowValue(
        SignedInTrustStatusPanelViewModel? panel,
        string label,
        string fallback)
        => panel?.Rows.FirstOrDefault(row => string.Equals(row.Label, label, StringComparison.Ordinal))?.Value ?? fallback;

    static bool IsDiscoverablePublicCreatorPublication(Chummer.Campaign.Contracts.CreatorPublicationProjection? publication)
        => publication is not null
            && publication.Discoverable
            && string.Equals(publication.PublicationStatus, "published", StringComparison.OrdinalIgnoreCase);

    static string CreatorPublicationHref(Chummer.Campaign.Contracts.CreatorPublicationProjection? publication, string publicationId)
        => IsDiscoverablePublicCreatorPublication(publication)
            ? $"/artifacts/publications/{Uri.EscapeDataString(publicationId)}"
            : $"/account/work/publications/{Uri.EscapeDataString(publicationId)}";

    static string CreatorPublicationLinkLabel(Chummer.Campaign.Contracts.CreatorPublicationProjection? publication)
        => IsDiscoverablePublicCreatorPublication(publication)
            ? "Open public publication"
            : "Open publication status";
}

<section class="home-command">
    <div class="home-command__intro">
        <p class="eyebrow">Home</p>
        <h1 class="page-title">@heading</h1>
        <p class="page-copy">@summary</p>
    </div>
    <nav class="account-nav" aria-label="Home sections">
        @foreach (var navItem in Model.Sections)
        {
            <a href="@navItem.Href" aria-current="@(navItem.Current ? "page" : "false")">@navItem.Label</a>
        }
    </nav>
</section>

<div class="sr-only" aria-hidden="true">
    @Html.AntiForgeryToken()
</div>

<section class="home-dashboard home-dashboard--focus">
    <div class="home-dashboard__main">
        @if (Model.SignedInStatus is not null)
        {
            @await Html.PartialAsync("~/Views/Shared/_SignedInTrustStatusPanel.cshtml", Model.SignedInStatus)
        }

        @if (showOverviewSection)
        {
            <div class="home-action-grid">
                <article class="app-action-card app-action-card--primary">
                    <span class="tag">@Model.PrimaryAction.Eyebrow</span>
                    <h2 id="setupCardTitle">@Model.PrimaryAction.Title</h2>
                    <p id="setupCardCopy">@Model.PrimaryAction.Summary</p>
                    @if (primaryActionTargetsSetup && showSetupSection)
                    {
                        <button class="button-like button-like--primary" type="button" data-open-onboarding id="openSetupButton">@Model.PrimaryAction.Label</button>
                    }
                    else
                    {
                        <a class="button-like button-like--primary" href="@Model.PrimaryAction.Href" id="openSetupButton">@Model.PrimaryAction.Label</a>
                    }
                </article>
                <article class="app-action-card">
                    <span class="tag">Current release</span>
                    <h2>Use the current preview</h2>
                    <p>See what changed, what is working today, and whether the current release is the right moment to install or update.</p>
                    <a class="button-like button-like--secondary" href="/now">Open current release</a>
                </article>
                <article class="app-action-card">
                    <span class="tag">Devices &amp; access</span>
                    <h2>Keep this copy connected</h2>
                    <p>Link this install, review access rights, and keep the claim path visible without digging through support copy.</p>
                    <a class="button-like button-like--ghost" href="/account/access">Open Devices &amp; access</a>
                </article>
            </div>
        }

        @if (showAccessSection && (!showOnboarding || accessSurfaceReady))
        {
            <section class="release-shelf release-shelf--manual">
                <div class="home-stream">
                                <div class="home-stream__column">
                                    <div class="home-stream__lead">
                                        <p class="eyebrow">Access</p>
                                        <h2 class="home-stream__title">What changed for you</h2>
                                        <p class="home-stream__summary">Support closure, install return, and release follow-up stay grouped so this route explains why something moved.</p>
                                    </div>
                                    <div class="app-rail">
                                        @if (releasedOrNotifiedCases.Length == 0 && recentReceipts.Length == 0 && restoreConflicts == 0)
                                        {
                                            <article class="app-rail__item">
                                                    <span class="tag">Calm</span>
                                                <div class="app-rail__copy">
                                                    <h3>No urgent follow-up</h3>
                                                    <p>This route does not see a fresh support closure, install handoff, or restore conflict right now.</p>
                                                </div>
                                                <a class="inline-link" href="/now">See what works today</a>
                                            </article>
                                        }
                                        else
                                        {
                                            @foreach (var supportCase in releasedOrNotifiedCases)
                                            {
                                                <article class="app-rail__item">
                                                    <span class="tag">@supportCase.StageLabel</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@supportCase.Case.Title</h3>
                                                        <p>@supportCase.ClosureSummary <span>Next: @supportCase.NextSafeAction</span></p>
                                                        <p class="muted-copy">@supportCase.ReleaseProgressSummary</p>
                                                        @if (!string.IsNullOrWhiteSpace(supportCase.AffectedInstallSummary))
                                                        {
                                                            <p class="muted-copy">@supportCase.AffectedInstallSummary</p>
                                                        }
                                                    </div>
                                                    <a class="inline-link" href="@supportCase.PrimaryActionHref">@supportCase.PrimaryActionLabel</a>
                                                </article>
                                            }
                                            @foreach (var receipt in recentReceipts)
                                            {
                                                <article class="app-rail__item">
                                                    <span class="tag">Install</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@receipt.ArtifactLabel</h3>
                                                        <p>@receipt.Version on @receipt.Channel is still attached to this account if you need to reconnect the copy later.</p>
                                                    </div>
                                                    <a class="inline-link" href="/account/access">Open Devices &amp; access</a>
                                                </article>
                                            }
                                            @if (restoreConflicts > 0)
                                            {
                                                <article class="app-rail__item">
                                                    <span class="tag">Return path</span>
                                                    <div class="app-rail__copy">
                                                        <h3>Campaign return needs confirmation</h3>
                                                        <p>@Model.CampaignSpine.Restore.ConflictSummaries[0]</p>
                                                    </div>
                                                    <a class="inline-link" href="/account/work">Review campaign return</a>
                                                </article>
                                            }
                                        }
                                    </div>
                                </div>

                                <div class="home-stream__column">
                                    <details class="details-drawer">
                                        <summary>Release and device state</summary>
                                        <div class="app-rail">
                                            <article class="app-rail__item">
                                                <span class="tag">Current release</span>
                                                <div class="app-rail__copy">
                                                    <h3>Use the current preview</h3>
                                                    <p>Review what changed, what is working today, and whether this is the right moment to install or update.</p>
                                                </div>
                                                <a class="inline-link" href="/now">Open current release</a>
                                            </article>
                                            <article class="app-rail__item">
                                                <span class="tag">Device state</span>
                                                <div class="app-rail__copy">
                                                    <h3>@(activeAccessRights > 0 ? $"{activeAccessRights} access right(s) active" : claimedInstallations > 0 ? $"{claimedInstallations} linked install(s)" : "No linked install yet")</h3>
                                                    <p>Claim tickets, linked installs, preview access, and Device roles stay in one place instead of being rediscovered during the next install.</p>
                                                </div>
                                                <a class="inline-link" href="/account/access">Open Devices &amp; access</a>
                                            </article>
                                        </div>
                                        <p class="muted-copy">Need product proof before you install or return? <a class="inline-link" href="/now">Open what works today</a>.</p>
                                    </details>
                                </div>
                </div>
            </section>
        }
        else if (showAccessSection)
        {
            <section class="release-footnote">
                <p class="eyebrow">Access</p>
                <h2 class="editorial-title">Finish setup before you worry about devices and follow-up</h2>
                <p class="editorial-copy">The access surface becomes more useful once the account basics and recovery path are in place.</p>
                <div class="stacked-actions">
                    <a class="button-like button-like--primary" href="/home/setup">Open setup</a>
                </div>
            </section>
        }

        @if (showWorkSection && (!showOnboarding || effectiveWorkSurfaceReady))
        {
            <section class="release-shelf release-shelf--manual">
                <div class="home-stream">
                                <div class="home-stream__column">
                                    <div class="home-stream__lead">
                                        <p class="eyebrow">Work</p>
                                        <h2 class="home-stream__title">Pick up where you actually left off</h2>
                                        @* Campaign workspace. GM readiness cues. *@
                                        <p class="home-stream__summary">Dossiers, runs, and current continuity stay visible here with shared return context, Rule environments, and GM-ready cues so the signed-in home route points to the next safe route without turning Home into a deeper work page.</p>
                                        <p class="muted-copy">Shared campaign view return, grounded rule answers, Rule environments, and GM-ready cues stay visible here before you open the deeper account work route.</p>
                                    </div>
                                    <div class="app-rail">
                                        @if (dossiers.Length == 0 && campaigns.Length == 0 && runs.Length == 0 && workspaces.Length == 0)
                                        {
                                            <article class="app-rail__item">
                                                <span class="tag">Ready</span>
                                                <div class="app-rail__copy">
                                                    <h3>No long-lived runner yet</h3>
                                                    <p>Your first install and first workspace are ready to be stitched into a session lane here.</p>
                                                </div>
                                                @if (hasSeedableStarterWork)
                                                {
                                                    <div class="stacked-actions">
                                                        <button id="seedStarterWorkspace" class="button-like button-like--primary" type="button">Start first playable session</button>
                                                        <a class="inline-link" href="/account/access">Review install setup first</a>
                                                    </div>
                                                    <p id="starterWorkspaceNotice" class="muted-copy" aria-live="polite"></p>
                                                }
                                                else
                                                {
                                                    <a class="inline-link" href="/downloads">Start from downloads</a>
                                                }
                                            </article>
                                        }
                                        else
                                        {
                                            @foreach (var dossier in dossiers)
                                            {
                                                <article class="app-rail__item">
                                                    <span class="tag">Dossier</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@dossier.DisplayName</h3>
                                                        <p>@(dossier.LatestContinuity?.Summary ?? "Living dossier is ready for the next handoff.")</p>
                                                    </div>
                                                    <a class="inline-link" href="/account/work">Open dossiers</a>
                                                </article>
                                            }
                                            @foreach (var campaign in campaigns)
                                            {
                                                <article class="app-rail__item">
                                                    <span class="tag">Campaign</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@campaign.Name</h3>
                                                        <p>@(campaign.LatestContinuity?.Summary ?? "Campaign return is live.")</p>
                                                    </div>
                                                    <a class="inline-link" href="/account/work">Open campaign return</a>
                                                </article>
                                            }
                                            @foreach (var run in runs)
                                            {
                                                <article class="app-rail__item">
                                                    <span class="tag">Live run</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@run.Title</h3>
                                                        <p>@run.Objectives.Count objectives · @(run.ActiveSceneId is null ? "No active scene" : "Scene live") · @(run.LatestContinuity?.Summary ?? run.Summary)</p>
                                                    </div>
                                                    <a class="inline-link" href="/account/work">Open run context</a>
                                                </article>
                                            }
                                            @foreach (var workspace in workspaces)
                                            {
                                                <article class="app-rail__item">
                                                    <span class="tag">Shared campaign view</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@workspace.CampaignName</h3>
                                                        <p>
                                                            @workspace.ReturnSummary
                                                            @if (!string.IsNullOrWhiteSpace(workspace.ActiveSceneSummary))
                                                            {
                                                                <span> Scene: @workspace.ActiveSceneSummary</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(workspace.NextSafeAction))
                                                            {
                                                                <span> Next: @workspace.NextSafeAction</span>
                                                            }
                                                            @if (workspace.FirstPlayableSession is not null)
                                                            {
                                                                <span> First playable session: @workspace.FirstPlayableSession.CampaignStartSummary</span>
                                                                <span> Legal runner: @workspace.FirstPlayableSession.RuleReadySummary</span>
                                                                <span> Understandable return: @workspace.FirstPlayableSession.ReturnLaneSummary</span>
                                                                <span> Campaign-ready lane: @workspace.FirstPlayableSession.CampaignReadySummary</span>
                                                            }
                                                            @if (workspace.NextSessionCarryForward is not null)
                                                            {
                                                                <span> Carry-forward: @workspace.NextSessionCarryForward.Summary</span>
                                                            }
                                                            else if (workspace.CampaignMemory is not null)
                                                            {
                                                                <span> Memory: @workspace.CampaignMemory.Summary</span>
                                                            }
                                                            else if (workspace.Consequences is { Count: > 0 })
                                                            {
                                                                <span> Consequence: @workspace.Consequences[0].Label is @workspace.Consequences[0].State.</span>
                                                            }
                                                            else if (workspace.RosterTransfers is { Count: > 0 })
                                                            {
                                                                <span> Transfer: @workspace.RosterTransfers[0].Summary</span>
                                                            }
                                                            else if (workspace.ReadinessCues.Count > 0)
                                                            {
                                                                <span> Readiness: @workspace.ReadinessCues[0].Summary</span>
                                                            }
                                                            else if (workspace.ChangePackets is { Count: > 0 })
                                                            {
                                                                <span> Change: @workspace.ChangePackets[0].Summary</span>
                                                            }
                                                            else if (workspace.RecapShelf.Count > 0)
                                                            {
                                                                <span> Recent return artifact: @workspace.RecapShelf[0].Summary</span>
                                                            }
                                                            @if (leadWorkspaceServerPlane is not null
                                                                && string.Equals(leadWorkspaceServerPlane.Workspace.WorkspaceId, workspace.WorkspaceId, StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <span> State: @(leadWorkspaceState?.Label).</span>
                                                                @if (leadWorkspaceServerPlane.ChangePackets.Count > 0)
                                                                {
                                                                    <span> Change: @leadWorkspaceServerPlane.ChangePackets[0].Summary</span>
                                                                }
                                                                @if (leadNextSessionCarryForward is not null)
                                                                {
                                                                    <span> Carry-forward: @leadNextSessionCarryForward.Summary</span>
                                                                }
                                                                @if (leadFirstPlayableSession is not null)
                                                                {
                                                                    <span> First session: @leadFirstPlayableSession.CampaignStartSummary</span>
                                                                    <span> Legal runner: @leadFirstPlayableSession.RuleReadySummary</span>
                                                                    <span> Understandable return: @leadFirstPlayableSession.ReturnLaneSummary</span>
                                                                    <span> Campaign-ready lane: @leadFirstPlayableSession.CampaignReadySummary</span>
                                                                }
                                                                <span> GM prep: @leadWorkspaceServerPlane.PrepLibrary.Packets.Count packet(s). Travel: @(leadWorkspaceServerPlane.TravelMode.TravelReadyDeviceCount == 0 ? "claim lane pending." : $"{leadWorkspaceServerPlane.TravelMode.TravelReadyDeviceCount} ready device(s).")</span>
                                                                @if (leadWorkspaceServerPlane.AftermathPackages.Count > 0)
                                                                {
                                                                    <span> Aftermath: @leadWorkspaceServerPlane.AftermathPackages.Count package(s).</span>
                                                                }
                                                                @if (leadPortableExchangeNotice is not null)
                                                                {
                                                                    <span> Portable exchange: @leadPortableExchangeNotice.Summary</span>
                                                                }
                                                            }
                                                        </p>
                                                    </div>

@model HomePageViewModel
@{
    var pageTitle = Model.CurrentSection switch
    {
        "access" => "Home · Access",
        "work" => "Home · Work",
        "setup" => "Home · Setup",
        _ => "Home"
    };
    ViewData["Title"] = pageTitle;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-home";
    var showOnboarding = !Model.Experience.OnboardingCompleted;
    var googlePrimary = string.Equals(Model.Links.RecommendedPrimaryAuth, "google", StringComparison.OrdinalIgnoreCase);
    var followCount = (Model.Experience.FollowHorizons ? 1 : 0) + (Model.Experience.BetaInterest ? 1 : 0);
    var recoveryLinked = Model.Links.LinkedIdentities.Any(link => string.Equals(link.Provider, "email", StringComparison.OrdinalIgnoreCase));
    var claimedInstallations = Model.InstallLinking.ClaimedInstallations?.Count ?? 0;
    var activeAccessRights = Model.InstallLinking.ActiveGrants?.Count ?? 0;
    var pendingClaims = Model.InstallLinking.PendingClaimTickets.Count;
    var primaryActionTargetsSetup = string.Equals(Model.PrimaryAction.Href, "/home/setup", StringComparison.OrdinalIgnoreCase);
    var dossiers = Model.CampaignSpine.Dossiers.Take(3).ToArray();
    var campaigns = Model.CampaignSpine.Campaigns.Take(3).ToArray();
    var runs = Model.CampaignSpine.Runs.Take(3).ToArray();
    var workspaces = Model.CampaignSpine.Workspaces.Take(2).ToArray();
    var buildHandoffs = Model.CampaignSpine.BuildLabHandoffs.Take(2).ToArray();
    var rulesAnswers = Model.CampaignSpine.RulesNavigator.Take(2).ToArray();
    var migrationReceipts = Model.CampaignSpine.MigrationReceipts.Take(1).ToArray();
    var creatorPublications = Model.CampaignSpine.CreatorPublications.Take(1).ToArray();
    var restoreDevices = Model.CampaignSpine.Restore.ClaimedDevices.Take(1).ToArray();
    var leadCommunityOperation = Model.CampaignSpine.CommunityOperations.FirstOrDefault();
    var leadCommunityTransfer = leadCommunityOperation?.RecentRosterTransfers?.FirstOrDefault();
    var leadWorkspaceServerPlane = Model.LeadWorkspaceServerPlane;
    var leadWorkspaceState = leadWorkspaceServerPlane?.WorkspaceState;
    var leadNextSessionCarryForward = leadWorkspaceServerPlane?.NextSessionCarryForward;
    var leadNextSessionEvidence = leadNextSessionCarryForward?.EvidenceLines.FirstOrDefault();
    var leadConsequence = leadWorkspaceServerPlane?.Consequences.FirstOrDefault();
    var leadConsequenceEvidence = leadConsequence?.EvidenceLines.FirstOrDefault();
    var leadRosterTransfer = leadWorkspaceServerPlane?.RosterTransfers.FirstOrDefault();
    var leadRosterAuditLine = leadRosterTransfer?.AuditLines.FirstOrDefault();
    var leadPrepLaunch = leadWorkspaceServerPlane?.PrepLaunches.FirstOrDefault();
    var leadTravelPrefetch = leadWorkspaceServerPlane?.TravelPrefetches.FirstOrDefault();
    var leadAftermathPackage = leadWorkspaceServerPlane?.AftermathPackages
        .FirstOrDefault(item => !string.Equals(item.PackageKind, "downtime_brief", StringComparison.OrdinalIgnoreCase));
    var leadDowntimePackage = leadWorkspaceServerPlane?.AftermathPackages
        .FirstOrDefault(item => string.Equals(item.PackageKind, "downtime_brief", StringComparison.OrdinalIgnoreCase));
    var leadAftermathShelfEntry = leadWorkspaceServerPlane?.RecapShelf
        .FirstOrDefault(item => string.Equals(item.EntryId, leadAftermathPackage?.PackageId, StringComparison.OrdinalIgnoreCase))
        ?? leadWorkspaceServerPlane?.RecapShelf.FirstOrDefault();
    var leadAftermathEvidence = leadAftermathPackage?.EvidenceLines.FirstOrDefault();
    var leadDowntimeEvidence = leadDowntimePackage?.EvidenceLines.FirstOrDefault();
    var restoreConflicts = Model.CampaignSpine.Restore.ConflictSummaries.Count;
    var releasedOrNotifiedCases = Model.SupportCaseSummaries
        .Where(item =>
            string.Equals(item.Case.Status, "released_to_reporter_channel", StringComparison.OrdinalIgnoreCase)
            || string.Equals(item.Case.Status, "user_notified", StringComparison.OrdinalIgnoreCase)
            || string.Equals(item.Case.Status, "fixed", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(item => item.Case.UpdatedAtUtc)
        .Take(2)
        .ToArray();
    var recentReceipts = Model.InstallLinking.RecentReceipts.Take(2).ToArray();
    var accessSurfaceReady = claimedInstallations > 0
        || activeAccessRights > 0
        || pendingClaims > 0
        || recentReceipts.Length > 0
        || restoreConflicts > 0
        || releasedOrNotifiedCases.Length > 0;
    var workSurfaceReady = (claimedInstallations > 0 || pendingClaims > 0)
        && (dossiers.Length > 0
            || campaigns.Length > 0
            || runs.Length > 0
            || workspaces.Length > 0
            || leadWorkspaceServerPlane is not null
            || restoreDevices.Length > 0);
    var showOverviewSection = string.Equals(Model.CurrentSection, "overview", StringComparison.OrdinalIgnoreCase);
    var showAccessSection = string.Equals(Model.CurrentSection, "access", StringComparison.OrdinalIgnoreCase);
    var showWorkSection = string.Equals(Model.CurrentSection, "work", StringComparison.OrdinalIgnoreCase);
    var showSetupSection = string.Equals(Model.CurrentSection, "setup", StringComparison.OrdinalIgnoreCase);
    var openSetupDialog = showOnboarding || showSetupSection;
    var heading = Model.CurrentSection switch
    {
        "access" => "Access and return",
        "work" => "Work",
        "setup" => "Finish setup",
        _ => $"Welcome back, {Model.User.DisplayName}"
    };
    var summary = Model.CurrentSection switch
    {
        "access" => "Keep install return, release posture, and support follow-up in one calmer route instead of searching the whole account surface.",
        "work" => "Pick up dossiers, active runs, and the next useful route without turning Home into a deeper work page.",
        "setup" => "Finish the short setup flow first, then come back to access and work with a steadier account.",
        _ => "Pick up where you left off: finish the basics, install the current preview, and keep track of what is opening next."
    };

    static string HumanizeStatus(string? value, string fallback = "Not connected")
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallback;
        }

        return value.Trim().ToLowerInvariant() switch
        {
            "active" => "Ready",
            "linked" => "Ready",
            "pending" => "Pending",
            "pending_verification" => "Verification sent",
            "verified" => "Verified",
            "approved" => "Approved",
            "self_service" => "Self-service",
            "review" => "Needs review",
            "warning" => "Needs attention",
            "attention" => "Needs attention",
            "ready" => "Ready",
            "revoked" => "Revoked",
            _ => System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(value.Replace('_', ' '))
        };
    }

    static string RuleEnvironmentSummary(Chummer.Campaign.Contracts.RuleEnvironmentRef environment)
        => $"{environment.OwnerScope} scope · {environment.CompatibilityFingerprint} · {HumanizeStatus(environment.ApprovalState, "Review")}";
}

<section class="home-command">
    <div class="home-command__intro">
        <p class="eyebrow">Home</p>
        <h1 class="page-title">@heading</h1>
        <p class="page-copy">@summary</p>
    </div>
    <nav class="account-nav" aria-label="Home sections">
        @foreach (var navItem in Model.Sections)
        {
            <a href="@navItem.Href" aria-current="@(navItem.Current ? "page" : "false")">@navItem.Label</a>
        }
    </nav>
</section>

<div class="sr-only" aria-hidden="true">
    @Html.AntiForgeryToken()
</div>

<section class="home-dashboard home-dashboard--focus">
    <div class="home-dashboard__main">
        @if (showOverviewSection)
        {
            <div class="home-action-grid">
                <article class="app-action-card app-action-card--primary">
                    <span class="tag">@Model.PrimaryAction.Eyebrow</span>
                    <h2 id="setupCardTitle">@Model.PrimaryAction.Title</h2>
                    <p id="setupCardCopy">@Model.PrimaryAction.Summary</p>
                    @if (primaryActionTargetsSetup && showSetupSection)
                    {
                        <button class="button-like button-like--primary" type="button" data-open-onboarding id="openSetupButton">@Model.PrimaryAction.Label</button>
                    }
                    else
                    {
                        <a class="button-like button-like--primary" href="@Model.PrimaryAction.Href" id="openSetupButton">@Model.PrimaryAction.Label</a>
                    }
                </article>
                <article class="app-action-card">
                    <span class="tag">Current release</span>
                    <h2>Use the current preview</h2>
                    <p>See what changed, what is working today, and whether the current release is the right moment to install or update.</p>
                    <a class="button-like button-like--secondary" href="/now">Open current release</a>
                </article>
                <article class="app-action-card">
                    <span class="tag">Devices &amp; access</span>
                    <h2>Keep this copy connected</h2>
                    <p>Link this install, review access rights, and keep the claim path visible without digging through support copy.</p>
                    <a class="button-like button-like--ghost" href="/account/access">Open Devices &amp; access</a>
                </article>
            </div>
        }

        @if (showAccessSection && (!showOnboarding || accessSurfaceReady))
        {
            <section class="release-shelf release-shelf--manual">
                <div class="home-stream">
                                <div class="home-stream__column">
                                    <div class="home-stream__lead">
                                        <p class="eyebrow">Access</p>
                                        <h2 class="home-stream__title">What changed for you</h2>
                                        <p class="home-stream__summary">Support closure, install return, and release follow-up stay grouped so this route explains why something moved.</p>
                                    </div>
                                    <div class="app-rail">
                                        @if (releasedOrNotifiedCases.Length == 0 && recentReceipts.Length == 0 && restoreConflicts == 0)
                                        {
                                            <article class="app-rail__item">
                                                    <span class="tag">Calm</span>
                                                <div class="app-rail__copy">
                                                    <h3>No urgent follow-up</h3>
                                                    <p>This route does not see a fresh support closure, install handoff, or restore conflict right now.</p>
                                                </div>
                                                <a class="inline-link" href="/now">See what works today</a>
                                            </article>
                                        }
                                        else
                                        {
                                            @foreach (var supportCase in releasedOrNotifiedCases)
                                            {
                                                <article class="app-rail__item">
                                                    <span class="tag">@supportCase.StageLabel</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@supportCase.Case.Title</h3>
                                                        <p>@supportCase.ClosureSummary <span>Next: @supportCase.NextSafeAction</span></p>
                                                        <p class="muted-copy">@supportCase.ReleaseProgressSummary</p>
                                                        @if (!string.IsNullOrWhiteSpace(supportCase.AffectedInstallSummary))
                                                        {
                                                            <p class="muted-copy">@supportCase.AffectedInstallSummary</p>
                                                        }
                                                    </div>
                                                    <a class="inline-link" href="@supportCase.PrimaryActionHref">@supportCase.PrimaryActionLabel</a>
                                                </article>
                                            }
                                            @foreach (var receipt in recentReceipts)
                                            {
                                                <article class="app-rail__item">
                                                    <span class="tag">Install</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@receipt.ArtifactLabel</h3>
                                                        <p>@receipt.Version on @receipt.Channel is still attached to this account if you need to reconnect the copy later.</p>
                                                    </div>
                                                    <a class="inline-link" href="/account/access">Open Devices &amp; access</a>
                                                </article>
                                            }
                                            @if (restoreConflicts > 0)
                                            {
                                                <article class="app-rail__item">
                                                    <span class="tag">Return path</span>
                                                    <div class="app-rail__copy">
                                                        <h3>Campaign return needs confirmation</h3>
                                                        <p>@Model.CampaignSpine.Restore.ConflictSummaries[0]</p>
                                                    </div>
                                                    <a class="inline-link" href="/account/work">Review campaign return</a>
                                                </article>
                                            }
                                        }
                                    </div>
                                </div>

                                <div class="home-stream__column">
                                    <details class="details-drawer">
                                        <summary>Release and device state</summary>
                                        <div class="app-rail">
                                            <article class="app-rail__item">
                                                <span class="tag">Current release</span>
                                                <div class="app-rail__copy">
                                                    <h3>Use the current preview</h3>
                                                    <p>Review what changed, what is working today, and whether this is the right moment to install or update.</p>
                                                </div>
                                                <a class="inline-link" href="/now">Open current release</a>
                                            </article>
                                            <article class="app-rail__item">
                                                <span class="tag">Device state</span>
                                                <div class="app-rail__copy">
                                                    <h3>@(activeAccessRights > 0 ? $"{activeAccessRights} access right(s) active" : claimedInstallations > 0 ? $"{claimedInstallations} linked install(s)" : "No linked install yet")</h3>
                                                    <p>Claim tickets, linked installs, preview access, and Device roles stay in one place instead of being rediscovered during the next install.</p>
                                                </div>
                                                <a class="inline-link" href="/account/access">Open Devices &amp; access</a>
                                            </article>
                                        </div>
                                        <p class="muted-copy">Need product proof before you install or return? <a class="inline-link" href="/now">Open what works today</a>.</p>
                                    </details>
                                </div>
                </div>
            </section>
        }
        else if (showAccessSection)
        {
            <section class="release-footnote">
                <p class="eyebrow">Access</p>
                <h2 class="editorial-title">Finish setup before you worry about devices and follow-up</h2>
                <p class="editorial-copy">The access surface becomes more useful once the account basics and recovery path are in place.</p>
                <div class="stacked-actions">
                    <a class="button-like button-like--primary" href="/home/setup">Open setup</a>
                </div>
            </section>
        }

        @if (showWorkSection && (!showOnboarding || workSurfaceReady))
        {
            <section class="release-shelf release-shelf--manual">
                <div class="home-stream">
                                <div class="home-stream__column">
                                    <div class="home-stream__lead">
                                        <p class="eyebrow">Work</p>
                                        <h2 class="home-stream__title">Pick up where you actually left off</h2>
                                        @* Campaign workspace. GM readiness cues. *@
                                        <p class="home-stream__summary">Dossiers, runs, and current continuity stay visible here with shared return context, Rule environments, and GM-ready cues so the signed-in home route points to the next safe route without turning Home into a deeper work page.</p>
                                        <p class="muted-copy">Shared campaign view return, grounded rule answers, Rule environments, and GM-ready cues stay visible here before you open the deeper account work route.</p>
                                    </div>
                                    <div class="app-rail">
                                        @if (dossiers.Length == 0 && campaigns.Length == 0 && runs.Length == 0 && workspaces.Length == 0)
                                        {
                                                <article class="app-rail__item">
                                                    <span class="tag">Ready</span>
                                                    <div class="app-rail__copy">
                                                        <h3>No long-lived runner yet</h3>
                                                        <p>Your first claimed install or campaign handoff will seed the living dossier and the first return path here.</p>
                                                    </div>
                                                    <a class="inline-link" href="/downloads">Start from downloads</a>
                                                </article>
                                        }
                                        else
                                        {
                                            @foreach (var dossier in dossiers)
                                            {
                                                <article class="app-rail__item">
                                                    <span class="tag">Dossier</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@dossier.DisplayName</h3>
                                                        <p>@(dossier.LatestContinuity?.Summary ?? "Living dossier is ready for the next handoff.")</p>
                                                    </div>
                                                    <a class="inline-link" href="/account/work">Open dossiers</a>
                                                </article>
                                            }
                                            @foreach (var campaign in campaigns)
                                            {
                                                <article class="app-rail__item">
                                                    <span class="tag">Campaign</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@campaign.Name</h3>
                                                        <p>@(campaign.LatestContinuity?.Summary ?? "Campaign return is live.")</p>
                                                    </div>
                                                    <a class="inline-link" href="/account/work">Open campaign return</a>
                                                </article>
                                            }
                                            @foreach (var run in runs)
                                            {
                                                <article class="app-rail__item">
                                                    <span class="tag">Live run</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@run.Title</h3>
                                                        <p>@run.Objectives.Count objectives · @(run.ActiveSceneId is null ? "No active scene" : "Scene live") · @(run.LatestContinuity?.Summary ?? run.Summary)</p>
                                                    </div>
                                                    <a class="inline-link" href="/account/work">Open run context</a>
                                                </article>
                                            }
                                            @foreach (var workspace in workspaces)
                                            {
                                                <article class="app-rail__item">
                                                    <span class="tag">Shared campaign view</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@workspace.CampaignName</h3>
                                                        <p>
                                                            @workspace.ReturnSummary
                                                            @if (!string.IsNullOrWhiteSpace(workspace.ActiveSceneSummary))
                                                            {
                                                                <span> Scene: @workspace.ActiveSceneSummary</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(workspace.NextSafeAction))
                                                            {
                                                                <span> Next: @workspace.NextSafeAction</span>
                                                            }
                                                            @if (workspace.NextSessionCarryForward is not null)
                                                            {
                                                                <span> Carry-forward: @workspace.NextSessionCarryForward.Summary</span>
                                                            }
                                                            else if (workspace.Consequences is { Count: > 0 })
                                                            {
                                                                <span> Consequence: @workspace.Consequences[0].Label is @workspace.Consequences[0].State.</span>
                                                            }
                                                            else if (workspace.RosterTransfers is { Count: > 0 })
                                                            {
                                                                <span> Transfer: @workspace.RosterTransfers[0].Summary</span>
                                                            }
                                                            else if (workspace.ReadinessCues.Count > 0)
                                                            {
                                                                <span> Readiness: @workspace.ReadinessCues[0].Summary</span>
                                                            }
                                                            else if (workspace.ChangePackets is { Count: > 0 })
                                                            {
                                                                <span> Change: @workspace.ChangePackets[0].Summary</span>
                                                            }
                                                            else if (workspace.RecapShelf.Count > 0)
                                                            {
                                                                <span> Recent recap: @workspace.RecapShelf[0].Summary</span>
                                                            }
                                                            @if (leadWorkspaceServerPlane is not null
                                                                && string.Equals(leadWorkspaceServerPlane.Workspace.WorkspaceId, workspace.WorkspaceId, StringComparison.OrdinalIgnoreCase))
                                                            {
                                                                <span> State: @(leadWorkspaceState?.Label).</span>
                                                                @if (leadWorkspaceServerPlane.ChangePackets.Count > 0)
                                                                {
                                                                    <span> Change: @leadWorkspaceServerPlane.ChangePackets[0].Summary</span>
                                                                }
                                                                @if (leadNextSessionCarryForward is not null)
                                                                {
                                                                    <span> Carry-forward: @leadNextSessionCarryForward.Summary</span>
                                                                }
                                                                <span> GM prep: @leadWorkspaceServerPlane.PrepLibrary.Packets.Count packet(s). Travel: @(leadWorkspaceServerPlane.TravelMode.TravelReadyDeviceCount == 0 ? "claim lane pending." : $"{leadWorkspaceServerPlane.TravelMode.TravelReadyDeviceCount} ready device(s).")</span>
                                                                @if (leadWorkspaceServerPlane.AftermathPackages.Count > 0)
                                                                {
                                                                    <span> Aftermath: @leadWorkspaceServerPlane.AftermathPackages.Count package(s).</span>
                                                                }
                                                            }
                                                        </p>
                                                    </div>
                                                    <a class="inline-link" href="@($"/account/work/workspaces/{Uri.EscapeDataString(workspace.WorkspaceId)}")">Open shared campaign view</a>
                                                </article>
                                            }
                                        }
                                    </div>
                                </div>

                                <div class="home-stream__column">
                                    <details class="details-drawer">
                                        <summary>Build, explain, and next step</summary>
                                        <div class="home-stream__lead">
                                            <p class="eyebrow">Next</p>
                                            <h2 class="home-stream__title">Build, explain, and move forward without losing your place</h2>
                                            <p class="home-stream__summary">Build paths and grounded rule answers stay next to your return path so you can see what to inspect before reopening a dossier, session, or support thread.</p>
                                        </div>
                                        <div class="app-rail">
                                            @if (leadWorkspaceServerPlane is not null)
                                            {
                                                <article class="app-rail__item">
                                                    <span class="tag">What changed</span>
                                                    <div class="app-rail__copy">
                                                        <h3>What changed for me</h3>
                                                        <p>
                                                            @(leadWorkspaceState?.Label): @(leadWorkspaceState?.Summary)
                                                            @if (leadNextSessionCarryForward is not null)
                                                            {
                                                                <span> Carry-forward: @leadNextSessionCarryForward.Summary</span>
                                                            }
                                                            @if (leadWorkspaceServerPlane.ChangePackets.Count > 0)
                                                            {
                                                                <span> Change: @leadWorkspaceServerPlane.ChangePackets[0].Summary</span>
                                                            }
                                                            <span> Next: @leadWorkspaceServerPlane.NextSafeAction.Summary</span>
                                                            @if (leadWorkspaceServerPlane.DecisionNotices.Count > 0)
                                                            {
                                                                <span> Notice: @leadWorkspaceServerPlane.DecisionNotices[0].Summary</span>
                                                            }
                                                        </p>
                                                    </div>
                                                    <a class="inline-link" href="@($"/account/work/workspaces/{Uri.EscapeDataString(leadWorkspaceServerPlane.Workspace.WorkspaceId)}")">Open shared campaign view</a>
                                                </article>

                                                @if (leadNextSessionCarryForward is not null)
                                                {
                                                    <article class="app-rail__item">
                                                        <span class="tag">Next-session carry-forward</span>
                                                        <div class="app-rail__copy">
                                                            <h3>Next-session carry-forward</h3>
                                                            <p>
                                                                @leadNextSessionCarryForward.Summary
                                                                <span> Return: @leadNextSessionCarryForward.ReturnSummary</span>
                                                                <span> Next: @leadNextSessionCarryForward.NextSafeAction</span>
                                                                @if (!string.IsNullOrWhiteSpace(leadNextSessionEvidence))
                                                                {
                                                                    <span> Evidence: @leadNextSessionEvidence</span>
                                                                }
                                                            </p>
                                                        </div>
                                                        <a class="inline-link" href="@($"/account/work/workspaces/{Uri.EscapeDataString(leadWorkspaceServerPlane.Workspace.WorkspaceId)}#selected-next-session-carry-forward")">Open next-session return</a>
                                                    </article>
                                                }

                                                @if (leadAftermathPackage is not null)
                                                {
                                                    <article class="app-rail__item">
                                                        <span class="tag">Aftermath recap</span>
                                                        <div class="app-rail__copy">
                                                            <h3>@leadAftermathPackage.Title</h3>
                                                            <p>
                                                                @leadAftermathPackage.Summary
                                                                @if (!string.IsNullOrWhiteSpace(leadAftermathEvidence))
                                                                {
                                                                    <span> Evidence: @leadAftermathEvidence</span>
                                                                }
                                                                @if (leadAftermathShelfEntry is not null)
                                                                {
                                                                    <span> Return shelf: @leadAftermathShelfEntry.Label.</span>
                                                                }
                                                            </p>
                                                        </div>
                                                        <a class="inline-link" href="@($"/account/work/workspaces/{Uri.EscapeDataString(leadWorkspaceServerPlane.Workspace.WorkspaceId)}#aftermath-packages")">Open aftermath and return</a>
                                                    </article>
                                                }

                                                @if (leadDowntimePackage is not null)
                                                {
                                                    <article class="app-rail__item">
                                                        <span class="tag">Downtime brief</span>
                                                        <div class="app-rail__copy">
                                                            <h3>@leadDowntimePackage.Title</h3>
                                                            <p>
                                                                @leadDowntimePackage.Summary
                                                                @if (!string.IsNullOrWhiteSpace(leadDowntimeEvidence))
                                                                {
                                                                    <span> Evidence: @leadDowntimeEvidence</span>
                                                                }
                                                                @if (leadNextSessionCarryForward is not null)
                                                                {
                                                                    <span> Next: @leadNextSessionCarryForward.NextSafeAction</span>
                                                                }
                                                            </p>
                                                        </div>
                                                        <a class="inline-link" href="@($"/account/work/workspaces/{Uri.EscapeDataString(leadWorkspaceServerPlane.Workspace.WorkspaceId)}#selected-downtime-brief")">Open downtime brief</a>
                                                    </article>
                                                }

                                                @if (leadConsequence is not null)
                                                {
                                                    <article class="app-rail__item">
                                                        <span class="tag">Consequence watch</span>
                                                        <div class="app-rail__copy">
                                                            <h3>@leadConsequence.Label · @HumanizeStatus(leadConsequence.State, "Tracked")</h3>
                                                            <p>
                                                                @leadConsequence.Summary
                                                                @if (!string.IsNullOrWhiteSpace(leadConsequenceEvidence))
                                                                {
                                                                    <span> Evidence: @leadConsequenceEvidence</span>
                                                                }
                                                            </p>
                                                        </div>
                                                        <a class="inline-link" href="@($"/account/work/workspaces/{Uri.EscapeDataString(leadWorkspaceServerPlane.Workspace.WorkspaceId)}")">Open shared campaign view</a>
                                                    </article>
                                                }

                                                @if (leadRosterTransfer is not null)
                                                {
                                                    <article class="app-rail__item">
                                                        <span class="tag">Roster move</span>
                                                        <div class="app-rail__copy">
                                                            <h3>@leadRosterTransfer.RunnerHandle</h3>
                                                            <p>
                                                                @leadRosterTransfer.Summary
                                                                <span> Target: @leadRosterTransfer.TargetCampaignName via @leadRosterTransfer.TargetGroupName.</span>
                                                                @if (!string.IsNullOrWhiteSpace(leadRosterAuditLine))
                                                                {
                                                                    <span> Audit: @leadRosterAuditLine</span>
                                                                }
                                                            </p>
                                                        </div>
                                                        <a class="inline-link" href="/account/work#community-ops">Open governed roster moves</a>
                                                    </article>
                                                }

                                                @if (leadCommunityOperation is not null)
                                                {
                                                    <article class="app-rail__item">
                                                        <span class="tag">Operator posture</span>
                                                        <div class="app-rail__copy">
                                                            <h3>@leadCommunityOperation.GroupName</h3>
                                                            <p>
                                                                @HumanizeStatus(leadCommunityOperation.OperatorRole, "Member") · @leadCommunityOperation.CampaignVisibilitySummary
                                                                <span> Roster: @leadCommunityOperation.MemberCount members · @leadCommunityOperation.ActiveCampaignCount campaigns.</span>
                                                                <span> Rules: @RuleEnvironmentSummary(leadCommunityOperation.RuleEnvironment).</span>
                                                                @if (leadCommunityTransfer is not null)
                                                                {
                                                                    <span> Latest move: @leadCommunityTransfer.RunnerHandle.</span>
                                                                }
                                                            </p>
                                                        </div>
                                                        <a class="inline-link" href="/account/work#community-ops">Open teams and permissions</a>
                                                    </article>
                                                }

                                                <article class="app-rail__item">
                                                    <span class="tag">GM prep</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@leadWorkspaceServerPlane.PrepLibrary.Summary</h3>
                                                        <p>
                                                            @leadWorkspaceServerPlane.TravelMode.Summary
                                                            @if (leadPrepLaunch is not null)
                                                            {
                                                                <span> Latest launch: @leadPrepLaunch.PacketTitle@(string.IsNullOrWhiteSpace(leadPrepLaunch.TargetRunTitle) ? string.Empty : $" for {leadPrepLaunch.TargetRunTitle}").</span>
                                                            }
                                                            @if (leadTravelPrefetch is not null)
                                                            {
                                                                <span> Latest travel receipt: @leadTravelPrefetch.DeviceRole on @leadTravelPrefetch.Platform.</span>
                                                            }
                                                            <span> Search: @leadWorkspaceServerPlane.PrepLibrary.SearchSummary</span>
                                                            <span> Safehouse / travel mode: @leadWorkspaceServerPlane.TravelMode.PrefetchInventorySummary.</span>
                                                        </p>
                                                    </div>
                                                    <a class="inline-link" href="@($"/account/work/workspaces/{Uri.EscapeDataString(leadWorkspaceServerPlane.Workspace.WorkspaceId)}")">Open prep and travel</a>
                                                </article>
                                            }

                                            @if (buildHandoffs.Length == 0 && rulesAnswers.Length == 0)
                                            {
                                                <article class="app-rail__item">
                                                    <span class="tag">Build path</span>
                                                    <div class="app-rail__copy">
                                                        <h3>Continuity is ready for the first grounded handoff</h3>
                                                        <p>Your next build comparison and rules answer will land here once the first dossier or campaign return is seeded.</p>
                                                    </div>
                                                    <a class="inline-link" href="/downloads">Start from downloads</a>
                                                </article>
                                            }
                                            else
                                            {
                                                @if (buildHandoffs.Length > 0)
                                                {
                                                    var handoff = buildHandoffs[0];
                                                    <article class="app-rail__item">
                                                        <span class="tag">Build path</span>
                                                        <div class="app-rail__copy">
                                                            <h3>@handoff.Title</h3>
                                                            <p>
                                                                @handoff.Summary
                                                                @if (!string.IsNullOrWhiteSpace(handoff.NextSafeAction))
                                                                {
                                                                    <span> Next: @handoff.NextSafeAction.</span>
                                                                }
                                                                else if (handoff.ProgressionOutcomes.Count > 0)
                                                                {
                                                                    <span> Next: @handoff.ProgressionOutcomes[0].</span>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(handoff.CampaignReturnSummary))
                                                                {
                                                                    <span> Return: @handoff.CampaignReturnSummary.</span>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(handoff.SupportClosureSummary))
                                                                {
                                                                    <span> Support: @handoff.SupportClosureSummary.</span>
                                                                }
                                                                @if (handoff.Watchouts is { Count: > 0 })
                                                                {
                                                                    <span> Watchout: @handoff.Watchouts[0]</span>
                                                                }
                                                            </p>
                                                        </div>
                                                        <a class="inline-link" href="@($"/account/work/build-handoffs/{Uri.EscapeDataString(handoff.HandoffId)}")">Open build follow-through</a>
                                                    </article>
                                                }
                                                @if (rulesAnswers.Length > 0)
                                                {
                                                    var answer = rulesAnswers[0];
                                                    <article class="app-rail__item">
                                                        <span class="tag">Grounded rule answer</span>
                                                        <div class="app-rail__copy">
                                                            <h3>@answer.Question</h3>
                                                            <p>
                                                                @answer.ShortAnswer
                                                                <span> Source: @answer.ProvenanceLabel.</span>
                                                                @if (answer.EvidenceLines.Count > 0)
                                                                {
                                                                    <span> Evidence: @answer.EvidenceLines[0]</span>
                                                                }
                                                                @if (answer.SupportReuseHints.Count > 0)
                                                                {
                                                                    <span> Support note: @answer.SupportReuseHints[0]</span>
                                                                }
                                                            </p>
                                                        </div>
                                                        <a class="inline-link" href="@($"/account/work/rules/{Uri.EscapeDataString(answer.EntryId)}")">Open grounded rule context</a>
                                                    </article>
                                                }
                                            }
                                            <article class="app-rail__item">
                                                <span class="tag">Support</span>
                                                <div class="app-rail__copy">
                                                    <h3>Need a real answer instead?</h3>
                                                    <p>Use support when release, device, or return-path surfaces stop being enough to move forward confidently.</p>
                                                </div>
                                                <a class="inline-link" href="/account/support">Open support</a>
                                            </article>
                                            @if (migrationReceipts.Length > 0)
                                            {
                                                var migration = migrationReceipts[0];
                                                var leadField = migration.Fields.FirstOrDefault();
                                                <article class="app-rail__item">
                                                    <span class="tag">Migration return</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@migration.Summary</h3>
                                                        <p>
                                                            @if (leadField is null)
                                                            {
                                                                <span>Legacy import stayed attached to the same account return path.</span>
                                                            }
                                                            else
                                                            {
                                                                <span>@leadField.Label: @leadField.Summary</span>
                                                            }
                                                        </p>
                                                    </div>
                                                    <a class="inline-link" href="/account/work">Open migration return</a>
                                                </article>
                                            }
                                            @if (creatorPublications.Length > 0)
                                            {
                                                var publication = creatorPublications[0];
                                                <article class="app-rail__item">
                                                    <span class="tag">Publication status</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@publication.Title</h3>
                                                        <p>
                                                            @publication.Summary
                                                            <span>Trust: @publication.ProvenanceSummary.</span>
                                                            @if (!string.IsNullOrWhiteSpace(publication.NextSafeAction))
                                                            {
                                                                <span> Next: @publication.NextSafeAction.</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(publication.CampaignReturnSummary))
                                                            {
                                                                <span> Return: @publication.CampaignReturnSummary.</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(publication.SupportClosureSummary))
                                                            {
                                                                <span> Support: @publication.SupportClosureSummary.</span>
                                                            }
                                                        </p>
                                                    </div>
                                                    <a class="inline-link" href="@($"/account/work/publications/{Uri.EscapeDataString(publication.PublicationId)}")">Open publication status</a>
                                                </article>
                                            }
                                            @if (restoreDevices.Length > 0)
                                            {
                                                var device = restoreDevices[0];
                                                <article class="app-rail__item">
                                                    <span class="tag">Device return</span>
                                                    <div class="app-rail__copy">
                                                        <h3>@device.HostLabel</h3>
                                                        <p>@device.RestoreSummary <span>Role: @device.DeviceRole on @device.Platform.</span></p>
                                                    </div>
                                                    <a class="inline-link" href="/account/access">Open device return</a>
                                                </article>
                                            }
                                        </div>
                                    </details>
                                </div>
                </div>
            </section>
        }
        else if (showWorkSection)
        {
            <section class="release-footnote">
                <p class="eyebrow">Work</p>
                <h2 class="editorial-title">Finish setup before the work surfaces try to carry too much</h2>
                <p class="editorial-copy">The work route gets useful once Chummer has a stable identity, install path, and return path attached to the account.</p>
                <div class="stacked-actions">
                    <a class="button-like button-like--primary" href="/home/setup">Open setup</a>
                </div>
            </section>
        }

        @if (showSetupSection)
        {
            <section class="release-footnote">
                <p class="eyebrow">Setup</p>
                <h2 class="editorial-title">Finish the small setup flow, then come back to access and work</h2>
                <p class="editorial-copy">Profile, recovery, and update preferences live here so the rest of the account can stay calmer by default.</p>
                <div class="stacked-actions">
                    <button class="button-like button-like--primary" type="button" data-open-onboarding id="openSetupButton">@(showOnboarding ? "Complete setup" : "Open setup")</button>
                    <a class="button-like button-like--ghost" href="/account/profile">Open account settings instead</a>
                </div>
            </section>
        }
    </div>
</section>

<div class="onboarding-dialog" id="home-onboarding" role="dialog" aria-modal="true" aria-labelledby="onboarding-title" @(openSetupDialog ? "" : "hidden")>
    <div class="onboarding-dialog__panel">
        <div class="onboarding-dialog__topline">
            <div>
                <p class="eyebrow">Setup</p>
                <h2 id="onboarding-title">Finish the account basics</h2>
            </div>
            <button class="button-like button-like--ghost" type="button" data-close-onboarding>Close</button>
        </div>
        <div class="onboarding-steps">
            <span class="onboarding-step">1. About you</span>
            <span class="onboarding-step">2. What you're here for</span>
            <span class="onboarding-step">3. Backup and updates</span>
        </div>
        <div id="onboardingError" class="muted-copy" aria-live="polite"></div>
        <form id="onboardingForm" class="settings-form">
            <section data-step-panel="1">
                <p class="eyebrow">Step 1</p>
                <h2>Name and timezone</h2>
                <div class="field">
                    <label for="onboardingDisplayName">Display name</label>
                    <input id="onboardingDisplayName" value="@Model.User.DisplayName" />
                </div>
                <div class="field">
                    <label for="onboardingHandle">Handle</label>
                    <input id="onboardingHandle" value="@Model.User.Handle" />
                </div>
                <div class="field">
                    <label for="onboardingTimezone">Timezone</label>
                    <input id="onboardingTimezone" value="@Model.User.Timezone" />
                </div>
            </section>
            <section data-step-panel="2" hidden>
                <p class="eyebrow">Step 2</p>
                <h2>What you want from Chummer</h2>
                <div class="check-grid">
                    @{
                        var currentLanes = Model.Experience.LaneInterests.ToHashSet(StringComparer.OrdinalIgnoreCase);
                    }
                    <label class="check-row"><input type="checkbox" value="player" @(currentLanes.Contains("player") ? "checked" : null) /> <span>Player</span></label>
                    <label class="check-row"><input type="checkbox" value="gm" @(currentLanes.Contains("gm") ? "checked" : null) /> <span>GM</span></label>
                    <label class="check-row"><input type="checkbox" value="creator" @(currentLanes.Contains("creator") ? "checked" : null) /> <span>Creator</span></label>
                </div>
            </section>
            <section data-step-panel="3" hidden>
                <p class="eyebrow">Step 3</p>
                <h2>Backup sign-in and updates</h2>
                @if (googlePrimary)
                {
                    <div class="field">
                        <label for="onboardingRecoveryEmail">Recovery email</label>
                        <input id="onboardingRecoveryEmail" type="email" placeholder="runner@example.com" />
                    </div>
                }
                else
                {
                    <p class="muted-copy">Email already covers your primary sign-in. Link Google later if you want a faster one-click return path as well.</p>
                    <a class="button-like button-like--secondary" href="/auth/google/link?next=/home">Link Google</a>
                }
                <div class="check-grid">
                    <label class="check-row"><input id="onboardingFollow" type="checkbox" @(Model.Experience.FollowHorizons ? "checked" : null) /> <span>Follow roadmap updates</span></label>
                    <label class="check-row"><input id="onboardingBeta" type="checkbox" @(Model.Experience.BetaInterest ? "checked" : null) /> <span>Invite me to the right beta when it opens</span></label>
                </div>
            </section>
            <div class="stacked-actions">
                <button class="button-like button-like--ghost" type="button" data-onboarding-back hidden>Back</button>
                <button class="button-like button-like--primary" type="button" data-onboarding-next>Next</button>
                <button class="button-like button-like--primary" type="submit" data-onboarding-submit hidden>Finish</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
(() => {
  const ui = window.ChummerUi;
  const dialog = document.getElementById("home-onboarding");
  if (!dialog) return;
  const subjectId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.User.SubjectId));
  const panels = Array.from(dialog.querySelectorAll("[data-step-panel]"));
  const onboardingForm = dialog.querySelector("#onboardingForm");
  const nextButton = dialog.querySelector("[data-onboarding-next]");
  const backButton = dialog.querySelector("[data-onboarding-back]");
  const submitButton = dialog.querySelector("[data-onboarding-submit]");
  const openButtons = document.querySelectorAll("[data-open-onboarding]");
  const closeButtons = dialog.querySelectorAll("[data-close-onboarding]");
  const nodes = {
    error: document.getElementById("onboardingError"),
    setupState: document.getElementById("homeSetupState"),
    setupCopy: document.getElementById("homeSetupCopy"),
    interestState: document.getElementById("homeInterestState"),
    recoveryState: document.getElementById("homeRecoveryState"),
    recoveryCopy: document.getElementById("homeRecoveryCopy"),
    setupCardTitle: document.getElementById("setupCardTitle"),
    setupCardCopy: document.getElementById("setupCardCopy"),
    openSetupButton: document.getElementById("openSetupButton")
  };
  let step = 0;

  const openDialog = () => { dialog.hidden = false; };
  const closeDialog = () => { dialog.hidden = true; };

  const showStep = (index) => {
    step = index;
    panels.forEach((panel, panelIndex) => panel.hidden = panelIndex !== index);
    backButton.hidden = index === 0;
    nextButton.hidden = index === panels.length - 1;
    submitButton.hidden = index !== panels.length - 1;
  };

  const updateAccountSummary = (preferencesPayload, recoveryRequested) => {
    const followCount = (preferencesPayload.followHorizons ? 1 : 0) + (preferencesPayload.betaInterest ? 1 : 0);
    ui.setText(nodes.setupState, "Ready");
    ui.setText(nodes.setupCopy, "Your basic account setup is already in place.");
    ui.setText(nodes.interestState, followCount === 0 ? "Quiet" : `${followCount} active`);

    if (recoveryRequested) {
      ui.setText(nodes.recoveryState, "Verification sent");
      ui.setText(nodes.recoveryCopy, "Check your email to finish verifying the backup sign-in path.");
    }

    ui.setText(nodes.setupCardTitle, "Review setup");
    ui.setText(nodes.setupCardCopy, "Open the setup sheet whenever you want to adjust profile, interests, or backup sign-in.");
    ui.setText(nodes.openSetupButton, "Open setup");
    nodes.openSetupButton.dataset.defaultLabel = "Open setup";
  };

  openButtons.forEach((button) => button.addEventListener("click", openDialog));
  closeButtons.forEach((button) => button.addEventListener("click", closeDialog));
  nextButton.addEventListener("click", () => showStep(Math.min(step + 1, panels.length - 1)));
  backButton.addEventListener("click", () => showStep(Math.max(step - 1, 0)));
  showStep(step);

  onboardingForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    ui.clearNotice(nodes.error);
    try {
      await ui.withBusyState(submitButton, "Saving...", async () => {
        const laneInterests = Array.from(dialog.querySelectorAll("[data-step-panel='2'] input[type='checkbox']:checked")).map((input) => input.value);
        const recoveryField = document.getElementById("onboardingRecoveryEmail");
        const recoveryEmail = recoveryField?.value.trim() || "";

        await ui.requestJson("/api/v1/accounts/me/profile", {
          method: "POST",
          json: {
            subjectId,
            displayName: document.getElementById("onboardingDisplayName").value,
            handle: document.getElementById("onboardingHandle").value,
            timezone: document.getElementById("onboardingTimezone").value,
            visibility: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.User.Visibility))
          }
        });

        if (recoveryEmail.length > 0) {
          const recoveryPayload = await ui.requestJson("/api/v1/accounts/me/links/email/start", {
            method: "POST",
            json: {
              subjectId,
              email: recoveryEmail,
              nextPath: "/home"
            }
          });

          if (recoveryPayload.previewHref) {
            window.location.href = recoveryPayload.previewHref;
            return;
          }
        }

        const preferencesPayload = await ui.requestJson("/api/v1/accounts/me/preferences", {
          method: "POST",
          json: {
            subjectId,
            laneInterests,
            followHorizons: document.getElementById("onboardingFollow").checked,
            betaInterest: document.getElementById("onboardingBeta").checked,
            onboardingCompleted: true
          }
        });

        updateAccountSummary(preferencesPayload, recoveryEmail.length > 0);
        ui.setNotice(nodes.error, "Setup saved.");
        window.setTimeout(() => {
          closeDialog();
          ui.clearNotice(nodes.error);
        }, 900);
      });
    } catch (error) {
      ui.setNotice(nodes.error, ui.describeError(error, "Setup could not be saved right now."), true);
    }
  });
})();
</script>
}

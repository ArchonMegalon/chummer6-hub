@model DownloadDispatchPageViewModel
@{
    // Marker retained for desktop native trust verification:
    // Automatic account linking is the default path. Use claim-code fallback only when Chummer explicitly says it is in recovery mode.
    // Support stays with this install path.
    ViewData["Title"] = "Download setup";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-downloads surface-minimal";
    var showCompactDispatchInfo = Model.CompactDispatchLayout
        && (!string.IsNullOrWhiteSpace(Model.DispatchNote)
            || !string.IsNullOrWhiteSpace(Model.BootstrapCommandNote)
            || Model.BootstrapFeatureCards.Count > 0
            || !string.IsNullOrWhiteSpace(Model.CurrentReleaseSummary));

    static string PublicDispatchText(string? value) => UndetectableHumanizerCopyAdapter.Humanize(value);

    static string PublicDispatchTextOr(string? value, string fallback)
        => string.IsNullOrWhiteSpace(value)
            ? fallback
            : UndetectableHumanizerCopyAdapter.Humanize(value);

    var routeChoices = new[]
    {
        new
        {
            Badge = "This device",
            Title = "Finish setup here",
            Summary = "Keep this page open while the installer starts. You can connect this copy to your account, or keep using it unlinked.",
            Href = "#signed-in-download",
            Label = "Continue setup",
            Details = new[] { Model.PlatformLabel, Model.Display.BuildLabel, "This device" }
        },
        new
        {
            Badge = "Downloads",
            Title = "Pick another installer",
            Summary = "Use downloads when you need Windows, Linux, or a clean install for another machine.",
            Href = "/downloads",
            Label = "Back to downloads",
            Details = new[] { "Windows", "Linux", "Fresh install" }
        },
        new
        {
            Badge = "Account",
            Title = "Manage linked installs",
            Summary = "Use your account when you need to reconnect, replace, or remove an old install.",
            Href = Model.AccountHref,
            Label = Model.AccountLabel,
            Details = new[] { "Linked installs", "Recovery", "Install history" }
        },
        new
        {
            Badge = "Status",
            Title = "See the latest update",
            Summary = "Use current release when you want to confirm the latest availability and platform status.",
            Href = "/now",
            Label = "Open current release",
            Details = new[] { "Updated", "Platform status", "Known limits" }
        },
        new
        {
            Badge = "Recovery",
            Title = "Get help when setup stalls",
            Summary = "If the installer or account connection gets stuck, open support with this install context preserved.",
            Href = Model.SupportHref,
            Label = Model.SupportLabel,
            Details = new[] { "Install context", "Private help", "Follow-up" }
        }
    };
}

<section class="release-stage">
    <div class="release-stage__lead">
        <p class="eyebrow">@PublicDispatchText(Model.Eyebrow)</p>
        <h1 class="page-title">@PublicDispatchText(Model.Heading)</h1>
        @if (Model.CompactDispatchLayout)
        {
            <div class="dispatch-compact-lead">
                <p class="page-copy">@PublicDispatchText(Model.Summary)</p>
                @if (showCompactDispatchInfo)
                {
                    <details class="dispatch-inline-info" data-install-info>
                        <summary aria-label="Install details">
                            <span aria-hidden="true">i</span>
                        </summary>
                        <div class="dispatch-inline-info__panel" role="note">
                            <p class="dispatch-inline-info__eyebrow">Install details</p>
                            @if (!string.IsNullOrWhiteSpace(Model.DispatchNote))
                            {
                                <p>@PublicDispatchText(Model.DispatchNote)</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.BootstrapCommandNote))
                            {
                                <p>@PublicDispatchText(Model.BootstrapCommandNote)</p>
                            }
                            <p><strong>Current release</strong><br />@PublicDispatchText(Model.CurrentReleaseSummary).</p>
                            @if (Model.BootstrapFeatureCards.Count > 0)
                            {
                                <ul class="dispatch-inline-info__list">
                                    @foreach (var card in Model.BootstrapFeatureCards)
                                    {
                                        <li><strong>@(PublicDispatchText(card.Heading)).</strong> @PublicDispatchText(card.Body)</li>
                                    }
                                </ul>
                            }
                        </div>
                    </details>
                }
            </div>
        }
        else
        {
            <p class="page-copy">@PublicDispatchText(Model.Summary)</p>
            <p class="release-stage__note">@PublicDispatchText(Model.DispatchNote)</p>
            <p class="release-stage__note">Account linking is optional. A recovery code appears only if setup needs recovery.</p>
            <p class="release-stage__note">Support stays with this install.</p>
            <p class="release-stage__note"><strong>Current release</strong><br />@PublicDispatchText(Model.CurrentReleaseSummary).</p>
        }
    </div>
</section>

<section class="editorial-block" id="dispatch-route-map">
    <div class="editorial-block__lead">
        <p class="eyebrow">Where to go next</p>
        <h2 class="editorial-title">Start the install.</h2>
        <p class="editorial-copy">Start the installer. Link this copy later only if you want recovery and support history attached.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var choice in routeChoices)
        {
            <article class="route-choice-card">
                <span class="tag">@PublicDispatchText(choice.Badge)</span>
                <h3>@PublicDispatchText(choice.Title)</h3>
                <p>@PublicDispatchText(choice.Summary)</p>
                <div class="route-choice-card__details">
                    @foreach (var item in choice.Details)
                    {
                        <span>@PublicDispatchText(item)</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@choice.Href">@PublicDispatchText(choice.Label)</a>
            </article>
        }
    </div>
</section>

<section class="recommended-download" id="signed-in-download">
    <article class="recommended-download__card">
        <div class="recommended-download__copy">
            @if (!string.IsNullOrWhiteSpace(Model.ClaimExchangeUrl))
            {
                <div id="claimExchangeUrl" data-claim-url="@Model.ClaimExchangeUrl" hidden></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.TerminalInstallCommand) && Model.PromoteSecondaryDownload && !string.IsNullOrWhiteSpace(Model.SecondaryDownloadHref) && !string.IsNullOrWhiteSpace(Model.SecondaryDownloadLabel))
            {
                <div class="stacked-actions">
                    <a class="button-like button-like--primary" href="@Model.SecondaryDownloadHref" id="startSignedInDownloadButton">@PublicDispatchText(Model.SecondaryDownloadLabel)</a>
                </div>
                <p class="muted-copy">Use this direct installer only if support asks for it. Guided setup below is the normal path.</p>
                <details class="release-disclosure">
                <summary>Guided setup</summary>
                    <div class="release-disclosure__body">
                        <div class="code-panel">
                            <div class="code-panel__label">@PublicDispatchTextOr(Model.BootstrapCommandLabel, "Install command")</div>
                            <p class="handoff-command__intro"><strong>@PublicDispatchTextOr(Model.BootstrapCommandIntro, "Run this in your terminal.")</strong></p>
                            <div class="code-panel__value code-panel__value--terminal mono-receipt" id="terminalInstallCommandValue">@Model.TerminalInstallCommand</div>
                            @if (!Model.CompactDispatchLayout && !string.IsNullOrWhiteSpace(Model.BootstrapCommandNote))
                            {
                            <p class="handoff-command__note">@PublicDispatchText(Model.BootstrapCommandNote)</p>
                            }
                            <div class="stacked-actions">
                                <button class="button-like button-like--secondary" type="button" id="copyTerminalInstallCommandButton">@PublicDispatchText(Model.CopyCommandLabel)</button>
                                <a class="button-like button-like--ghost" href="@Model.DownloadHref">@PublicDispatchText(Model.DownloadLabel)</a>
                            </div>
                            <p class="status-copy" id="terminalInstallCommandNotice" hidden></p>
                        </div>
                        @if (!Model.CompactDispatchLayout && Model.BootstrapFeatureCards.Count > 0)
                        {
                            <div class="handoff-feature-grid" aria-label="Setup highlights">
                                @foreach (var card in Model.BootstrapFeatureCards)
                                {
                                    <article class="handoff-feature-card">
                                        <h2>@PublicDispatchText(card.Heading)</h2>
                                        <p>@PublicDispatchText(card.Body)</p>
                                    </article>
                                }
                            </div>
                        }
                    </div>
                </details>
            }
            else if (!string.IsNullOrWhiteSpace(Model.TerminalInstallCommand))
            {
                <div class="code-panel">
                    <div class="code-panel__label">@PublicDispatchTextOr(Model.BootstrapCommandLabel, "Install command")</div>
                    <p class="handoff-command__intro"><strong>@PublicDispatchTextOr(Model.BootstrapCommandIntro, "Run this in your terminal.")</strong></p>
                    <div class="code-panel__value code-panel__value--terminal mono-receipt" id="terminalInstallCommandValue">@Model.TerminalInstallCommand</div>
                    @if (!Model.CompactDispatchLayout && !string.IsNullOrWhiteSpace(Model.BootstrapCommandNote))
                    {
                        <p class="handoff-command__note">@PublicDispatchText(Model.BootstrapCommandNote)</p>
                    }
                    <div class="stacked-actions">
                        <button class="button-like button-like--primary" type="button" id="copyTerminalInstallCommandButton">@PublicDispatchText(Model.CopyCommandLabel)</button>
                    </div>
                    <p class="status-copy" id="terminalInstallCommandNotice" hidden></p>
                </div>
                @if (!Model.CompactDispatchLayout && Model.BootstrapFeatureCards.Count > 0)
                {
                    <div class="handoff-feature-grid" aria-label="Setup highlights">
                        @foreach (var card in Model.BootstrapFeatureCards)
                        {
                            <article class="handoff-feature-card">
                                <h2>@PublicDispatchText(card.Heading)</h2>
                                <p>@PublicDispatchText(card.Body)</p>
                            </article>
                        }
                    </div>
                }
            }
            @if (string.IsNullOrWhiteSpace(Model.TerminalInstallCommand))
            {
                <div class="stacked-actions">
                    <a class="button-like button-like--primary" href="@Model.DownloadHref" id="startSignedInDownloadButton">@PublicDispatchText(Model.DownloadLabel)</a>
                </div>
            }
            <details class="release-disclosure">
                <summary>Recovery options</summary>
                <div class="release-disclosure__body">
                    <p class="muted-copy">Use these options if setup stalls or this install needs account recovery.</p>
                    <p class="muted-copy">@PublicDispatchText(Model.ArtifactSupportLine)</p>
                    @if (Model.Steps.Count > 0)
                    {
                        <ul class="trust-page-section__list">
                            @foreach (var step in Model.Steps)
                            {
                                <li>@PublicDispatchText(step)</li>
                            }
                        </ul>
                    }
                    <div class="stacked-actions">
                        @if (!string.IsNullOrWhiteSpace(Model.TerminalInstallCommand))
                        {
                            <a class="button-like button-like--primary" href="@Model.DownloadHref">@PublicDispatchText(Model.DownloadLabel)</a>
                        }
                        @if (!Model.PromoteSecondaryDownload && !string.IsNullOrWhiteSpace(Model.SecondaryDownloadHref) && !string.IsNullOrWhiteSpace(Model.SecondaryDownloadLabel))
                        {
                            <a class="button-like button-like--ghost" href="@Model.SecondaryDownloadHref">@PublicDispatchText(Model.SecondaryDownloadLabel)</a>
                        }
                        <a class="button-like button-like--secondary" href="@Model.AccountHref">@PublicDispatchText(Model.AccountLabel)</a>
                        <a class="button-like button-like--secondary" href="@Model.SupportHref">@PublicDispatchText(Model.SupportLabel)</a>
                        <a class="button-like button-like--ghost" href="/now">Open current release</a>
                        <a class="button-like button-like--ghost" href="@Model.HelpHref">@PublicDispatchText(Model.HelpLabel)</a>
                        <a class="button-like button-like--ghost" href="/downloads">Back to downloads</a>
                    </div>
                </div>
            </details>
        </div>
    </article>
</section>

<section class="release-footnote">
    <div class="stacked-actions">
        <a class="cta-link cta-link--primary" href="/downloads">Back to downloads</a>
        <a class="cta-link cta-link--secondary" href="@Model.AccountHref">@PublicDispatchText(Model.AccountLabel)</a>
        <a class="cta-link cta-link--ghost" href="@Model.SupportHref">@PublicDispatchText(Model.SupportLabel)</a>
    </div>
</section>

<iframe id="signedInDownloadFrame" title="Download setup" hidden></iframe>

@section Scripts {
<script>
(() => {
  const ui = window.ChummerUi;
  const downloadHref = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DownloadHref));
  const autoStartDownload = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AutoStartDownload));
  const downloadButton = document.getElementById("startSignedInDownloadButton");
  const downloadFrame = document.getElementById("signedInDownloadFrame");
  const commandCopyButton = document.getElementById("copyTerminalInstallCommandButton");
  const terminalInstallCommandValue = document.getElementById("terminalInstallCommandValue");
  const terminalInstallCommandNotice = document.getElementById("terminalInstallCommandNotice");
  const installInfo = document.querySelector("[data-install-info]");

  const startDownload = () => {
    if (!downloadFrame || !downloadHref) return;
    downloadFrame.setAttribute("src", downloadHref);
  };

  if (downloadButton) {
    if (autoStartDownload) {
      downloadButton.addEventListener("click", (event) => {
        event.preventDefault();
        startDownload();
      });
    }
  }

  if (autoStartDownload) {
    window.setTimeout(startDownload, 250);
  }

  if (commandCopyButton && terminalInstallCommandValue && ui?.copyToClipboard) {
    commandCopyButton.addEventListener("click", async () => {
      try {
        await ui.copyToClipboard(terminalInstallCommandValue.textContent || "", commandCopyButton, "Copied");
        ui.setNotice(terminalInstallCommandNotice, "Install command copied.");
      } catch (error) {
        ui.setNotice(terminalInstallCommandNotice, ui.describeError(error, "Terminal command copy failed. Copy it manually from the panel."), true);
      }
    });
  }

  if (installInfo instanceof HTMLDetailsElement) {
    document.addEventListener("click", (event) => {
      if (!installInfo.open || installInfo.contains(event.target)) {
        return;
      }

      installInfo.removeAttribute("open");
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        installInfo.removeAttribute("open");
      }
    });
  }

})();
</script>
}

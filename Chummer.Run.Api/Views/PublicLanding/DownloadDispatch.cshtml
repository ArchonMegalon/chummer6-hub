@model DownloadDispatchPageViewModel
@{
    ViewData["Title"] = "Download handoff";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-downloads";
}

<section class="release-stage">
    <div class="release-stage__lead">
        <p class="eyebrow">Signed-in download</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@Model.Summary</p>
        <p class="release-stage__note">@Model.DispatchNote</p>
        <p class="release-stage__note"><strong>Current release</strong><br />@Model.Display.ChannelLabel, @Model.Display.BuildLabel, @Model.CurrentReleaseSummary.</p>
    </div>
</section>

<section class="recommended-download" id="signed-in-download">
    <article class="recommended-download__card">
        <div class="recommended-download__copy">
            @if (!string.IsNullOrWhiteSpace(Model.ClaimExchangeUrl))
            {
                <div id="claimExchangeUrl" data-claim-url="@Model.ClaimExchangeUrl" hidden></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.TerminalInstallCommand) && Model.PromoteSecondaryDownload && !string.IsNullOrWhiteSpace(Model.SecondaryDownloadHref) && !string.IsNullOrWhiteSpace(Model.SecondaryDownloadLabel))
            {
                <div class="stacked-actions">
                    <a class="button-like button-like--primary" href="@Model.SecondaryDownloadHref" id="startSignedInDownloadButton">@Model.SecondaryDownloadLabel</a>
                </div>
                <p class="muted-copy">Direct installer download is the cleanest Windows path when you want the standard setup wizard. Use the guided setup assistant below when you want both desktop heads and automatic account linking handled for you.</p>
                <details class="release-disclosure">
                    <summary>Guided Windows setup assistant</summary>
                    <div class="release-disclosure__body">
                        <div class="code-panel">
                            <div class="code-panel__label">@(Model.BootstrapCommandLabel ?? "Install command")</div>
                            <p class="handoff-command__intro"><strong>@(Model.BootstrapCommandIntro ?? "Paste this into your platform shell.")</strong></p>
                            <div class="code-panel__value code-panel__value--terminal mono-receipt" id="terminalInstallCommandValue">@Model.TerminalInstallCommand</div>
                            @if (!string.IsNullOrWhiteSpace(Model.BootstrapCommandNote))
                            {
                                <p class="handoff-command__note">@Model.BootstrapCommandNote</p>
                            }
                            <div class="stacked-actions">
                                <button class="button-like button-like--secondary" type="button" id="copyTerminalInstallCommandButton">Copy install command</button>
                                <a class="button-like button-like--ghost" href="@Model.DownloadHref">@Model.DownloadLabel</a>
                            </div>
                            <p class="status-copy" id="terminalInstallCommandNotice" hidden></p>
                        </div>
                        @if (Model.BootstrapFeatureCards.Count > 0)
                        {
                            <div class="handoff-feature-grid" aria-label="Setup highlights">
                                @foreach (var card in Model.BootstrapFeatureCards)
                                {
                                    <article class="handoff-feature-card">
                                        <h2>@card.Heading</h2>
                                        <p>@card.Body</p>
                                    </article>
                                }
                            </div>
                        }
                    </div>
                </details>
            }
            else if (!string.IsNullOrWhiteSpace(Model.TerminalInstallCommand))
            {
                <div class="code-panel">
                    <div class="code-panel__label">@(Model.BootstrapCommandLabel ?? "Install command")</div>
                    <p class="handoff-command__intro"><strong>@(Model.BootstrapCommandIntro ?? "Paste this into your platform shell.")</strong></p>
                    <div class="code-panel__value code-panel__value--terminal mono-receipt" id="terminalInstallCommandValue">@Model.TerminalInstallCommand</div>
                    @if (!string.IsNullOrWhiteSpace(Model.BootstrapCommandNote))
                    {
                        <p class="handoff-command__note">@Model.BootstrapCommandNote</p>
                    }
                    <div class="stacked-actions">
                        <button class="button-like button-like--primary" type="button" id="copyTerminalInstallCommandButton">Copy install command</button>
                    </div>
                    <p class="status-copy" id="terminalInstallCommandNotice" hidden></p>
                </div>
                @if (Model.BootstrapFeatureCards.Count > 0)
                {
                    <div class="handoff-feature-grid" aria-label="Setup highlights">
                        @foreach (var card in Model.BootstrapFeatureCards)
                        {
                            <article class="handoff-feature-card">
                                <h2>@card.Heading</h2>
                                <p>@card.Body</p>
                            </article>
                        }
                    </div>
                }
            }
            @if (string.IsNullOrWhiteSpace(Model.TerminalInstallCommand))
            {
                <div class="stacked-actions">
                    <a class="button-like button-like--primary" href="@Model.DownloadHref" id="startSignedInDownloadButton">@Model.DownloadLabel</a>
                </div>
            }
            <details class="release-disclosure">
                <summary>Fallbacks and recovery</summary>
                <div class="release-disclosure__body">
                    <p class="muted-copy">@Model.ArtifactSupportLine</p>
                    @if (Model.Steps.Count > 0)
                    {
                        <ul class="trust-page-section__list">
                            @foreach (var step in Model.Steps)
                            {
                                <li>@step</li>
                            }
                        </ul>
                    }
                    <div class="stacked-actions">
                        @if (!string.IsNullOrWhiteSpace(Model.TerminalInstallCommand))
                        {
                            <a class="button-like button-like--primary" href="@Model.DownloadHref">@Model.DownloadLabel</a>
                        }
                        @if (!Model.PromoteSecondaryDownload && !string.IsNullOrWhiteSpace(Model.SecondaryDownloadHref) && !string.IsNullOrWhiteSpace(Model.SecondaryDownloadLabel))
                        {
                            <a class="button-like button-like--ghost" href="@Model.SecondaryDownloadHref">@Model.SecondaryDownloadLabel</a>
                        }
                        <a class="button-like button-like--secondary" href="@Model.AccountHref">@Model.AccountLabel</a>
                        <a class="button-like button-like--ghost" href="@Model.HelpHref">@Model.HelpLabel</a>
                        <a class="button-like button-like--ghost" href="/downloads">Back to downloads</a>
                    </div>
                    <p class="muted-copy">@(Model.BootstrapScriptDownload
                        ? "The published packages stay the same for every user. The account-aware part is the short-lived setup assistant and the install ticket it carries, not a personalized app binary."
                        : "The installer bytes stay the same for every user. If account linking is needed, enter the support or recovery code inside setup instead of copying one from this page.")</p>
                </div>
            </details>
        </div>
    </article>
</section>

<section class="release-footnote">
    <div class="stacked-actions">
        <a class="button-like button-like--secondary" href="/downloads">Back to downloads</a>
    </div>
</section>

<iframe id="signedInDownloadFrame" title="Signed-in download" hidden></iframe>

@section Scripts {
<script>
(() => {
  const ui = window.ChummerUi;
  const downloadHref = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DownloadHref));
  const autoStartDownload = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AutoStartDownload));
  const downloadButton = document.getElementById("startSignedInDownloadButton");
  const downloadFrame = document.getElementById("signedInDownloadFrame");
  const commandCopyButton = document.getElementById("copyTerminalInstallCommandButton");
  const terminalInstallCommandValue = document.getElementById("terminalInstallCommandValue");
  const terminalInstallCommandNotice = document.getElementById("terminalInstallCommandNotice");

  const startDownload = () => {
    if (!downloadFrame || !downloadHref) return;
    downloadFrame.setAttribute("src", downloadHref);
  };

  if (downloadButton) {
    if (autoStartDownload) {
      downloadButton.addEventListener("click", (event) => {
        event.preventDefault();
        startDownload();
      });
    }
  }

  if (autoStartDownload) {
    window.setTimeout(startDownload, 250);
  }

  if (commandCopyButton && terminalInstallCommandValue && ui?.copyToClipboard) {
    commandCopyButton.addEventListener("click", async () => {
      try {
        await ui.copyToClipboard(terminalInstallCommandValue.textContent || "", commandCopyButton, "Copied");
        ui.setNotice(terminalInstallCommandNotice, "Install command copied.");
      } catch (error) {
        ui.setNotice(terminalInstallCommandNotice, ui.describeError(error, "Terminal command copy failed. Copy it manually from the panel."), true);
      }
    });
  }

})();
</script>
}

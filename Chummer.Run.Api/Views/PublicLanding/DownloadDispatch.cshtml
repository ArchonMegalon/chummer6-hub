@model DownloadDispatchPageViewModel
@{
    ViewData["Title"] = "Download handoff";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-downloads";
    var showCompactDispatchInfo = Model.CompactDispatchLayout
        && (!string.IsNullOrWhiteSpace(Model.DispatchNote)
            || !string.IsNullOrWhiteSpace(Model.BootstrapCommandNote)
            || Model.BootstrapFeatureCards.Count > 0
            || !string.IsNullOrWhiteSpace(Model.CurrentReleaseSummary));
    var routeChoices = new[]
    {
        new
        {
            Badge = "Current handoff",
            Title = "Stay on this install handoff while this device finishes its claim-aware setup",
            Summary = "This page exists for one signed-in device continuation. Keep using it when the job is finishing the guided setup assistant, the installer download, or the linked claim handoff for this copy.",
            Href = "#signed-in-download",
            Label = "Stay on this handoff",
            Proof = new[] { Model.PlatformLabel, Model.Display.BuildLabel, "One device continuation" }
        },
        new
        {
            Badge = "Downloads",
            Title = "Return to downloads when the job is choosing a platform or installer shape",
            Summary = "The main downloads page still owns platform comparison, known issues, and the calmer entry point for a fresh device. This page should not become a general installer catalog.",
            Href = "/downloads",
            Label = "Back to downloads",
            Proof = new[] { "Platform shelf", "Known issues nearby", "General install path" }
        },
        new
        {
            Badge = "Devices and access",
            Title = "Open Devices and access only when this copy needs relink or reclaim help",
            Summary = "Use the account-owned device page when the install needs relinking, reclaim, or continuity cleanup. Do not use this handoff page as a substitute account center.",
            Href = Model.AccountHref,
            Label = Model.AccountLabel,
            Proof = new[] { "Claimed install history", "Relink and reclaim", "Account-owned continuity" }
        },
        new
        {
            Badge = "Reality check",
            Title = "Open what works today when the question is current proof, not this device handoff",
            Summary = "The install handoff is for one device. Use the live proof page when you need the broader release posture, user-visible cautions, or current confidence before continuing.",
            Href = "/now",
            Label = "Open what works today",
            Proof = new[] { "Current proof shelf", "User-visible caution", "No mixed jobs" }
        },
        new
        {
            Badge = "Recovery",
            Title = "Leave the handoff for tracked support or help as soon as the problem becomes recovery-bound",
            Summary = "If setup breaks, logs are needed, or private follow-up starts, move to the support/help page immediately instead of treating this page like a troubleshooting maze.",
            Href = Model.SupportHref,
            Label = Model.SupportLabel,
            Proof = new[] { "Tracked follow-up", "Install context preserved", "Private help" }
        }
    };
    @* Support follow-through stays on the same install rail while this handoff resolves linked install truth. *@
}

<section class="release-stage">
    <div class="release-stage__lead">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        @if (Model.CompactDispatchLayout)
        {
            <div class="dispatch-compact-lead">
                <p class="page-copy">@Model.Summary</p>
                @if (showCompactDispatchInfo)
                {
                    <details class="dispatch-inline-info" data-install-info>
                        <summary aria-label="Install details">
                            <span aria-hidden="true">i</span>
                        </summary>
                        <div class="dispatch-inline-info__panel" role="note">
                            <p class="dispatch-inline-info__eyebrow">Install details</p>
                            @if (!string.IsNullOrWhiteSpace(Model.DispatchNote))
                            {
                                <p>@Model.DispatchNote</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.BootstrapCommandNote))
                            {
                                <p>@Model.BootstrapCommandNote</p>
                            }
                            <p><strong>Current release</strong><br />@Model.Display.ChannelLabel, @Model.Display.BuildLabel, @Model.CurrentReleaseSummary.</p>
                            @if (Model.BootstrapFeatureCards.Count > 0)
                            {
                                <ul class="dispatch-inline-info__list">
                                    @foreach (var card in Model.BootstrapFeatureCards)
                                    {
                                        <li><strong>@card.Heading.</strong> @card.Body</li>
                                    }
                                </ul>
                            }
                        </div>
                    </details>
                }
            </div>
        }
        else
        {
            <p class="page-copy">@Model.Summary</p>
            <p class="release-stage__note">@Model.DispatchNote</p>
            <p class="release-stage__note"><strong>Current release</strong><br />@Model.Display.ChannelLabel, @Model.Display.BuildLabel, @Model.CurrentReleaseSummary.</p>
        }
    </div>
</section>

<section class="editorial-block" id="dispatch-route-map">
    <div class="editorial-block__lead">
        <p class="eyebrow">Where to go next</p>
        <h2 class="editorial-title">Keep install handoff, platform choice, release proof, and recovery on separate pages.</h2>
        <p class="editorial-copy">This page should finish one signed-in device handoff. It should not replace the general downloads shelf, the account-owned device page, or first-party support.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var choice in routeChoices)
        {
            <article class="route-choice-card">
                <span class="tag">@choice.Badge</span>
                <h3>@choice.Title</h3>
                <p>@choice.Summary</p>
                <div class="route-choice-card__proof">
                    @foreach (var item in choice.Proof)
                    {
                        <span>@item</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@choice.Href">@choice.Label</a>
            </article>
        }
    </div>
</section>

<section class="recommended-download" id="signed-in-download">
    <article class="recommended-download__card">
        <div class="recommended-download__copy">
            @if (!string.IsNullOrWhiteSpace(Model.ClaimExchangeUrl))
            {
                <div id="claimExchangeUrl" data-claim-url="@Model.ClaimExchangeUrl" hidden></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.TerminalInstallCommand) && Model.PromoteSecondaryDownload && !string.IsNullOrWhiteSpace(Model.SecondaryDownloadHref) && !string.IsNullOrWhiteSpace(Model.SecondaryDownloadLabel))
            {
                <div class="stacked-actions">
                    <a class="button-like button-like--primary" href="@Model.SecondaryDownloadHref" id="startSignedInDownloadButton">@Model.SecondaryDownloadLabel</a>
                </div>
                <p class="muted-copy">Use this raw installer fallback only when support asks for it. The guided setup assistant below remains the linked-install default when this page is active.</p>
                <details class="release-disclosure">
                    <summary>Guided setup assistant</summary>
                    <div class="release-disclosure__body">
                        <div class="code-panel">
                            <div class="code-panel__label">@(Model.BootstrapCommandLabel ?? "Install command")</div>
                            <p class="handoff-command__intro"><strong>@(Model.BootstrapCommandIntro ?? "Paste this into your platform shell.")</strong></p>
                            <div class="code-panel__value code-panel__value--terminal mono-receipt" id="terminalInstallCommandValue">@Model.TerminalInstallCommand</div>
                            @if (!Model.CompactDispatchLayout && !string.IsNullOrWhiteSpace(Model.BootstrapCommandNote))
                            {
                                <p class="handoff-command__note">@Model.BootstrapCommandNote</p>
                            }
                            <div class="stacked-actions">
                                <button class="button-like button-like--secondary" type="button" id="copyTerminalInstallCommandButton">@Model.CopyCommandLabel</button>
                                <a class="button-like button-like--ghost" href="@Model.DownloadHref">@Model.DownloadLabel</a>
                            </div>
                            <p class="status-copy" id="terminalInstallCommandNotice" hidden></p>
                        </div>
                        @if (!Model.CompactDispatchLayout && Model.BootstrapFeatureCards.Count > 0)
                        {
                            <div class="handoff-feature-grid" aria-label="Setup highlights">
                                @foreach (var card in Model.BootstrapFeatureCards)
                                {
                                    <article class="handoff-feature-card">
                                        <h2>@card.Heading</h2>
                                        <p>@card.Body</p>
                                    </article>
                                }
                            </div>
                        }
                    </div>
                </details>
            }
            else if (!string.IsNullOrWhiteSpace(Model.TerminalInstallCommand))
            {
                <div class="code-panel">
                    <div class="code-panel__label">@(Model.BootstrapCommandLabel ?? "Install command")</div>
                    <p class="handoff-command__intro"><strong>@(Model.BootstrapCommandIntro ?? "Paste this into your platform shell.")</strong></p>
                    <div class="code-panel__value code-panel__value--terminal mono-receipt" id="terminalInstallCommandValue">@Model.TerminalInstallCommand</div>
                    @if (!Model.CompactDispatchLayout && !string.IsNullOrWhiteSpace(Model.BootstrapCommandNote))
                    {
                        <p class="handoff-command__note">@Model.BootstrapCommandNote</p>
                    }
                    <div class="stacked-actions">
                        <button class="button-like button-like--primary" type="button" id="copyTerminalInstallCommandButton">@Model.CopyCommandLabel</button>
                    </div>
                    <p class="status-copy" id="terminalInstallCommandNotice" hidden></p>
                </div>
                @if (!Model.CompactDispatchLayout && Model.BootstrapFeatureCards.Count > 0)
                {
                    <div class="handoff-feature-grid" aria-label="Setup highlights">
                        @foreach (var card in Model.BootstrapFeatureCards)
                        {
                            <article class="handoff-feature-card">
                                <h2>@card.Heading</h2>
                                <p>@card.Body</p>
                            </article>
                        }
                    </div>
                }
            }
            @if (string.IsNullOrWhiteSpace(Model.TerminalInstallCommand))
            {
                <div class="stacked-actions">
                    <a class="button-like button-like--primary" href="@Model.DownloadHref" id="startSignedInDownloadButton">@Model.DownloadLabel</a>
                </div>
            }
            <details class="release-disclosure">
                <summary>Fallbacks and recovery</summary>
                <div class="release-disclosure__body">
                    <p class="muted-copy">@Model.ArtifactSupportLine</p>
                    @if (Model.Steps.Count > 0)
                    {
                        <ul class="trust-page-section__list">
                            @foreach (var step in Model.Steps)
                            {
                                <li>@step</li>
                            }
                        </ul>
                    }
                    <div class="stacked-actions">
                        @if (!string.IsNullOrWhiteSpace(Model.TerminalInstallCommand))
                        {
                            <a class="button-like button-like--primary" href="@Model.DownloadHref">@Model.DownloadLabel</a>
                        }
                        @if (!Model.PromoteSecondaryDownload && !string.IsNullOrWhiteSpace(Model.SecondaryDownloadHref) && !string.IsNullOrWhiteSpace(Model.SecondaryDownloadLabel))
                        {
                            <a class="button-like button-like--ghost" href="@Model.SecondaryDownloadHref">@Model.SecondaryDownloadLabel</a>
                        }
                        <a class="button-like button-like--secondary" href="@Model.AccountHref">@Model.AccountLabel</a>
                        <a class="button-like button-like--secondary" href="@Model.SupportHref">@Model.SupportLabel</a>
                        <a class="button-like button-like--ghost" href="/now">What works today</a>
                        <a class="button-like button-like--ghost" href="@Model.HelpHref">@Model.HelpLabel</a>
                        <a class="button-like button-like--ghost" href="/downloads">Back to downloads</a>
                    </div>
                    <p class="muted-copy">@(Model.BootstrapScriptDownload
                        ? "The published packages stay the same for every user. The account-aware part is the short-lived setup assistant and the short-lived install claims it carries, not a personalized app binary."
                        : "The installer bytes stay the same for every user. If account linking is needed, enter the support or recovery code inside setup instead of copying one from this page.")</p>
                    <p class="muted-copy">Automatic account linking is the default path. Use claim-code fallback only when Chummer explicitly says it is in recovery mode.</p>
                    <p class="muted-copy">Support follow-through stays on the same install page, so the support form opens with this installer context instead of splitting recovery into a separate browser ritual.</p>
                    <p class="muted-copy">Status, known issues, and install help stay on one release page so recovery never depends on stale page copy.</p>
                </div>
            </details>
        </div>
    </article>
</section>

<section class="release-footnote">
    <p class="eyebrow">Next step</p>
    <h2 class="editorial-title">Use this page to finish one install handoff, then move to the page that owns the next job.</h2>
    <p class="editorial-copy">Return to Downloads for platform choice, open Devices and access for relink or reclaim work, and leave for tracked support as soon as the device needs recovery help instead of another install click.</p>
    <div class="stacked-actions">
        <a class="cta-link cta-link--primary" href="/downloads">Back to downloads</a>
        <a class="cta-link cta-link--secondary" href="@Model.AccountHref">@Model.AccountLabel</a>
        <a class="cta-link cta-link--ghost" href="@Model.SupportHref">@Model.SupportLabel</a>
    </div>
</section>

<iframe id="signedInDownloadFrame" title="Signed-in download" hidden></iframe>

@section Scripts {
<script>
(() => {
  const ui = window.ChummerUi;
  const downloadHref = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DownloadHref));
  const autoStartDownload = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AutoStartDownload));
  const downloadButton = document.getElementById("startSignedInDownloadButton");
  const downloadFrame = document.getElementById("signedInDownloadFrame");
  const commandCopyButton = document.getElementById("copyTerminalInstallCommandButton");
  const terminalInstallCommandValue = document.getElementById("terminalInstallCommandValue");
  const terminalInstallCommandNotice = document.getElementById("terminalInstallCommandNotice");
  const installInfo = document.querySelector("[data-install-info]");

  const startDownload = () => {
    if (!downloadFrame || !downloadHref) return;
    downloadFrame.setAttribute("src", downloadHref);
  };

  if (downloadButton) {
    if (autoStartDownload) {
      downloadButton.addEventListener("click", (event) => {
        event.preventDefault();
        startDownload();
      });
    }
  }

  if (autoStartDownload) {
    window.setTimeout(startDownload, 250);
  }

  if (commandCopyButton && terminalInstallCommandValue && ui?.copyToClipboard) {
    commandCopyButton.addEventListener("click", async () => {
      try {
        await ui.copyToClipboard(terminalInstallCommandValue.textContent || "", commandCopyButton, "Copied");
        ui.setNotice(terminalInstallCommandNotice, "Install command copied.");
      } catch (error) {
        ui.setNotice(terminalInstallCommandNotice, ui.describeError(error, "Terminal command copy failed. Copy it manually from the panel."), true);
      }
    });
  }

  if (installInfo instanceof HTMLDetailsElement) {
    document.addEventListener("click", (event) => {
      if (!installInfo.open || installInfo.contains(event.target)) {
        return;
      }

      installInfo.removeAttribute("open");
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        installInfo.removeAttribute("open");
      }
    });
  }

})();
</script>
}

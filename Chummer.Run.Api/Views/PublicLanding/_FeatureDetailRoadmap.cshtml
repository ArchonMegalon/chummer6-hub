@model FeatureDetailPageViewModel
@{
    static string RoadmapText(string? value)
        => UndetectableHumanizerCopyAdapter.HumanizeRoadmap(value);
}

<section class="role-matrix">
    <div class="editorial-block__lead">
        <p class="eyebrow">Why now</p>
        <h2 class="editorial-title">The short version.</h2>
        <p class="editorial-copy">What it fixes, what changes, and where to compare it with the app today.</p>
    </div>
    <div class="role-matrix__grid">
        @if (!string.IsNullOrWhiteSpace(Model.Pain))
        {
            <article class="role-matrix__cell">
                <span class="tag">Why now</span>
                <p>@RoadmapText(Model.Pain)</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Payoff))
        {
            <article class="role-matrix__cell">
                <span class="tag">What changes</span>
                <p>@RoadmapText(Model.Payoff)</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ProofNote))
        {
            <article class="role-matrix__cell">
                <span class="tag">Current state</span>
                <p>@RoadmapText(Model.ProofNote)</p>
            </article>
        }
    </div>
</section>

@if (Model.MicroProof.Count > 0)
{
    <section class="trust-rail-section">
        <div class="editorial-block__lead">
            <p class="eyebrow">Notes</p>
            <h2 class="editorial-title">What to compare with the app today.</h2>
        </div>
        <div class="trust-claim__details">
            @foreach (var item in Model.MicroProof)
            {
                <span>@UndetectableHumanizerCopyAdapter.Humanize(item)</span>
            }
        </div>
    </section>
}

<section class="compact-rail">
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Not shipped yet</h3>
            <p>Compare it with the current app before you count on it.</p>
        </div>
        <a class="inline-link" href="/now">Compare with current release</a>
    </article>
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Next page</h3>
            <p>@RoadmapText(Model.PrimaryAction.Label) is the next useful page.</p>
        </div>
        <a class="inline-link" href="@Model.PrimaryAction.Href">@RoadmapText(Model.PrimaryAction.Label)</a>
    </article>
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Need an answer?</h3>
            <p>Open support when you need help deciding what is blocked and what is already usable.</p>
        </div>
        <a class="inline-link" href="/contact">Open contact</a>
    </article>
    @if (Model.Chrome.Authenticated)
    {
        <article class="compact-rail__item">
            <div class="compact-rail__copy">
                <h3>Compare against your account details</h3>
                <p>Use your account details to compare this planned work with the same recap and publication history you already have on your account.</p>
            </div>
            <a class="inline-link" href="/artifacts#signed-in-detail-view">Open account details</a>
        </article>
    }
</section>

@model FeatureDetailPageViewModel
@{
    static string RoadmapText(string? value)
        => PublicFacingCopyHumanizer.Clean(value)
            .Replace("product threads", "planned work", StringComparison.OrdinalIgnoreCase)
            .Replace("product thread", "planned work", StringComparison.OrdinalIgnoreCase)
            .Replace("maintenance", "planned work", StringComparison.OrdinalIgnoreCase)
            .Replace("implementation tranche", "implementation slice", StringComparison.OrdinalIgnoreCase);
}

<section class="role-matrix">
    <div class="editorial-block__lead">
        <p class="eyebrow">Why this work matters now</p>
        <h2 class="editorial-title">Current pain, expected unlock, and the live surface you should compare first</h2>
        <p class="editorial-copy">Roadmap pages should explain why the work exists, what it changes for users, and which live surface keeps the promise honest today.</p>
    </div>
    <div class="role-matrix__grid">
        @if (!string.IsNullOrWhiteSpace(Model.Pain))
        {
            <article class="role-matrix__cell">
                <span class="tag">Why now</span>
                <p>@RoadmapText(Model.Pain)</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Payoff))
        {
            <article class="role-matrix__cell">
                <span class="tag">Expected unlock</span>
                <p>@RoadmapText(Model.Payoff)</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ProofNote))
        {
            <article class="role-matrix__cell">
                <span class="tag">Related live surface</span>
                <p>@RoadmapText(Model.ProofNote)</p>
            </article>
        }
    </div>
</section>

@if (Model.MicroProof.Count > 0)
{
    <section class="trust-rail-section">
        <div class="editorial-block__lead">
            <p class="eyebrow">What following this work means</p>
            <h2 class="editorial-title">Compare it against the current product before treating it as promised</h2>
        </div>
        <div class="trust-claim__details">
            @foreach (var item in Model.MicroProof)
            {
                <span>@PublicFacingCopyHumanizer.Clean(item)</span>
            }
        </div>
    </section>
}

<section class="compact-rail">
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Not live yet</h3>
            <p>This page names the work honestly before it reaches the live public release. Use the current product surface to compare what already exists.</p>
        </div>
        <a class="inline-link" href="/now">Compare with what works today</a>
    </article>
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Next honest page</h3>
            <p>@RoadmapText(Model.PrimaryAction.Label) is the in-product next step. The deeper brief stays secondary so roadmap pages stay useful without pulling you away from the product.</p>
        </div>
        <a class="inline-link" href="@Model.PrimaryAction.Href">@RoadmapText(Model.PrimaryAction.Label)</a>
    </article>
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Need a decision instead?</h3>
            <p>When the gap between the roadmap and today’s live surface is still unclear, support is the right place to ask what is blocked versus what is already usable.</p>
        </div>
        <a class="inline-link" href="/contact#support-intake">Open support</a>
    </article>
    @if (Model.Chrome.Authenticated)
    {
        <article class="compact-rail__item">
            <div class="compact-rail__copy">
                <h3>Compare against your account detail view</h3>
                <p>Use the account detail view to compare this planned work with the same recap and publication history you already have on your account.</p>
            </div>
            <a class="inline-link" href="/artifacts#signed-in-detail-view">Open account detail view</a>
        </article>
    }
</section>

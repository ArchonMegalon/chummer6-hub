@model FeatureDetailPageViewModel
@{
}

<section class="role-matrix">
    <div class="editorial-block__lead">
        <p class="eyebrow">Why this horizon matters now</p>
        <h2 class="editorial-title">Current pain, expected unlock, and the live proof you should compare first</h2>
        <p class="editorial-copy">Roadmap pages should explain why the horizon exists, what it changes for users, and which live proof keeps the promise honest today.</p>
    </div>
    <div class="role-matrix__grid">
        @if (!string.IsNullOrWhiteSpace(Model.Pain))
        {
            <article class="role-matrix__cell">
                <span class="tag">Why now</span>
                <p>@Model.Pain</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Payoff))
        {
            <article class="role-matrix__cell">
                <span class="tag">Expected unlock</span>
                <p>@Model.Payoff</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ProofNote))
        {
            <article class="role-matrix__cell">
                <span class="tag">Related live proof</span>
                <p>@Model.ProofNote</p>
            </article>
        }
    </div>
</section>

@if (Model.MicroProof.Count > 0)
{
    <section class="trust-rail-section">
        <div class="editorial-block__lead">
            <p class="eyebrow">What following this horizon means</p>
            <h2 class="editorial-title">Compare it against the current product before treating it as promised</h2>
        </div>
        <div class="trust-claim__microproof">
            @foreach (var item in Model.MicroProof)
            {
                <span>@item</span>
            }
        </div>
    </section>
}

<section class="compact-rail">
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Not live yet</h3>
            <p>This route names the horizon honestly before it reaches the live proof shelf. Use the current product surface to compare what already exists.</p>
        </div>
        <a class="inline-link" href="/now">Compare with current proof</a>
    </article>
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Next honest route</h3>
            <p>@Model.PrimaryAction.Label is the in-product next step. The deeper brief stays secondary so roadmap pages do not become a dead external handoff.</p>
        </div>
        <a class="inline-link" href="@Model.PrimaryAction.Href">@Model.PrimaryAction.Label</a>
    </article>
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Need a decision instead?</h3>
            <p>When the gap between the roadmap and today’s proof is still unclear, support is the right place to ask what is blocked versus what is already usable.</p>
        </div>
        <a class="inline-link" href="/contact#support-intake">Open support</a>
    </article>
    @if (Model.Chrome.Authenticated)
    {
        <article class="compact-rail__item">
            <div class="compact-rail__copy">
                <h3>Compare against your signed-in artifact shelf</h3>
                <p>Use the signed-in artifact shelf to compare this horizon with the same governed recap and creator-publication record you already have on your account.</p>
            </div>
            <a class="inline-link" href="/artifacts#linked-artifacts">Open signed-in artifact shelf</a>
        </article>
    }
</section>

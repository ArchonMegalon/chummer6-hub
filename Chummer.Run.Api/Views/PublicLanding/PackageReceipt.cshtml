@model PackageActionReceiptPageViewModel
@{
    ViewData["Title"] = PublicPackageText(Model.Heading);
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-package-receipt";

    static string PublicPackageText(string? value)
        => PublicFacingCopyHumanizer.Clean(value)
            .Replace("records", "updates", StringComparison.OrdinalIgnoreCase);
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@PublicPackageText(Model.Eyebrow)</p>
        <h1 class="page-title">@PublicPackageText(Model.Heading)</h1>
        <p class="page-copy">@PublicPackageText(Model.Intro)</p>
        <div class="trust-claim__details">
            <span>@PublicPackageText(Model.Receipt.ActionLabel)</span>
            <span>@PublicPackageText(Model.Receipt.PackageTitle)</span>
            <span>@Model.Receipt.RecordedAtLabel</span>
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="@Model.PrimaryAction.Href">@PublicPackageText(Model.PrimaryAction.Label)</a>
        @if (Model.SecondaryAction is not null)
        {
            <a class="button-like button-like--secondary" href="@Model.SecondaryAction.Href">@PublicPackageText(Model.SecondaryAction.Label)</a>
        }
        <a class="button-like button-like--ghost" href="/help">Open help</a>
    </div>
</section>

<section class="continuity-band">
    <div class="continuity-band__copy">
        <p class="eyebrow">Saved action</p>
        <h2 class="editorial-title">The action is saved in Chummer.</h2>
        <p class="editorial-copy">@PublicPackageText(Model.Receipt.RouteSummary)</p>
    </div>
    <div class="continuity-band__panel">
        <article class="continuity-band__fact">
            <span>Actor</span>
            <strong>@PublicPackageText(Model.Receipt.ActorLabel)</strong>
        </article>
        <article class="continuity-band__fact">
            <span>Package</span>
            <strong>@PublicPackageText(Model.Package.Title)</strong>
        </article>
        <article class="continuity-band__fact">
            <span>Recorded</span>
            <strong>@Model.Receipt.RecordedAtLabel</strong>
        </article>
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Next step</p>
        <h2 class="editorial-title">Return to the package detail or the account page without losing the saved action.</h2>
        <p class="editorial-copy">The saved action stays inside Chummer. The next step is either the package detail page or the account package page, not an external board.</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">Package detail</span>
            <h3>Return to the package page</h3>
            <p>Keep class, compatibility, and package status attached to the same detail page.</p>
            <a class="editorial-strip__action" href="@Model.PrimaryAction.Href">@PublicPackageText(Model.PrimaryAction.Label)</a>
        </article>
        @if (Model.SecondaryAction is not null)
        {
            <article class="route-choice-card">
                <span class="tag">Account page</span>
                <h3>Keep tracked package work together</h3>
                <p>Use the account package page when you want your follows, votes, and later return path to stay grouped.</p>
                <a class="editorial-strip__action" href="@Model.SecondaryAction.Href">@PublicPackageText(Model.SecondaryAction.Label)</a>
            </article>
        }
        <article class="route-choice-card">
            <span class="tag">Help</span>
            <h3>Switch to Chummer help if the issue becomes private</h3>
            <p>Package activity should not become a support workaround once the question turns into install repair, account recovery, or a private campaign issue.</p>
            <a class="editorial-strip__action" href="/help">Open help</a>
        </article>
    </div>
</section>

@model BlackLedgerNotificationsPageViewModel
@{
    ViewData["Title"] = "Black Ledger notifications";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-ledger";
}

<section class="ledger-flagship ledger-flagship--notifications">
    <div class="ledger-flagship__copy">
        <p class="eyebrow">Account notifications</p>
        <h1 class="page-title">@UndetectableHumanizerCopyAdapter.Humanize(Model.Heading)</h1>
        <p class="page-copy">@UndetectableHumanizerCopyAdapter.Humanize(Model.Intro)</p>
        <p class="ledger-flagship__support">Inbox opens on the world board first, then shows what happened for this turn.</p>
        <div class="trust-claim__details">
            <span>Current: @UndetectableHumanizerCopyAdapter.Humanize(Model.Status.StatusLabel)</span>
            <span>Policy: @UndetectableHumanizerCopyAdapter.Humanize(Model.Status.Policy)</span>
            <span>Updates: @Model.Status.ReceiptCount</span>
        </div>
        <div class="stacked-actions">
            <a class="button-like button-like--primary" href="@Model.Status.TurnHref">Open Turn 1</a>
            <a class="button-like button-like--secondary" href="/account/ledger/worldtick/validation">Open turn summary</a>
            <a class="button-like button-like--secondary" href="/account/ledger/advisory">Open advisory</a>
            <a class="button-like button-like--secondary" href="/account/ledger">Back to faction home</a>
        </div>
    </div>
    <div class="ledger-flagship__stage">
        <div class="ledger-flagship__map-frame">
            <div
                class="ledger-flagship__geoscape"
                data-black-ledger-geoscape-root
                data-variant="notifications"
                data-map-url="/api/v1/ledger/worlds/emerald-sprawl-prelude/map?turn=1&amp;mode=recent-changes"
                data-delta-url="/api/v1/ledger/worlds/emerald-sprawl-prelude/map/tick-delta/0/1"
                data-initial-mode="recent-changes"
                data-tick-headline="Newsreel pressure live."
                data-primary-label="Open Turn 1"
                data-primary-href="@Model.Status.TurnHref"
                data-secondary-label="Open turn summary"
                data-secondary-href="/account/ledger/worldtick/validation"></div>
        </div>
        <div class="ledger-flagship__nav" aria-label="Notification command paths">
            <a class="ledger-flagship__nav-card ledger-flagship__nav-card--primary" href="@Model.Status.TurnHref">
                <span class="tag">Turn</span>
                <strong>Open the world turn</strong>
                <p>Jump from the globe straight into the current turn and the current world state.</p>
            </a>
            <a class="ledger-flagship__nav-card" href="/account/ledger/worldtick/validation">
                <span class="tag">World state</span>
                <strong>Open turn summary</strong>
                <p>Every inbox line should trace back to the same world turn.</p>
            </a>
            <a class="ledger-flagship__nav-card" href="/account/ledger">
                <span class="tag">Home</span>
                <strong>Return to command</strong>
                <p>Go back to your faction command deck and read the board in the broader context.</p>
            </a>
            <a class="ledger-flagship__nav-card" href="/account/ledger/advisory">
                <span class="tag">Advisory</span>
                <strong>Open advisory voting</strong>
                <p>See the player and GM vote paths that feed upward into the faction chain of command.</p>
            </a>
            <a class="ledger-flagship__nav-card" href="/ledger/map#ledger-map">
                <span class="tag">Public</span>
                <strong>Open the public globe</strong>
                <p>Compare the account inbox with the public world view.</p>
            </a>
        </div>
    </div>
</section>

@if (Model.TablePulsePacket is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Table Pulse Live</p>
            <h2 class="editorial-title">@UndetectableHumanizerCopyAdapter.Humanize(Model.TablePulsePacket.Heading)</h2>
            <p class="editorial-copy">@UndetectableHumanizerCopyAdapter.Humanize(Model.TablePulsePacket.Summary)</p>
        </div>
        <div class="trust-claim__details">
            <span>Current: @UndetectableHumanizerCopyAdapter.Humanize(Model.TablePulsePacket.VerdictLabel)</span>
            <span>@UndetectableHumanizerCopyAdapter.Humanize(Model.TablePulsePacket.ConsentPosture)</span>
        </div>
        <div class="route-choice-grid route-choice-grid--three">
            <article class="route-choice-card">
                <span class="tag">Boundary</span>
                <p>@UndetectableHumanizerCopyAdapter.Humanize(Model.TablePulsePacket.BoundaryLine)</p>
            </article>
        </div>
        <div class="trust-claim__details">
            @foreach (var label in Model.TablePulsePacket.Labels)
            {
                <span>@UndetectableHumanizerCopyAdapter.Humanize(label)</span>
            }
        </div>
        <div class="route-choice-grid route-choice-grid--three">
            @foreach (var cue in Model.TablePulsePacket.Cues)
            {
                <article class="route-choice-card">
                    <span class="tag">@UndetectableHumanizerCopyAdapter.Humanize(cue.Label)</span>
                    <h3>@UndetectableHumanizerCopyAdapter.Humanize(cue.StatusLabel)</h3>
                    <p>@UndetectableHumanizerCopyAdapter.Humanize(cue.Summary)</p>
                    <div class="route-choice-card__details">
                        <a href="@cue.Href">Open</a>
                    </div>
                </article>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.TablePulsePacket.AdjudicationSummary))
        {
            <div class="trust-claim__details">
                <span>@UndetectableHumanizerCopyAdapter.Humanize(Model.TablePulsePacket.AdjudicationSummary)</span>
            </div>
        }
        <div class="route-choice-grid route-choice-grid--three">
            <article class="route-choice-card">
                <span class="tag">Heat</span>
                <p>@UndetectableHumanizerCopyAdapter.Humanize(Model.TablePulsePacket.HeatPosture)</p>
            </article>
            <article class="route-choice-card">
                <span class="tag">Notifications</span>
                <p>@UndetectableHumanizerCopyAdapter.Humanize(Model.TablePulsePacket.NotificationPosture)</p>
            </article>
            <article class="route-choice-card">
                <span class="tag">Remote reaction</span>
                <p>@UndetectableHumanizerCopyAdapter.Humanize(Model.TablePulsePacket.RemoteReactionPosture)</p>
            </article>
            <article class="route-choice-card">
                <span class="tag">Signal Deck</span>
                <p>@UndetectableHumanizerCopyAdapter.Humanize(Model.TablePulsePacket.SignalDeckPosture)</p>
            </article>
            <article class="route-choice-card">
                <span class="tag">Runner Passport</span>
                <p>@UndetectableHumanizerCopyAdapter.Humanize(Model.TablePulsePacket.RunnerPassportPosture)</p>
            </article>
            <article class="route-choice-card">
                <span class="tag">Aftermath</span>
                <p>@UndetectableHumanizerCopyAdapter.Humanize(Model.TablePulsePacket.AftermathPosture)</p>
                <div class="route-choice-card__details">
                    <a href="@Model.TablePulsePacket.AftermathHref">Open aftermath</a>
                </div>
            </article>
            <article class="route-choice-card">
                <span class="tag">Living World</span>
                <p>Keep the between-session notes, command carry-forward, and aftermath on one Chummer path.</p>
                <div class="route-choice-card__details">
                    <a href="/living-world">Open Living World</a>
                </div>
            </article>
            <article class="route-choice-card">
                <span class="tag">Entry</span>
                <p>Use the inbox as the Table Pulse Live entry point, not a static notification list.</p>
                <div class="route-choice-card__details">
                    <a href="@Model.TablePulsePacket.EntryHref">Open Table Pulse Live</a>
                </div>
            </article>
        </div>
        @if (Model.TablePulsePacket.ReactionOptions.Count > 0)
        {
            <div class="editorial-block__lead">
                <p class="eyebrow">Remote reactions</p>
                <h3 class="editorial-title">Small choices for players away from the table</h3>
                <p class="editorial-copy">These choices feed back into the campaign instead of creating a separate side game.</p>
            </div>
            <div class="route-choice-grid route-choice-grid--three">
                @foreach (var option in Model.TablePulsePacket.ReactionOptions)
                {
                    <article class="route-choice-card">
                        <span class="tag">@UndetectableHumanizerCopyAdapter.Humanize(option.Kind)</span>
                        <h3>@UndetectableHumanizerCopyAdapter.Humanize(option.Label)</h3>
                        <p>@UndetectableHumanizerCopyAdapter.Humanize(option.Summary)</p>
                        <form method="post" action="/account/ledger/notifications/table-pulse/react">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="reactionId" value="@option.ReactionId" />
                            <button class="button-like button-like--secondary" type="submit">@UndetectableHumanizerCopyAdapter.Humanize(option.ActionLabel)</button>
                        </form>
                    </article>
                }
            </div>
        }
    </section>
}

@if (Model.AdvisorySummary is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Advisory signal</p>
            <h2 class="editorial-title">@UndetectableHumanizerCopyAdapter.Humanize(Model.AdvisorySummary.Heading)</h2>
            <p class="editorial-copy">@UndetectableHumanizerCopyAdapter.Humanize(Model.AdvisorySummary.NoDemocracyNote)</p>
        </div>
        <div class="route-choice-grid route-choice-grid--three">
            <article class="route-choice-card">
                <span class="tag">Players</span>
                <p>@Model.AdvisorySummary.PlayerBallots.Count player ballot(s) currently open.</p>
            </article>
            <article class="route-choice-card">
                <span class="tag">GMs</span>
                <p>@Model.AdvisorySummary.GmBallots.Count GM strategy ballot(s) currently open.</p>
            </article>
            <article class="route-choice-card">
                <span class="tag">Executive</span>
                <p>@Model.AdvisorySummary.ExecutiveSummaries.Count executive summary item(s) currently visible.</p>
            </article>
        </div>
    </section>
}

@if (Model.WorldTurnBriefing is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">@UndetectableHumanizerCopyAdapter.Humanize(Model.WorldTurnBriefing.TransitionLabel)</p>
            <h2 class="editorial-title">@UndetectableHumanizerCopyAdapter.Humanize(Model.WorldTurnBriefing.InboxHeadline)</h2>
            <p class="editorial-copy">@UndetectableHumanizerCopyAdapter.Humanize(Model.WorldTurnBriefing.NewsreelLead)</p>
        </div>
        <div class="route-choice-grid route-choice-grid--three">
            @foreach (var beat in Model.WorldTurnBriefing.NewsreelBullets.Take(3))
            {
                <article class="route-choice-card">
                    <span class="tag">Inbox beat</span>
                    <p>@UndetectableHumanizerCopyAdapter.Humanize(beat)</p>
                </article>
            }
        </div>
    </section>

    @if (Model.WorldTurnBriefing.Broadcast is not null)
    {
        <section class="editorial-block ledger-newsreel-broadcast" id="newsreel-player">
            <div class="editorial-block__lead">
                <p class="eyebrow">Inbox watch package</p>
                <h2 class="editorial-title">@UndetectableHumanizerCopyAdapter.Humanize(Model.WorldTurnBriefing.Broadcast.PackageLabel)</h2>
                <p class="editorial-copy">Open the same anchor-led bulletin your inbox is referring to instead of reading a dead status card.</p>
            </div>
            <div class="ledger-newsreel-broadcast__shell">
                <div class="ledger-newsreel-broadcast__player">
                    <video class="ledger-newsreel-broadcast__video faction-promo-video"
                           controls
                           playsinline
                           preload="metadata"
                           poster="@Model.WorldTurnBriefing.Broadcast.PosterHref">
                        <source src="@Model.WorldTurnBriefing.Broadcast.VideoMp4Href" type="video/mp4" />
                        <source src="@Model.WorldTurnBriefing.Broadcast.VideoWebmHref" type="video/webm" />
                        <track kind="captions" src="@Model.WorldTurnBriefing.Broadcast.CaptionsHref" srclang="en" label="English" default />
                        Your browser cannot play this video here.
                    </video>
                    <div class="trust-claim__details">
                        <span>Anchor: @UndetectableHumanizerCopyAdapter.Humanize(Model.WorldTurnBriefing.Broadcast.AnchorName)</span>
                        <span>Desk: @UndetectableHumanizerCopyAdapter.Humanize(Model.WorldTurnBriefing.Broadcast.DeskLabel)</span>
                        <span>Duration: @Model.WorldTurnBriefing.Broadcast.DurationLabel</span>
                    </div>
                </div>
                <aside class="ledger-newsreel-broadcast__sidebar">
                    @if (Model.WorldTurnBriefing.Broadcast.ActionBeats.Count > 0)
                    {
                        <article class="route-choice-card">
                            <span class="tag">Action board</span>
                            <h3>Inbox-worthy beats</h3>
                            <div class="ledger-newsreel-broadcast__action-strip">
                                @foreach (var beat in Model.WorldTurnBriefing.Broadcast.ActionBeats.Take(3))
                                {
                                    <article class="ledger-newsreel-broadcast__action-card">
                                        <span class="tag">@UndetectableHumanizerCopyAdapter.Humanize(beat.ActorKind)</span>
                                        <h4>@UndetectableHumanizerCopyAdapter.Humanize(beat.BeatLabel)</h4>
                                        <p class="ledger-newsreel-broadcast__action-actor">@UndetectableHumanizerCopyAdapter.Humanize(beat.ActorLabel)</p>
                                        <p>@UndetectableHumanizerCopyAdapter.Humanize(beat.ActionSummary)</p>
                                        <p class="ledger-newsreel-broadcast__action-detail">@UndetectableHumanizerCopyAdapter.Humanize(beat.ProofNote)</p>
                                    </article>
                                }
                            </div>
                        </article>
                    }
                    <article class="route-choice-card">
                        <span class="tag">Audio</span>
                        <h3>Broadcast mix</h3>
                        <p>@UndetectableHumanizerCopyAdapter.Humanize(Model.WorldTurnBriefing.Broadcast.AudioPosture)</p>
                        <p>@UndetectableHumanizerCopyAdapter.Humanize(Model.WorldTurnBriefing.Broadcast.MusicPosture)</p>
                        <div class="route-choice-card__details">
                            <a href="@Model.WorldTurnBriefing.Broadcast.WatchHref">Watch</a>
                        </div>
                    </article>
                </aside>
            </div>
        </section>
    }
}

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Inbox</p>
        <h2 class="editorial-title">Actual messages, not just status</h2>
        <p class="editorial-copy">The account path now shows the turn, world state, leader digest, and faction promo as separate inbox items.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var message in Model.InboxMessages)
        {
            <article class="route-choice-card">
                <span class="tag">@UndetectableHumanizerCopyAdapter.Humanize(message.Eyebrow)</span>
                <h3>@UndetectableHumanizerCopyAdapter.Humanize(message.Heading)</h3>
                <p>@UndetectableHumanizerCopyAdapter.Humanize(message.Summary)</p>
                <div class="route-choice-card__details">
                    <span>Current: @UndetectableHumanizerCopyAdapter.Humanize(message.StatusLabel)</span>
                    <a href="@message.Href">@UndetectableHumanizerCopyAdapter.Humanize(message.CtaLabel)</a>
                </div>
            </article>
        }
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Delivery status</p>
        <h2 class="editorial-title">@UndetectableHumanizerCopyAdapter.Humanize(Model.Status.StatusLabel)</h2>
        <p class="editorial-copy">@UndetectableHumanizerCopyAdapter.Humanize(Model.Status.Summary)</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var note in Model.DeliveryNotes)
        {
            <article class="route-choice-card">
                <span class="tag">Policy note</span>
                <p>@UndetectableHumanizerCopyAdapter.Humanize(note)</p>
            </article>
        }
    </div>
</section>

@if (Model.Status.Receipts.Count > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Saved updates</p>
            <h2 class="editorial-title">Recent deliveries</h2>
            <p class="editorial-copy">Delivery or suppression history for the seeded Turn 1 newsreel.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var receipt in Model.Status.Receipts)
            {
                <article class="route-choice-card">
                    <span class="tag">@UndetectableHumanizerCopyAdapter.Humanize(receipt.Status)</span>
                    <h3>Delivery update</h3>
                    <p>@UndetectableHumanizerCopyAdapter.Humanize(receipt.Summary)</p>
                    <div class="route-choice-card__details">
                        <span>To: @UndetectableHumanizerCopyAdapter.Humanize(receipt.RecipientLabel)</span>
                        <span>Sent: @receipt.AttemptedAtUtc</span>
                        @if (!string.IsNullOrWhiteSpace(receipt.FailureReason))
                        {
                            <span>Reason: @UndetectableHumanizerCopyAdapter.Humanize(receipt.FailureReason)</span>
                        }
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (Model.ValidationPacket is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Current turn</p>
            <h2 class="editorial-title">What drives this inbox</h2>
            <p class="editorial-copy">@UndetectableHumanizerCopyAdapter.Humanize(Model.ValidationPacket.Summary)</p>
        </div>
        <div class="route-choice-grid route-choice-grid--three">
            @foreach (var check in Model.ValidationPacket.Checks.Take(3))
            {
                <article class="route-choice-card">
                    <span class="tag">Detail</span>
                    <p>@UndetectableHumanizerCopyAdapter.Humanize(check)</p>
                </article>
            }
        </div>
    </section>
}

<script type="module" src="~/js/black-ledger-geoscape.js" asp-append-version="true"></script>

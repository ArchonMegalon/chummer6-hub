@model PackageDetailPageViewModel
@{
    ViewData["Title"] = PublicPackageText(Model.Package.Title);
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-package-detail";

    static string PublicPackageText(string? value)
        => UndetectableHumanizerCopyAdapter.Humanize(value)
            .Replace("Provenance", "History", StringComparison.OrdinalIgnoreCase)
            .Replace("provenance", "history", StringComparison.OrdinalIgnoreCase)
            .Replace("Records", "Updates", StringComparison.OrdinalIgnoreCase)
            .Replace("records", "updates", StringComparison.OrdinalIgnoreCase);
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@PublicPackageText(Model.ScopeLabel)</p>
        <h1 class="page-title">@PublicPackageText(Model.Package.Title)</h1>
        <p class="page-copy">@PublicPackageText(Model.Package.Summary)</p>
        <div class="trust-claim__details">
            <span>@PublicPackageText(Model.Package.ClassLabel)</span>
            <span>@PublicPackageText(Model.Package.StatusLabel)</span>
            <span>@Model.Package.VoteCount votes</span>
            <span>@Model.Package.FollowCount follows</span>
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="@Model.PrimaryAction.Href">@PublicPackageText(Model.PrimaryAction.Label)</a>
        @if (Model.SecondaryAction is not null)
        {
            <a class="button-like button-like--secondary" href="@Model.SecondaryAction.Href">@PublicPackageText(Model.SecondaryAction.Label)</a>
        }
        <a class="button-like button-like--ghost" href="/help">Open help</a>
    </div>
</section>

<section class="continuity-band">
    <div class="continuity-band__copy">
        <p class="eyebrow">Fit</p>
        <h2 class="editorial-title">Know where this belongs before you act.</h2>
        <p class="editorial-copy">@PublicPackageText(Model.Package.EvidenceSummary)</p>
    </div>
    <div class="continuity-band__panel">
        <article class="continuity-band__fact">
            <span>Compatibility</span>
            <strong>@PublicPackageText(Model.Package.CompatibilitySummary)</strong>
        </article>
        <article class="continuity-band__fact">
            <span>Status</span>
            <strong>@PublicPackageText(Model.Package.GovernanceSummary)</strong>
        </article>
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Notes</p>
        <h2 class="editorial-title">Know where this belongs before you treat it like a build or a promise.</h2>
    </div>
    <div class="trust-rail-list">
        @foreach (var note in Model.CompatibilityNotes)
        {
            <article class="trust-rail">
                <span class="tag">Compatibility</span>
                <p>@PublicPackageText(note)</p>
            </article>
        }
        @foreach (var note in Model.GovernanceNotes)
        {
            <article class="trust-rail">
                <span class="tag">Status</span>
                <p>@PublicPackageText(note)</p>
            </article>
        }
    </div>
</section>

<section class="editorial-block" id="community-actions">
    <div class="editorial-block__lead">
        <p class="eyebrow">Actions</p>
        <h2 class="editorial-title">Vote or follow in Chummer.</h2>
        <p class="editorial-copy">
            @(Model.CanInteract
                ? "These actions keep package interest attached to the package, not to an external board name."
                : "Public package detail stays readable without an account. Sign in only when you want your package history tracked on the account page.")
        </p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
                    <span class="tag">Vote</span>
                    <h3>@PublicPackageText(Model.VoteActionLabel)</h3>
                    <p>Package votes stay in Chummer and stay tied to compatibility.</p>
            @if (Model.CanInteract)
            {
                <form method="post" action="@Model.VoteActionHref">
                    @Html.AntiForgeryToken()
                    <button class="button-like button-like--primary" type="submit">@PublicPackageText(Model.VoteActionLabel)</button>
                </form>
                @if (Model.CanRevokeVote && !string.IsNullOrWhiteSpace(Model.RevokeVoteActionHref))
                {
                    <form method="post" action="@Model.RevokeVoteActionHref">
                        @Html.AntiForgeryToken()
                        <button class="button-like button-like--ghost" type="submit">Revoke vote</button>
                    </form>
                }
            }
            else
            {
                <a class="button-like button-like--primary" href="@Model.VoteActionHref">@PublicPackageText(Model.VoteActionLabel)</a>
            }
            @if (Model.LatestVoteReceipt is not null)
            {
                <p><strong>Latest:</strong> <a class="inline-link" href="@Model.LatestVoteReceipt.Href">@Model.LatestVoteReceipt.RecordedAtLabel</a></p>
            }
        </article>
        <article class="route-choice-card">
                    <span class="tag">Follow</span>
                    <h3>@PublicPackageText(Model.FollowActionLabel)</h3>
                    <p>Package follows stay on the same Chummer page as later compatibility or release updates.</p>
            @if (Model.CanInteract)
            {
                <form method="post" action="@Model.FollowActionHref">
                    @Html.AntiForgeryToken()
                    <button class="button-like button-like--secondary" type="submit">@PublicPackageText(Model.FollowActionLabel)</button>
                </form>
                @if (Model.CanRevokeFollow && !string.IsNullOrWhiteSpace(Model.RevokeFollowActionHref))
                {
                    <form method="post" action="@Model.RevokeFollowActionHref">
                        @Html.AntiForgeryToken()
                        <button class="button-like button-like--ghost" type="submit">Revoke follow</button>
                    </form>
                }
            }
            else
            {
                <a class="button-like button-like--secondary" href="@Model.FollowActionHref">@PublicPackageText(Model.FollowActionLabel)</a>
            }
            @if (Model.LatestFollowReceipt is not null)
            {
                <p><strong>Latest:</strong> <a class="inline-link" href="@Model.LatestFollowReceipt.Href">@Model.LatestFollowReceipt.RecordedAtLabel</a></p>
            }
        </article>
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Recent activity</p>
        <h2 class="editorial-title">Activity stays attached to this package page.</h2>
    </div>
    <section class="compact-rail">
        @if (Model.RecentReceipts.Count == 0)
        {
            <article class="compact-rail__item">
                <div class="compact-rail__copy">
                    <h3>No activity yet</h3>
                    <p>Use vote or follow to create the first activity entry for this package.</p>
                </div>
            </article>
        }
        else
        {
            @foreach (var receipt in Model.RecentReceipts)
            {
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <h3>@PublicPackageText(receipt.ActionLabel) · @PublicPackageText(receipt.ActorLabel)</h3>
                        <p>@PublicPackageText(receipt.RouteSummary)</p>
                        <p>@receipt.RecordedAtLabel</p>
                    </div>
                    <a class="editorial-strip__action" href="@receipt.Href">Open activity</a>
                </article>
            }
        }
    </section>
</section>

@model PackageDetailPageViewModel
@{
    ViewData["Title"] = Model.Package.Title;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-package-detail";
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@Model.ScopeLabel</p>
        <h1 class="page-title">@Model.Package.Title</h1>
        <p class="page-copy">@Model.Package.Summary</p>
        <div class="trust-claim__microproof">
            <span>@Model.Package.ClassLabel</span>
            <span>@Model.Package.StatusLabel</span>
            <span>@Model.Package.VoteCount vote(s)</span>
            <span>@Model.Package.FollowCount follow(s)</span>
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="@Model.PrimaryAction.Href">@Model.PrimaryAction.Label</a>
        @if (Model.SecondaryAction is not null)
        {
            <a class="button-like button-like--secondary" href="@Model.SecondaryAction.Href">@Model.SecondaryAction.Label</a>
        }
        <a class="button-like button-like--ghost" href="/help">Open help</a>
    </div>
</section>

<section class="continuity-band">
    <div class="continuity-band__copy">
        <p class="eyebrow">Package posture</p>
        <h2 class="editorial-title">Compatibility and governance stay attached before any action fires.</h2>
        <p class="editorial-copy">@Model.Package.EvidenceSummary</p>
    </div>
    <div class="continuity-band__panel">
        <article class="continuity-band__fact">
            <span>Compatibility</span>
            <strong>@Model.Package.CompatibilitySummary</strong>
        </article>
        <article class="continuity-band__fact">
            <span>Governance</span>
            <strong>@Model.Package.GovernanceSummary</strong>
        </article>
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Compatibility notes</p>
        <h2 class="editorial-title">Know where this package belongs before you treat it like a build or a roadmap promise.</h2>
    </div>
    <div class="trust-rail-list">
        @foreach (var note in Model.CompatibilityNotes)
        {
            <article class="trust-rail">
                <span class="tag">Compatibility</span>
                <p>@note</p>
            </article>
        }
        @foreach (var note in Model.GovernanceNotes)
        {
            <article class="trust-rail">
                <span class="tag">Governance</span>
                <p>@note</p>
            </article>
        }
    </div>
</section>

<section class="editorial-block" id="community-actions">
    <div class="editorial-block__lead">
        <p class="eyebrow">Community actions</p>
        <h2 class="editorial-title">Vote or follow on first-party routes.</h2>
        <p class="editorial-copy">
            @(Model.CanInteract
                ? "These actions emit Chummer-owned receipts so package interest stays attached to the package, not to an external board name."
                : "Public package detail stays readable without an account. Sign in only when you want your package receipts tracked on the account rail.")
        </p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">Vote</span>
            <h3>@Model.VoteActionLabel</h3>
            <p>Package votes stay first-party and bounded by package compatibility posture.</p>
            @if (Model.CanInteract)
            {
                <form method="post" action="@Model.VoteActionHref">
                    @Html.AntiForgeryToken()
                    <button class="button-like button-like--primary" type="submit">@Model.VoteActionLabel</button>
                </form>
                @if (Model.CanRevokeVote && !string.IsNullOrWhiteSpace(Model.RevokeVoteActionHref))
                {
                    <form method="post" action="@Model.RevokeVoteActionHref">
                        @Html.AntiForgeryToken()
                        <button class="button-like button-like--ghost" type="submit">Revoke vote</button>
                    </form>
                }
            }
            else
            {
                <a class="button-like button-like--primary" href="@Model.VoteActionHref">@Model.VoteActionLabel</a>
            }
            @if (Model.LatestVoteReceipt is not null)
            {
                <p><strong>Latest:</strong> <a class="inline-link" href="@Model.LatestVoteReceipt.Href">@Model.LatestVoteReceipt.RecordedAtLabel</a></p>
            }
        </article>
        <article class="route-choice-card">
            <span class="tag">Follow</span>
            <h3>@Model.FollowActionLabel</h3>
            <p>Package follows stay on the same Chummer-owned rail as later compatibility or release updates.</p>
            @if (Model.CanInteract)
            {
                <form method="post" action="@Model.FollowActionHref">
                    @Html.AntiForgeryToken()
                    <button class="button-like button-like--secondary" type="submit">@Model.FollowActionLabel</button>
                </form>
                @if (Model.CanRevokeFollow && !string.IsNullOrWhiteSpace(Model.RevokeFollowActionHref))
                {
                    <form method="post" action="@Model.RevokeFollowActionHref">
                        @Html.AntiForgeryToken()
                        <button class="button-like button-like--ghost" type="submit">Revoke follow</button>
                    </form>
                }
            }
            else
            {
                <a class="button-like button-like--secondary" href="@Model.FollowActionHref">@Model.FollowActionLabel</a>
            }
            @if (Model.LatestFollowReceipt is not null)
            {
                <p><strong>Latest:</strong> <a class="inline-link" href="@Model.LatestFollowReceipt.Href">@Model.LatestFollowReceipt.RecordedAtLabel</a></p>
            }
        </article>
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Recent receipts</p>
        <h2 class="editorial-title">Package receipts stay attached to this package route.</h2>
    </div>
    <section class="compact-rail">
        @if (Model.RecentReceipts.Count == 0)
        {
            <article class="compact-rail__item">
                <div class="compact-rail__copy">
                    <h3>No receipts yet</h3>
                    <p>Use the vote or follow action to create the first first-party receipt for this package.</p>
                </div>
            </article>
        }
        else
        {
            @foreach (var receipt in Model.RecentReceipts)
            {
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <h3>@receipt.ActionLabel · @receipt.ActorLabel</h3>
                        <p>@receipt.RouteSummary</p>
                        <p>@receipt.RecordedAtLabel</p>
                    </div>
                    <a class="editorial-strip__action" href="@receipt.Href">Open receipt</a>
                </article>
            }
        }
    </section>
</section>

@model KnowledgeFabricPageViewModel
@{
    static string PublicKnowledgeText(string? value) => UndetectableHumanizerCopyAdapter.Humanize(value);

    ViewData["Title"] = PublicKnowledgeText(Model.Heading);
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-trust-page";
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@PublicKnowledgeText(Model.Eyebrow)</p>
        <h1 class="page-title">@PublicKnowledgeText(Model.Heading)</h1>
        <p class="page-copy">@PublicKnowledgeText(Model.Intro)</p>
        <div class="trust-claim__details">
            @foreach (var point in Model.SummaryPoints)
            {
                <span>@PublicKnowledgeText(point)</span>
            }
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--@Model.PrimaryAction.Tone" href="@Model.PrimaryAction.Href">@PublicKnowledgeText(Model.PrimaryAction.Label)</a>
        <a class="button-like button-like--@Model.SecondaryAction.Tone" href="@Model.SecondaryAction.Href">@PublicKnowledgeText(Model.SecondaryAction.Label)</a>
        <a class="button-like button-like--@Model.TertiaryAction.Tone" href="@Model.TertiaryAction.Href">@PublicKnowledgeText(Model.TertiaryAction.Label)</a>
    </div>
</section>

@if (Model.SignedInStatus is not null)
{
    <section class="release-footnote">
        @await Html.PartialAsync("~/Views/Shared/_SignedInTrustStatusPanel.cshtml", Model.SignedInStatus)
    </section>
}

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Rules</p>
        <h2 class="editorial-title">Read the short answer and open more when needed.</h2>
        <p class="editorial-copy">This page keeps rule answers short: a summary, recent context, and a deeper view when you need it. It does not dump book text or pretend to answer everything.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var receipt in Model.Receipts)
        {
            var provenance = PublicKnowledgeText(receipt.Provenance);
            <article class="route-choice-card">
                <span class="tag">@PublicKnowledgeText(receipt.Status)</span>
                <h3>@PublicKnowledgeText(receipt.Topic)</h3>
                <p>@PublicKnowledgeText(receipt.Summary)</p>
                <div class="route-choice-card__details">
                    <span>Based on: @PublicFacingCopyHumanizer.Clean(receipt.Provenance)</span>
                </div>
                <a class="editorial-strip__action" href="@receipt.Route">Open details</a>
            </article>
        }
    </div>
</section>

@if (Model.TrustPulse is not null)
{
    <section class="release-footnote">
        @await Html.PartialAsync("~/Views/Shared/_PublicTrustPulsePanel.cshtml", Model.TrustPulse)
    </section>
}

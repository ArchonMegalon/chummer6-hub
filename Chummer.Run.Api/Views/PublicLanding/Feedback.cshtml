@model ParticipatePageViewModel
@{
    ViewData["Title"] = "Feedback";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-participate";
    var signalLoop = Model.SignalLoop;
    var followSettingsHref = signalLoop.FollowSettingsHref;
    var followSettingsLabel = signalLoop.FollowSettingsLabel;
    var routeChoices = new[]
    {
        new
        {
            Badge = "Public board",
            Title = "Feature idea, UX friction, or safe public bug",
            Summary = "Use this page when the issue can stay public and does not need logs, private campaign detail, install recovery, or account repair.",
            Href = "#feedback-public-pages",
            Label = "Review public options",
            Details = new[] { "Public by default", "Votes show demand", "No private logs" }
        },
        new
        {
            Badge = "Roadmap",
            Title = "See what might come next",
            Summary = "Roadmap shows the next likely product movement. It is not a promise and it is not the shipped status page.",
            Href = "/roadmap",
            Label = "Open roadmap",
            Details = new[] { "Planned", "Milestones", "Separate from shipped updates" }
        },
        new
        {
            Badge = "Changelog",
            Title = "See what is actually available now",
            Summary = "When you need to know whether something is ready today, switch to the changelog backed by releases, live pages, and guides.",
            Href = "/changelog",
            Label = "Open changelog",
            Details = new[] { "Available now", "Release notes", "Help nearby" }
        },
        new
        {
            Badge = "Private help",
            Title = "Installs, crashes, account issues, and private table detail leave this page",
            Summary = "Use Chummer help when the problem needs logs, recovery, support history, or any private account or campaign detail that should not sit on a public board.",
            Href = "/contact#support-intake",
            Label = "Need private help instead?",
            Details = new[] { "Setup help", "Account help", "Private reply" }
        }
    };
    var feedbackStages = new[]
    {
        new
        {
            Badge = "Share it",
            Title = "Post one clear public item",
            Summary = "A public feature request, UX pain point, or safe public bug should live on one public page instead of scattering across comments and replies.",
            Note = "Start here when the issue can stay public.",
            Href = "#feedback-public-pages",
            Label = "Review the public pages"
        },
        new
        {
            Badge = "Review",
            Title = "The team reviews it before plans change",
            Summary = "Votes and comments help show demand, but the roadmap only moves when the team is ready to name what comes next.",
            Note = "Public interest helps prioritize; it does not promise a ship date.",
            Href = "/roadmap",
            Label = "Open roadmap"
        },
        new
        {
            Badge = "Ship it",
            Title = "The loop closes only after people can use it",
            Summary = "A report is not done because code merged. It is done when a release, live page, or guide lets people actually use the result.",
            Note = "The changelog shows what is available now.",
            Href = "/changelog",
            Label = "Open changelog"
        },
        new
        {
            Badge = "Take it private",
            Title = "Move to help when the issue stops being public",
            Summary = "If the issue needs recovery, logs, support history, or account detail, move it to Chummer help early instead of keeping it on a public page.",
            Note = "Private help stays in Chummer.",
            Href = "/help",
            Label = "Open help"
        }
    };
    var operatingCards = new[]
    {
        new
        {
            Badge = "Stay public",
            Title = "Leave one searchable report instead of scattering the same issue",
            Summary = "Keep feature requests, safe public bugs, and UX friction on one visible page so demand is legible before roadmap or release language changes.",
            Href = "#feedback-public-pages",
            Label = "Review public pages"
        },
        new
        {
            Badge = "Account value",
            Title = "Create the account only when support history becomes useful",
            Summary = "Roadmap follows, support history, device return, and future install return all get calmer once they can come back to one account place.",
            Href = followSettingsHref,
            Label = Model.Chrome.Authenticated ? "Open account settings" : "Create account for follow-up"
        },
        new
        {
            Badge = "Private boundary",
            Title = "Move off the board as soon as the issue stops being public",
            Summary = "Crashes, logs, account repair, install recovery, and private campaign detail belong on Chummer help before they leak into public comments.",
            Href = "/contact#support-intake",
            Label = "Open private support"
        }
    };
}

<section class="release-footnote route-anchor-target" id="public-feedback">
    <p class="eyebrow">Feedback</p>
    <h1 class="page-title">Share product ideas and safe public bugs in one place</h1>
    <p class="page-copy">Use this page for public feedback, then move to roadmap for what is next, changelog for shipped updates, or help when the issue is private.</p>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="#feedback-public-pages">Review public pages</a>
        <a class="button-like button-like--secondary" href="/roadmap">Open roadmap</a>
        <a class="button-like button-like--ghost" href="/changelog">Open changelog</a>
    </div>
    <p class="muted-copy">Votes show demand. Chummer decides what ships. Good reports include context and reproduction steps. Private logs and account issues belong in Help, not public feedback.</p>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Public-safe boundary</p>
        <h2 class="editorial-title">This page stays public-facing on purpose.</h2>
        <p class="editorial-copy">Use the public board for safe ideas and safe bugs. This page stays public and lightweight on purpose. If the issue needs logs, account history, recovery, or private support follow-up, leave this page and use Help.</p>
    </div>
</section>

<section class="status-decision-strip" aria-label="Feedback overview">
    <article class="status-decision-strip__card">
        <span class="tag">Roadmap</span>
        <h2>@signalLoop.OpenMilestoneCount named slice@(signalLoop.OpenMilestoneCount == 1 ? string.Empty : "s") are visible on the public roadmap.</h2>
        <p>@signalLoop.ClaimedMilestoneCount active now. @signalLoop.HighDifficultyMilestoneCount larger slice@(signalLoop.HighDifficultyMilestoneCount == 1 ? string.Empty : "s") still need more work before they become present-tense promises.</p>
        <a class="button-like button-like--ghost" href="/roadmap#roadmap-milestones">Open roadmap</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag">Shipped today</span>
        <h2>@signalLoop.ShippedFollowUpCount live example@(signalLoop.ShippedFollowUpCount == 1 ? string.Empty : "s") already show what people can use now.</h2>
        <p>When the question is what works today, switch to the changelog and current release notes instead of staying on the feedback page.</p>
        <a class="button-like button-like--ghost" href="/changelog">Open changelog</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag">Private help</span>
        <h2>Move off this page as soon as the issue needs logs, recovery, or account detail.</h2>
        <p>Public feedback works best when private support work stays on the help path.</p>
        <a class="button-like button-like--ghost" href="/help">Open help</a>
    </article>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Pick the right page</p>
        <h2 class="editorial-title">Public feedback, roadmap direction, shipped updates, and private support should not blur together.</h2>
        <p class="editorial-copy">The experience is calmer when each job has one page and one promise. Feedback starts the conversation; it is not the shipped status page or the private support inbox.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var choice in routeChoices)
        {
            <article class="route-choice-card">
                <span class="tag">@choice.Badge</span>
                <h3>@choice.Title</h3>
                <p>@choice.Summary</p>
                <div class="route-choice-card__details">
                    @foreach (var item in choice.Details)
                    {
                        <span>@item</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@choice.Href">@choice.Label</a>
            </article>
        }
    </div>
</section>

<section class="workflow-band">
    <div class="workflow-band__lead">
        <p class="eyebrow">Feedback path</p>
        <h2 class="editorial-title">Public feedback should start in one place and end on a page people can actually use.</h2>
        <p class="editorial-copy">This keeps feedback visible without pretending that comments are the same thing as roadmap commitments, shipped updates, or private support.</p>
    </div>
    <div class="workflow-grid">
        @foreach (var stage in feedbackStages)
        {
            <article class="workflow-card">
                <div class="workflow-card__copy">
                    <span class="tag">@stage.Badge</span>
                    <h3>@stage.Title</h3>
                    <p>@stage.Summary</p>
                    <p class="workflow-card__proof">@stage.Note</p>
                    <a class="inline-link" href="@stage.Href">@stage.Label</a>
                </div>
            </article>
        }
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">After something ships</p>
        <h2 class="editorial-title">Shipped updates stay upstream of public celebration.</h2>
        <p class="editorial-copy">The public board can show demand now, but shipped updates only land after the update path is ready.</p>
    </div>
</section>

<section class="status-decision-strip" aria-label="Public feedback rules">
    @foreach (var card in operatingCards)
    {
        <article class="status-decision-strip__card">
            <span class="tag">@PublicFacingCopyHumanizer.Clean(card.Badge)</span>
            <h2>@PublicFacingCopyHumanizer.Clean(card.Title)</h2>
            <p>@PublicFacingCopyHumanizer.Clean(card.Summary)</p>
            <a class="button-like button-like--ghost" href="@card.Href">@PublicFacingCopyHumanizer.Clean(card.Label)</a>
        </article>
    }
</section>

<section class="editorial-block" id="feedback-public-pages">
    <div class="editorial-block__lead">
        <p class="eyebrow">Public pages</p>
        <h2 class="editorial-title">Use the page that matches the job.</h2>
        <p class="editorial-copy">Public feedback is for ideas and safe bugs. Roadmap is for what may come next. Changelog is for what people can use. Help is for private details.</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">Feedback</span>
            <h3>Ideas and safe public bugs</h3>
            <p>Use this page when the discussion can stay public.</p>
            <a class="editorial-strip__action" href="/feedback">Stay here</a>
        </article>
        <article class="route-choice-card">
            <span class="tag">Roadmap</span>
            <h3>What may come next</h3>
            <p>Use roadmap when you want direction without treating it as shipped.</p>
            <a class="editorial-strip__action" href="/roadmap">Open roadmap</a>
        </article>
        <article class="route-choice-card">
            <span class="tag">Changelog</span>
            <h3>What is available now</h3>
            <p>Use changelog when you need the current shipped answer.</p>
            <a class="editorial-strip__action" href="/changelog">Open changelog</a>
        </article>
        <article class="route-choice-card">
            <span class="tag">Help</span>
            <h3>Private details</h3>
            <p>Use help for logs, account detail, install recovery, or private table material.</p>
            <a class="editorial-strip__action" href="/help">Open help</a>
        </article>
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">What happens after</p>
        <h2 class="editorial-title">One public report should connect to a roadmap page, a shipped page, or a help page.</h2>
        <p class="editorial-copy">Public feedback stays in Chummer. The next visible step can stay clear without turning this page into an operations board.</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">Roadmap</span>
            <h3>What active product movement looks like right now</h3>
            <p>Reports that matter should turn into named roadmap movement instead of vague comment-thread promises.</p>
            <a class="editorial-strip__action" href="/roadmap#roadmap-milestones">Open roadmap</a>
        </article>
        <article class="route-choice-card">
            <span class="tag">What might come next</span>
            <h3>What public movement looks like before anything is called shipped</h3>
            <p>The next public explanation should land on a clear roadmap page, not as a promise buried in feedback replies.</p>
            <a class="editorial-strip__action" href="/roadmap">Browse roadmap</a>
        </article>
        <article class="route-choice-card">
            <span class="tag">What works today</span>
            <h3>What a real shipped example already looks like</h3>
            <p>Public feedback only closes when a release, live page, or guide lets a person actually reach the result. That status lives in the changelog, not in a vote count.</p>
            <a class="editorial-strip__action" href="/changelog">Open changelog</a>
        </article>
    </div>
</section>

<section class="release-footnote">
    <p class="eyebrow">Account-aware follow-up</p>
    <h2 class="editorial-title">Create the account when you want feedback, installs, support, and roadmap follow-up to return to one place.</h2>
    <p class="editorial-copy">The public board still works without an account. The account becomes useful once you want device return, support return, roadmap follows, and future install linking attached to one calmer place.</p>
    <div class="stacked-actions">
        <a class="cta-link cta-link--primary" href="@followSettingsHref">@followSettingsLabel</a>
        <a class="cta-link cta-link--secondary" href="/roadmap">Open roadmap</a>
        <a class="cta-link cta-link--ghost" href="/help">Open help</a>
    </div>
    <p class="muted-copy">The paths stay split on purpose: <a class="inline-link" href="/feedback">public feedback</a>, <a class="inline-link" href="/roadmap">planned movement</a>, <a class="inline-link" href="/changelog">shipped updates</a>, and <a class="inline-link" href="/help">private follow-up</a>.</p>
</section>

@model ParticipatePageViewModel
@{
    ViewData["Title"] = "Feedback";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-participate";
    var signalLoop = Model.SignalLoop;
    var signalProjection = Model.SignalProjection;
    var signalOperations = Model.SignalOperations;
    var followSettingsHref = signalLoop.FollowSettingsHref;
    var followSettingsLabel = signalLoop.FollowSettingsLabel;
    var milestoneFollowUp = signalLoop.MilestoneFollowUp.Take(3).ToArray();
    var roadmapFollowUp = signalLoop.RoadmapFollowUp.Take(3).ToArray();
    var shippedFollowUp = signalLoop.ShippedFollowUp.Take(3).ToArray();
    var routeChoices = new[]
    {
        new
        {
            Badge = "Public board",
            Title = "Feature idea, UX friction, or safe public bug",
            Summary = "Use this page when the issue can stay public and does not need logs, private campaign detail, install recovery, or account repair.",
            Href = "#feedback-public-lanes",
            Label = "Review public signal pages",
            Proof = new[] { "Public by default", "Votes inform demand", "No private logs" }
        },
        new
        {
            Badge = "Roadmap",
            Title = "See what might come next",
            Summary = "Roadmap shows the next likely product movement. It is not a promise and it is not the shipped status page.",
            Href = "/roadmap",
            Label = "Open roadmap",
            Proof = new[] { "Planned", "Milestone-backed", "Separate from shipped updates" }
        },
        new
        {
            Badge = "Changelog",
            Title = "Check what is actually available now",
            Summary = "When you need to know whether something is ready today, switch to the changelog backed by releases, live pages, guides, and proof.",
            Href = "/changelog",
            Label = "Open changelog",
            Proof = new[] { "Evidence first", "User-available", "Release-linked" }
        },
        new
        {
            Badge = "Private help",
            Title = "Installs, crashes, account issues, and private table detail leave this page",
            Summary = "Use first-party help when the problem needs logs, recovery, support history, or any private account or campaign detail that should not sit on a public board.",
            Href = "/contact#support-intake",
            Label = "Need private help instead?",
            Proof = new[] { "Support-owned", "Tracked return", "Private by default" }
        }
    };
    var signalStages = new[]
    {
        new
        {
            Badge = "Share it",
            Title = "Post one clear public item",
            Summary = "A public feature request, UX pain point, or safe public bug should live on one public page instead of scattering across comments and replies.",
            Proof = "Start here when the issue can stay public.",
            Href = "#feedback-public-lanes",
            Label = "Review the public pages"
        },
        new
        {
            Badge = "Review",
            Title = "The team reviews it before plans change",
            Summary = "Votes and comments help show demand, but the roadmap only moves when the team is ready to name what comes next.",
            Proof = "Public interest helps prioritize; it does not promise a ship date.",
            Href = "/roadmap",
            Label = "Open roadmap"
        },
        new
        {
            Badge = "Ship it",
            Title = "The loop closes only after people can use it",
            Summary = "A signal is not done because code merged. It is done when a release, live page, or guide lets people actually use the result.",
            Proof = "The changelog shows what is available now.",
            Href = "/changelog",
            Label = "Open changelog"
        },
        new
        {
            Badge = "Take it private",
            Title = "Move to help when the issue stops being public",
            Summary = "If the issue needs recovery, logs, support follow-through, or account detail, push it onto the first-party help path early instead of keeping it on a public signal page.",
            Proof = "Private help stays first-party even while the hosted public mirror catches up.",
            Href = "/help",
            Label = "Open help"
        }
    };
    var operatingRails = new[]
    {
        new
        {
            Badge = "Stay public",
            Title = "Leave one searchable signal instead of scattering the same issue",
            Summary = "Keep feature requests, safe public bugs, and UX friction on one visible page so demand is legible before roadmap or release language changes.",
            Href = "#feedback-public-lanes",
            Label = "Review public pages"
        },
        new
        {
            Badge = "Account value",
            Title = "Create the account only when tracked follow-up becomes useful",
            Summary = "Roadmap follows, support history, device continuity, and future install-linked return all get calmer once they can come back to one account place.",
            Href = followSettingsHref,
            Label = Model.Chrome.Authenticated ? "Open account settings" : "Create account for follow-up"
        },
        new
        {
            Badge = "Private boundary",
            Title = "Move off the board as soon as the issue stops being public",
            Summary = "Crashes, logs, account repair, install recovery, and private campaign detail belong on first-party help before they leak into public comments.",
            Href = "/contact#support-intake",
            Label = "Open private support"
        }
    };
}

@if (signalProjection is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Projection boundary</p>
            <h2 class="editorial-title">Public feedback can show direction without pretending to be release truth.</h2>
            <p class="editorial-copy">This packet keeps the public board subordinate to first-party truth, fallback, and shipped closeout before feature demand becomes public celebration.</p>
        </div>
        <div class="support-operations-panel">
            @await Html.PartialAsync("~/Views/Shared/_PublicSignalProjectionPacket.cshtml", signalProjection)
        </div>
    </section>
}

@if (signalOperations is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Operations packet</p>
            <h2 class="editorial-title">Hosted signal promotion still needs intake, routing, and closeout discipline.</h2>
            <p class="editorial-copy">The public board earns trust only when promotion, taxonomy, intake, and closeout routes remain inspectable instead of becoming vibes.</p>
        </div>
        <div class="support-operations-panel">
            @await Html.PartialAsync("~/Views/Shared/_PublicSignalOperationsPacket.cshtml", signalOperations)
        </div>
    </section>
}

<section class="release-footnote route-anchor-target" id="public-feedback">
    <p class="eyebrow">Feedback</p>
    <h1 class="page-title">Share product ideas and safe public bugs in one place</h1>
    <p class="page-copy">Use this page for public feedback, then move to roadmap for what is next, changelog for shipped updates, or help when the issue is private.</p>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="#feedback-public-lanes">Review public pages</a>
        <a class="button-like button-like--secondary" href="/roadmap">Open roadmap</a>
        <a class="button-like button-like--ghost" href="/changelog">Open changelog</a>
    </div>
    <p class="muted-copy">Votes show demand; Chummer-owned proof decides what ships. Good reports include context and reproduction steps. Private logs and account issues belong in Help, not public feedback.</p>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Public-safe boundary</p>
        <h2 class="editorial-title">This page stays public-facing on purpose.</h2>
        <p class="editorial-copy">Use the public board for safe ideas and safe bugs. This page stays preview-only on this host until proof-backed closeout is real here. If the issue needs logs, account history, recovery, or private support follow-up, leave this page and use Help.</p>
    </div>
</section>

<section class="status-decision-strip" aria-label="Signal loop snapshot">
    <article class="status-decision-strip__card">
        <span class="tag">Roadmap</span>
        <h2>@signalLoop.OpenMilestoneCount named slice@(signalLoop.OpenMilestoneCount == 1 ? string.Empty : "s") are visible on the public roadmap.</h2>
        <p>@signalLoop.ClaimedMilestoneCount active now. @signalLoop.HighDifficultyMilestoneCount larger slice@(signalLoop.HighDifficultyMilestoneCount == 1 ? string.Empty : "s") still need more work before they become present-tense promises.</p>
        <a class="button-like button-like--ghost" href="/roadmap#roadmap-milestones">Open roadmap</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag">Shipped today</span>
        <h2>@signalLoop.ShippedFollowUpCount live example@(signalLoop.ShippedFollowUpCount == 1 ? string.Empty : "s") already show what people can use now.</h2>
        <p>When the question is what works today, switch to the changelog and current proof instead of staying on the feedback page.</p>
        <a class="button-like button-like--ghost" href="/changelog">Open changelog</a>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag">Private help</span>
        <h2>Move off this page as soon as the issue needs logs, recovery, or account detail.</h2>
        <p>Public feedback works best when private support work stays on the help path.</p>
        <a class="button-like button-like--ghost" href="/help">Open help</a>
    </article>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Pick the right page</p>
        <h2 class="editorial-title">Public signal, roadmap direction, shipped proof, and private support should not blur together.</h2>
        <p class="editorial-copy">The experience is calmer when each job has one page and one promise. Feedback starts the conversation; it is not the shipped status page or the private support inbox.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var choice in routeChoices)
        {
            <article class="route-choice-card">
                <span class="tag">@choice.Badge</span>
                <h3>@choice.Title</h3>
                <p>@choice.Summary</p>
                <div class="route-choice-card__proof">
                    @foreach (var item in choice.Proof)
                    {
                        <span>@item</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@choice.Href">@choice.Label</a>
            </article>
        }
    </div>
</section>

<section class="workflow-band">
    <div class="workflow-band__lead">
        <p class="eyebrow">Signal loop</p>
        <h2 class="editorial-title">A public signal should start in one place and end on a page people can actually use.</h2>
        <p class="editorial-copy">This keeps public feedback visible without pretending that comments are the same thing as roadmap commitments, shipped proof, or private support. Public feedback can still show demand, but account-backed follow-up stays off until shipped proof and first-party closeout receipts are both real on this host.</p>
    </div>
    <div class="workflow-grid">
        @foreach (var stage in signalStages)
        {
            <article class="workflow-card">
                <div class="workflow-card__copy">
                    <span class="tag">@stage.Badge</span>
                    <h3>@stage.Title</h3>
                    <p>@stage.Summary</p>
                    <p class="workflow-card__proof">@stage.Proof</p>
                    <a class="inline-link" href="@stage.Href">@stage.Label</a>
                </div>
            </article>
        }
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Closeout posture</p>
        <h2 class="editorial-title">Shipped follow-through stays upstream of public celebration.</h2>
        <p class="editorial-copy">First-party follow-up is still preview-only on this host. The public board can show demand now, but shipped follow-through only lands after shipped proof and first-party receipts agree.</p>
    </div>
</section>

<section class="status-decision-strip" aria-label="Public signal operating rules">
    @foreach (var rail in operatingRails)
    {
        <article class="status-decision-strip__card">
            <span class="tag">@rail.Badge</span>
            <h2>@rail.Title</h2>
            <p>@rail.Summary</p>
            <a class="button-like button-like--ghost" href="@rail.Href">@rail.Label</a>
        </article>
    }
</section>

<section class="editorial-block editorial-block--lanes" id="feedback-public-lanes">
    <div class="lane-strip-list">
        <article class="lane-strip">
            <div class="lane-strip__copy">
                <span class="tag">Current public pages</span>
                <h2>Safe public signal starts here</h2>
                <p>These first-party pages keep feedback visible and easy to follow without bouncing people across aliases or private support paths.</p>
                <div class="compact-rail">
                    @foreach (var card in Model.PublicLane)
                    {
                        var sectionId = card.Action.Href.Contains('#', StringComparison.Ordinal)
                            ? card.Action.Href[(card.Action.Href.LastIndexOf('#') + 1)..]
                            : card.Card.Id.Replace('_', '-');
                        <article class="compact-rail__item" id="@sectionId">
                            <div class="compact-rail__copy">
                                <h3>@card.Card.Title</h3>
                                <p>@card.Card.Summary</p>
                            </div>
                            <a class="editorial-strip__action" href="@card.Action.Href">@card.Action.Label</a>
                        </article>
                    }
                </div>
            </div>
        </article>

        <article class="lane-strip">
            <div class="lane-strip__copy">
                <span class="tag">Deeper participation</span>
                <h2>Signed-in contribution lanes stay optional</h2>
                <p>Public product signal should work without turning this page into a contributor-only or account-gated surface. Signed-in participation remains available when you need the deeper path.</p>
                <div class="stacked-actions">
                    <a class="button-like button-like--secondary" href="/participate">Open guided contribution</a>
                    <a class="button-like button-like--ghost" href="/participate">Open broader participation</a>
                </div>
                @if (Model.SignedInLane.Count > 0)
                {
                    <div class="compact-rail">
                        @foreach (var card in Model.SignedInLane)
                        {
                            <article class="compact-rail__item">
                                <div class="compact-rail__copy">
                                    <h3>@card.Card.Title</h3>
                                    <p>@card.Card.Summary</p>
                                </div>
                                <a class="editorial-strip__action" href="@card.Action.Href">@card.Action.Label</a>
                            </article>
                        }
                    </div>
                }
            </div>
        </article>
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Follow-through</p>
        <h2 class="editorial-title">One public signal should connect to a roadmap page, a shipped page, or a help page.</h2>
        <p class="editorial-copy">Public feedback stays first-party. Follow-through can stay visible without turning this page into an operations board.</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">Roadmap</span>
            <h3>What active product movement looks like right now</h3>
            <p>Signals that matter should turn into named roadmap movement instead of vague comment-thread promises.</p>
            @if (milestoneFollowUp.Length > 0)
            {
                <div class="compact-rail">
                    @foreach (var milestone in milestoneFollowUp)
                    {
                        <article class="compact-rail__item">
                            <div class="compact-rail__copy">
                                <h3>@($"Milestone {milestone.Id}") · @milestone.Title</h3>
                                <p>@milestone.CasualSummary</p>
                            </div>
                            <span class="tag">@milestone.StatusLabel · @milestone.DifficultyLabel</span>
                        </article>
                    }
                </div>
            }
            <a class="editorial-strip__action" href="/roadmap#roadmap-milestones">Open roadmap</a>
        </article>
        <article class="route-choice-card">
            <span class="tag">What might come next</span>
            <h3>What public movement looks like before anything is called shipped</h3>
            <p>The next public explanation should land on a named horizon with a truthful next page, not as a promise buried in feedback replies.</p>
            @if (roadmapFollowUp.Length > 0)
            {
                <div class="compact-rail">
                    @foreach (var card in roadmapFollowUp)
                    {
                        <article class="compact-rail__item">
                            <div class="compact-rail__copy">
                                <h3>@card.Card.Title</h3>
                                <p>@card.Card.Summary</p>
                            </div>
                            <a class="editorial-strip__action" href="@card.Action.Href">@card.Action.Label</a>
                        </article>
                    }
                </div>
            }
            <a class="editorial-strip__action" href="/roadmap#roadmap-horizons">Browse roadmap</a>
        </article>
        <article class="route-choice-card">
            <span class="tag">What works today</span>
            <h3>What a real shipped example already looks like</h3>
            <p>Public signal only closes when a release, live page, or guide lets a person actually reach the result. That evidence lives here, not in a vote count.</p>
            @if (shippedFollowUp.Length > 0)
            {
                <div class="compact-rail">
                    @foreach (var card in shippedFollowUp)
                    {
                        <article class="compact-rail__item">
                            <div class="compact-rail__copy">
                                <h3>@card.Card.Title</h3>
                                <p>@card.Card.Summary</p>
                            </div>
                            <a class="editorial-strip__action" href="@card.Action.Href">@card.Action.Label</a>
                        </article>
                    }
                </div>
            }
            <a class="editorial-strip__action" href="/changelog">Open changelog</a>
        </article>
    </div>
</section>

<section class="release-footnote">
    <p class="eyebrow">Account-aware follow-up</p>
    <h2 class="editorial-title">Create the account when you want signal, installs, support, and roadmap follow-up to return to one place.</h2>
    <p class="editorial-copy">The public board still works without an account. The account becomes useful once you want device continuity, support return, roadmap follows, and future install linking attached to one calmer place.</p>
    <div class="stacked-actions">
        <a class="cta-link cta-link--primary" href="@followSettingsHref">@followSettingsLabel</a>
        <a class="cta-link cta-link--secondary" href="/roadmap">Open roadmap</a>
        <a class="cta-link cta-link--ghost" href="/help">Open help</a>
    </div>
    <p class="muted-copy">Truth stays split on purpose: <a class="inline-link" href="/feedback">public signal</a>, <a class="inline-link" href="/roadmap">projected movement</a>, <a class="inline-link" href="/changelog">shipped updates</a>, and <a class="inline-link" href="/help">private follow-up</a>.</p>
</section>

@model DownloadsPageViewModel
@{
    ViewData["Title"] = "Downloads";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-downloads surface-minimal";

    var release = Model.ReleaseExperience;
    var recommended = release.Recommended;
    var requestedPlatformUnavailable = !release.RequestedPlatformHasPublicDownload
        && !string.IsNullOrWhiteSpace(release.RequestedPlatformLabel);
    var currentReleaseIsNightlyHandoff = IsNightlyHandoff(Model.Manifest.Channel, Model.Manifest.Version, Model.Manifest.RolloutState);
    var stable = requestedPlatformUnavailable || currentReleaseIsNightlyHandoff ? null : recommended;
    var nightly = currentReleaseIsNightlyHandoff && !requestedPlatformUnavailable ? recommended : release.Alternatives
        .Where(option => stable is null || !string.Equals(option.Artifact.Id, stable.Artifact.Id, StringComparison.OrdinalIgnoreCase))
        .FirstOrDefault(IsNightly);
    var stableAndNightlyMatch = stable is not null
        && nightly is not null
        && string.Equals(stable.Artifact.Id, nightly.Artifact.Id, StringComparison.OrdinalIgnoreCase);
    var otherPlatformOptions = release.OtherPlatforms
        .Concat(requestedPlatformUnavailable && recommended is not null ? new[] { recommended } : Array.Empty<ReleaseOptionViewModel>())
        .Concat(release.ManualPackages)
        .Where(option => stable is null || !string.Equals(option.Artifact.Id, stable.Artifact.Id, StringComparison.OrdinalIgnoreCase))
        .Where(option => nightly is null || !string.Equals(option.Artifact.Id, nightly.Artifact.Id, StringComparison.OrdinalIgnoreCase))
        .ToArray();
    var sourceScriptHref = "/downloads/build-chummer6-linux.sh";
    var showLinuxSourcePrimary = !string.IsNullOrWhiteSpace(sourceScriptHref);
    var hasOtherDownloads = showLinuxSourcePrimary || otherPlatformOptions.Length > 0;
    var releaseNeedsReview = string.Equals(Model.Manifest.SupportabilityState, "review_required", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.Manifest.RolloutState, "readiness_review_required", StringComparison.OrdinalIgnoreCase);
    var releaseMarkerText = string.IsNullOrWhiteSpace(Model.Manifest.Version)
        ? "Version unpublished"
        : $"Version {Model.Manifest.Version}";
    var releaseVersionText = PublicReleaseVersionLabel(Model.Manifest.Version);
    var stableHeading = stable is null
        ? currentReleaseIsNightlyHandoff && !requestedPlatformUnavailable ? "Not promoted here" : $"{release.RequestedPlatformLabel} unavailable"
        : stable.PlatformLabel;
    var stableSummary = stable is null
        ? currentReleaseIsNightlyHandoff && !requestedPlatformUnavailable
            ? "Stable release is unchanged while this nightly handoff is under review."
            : "Stable release is not available for this platform yet."
        : "Stable release.";
    var stableFallbackHref = currentReleaseIsNightlyHandoff && nightly is not null ? "#nightly" : "#other-downloads";
    var stableFallbackLabel = currentReleaseIsNightlyHandoff && nightly is not null ? "Use Nightly" : "Other downloads";
    var nightlyHeading = nightly is null || stableAndNightlyMatch ? "No newer build" : nightly.PlatformLabel;
    var nightlySummary = nightly is null || stableAndNightlyMatch
        ? "No newer Nightly right now."
        : currentReleaseIsNightlyHandoff ? "Nightly handoff. Stable release is unchanged." : "Newer than Stable.";
    static string PublicDownloadText(string? value) => UndetectableHumanizerCopyAdapter.Humanize(value);

    static string PublicReleaseVersionLabel(string? version)
    {
        var normalized = version?.Trim();
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return "Version unavailable";
        }

        if (normalized.StartsWith("run-", StringComparison.OrdinalIgnoreCase) && normalized.Length >= 12)
        {
            var stamp = normalized.Substring(4, 8);
            if (stamp.All(char.IsDigit))
            {
                return $"Nightly {stamp.Substring(0, 4)}.{stamp.Substring(4, 2)}.{stamp.Substring(6, 2)}";
            }

            return "Nightly build";
        }

        return $"Version {normalized}";
    }

    static string PlatformId(ReleaseOptionViewModel? option)
    {
        if (option is null)
        {
            return "unknown";
        }

        var platformId = option.Artifact.PlatformId ?? string.Empty;
        if (platformId.Contains("win", StringComparison.OrdinalIgnoreCase))
        {
            return "windows";
        }

        if (platformId.Contains("linux", StringComparison.OrdinalIgnoreCase))
        {
            return "linux";
        }

        if (platformId.Contains("osx", StringComparison.OrdinalIgnoreCase)
            || platformId.Contains("mac", StringComparison.OrdinalIgnoreCase))
        {
            return "macos";
        }

        return string.IsNullOrWhiteSpace(platformId) ? "unknown" : platformId.Trim().ToLowerInvariant();
    }

    static string ButtonText(ReleaseOptionViewModel option)
        => string.IsNullOrWhiteSpace(option.PlatformLabel)
            ? "Download"
            : $"Download for {option.PlatformLabel}";

    static bool IsNightly(ReleaseOptionViewModel option)
    {
        foreach (var value in new[]
                 {
                     option.Artifact.Channel,
                     option.Artifact.ChannelId,
                     option.Artifact.Id,
                     option.Artifact.Version,
                     option.Title,
                     option.HeadLabel
                 })
        {
            if (!string.IsNullOrWhiteSpace(value)
                && value.Contains("nightly", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }

    static bool IsNightlyHandoff(string? channel, string? version, string? rolloutState)
    {
        var normalizedChannel = channel?.Trim();
        var normalizedVersion = version?.Trim();
        var normalizedRollout = rolloutState?.Trim();
        return string.Equals(normalizedChannel, "nightly", StringComparison.OrdinalIgnoreCase)
            || string.Equals(normalizedChannel, "preview", StringComparison.OrdinalIgnoreCase)
            || string.Equals(normalizedRollout, "promoted_preview", StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrWhiteSpace(normalizedVersion)
                && normalizedVersion.StartsWith("run-", StringComparison.OrdinalIgnoreCase));
    }
}

<section class="minimal-page-hero downloads-simple-hero">
    <div>
        <h1>Downloads</h1>
        <p>Download Chummer from the current release page. Chummer selects the best installer when it can. Other downloads stay below.</p>
        <p class="downloads-release-version">@releaseVersionText</p>
        <span data-downloads-release-version hidden>@releaseMarkerText</span>
        @if (releaseNeedsReview)
        {
            <p class="muted-copy"><strong>Current note:</strong> Current installers remain available, but wider readiness is under review. Use Help if setup blocks your table.</p>
        }
        <p class="muted-copy">Sign in later only if you want to attach this installed copy to your account.</p>
    </div>
</section>

@if (Model.Manifest.Downloads.Count == 0)
{
    <section class="minimal-empty">
        <h2>No build is available right now</h2>
        <p>@PublicDownloadText(Model.Manifest.Message)</p>
        <a class="button-like button-like--primary" href="/help">Help</a>
    </section>
}
else
{
    <section class="downloads-choice-list minimal-lane-grid" aria-label="Downloads">
        <article class="downloads-choice-card" id="stable">
            <div>
                <span>Stable</span>
                <h2>@stableHeading</h2>
                <p>@stableSummary</p>
            </div>
            @if (stable is null)
            {
                <a class="button-like button-like--primary" href="@stableFallbackHref">@stableFallbackLabel</a>
            }
            else
            {
                <a class="button-like button-like--primary"
                   href="@stable.DispatchHref"
                   data-download-action="download-artifact"
                   data-download-artifact="@stable.Artifact.Id"
                   data-download-platform="@PlatformId(stable)"
                   data-download-raw-url="@stable.DirectFileHref"
                   data-download-install-route="/downloads/install/@Uri.EscapeDataString(stable.Artifact.Id)"
                   data-download-link-mode="raw-url"
                   data-release-lane="stable"
                   data-platform="@PlatformId(stable)"
                   data-analytics-event="downloads_stable_install"
                   data-analytics-surface="minimal_downloads"
                   data-analytics-label="@stable.PlatformLabel">@ButtonText(stable)</a>
            }
        </article>

        <article class="downloads-choice-card" id="nightly">
            <div>
                <span>Nightly</span>
                <h2>@nightlyHeading</h2>
                <p>@nightlySummary</p>
            </div>
            @if (nightly is null || stableAndNightlyMatch)
            {
                <a class="button-like button-like--secondary" href="@(stable is null ? "#other-downloads" : "#stable")">@(stable is null ? "Other downloads" : "Use Stable")</a>
            }
            else
            {
                <a class="button-like button-like--secondary"
                   href="@nightly.DispatchHref"
                   data-download-action="download-artifact"
                   data-download-artifact="@nightly.Artifact.Id"
                   data-download-platform="@PlatformId(nightly)"
                   data-download-raw-url="@nightly.DirectFileHref"
                   data-download-install-route="/downloads/install/@Uri.EscapeDataString(nightly.Artifact.Id)"
                   data-download-link-mode="raw-url"
                   data-release-lane="nightly"
                   data-platform="@PlatformId(nightly)"
                   data-analytics-event="downloads_nightly_install"
                   data-analytics-surface="minimal_downloads"
                   data-analytics-label="@nightly.PlatformLabel">@ButtonText(nightly)</a>
            }
        </article>

    </section>

    @if (hasOtherDownloads)
    {
        <details class="details-drawer downloads-other-platforms" id="other-downloads">
            <summary>Other downloads</summary>
            <div class="downloads-choice-list downloads-choice-list--collapsed minimal-lane-grid" aria-label="Other downloads">
                <article class="downloads-choice-card" id="linux-source">
                    <div>
                        <span>Linux</span>
                        <h2>Build from source</h2>
                        <p>No sudo. Updates default to notify.</p>
                    </div>
                    @if (showLinuxSourcePrimary)
                    {
                        <a class="button-like button-like--ghost"
                           href="@sourceScriptHref"
                           download
                           data-analytics-event="downloads_linux_source_script"
                           data-analytics-surface="minimal_downloads"
                           data-analytics-label="build-chummer6-linux.sh">Download script</a>
                    }
                </article>

                @foreach (var option in otherPlatformOptions)
                {
                    <article class="downloads-choice-card">
                        <div>
                            <span>@option.PlatformLabel</span>
                            <h2>@option.HeadLabel</h2>
                            <p>Only if you need this platform.</p>
                        </div>
                        <a class="button-like button-like--ghost"
                           href="@option.DispatchHref"
                           data-download-action="download-artifact"
                           data-download-artifact="@option.Artifact.Id"
                           data-download-platform="@PlatformId(option)"
                           data-download-raw-url="@option.DirectFileHref"
                           data-download-install-route="/downloads/install/@Uri.EscapeDataString(option.Artifact.Id)"
                           data-download-link-mode="raw-url"
                           data-release-lane="other"
                           data-platform="@PlatformId(option)"
                           data-analytics-event="downloads_other_install"
                           data-analytics-surface="minimal_downloads"
                           data-analytics-label="@option.PlatformLabel">@ButtonText(option)</a>
                    </article>
                }
            </div>
        </details>
    }
}

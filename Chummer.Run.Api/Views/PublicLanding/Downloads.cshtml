@model DownloadsPageViewModel
@{
    ViewData["Title"] = "Downloads";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-downloads";
    var release = Model.ReleaseExperience;
    var guestGateRequired = !Model.Chrome.Authenticated && release.Recommended?.RequiresAccount == true;
    var platformShelfNotice = !string.IsNullOrWhiteSpace(release.PlatformShelfNoticeSummary);
}

<section class="release-stage">
    <div class="release-stage__lead">
        <p class="eyebrow">Downloads</p>
        <h1 class="page-title">Install the current preview</h1>
        <p class="page-copy">
            @(platformShelfNotice
                ? "This device platform is not on the current public shelf. Read the current platform note before treating the preview as installable on this machine."
                : "Start with the recommended installer for this device. Release details and advanced packages stay underneath so the first decision stays simple.")
        </p>
        <p class="release-stage__note">
            @(platformShelfNotice
                ? release.PlatformShelfNoticeSummary
                : guestGateRequired
                ? release.GuestGateSummary
                : "Use the recommended installer first. Everything else stays collapsed underneath unless you know you need it.")
        </p>
        @if (platformShelfNotice)
        {
            <div class="release-stage__note">
                <strong>@release.PlatformShelfNoticeTitle</strong>
            </div>
        }
    </div>
</section>

@if (Model.Manifest.Downloads.Count == 0 || release.Recommended is null)
{
    <section class="release-shelf">
        <article class="release-empty">
            <h2>No published build is on the shelf yet</h2>
            <p>@Model.Manifest.Message</p>
            <div class="stacked-actions">
                <a class="button-like button-like--primary" href="@release.NoBuildPrimaryHref">@release.NoBuildPrimaryLabel</a>
                <a class="button-like button-like--secondary" href="/now">See what works today</a>
            </div>
        </article>
    </section>
}
else
{
    <section class="recommended-download" id="recommended-download">
        <article class="recommended-download__card">
            <div class="recommended-download__copy">
                <span class="tag">@(guestGateRequired ? release.GuestGateHeading : "Recommended")</span>
                <h2>@release.Recommended.Title</h2>
                <p>Use the recommended installer first. Release detail, alternate packages, and manual paths stay collapsed underneath.</p>
                <p class="muted-copy">@release.Display.ChannelLabel · @release.Display.BuildLabel · @release.Display.PublishedLabel</p>
                <div class="recommended-download__meta">
                    <span>@release.Recommended.PlatformLabel</span>
                </div>
                <div class="stacked-actions">
                    @if (guestGateRequired)
                    {
                        <a class="button-like button-like--primary" href="@release.GuestGatePrimaryHref">@release.GuestGatePrimaryLabel</a>
                        <a class="button-like button-like--secondary" href="@release.GuestGateSecondaryHref">@release.GuestGateSecondaryLabel</a>
                    }
                    else
                    {
                        <a class="button-like button-like--primary" href="@release.Recommended.DispatchHref">@release.Recommended.ActionLabel</a>
                        @if (!Model.Chrome.Authenticated)
                        {
                            <a class="button-like button-like--secondary" href="/login?next=@Uri.EscapeDataString("/downloads")">Already have an account? Sign in</a>
                        }
                    }
                </div>
                <p class="muted-copy"><a class="quiet-link" href="@release.InstallHelpHref">@release.InstallHelpLabel</a></p>
                <details class="details-drawer">
                    <summary>Release notes, known issues, and requirements</summary>
                    <div class="settings-summary-list">
                        <div class="settings-summary-row">
                            <span>Release notes</span>
                            <strong>@release.ReleaseNotesSummary</strong>
                        </div>
                        <div class="settings-summary-row">
                            <span>Known issues</span>
                            <strong>@(Model.Manifest.KnownIssueSummary ?? "Check the install and trust lane before you commit a fresh device to this preview.")</strong>
                        </div>
                        <div class="settings-summary-row">
                            <span>Update posture</span>
                            <strong>@release.UpdatePostureSummary</strong>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.Manifest.SupportabilitySummary))
                        {
                            <div class="settings-summary-row">
                                <span>Supportability</span>
                                <strong>@Model.Manifest.SupportabilitySummary</strong>
                            </div>
                        }
                        <div class="settings-summary-row">
                            <span>Install path</span>
                            <strong>@release.Recommended.SupportLine</strong>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.Manifest.FixAvailabilitySummary))
                        {
                            <div class="settings-summary-row">
                                <span>Fix availability</span>
                                <strong>@Model.Manifest.FixAvailabilitySummary</strong>
                            </div>
                        }
                        <div class="settings-summary-row">
                            <span>System requirements</span>
                            <strong>@string.Join(" ", release.SystemRequirements)</strong>
                        </div>
                    </div>
                    <div class="settings-summary-list">
                        <div class="settings-summary-row">
                            <span>Package size</span>
                            <strong>@release.Recommended.SizeLabel</strong>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(release.Recommended.ShaPreview))
                        {
                            <div class="settings-summary-row">
                                <span>Integrity preview</span>
                                <strong><code class="mono-receipt">@release.Recommended.ShaPreview</code></strong>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Manifest.RolloutReason))
                        {
                            <div class="settings-summary-row">
                                <span>Release posture</span>
                                <strong>@Model.Manifest.RolloutReason</strong>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Manifest.ProofStatus))
                        {
                            <div class="settings-summary-row">
                                <span>Local release proof</span>
                                <strong>
                                    @Model.Manifest.ProofStatus
                                    @if (Model.Manifest.ProofGeneratedAt is not null)
                                    {
                                        <text> · @Model.Manifest.ProofGeneratedAt.Value.ToUniversalTime().ToString("yyyy-MM-dd HH:mm 'UTC'")</text>
                                    }
                                </strong>
                            </div>
                        }
                    </div>
                    <div class="stacked-actions">
                        <a class="button-like button-like--ghost" href="/now">Open current release</a>
                        <a class="button-like button-like--ghost" href="@release.KnownIssuesHref">@release.KnownIssuesLabel</a>
                    </div>
                </details>
            </div>
        </article>
    </section>

    @if (release.Alternatives.Count > 0 || release.OtherPlatforms.Count > 0 || release.ManualPackages.Count > 0)
    {
        <section class="release-shelf release-shelf--manual">
            <details class="release-accordion">
                <summary>Advanced download options</summary>
                <div class="release-accordion__body">
                    @if (release.Alternatives.Count > 0)
                    {
                        <details class="details-drawer">
                            <summary>More options for @release.Recommended.PlatformLabel</summary>
                            <div class="evidence-row-list">
                                @foreach (var download in release.Alternatives)
                                {
                                    <article class="evidence-row evidence-row--download">
                                        <div class="evidence-row__copy">
                                            <h3>@download.Title</h3>
                                            <p>@download.SupportLine</p>
                                        </div>
                                        <div class="download-row__meta">
                                            <span class="platform-pill">@download.SizeLabel</span>
                                            @if (!string.IsNullOrWhiteSpace(download.ShaPreview))
                                            {
                                                <code class="mono-receipt">@download.ShaPreview</code>
                                            }
                                        </div>
                                        <a class="button-like button-like--ghost" href="@download.DispatchHref">@download.ActionLabel</a>
                                    </article>
                                }
                            </div>
                        </details>
                    }

                    @if (release.OtherPlatforms.Count > 0)
                    {
                        <details class="details-drawer">
                            <summary>Other platforms</summary>
                            <div class="evidence-row-list">
                                @foreach (var download in release.OtherPlatforms)
                                {
                                    <article class="evidence-row evidence-row--download">
                                        <div class="evidence-row__copy">
                                            <h3>@download.Title</h3>
                                            <p>@download.SupportLine</p>
                                        </div>
                                        <div class="download-row__meta">
                                            <span class="platform-pill">@download.PlatformLabel</span>
                                            <span class="muted-copy">@download.SizeLabel</span>
                                        </div>
                                        <a class="button-like button-like--ghost" href="@download.DispatchHref">@download.ActionLabel</a>
                                    </article>
                                }
                            </div>
                        </details>
                    }

                    @if (release.ManualPackages.Count > 0)
                    {
                        <details class="details-drawer">
                            <summary>Manual packages for advanced installs</summary>
                            <div class="evidence-row-list">
                                @foreach (var download in release.ManualPackages)
                                {
                                    <article class="evidence-row evidence-row--download">
                                        <div class="evidence-row__copy">
                                            <h3>@download.Title</h3>
                                            <p>@download.SupportLine</p>
                                        </div>
                                        <div class="download-row__meta">
                                            <span class="platform-pill">@download.PlatformLabel</span>
                                            <span class="muted-copy">@download.SizeLabel</span>
                                        </div>
                                        <a class="button-like button-like--ghost" href="@download.DispatchHref">@download.ActionLabel</a>
                                    </article>
                                }
                            </div>
                        </details>
                    }
                </div>
            </details>
        </section>
    }
}

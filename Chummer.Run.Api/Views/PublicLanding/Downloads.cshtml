@model DownloadsPageViewModel
@{
    ViewData["Title"] = "Downloads";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-downloads";
    var release = Model.ReleaseExperience;
    var guestGateRequired = !Model.Chrome.Authenticated && release.Recommended?.RequiresAccount == true;
    var recommendedIsInstaller = release.Recommended?.Installer == true;
    var platformShelfNotice = !string.IsNullOrWhiteSpace(release.PlatformShelfNoticeSummary);
    var requestedPlatformUnavailable = platformShelfNotice && !release.RequestedPlatformHasPublicDownload;
    var deviceLabel = release.RequestedPlatformLabel ?? "this device";
    var signedInWindowsBuilds = Model.SignedInWindowsBuilds ?? Array.Empty<ReleaseOptionViewModel>();
    var hasSignedInWindowsBuilds = Model.Chrome.Authenticated && signedInWindowsBuilds.Count > 0;
    var windowsProofInstallers = Model.WindowsProofInstallers ?? Array.Empty<WindowsProofInstallerRecord>();
    var hasWindowsProofRail = windowsProofInstallers.Count > 0;
    var requestedWindowsUnavailable = requestedPlatformUnavailable && string.Equals(deviceLabel, "Windows", StringComparison.OrdinalIgnoreCase);
    var hasAdvancedDownloads = release.Alternatives.Count > 0 || release.OtherPlatforms.Count > 0 || release.ManualPackages.Count > 0;
    var showPlatformShelf = release.PlatformAvailability.Count > 0;
    var hasAdvancedPanels = hasAdvancedDownloads || hasSignedInWindowsBuilds || hasWindowsProofRail;
    var returningUserLabel = Model.Chrome.Authenticated ? "Open devices and access" : "Already have an account? Sign in";
    var returningUserHref = Model.Chrome.Authenticated ? "/account/access" : "/auth/google/start?next=%2Fdownloads";
    var optionPool = (release.Recommended is null ? Enumerable.Empty<ReleaseOptionViewModel>() : new[] { release.Recommended })
        .Concat(release.Alternatives)
        .Concat(release.OtherPlatforms)
        .Concat(release.ManualPackages)
        .ToArray();

    static bool MatchesPlatform(PublicReleaseArtifactDto artifact, string platformId)
    {
        var candidatePlatformId = artifact.PlatformId ?? string.Empty;
        var candidatePlatform = artifact.Platform ?? string.Empty;
        return platformId switch
        {
            "windows" => candidatePlatformId.Contains("win", StringComparison.OrdinalIgnoreCase)
                || candidatePlatform.Contains("Windows", StringComparison.OrdinalIgnoreCase),
            "linux" => candidatePlatformId.Contains("linux", StringComparison.OrdinalIgnoreCase)
                || candidatePlatform.Contains("Linux", StringComparison.OrdinalIgnoreCase),
            "macos" => candidatePlatformId.Contains("osx", StringComparison.OrdinalIgnoreCase)
                || candidatePlatformId.Contains("mac", StringComparison.OrdinalIgnoreCase)
                || candidatePlatform.Contains("mac", StringComparison.OrdinalIgnoreCase),
            _ => false
        };
    }

    ReleaseOptionViewModel? ResolvePlatformOption(string platformId)
        => optionPool.FirstOrDefault(option => MatchesPlatform(option.Artifact, platformId));

    var recommendedUsesMacSetupScript = release.Recommended is not null && MatchesPlatform(release.Recommended.Artifact, "macos");
}

<section class="release-stage">
    <div class="release-stage__lead">
        <p class="eyebrow">Downloads</p>
        <h1 class="page-title">Install Chummer</h1>
        <p class="page-copy">
            @(requestedPlatformUnavailable
                ? $"This browser looks like {deviceLabel}, but that platform is not on the current public shelf yet."
                : $"This browser looks like {deviceLabel}. Start with the recommended build for that platform.")
        </p>
        <p class="release-stage__note">
            @(platformShelfNotice
                ? requestedWindowsUnavailable && hasSignedInWindowsBuilds
                    ? "Windows is not promoted for guests on the current public shelf, but signed-in users can still open the latest Windows build below."
                    : requestedWindowsUnavailable && hasWindowsProofRail
                        ? "Windows is not promoted for this browser on the current public shelf. Check the main platform downloads below, and use the Windows verification page only if support points you there."
                    : release.PlatformShelfNoticeSummary
                : recommendedUsesMacSetupScript
                        ? "On macOS, the default path is the signed-in setup handoff. It gives you one Terminal command for this install."
                    : guestGateRequired
                        ? release.GuestGateSummary
                        : "Other platforms stay on the main platform downloads shelf below. Manual packages and technical detail stay collapsed underneath.")
        </p>
    </div>
</section>

@if (Model.Manifest.Downloads.Count == 0 || release.Recommended is null)
{
    <section class="release-shelf">
        <article class="release-empty">
            <h2>No published build is on the shelf yet</h2>
            <p>@Model.Manifest.Message</p>
            <div class="stacked-actions">
                <a class="button-like button-like--primary" href="@release.NoBuildPrimaryHref">@release.NoBuildPrimaryLabel</a>
                <a class="button-like button-like--secondary" href="/now">See what works today</a>
            </div>
        </article>
    </section>
}
else
{
    <section class="recommended-download" id="recommended-download">
        <article class="recommended-download__card">
            <div class="recommended-download__copy">
                <span class="tag">
                    @(requestedPlatformUnavailable
                        ? $"No public {deviceLabel} build"
                        : release.RequestedPlatformLabel is null
                            ? "Recommended"
                            : $"Recommended for {deviceLabel}")
                </span>
                <h2>@(requestedPlatformUnavailable ? $"This browser looks like {deviceLabel}" : release.Recommended.Title)</h2>
                <p>@(requestedPlatformUnavailable ? release.PlatformShelfNoticeSummary : release.Recommended.SupportLine)</p>
                <div class="recommended-download__meta">
                    <span>@(requestedPlatformUnavailable ? (release.RequestedPlatformLabel ?? "Platform note") : release.Recommended.PlatformLabel)</span>
                    @if (!requestedPlatformUnavailable)
                    {
                        <span>@release.Recommended.SizeLabel</span>
                    }
                    <span>@(recommendedIsInstaller ? "Install path" : "Download path")</span>
                    <span>@release.Display.BuildLabel</span>
                    <span>@release.Display.PublishedLabel</span>
                </div>
                <div class="recommended-download__trustrail" aria-label="Install continuity facts">
                    <article class="recommended-download__trustfact">
                        <span>Binary</span>
                        <strong>The same build for everyone</strong>
                        <p>Account-aware install value lives in the handoff, not in a personalized binary.</p>
                    </article>
                    <article class="recommended-download__trustfact">
                        <span>First launch</span>
                        <strong>Guest or link this copy</strong>
                        <p>The app can still start as guest or attach this installed copy to your account when you are ready.</p>
                    </article>
                    <article class="recommended-download__trustfact">
                        <span>Recovery path</span>
                        <strong>Devices and access stay calm</strong>
                        <p>Relink, reclaim, and recovery belong on the account page after the installer or app does the real work.</p>
                    </article>
                </div>
                <div class="stacked-actions">
                    @if (requestedPlatformUnavailable)
                    {
                        <a class="button-like button-like--primary" href="@release.InstallHelpHref">@release.InstallHelpLabel</a>
                        <a class="button-like button-like--secondary" href="#platform-shelf">See other platforms</a>
                        @if (requestedWindowsUnavailable && hasSignedInWindowsBuilds)
                        {
                            <a class="button-like button-like--ghost" href="#signed-in-windows-builds">Open signed-in Windows build</a>
                        }
                        else if (requestedWindowsUnavailable && hasWindowsProofRail)
                        {
                            <a class="button-like button-like--ghost" href="#windows-verification-rail">Open Windows verification page</a>
                        }
                        <details class="release-accordion">
                            <summary>Release notes, known issues, and requirements</summary>
                            <div class="release-accordion__body">
                                <p class="muted-copy">This platform is not on the current public shelf, but the release notes, known issues, and install help still stay attached to the same downloads page.</p>
                                <div class="stacked-actions">
                                    <a class="button-like button-like--ghost" href="/now">Open current release</a>
                                    <a class="button-like button-like--ghost" href="@release.KnownIssuesHref">@release.KnownIssuesLabel</a>
                                    <a class="button-like button-like--ghost" href="@release.InstallHelpHref">@release.InstallHelpLabel</a>
                                </div>
                            </div>
                        </details>
                    }
                    else if (guestGateRequired)
                    {
                        <a class="button-like button-like--primary" href="@release.Recommended.DispatchHref">@release.Recommended.ActionLabel</a>
                        <a class="button-like button-like--secondary" href="@returningUserHref">@returningUserLabel</a>
                        <a class="button-like button-like--ghost" href="@release.InstallHelpHref">@release.InstallHelpLabel</a>
                    }
                    else
                    {
                        <a class="button-like button-like--primary" href="@release.Recommended.DispatchHref">@release.Recommended.ActionLabel</a>
                        <a class="button-like button-like--secondary" href="@returningUserHref">@returningUserLabel</a>
                        <a class="button-like button-like--ghost" href="@release.InstallHelpHref">@release.InstallHelpLabel</a>
                    }
                </div>
                @if (!requestedPlatformUnavailable)
                {
                    <p class="downloads-inline-note">
                        @(recommendedUsesMacSetupScript
                            ? "Open the Mac setup handoff, copy the Terminal command, and run it in Terminal."
                            : "After install, open Chummer and use Load Demo Runner to inspect the bundled Soma-Career.chum5 sample before starting blank.")
                    </p>
                    <details class="release-accordion">
                        <summary>Release notes, known issues, and requirements</summary>
                        <div class="release-accordion__body">
                            <p class="muted-copy">Known issues and install help stay nearby. Deeper release evidence lives on the current-release and status surfaces, not in front of the install button.</p>
                            <p class="muted-copy">Release notes and known issues stay tied to this shelf, so install confidence remains truthful even while release shelves evolve.</p>
                            <div class="stacked-actions">
                                <a class="button-like button-like--ghost" href="/now">Open current release</a>
                                <a class="button-like button-like--ghost" href="@release.KnownIssuesHref">@release.KnownIssuesLabel</a>
                                <a class="button-like button-like--ghost" href="@release.InstallHelpHref">@release.InstallHelpLabel</a>
                            </div>
                        </div>
                    </details>
                }
                @if (hasAdvancedPanels)
                {
                    <p class="downloads-advanced-link">
                        <a class="inline-link" href="#advanced-downloads">Advanced download options</a>
                    </p>
                }
            </div>
        </article>
    </section>

    @if (showPlatformShelf)
    {
        <section class="release-shelf" id="platform-shelf">
            <details class="release-accordion">
                <summary>Other supported platforms</summary>
                <div class="release-accordion__body">
                    <div class="downloads-advanced-group">
                        <h2 class="downloads-subheading">Main platform downloads</h2>
                        <p class="muted-copy">Published installers for each supported platform stay available here, but the main page keeps the first decision focused on one install path.</p>
                        <div class="downloads-platform-grid">
                            @foreach (var platform in release.PlatformAvailability)
                            {
                                var platformOption = ResolvePlatformOption(platform.PlatformId);
                                <article class="downloads-platform-card">
                                    <span class="platform-pill">@platform.StatusLabel</span>
                                    <h3>@platform.PlatformLabel@(platform.CurrentDevice ? " (this browser)" : string.Empty)</h3>
                                    <p>@platform.Summary</p>
                                    <p class="muted-copy">@platform.PrimaryPackageLabel · @platform.SupportabilityLabel</p>
                                    @if (platformOption is not null)
                                    {
                                        <a class="button-like button-like--ghost" href="@platformOption.DispatchHref">@platformOption.ActionLabel</a>
                                    }
                                </article>
                            }
                        </div>
                    </div>
                </div>
            </details>
        </section>
    }

    @if (hasAdvancedPanels)
    {
        <section class="release-shelf release-shelf--manual" id="advanced-downloads">
            <details class="release-accordion">
                <summary>Advanced download options</summary>
                <div class="release-accordion__body">
                    <div class="downloads-advanced-group">
                        <h3 class="downloads-subheading">Install notes</h3>
                        <div class="downloads-facts">
                            <article class="downloads-fact">
                                <span>Detected device</span>
                                <strong>@deviceLabel gets the default path on this page.</strong>
                            </article>
                            <article class="downloads-fact">
                                <span>First launch</span>
                                <strong>Use <code class="mono-receipt">Load Demo Runner</code> to inspect the bundled <code class="mono-receipt">Soma-Career.chum5</code> sample before you start blank.</strong>
                            </article>
                            <article class="downloads-fact">
                                <span>Support path</span>
                                <strong>@(Model.Chrome.Authenticated ? "This install stays tied to your signed-in recovery and support path." : "Sign in when you want recovery, support continuity, and claim-linked install history tied to the same machine.")</strong>
                            </article>
                        </div>
                        <div class="stacked-actions">
                            <a class="button-like button-like--ghost" href="@release.InstallHelpHref">@release.InstallHelpLabel</a>
                            <a class="button-like button-like--ghost" href="@release.KnownIssuesHref">@release.KnownIssuesLabel</a>
                            <a class="button-like button-like--ghost" href="/status">Open status</a>
                        </div>
                    </div>

                    <div class="downloads-advanced-group">
                        <h3 class="downloads-subheading">Need more detail?</h3>
                        <p class="muted-copy">Use Status when you want platform readiness, the current caution, and the technical release trail without crowding the main install decision.</p>
                        <div class="stacked-actions">
                            <a class="button-like button-like--ghost" href="/status">Open status</a>
                            <a class="button-like button-like--ghost" href="/now">Open what works today</a>
                        </div>
                    </div>

                    @if (hasSignedInWindowsBuilds)
                    {
                        <div class="downloads-advanced-group" id="signed-in-windows-builds">
                            <h3 class="downloads-subheading">Signed-in Windows builds</h3>
                            <p class="muted-copy">Windows is not on the guest shelf right now, but signed-in users can still open the latest Windows install handoff here.</p>
                            <div class="evidence-row-list">
                                @foreach (var option in signedInWindowsBuilds)
                                {
                                    <article class="evidence-row evidence-row--download">
                                        <div class="evidence-row__copy">
                                            <h3>@option.Title</h3>
                                            <p>@option.SupportLine</p>
                                        </div>
                                        <div class="download-row__meta">
                                            <span class="platform-pill">Signed-in only</span>
                                            <span class="muted-copy">@option.PlatformLabel</span>
                                            <span class="muted-copy">@option.HeadLabel</span>
                                            <code class="mono-receipt">@option.SizeLabel</code>
                                        </div>
                                        <a class="button-like button-like--ghost" href="@option.DispatchHref">@option.ActionLabel</a>
                                    </article>
                                }
                            </div>
                        </div>
                    }

                    @if (hasWindowsProofRail)
                    {
                        <div class="downloads-advanced-group" id="windows-verification-rail">
                            <h3 class="downloads-subheading">Windows verification and support path</h3>
                            <p class="muted-copy">These direct Windows installers stay available for verification and support when a proof or support flow points to a specific build beyond the main platform shelf.</p>
                            <div class="evidence-row-list">
                                @foreach (var proofInstaller in windowsProofInstallers)
                                {
                                    var headLabel = string.Equals(proofInstaller.Head, "blazor-desktop", StringComparison.OrdinalIgnoreCase)
                                        ? "Blazor Desktop"
                                        : "Avalonia Desktop";
                                    <article class="evidence-row evidence-row--download">
                                        <div class="evidence-row__copy">
                                            <h3>@headLabel Windows x64 installer</h3>
                                            <p>Direct Windows installer for verification and support. Use this when a proof or support flow points to this specific build.</p>
                                        </div>
                                        <div class="download-row__meta">
                                            <span class="platform-pill">Support path</span>
                                            <span class="muted-copy">Windows x64</span>
                                            <code class="mono-receipt">SHA @proofInstaller.Sha256[..Math.Min(proofInstaller.Sha256.Length, 16)]...</code>
                                        </div>
                                        <a class="button-like button-like--ghost" href="/downloads/install/@Uri.EscapeDataString(proofInstaller.ArtifactId)">Open installer</a>
                                    </article>
                                }
                            </div>
                        </div>
                    }

                    @if (release.Alternatives.Count > 0)
                    {
                        <div class="downloads-advanced-group">
                            <h3 class="downloads-subheading">More options for @release.Recommended.PlatformLabel</h3>
                            <div class="evidence-row-list">
                                @foreach (var download in release.Alternatives)
                                {
                                    <article class="evidence-row evidence-row--download">
                                        <div class="evidence-row__copy">
                                            <h3>@download.Title</h3>
                                            <p>@download.SupportLine</p>
                                        </div>
                                        <div class="download-row__meta">
                                            <span class="platform-pill">@download.HeadLabel</span>
                                            <span class="muted-copy">@download.SizeLabel</span>
                                            @if (!string.IsNullOrWhiteSpace(download.ShaPreview))
                                            {
                                                <code class="mono-receipt">@download.ShaPreview</code>
                                            }
                                        </div>
                                        <a class="button-like button-like--ghost" href="@download.DispatchHref">@download.ActionLabel</a>
                                    </article>
                                }
                            </div>
                        </div>
                    }

                    @if (release.OtherPlatforms.Count > 0)
                    {
                        <div class="downloads-advanced-group">
                            <h3 class="downloads-subheading">Other platforms</h3>
                            <div class="evidence-row-list">
                                @foreach (var download in release.OtherPlatforms)
                                {
                                    <article class="evidence-row evidence-row--download">
                                        <div class="evidence-row__copy">
                                            <h3>@download.Title</h3>
                                            <p>@download.SupportLine</p>
                                        </div>
                                        <div class="download-row__meta">
                                            <span class="platform-pill">@download.PlatformLabel</span>
                                            <span class="muted-copy">@download.SizeLabel</span>
                                        </div>
                                        <a class="button-like button-like--ghost" href="@download.DispatchHref">@download.ActionLabel</a>
                                    </article>
                                }
                            </div>
                        </div>
                    }

                    @if (release.ManualPackages.Count > 0)
                    {
                        <div class="downloads-advanced-group">
                            <h3 class="downloads-subheading">Manual packages for support-directed installs</h3>
                            <div class="evidence-row-list">
                                @foreach (var download in release.ManualPackages)
                                {
                                    <article class="evidence-row evidence-row--download">
                                        <div class="evidence-row__copy">
                                            <h3>@download.Title</h3>
                                            <p>@download.SupportLine</p>
                                        </div>
                                        <div class="download-row__meta">
                                            <span class="platform-pill">@download.PlatformLabel</span>
                                            <span class="muted-copy">@download.SizeLabel</span>
                                        </div>
                                        <a class="button-like button-like--ghost" href="@download.DispatchHref">@download.ActionLabel</a>
                                    </article>
                                }
                            </div>
                        </div>
                    }

                </div>
            </details>
        </section>
    }

    @if (Model.SignedInStatus is not null)
    {
        @await Html.PartialAsync("~/Views/Shared/_SignedInTrustStatusPanel.cshtml", Model.SignedInStatus)
    }
}

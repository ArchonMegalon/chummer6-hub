@model DownloadsPageViewModel
@{
    ViewData["Title"] = "Downloads";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-downloads surface-minimal";
    var release = Model.ReleaseExperience;
    var verifiedLabel = Model.ReleaseTruth.VerifiedDateLabel;
    var optionPool = (release.Recommended is null ? Enumerable.Empty<ReleaseOptionViewModel>() : new[] { release.Recommended })
        .Concat(release.Alternatives)
        .Concat(release.OtherPlatforms)
        .Concat(release.ManualPackages)
        .GroupBy(option => option.Artifact.Id, StringComparer.OrdinalIgnoreCase)
        .Select(group => group.First())
        .ToArray();
    var platforms = new[] { ("windows", "Windows"), ("linux", "Linux") };
    var stableLaneIds = new[] { "stable", "public_stable" };
    var nightlyLaneIds = new[] { "nightly", "preview", "public_preview", "public_stable" };
    var aurPackages = Model.AurPackages ?? Array.Empty<AurPackageEntry>();

    static bool MatchesPlatform(PublicReleaseArtifactDto artifact, string platformId)
    {
        var candidatePlatformId = artifact.PlatformId ?? string.Empty;
        var candidatePlatform = artifact.Platform ?? string.Empty;
        return platformId switch
        {
            "windows" => candidatePlatformId.Contains("win", StringComparison.OrdinalIgnoreCase)
                || candidatePlatform.Contains("Windows", StringComparison.OrdinalIgnoreCase),
            "linux" => candidatePlatformId.Contains("linux", StringComparison.OrdinalIgnoreCase)
                || candidatePlatform.Contains("Linux", StringComparison.OrdinalIgnoreCase),
            _ => false
        };
    }

    static bool MatchesReleaseLane(PublicReleaseArtifactDto artifact, IReadOnlyList<string> laneIds)
    {
        var artifactLaneIds = new[] { artifact.ChannelId, artifact.Channel };
        return artifactLaneIds.Any(candidate =>
            !string.IsNullOrWhiteSpace(candidate)
            && laneIds.Any(lane => string.Equals(candidate.Trim(), lane, StringComparison.OrdinalIgnoreCase)));
    }

    ReleaseOptionViewModel? ResolveLanePlatformOption(string platformId, IReadOnlyList<string> laneIds, bool allowFallback)
    {
        var platformOptions = optionPool
            .Where(option => option.Installer)
            .Where(option => MatchesPlatform(option.Artifact, platformId))
            .ToArray();
        return platformOptions.FirstOrDefault(option => MatchesReleaseLane(option.Artifact, laneIds))
            ?? (allowFallback ? platformOptions.FirstOrDefault() : null);
    }

    var stablePlatformOptions = platforms
        .Select(platform => new
        {
            PlatformId = platform.Item1,
            PlatformLabel = platform.Item2,
            Option = ResolveLanePlatformOption(platform.Item1, stableLaneIds, allowFallback: true)
        })
        .ToArray();
    var nightlyPlatformOptions = platforms
        .Select(platform => new
        {
            PlatformId = platform.Item1,
            PlatformLabel = platform.Item2,
            Option = ResolveLanePlatformOption(platform.Item1, nightlyLaneIds, allowFallback: true)
        })
        .ToArray();
    var stableArtifactIds = stablePlatformOptions
        .Where(platform => platform.Option is not null)
        .Select(platform => platform.Option!.Artifact.Id)
        .OrderBy(id => id, StringComparer.OrdinalIgnoreCase)
        .ToArray();
    var nightlyArtifactIds = nightlyPlatformOptions
        .Where(platform => platform.Option is not null)
        .Select(platform => platform.Option!.Artifact.Id)
        .OrderBy(id => id, StringComparer.OrdinalIgnoreCase)
        .ToArray();
    var stableAndNightlyMatch = stableArtifactIds.Length > 0
        && stableArtifactIds.SequenceEqual(nightlyArtifactIds, StringComparer.OrdinalIgnoreCase);

    static string PublicDownloadText(string? value) => UndetectableHumanizerCopyAdapter.Humanize(value);
}

<section class="minimal-page-hero">
    <div>
        <h1>Install Chummer</h1>
        <p>Windows and Linux installers.</p>
    </div>
    <div class="minimal-status-pill" aria-label="Current release">
        <span>Updated</span>
        <strong>@verifiedLabel</strong>
    </div>
</section>

@if (Model.Manifest.Downloads.Count == 0 || release.Recommended is null)
{
    <section class="minimal-empty">
        <h2>No download is available right now</h2>
        <p>@PublicDownloadText(Model.Manifest.Message)</p>
        <a class="button-like button-like--primary" href="/status">Open status</a>
    </section>
}
else
{
    <section class="minimal-lane-grid" aria-label="Downloads">
        <article class="minimal-lane-card" id="stable">
            <div class="minimal-lane-card__head">
                <span>Stable</span>
                <h2>Current build</h2>
                <p>The default choice for regular play.</p>
            </div>
            <div class="minimal-platform-actions">
                @foreach (var platform in stablePlatformOptions)
                {
                    var option = platform.Option;
                    if (option is not null)
                    {
                        var installRoute = $"/downloads/install/{Uri.EscapeDataString(option.Artifact.Id)}";
                        <a class="button-like button-like--primary" href="@option.DispatchHref" data-download-action="download-artifact" data-download-artifact="@option.Artifact.Id" data-download-platform="@platform.PlatformId" data-download-raw-url="@option.DirectFileHref" data-download-install-route="@installRoute" data-download-link-mode="raw-url" data-release-lane="stable" data-platform="@platform.PlatformId" data-analytics-event="downloads_stable_install" data-analytics-surface="minimal_downloads" data-analytics-label="@platform.PlatformLabel">@platform.PlatformLabel</a>
                    }
                }
            </div>
            <dl class="minimal-inline-facts" aria-label="Stable build details">
                <div><dt>Updated</dt><dd>@verifiedLabel</dd></div>
            </dl>
        </article>

        <article class="minimal-lane-card" id="nightly">
            <div class="minimal-lane-card__head">
                <span>Nightly</span>
                <h2>Newest build</h2>
                <p>Use this when you want the latest Windows or Linux build.</p>
                @if (stableAndNightlyMatch)
                {
                    <p>Nightly currently matches Stable. There is no newer Nightly available.</p>
                }
            </div>
            <div class="minimal-platform-actions">
                @foreach (var platform in nightlyPlatformOptions)
                {
                    var option = platform.Option;
                    if (option is not null)
                    {
                        var installRoute = $"/downloads/install/{Uri.EscapeDataString(option.Artifact.Id)}";
                        <a class="button-like button-like--secondary" href="@option.DispatchHref" data-download-action="download-artifact" data-download-artifact="@option.Artifact.Id" data-download-platform="@platform.PlatformId" data-download-raw-url="@option.DirectFileHref" data-download-install-route="@installRoute" data-download-link-mode="raw-url" data-release-lane="nightly" data-platform="@platform.PlatformId" data-analytics-event="downloads_nightly_install" data-analytics-surface="minimal_downloads" data-analytics-label="@platform.PlatformLabel">@platform.PlatformLabel</a>
                    }
                }
            </div>
            <dl class="minimal-inline-facts" aria-label="Nightly build details">
                <div><dt>Updated</dt><dd>@verifiedLabel</dd></div>
            </dl>
        </article>
    </section>

    @if (aurPackages.Count > 0)
    {
        <section class="minimal-section minimal-section--tight" id="arch-linux">
            <div class="minimal-section__lead">
                <h2>Arch Linux</h2>
                <p>AUR-compatible package source for Arch-based distributions.</p>
            </div>
            <div class="minimal-platform-list">
                @foreach (var package in aurPackages)
                {
                <article>
                    <h3>@package.PlatformLabel</h3>
                    <p>@PublicDownloadText(package.Summary)</p>
                    <div class="minimal-actions">
                        <a href="@package.SourceArchiveUrl" data-analytics-event="downloads_arch_aur_source" data-analytics-surface="minimal_downloads" data-analytics-label="@package.PackageName">AUR source</a>
                        <a href="@package.PkgbuildUrl">PKGBUILD</a>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    <section class="minimal-section minimal-section--tight" id="platforms">
        <div class="minimal-section__lead">
            <h2>Platforms</h2>
        </div>
        <div class="minimal-platform-list">
            @foreach (var platform in release.PlatformAvailability.Where(item => item.PlatformId is "windows" or "linux" or "macos"))
            {
                <article>
                    <h3>@platform.PlatformLabel</h3>
                    <p>@PublicDownloadText(platform.Summary)</p>
                </article>
            }
        </div>
    </section>

    <div class="minimal-section minimal-section--tight">
        <div class="minimal-section__lead">
            <h2>Help</h2>
            <p>Use Help for install or update trouble. Use Status for platforms and dates. Use Changelog for release notes.</p>
        </div>
        <div class="minimal-actions">
            <a class="button-like button-like--primary" href="/help">Help</a>
            <a class="button-like button-like--ghost" href="/status">Status</a>
        </div>
    </div>
}

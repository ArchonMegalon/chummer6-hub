@model DownloadsPageViewModel
@{
    ViewData["Title"] = "Downloads";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-downloads";
}

<section class="release-stage">
    <div class="release-stage__lead">
        <p class="eyebrow">Downloads</p>
        <h1 class="page-title">@Model.Manifest.Version</h1>
        <p class="page-copy">@Model.Manifest.Channel channel, published @Model.Manifest.PublishedAt.ToUniversalTime().ToString("yyyy-MM-dd").</p>
        <p class="release-stage__note">Platform, artifact, size, checksum, and download stay together.</p>
    </div>
    <div class="release-stage__integrity">
        <span class="tag">Integrity</span>
        <p>Checksums stay visible beside every build.</p>
    </div>
</section>

<section class="release-shelf">
    <div class="table-shell">
        <table class="release-table">
            <thead>
                <tr>
                    <th>Platform</th>
                    <th>Artifact</th>
                    <th>Size</th>
                    <th>Checksum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Manifest.Downloads.Count == 0)
                {
                    <tr>
                        <td colspan="5">@Model.Manifest.Message</td>
                    </tr>
                }
                else
                {
                    @foreach (var download in Model.Manifest.Downloads)
                    {
                        <tr>
                            <td><span class="platform-pill">@download.Platform</span></td>
                            <td>@download.Id</td>
                            <td>@(download.SizeBytes is long size ? $"{Math.Round(size / 1024d, 1)} KB" : "Unknown")</td>
                            <td><code class="mono-receipt">@download.Sha256[..Math.Min(download.Sha256.Length, 16)]...</code></td>
                            <td><a class="button-like button-like--primary" href="@download.Url">Download</a></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

<section class="release-footnote">
    <p class="muted-copy">Channel behavior and release notes stay with the current build.</p>
</section>

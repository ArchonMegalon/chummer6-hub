@model DownloadsPageViewModel
@{
    ViewData["Title"] = "Downloads";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-downloads";
    var release = Model.ReleaseExperience;
    var guestGateRequired = !Model.Chrome.Authenticated && release.Recommended?.RequiresAccount == true;
}

<section class="release-stage">
    <div class="release-stage__lead">
        <p class="eyebrow">Downloads</p>
        <h1 class="page-title">Install the current preview</h1>
        <p class="page-copy">@release.Display.ChannelLabel, @release.Display.BuildLabel, @release.Display.PublishedLabel.ToLowerInvariant().</p>
        @if (guestGateRequired)
        {
            <p class="release-stage__note">@release.GuestGateSummary</p>
        }
        else
        {
            <p class="release-stage__note">Start with the recommended installer for your platform. Alternative builds and manual packages stay underneath when you explicitly need them.</p>
        }
        @if (Model.Chrome.Authenticated || guestGateRequired)
        {
            <p class="release-stage__note">Signed-in downloads keep a receipt and an install-link handoff without changing the published bytes.</p>
        }
    </div>
    <div class="release-stage__integrity">
        <span class="tag">Current release</span>
        <p>@release.ReleaseNotesSummary</p>
    </div>
</section>

<section class="release-guidance">
    <article class="release-guidance__item">
        <span class="tag">Release notes</span>
        <h2>What changed in this preview</h2>
        <p>@release.ReleaseNotesSummary</p>
    </article>
    <article class="release-guidance__item">
        <span class="tag tag--quiet">Updates</span>
        <h2>How updates behave</h2>
        <p>@release.UpdatePostureSummary</p>
    </article>
    <article class="release-guidance__item">
        <span class="tag">Help</span>
        <h2>Get install help fast</h2>
        <p>Use the recommended installer first. Known issues and install help stay on first-party pages when you need them, without making you reverse-engineer package choices.</p>
    </article>
</section>

@if (Model.Manifest.Downloads.Count == 0 || release.Recommended is null)
{
    <section class="release-shelf">
        <article class="release-empty">
            <h2>No published build is on the shelf yet</h2>
            <p>@Model.Manifest.Message</p>
            <div class="stacked-actions">
                <a class="button-like button-like--primary" href="@release.NoBuildPrimaryHref">@release.NoBuildPrimaryLabel</a>
                <a class="button-like button-like--secondary" href="/now">See what works today</a>
            </div>
        </article>
    </section>
}
else
{
    <section class="recommended-download" id="recommended-download">
        <article class="recommended-download__card">
            <div class="recommended-download__copy">
                <span class="tag">@(guestGateRequired ? release.GuestGateHeading : "Recommended")</span>
                <h2>@release.Recommended.Title</h2>
                <p>@release.Recommended.SupportLine</p>
                <div class="recommended-download__meta">
                    <span>@release.Recommended.PlatformLabel</span>
                    <span>@release.Recommended.SizeLabel</span>
                    @if (!string.IsNullOrWhiteSpace(release.Recommended.ShaPreview))
                    {
                        <code class="mono-receipt">@release.Recommended.ShaPreview</code>
                    }
                </div>
                <div class="stacked-actions">
                    @if (guestGateRequired)
                    {
                        <a class="button-like button-like--primary" href="@release.GuestGatePrimaryHref">@release.GuestGatePrimaryLabel</a>
                        <a class="button-like button-like--secondary" href="@release.GuestGateSecondaryHref">@release.GuestGateSecondaryLabel</a>
                        <a class="inline-link" href="@release.InstallHelpHref">@release.InstallHelpLabel</a>
                    }
                    else
                    {
                        <a class="button-like button-like--primary" href="@release.Recommended.DispatchHref">@release.Recommended.ActionLabel</a>
                        <a class="inline-link" href="@release.KnownIssuesHref">@release.KnownIssuesLabel</a>
                    }
                </div>
            </div>
        </article>
    </section>

    <section class="release-guidance release-guidance--detail">
        <article class="release-guidance__item">
            <span class="tag">Install steps</span>
            <h2>First run should be straightforward</h2>
            <ul class="trust-page-section__list">
                @foreach (var step in release.InstallSteps)
                {
                    <li>@step</li>
                }
            </ul>
        </article>
        <article class="release-guidance__item">
            <span class="tag tag--quiet">System requirements</span>
            <h2>@release.Recommended.PlatformLabel requirements</h2>
            <ul class="trust-page-section__list">
                @foreach (var requirement in release.SystemRequirements)
                {
                    <li>@requirement</li>
                }
            </ul>
        </article>
    </section>

    @if (release.Alternatives.Count > 0)
    {
        <section class="release-shelf release-shelf--manual">
            <details class="release-accordion">
                <summary>More download options for @release.Recommended.PlatformLabel</summary>
                <div class="release-accordion__body">
                    <p class="editorial-copy">Use these only when you explicitly want a different desktop implementation on the same platform.</p>
                    <div class="evidence-row-list">
                        @foreach (var download in release.Alternatives)
                        {
                            <article class="evidence-row evidence-row--download">
                                <div class="evidence-row__copy">
                                    <h3>@download.HeadLabel</h3>
                                    <p>@download.SupportLine</p>
                                </div>
                                <div class="download-row__meta">
                                    <span class="platform-pill">@download.PlatformLabel</span>
                                    <span class="muted-copy">@download.SizeLabel</span>
                                    @if (!string.IsNullOrWhiteSpace(download.ShaPreview))
                                    {
                                        <code class="mono-receipt">@download.ShaPreview</code>
                                    }
                                </div>
                                <a class="button-like button-like--ghost" href="@download.DispatchHref">@download.ActionLabel</a>
                            </article>
                        }
                    </div>
                </div>
            </details>
        </section>
    }

    @if (release.OtherPlatforms.Count > 0)
    {
        <section class="release-shelf release-shelf--manual">
            <details class="release-accordion">
                <summary>Other platforms</summary>
                <div class="release-accordion__body">
                    <p class="editorial-copy">Use these when you are intentionally installing on another platform, not as the default choice for this machine.</p>
                    <div class="evidence-row-list">
                        @foreach (var download in release.OtherPlatforms)
                        {
                            <article class="evidence-row evidence-row--download">
                                <div class="evidence-row__copy">
                                    <h3>@download.PlatformLabel</h3>
                                    <p>@download.SupportLine</p>
                                </div>
                                <div class="download-row__meta">
                                    <span class="platform-pill">@download.HeadLabel</span>
                                    <span class="muted-copy">@download.SizeLabel</span>
                                    @if (!string.IsNullOrWhiteSpace(download.ShaPreview))
                                    {
                                        <code class="mono-receipt">@download.ShaPreview</code>
                                    }
                                </div>
                                <a class="button-like button-like--ghost" href="@download.DispatchHref">@download.ActionLabel</a>
                            </article>
                        }
                    </div>
                </div>
            </details>
        </section>
    }

    @if (release.ManualPackages.Count > 0)
    {
        <section class="release-shelf release-shelf--manual">
            <details class="release-accordion">
                <summary>Manual packages for advanced installs</summary>
                <div class="release-accordion__body">
                    <p class="editorial-copy">These packages stay available for edge cases, but they are not the default first-run path.</p>
                    <div class="evidence-row-list">
                        @foreach (var download in release.ManualPackages)
                        {
                            <article class="evidence-row evidence-row--download">
                                <div class="evidence-row__copy">
                                    <h3>@download.PlatformLabel</h3>
                                    <p>@download.SupportLine</p>
                                </div>
                                <div class="download-row__meta">
                                    <span class="platform-pill">@download.HeadLabel</span>
                                    <span class="muted-copy">@download.SizeLabel</span>
                                    @if (!string.IsNullOrWhiteSpace(download.ShaPreview))
                                    {
                                        <code class="mono-receipt">@download.ShaPreview</code>
                                    }
                                </div>
                                <a class="button-like button-like--ghost" href="@download.DispatchHref">@download.ActionLabel</a>
                            </article>
                        }
                    </div>
                </div>
            </details>
        </section>
    }
}

<section class="release-footnote">
    <p class="muted-copy">If the package choice is still unclear, stop here and use support before you guess between package types or alternate builds.</p>
    <div class="stacked-actions">
        <a class="button-like button-like--ghost" href="/contact">Contact Chummer</a>
    </div>
</section>

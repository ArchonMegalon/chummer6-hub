@using Chummer.Run.Api.Services
@model KarmaForgeIntakePageViewModel
@{
    ViewData["Title"] = UndetectableHumanizerCopyAdapter.Humanize(Model.Heading);
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-karma-forge surface-minimal";
    ViewData["ContextSidebarHeading"] = "Request sections";
    ViewData["ContextSidebarSummary"] = "Use the section links to send a table problem and see the next step.";
    ViewData["ContextSidebarLinks"] = new[]
    {
        new PublicNavigationLink("Request form", "#karma-forge-intake"),
        new PublicNavigationLink("What happens next", "#external-stages"),
        new PublicNavigationLink("Track questions", "#track-questions"),
        new PublicNavigationLink("Likely outcomes", "#candidate-decisions"),
        new PublicNavigationLink("Saved requests", "#recent-packets"),
    };
    bool hasErrors = Model.Form.ValidationErrors.Count > 0;
    var historyHref = Model.Form.Authenticated
        ? "#recent-packets"
        : "/signup?next=%2Fparticipate%2Fkarma-forge";
    var historyLabel = Model.Form.Authenticated
        ? "Open my requests"
        : "Create account for saved requests";
    var historyTitle = Model.Form.Authenticated
        ? "Open your recent requests"
        : "Create an account only if you want saved requests";
    var historySummary = Model.Form.Authenticated
        ? "Your saved requests and next steps stay together."
        : "The public request form works without an account. Sign in only if you want saved requests.";
    var routeChoices = new[]
    {
        new
        {
            Badge = "Request",
            Title = "Submit a rules or table problem",
            Summary = "Use this page when something at the table slows play, causes confusion, or needs a Chummer fix.",
            Href = "#karma-forge-intake",
            Label = "Start request",
            Details = new[] { "Describe the problem", "Pick the edition", "Send it" }
        },
        new
        {
            Badge = "Roadmap",
            Title = "Open the roadmap only if you want the larger plan",
            Summary = "Stay here to submit a request. Open the roadmap when you want to understand where this work may go later.",
            Href = "/roadmap/karma-forge",
            Label = "Open roadmap",
            Details = new[] { "Larger plan", "Related work", "No intake required" }
        },
        new
        {
            Badge = "Public signal",
            Title = "Return to participate for broader feedback",
            Summary = "Use Participate for general product feedback. Use this page for a specific table or rules pain point.",
            Href = "/participate",
            Label = "Back to participate",
            Details = new[] { "General feedback", "Broader topics", "Separate from support" }
        },
        new
        {
            Badge = "Continuity",
            Title = historyTitle,
            Summary = historySummary,
            Href = historyHref,
            Label = historyLabel,
            Details = Model.Form.Authenticated
                ? new[] { "Recent requests", "Queue status", "Same page" }
                : new[] { "Public first", "Account adds history", "No login required" }
        },
        new
        {
            Badge = "Support",
            Title = "Use Help for setup, account, or bug problems",
            Summary = "If the problem is install repair, account recovery, or a normal bug report, Help is the right place.",
            Href = "/contact#support-intake",
            Label = "Open Help",
            Details = new[] { "Install help", "Account help", "Bug reports" }
        }
    };

    string SanitizePublicText(string? value)
        => UndetectableHumanizerCopyAdapter.HumanizeKarmaForgeIntake(value);
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@SanitizePublicText(Model.Eyebrow)</p>
        <h1 class="page-title">@SanitizePublicText(Model.Heading)</h1>
        <p class="page-copy">Send one concrete table problem to Chummer.</p>
        <div class="trust-claim__details">
            <span>@SanitizePublicText(Model.CanonicalLane)</span>
            <span>@SanitizePublicText(Model.EntryLane)</span>
            <span>@Model.Dashboard.TotalPackets request(s) received so far</span>
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="#karma-forge-intake">Start request</a>
        <a class="button-like button-like--secondary" href="/roadmap/karma-forge">Open roadmap</a>
        <a class="button-like button-like--ghost" href="/participate">Back to participate</a>
    </div>
</section>

<section class="editorial-block" id="karma-forge-route-map">
    <div class="editorial-block__lead">
        <p class="eyebrow">Where to go next</p>
        <h2 class="editorial-title">Pick the page that matches the job.</h2>
        <p class="editorial-copy">Submit a table problem here through the guided request path. Use Help for setup or account issues.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var choice in routeChoices)
        {
            <article class="route-choice-card">
                <span class="tag">@SanitizePublicText(choice.Badge)</span>
                <h3>@SanitizePublicText(choice.Title)</h3>
                <p>@SanitizePublicText(choice.Summary)</p>
                <div class="route-choice-card__details">
                    @foreach (var item in choice.Details)
                    {
                        <span>@SanitizePublicText(item)</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@choice.Href">@SanitizePublicText(choice.Label)</a>
            </article>
        }
    </div>
</section>

<section class="trust-rail-section">
    <div class="editorial-block__lead">
        <p class="eyebrow">Current requests</p>
        <h2 class="editorial-title">Recent requests at a glance.</h2>
        <p class="editorial-copy">These numbers show what people are sending in.</p>
    </div>
    <div class="trust-rail-list">
        <article class="trust-rail">
            <span class="tag">Waiting</span>
            <p>@Model.Dashboard.GovernorQueueCount request(s) are currently in line.</p>
        </article>
        <article class="trust-rail">
            <span class="tag">Follow-up</span>
            <p>@Model.Dashboard.FollowUpCandidateCount request(s) are likely to need follow-up.</p>
        </article>
        <article class="trust-rail">
            <span class="tag">Shareable</span>
            <p>@Model.Dashboard.ShareablePacketCount request(s) may be useful beyond one table.</p>
        </article>
        <article class="trust-rail">
            <span class="tag">Core gap</span>
            <p>@Model.Dashboard.CoreRulesetGapCount request(s) look like core ruleset work.</p>
        </article>
    </div>
</section>

<section class="editorial-block" id="external-stages">
    <div class="editorial-block__lead">
        <p class="eyebrow">Workflow</p>
        <h2 class="editorial-title">What happens after you send it.</h2>
        <p class="editorial-copy">Chummer keeps the request tied to this page.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var stage in Model.ExternalStages)
        {
            <article class="route-choice-card">
                <span class="tag">@SanitizePublicText(stage.PublicLabel)</span>
                <h3>@SanitizePublicText(stage.Status.Replace("_", " ", StringComparison.OrdinalIgnoreCase))</h3>
                <p>@SanitizePublicText(stage.Summary)</p>
                <div class="route-choice-card__details">
                    <span>Status</span>
                    <span>@stage.Boundary.Replace("_", " ", StringComparison.OrdinalIgnoreCase)</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(stage.ActionHref) && !string.IsNullOrWhiteSpace(stage.ActionLabel))
                {
                    <a class="editorial-strip__action" href="@stage.ActionHref">@SanitizePublicText(stage.ActionLabel)</a>
                }
            </article>
        }
    </div>
</section>

<section class="compact-rail">
    @foreach (var step in Model.DiscoverySteps)
    {
        <article class="compact-rail__item">
            <div class="compact-rail__copy">
                <h3>@step</h3>
                <p>The next step stays clear.</p>
            </div>
        </article>
    }
</section>

<section class="trust-page-layout">
    <div class="trust-page-sections">
        <article class="trust-page-section trust-page-section--form" id="karma-forge-intake">
            <p class="eyebrow">Request</p>
            <h2>Describe the problem.</h2>
            <p>Tell Chummer what is breaking trust or pace at the table.</p>

            @if (!string.IsNullOrWhiteSpace(Model.Form.SubmissionNotice))
            {
                <p class="status-copy @(hasErrors ? "status-copy--error" : "status-copy--success")">@Model.Form.SubmissionNotice</p>
            }
            @if (Model.Form.ValidationErrors.Count > 0)
            {
                <div class="status-copy status-copy--error">
                    <strong>Fix these first:</strong>
                    <ul>
                        @foreach (var error in Model.Form.ValidationErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            <form class="settings-form" method="post" action="@Model.Form.ActionHref">
                @Html.AntiForgeryToken()
                <div class="field">
                    <label for="trackKey">Request type</label>
                    <select id="trackKey" name="TrackKey" required>
                        @foreach (var option in Model.Form.TrackOptions)
                        {
                            <option value="@option.Value" selected="@(string.Equals(Model.Form.DefaultTrackKey, option.Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@SanitizePublicText(option.Label)</option>
                        }
                    </select>
                    <p class="muted-copy">@SanitizePublicText(Model.SelectedTrack.Family) prompts are shown below.</p>
                </div>
                <div class="field">
                    <label for="respondentRole">Respondent role</label>
                    <select id="respondentRole" name="RespondentRole" required>
                        @foreach (var option in Model.Form.RoleOptions)
                        {
                            <option value="@option.Value" selected="@(string.Equals(Model.Form.DefaultRespondentRole, option.Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@SanitizePublicText(option.Label)</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="edition">Edition</label>
                    <select id="edition" name="Edition" required>
                        @foreach (var option in Model.Form.EditionOptions)
                        {
                            <option value="@option.Value" selected="@(string.Equals(Model.Form.DefaultEdition, option.Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@SanitizePublicText(option.Label)</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="tableType">Table type</label>
                    <select id="tableType" name="TableType" required>
                        @foreach (var option in Model.Form.TableTypeOptions)
                        {
                            <option value="@option.Value" selected="@(string.Equals(Model.Form.DefaultTableType, option.Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@SanitizePublicText(option.Label)</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="ruleCategory">Rule category</label>
                    <select id="ruleCategory" name="RuleCategory" required>
                        @foreach (var option in Model.Form.RuleCategoryOptions)
                        {
                            <option value="@option.Value" selected="@(string.Equals(Model.Form.DefaultRuleCategory, option.Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@SanitizePublicText(option.Label)</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="severity">Severity</label>
                    <select id="severity" name="Severity" required>
                        @foreach (var option in Model.Form.SeverityOptions)
                        {
                            <option value="@option.Value" selected="@(string.Equals(Model.Form.DefaultSeverity, option.Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@SanitizePublicText(option.Label)</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="feedbackPrompt">Short frame</label>
                    <input id="feedbackPrompt" name="FeedbackPrompt" maxlength="280" value="@Model.Form.DefaultFeedbackPrompt" placeholder="Our table needs campaign-scoped gear unlocks without hidden legality changes." />
                </div>
                <div class="field">
                    <label for="userWordsSummary">In your words</label>
                    <textarea id="userWordsSummary" name="UserWordsSummary" rows="4" placeholder="What did the table actually ask for?" required>@Model.Form.DefaultUserWordsSummary</textarea>
                </div>
                <div class="field">
                    <label for="currentWorkaround">Current workaround</label>
                    <textarea id="currentWorkaround" name="CurrentWorkaround" rows="4" placeholder="How are you handling this today?" required>@Model.Form.DefaultCurrentWorkaround</textarea>
                </div>
                <details class="details-drawer">
                    <summary>Optional extra detail</summary>
                    <div class="field">
                        <label for="interpretedNeedSummary">Optional rewrite</label>
                        <textarea id="interpretedNeedSummary" name="InterpretedNeedSummary" rows="4" placeholder="Rewrite the need into a Chummer-owned summary.">@Model.Form.DefaultInterpretedNeedSummary</textarea>
                    </div>
                    <div class="field">
                        <label for="impactNotes">Impact notes</label>
                        <textarea id="impactNotes" name="ImpactNotes" rows="4" placeholder="Call out build impact, rollback, player visibility, approvals, and portability.">@Model.Form.DefaultImpactNotes</textarea>
                    </div>
                    <div class="field">
                        <label for="shareabilityNotes">Reuse notes</label>
                        <textarea id="shareabilityNotes" name="ShareabilityNotes" rows="4" placeholder="Is this campaign-local, reusable, publishable, or version-sensitive?">@Model.Form.DefaultShareabilityNotes</textarea>
                    </div>
                </details>
                @if (!Model.Form.Authenticated)
                {
                    <div class="field">
                        <label for="replyEmail">Reply email</label>
                        <input id="replyEmail" name="ReplyEmail" type="email" value="@Model.Form.DefaultReplyEmail" placeholder="runner@example.com" />
                    </div>
                }
                <details class="details-drawer">
                    <summary>Consent and boundaries</summary>
                    <p class="muted-copy">Do not paste raw copyrighted sourcebook text. Use your own wording, examples from your table, and lawful source references only when needed.</p>
                    <div class="field">
                        <label>
                            <input name="FollowUpAllowed" type="checkbox" value="true" checked="@Model.Form.DefaultFollowUpAllowed" />
                            Chummer may follow up through the reply route I provided if this request looks useful.
                        </label>
                    </div>
                    <div class="field">
                        <label>
                            <input name="QuoteAllowed" type="checkbox" value="true" checked="@Model.Form.DefaultQuoteAllowed" />
                            Chummer may use an anonymous quote or paraphrase when summarizing common problems.
                        </label>
                    </div>
                    <div class="field">
                        <label>
                            <input name="ConsentAccepted" type="checkbox" value="true" checked="@Model.Form.DefaultConsentAccepted" required />
                            I understand this may inform Chummer design, but it does not promise a feature by itself.
                        </label>
                    </div>
                </details>
                <div class="stacked-actions">
                    <button class="button-like button-like--primary" type="submit">Send request</button>
                    <a class="button-like button-like--ghost" href="/contact#support-intake">This is a support issue</a>
                </div>
            </form>
        </article>

        <article class="trust-page-section" id="track-questions">
            <p class="eyebrow">Helpful questions</p>
            <h2>@SanitizePublicText(Model.SelectedTrack.Title)</h2>
            <p>These prompts sharpen the need without becoming decisions by themselves.</p>
            <ul class="trust-page-section__list">
                @foreach (var question in Model.SelectedTrack.Questions)
                {
                    <li>@SanitizePublicText(question)</li>
                }
            </ul>
        </article>

        <article class="trust-page-section" id="candidate-decisions">
            <p class="eyebrow">Possible outcomes</p>
            <h2>Each request should land on a clear next step.</h2>
            <p>Requests stay understandable before anything changes.</p>
            <p class="muted-copy">The request stays clear before anything changes.</p>
            <div class="settings-summary-list">
                @foreach (var decision in Model.CandidateDecisions)
                {
                    <div class="settings-summary-row">
                        <span>@SanitizePublicText(decision.Key)</span>
                        <strong>@SanitizePublicText(decision.Meaning)</strong>
                    </div>
                }
            </div>
            <section class="compact-rail">
                @foreach (var output in Model.CanonicalOutputs)
                {
                    <article class="compact-rail__item">
                        <div class="compact-rail__copy">
                            <h3>@SanitizePublicText(output)</h3>
                            <p>Chummer uses saved outcomes here. Raw notes and vendor summaries stay out of the public result.</p>
                        </div>
                    </article>
                }
            </section>
        </article>

        <article class="trust-page-section" id="recent-packets">
            <p class="eyebrow">Saved requests</p>
            <h2>Your recent requests</h2>
            <p>@(Model.Form.Authenticated ? "Your requests stay visible here with current status." : "Sign in if you want saved requests beyond this page.")</p>
            @if (Model.RecentSubmissions.Count == 0)
            {
                <p class="muted-copy">No saved requests are visible yet.</p>
            }
            else
            {
                <div class="settings-summary-list">
                    @foreach (var packet in Model.RecentSubmissions)
                    {
                        <div class="settings-summary-row">
                            <span><a class="inline-link" href="/participate/karma-forge/submitted/@packet.SubmissionId">@SanitizePublicText(packet.Title)</a></span>
                            <strong>@SanitizePublicText(packet.SubmittedLabel) · @SanitizePublicText(packet.CandidateDecision) · @SanitizePublicText(packet.QueueStatus)</strong>
                        </div>
                    }
                </div>
            }
        </article>
    </div>
</section>

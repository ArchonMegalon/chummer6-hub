@model KarmaForgeIntakePageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-karma-forge";
    bool hasErrors = Model.Form.ValidationErrors.Count > 0;
    var historyHref = Model.Form.Authenticated
        ? "#recent-packets"
        : "/signup?next=%2Fparticipate%2Fkarma-forge";
    var historyLabel = Model.Form.Authenticated
        ? "Open signed-in packet history"
        : "Create account for packet history";
    var historyTitle = Model.Form.Authenticated
        ? "Stay on the signed-in packet history page when you need recent KARMA FORGE continuity"
        : "Create the account only when you want packet history and follow-through in one place";
    var historySummary = Model.Form.Authenticated
        ? "Signed-in history keeps recent packets, queue posture, and follow-through attached to the same discovery page instead of burying them in generic feedback history."
        : "The public intake works without an account. Sign in only when you want your packet history, queue posture, and follow-through to stay visible in one place.";
    var routeChoices = new[]
    {
        new
        {
            Badge = "Intake",
            Title = "Stay on this page when the job is turning table pain into a Chummer-owned packet",
            Summary = "This intake page owns normalization, consent, and the first named packet output. It should not be replaced by generic support copy or vague future-signal chatter.",
            Href = "#karma-forge-intake",
            Label = "Start the intake",
            Proof = new[] { "Chummer-owned packets", "Consent explicit", "One intake page" }
        },
        new
        {
            Badge = "Roadmap family",
            Title = "Open the horizon brief only when you need the larger product case",
            Summary = "The intake page keeps the discovery job concrete. Move to the horizon brief when you need the broader why, planned shape, or longer strategic frame behind KARMA FORGE.",
            Href = "/roadmap/karma-forge",
            Label = "Read the horizon brief",
            Proof = new[] { "Broader rationale", "Planned product frame", "Still first-party" }
        },
        new
        {
            Badge = "Public signal",
            Title = "Return to participate when the question is broader public discovery, not this intake packet",
            Summary = "Participate still owns the wider public signal loop. This page should stay the governed intake for specific house-rule and campaign demand packets.",
            Href = "/participate",
            Label = "Back to participate",
            Proof = new[] { "Broader signal loop", "Public discovery", "No mixed jobs" }
        },
        new
        {
            Badge = "Continuity",
            Title = historyTitle,
            Summary = historySummary,
            Href = historyHref,
            Label = historyLabel,
            Proof = Model.Form.Authenticated
                ? new[] { "Recent packets", "Queue posture", "Same discovery page" }
                : new[] { "Public first", "Account adds history", "No auth wall for intake" }
        },
        new
        {
            Badge = "Support",
            Title = "Leave KARMA FORGE for normal support as soon as the issue is no longer discovery work",
            Summary = "If the problem is install repair, account recovery, or a normal bug/support case, stop using this discovery page and move to first-party support instead.",
            Href = "/contact#support-intake",
            Label = "Open support intake",
            Proof = new[] { "Support-owned", "Normal support page", "Discovery stays bounded" }
        }
    };

    string SanitizePublicText(string value)
        => string.IsNullOrWhiteSpace(value)
            ? string.Empty
            : value
                .Replace(string.Concat("Product", " Governor"), "governed product decision", StringComparison.OrdinalIgnoreCase)
                .Replace(string.Concat("Face", "Pop"), "public invitation", StringComparison.OrdinalIgnoreCase)
                .Replace(string.Concat("Deft", "form"), "structured pre-screen", StringComparison.OrdinalIgnoreCase)
                .Replace(string.Concat("Ican", "preneur"), "guided synthesis lane", StringComparison.OrdinalIgnoreCase)
                .Replace(string.Concat("Tea", "ble"), "review board", StringComparison.OrdinalIgnoreCase)
                .Replace(string.Concat("Next", "Step"), "guided review lane", StringComparison.OrdinalIgnoreCase)
                .Replace(string.Concat("oper", "ator projections"), "review projections", StringComparison.OrdinalIgnoreCase)
                .Replace(string.Concat("oper", "ator projection"), "review projection", StringComparison.OrdinalIgnoreCase);
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">Turn one table pain into a named Chummer-owned packet before it drifts into support noise or roadmap guessing.</p>
        <div class="trust-claim__microproof">
            <span>@Model.CanonicalLane</span>
            <span>@Model.EntryLane</span>
            <span>@Model.Dashboard.TotalPackets packet(s) normalized so far</span>
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="#karma-forge-intake">Start the intake</a>
        <a class="button-like button-like--secondary" href="/roadmap/karma-forge">Read the horizon brief</a>
        <a class="button-like button-like--ghost" href="/participate">Back to participate</a>
    </div>
</section>

<section class="editorial-block" id="karma-forge-route-map">
    <div class="editorial-block__lead">
        <p class="eyebrow">Where to go next</p>
        <h2 class="editorial-title">Keep intake, roadmap, continuity, and support on separate pages.</h2>
        <p class="editorial-copy">This page is for governed discovery intake only.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var choice in routeChoices)
        {
            <article class="route-choice-card">
                <span class="tag">@choice.Badge</span>
                <h3>@choice.Title</h3>
                <p>@choice.Summary</p>
                <div class="route-choice-card__proof">
                    @foreach (var item in choice.Proof)
                    {
                        <span>@item</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@choice.Href">@choice.Label</a>
            </article>
        }
    </div>
</section>

<section class="trust-rail-section">
    <div class="editorial-block__lead">
        <p class="eyebrow">Loop state</p>
        <h2 class="editorial-title">The loop is visible before any rules work starts.</h2>
        <p class="editorial-copy">Hub owns intake, receipts, and the first named packet.</p>
    </div>
    <div class="trust-rail-list">
        <article class="trust-rail">
            <span class="tag">Queue</span>
            <p>@Model.Dashboard.GovernorQueueCount packet(s) already normalized for review queue handling.</p>
        </article>
        <article class="trust-rail">
            <span class="tag">Follow-up</span>
            <p>@Model.Dashboard.FollowUpCandidateCount packet(s) are strong enough for likely follow-up on the governed review rail.</p>
        </article>
        <article class="trust-rail">
            <span class="tag">Shareable</span>
            <p>@Model.Dashboard.ShareablePacketCount packet(s) currently look reusable across tables instead of staying campaign-local.</p>
        </article>
        <article class="trust-rail">
            <span class="tag">Core gap</span>
            <p>@Model.Dashboard.CoreRulesetGapCount packet(s) already look closer to core-ruleset review than KARMA FORGE packaging work.</p>
        </article>
    </div>
</section>

<section class="editorial-block" id="external-stages">
    <div class="editorial-block__lead">
        <p class="eyebrow">Bounded workflow stages</p>
        <h2 class="editorial-title">The discovery loop stays explicit from signal to closeout.</h2>
        <p class="editorial-copy">No external step replaces Chummer-owned packet truth.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var stage in Model.ExternalStages)
        {
            <article class="route-choice-card">
                <span class="tag">@SanitizePublicText(stage.PublicLabel)</span>
                <h3>@stage.Status.Replace("_", " ", StringComparison.OrdinalIgnoreCase)</h3>
                <p>@SanitizePublicText(stage.Summary)</p>
                <div class="route-choice-card__proof">
                    <span>@stage.ReceiptId</span>
                    <span>@stage.Boundary.Replace("_", " ", StringComparison.OrdinalIgnoreCase)</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(stage.ActionHref) && !string.IsNullOrWhiteSpace(stage.ActionLabel))
                {
                    <a class="editorial-strip__action" href="@stage.ActionHref">@stage.ActionLabel</a>
                }
            </article>
        }
    </div>
</section>

<section class="compact-rail">
    @foreach (var step in Model.DiscoverySteps)
    {
        <article class="compact-rail__item">
            <div class="compact-rail__copy">
                <h3>@step</h3>
                <p>The loop stays named and bounded.</p>
            </div>
        </article>
    }
</section>

<section class="trust-page-layout">
    <aside class="account-nav account-nav--trust" aria-label="KARMA FORGE sections">
        <a href="#karma-forge-intake">Intake</a>
        <a href="#external-stages">Bounded stages</a>
        <a href="#track-questions">Track questions</a>
        <a href="#candidate-decisions">Governor decisions</a>
        <a href="#recent-packets">Recent packets</a>
    </aside>
    <div class="trust-page-sections">
        <article class="trust-page-section trust-page-section--form" id="karma-forge-intake">
            <p class="eyebrow">Structured intake</p>
            <h2>Pre-screen the table pain before it turns into canon talk.</h2>
            <p>Tell Chummer what is breaking trust or pace. Hub normalizes it into Chummer-owned packets.</p>

            @if (!string.IsNullOrWhiteSpace(Model.Form.SubmissionNotice))
            {
                <p class="status-copy @(hasErrors ? "status-copy--error" : "status-copy--success")">@Model.Form.SubmissionNotice</p>
            }
            @if (Model.Form.ValidationErrors.Count > 0)
            {
                <div class="status-copy status-copy--error">
                    <strong>Fix these first:</strong>
                    <ul>
                        @foreach (var error in Model.Form.ValidationErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            <form class="settings-form" method="post" action="@Model.Form.ActionHref">
                @Html.AntiForgeryToken()
                <div class="field">
                    <label for="trackKey">Follow-up track</label>
                    <select id="trackKey" name="TrackKey" required>
                        @foreach (var option in Model.Form.TrackOptions)
                        {
                            <option value="@option.Value" selected="@(string.Equals(Model.Form.DefaultTrackKey, option.Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@option.Label</option>
                        }
                    </select>
                    <p class="muted-copy">@Model.SelectedTrack.Family prompts are currently loaded below.</p>
                </div>
                <div class="field">
                    <label for="respondentRole">Respondent role</label>
                    <select id="respondentRole" name="RespondentRole" required>
                        @foreach (var option in Model.Form.RoleOptions)
                        {
                            <option value="@option.Value" selected="@(string.Equals(Model.Form.DefaultRespondentRole, option.Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@option.Label</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="edition">Edition</label>
                    <select id="edition" name="Edition" required>
                        @foreach (var option in Model.Form.EditionOptions)
                        {
                            <option value="@option.Value" selected="@(string.Equals(Model.Form.DefaultEdition, option.Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@option.Label</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="tableType">Table type</label>
                    <select id="tableType" name="TableType" required>
                        @foreach (var option in Model.Form.TableTypeOptions)
                        {
                            <option value="@option.Value" selected="@(string.Equals(Model.Form.DefaultTableType, option.Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@option.Label</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="ruleCategory">Rule category</label>
                    <select id="ruleCategory" name="RuleCategory" required>
                        @foreach (var option in Model.Form.RuleCategoryOptions)
                        {
                            <option value="@option.Value" selected="@(string.Equals(Model.Form.DefaultRuleCategory, option.Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@option.Label</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="severity">Severity</label>
                    <select id="severity" name="Severity" required>
                        @foreach (var option in Model.Form.SeverityOptions)
                        {
                            <option value="@option.Value" selected="@(string.Equals(Model.Form.DefaultSeverity, option.Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@option.Label</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="feedbackPrompt">Prompt or one-line frame</label>
                    <input id="feedbackPrompt" name="FeedbackPrompt" maxlength="280" value="@Model.Form.DefaultFeedbackPrompt" placeholder="Our table needs campaign-scoped gear unlocks without hidden legality changes." />
                </div>
                <div class="field">
                    <label for="userWordsSummary">User words</label>
                    <textarea id="userWordsSummary" name="UserWordsSummary" rows="4" placeholder="What did the table actually ask for?" required>@Model.Form.DefaultUserWordsSummary</textarea>
                </div>
                <div class="field">
                    <label for="currentWorkaround">Current workaround</label>
                    <textarea id="currentWorkaround" name="CurrentWorkaround" rows="4" placeholder="How are you handling this today?" required>@Model.Form.DefaultCurrentWorkaround</textarea>
                </div>
                <details class="details-drawer">
                    <summary>Optional synthesis fields</summary>
                    <div class="field">
                        <label for="interpretedNeedSummary">Interpreted need</label>
                        <textarea id="interpretedNeedSummary" name="InterpretedNeedSummary" rows="4" placeholder="Rewrite the need into a Chummer-owned summary.">@Model.Form.DefaultInterpretedNeedSummary</textarea>
                    </div>
                    <div class="field">
                        <label for="impactNotes">Trust and impact notes</label>
                        <textarea id="impactNotes" name="ImpactNotes" rows="4" placeholder="Call out build impact, rollback, player visibility, approvals, and portability.">@Model.Form.DefaultImpactNotes</textarea>
                    </div>
                    <div class="field">
                        <label for="shareabilityNotes">Shareability notes</label>
                        <textarea id="shareabilityNotes" name="ShareabilityNotes" rows="4" placeholder="Is this campaign-local, reusable, publishable, or version-sensitive?">@Model.Form.DefaultShareabilityNotes</textarea>
                    </div>
                </details>
                @if (!Model.Form.Authenticated)
                {
                    <div class="field">
                        <label for="replyEmail">Reply email</label>
                        <input id="replyEmail" name="ReplyEmail" type="email" value="@Model.Form.DefaultReplyEmail" placeholder="runner@example.com" />
                    </div>
                }
                <details class="details-drawer">
                    <summary>Consent and boundaries</summary>
                    <p class="muted-copy">Do not paste raw copyrighted sourcebook text. Use your own wording, examples from your table, and lawful source references only when needed.</p>
                    <div class="field">
                        <label>
                            <input name="FollowUpAllowed" type="checkbox" value="true" checked="@Model.Form.DefaultFollowUpAllowed" />
                            Chummer may follow up through the reply route I provided if this packet looks high-signal.
                        </label>
                    </div>
                    <div class="field">
                        <label>
                            <input name="QuoteAllowed" type="checkbox" value="true" checked="@Model.Form.DefaultQuoteAllowed" />
                            Chummer may use an anonymous quote or paraphrase in discovery closeout materials.
                        </label>
                    </div>
                    <div class="field">
                        <label>
                            <input name="ConsentAccepted" type="checkbox" value="true" checked="@Model.Form.DefaultConsentAccepted" required />
                            I understand this may inform Chummer design, but it does not become feature truth or backlog ownership by itself.
                        </label>
                    </div>
                </details>
                <div class="stacked-actions">
                    <button class="button-like button-like--primary" type="submit">Normalize into KARMA FORGE packets</button>
                    <a class="button-like button-like--ghost" href="/contact#support-intake">This is really a normal support issue</a>
                </div>
            </form>
        </article>

        <article class="trust-page-section" id="track-questions">
            <p class="eyebrow">Follow-up prompts</p>
            <h2>@Model.SelectedTrack.Title</h2>
            <p>These prompts sharpen the need without becoming truth by themselves.</p>
            <ul class="trust-page-section__list">
                @foreach (var question in Model.SelectedTrack.Questions)
                {
                    <li>@question</li>
                }
            </ul>
        </article>

        <article class="trust-page-section" id="candidate-decisions">
            <p class="eyebrow">Priority decisions</p>
            <h2>Every packet still has to land on a named decision.</h2>
            <p>Discovery does not skip straight to implementation.</p>
            <p class="muted-copy">The packet stays explicit before any routing or follow-up.</p>
            <div class="settings-summary-list">
                @foreach (var decision in Model.CandidateDecisions)
                {
                    <div class="settings-summary-row">
                        <span>@decision.Key</span>
                        <strong>@decision.Meaning</strong>
                    </div>
                }
            </div>
            <section class="compact-rail">
                @foreach (var output in Model.CanonicalOutputs)
                {
                    <article class="compact-rail__item">
                        <div class="compact-rail__copy">
                            <h3>@output</h3>
                            <p>Chummer-owned output only. Raw interview notes and vendor summaries stay non-canonical.</p>
                        </div>
                    </article>
                }
            </section>
        </article>

        <article class="trust-page-section" id="recent-packets">
            <p class="eyebrow">Signed-in history</p>
            <h2>Your recent KARMA FORGE packets</h2>
            <p>@(Model.Form.Authenticated ? "Signed-in submissions stay visible here with current queue posture." : "Sign in if you want packet history beyond the receipt link.")</p>
            @if (Model.RecentSubmissions.Count == 0)
            {
                <p class="muted-copy">No signed-in KARMA FORGE packets are visible on this account yet.</p>
            }
            else
            {
                <div class="settings-summary-list">
                    @foreach (var packet in Model.RecentSubmissions)
                    {
                        <div class="settings-summary-row">
                            <span><a class="inline-link" href="/participate/karma-forge/submitted/@packet.SubmissionId">@packet.Title</a></span>
                            <strong>@packet.SubmittedLabel · @packet.CandidateDecision · @packet.QueueStatus</strong>
                        </div>
                    }
                </div>
            }
        </article>
    </div>
</section>

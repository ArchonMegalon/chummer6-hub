@model FirstPartyParticipateBoardViewModel
@{
    ViewData["Title"] = "Participate";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-minimal surface-participate surface-partizipate";
    var maxVisiblePosts = 8;
    var displayPosts = Model.Posts
        .Take(maxVisiblePosts)
        .Select(post => new ParticipateItemViewModel(post.Score, post.Title, post.Summary, post.Status, post.Href))
        .ToArray();
    var hasMorePosts = Model.Posts.Count > maxVisiblePosts;
}

<style data-chummer-board-skin>
</style>

<section class="partizipate-board" aria-labelledby="partizipate-title">
    <header class="partizipate-board__header">
        <div>
            <p class="partizipate-board__eyebrow">@Model.StatusLabel</p>
            <h1 id="partizipate-title">@Model.Heading</h1>
        </div>
        <p>@Model.Summary</p>
        @if (Model.LoadedFromBoard)
        {
            <p class="partizipate-board__meta">@Model.TotalRequestCount items · @Model.SyncedLabel</p>
        }
    </header>

    @if (Model.LoadedFromBoard)
    {
            <div class="partizipate-board__grid" aria-label="Public requests">
            @foreach (var item in displayPosts)
            {
                <article class="partizipate-request">
                    <div class="partizipate-request__score" aria-label="@item.Score votes">
                        <strong>@item.Score</strong>
                        <span>votes</span>
                    </div>
                    <div class="partizipate-request__body">
                        <div class="partizipate-request__topline">
                            <span>@item.Status</span>
                        </div>
                        <h2>
                            @if (!string.IsNullOrWhiteSpace(item.Href))
                            {
                                <a href="@item.Href">@item.Title</a>
                            }
                            else
                            {
                                @item.Title
                            }
                        </h2>
                        @if (!string.IsNullOrWhiteSpace(item.Summary))
                        {
                            <p>@item.Summary</p>
                        }
                    </div>
                </article>
            }
            @if (hasMorePosts)
            {
                <p class="partizipate-board__meta">Showing the top 8 requests.</p>
            }
        </div>
    }
    else
    {
        <article class="partizipate-request partizipate-request--empty" role="status">
            <div class="partizipate-request__body">
                <div class="partizipate-request__topline">
                    <span>Unavailable</span>
                </div>
                <h2>Participate is temporarily unavailable</h2>
                <p>Try again later. Use Discord for normal questions or Contact for private details.</p>
            </div>
        </article>
    }

    <nav class="partizipate-board__actions" aria-label="Participate actions">
        <a class="button-like button-like--primary" href="@Model.RetryHref">Reload</a>
        <a class="button-like button-like--secondary" href="@Model.RoadmapHref">Roadmap</a>
        <a class="button-like button-like--secondary" href="@Model.SupportHref">Private message</a>
        @if (!string.IsNullOrWhiteSpace(Model.SupporterHref))
        {
            <a class="button-like button-like--ghost" href="@Model.SupporterHref">Supporter</a>
        }
    </nav>
</section>

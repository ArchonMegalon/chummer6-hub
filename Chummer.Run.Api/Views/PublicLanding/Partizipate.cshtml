@model FirstPartyParticipateBoardViewModel
@{
    ViewData["Title"] = "Participate";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-minimal surface-participate surface-partizipate";

    var hasHostedBoard = Model.EmbeddedBoardEnabled && !string.IsNullOrWhiteSpace(Model.EmbeddedBoardHref);
}

<section class="participate-shell route-anchor-target" aria-labelledby="partizipate-title">
    <h1 id="partizipate-title" class="sr-only">Participate</h1>
    <div class="participate-hosted">
        @if (hasHostedBoard)
        {
            <div class="participate-hosted__frame-shell">
                <iframe
                    class="participate-hosted__frame"
                    src="@Model.EmbeddedBoardHref"
                    title="Chummer participation board"
                    loading="lazy"
                    referrerpolicy="same-origin"
                    data-chummer-participate-frame></iframe>
            </div>
        }
        else
        {
            <article class="participate-board-fallback" role="status" aria-live="polite">
                <p>
                    Board offline right now. Use Contact for the Chummer5 Discord server.
                </p>
                <nav aria-label="Participate recovery actions">
                    <a class="button-like button-like--primary" href="@Model.RetryHref">
                        Retry
                    </a>
                    <a class="button-like button-like--ghost" href="@Model.SupportHref">Contact</a>
                </nav>
            </article>
        }
    </div>
</section>

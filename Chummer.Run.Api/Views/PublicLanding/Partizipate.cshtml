@model FirstPartyParticipateBoardViewModel
@{
    ViewData["Title"] = "Participate";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-minimal surface-participate surface-partizipate";

    var boardStateSummary = Model.EmbeddedBoardEnabled
        ? "Board is live."
        : "Board offline right now.";
    static string PublicParticipateText(string? value) => UndetectableHumanizerCopyAdapter.Humanize(value);
}

<section class="minimal-page-hero participate-hero route-anchor-target" aria-labelledby="partizipate-title">
    <div class="participate-hero__copy">
        <p class="eyebrow">@Model.StatusLabel</p>
        <h1 id="partizipate-title">@PublicParticipateText(Model.Heading)</h1>
        <p>@PublicParticipateText(Model.Summary)</p>
    </div>
    <div class="participate-hero__status">
        @if (!string.IsNullOrWhiteSpace(Model.EntryHref) && !string.IsNullOrWhiteSpace(Model.EntryLabel))
        {
            <a class="button-like button-like--ghost" href="@Model.EntryHref">@PublicParticipateText(Model.EntryLabel)</a>
        }
        @if (!string.IsNullOrWhiteSpace(Model.SupporterHref))
        {
            <a class="button-like button-like--ghost" href="@Model.SupporterHref">Supporter</a>
        }
    </div>
</section>

<section class="participate-shell" aria-label="Participate board">
    <div class="participate-hosted">
        <div class="participate-hosted__header">
            <div class="participate-hosted__lead">
                <h2>Current requests</h2>
                <p>@boardStateSummary</p>
            </div>
        }

        @if (Model.EmbeddedBoardEnabled && !string.IsNullOrWhiteSpace(Model.EmbeddedBoardHref))
        {
            <div class="participate-hosted__frame-shell" data-chummer-participate-frame-shell>
                <iframe
                    class="participate-hosted__frame"
                    src="@Model.EmbeddedBoardHref"
                    title="Participate board"
                    loading="eager"
                    referrerpolicy="strict-origin-when-cross-origin"
                    data-chummer-participate-frame></iframe>
            </div>
        }
        else
        {
            <article class="participate-board-fallback" role="status" aria-live="polite">
                <p>Board offline right now. Use private support only when it should stay private.</p>
                <nav aria-label="Participate recovery actions">
                    <a class="button-like button-like--primary" href="@Model.RetryHref">Retry</a>
                    <a class="button-like button-like--secondary" href="@Model.RoadmapHref">Roadmap</a>
                    <a class="button-like button-like--ghost" href="@Model.SupportHref">Private support</a>
                </nav>
            </article>
        }
    </div>
</section>

@model StoryPageViewModel
@{
    ViewData["Title"] = "What Is Chummer?";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-story";
    var leadAsset = Model.Assets.BySlot("scene_archive_stair");
}

<section class="story-cinematic">
    <div class="story-cinematic__copy">
        <p class="eyebrow">Product</p>
        <h1 class="page-title">Build, explain, run, publish, and improve from one explainable system.</h1>
        <p class="page-copy">Chummer is a serious, explainable Shadowrun platform that keeps rules truth, living dossiers, campaign continuity, publication, and support closure in one visible product.</p>
    </div>
    @if (leadAsset is not null)
    {
        <div class="story-cinematic__media">
            @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", leadAsset)
        </div>
    }
</section>

<section class="role-matrix">
    <div class="editorial-block__lead">
        <p class="eyebrow">Product loop</p>
        <h2 class="editorial-title">What Chummer helps you do</h2>
        <p class="editorial-copy">These five jobs connect the builder, explanation trail, campaign continuity, publication, and support follow-through.</p>
    </div>
    <div class="role-matrix__grid">
        @foreach (var card in Model.Workflows)
        {
            <article class="role-matrix__cell">
                <span class="tag">@card.Card.Badge</span>
                <h3>@card.Card.Title</h3>
                <p>@card.Card.Summary</p>
                <a class="inline-link" href="@card.Action.Href">@card.Action.Label</a>
            </article>
        }
    </div>
</section>

<section class="trust-rail-section">
    <div class="editorial-block__lead">
        <p class="eyebrow">How the pieces fit together</p>
        <h2 class="editorial-title">One explainable system, three trust checks</h2>
        <p class="editorial-copy">Rules truth, receipts, and continuity are how the same result stays usable across build, play, and follow-up.</p>
    </div>
    <div class="trust-rail-list">
        @foreach (var card in Model.TrustPillars)
        {
            <article class="trust-rail">
                <span class="tag">@card.Badge</span>
                <h3>@card.Title</h3>
                <p>@card.Summary</p>
            </article>
        }
    </div>
</section>

<section class="role-matrix">
    <div class="editorial-block__lead">
        <p class="eyebrow">Roles</p>
        <h2 class="editorial-title">One product, different table needs</h2>
        <p class="editorial-copy">Players, GMs, and creators hit different surfaces, but they still share the same install, rules, campaign, and support truth.</p>
    </div>
    <div class="role-matrix__grid">
        @foreach (var card in Model.Lanes)
        {
            <article class="role-matrix__cell">
                <h3>@card.Card.Title</h3>
                <p>@card.Card.Summary</p>
                <a class="inline-link" href="@card.Action.Href">@card.Action.Label</a>
            </article>
        }
    </div>
</section>

<section id="public-guide" class="story-guide-tail">
    <p class="eyebrow">Keep going</p>
    <h2 class="editorial-title">Choose the next useful read</h2>
    <p class="editorial-copy">Stay inside the product front door for the practical next step: what works today, how help works, and which horizons are worth following.</p>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="/now">See what works today</a>
        <a class="button-like button-like--secondary" href="/faq">Read the FAQ</a>
        <a class="button-like button-like--ghost" href="/help">Open help</a>
    </div>
</section>

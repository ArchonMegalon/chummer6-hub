@model StoryPageViewModel
@{
    ViewData["Title"] = "What Is Chummer?";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-story";
    var leadAsset = Model.Assets.BySlot("scene_archive_stair");
    var installLane = Model.Lanes.FirstOrDefault(card => string.Equals(card.Card.Title, "Player", StringComparison.OrdinalIgnoreCase));
    var continuityLane = Model.Lanes.FirstOrDefault(card => string.Equals(card.Card.Title, "GM", StringComparison.OrdinalIgnoreCase));
    var creatorLane = Model.Lanes.FirstOrDefault(card => string.Equals(card.Card.Title, "Creator", StringComparison.OrdinalIgnoreCase));
}

<section class="story-cinematic">
    <div class="story-cinematic__copy">
        <p class="eyebrow">Product</p>
        <h1 class="page-title">One product for rules truth, living dossiers, and session return.</h1>
        <p class="page-copy">Chummer is the account-aware Shadowrun companion that keeps rules truth, table continuity, and product support in one accountable front door.</p>
    </div>
    @if (leadAsset is not null)
    {
        <div class="story-cinematic__media">
            @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", leadAsset)
        </div>
    }
</section>

<section class="role-matrix">
    <div class="editorial-block__lead">
        <p class="eyebrow">The short answer</p>
        <h2 class="editorial-title">What it is, where it fits, why it is different, and who it helps</h2>
        <p class="editorial-copy">This page is the differentiation layer. Install, proof, and support stay on their own routes.</p>
    </div>
    <div class="role-matrix__grid">
        <article class="role-matrix__cell">
            <span class="tag">What it is</span>
            <h3>A Shadowrun companion with one front door</h3>
            <p>It keeps release health, proof, sign-in, and help inside one product surface instead of sending you across separate tools to answer basic questions.</p>
        </article>
        <article class="role-matrix__cell">
            <span class="tag">Where it fits</span>
            <h3>Between build truth and table continuity</h3>
            <p>Use it when character prep, explanation, and the next session return all need to stay attached to the same runner and table context.</p>
        </article>
        <article class="role-matrix__cell">
            <span class="tag">Why it is different</span>
            <h3>Proof, release, and help stay attached</h3>
            <p>The rule answer, the current build, and the recovery path stay in one product loop instead of turning into separate detective work later.</p>
        </article>
        <article class="role-matrix__cell">
            <span class="tag">Who it helps</span>
            <h3>Players, GMs, and creators on one rules truth</h3>
            <p>Each lane uses a different slice of the product, but the release shelf, explanation trail, and support path stay shared across the table.</p>
        </article>
    </div>
</section>

<section id="public-guide" class="role-matrix">
    <div class="editorial-block__lead">
        <p class="eyebrow">Who it is for</p>
        <h2 class="editorial-title">Start from the lane that matches your job</h2>
        <p class="editorial-copy">These lanes share one proof shelf and one support path, but each starts from a different table job.</p>
    </div>
    <div class="role-matrix__grid">
        @if (installLane is not null)
        {
            <article class="role-matrix__cell">
                <span class="tag">@installLane.Card.Badge</span>
                <h3>@installLane.Card.Title</h3>
                <p>@installLane.Card.Summary</p>
                <a class="inline-link" href="@installLane.Action.Href">@installLane.Action.Label</a>
            </article>
        }
        @if (continuityLane is not null)
        {
            <article class="role-matrix__cell">
                <span class="tag">@continuityLane.Card.Badge</span>
                <h3>@continuityLane.Card.Title</h3>
                <p>@continuityLane.Card.Summary</p>
                <a class="inline-link" href="@continuityLane.Action.Href">@continuityLane.Action.Label</a>
            </article>
        }
        @if (creatorLane is not null)
        {
            <article class="role-matrix__cell">
                <span class="tag">@creatorLane.Card.Badge</span>
                <h3>@creatorLane.Card.Title</h3>
                <p>@creatorLane.Card.Summary</p>
                <a class="inline-link" href="@creatorLane.Action.Href">@creatorLane.Action.Label</a>
            </article>
        }
    </div>
</section>

<section class="story-guide-tail">
    <p class="eyebrow">Keep going</p>
    <h2 class="editorial-title">Take the next useful step</h2>
    <p class="editorial-copy">Start from proof when you are evaluating, move to downloads when you are ready to install, and use help only when the product path stops being enough.</p>
    <div class="stacked-actions">
        <a class="button-like button-like--primary" href="/now">See what works today</a>
        <a class="button-like button-like--secondary" href="/downloads">Open downloads</a>
    </div>
    <p class="muted-copy">Need help instead? <a class="inline-link" href="/help">Open the help hub</a>.</p>
</section>

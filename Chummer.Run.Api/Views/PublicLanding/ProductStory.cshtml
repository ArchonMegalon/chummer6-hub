@model StoryPageViewModel
@{
    ViewData["Title"] = "What Is Chummer?";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-story";
    var leadAsset = Model.Assets.BySlot("scene_archive_stair");
    var guestNeedsInstallGate = !Model.Chrome.Authenticated && !string.IsNullOrWhiteSpace(Model.ReleaseExperience.GuestGatePrimaryHref);

    string ContextualPreviewHref(string? href)
    {
        var resolvedHref = string.IsNullOrWhiteSpace(href) ? "/downloads" : href;
        if (
            guestNeedsInstallGate
            && string.Equals(resolvedHref, "/downloads", StringComparison.OrdinalIgnoreCase)
        )
        {
            return Model.ReleaseExperience.GuestGatePrimaryHref ?? resolvedHref;
        }

        return resolvedHref;
    }
}

<section class="story-cinematic">
    <div class="story-cinematic__copy">
        <p class="eyebrow">Product</p>
        <h1 class="page-title">One place for builds, explanations, and campaign return.</h1>
        <p class="page-copy">Chummer helps you build a runner, understand the decisions, and return to a campaign without losing context.</p>
    </div>
    @if (leadAsset is not null)
    {
        <div class="story-cinematic__media">
            @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", leadAsset)
        </div>
    }
</section>

<section class="role-matrix">
    <div class="editorial-block__lead">
        <p class="eyebrow">The short answer</p>
        <h2 class="editorial-title">What it is, where it fits, why it is different, and who it helps</h2>
        <p class="editorial-copy">Use this page to decide whether Chummer fits. Downloads, What works today, and Help carry the action routes.</p>
    </div>
    <div class="role-matrix__grid">
        <article class="role-matrix__cell">
            <span class="tag">What it is</span>
            <h3>A Shadowrun desktop and campaign companion</h3>
            <p>It keeps runner building, explanation, installs, and recovery on one product surface instead of sending you across separate tools for basic answers.</p>
        </article>
        <article class="role-matrix__cell">
            <span class="tag">Where it fits</span>
            <h3>Between character creation and the next session</h3>
            <p>Use it when character prep, rules answers, and campaign return all need to stay attached to the same runner and table context.</p>
        </article>
        <article class="role-matrix__cell">
            <span class="tag">Why it is different</span>
            <h3>Explanation, release, and help stay attached</h3>
            <p>The rule answer, current build, and recovery path stay attached instead of turning into separate detective work later.</p>
        </article>
        <article class="role-matrix__cell">
            <span class="tag">Who it helps</span>
            <h3>Players, GMs, and returning groups</h3>
            <p>Each lane uses a different slice of the product, but the shared rules context, explanation trail, and support path stay aligned across the table.</p>
        </article>
    </div>
</section>

<section id="public-guide" class="release-footnote">
    <p class="muted-copy">
        Need proof? <a class="inline-link" href="/now">Open what works today</a>.
        Ready to install? <a class="inline-link" href="@ContextualPreviewHref("/downloads")">Open downloads</a>.
        Need help instead? <a class="inline-link" href="/help">Open the help hub</a>.
    </p>
</section>

@if (Model.TrustPulse is not null)
{
    @await Html.PartialAsync("~/Views/Shared/_PublicTrustPulsePanel.cshtml", Model.TrustPulse)
}

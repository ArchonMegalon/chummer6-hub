@model StoryPageViewModel
@{
    ViewData["Title"] = "What Is Chummer?";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-story surface-minimal";
}

<section class="minimal-page-hero">
    <div>
        <p class="minimal-kicker">Product</p>
        <h1>Character tools for Shadowrun.</h1>
        <p>Chummer helps you create, maintain, and understand a runner without turning the workflow into a brochure.</p>
    </div>
    <div class="minimal-status-pill" aria-label="Start here">
        <span>Start</span>
        <strong>Downloads first</strong>
        <span>Account optional</span>
    </div>
</section>

<section class="minimal-section minimal-section--tight">
    <div class="minimal-section__lead">
        <h2>Use it for</h2>
    </div>
    <div class="minimal-three">
        <article>
            <h3>Characters</h3>
            <p>Create a runner and keep the sheet readable while details change.</p>
        </article>
        <article>
            <h3>Maintenance</h3>
            <p>Track advancement, gear, qualities, and notes between sessions.</p>
        </article>
        <article>
            <h3>Explanations</h3>
            <p>Check why a value or option appears before you return to the table.</p>
        </article>
    </div>
</section>

<section class="minimal-section minimal-section--tight">
    <div class="minimal-section__lead">
        <h2>Where to start</h2>
        <p>Install the app first. Use Help when install, update, or account return needs attention.</p>
    </div>
    <div class="minimal-actions">
        <a class="button-like button-like--primary" href="/downloads">Downloads</a>
        <a class="button-like button-like--secondary" href="/help">Help</a>
        <a class="button-like button-like--ghost" href="/status">Status</a>
    </div>
</section>

@model StoryPageViewModel
@{
    ViewData["Title"] = "What Is Chummer?";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-story";
    var leadAsset = Model.Assets.BySlot("scene_archive_stair");
    var guestNeedsInstallGate = !Model.Chrome.Authenticated && !string.IsNullOrWhiteSpace(Model.ReleaseExperience.GuestGatePrimaryHref);

    string ContextualPreviewHref(string? href)
    {
        var resolvedHref = string.IsNullOrWhiteSpace(href) ? "/downloads" : href;
        if (
            guestNeedsInstallGate
            && string.Equals(resolvedHref, "/downloads", StringComparison.OrdinalIgnoreCase)
        )
        {
            return Model.ReleaseExperience.GuestGatePrimaryHref ?? resolvedHref;
        }

        return resolvedHref;
    }
}

<section class="story-cinematic">
    <div class="story-cinematic__copy">
        <p class="eyebrow">Product</p>
        <h1 class="page-title">Build a runner. Check the answer. Get back to the table.</h1>
        <p class="page-copy">Chummer is for Shadowrun players and GMs who need one dependable place for builds, ruling trails, campaign continuity, and world-facing follow-through.</p>
    </div>
    @if (leadAsset is not null)
    {
        <div class="story-cinematic__media">
            @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", leadAsset)
        </div>
    }
</section>

<section class="story-pain-grid">
    <article class="story-pain-grid__card">
        <span class="tag">What it is</span>
        <h2>A character and campaign companion.</h2>
        <p>Use it to build dossiers, inspect modifier trails, keep installs recoverable, and stay attached to the same table context later.</p>
    </article>
    <article class="story-pain-grid__card">
        <span class="tag">Who it helps</span>
        <h2>Players, GMs, and returning groups.</h2>
        <p>Players need clean totals. GMs need continuity and evidence. Returning groups need the same state and support thread when the next session starts.</p>
    </article>
    <article class="story-pain-grid__card">
        <span class="tag">What to know first</span>
        <h2>Check what works now before you assume.</h2>
        <p>The preview is real, but not every platform is equally proven. Downloads, what works today, and help are the first pages most users actually need.</p>
    </article>
</section>

<section class="role-matrix">
    <div class="editorial-block__lead">
        <p class="eyebrow">Most users need</p>
        <h2 class="editorial-title">Four decisions, not a brochure</h2>
        <p class="editorial-copy">If you are evaluating Chummer, decide where you start, whether the current proof is good enough, whether the world lanes matter to you, and whether you want an account.</p>
    </div>
    <div class="role-matrix__grid">
        <article class="role-matrix__cell">
            <span class="tag">1</span>
            <h3>Start with Downloads</h3>
            <p>Install the current preview when you want the concrete product, not a promise about it.</p>
        </article>
        <article class="role-matrix__cell">
            <span class="tag">2</span>
            <h3>Open What Works Today</h3>
            <p>See the current boundary, current proof, and current platform posture before you commit time.</p>
        </article>
        <article class="role-matrix__cell">
            <span class="tag">3</span>
            <h3>Use Black Ledger and Karma Forge when you want the world layer</h3>
            <p>Black Ledger shows campaign pressure and dispatches. Karma Forge is the intake lane for rule pain, candidate packages, and follow-through.</p>
        </article>
        <article class="role-matrix__cell">
            <span class="tag">4</span>
            <h3>Create an account only when continuity matters</h3>
            <p>The account is for relink, recovery, support history, and future follow-up. The binary stays the same for everyone.</p>
        </article>
    </div>
</section>

<section class="role-matrix">
    <div class="editorial-block__lead">
        <p class="eyebrow">World layer</p>
        <h2 class="editorial-title">Where Black Ledger and Karma Forge fit</h2>
        <p class="editorial-copy">These are not side lore pages. They are the world-facing operating surfaces for campaign pressure and product improvement.</p>
    </div>
    <div class="role-matrix__grid">
        <article class="role-matrix__cell">
            <span class="tag">Black Ledger</span>
            <h3>Receipt-backed world pressure</h3>
            <p>Open Black Ledger when you want districts, factions, dispatches, and world-tick movement that stays public-safe and proof-linked.</p>
            <a class="editorial-strip__action" href="/ledger">Open Black Ledger</a>
        </article>
        <article class="role-matrix__cell">
            <span class="tag">Dispatches</span>
            <h3>What changed since the last tick</h3>
            <p>Dispatches turn tick facts into short readable updates without drifting into unsupported fiction.</p>
            <a class="editorial-strip__action" href="/ledger/dispatches">Read dispatches</a>
        </article>
        <article class="role-matrix__cell">
            <span class="tag">Karma Forge</span>
            <h3>Rule pain and package candidate intake</h3>
            <p>Use Karma Forge when a table problem should become a tracked intake, candidate package, or follow-up lane instead of vanishing into chat.</p>
            <a class="editorial-strip__action" href="/participate/karma-forge">Open Karma Forge</a>
        </article>
    </div>
</section>

<section id="public-guide" class="release-footnote">
    <p class="muted-copy">
        Start here:
        <a class="inline-link" href="@ContextualPreviewHref("/downloads")">downloads</a>,
        <a class="inline-link" href="/now">what works today</a>,
        <a class="inline-link" href="/ledger">Black Ledger</a>,
        <a class="inline-link" href="/participate/karma-forge">Karma Forge</a>,
        and <a class="inline-link" href="/help">help</a>.
    </p>
</section>

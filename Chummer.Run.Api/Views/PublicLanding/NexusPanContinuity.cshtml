@model NexusPanContinuityPageViewModel
@{
    static string PublicNexusText(string? value) => PublicFacingCopyHumanizer.Clean(value);

    ViewData["Title"] = PublicNexusText(Model.Heading);
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-trust-page";
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@PublicNexusText(Model.Eyebrow)</p>
        <h1 class="page-title">@PublicNexusText(Model.Heading)</h1>
        <p class="page-copy">@PublicNexusText(Model.Intro)</p>
        <div class="trust-claim__details">
            @foreach (var point in Model.SummaryPoints)
            {
                <span>@PublicNexusText(point)</span>
            }
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--@Model.PrimaryAction.Tone" href="@Model.PrimaryAction.Href">@PublicNexusText(Model.PrimaryAction.Label)</a>
        <a class="button-like button-like--@Model.SecondaryAction.Tone" href="@Model.SecondaryAction.Href">@PublicNexusText(Model.SecondaryAction.Label)</a>
        <a class="button-like button-like--@Model.TertiaryAction.Tone" href="@Model.TertiaryAction.Href">@PublicNexusText(Model.TertiaryAction.Label)</a>
    </div>
</section>

@if (Model.SignedInStatus is not null)
{
    <section class="release-footnote">
        @await Html.PartialAsync("~/Views/Shared/_SignedInTrustStatusPanel.cshtml", Model.SignedInStatus)
    </section>
}

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Continuity</p>
        <h2 class="editorial-title">Claimed installs and reconnect paths are visible without leaking private device history.</h2>
        <p class="editorial-copy">@PublicFacingCopyHumanizer.Clean(Model.VerdictSummary)</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">Claimed installs</span>
            <h3>@Model.ActiveInstallationCount</h3>
            <p>Active claimed installations currently tracked by Chummer.</p>
        </article>
        <article class="route-choice-card">
            <span class="tag">Active grants</span>
            <h3>@Model.ActiveGrantCount</h3>
            <p>Live continuity grants currently backing claimed installs.</p>
        </article>
        <article class="route-choice-card">
            <span class="tag">Pending recovery</span>
            <h3>@(Model.PendingClaimCount + Model.PendingBrowserCallbackCount)</h3>
            <p>Pending claims and browser return steps still need recovery.</p>
        </article>
    </div>
</section>

<section class="continuity-band">
    <div class="continuity-band__copy">
        <p class="eyebrow">Platform spread</p>
        <h2 class="editorial-title">Continuity stays cross-device, while the public page only shows safe aggregate status.</h2>
        <p class="editorial-copy">@PublicNexusText(Model.PlatformSummary)</p>
    </div>
    <div class="continuity-band__panel">
        @foreach (var platform in Model.PlatformLabels)
        {
            <article class="continuity-band__fact">
                <span>Observed platform</span>
                <strong>@platform</strong>
            </article>
        }
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Continuity details</p>
        <h2 class="editorial-title">See what continuity keeps together.</h2>
        <p class="editorial-copy">These details show install state, reconnect steps, and which parts stay private.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var receipt in Model.Receipts)
        {
            <article class="route-choice-card">
                <span class="tag">@PublicFacingCopyHumanizer.Clean(receipt.Status)</span>
                <h3>@PublicFacingCopyHumanizer.Clean(receipt.Topic)</h3>
                <p>@PublicFacingCopyHumanizer.Clean(receipt.Summary)</p>
                <div class="route-choice-card__details">
                    <span>@PublicFacingCopyHumanizer.Clean(receipt.Route)</span>
                </div>
                <a class="editorial-strip__action" href="@receipt.Route">Open details</a>
            </article>
        }
    </div>
</section>

@if (Model.TrustPulse is not null)
{
    <section class="release-footnote">
        @await Html.PartialAsync("~/Views/Shared/_PublicTrustPulsePanel.cshtml", Model.TrustPulse)
    </section>
}

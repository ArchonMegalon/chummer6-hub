@model FeatureDetailPageViewModel

<section class="role-matrix">
    <div class="editorial-block__lead">
        <p class="eyebrow">Preview concept</p>
        <h2 class="editorial-title">What this concept is aiming for, who it would help, and what to follow next</h2>
        <p class="editorial-copy">Preview pages should be honest about what is ready and point you to the next useful place.</p>
    </div>
    <div class="role-matrix__grid">
        <article class="role-matrix__cell">
            <span class="tag">Readiness</span>
            <p>This concept is still preview-only. Treat the related roadmap and support path as the next honest places to go.</p>
        </article>
        @if (!string.IsNullOrWhiteSpace(Model.Pain))
        {
            <article class="role-matrix__cell">
                <span class="tag">Why it matters</span>
                <p>@PublicFacingCopyHumanizer.Clean(Model.Pain)</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Payoff))
        {
            <article class="role-matrix__cell">
                <span class="tag">What it could unlock</span>
                <p>@PublicFacingCopyHumanizer.Clean(Model.Payoff)</p>
            </article>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ProofNote))
        {
            <article class="role-matrix__cell">
                <span class="tag">What to watch for next</span>
                <p>@PublicFacingCopyHumanizer.Clean(Model.ProofNote)</p>
            </article>
        }
    </div>
</section>

@if (Model.MicroProof.Count > 0)
{
    <section class="trust-rail-section">
        <div class="editorial-block__lead">
            <p class="eyebrow">Follow this concept</p>
            <h2 class="editorial-title">These cues should move onto the live product before you treat the concept as ready.</h2>
        </div>
        <div class="trust-claim__details">
            @foreach (var item in Model.MicroProof)
            {
                <span>@PublicFacingCopyHumanizer.Clean(item)</span>
            }
        </div>
    </section>
}

<section class="compact-rail">
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Still a concept</h3>
            <p>This page should help you follow the roadmap, not imply that the concept is already installable.</p>
        </div>
        <a class="inline-link" href="/roadmap">Open roadmap</a>
    </article>
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Best next page</h3>
            <p>@PublicFacingCopyHumanizer.Clean(Model.PrimaryAction.Label) is the cleanest place to follow the concept without treating it as already shipped.</p>
        </div>
        <a class="inline-link" href="@Model.PrimaryAction.Href">@PublicFacingCopyHumanizer.Clean(Model.PrimaryAction.Label)</a>
    </article>
    <article class="compact-rail__item">
        <div class="compact-rail__copy">
            <h3>Need the live product instead?</h3>
            <p>The detail view and current preview stay separate so preview concepts do not pretend to answer “what works now.”</p>
        </div>
        <a class="inline-link" href="/artifacts">Open detail view</a>
    </article>
    @if (Model.Chrome.Authenticated)
    {
        <article class="compact-rail__item">
            <div class="compact-rail__copy">
                <h3>Open account detail</h3>
                <p>The account detail view keeps your personal, campaign, and publication history on one calmer return path while this concept is still preview-only.</p>
            </div>
            <a class="inline-link" href="/artifacts#signed-in-detail-view">Open account detail view</a>
        </article>
    }
</section>

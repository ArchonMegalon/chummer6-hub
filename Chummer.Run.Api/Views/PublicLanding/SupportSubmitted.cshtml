@model SupportSubmittedPageViewModel
@{
    ViewData["Title"] = UndetectableHumanizerCopyAdapter.Humanize(Model.Heading);
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-support-submitted surface-minimal";
    var primaryAction = Model.Actions.FirstOrDefault(action => string.Equals(action.Tone, "primary", StringComparison.OrdinalIgnoreCase));
    var helpAction = Model.Actions.FirstOrDefault(action => string.Equals(action.Href, "/help", StringComparison.OrdinalIgnoreCase))
        ?? new TrustPageActionViewModel("Return to help", "/help", "secondary");
    var installAction = Model.Actions.FirstOrDefault(action => string.Equals(action.Tone, "ghost", StringComparison.OrdinalIgnoreCase));
    var responseRoutes = new List<(string Badge, string Title, string Summary, string Href, string Label, string[] Details)>();
    var helperFacts = new List<(string Heading, string Summary)>();

    static string TrustRowValue(
        SignedInTrustStatusPanelViewModel? panel,
        string label,
        string fallback)
        => panel?.Rows.FirstOrDefault(row => string.Equals(row.Label, label, StringComparison.Ordinal))?.Value ?? fallback;

    static string PublicSupportSubmittedText(string? value) => UndetectableHumanizerCopyAdapter.Humanize(value);

    if (primaryAction is not null)
    {
        responseRoutes.Add((
            Badge: Model.Chrome.Authenticated ? "Saved history" : "Saved follow-up",
            Title: Model.Chrome.Authenticated
                ? "Keep this report on the account support page"
                : "Create an account if you want support history here",
            Summary: Model.Chrome.Authenticated
                ? "The next update should stay inside Chummer so you can find it in the same place."
                : "Guest follow-up still works on reply email, but an account keeps later support history, linked installs, and recovery on one calmer return path.",
            Href: primaryAction.Href,
            Label: primaryAction.Label,
            Details: Model.Chrome.Authenticated
                ? new[] { "Same report", "Saved updates", "Private reply" }
                : new[] { "Guest still works", "History in Account", "Same download for everyone" }));
    }

    responseRoutes.Add((
        Badge: "Current status",
        Title: "Open current release for fix status",
        Summary: "Use the release surfaces when you need to know whether a fix is already user-available.",
        Href: "/now",
        Label: "Open current release",
        Details: new[] { "Current release", "Known caution", "Latest changes" }));

    responseRoutes.Add((
        Badge: "Help",
        Title: "Return to help if the issue changes",
        Summary: "Use help when the question turns back into direction: install trouble, account recovery, or product questions.",
        Href: helpAction.Href,
        Label: "Open help overview",
        Details: new[] { "Chummer help", "Safe next step", "Account optional" }));

    if (installAction is not null)
    {
        responseRoutes.Add((
            Badge: "Account return",
            Title: Model.TrackedCaseSummary?.NeedsLinkedInstall == true || Model.TrackedCaseSummary?.NeedsInstallUpdate == true
                ? "Return to the same install page for relink, update, or reclaim"
                : "Return to the same install page after support",
            Summary: "The installer or affected copy still handles relink, reclaim, and recovery. This page should send you back to the same setup path.",
            Href: installAction.Href,
            Label: installAction.Label,
            Details: new[] { "Same install page", "Devices & access stays calm", "Same recovery path" }));
    }

    if (Model.TrackedCaseSummary is not null)
    {
        helperFacts.Add(("Current case status", $"{Model.TrackedCaseSummary.StatusLabel} · {Model.TrackedCaseSummary.StageLabel} · {Model.TrackedCaseSummary.UpdatedLabel}"));
        helperFacts.Add(("Next safe action", Model.TrackedCaseSummary.NextSafeAction));
        helperFacts.Add(("Follow-up", Model.TrackedCaseSummary.FollowUpLaneSummary));
        helperFacts.Add(("Release", Model.TrackedCaseSummary.ReleaseProgressSummary));
        helperFacts.Add(("Install", Model.TrackedCaseSummary.InstallReadinessSummary));
        helperFacts.Add(("Fix", Model.TrackedCaseSummary.VerificationSummary));
        if (!string.IsNullOrWhiteSpace(Model.TrackedCaseSummary.AffectedInstallSummary))
        {
            helperFacts.Add(("Affected install", Model.TrackedCaseSummary.AffectedInstallSummary!));
        }

        helperFacts.Add(("Closure", Model.TrackedCaseSummary.ClosureSummary));
    }
    else
    {
        helperFacts.Add(("Keep this page handy", "Use this confirmation page whenever you need to return to the report from support, downloads, or a later account return path."));
        helperFacts.Add((Model.Chrome.Authenticated ? "Watch Account > Support" : "Watch your reply email",
            Model.Chrome.Authenticated
                ? "Saved cases stay on the account support page, so later updates should show up in the same place."
                : "Guest support replies should return by email, so keep that inbox visible until the next update arrives."));
        if (installAction is not null)
        {
            helperFacts.Add(("Account return", "If the report started from an install or recovery page, return to that same guided copy after support tells you the next safe move."));
        }
    }
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@PublicSupportSubmittedText(Model.Eyebrow)</p>
        <h1 class="page-title">@PublicSupportSubmittedText(Model.Heading)</h1>
        <p class="page-copy">@PublicSupportSubmittedText(Model.Intro)</p>
        <div class="trust-claim__details">
            <span>Report saved</span>
            <span>@PublicSupportSubmittedText(Model.StatusLabel.Replace('_', ' '))</span>
        </div>
    </div>
    <div class="stacked-actions">
        @foreach (var action in Model.Actions)
        {
            <a class="button-like button-like--@action.Tone" href="@action.Href">@PublicSupportSubmittedText(action.Label)</a>
        }
    </div>
</section>

<section class="continuity-band support-submitted-band">
    <div class="continuity-band__copy">
        <p class="eyebrow">What happens next</p>
        <h2 class="editorial-title">The report is saved.</h2>
        <p class="editorial-copy">@PublicSupportSubmittedText(Model.ResponseExpectation)</p>
    </div>
    <div class="continuity-band__panel">
        @foreach (var item in Model.Highlights)
        {
            <article class="continuity-band__fact">
                <span>Support</span>
                <strong>@PublicSupportSubmittedText(item)</strong>
            </article>
        }
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Next</p>
        <h2 class="editorial-title">Choose the next step.</h2>
        <p class="editorial-copy">Use the page that matches the next job: saved support history, current release status, help, or the same install path.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var route in responseRoutes)
        {
            <article class="route-choice-card">
                <span class="tag">@PublicSupportSubmittedText(route.Badge)</span>
                <h3>@PublicSupportSubmittedText(route.Title)</h3>
                <p>@PublicSupportSubmittedText(route.Summary)</p>
                <div class="route-choice-card__details">
                    @foreach (var detail in route.Details)
                    {
                        <span>@PublicSupportSubmittedText(detail)</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@route.Href">@PublicSupportSubmittedText(route.Label)</a>
            </article>
        }
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Case details</p>
        <h2 class="editorial-title">Keep the case handy.</h2>
        <p class="editorial-copy">
            @(Model.TrackedCaseSummary is null
                ? "This page keeps the case id, reply path, and account return visible until the next update arrives."
                : "This page keeps the current case status, install state, release progress, and follow-up visible in one place.")
        </p>
    </div>
    <section class="compact-rail">
        @foreach (var fact in helperFacts)
        {
            <article class="compact-rail__item">
                <div class="compact-rail__copy">
                    <h3>@PublicSupportSubmittedText(fact.Heading)</h3>
                    <p>@PublicSupportSubmittedText(fact.Summary)</p>
                </div>
            </article>
        }
    </section>
</section>

@if (Model.SignedInStatus is not null)
{
    <section class="release-footnote">
        <p class="muted-copy">Who can get it now: @PublicSupportSubmittedText(TrustRowValue(Model.SignedInStatus, "Who can get it now", "Open the current release to confirm access."))</p>
    </section>
}

@if (Model.TrackedCaseSummary?.TimelineHighlights is { Count: > 0 })
{
    <section class="editorial-block">
        <details class="details-drawer">
            <summary>Case timeline</summary>
            <div class="settings-summary-list">
                @foreach (var eventItem in Model.TrackedCaseSummary.TimelineHighlights)
                {
                    <div class="settings-summary-row">
                        <span>@eventItem.OccurredLabel · @PublicSupportSubmittedText(eventItem.Label)</span>
                        <strong>@PublicSupportSubmittedText(eventItem.Summary)</strong>
                    </div>
                }
            </div>
        </details>
    </section>
}

@if (Model.Attachments.Count > 0)
{
    <section class="editorial-block">
        <details class="details-drawer">
            <summary>Saved files</summary>
            <div class="settings-summary-list">
                @foreach (var attachment in Model.Attachments)
                {
                    <div class="settings-summary-row">
                        <span>@attachment.FileName</span>
                        <strong>
                            @($"{attachment.SizeBytes / 1024.0:F1} KB · {attachment.UploadedAtUtc:yyyy-MM-dd HH:mm} UTC")
                            @if (!string.IsNullOrWhiteSpace(attachment.DownloadHref))
                            {
                                <a class="inline-link" href="@attachment.DownloadHref">Download</a>
                            }
                        </strong>
                    </div>
                }
            </div>
        </details>
    </section>
}

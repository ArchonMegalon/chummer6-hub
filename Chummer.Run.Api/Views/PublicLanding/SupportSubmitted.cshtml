@model SupportSubmittedPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-support-submitted";
    var primaryAction = Model.Actions.FirstOrDefault(action => string.Equals(action.Tone, "primary", StringComparison.OrdinalIgnoreCase));
    var helpAction = Model.Actions.FirstOrDefault(action => string.Equals(action.Href, "/help", StringComparison.OrdinalIgnoreCase))
        ?? new TrustPageActionViewModel("Return to help", "/help", "secondary");
    var installAction = Model.Actions.FirstOrDefault(action => string.Equals(action.Tone, "ghost", StringComparison.OrdinalIgnoreCase));
    var responseRoutes = new List<(string Badge, string Title, string Summary, string Href, string Label, string[] Proof)>();
    var helperFacts = new List<(string Heading, string Summary)>();

    static string TrustRowValue(
        SignedInTrustStatusPanelViewModel? panel,
        string label,
        string fallback)
        => panel?.Rows.FirstOrDefault(row => string.Equals(row.Label, label, StringComparison.Ordinal))?.Value ?? fallback;

    if (primaryAction is not null)
    {
        responseRoutes.Add((
            Badge: Model.Chrome.Authenticated ? "Tracked return" : "Tracked follow-up",
            Title: Model.Chrome.Authenticated
                ? "Keep this case on the account support page"
                : "Create an account if you want tracked support history here",
            Summary: Model.Chrome.Authenticated
                ? "The next tracked update should stay on the same case id inside Chummer instead of vanishing into side channels."
                : "Guest follow-up still works on reply email, but an account keeps later support history, linked installs, and recovery on one calmer return path.",
            Href: primaryAction.Href,
            Label: primaryAction.Label,
            Proof: Model.Chrome.Authenticated
                ? new[] { "Same case id", "Tracked updates", "Private by default" }
                : new[] { "Guest still works", "History in Account", "No personalized binary" }));
    }

    responseRoutes.Add((
        Badge: "Reality check",
        Title: "Use what works today when you need current public fix truth",
        Summary: "Downloads, status, and known caution stay on the release surfaces when you need to know whether a fix is already user-available instead of merely accepted into support.",
        Href: "/now",
        Label: "Open what works today",
        Proof: new[] { "Current release truth", "Known caution", "Release-linked" }));

    responseRoutes.Add((
        Badge: "Help",
        Title: "Return to help if the issue changes shape",
        Summary: "Use help when the question turns back into direction: install trouble, account recovery, product questions, or figuring out which first-party page should own the next move.",
        Href: helpAction.Href,
        Label: helpAction.Label,
        Proof: new[] { "First-party help", "Safe next step", "No GitHub required" }));

    if (installAction is not null)
    {
        responseRoutes.Add((
            Badge: "Install continuity",
            Title: Model.TrackedCaseSummary?.NeedsLinkedInstall == true || Model.TrackedCaseSummary?.NeedsInstallUpdate == true
                ? "Return to the same install page for relink, update, or reclaim"
                : "Return to the same install page after support",
            Summary: "The installer or affected copy still owns relink, reclaim, and recovery. This confirmation page should not split the install flow into a browser-only ritual.",
            Href: installAction.Href,
            Label: installAction.Label,
            Proof: new[] { "Same install page", "Devices & access stays calm", "No browser-only recovery" }));
    }

    if (Model.TrackedCaseSummary is not null)
    {
        helperFacts.Add(("Current case state", $"{Model.TrackedCaseSummary.StatusLabel} · {Model.TrackedCaseSummary.StageLabel} · {Model.TrackedCaseSummary.UpdatedLabel}"));
        helperFacts.Add(("Next safe action", Model.TrackedCaseSummary.NextSafeAction));
        helperFacts.Add(("Follow-up status", Model.TrackedCaseSummary.FollowUpLaneSummary));
        helperFacts.Add(("Release status", Model.TrackedCaseSummary.ReleaseProgressSummary));
        helperFacts.Add(("Linked install state", Model.TrackedCaseSummary.InstallReadinessSummary));
        helperFacts.Add(("Fix confirmation", Model.TrackedCaseSummary.VerificationSummary));
        if (!string.IsNullOrWhiteSpace(Model.TrackedCaseSummary.AffectedInstallSummary))
        {
            helperFacts.Add(("Affected install", Model.TrackedCaseSummary.AffectedInstallSummary!));
        }

        helperFacts.Add(("Closure", Model.TrackedCaseSummary.ClosureSummary));
    }
    else
    {
        helperFacts.Add(("Keep the case id nearby", $"Use {Model.CaseId} whenever you need to refer back to this report from support, downloads, or a later signed-in return path."));
        helperFacts.Add((Model.Chrome.Authenticated ? "Watch Account > Support" : "Watch your reply email",
            Model.Chrome.Authenticated
                ? "Tracked cases stay in the account surface, so tracked fixes and reporter-ready updates should reappear there instead of vanishing into side channels."
                : "Guest support replies should come back through the email path attached to the case, so keep that inbox visible until the next tracked update lands."));
        if (installAction is not null)
        {
            helperFacts.Add(("Install continuity", "If the report started from an install or recovery page, return to that same guided copy after support tells you the next safe move."));
        }
    }
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@Model.Intro</p>
        <div class="trust-claim__microproof">
            <span>@Model.CaseId</span>
            <span>@Model.StatusLabel.Replace('_', ' ')</span>
        </div>
    </div>
    <div class="stacked-actions">
        @foreach (var action in Model.Actions)
        {
            <a class="button-like button-like--@action.Tone" href="@action.Href">@action.Label</a>
        }
    </div>
</section>

<section class="continuity-band support-submitted-band">
    <div class="continuity-band__copy">
        <p class="eyebrow">What happens next</p>
        <h2 class="editorial-title">The case is in Chummer now, with one stable id and the next honest page attached.</h2>
        <p class="editorial-copy">@Model.ResponseExpectation</p>
    </div>
    <div class="continuity-band__panel">
        @foreach (var item in Model.Highlights)
        {
            <article class="continuity-band__fact">
                <span>Support</span>
                <strong>@item</strong>
            </article>
        }
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Next step pack</p>
        <h2 class="editorial-title">Pick the next support page without losing continuity.</h2>
        <p class="editorial-copy">Support confirmation should not strand you on a dead-end receipt page. Use the page that matches the next job: tracked follow-up, release truth, help, or the same install path.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var route in responseRoutes)
        {
            <article class="route-choice-card">
                <span class="tag">@route.Badge</span>
                <h3>@route.Title</h3>
                <p>@route.Summary</p>
                <div class="route-choice-card__proof">
                    @foreach (var proof in route.Proof)
                    {
                        <span>@proof</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@route.Href">@route.Label</a>
            </article>
        }
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Response helper pack</p>
        <h2 class="editorial-title">Keep the case moving on the same support path.</h2>
        <p class="editorial-copy">
            @(Model.TrackedCaseSummary is null
                ? "This pack keeps the case id, reply path, and install continuity visible until the next tracked update lands."
                : "This pack keeps the current case state, install readiness, release progress, and follow-up status visible without forcing you back into guesswork.")
        </p>
    </div>
    <section class="compact-rail">
        @foreach (var fact in helperFacts)
        {
            <article class="compact-rail__item">
                <div class="compact-rail__copy">
                    <h3>@fact.Heading</h3>
                    <p>@fact.Summary</p>
                </div>
            </article>
        }
    </section>
</section>

@if (Model.SignedInStatus is not null)
{
    <section class="release-footnote">
        <p class="muted-copy">Who can get it now: @TrustRowValue(Model.SignedInStatus, "Who can get it now", "Open the current release to confirm access.")</p>
    </section>
}

@if (Model.TrackedCaseSummary?.TimelineHighlights is { Count: > 0 })
{
    <section class="editorial-block">
        <details class="details-drawer">
            <summary>Case timeline</summary>
            <div class="settings-summary-list">
                @foreach (var eventItem in Model.TrackedCaseSummary.TimelineHighlights)
                {
                    <div class="settings-summary-row">
                        <span>@eventItem.OccurredLabel · @eventItem.Label</span>
                        <strong>@eventItem.Summary</strong>
                    </div>
                }
            </div>
        </details>
    </section>
}

@if (Model.Attachments.Count > 0)
{
    <section class="editorial-block">
        <details class="details-drawer">
            <summary>Saved evidence</summary>
            <div class="settings-summary-list">
                @foreach (var attachment in Model.Attachments)
                {
                    <div class="settings-summary-row">
                        <span>@attachment.FileName</span>
                        <strong>
                            @($"{attachment.SizeBytes / 1024.0:F1} KB · {attachment.UploadedAtUtc:yyyy-MM-dd HH:mm} UTC")
                            @if (!string.IsNullOrWhiteSpace(attachment.DownloadHref))
                            {
                                <a class="inline-link" href="@attachment.DownloadHref">Download</a>
                            }
                        </strong>
                    </div>
                }
            </div>
        </details>
    </section>
}

@model ReadyForTonightPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-trust-page";
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@Model.Intro</p>
        <div class="trust-claim__microproof">
            @foreach (var point in Model.SummaryPoints)
            {
                <span>@point</span>
            }
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--@Model.PrimaryAction.Tone" href="@Model.PrimaryAction.Href">@Model.PrimaryAction.Label</a>
        <a class="button-like button-like--@Model.SecondaryAction.Tone" href="@Model.SecondaryAction.Href">@Model.SecondaryAction.Label</a>
        <a class="button-like button-like--@Model.TertiaryAction.Tone" href="@Model.TertiaryAction.Href">@Model.TertiaryAction.Label</a>
    </div>
</section>

@if (Model.SignedInStatus is not null)
{
    <section class="release-footnote">
        @await Html.PartialAsync("~/Views/Shared/_SignedInTrustStatusPanel.cshtml", Model.SignedInStatus)
    </section>
}

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Session-start verdict</p>
        <h2 class="editorial-title">Make the next game start calmer.</h2>
        <p class="editorial-copy">@Model.VerdictSummary</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var verdict in Model.Verdicts)
        {
            <article class="route-choice-card">
                <span class="tag">@verdict.RoleLabel</span>
                <h3>@verdict.StatusLabel</h3>
                <p>@verdict.Summary</p>
                <div class="route-choice-card__proof">
                    <span>Status: @verdict.Status</span>
                    <span>Next: @verdict.NextBestScreen</span>
                </div>
                <p><strong>Blocking reasons</strong></p>
                <ul>
                    @foreach (var item in verdict.BlockingReasons)
                    {
                        <li>@item</li>
                    }
                </ul>
                <p><strong>Changed since last session</strong></p>
                <ul>
                    @foreach (var item in verdict.ChangedSinceLastSession)
                    {
                        <li>@item</li>
                    }
                </ul>
                <div class="stacked-actions">
                    @foreach (var action in verdict.Actions)
                    {
                        <a class="button-like button-like--@action.Tone" href="@action.Href">@action.Label</a>
                    }
                </div>
                <div class="trust-claim__microproof">
                    @foreach (var proof in verdict.ProofReceipts)
                    {
                        <span>@proof</span>
                    }
                </div>
            </article>
        }
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Starter kits</p>
        <h2 class="editorial-title">Download the bounded loadout that matches the table lane.</h2>
        <p class="editorial-copy">Starter kits stay small on purpose: enough to reduce session-start anxiety, not an excuse to pretend the deep builder disappeared.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var kit in Model.RoleKits)
        {
            <article class="route-choice-card">
                <span class="tag">@kit.RoleLane</span>
                <h3>@kit.Label</h3>
                <p>@kit.Summary</p>
                <div class="route-choice-card__proof">
                    @foreach (var item in kit.Highlights)
                    {
                        <span>@item</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@kit.DownloadHref">Download starter loadout JSON</a>
            </article>
        }
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Packets and handoff</p>
        <h2 class="editorial-title">Carry the packet into print, export, or mobile without losing provenance.</h2>
        <p class="editorial-copy">The file routes below are first-party. They keep the session-start packet, machine-readable copy, and mobile return path attached to the same public-safe rail.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var packet in Model.Packets)
        {
            <article class="route-choice-card">
                <span class="tag">@packet.RoleId</span>
                <h3>@packet.Label</h3>
                <p>@packet.Summary</p>
                <div class="stacked-actions">
                    <a class="button-like button-like--primary" href="@packet.MarkdownHref">Download packet</a>
                    <a class="button-like button-like--secondary" href="@packet.JsonHref">Open packet JSON</a>
                </div>
            </article>
        }
        <article class="route-choice-card">
            <span class="tag">mobile</span>
            <h3>Mobile handoff</h3>
            <p>Keep the packet family, install rail, and continuity rail attached when the session moves off the desktop.</p>
            <div class="stacked-actions">
                <a class="button-like button-like--primary" href="/ready/handoff/mobile.json">Open handoff JSON</a>
                <a class="button-like button-like--secondary" href="/mobile">Open mobile and PWA</a>
            </div>
        </article>
    </div>
</section>

@if (Model.TrustPulse is not null)
{
    <section class="release-footnote">
        @await Html.PartialAsync("~/Views/Shared/_PublicTrustPulsePanel.cshtml", Model.TrustPulse)
    </section>
}

@model ReadyForTonightPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-trust-page";
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@PublicFacingCopyHumanizer.Clean(Model.Intro)</p>
        <div class="trust-claim__details">
            @foreach (var point in Model.SummaryPoints)
            {
                <span>@PublicFacingCopyHumanizer.Clean(point)</span>
            }
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--@Model.PrimaryAction.Tone" href="@Model.PrimaryAction.Href">@Model.PrimaryAction.Label</a>
        <a class="button-like button-like--@Model.SecondaryAction.Tone" href="@Model.SecondaryAction.Href">@Model.SecondaryAction.Label</a>
        <a class="button-like button-like--@Model.TertiaryAction.Tone" href="@Model.TertiaryAction.Href">@Model.TertiaryAction.Label</a>
    </div>
</section>

@if (Model.SignedInStatus is not null)
{
    <section class="release-footnote">
        @await Html.PartialAsync("~/Views/Shared/_SignedInTrustStatusPanel.cshtml", Model.SignedInStatus)
    </section>
}

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Session start</p>
        <h2 class="editorial-title">Make the next game start calmer.</h2>
        <p class="editorial-copy">@PublicFacingCopyHumanizer.Clean(Model.VerdictSummary)</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var verdict in Model.Verdicts)
        {
            <article class="route-choice-card">
                <span class="tag">@verdict.RoleLabel</span>
                <h3>@verdict.StatusLabel</h3>
                <p>@PublicFacingCopyHumanizer.Clean(verdict.Summary)</p>
                <p><strong>Blocking reasons</strong></p>
                <ul>
                    @foreach (var item in verdict.BlockingReasons)
                    {
                        <li>@PublicFacingCopyHumanizer.Clean(item)</li>
                    }
                </ul>
                <p><strong>Changed since last session</strong></p>
                <ul>
                    @foreach (var item in verdict.ChangedSinceLastSession)
                    {
                        <li>@PublicFacingCopyHumanizer.Clean(item)</li>
                    }
                </ul>
                <div class="stacked-actions">
                    @foreach (var action in verdict.Actions)
                    {
                        <a class="button-like button-like--@action.Tone" href="@action.Href">@action.Label</a>
                    }
                </div>
            </article>
        }
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Starter kits</p>
        <h2 class="editorial-title">Download the small loadout that matches your table role.</h2>
        <p class="editorial-copy">Starter kits stay small on purpose: enough to reduce session-start anxiety without replacing the full builder.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var kit in Model.RoleKits)
        {
            <article class="route-choice-card">
                <span class="tag">@PublicFacingCopyHumanizer.Clean(kit.RoleLane)</span>
                <h3>@kit.Label</h3>
                <p>@PublicFacingCopyHumanizer.Clean(kit.Summary)</p>
                <div class="route-choice-card__details">
                    @foreach (var item in kit.Highlights)
                    {
                        <span>@PublicFacingCopyHumanizer.Clean(item)</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@kit.DownloadHref">Download starter file</a>
            </article>
        }
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Files and mobile setup</p>
        <h2 class="editorial-title">Carry the session notes into print, export, or mobile.</h2>
        <p class="editorial-copy">The files below keep the session-start notes, downloadable setup, and mobile return path together.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var packet in Model.Packets)
        {
            <article class="route-choice-card">
                <span class="tag">@PublicFacingCopyHumanizer.Clean(packet.RoleId)</span>
                <h3>@packet.Label</h3>
                <p>@PublicFacingCopyHumanizer.Clean(packet.Summary)</p>
                <div class="stacked-actions">
                    <a class="button-like button-like--primary" href="@packet.MarkdownHref">Download notes</a>
                    <a class="button-like button-like--secondary" href="@packet.JsonHref">Open setup file</a>
                </div>
            </article>
        }
        <article class="route-choice-card">
            <span class="tag">mobile</span>
            <h3>Mobile setup</h3>
            <p>Keep the session files, install path, and return path together when the session moves off the desktop.</p>
            <div class="stacked-actions">
                <a class="button-like button-like--primary" href="/ready/handoff/mobile.json">Open mobile setup file</a>
                <a class="button-like button-like--secondary" href="/mobile">Open mobile and PWA</a>
            </div>
        </article>
    </div>
</section>

@if (Model.TrustPulse is not null)
{
    <section class="release-footnote">
        @await Html.PartialAsync("~/Views/Shared/_PublicTrustPulsePanel.cshtml", Model.TrustPulse)
    </section>
}

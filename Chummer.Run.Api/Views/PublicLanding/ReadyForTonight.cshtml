@model ReadyForTonightPageViewModel
@{
    ViewData["Title"] = UndetectableHumanizerCopyAdapter.Humanize(Model.Heading);
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-trust-page";
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@UndetectableHumanizerCopyAdapter.Humanize(Model.Eyebrow)</p>
        <h1 class="page-title">@UndetectableHumanizerCopyAdapter.Humanize(Model.Heading)</h1>
        <p class="page-copy">@UndetectableHumanizerCopyAdapter.Humanize(Model.Intro)</p>
        <div class="trust-claim__details">
            @foreach (var point in Model.SummaryPoints)
            {
                <span>@UndetectableHumanizerCopyAdapter.Humanize(point)</span>
            }
        </div>
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--@Model.PrimaryAction.Tone" href="@Model.PrimaryAction.Href">@UndetectableHumanizerCopyAdapter.Humanize(Model.PrimaryAction.Label)</a>
        <a class="button-like button-like--@Model.SecondaryAction.Tone" href="@Model.SecondaryAction.Href">@UndetectableHumanizerCopyAdapter.Humanize(Model.SecondaryAction.Label)</a>
        <a class="button-like button-like--@Model.TertiaryAction.Tone" href="@Model.TertiaryAction.Href">@UndetectableHumanizerCopyAdapter.Humanize(Model.TertiaryAction.Label)</a>
    </div>
</section>

@if (Model.SignedInStatus is not null)
{
    <section class="release-footnote">
        @await Html.PartialAsync("~/Views/Shared/_SignedInTrustStatusPanel.cshtml", Model.SignedInStatus)
    </section>
}

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Session start</p>
        <h2 class="editorial-title">Make the next game start calmer.</h2>
        <p class="editorial-copy">@UndetectableHumanizerCopyAdapter.Humanize(Model.VerdictSummary)</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var verdict in Model.Verdicts)
        {
            <article class="route-choice-card">
                <span class="tag">@UndetectableHumanizerCopyAdapter.Humanize(verdict.RoleLabel)</span>
                <h3>@UndetectableHumanizerCopyAdapter.Humanize(verdict.StatusLabel)</h3>
                <p>@UndetectableHumanizerCopyAdapter.Humanize(verdict.Summary)</p>
                <p><strong>Blocking reasons</strong></p>
                <ul>
                    @foreach (var item in verdict.BlockingReasons)
                    {
                        <li>@UndetectableHumanizerCopyAdapter.Humanize(item)</li>
                    }
                </ul>
                <p><strong>Changed since last session</strong></p>
                <ul>
                    @foreach (var item in verdict.ChangedSinceLastSession)
                    {
                        <li>@UndetectableHumanizerCopyAdapter.Humanize(item)</li>
                    }
                </ul>
                <div class="stacked-actions">
                    @foreach (var action in verdict.Actions)
                    {
                        <a class="button-like button-like--@action.Tone" href="@action.Href">@UndetectableHumanizerCopyAdapter.Humanize(action.Label)</a>
                    }
                </div>
            </article>
        }
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Starter kits</p>
        <h2 class="editorial-title">Download the small loadout that matches your table role.</h2>
        <p class="editorial-copy">Starter kits stay small on purpose: enough to reduce session-start anxiety without replacing the full builder.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var kit in Model.RoleKits)
        {
            <article class="route-choice-card">
                <span class="tag">@UndetectableHumanizerCopyAdapter.Humanize(kit.RoleLane)</span>
                <h3>@UndetectableHumanizerCopyAdapter.Humanize(kit.Label)</h3>
                <p>@UndetectableHumanizerCopyAdapter.Humanize(kit.Summary)</p>
                <div class="route-choice-card__details">
                    @foreach (var item in kit.Highlights)
                    {
                        <span>@UndetectableHumanizerCopyAdapter.Humanize(item)</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@kit.DownloadHref">Download starter file</a>
            </article>
        }
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Files</p>
        <h2 class="editorial-title">Carry the session notes into print or export.</h2>
        <p class="editorial-copy">The files below keep the session-start notes and downloadable setup together.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var packet in Model.Packets)
        {
            <article class="route-choice-card">
                <span class="tag">@UndetectableHumanizerCopyAdapter.Humanize(packet.RoleId)</span>
                <h3>@UndetectableHumanizerCopyAdapter.Humanize(packet.Label)</h3>
                <p>@UndetectableHumanizerCopyAdapter.Humanize(packet.Summary)</p>
                <div class="stacked-actions">
                    <a class="button-like button-like--primary" href="@packet.MarkdownHref">Download notes</a>
                    <a class="button-like button-like--secondary" href="@packet.JsonHref">Open setup details</a>
                </div>
            </article>
        }
        <article class="route-choice-card">
            <span class="tag">mobile</span>
            <h3>Mobile setup</h3>
            <p>Keep the session files, install path, and return path together when the session moves off the desktop.</p>
            <div class="stacked-actions">
                <a class="button-like button-like--primary" href="/mobile">Open mobile view</a>
                <a class="button-like button-like--secondary" href="/help">Open setup help</a>
            </div>
        </article>
    </div>
</section>

@if (Model.TrustPulse is not null)
{
    <section class="release-footnote">
        @await Html.PartialAsync("~/Views/Shared/_PublicTrustPulsePanel.cshtml", Model.TrustPulse)
    </section>
}

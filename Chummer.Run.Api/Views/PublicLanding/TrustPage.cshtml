@model TrustPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-trust-page";
}

<section class="trust-page-hero">
    <div class="trust-page-hero__copy">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@Model.Intro</p>
    </div>
    <div class="stacked-actions">
        @foreach (var action in Model.Actions)
        {
            <a class="button-like button-like--@action.Tone" href="@action.Href">@action.Label</a>
        }
    </div>
</section>

<section class="trust-page-sections">
    @foreach (var pageSection in Model.Sections)
    {
        <article class="trust-page-section" id="@pageSection.Id">
            <p class="eyebrow">@pageSection.Eyebrow</p>
            <h2>@pageSection.Heading</h2>
            <p>@pageSection.Body</p>
            @if (pageSection.Bullets is { Count: > 0 })
            {
                <ul class="trust-page-section__list">
                    @foreach (var bullet in pageSection.Bullets)
                    {
                        <li>@bullet</li>
                    }
                </ul>
            }
        </article>
    }
</section>

@using Chummer.Run.Api.Services
@model TrustPageViewModel
@{
    ViewData["Title"] = UndetectableHumanizerCopyAdapter.Humanize(Model.Heading);
    ViewData["Chrome"] = Model.Chrome;
    var helpPage = string.Equals(Model.PageId, "help", StringComparison.OrdinalIgnoreCase);
    var contactPage = string.Equals(Model.PageId, "contact", StringComparison.OrdinalIgnoreCase);
    var policyPage = string.Equals(Model.PageId, "privacy", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.PageId, "terms", StringComparison.OrdinalIgnoreCase);
    ViewData["SurfaceClass"] = helpPage || contactPage
        ? "surface-help surface-minimal"
        : "surface-trust-page";
    ViewData["ContextSidebarHeading"] = helpPage || contactPage ? null : "Page sections";
    ViewData["ContextSidebarSummary"] = helpPage || contactPage
        ? null
        : "Jump between the current sections.";
    ViewData["ContextSidebarLinks"] = helpPage || contactPage
        ? Array.Empty<PublicNavigationLink>()
        : Model.Sections
            .Select(section => new PublicNavigationLink(section.Heading, $"#{section.Id}"))
            .ToArray();
    var deferSupportPanels = helpPage || contactPage;
    var guestPreviewHref = !Model.Chrome.Authenticated && !string.IsNullOrWhiteSpace(Model.Chrome.PublicPrimaryCta?.Href)
        ? Model.Chrome.PublicPrimaryCta!.Href
        : "/downloads";
    var policyFacts = new List<(string Tag, string Heading, string Summary, string Href)>();
    var helpRouteChoices = new List<(string Id, string Badge, string Title, string Summary, string Href, string Label, string[] Details)>();
    var contactRouteChoices = new List<(string Id, string Badge, string Title, string Summary, string Href, string Label, string[] Details)>();

    string ContextualPreviewHref(string? href)
    {
        var resolvedHref = string.IsNullOrWhiteSpace(href) ? "/downloads" : href;
        if (string.Equals(resolvedHref, "/downloads", StringComparison.OrdinalIgnoreCase))
        {
            return guestPreviewHref;
        }

        return resolvedHref;
    }

    string PublicText(string? value) => UndetectableHumanizerCopyAdapter.Humanize(value);

    static TrustPageActionViewModel? HelpActionFor(string sectionId, bool authenticated) => sectionId switch
    {
        "install-update" => new TrustPageActionViewModel("Open downloads", "/downloads", "secondary"),
        "sign-in-recovery" => new TrustPageActionViewModel(authenticated ? "Open account" : "Claim your copy", authenticated ? "/account" : "/signup?next=/home", "secondary"),
        "product-bug" => new TrustPageActionViewModel("Open support", "/contact#support-intake", "secondary"),
        "product-question" => new TrustPageActionViewModel("Read the FAQ", "/faq", "secondary"),
        _ => null
    };

    static TrustPageActionViewModel? HelpFallbackActionFor(string sectionId, bool authenticated) => sectionId switch
    {
        "install-update" => new TrustPageActionViewModel("Open support", "/contact#support-intake", "ghost"),
        "sign-in-recovery" => new TrustPageActionViewModel("Open support", "/contact#support-intake", "ghost"),
        "product-bug" => new TrustPageActionViewModel("Open status", "/status", "ghost"),
        "product-question" => new TrustPageActionViewModel("Open support", "/contact#support-intake", "ghost"),
        _ => null
    };

    if (policyPage && Model.SummaryPoints is { Count: > 0 })
    {
        for (var index = 0; index < Model.SummaryPoints.Count; index++)
        {
            var sourceSection = index < Model.Sections.Count ? Model.Sections[index] : null;
            policyFacts.Add((
                Tag: sourceSection?.Eyebrow ?? "Policy",
                Heading: sourceSection?.Heading ?? "Current summary",
                Summary: Model.SummaryPoints[index],
                Href: sourceSection is null ? "#" : $"#{sourceSection.Id}"));
        }
    }

    if (helpPage)
    {
        foreach (var pageSection in Model.Sections)
        {
            var quickAction = HelpActionFor(pageSection.Id, Model.Chrome.Authenticated);
            var fallbackAction = HelpFallbackActionFor(pageSection.Id, Model.Chrome.Authenticated);
            var routeAction = quickAction ?? fallbackAction ?? new TrustPageActionViewModel("Open details", $"#{pageSection.Id}", "ghost");
            helpRouteChoices.Add((
                Id: pageSection.Id,
                Badge: pageSection.Eyebrow,
                Title: pageSection.Heading,
                Summary: pageSection.Body,
                Href: ContextualPreviewHref(routeAction.Href),
                Label: routeAction.Label,
                Details: (pageSection.Bullets ?? Array.Empty<string>())
                    .Where(static bullet => !string.IsNullOrWhiteSpace(bullet))
                    .ToArray()));
        }
    }

    if (contactPage && Model.SupportIntake is not null)
    {
        string installHref = ContextualPreviewHref(Model.SupportIntake.InstallAccessHref);
        string installSummary = string.IsNullOrWhiteSpace(Model.SupportIntake.InstallRailSummary)
            ? "Devices and access is where you reconnect, replace, or recover this copy."
            : Model.SupportIntake.InstallRailSummary!;
        string installTitle = Model.SupportIntake.RecoveryModeOnly
            ? "Install recovery stays on the same device page"
            : "Account return stays attached to the affected copy";
        string installRouteLabel = string.IsNullOrWhiteSpace(Model.SupportIntake.InstallRailLabel)
            ? Model.SupportIntake.InstallAccessLabel
            : Model.SupportIntake.InstallRailLabel!;
        contactRouteChoices.Add((
            Id: "public-ideas",
            Badge: "Public",
            Title: "Ideas and safe public bugs",
            Summary: "Use Participate when the discussion can be public and does not need logs, account detail, or campaign secrets.",
            Href: "/participate",
            Label: "Open participate",
            Details: new[] { "Public board", "Votes and comments", "No private logs" }));
        contactRouteChoices.Add((
            Id: "private-help",
            Badge: "Private",
            Title: "Install trouble, crashes, or account detail",
            Summary: "Use support when the issue needs a reply, screenshots, logs, install recovery, or anything you do not want public.",
            Href: "#support-intake",
            Label: "Open support",
            Details: new[] { "Guest allowed", "Private reply", "Tracked later if you sign in" }));
    }
}

<section class="@((helpPage || contactPage) ? "minimal-page-hero" : "trust-page-hero")">
    <div class="@((helpPage || contactPage) ? string.Empty : "trust-page-hero__copy")">
        <p class="@((helpPage || contactPage) ? "minimal-kicker" : "eyebrow")">@PublicText(Model.Eyebrow)</p>
        <h1 class="@((helpPage || contactPage) ? string.Empty : "page-title")">@PublicText(Model.Heading)</h1>
        <p class="@((helpPage || contactPage) ? string.Empty : "page-copy")">@PublicText(Model.Intro)</p>
        @if (!(helpPage || contactPage) && (!string.IsNullOrWhiteSpace(Model.EffectiveDate) || !string.IsNullOrWhiteSpace(Model.UpdatedDate)))
        {
            <div class="trust-claim__details">
                @if (!string.IsNullOrWhiteSpace(Model.EffectiveDate))
                {
                    <span>Effective @Model.EffectiveDate</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.UpdatedDate))
                {
                    <span>Updated @Model.UpdatedDate</span>
                }
            </div>
        }
        @if (!policyPage && !(helpPage || contactPage) && Model.SummaryPoints is { Count: > 0 })
        {
            <div class="trust-claim__details">
                @foreach (var point in Model.SummaryPoints)
                {
                    <span>@PublicText(point)</span>
                }
            </div>
        }
    </div>
    @if (!(helpPage || contactPage))
    {
        <div class="stacked-actions">
            @foreach (var action in Model.Actions)
            {
                <a class="button-like button-like--@action.Tone" href="@ContextualPreviewHref(action.Href)">@PublicText(action.Label)</a>
            }
        </div>
    }
</section>

@if (Model.SignedInStatus is not null && !deferSupportPanels)
{
    <section class="release-footnote">
        @await Html.PartialAsync("~/Views/Shared/_SignedInTrustStatusPanel.cshtml", Model.SignedInStatus)
    </section>
}

@if (Model.PrivacyBoundary is not null && !deferSupportPanels)
{
    @await Html.PartialAsync("~/Views/Shared/_PrivacyBoundaryPanel.cshtml", Model.PrivacyBoundary)
}

@if (policyFacts.Count > 0)
{
    <section class="continuity-band trust-doc-band">
        <div class="continuity-band__copy">
            <p class="eyebrow">@((string.Equals(Model.PageId, "privacy", StringComparison.OrdinalIgnoreCase) ? "Privacy summary" : "Rule summary"))</p>
            <h2 class="editorial-title">@((string.Equals(Model.PageId, "privacy", StringComparison.OrdinalIgnoreCase) ? "Read the short privacy summary first, then the full policy." : "Read the short rules summary first, then the full terms."))</h2>
            <p class="editorial-copy">@((string.Equals(Model.PageId, "privacy", StringComparison.OrdinalIgnoreCase)
                ? "Start with the short version: the app file stays the same for everyone, and telemetry or diagnostics stay explicit about what they capture."
                : "Start with the short version: Downloads shows the current public installer, platform notes, and any limits before you install."))</p>
        </div>
        <div class="continuity-band__panel">
            @foreach (var fact in policyFacts)
            {
                <article class="continuity-band__fact">
                    <span>@PublicText(fact.Tag)</span>
                    <strong>@PublicText(fact.Heading)</strong>
                    <p>@PublicText(fact.Summary)</p>
                    @if (!string.Equals(fact.Href, "#", StringComparison.Ordinal))
                    {
                        <a class="inline-link" href="@fact.Href">Open section</a>
                    }
                </article>
            }
        </div>
    </section>
}

@if (helpPage)
{
    <section class="minimal-section minimal-section--tight">
        <div class="minimal-section__lead">
            <h2>Pick the problem</h2>
            <p>Each card starts with the best first step. Use the second link only if needed.</p>
        </div>
        <div class="minimal-help-grid">
            @foreach (var choice in helpRouteChoices)
            {
                var fallbackAction = HelpFallbackActionFor(choice.Id, Model.Chrome.Authenticated);
                <article class="minimal-help-card" id="@choice.Id">
                    <span>@PublicText(choice.Badge)</span>
                    <h3>@PublicText(choice.Title)</h3>
                    <p>@PublicText(choice.Summary)</p>
                    @if (choice.Details.Length > 0)
                    {
                        <ul class="minimal-help-card__list" aria-label="Quick notes">
                            @foreach (var item in choice.Details)
                            {
                                <li>@PublicText(item)</li>
                            }
                        </ul>
                    }
                    <a class="inline-link" href="@choice.Href">@PublicText(choice.Label)</a>
                    @if (fallbackAction is not null)
                    {
                        <p class="muted-copy">Or: <a class="inline-link" href="@ContextualPreviewHref(fallbackAction.Href)">@PublicText(fallbackAction.Label)</a></p>
                    }
                </article>
            }
        </div>
    </section>
}
else if (!contactPage)
{
    <section class="trust-page-layout">
        <div class="trust-page-sections">
            @foreach (var pageSection in Model.Sections)
            {
                <article class="trust-page-section" id="@pageSection.Id">
                    <p class="eyebrow">@PublicText(pageSection.Eyebrow)</p>
                    <h2>@PublicText(pageSection.Heading)</h2>
                    <p>@PublicText(pageSection.Body)</p>
                    @if (pageSection.Bullets is { Count: > 0 })
                    {
                        <ul class="trust-page-section__list">
                            @foreach (var bullet in pageSection.Bullets)
                            {
                                <li>@PublicText(bullet)</li>
                            }
                        </ul>
                    }
                </article>
            }
        </div>
    </section>
}

@if (Model.SupportIntake is not null && contactPage)
{
    <section class="minimal-section minimal-section--tight">
        <div class="minimal-section__lead">
            <h2>Choose one</h2>
            <p>Public ideas go to Participate. Private problems stay here.</p>
        </div>
        <div class="route-choice-grid route-choice-grid--two route-choice-grid--compact" id="contact-paths">
            @foreach (var choice in contactRouteChoices)
            {
                <article class="route-choice-card" id="@choice.Id">
                    <span class="tag">@PublicText(choice.Badge)</span>
                    <h3>@PublicText(choice.Title)</h3>
                    <p>@PublicText(choice.Summary)</p>
                    <div class="route-choice-card__details">
                        @foreach (var item in choice.Details)
                        {
                            <span>@PublicText(item)</span>
                        }
                    </div>
                    <a class="editorial-strip__action" href="@choice.Href">@PublicText(choice.Label)</a>
                </article>
            }
        </div>
    </section>

    <section class="minimal-section minimal-section--tight" id="support-intake">
        <article class="trust-page-section trust-page-section--form minimal-help-card">
            <p class="eyebrow">Support</p>
            <h2>@PublicText(Model.SupportIntake.Heading)</h2>
            <p>@PublicText(Model.SupportIntake.Intro)</p>

            @if (!string.IsNullOrWhiteSpace(Model.SupportIntake.SubmissionNotice))
            {
                <p class="status-copy status-copy--success">@PublicText(Model.SupportIntake.SubmissionNotice)</p>
            }
            <p class="muted-copy">One problem per message keeps the reply clear.</p>

            <form class="settings-form" method="post" action="@Model.SupportIntake.ActionHref" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="field">
                    <label for="supportKind">Problem type</label>
                    <select id="supportKind" name="kind" required>
                        @foreach (var option in Model.SupportIntake.Options)
                        {
                            <option value="@option.Value" selected="@(string.Equals(Model.SupportIntake.DefaultKind, option.Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@PublicText(option.Label)</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="supportTitle">Title</label>
                    <input id="supportTitle" name="title" maxlength="160" placeholder="Installer linked, but first launch did not explain the next step" value="@Model.SupportIntake.DefaultTitle" required />
                </div>
                <div class="field">
                    <label for="supportSummary">Short summary</label>
                    <input id="supportSummary" name="summary" maxlength="280" placeholder="The Linux release installed successfully, but the post-install guidance was unclear." value="@Model.SupportIntake.DefaultSummary" required />
                </div>
                <div class="field">
                    <label for="supportDetail">What happened</label>
                    <textarea id="supportDetail" name="detail" rows="6" placeholder="Tell Chummer what you expected, what actually happened, and the fastest way to reproduce it." required>@Model.SupportIntake.DefaultDetail</textarea>
                </div>
                @if (!Model.SupportIntake.Authenticated)
                {
                    <div class="field">
                        <label for="supportReplyEmail">Reply email</label>
                        <input id="supportReplyEmail" name="replyEmail" type="email" placeholder="runner@example.com" required />
                    </div>
                }
                <details class="details-drawer">
                    <summary>Optional environment details</summary>
                    @if (!string.IsNullOrWhiteSpace(Model.SupportIntake.ContextHint))
                    {
                        <p class="muted-copy">@PublicText(Model.SupportIntake.ContextHint)</p>
                    }
                    <div class="field">
                        <label for="supportPlatform">Platform</label>
                        <input id="supportPlatform" name="platform" maxlength="64" placeholder="Windows, Linux, or macOS" value="@Model.SupportIntake.DefaultPlatform" />
                    </div>
                    <div class="field">
                        <label for="supportVersion">Version</label>
                        <input id="supportVersion" name="applicationVersion" maxlength="64" placeholder="Current public build or version number" value="@Model.SupportIntake.DefaultApplicationVersion" />
                    </div>
                    <div class="field">
                        <label for="supportReleaseChannel">Release channel</label>
                        <input id="supportReleaseChannel" name="releaseChannel" maxlength="64" placeholder="public release, beta, or stable" value="@Model.SupportIntake.DefaultReleaseChannel" />
                    </div>
                    <div class="field">
                        <label for="supportHeadId">Desktop head</label>
                        <input id="supportHeadId" name="headId" maxlength="64" placeholder="avalonia or another shipped head" value="@Model.SupportIntake.DefaultHeadId" />
                    </div>
                    <div class="field">
                        <label for="supportInstallationId">Install id</label>
                        <input id="supportInstallationId" name="installationId" maxlength="64" placeholder="Optional install id from Devices and access" value="@Model.SupportIntake.DefaultInstallationId" />
                    </div>
                    <div class="field">
                        <label for="supportArch">Architecture</label>
                        <input id="supportArch" name="arch" maxlength="32" placeholder="x64 or arm64" value="@Model.SupportIntake.DefaultArch" />
                    </div>
                </details>
                <details class="details-drawer">
                    <summary>Attachments</summary>
                    <p class="muted-copy">@PublicText(Model.SupportIntake.AttachmentHelp)</p>
                    <div class="field">
                        <label for="supportAttachments">Screenshots, logs, or small bundles</label>
                        <input id="supportAttachments" name="attachments" type="file" multiple accept=".png,.jpg,.jpeg,.webp,.txt,.log,.json,.zip,.md" />
                    </div>
                </details>
                <div class="stacked-actions">
                    <button class="button-like button-like--primary" type="submit">Send support request</button>
                    <a class="button-like button-like--secondary" href="@Model.SupportIntake.AccountSupportHref">@PublicText(Model.SupportIntake.AccountSupportLabel)</a>
                    <a class="button-like button-like--ghost" href="@Model.SupportIntake.InstallAccessHref">@PublicText(Model.SupportIntake.InstallAccessLabel)</a>
                </div>
            </form>
            @if (!string.IsNullOrWhiteSpace(Model.SupportIntake.InstallRailHref)
                && !string.IsNullOrWhiteSpace(Model.SupportIntake.InstallRailLabel)
                && !string.IsNullOrWhiteSpace(Model.SupportIntake.InstallRailSummary))
            {
                <p class="muted-copy">Back to setup: <a class="inline-link" href="@Model.SupportIntake.InstallRailHref">@PublicText(Model.SupportIntake.InstallRailLabel)</a></p>
            }
        </article>
    </section>
}

@if (Model.SignedInStatus is not null && deferSupportPanels)
{
    <section class="release-footnote">
        @await Html.PartialAsync("~/Views/Shared/_SignedInTrustStatusPanel.cshtml", Model.SignedInStatus)
    </section>
}

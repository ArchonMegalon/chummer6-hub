@using Chummer.Run.Api.Services
@model TrustPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    var helpPage = string.Equals(Model.PageId, "help", StringComparison.OrdinalIgnoreCase);
    var contactPage = string.Equals(Model.PageId, "contact", StringComparison.OrdinalIgnoreCase);
    var policyPage = string.Equals(Model.PageId, "privacy", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.PageId, "terms", StringComparison.OrdinalIgnoreCase);
    ViewData["SurfaceClass"] = helpPage
        ? "surface-help surface-minimal"
        : "surface-trust-page";
    ViewData["ContextSidebarHeading"] = helpPage ? "Help" : "Page sections";
    ViewData["ContextSidebarSummary"] = helpPage
        ? "Jump to the help path that matches the problem."
        : "Jump between the current trust sections from the shared side panel.";
    ViewData["ContextSidebarLinks"] = Model.Sections
        .Select(section => new PublicNavigationLink(section.Heading, $"#{section.Id}"))
        .ToArray();
    var deferSupportPanels = helpPage || contactPage;
    var guestPreviewHref = !Model.Chrome.Authenticated && !string.IsNullOrWhiteSpace(Model.Chrome.PublicPrimaryCta?.Href)
        ? Model.Chrome.PublicPrimaryCta!.Href
        : "/downloads";
    var policyFacts = new List<(string Tag, string Heading, string Summary, string Href)>();
    var helpRouteChoices = new List<(string Id, string Badge, string Title, string Summary, string Href, string Label, string[] Details)>();
    var contactRouteChoices = new List<(string Id, string Badge, string Title, string Summary, string Href, string Label, string[] Details)>();

    string ContextualPreviewHref(string? href)
    {
        var resolvedHref = string.IsNullOrWhiteSpace(href) ? "/downloads" : href;
        if (string.Equals(resolvedHref, "/downloads", StringComparison.OrdinalIgnoreCase))
        {
            return guestPreviewHref;
        }

        return resolvedHref;
    }

    string PublicText(string? value) => PublicFacingCopyHumanizer.Clean(value);

    static TrustPageActionViewModel? HelpActionFor(string sectionId, bool authenticated) => sectionId switch
    {
        "install-update" => new TrustPageActionViewModel("Open downloads", "/downloads", "secondary"),
        "sign-in-recovery" => new TrustPageActionViewModel(authenticated ? "Open account" : "Create account", authenticated ? "/account" : "/signup?next=/home", "secondary"),
        "product-bug" => new TrustPageActionViewModel("Open support intake", "/contact#support-intake", "secondary"),
        "product-question" => new TrustPageActionViewModel("Read the FAQ", "/faq", "secondary"),
        _ => null
    };

    static TrustPageActionViewModel? HelpFallbackActionFor(string sectionId, bool authenticated) => sectionId switch
    {
        "install-update" => new TrustPageActionViewModel("Open support intake", "/contact#support-intake", "ghost"),
        "sign-in-recovery" => new TrustPageActionViewModel("Open support intake", "/contact#support-intake", "ghost"),
        "product-bug" => new TrustPageActionViewModel("See what works today", "/now", "ghost"),
        "product-question" => new TrustPageActionViewModel("Open support intake", "/contact#support-intake", "ghost"),
        _ => null
    };

    if (policyPage && Model.SummaryPoints is { Count: > 0 })
    {
        for (var index = 0; index < Model.SummaryPoints.Count; index++)
        {
            var sourceSection = index < Model.Sections.Count ? Model.Sections[index] : null;
            policyFacts.Add((
                Tag: sourceSection?.Eyebrow ?? "Policy",
                Heading: sourceSection?.Heading ?? "Current boundary",
                Summary: Model.SummaryPoints[index],
                Href: sourceSection is null ? "#" : $"#{sourceSection.Id}"));
        }
    }

    if (helpPage)
    {
        foreach (var pageSection in Model.Sections)
        {
            var quickAction = HelpActionFor(pageSection.Id, Model.Chrome.Authenticated);
            var fallbackAction = HelpFallbackActionFor(pageSection.Id, Model.Chrome.Authenticated);
            var routeAction = quickAction ?? fallbackAction ?? new TrustPageActionViewModel("Open details", $"#{pageSection.Id}", "ghost");
            helpRouteChoices.Add((
                Id: pageSection.Id,
                Badge: pageSection.Eyebrow,
                Title: pageSection.Heading,
                Summary: pageSection.Body,
                Href: ContextualPreviewHref(routeAction.Href),
                Label: routeAction.Label,
                Details: Array.Empty<string>()));
        }
    }

    if (contactPage && Model.SupportIntake is not null)
    {
        string installHref = ContextualPreviewHref(Model.SupportIntake.InstallAccessHref);
        string installSummary = string.IsNullOrWhiteSpace(Model.SupportIntake.InstallRailSummary)
            ? "Devices and access stays the calm relink, reclaim, and recovery page after the installer or app does the real work."
            : Model.SupportIntake.InstallRailSummary!;
        string installTitle = Model.SupportIntake.RecoveryModeOnly
            ? "Install recovery stays on the same device page"
            : "Account return stays attached to the affected copy";
        string installRouteLabel = string.IsNullOrWhiteSpace(Model.SupportIntake.InstallRailLabel)
            ? Model.SupportIntake.InstallAccessLabel
            : Model.SupportIntake.InstallRailLabel!;
        contactRouteChoices.Add((
            Id: "public-issues",
            Badge: "Public signal",
            Title: "Safe public feedback should start on the public feedback page",
            Summary: "Feature requests, safe public bugs, and confusing public copy belong on the public feedback page. Install failures, account issues, logs, and private campaign detail do not.",
            Href: "/feedback",
            Label: "Open feedback",
            Details: new[] { "Public page", "Votes show demand", "No private logs" }));
        contactRouteChoices.Add((
            Id: "right-lane",
            Badge: "Private support",
            Title: "Use the support form when the issue needs logs or account detail",
            Summary: "Support is the normal path for crashes, install recovery, broken behavior, and anything that needs logs or support history.",
            Href: "#support-intake",
            Label: "Open support intake",
            Details: new[] { "Private reply", "Saved case", "Account optional" }));
        contactRouteChoices.Add((
            Id: "tracked-support",
            Badge: "Saved history",
            Title: "Create an account when you want support history in one place",
            Summary: "Guest submissions are allowed. An account keeps the case, recovery state, and later replies in one place.",
            Href: ContextualPreviewHref(Model.SupportIntake.AccountSupportHref),
            Label: Model.SupportIntake.AccountSupportLabel,
            Details: new[] { "Guest allowed", "History in Account", "No outside account" }));
        contactRouteChoices.Add((
            Id: "install-continuity",
            Badge: "Account return",
            Title: installTitle,
            Summary: installSummary,
            Href: installHref,
            Label: installRouteLabel,
            Details: new[]
            {
                Model.SupportIntake.RecoveryModeOnly ? "Recovery mode only" : "Normal install path",
                "Devices & access stays simple",
                "Account return"
            }));
        contactRouteChoices.Add((
            Id: "guided-routing",
            Badge: "Guided routing",
            Title: "Open one guided page when you are not sure where to start",
            Summary: "The guide keeps feedback, support, install return, and account help separate without making you choose from a long list.",
            Href: "/contact/concierge",
            Label: "Open concierge",
            Details: new[] { "Optional", "Simple fallback", "Help stays visible" }));
    }
}

<section class="@(helpPage ? "minimal-page-hero" : "trust-page-hero")">
    <div class="@(helpPage ? string.Empty : "trust-page-hero__copy")">
        <p class="@(helpPage ? "minimal-kicker" : "eyebrow")">@Model.Eyebrow</p>
        <h1 class="@(helpPage ? string.Empty : "page-title")">@Model.Heading</h1>
        <p class="@(helpPage ? string.Empty : "page-copy")">@Model.Intro</p>
        @if (!helpPage && (!string.IsNullOrWhiteSpace(Model.EffectiveDate) || !string.IsNullOrWhiteSpace(Model.UpdatedDate)))
        {
            <div class="trust-claim__details">
                @if (!string.IsNullOrWhiteSpace(Model.EffectiveDate))
                {
                    <span>Effective @Model.EffectiveDate</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.UpdatedDate))
                {
                    <span>Updated @Model.UpdatedDate</span>
                }
            </div>
        }
        @if (!policyPage && !helpPage && Model.SummaryPoints is { Count: > 0 })
        {
            <div class="trust-claim__details">
                @foreach (var point in Model.SummaryPoints)
                {
                    <span>@point</span>
                }
            </div>
        }
    </div>
    @if (helpPage)
    {
        <div class="minimal-status-pill" aria-label="Help options">
            <span>Start here</span>
            <strong>Pick one path</strong>
            <span>Install, account, support, or FAQ</span>
        </div>
    }
    else
    {
        <div class="stacked-actions">
            @foreach (var action in Model.Actions)
            {
                <a class="button-like button-like--@action.Tone" href="@ContextualPreviewHref(action.Href)">@action.Label</a>
            }
        </div>
    }
</section>

@if (Model.SignedInStatus is not null && !deferSupportPanels)
{
    <section class="release-footnote">
        @await Html.PartialAsync("~/Views/Shared/_SignedInTrustStatusPanel.cshtml", Model.SignedInStatus)
    </section>
}

@if (Model.PrivacyBoundary is not null && !deferSupportPanels)
{
    @await Html.PartialAsync("~/Views/Shared/_PrivacyBoundaryPanel.cshtml", Model.PrivacyBoundary)
}

@if (policyFacts.Count > 0)
{
    <section class="continuity-band trust-doc-band">
        <div class="continuity-band__copy">
            <p class="eyebrow">@((string.Equals(Model.PageId, "privacy", StringComparison.OrdinalIgnoreCase) ? "Boundary summary" : "Rule summary"))</p>
            <h2 class="editorial-title">@((string.Equals(Model.PageId, "privacy", StringComparison.OrdinalIgnoreCase) ? "Read the trust boundary first, then the full policy." : "Read the rule boundary first, then the full terms."))</h2>
            <p class="editorial-copy">@((string.Equals(Model.PageId, "privacy", StringComparison.OrdinalIgnoreCase)
                ? "Start with the short version: the binary stays the same for everyone, account truth is bounded, and telemetry or diagnostics stay explicit about what they capture."
                : "Start with the short version: Windows and Linux are public now, macOS is guided support only, and Downloads stays the normal place to get the current build."))</p>
        </div>
        <div class="continuity-band__panel">
            @foreach (var fact in policyFacts)
            {
                <article class="continuity-band__fact">
                    <span>@fact.Tag</span>
                    <strong>@fact.Heading</strong>
                    <p>@fact.Summary</p>
                    @if (!string.Equals(fact.Href, "#", StringComparison.Ordinal))
                    {
                        <a class="inline-link" href="@fact.Href">Open section</a>
                    }
                </article>
            }
        </div>
    </section>
}

@if (helpPage)
{
    <section class="minimal-section minimal-section--tight">
        <div class="minimal-section__lead">
            <h2>Choose the right path</h2>
            <p>Start with the page that matches the problem. Each path has one primary next step and one fallback.</p>
        </div>
        <div class="minimal-help-grid">
            @foreach (var choice in helpRouteChoices)
            {
                var fallbackAction = HelpFallbackActionFor(choice.Id, Model.Chrome.Authenticated);
                <article class="minimal-help-card" id="@choice.Id">
                    <span>@choice.Badge</span>
                    <h3>@PublicText(choice.Title)</h3>
                    <p>@PublicText(choice.Summary)</p>
                    <a class="inline-link" href="@choice.Href">@PublicText(choice.Label)</a>
                    @if (fallbackAction is not null)
                    {
                        <p class="muted-copy">Fallback: <a class="inline-link" href="@ContextualPreviewHref(fallbackAction.Href)">@PublicText(fallbackAction.Label)</a></p>
                    }
                </article>
            }
        </div>
    </section>

    <section class="minimal-section minimal-section--tight">
        <div class="minimal-section__lead">
            <h2>Details</h2>
        </div>
        <div class="minimal-platform-list">
            @foreach (var pageSection in Model.Sections)
            {
                <article>
                    <details>
                        <summary>@PublicText(pageSection.Heading)</summary>
                        <p>@PublicText(pageSection.Body)</p>
                        @if (pageSection.Bullets is { Count: > 0 })
                        {
                            <ul>
                                @foreach (var bullet in pageSection.Bullets)
                                {
                                    <li>@PublicText(bullet)</li>
                                }
                            </ul>
                        }
                    </details>
                </article>
            }
        </div>
    </section>
}
else if (!contactPage)
{
    <section class="trust-page-layout">
        <div class="trust-page-sections">
            @foreach (var pageSection in Model.Sections)
            {
                <article class="trust-page-section" id="@pageSection.Id">
                    <p class="eyebrow">@pageSection.Eyebrow</p>
                    <h2>@pageSection.Heading</h2>
                    <p>@pageSection.Body</p>
                    @if (pageSection.Bullets is { Count: > 0 })
                    {
                        <ul class="trust-page-section__list">
                            @foreach (var bullet in pageSection.Bullets)
                            {
                                <li>@bullet</li>
                            }
                        </ul>
                    }
                </article>
            }
        </div>
    </section>
}

@if (Model.SupportIntake is not null && contactPage)
{
    <section class="trust-page-sections" id="support-intake">
        <article class="trust-page-section trust-page-section--form">
            <p class="eyebrow">Support intake</p>
            <h2>@Model.SupportIntake.Heading</h2>
            <p>@Model.SupportIntake.Intro</p>

            @if (!string.IsNullOrWhiteSpace(Model.SupportIntake.SubmissionNotice))
            {
                <p class="status-copy status-copy--success">@Model.SupportIntake.SubmissionNotice</p>
            }

            <div class="editorial-block__lead trust-page-section__lead">
                <p class="eyebrow">Case-type guide</p>
                <h3>Choose the path that fits the issue before you attach logs</h3>
                <p class="muted-copy">Safe public feedback should start on the public feedback page. Choose this form only when the issue needs private or account-linked follow-up.</p>
            </div>
            <div class="compact-rail">
                @foreach (var option in Model.SupportIntake.Options)
                {
                    <article class="compact-rail__item">
                        <div class="compact-rail__copy">
                            <h3>@option.Label</h3>
                            <p>@option.Description</p>
                        </div>
                    </article>
                }
            </div>

            <form class="settings-form" method="post" action="@Model.SupportIntake.ActionHref" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="field">
                    <label for="supportKind">Case type</label>
                    <select id="supportKind" name="kind" required>
                        @foreach (var option in Model.SupportIntake.Options)
                        {
                            <option value="@option.Value" selected="@(string.Equals(Model.SupportIntake.DefaultKind, option.Value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@option.Label</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="supportTitle">Short title</label>
                    <input id="supportTitle" name="title" maxlength="160" placeholder="Installer linked, but first launch did not explain the next step" value="@Model.SupportIntake.DefaultTitle" required />
                </div>
                <div class="field">
                    <label for="supportSummary">One-line summary</label>
                    <input id="supportSummary" name="summary" maxlength="280" placeholder="The Linux release installed successfully, but the post-install guidance was unclear." value="@Model.SupportIntake.DefaultSummary" required />
                </div>
                <div class="field">
                    <label for="supportDetail">What happened</label>
                    <textarea id="supportDetail" name="detail" rows="6" placeholder="Tell Chummer what you expected, what actually happened, and the fastest way to reproduce it." required>@Model.SupportIntake.DefaultDetail</textarea>
                </div>
                @if (!Model.SupportIntake.Authenticated)
                {
                    <div class="field">
                        <label for="supportReplyEmail">Reply email</label>
                        <input id="supportReplyEmail" name="replyEmail" type="email" placeholder="runner@example.com" required />
                    </div>
                }
                <details class="details-drawer">
                    <summary>Optional environment details</summary>
                    @if (!string.IsNullOrWhiteSpace(Model.SupportIntake.ContextHint))
                    {
                        <p class="muted-copy">@Model.SupportIntake.ContextHint</p>
                    }
                    <div class="field">
                        <label for="supportPlatform">Platform</label>
                        <input id="supportPlatform" name="platform" maxlength="64" placeholder="Windows, Linux, or macOS" value="@Model.SupportIntake.DefaultPlatform" />
                    </div>
                    <div class="field">
                        <label for="supportVersion">Version</label>
                        <input id="supportVersion" name="applicationVersion" maxlength="64" placeholder="Current public build or version number" value="@Model.SupportIntake.DefaultApplicationVersion" />
                    </div>
                    <div class="field">
                        <label for="supportReleaseChannel">Release channel</label>
                        <input id="supportReleaseChannel" name="releaseChannel" maxlength="64" placeholder="public release, beta, or stable" value="@Model.SupportIntake.DefaultReleaseChannel" />
                    </div>
                    <div class="field">
                        <label for="supportHeadId">Desktop head</label>
                        <input id="supportHeadId" name="headId" maxlength="64" placeholder="avalonia or another shipped head" value="@Model.SupportIntake.DefaultHeadId" />
                    </div>
                    <div class="field">
                        <label for="supportInstallationId">Install id</label>
                        <input id="supportInstallationId" name="installationId" maxlength="64" placeholder="Optional install id from Devices and access" value="@Model.SupportIntake.DefaultInstallationId" />
                    </div>
                    <div class="field">
                        <label for="supportArch">Architecture</label>
                        <input id="supportArch" name="arch" maxlength="32" placeholder="x64 or arm64" value="@Model.SupportIntake.DefaultArch" />
                    </div>
                </details>
                <details class="details-drawer">
                    <summary>Attachments</summary>
                    <p class="muted-copy">@Model.SupportIntake.AttachmentHelp</p>
                    <div class="field">
                        <label for="supportAttachments">Screenshots, logs, or small bundles</label>
                        <input id="supportAttachments" name="attachments" type="file" multiple accept=".png,.jpg,.jpeg,.webp,.txt,.log,.json,.zip,.md" />
                    </div>
                </details>
                <div class="stacked-actions">
                    <button class="button-like button-like--primary" type="submit">Submit support case</button>
                    <a class="button-like button-like--secondary" href="@Model.SupportIntake.AccountSupportHref">@Model.SupportIntake.AccountSupportLabel</a>
                    <a class="button-like button-like--ghost" href="@Model.SupportIntake.InstallAccessHref">@Model.SupportIntake.InstallAccessLabel</a>
                </div>
            </form>
            <p class="muted-copy">@Model.SupportIntake.ResponseExpectation</p>
            @if (!string.IsNullOrWhiteSpace(Model.SupportIntake.InstallRailHref)
                && !string.IsNullOrWhiteSpace(Model.SupportIntake.InstallRailLabel)
                && !string.IsNullOrWhiteSpace(Model.SupportIntake.InstallRailSummary))
            {
                <div class="compact-rail">
                    <article class="compact-rail__item">
                        <div class="compact-rail__copy">
                            <h3>@(Model.SupportIntake.RecoveryModeOnly ? "Recovery stays on this install page" : "Return to the guided installer after support")</h3>
                            <p>@Model.SupportIntake.InstallRailSummary</p>
                        </div>
                        <a class="inline-link" href="@Model.SupportIntake.InstallRailHref">@Model.SupportIntake.InstallRailLabel</a>
                    </article>
                </div>
            }
        </article>
    </section>

    if (contactPage)
    {
        <section class="editorial-block">
            <div class="editorial-block__lead">
                <p class="eyebrow">Need a different path?</p>
                <h2 class="editorial-title">Public feedback, tracked return, and install recovery stay nearby.</h2>
                <p class="editorial-copy">Start the case form first when you already know this needs private follow-up. Use the other routes below when the issue is public, install-specific, or better handled from your account.</p>
            </div>
            <div class="route-choice-grid">
                @foreach (var choice in contactRouteChoices)
                {
                    <article class="route-choice-card" id="@choice.Id">
                        <span class="tag">@choice.Badge</span>
                        <h3>@choice.Title</h3>
                        <p>@choice.Summary</p>
                        <div class="route-choice-card__details">
                            @foreach (var item in choice.Details)
                            {
                                <span>@item</span>
                            }
                        </div>
                        <a class="editorial-strip__action" href="@choice.Href">@choice.Label</a>
                    </article>
                }
            </div>
        </section>
    }
}

@if (Model.SignedInStatus is not null && deferSupportPanels)
{
    <section class="release-footnote">
        @await Html.PartialAsync("~/Views/Shared/_SignedInTrustStatusPanel.cshtml", Model.SignedInStatus)
    </section>
}

@model BlackLedgerFactionPromoPageViewModel
@{
    ViewData["Title"] = $"{Model.Promo.PublicName} promo";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-ledger";
    var slug = Model.Promo.FactionId.Replace('_', '-');
    var logoHref = $"/media/ledger/factions/{slug}-logo.svg";
    var backgroundHref = $"/media/ledger/factions/{slug}-bg.svg";
}

<section class="faction-detail-hero faction-detail-hero--promo" style="background-image:url('@backgroundHref')">
    <img class="faction-detail-hero__logo" src="@logoHref" alt="@($"{Model.Promo.PublicName} logo")" loading="lazy" />
    <div class="faction-detail-hero__copy">
        <p class="eyebrow">Faction war bulletin</p>
        <h1 class="editorial-title">@Model.Heading</h1>
        <p class="editorial-copy">@Model.Intro</p>
        <div class="trust-claim__microproof">
            <span>Provider: @Model.Promo.ProviderStatus</span>
            <span>Render mode: @Model.Promo.RenderMode</span>
            <span>Fallback: @Model.Promo.FallbackRenderMode</span>
            <span>Safety: public-safe</span>
        </div>
        <div class="stacked-actions">
            <a class="button-like button-like--primary" href="@($"{Model.Promo.HtmlHref}?autoplay=1#promo-player")">Open watch page</a>
            <a class="button-like button-like--secondary" href="#promo-player">Play inline here</a>
            <a class="button-like button-like--secondary" href="@Model.Promo.CaptionsHref">Open captions</a>
            <a class="button-like button-like--secondary" href="@Model.Promo.JsonHref">Open JSON brief</a>
        </div>
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">First-party motion bulletin</p>
        <h2 class="editorial-title">@Model.Promo.StaticCardLabel</h2>
        <p class="editorial-copy">@Model.Promo.CampaignHook</p>
        <p class="editorial-copy">@Model.Promo.StorylineSummary</p>
    </div>
    <div id="promo-player" class="route-choice-card" data-storyboard-player>
        <div class="trust-claim__microproof">
            <span>Mode: @Model.Promo.PlaybackLabel</span>
            <span>Captions: included</span>
            <span>Narration: @Model.Promo.NarratorPosture</span>
            <span>Pipeline: @Model.Promo.RenderPipelineLabel</span>
        </div>
        <video class="faction-promo-video"
               controls
               playsinline
               preload="metadata"
               poster="@Model.Promo.PosterHref">
            <source src="@Model.Promo.VideoMp4Href" type="video/mp4" />
            <source src="@Model.Promo.VideoWebmHref" type="video/webm" />
            <track kind="captions" src="@Model.Promo.CaptionsHref" srclang="en" label="English" default />
            Your browser does not support HTML5 video playback for this route.
        </video>
        <div class="trust-claim__microproof">
            <span>Fallback mode: storyboard bulletin</span>
            <span>Captions: included</span>
        </div>
        <div class="stacked-actions">
            <button type="button" class="button-like button-like--secondary" data-storyboard-prev>Previous frame</button>
            <button type="button" class="button-like button-like--primary" data-storyboard-toggle>Auto-play storyboard</button>
            <button type="button" class="button-like button-like--secondary" data-storyboard-next>Next frame</button>
        </div>
        <div class="faction-storyboard-strip faction-storyboard-strip--action">
            @for (int index = 0; index < Model.Promo.StoryboardFrames.Count; index += 1)
            {
                var frame = Model.Promo.StoryboardFrames[index];
                <article class="route-choice-card" data-storyboard-frame="@(index)" hidden="@(index == 0 ? null : "hidden")">
                    <span class="tag">@frame.Label</span>
                    <h3>@Model.Promo.PublicName</h3>
                    <p class="faction-storyboard-frame__visual">@frame.VisualHook</p>
                    <p class="faction-storyboard-frame__action">@frame.ActionBeat</p>
                    <p class="faction-storyboard-frame__proof">@frame.ProofPayoff</p>
                </article>
            }
        </div>
        <div class="trust-claim__microproof">
            @for (int index = 0; index < Model.Promo.CaptionLines.Count; index += 1)
            {
                <span>Caption @(index + 1): @Model.Promo.CaptionLines[index]</span>
            }
        </div>
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Screenplay</p>
        <h2 class="editorial-title">How the reel is structured</h2>
        <p class="editorial-copy">@Model.Promo.AudiencePromise</p>
    </div>
    <div class="route-choice-grid route-choice-grid--three">
        @foreach (var scene in Model.Promo.ScreenplayScenes)
        {
            <article class="route-choice-card">
                <span class="tag">@scene.Label · @scene.DurationLabel</span>
                <p>@scene.Purpose</p>
                <p>@scene.VisualDirection</p>
                <p>@scene.NarratorLine</p>
            </article>
        }
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Formats</p>
        <h2 class="editorial-title">Public-safe deliverables</h2>
        <p class="editorial-copy">Every faction video route now includes real motion-video files, a JSON brief, a caption file, and a storyboard fallback that still reads like a command bulletin instead of an empty shell.</p>
    </div>
    <div class="route-choice-grid route-choice-grid--three">
        @foreach (var format in Model.Promo.FormatLabels)
        {
            <article class="route-choice-card">
                <span class="tag">Format</span>
                <p>@format</p>
            </article>
        }
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Human Review</p>
        <h2 class="editorial-title">Flagship signoff checklist</h2>
        <p class="editorial-copy">Machine checks can prove route health, duration, captions, audio, and motion. Flagship release still requires a human reviewer to confirm that the promo plays like a real animated scene instead of a dressed-up motion card.</p>
    </div>
    <div class="route-choice-grid route-choice-grid--three">
        <article class="route-choice-card">
            <span class="tag">Characters</span>
            <p>Visible human or metahuman performers must read clearly on screen.</p>
        </article>
        <article class="route-choice-card">
            <span class="tag">Action</span>
            <p>The lead has to do something that changes the scene, not just pose under typography.</p>
        </article>
        <article class="route-choice-card">
            <span class="tag">Camera</span>
            <p>Movement, framing, and shot progression must feel cinematic rather than slideshow-like.</p>
        </article>
        <article class="route-choice-card">
            <span class="tag">Lighting</span>
            <p>Color, contrast, and atmosphere must look intentional and faction-specific.</p>
        </article>
        <article class="route-choice-card">
            <span class="tag">Safety</span>
            <p>No provider watermark, no private material, and no sourcebook leakage may appear.</p>
        </article>
        <article class="route-choice-card">
            <span class="tag">Approval</span>
            <p>The cinematic lane is not flagship-ready until a named human reviewer signs the final creative receipt.</p>
        </article>
    </div>
</section>

<script>
(() => {
    const player = document.querySelector('[data-storyboard-player]');
    if (!player) {
        return;
    }
    const frames = Array.from(player.querySelectorAll('[data-storyboard-frame]'));
    const video = player.querySelector('video');
    const previous = player.querySelector('[data-storyboard-prev]');
    const next = player.querySelector('[data-storyboard-next]');
    const toggle = player.querySelector('[data-storyboard-toggle]');
    if (frames.length === 0 || !(previous instanceof HTMLButtonElement) || !(next instanceof HTMLButtonElement) || !(toggle instanceof HTMLButtonElement)) {
        return;
    }

    let activeIndex = 0;
    let autoplayId = null;

    const showFrame = (index) => {
        activeIndex = (index + frames.length) % frames.length;
        frames.forEach((frame, frameIndex) => {
            frame.hidden = frameIndex !== activeIndex;
        });
    };

    const stopAutoplay = () => {
        if (autoplayId !== null) {
            window.clearInterval(autoplayId);
            autoplayId = null;
        }
        toggle.textContent = 'Auto-play storyboard';
    };

    const startAutoplay = () => {
        stopAutoplay();
        autoplayId = window.setInterval(() => showFrame(activeIndex + 1), 3200);
        toggle.textContent = 'Pause storyboard';
    };

    previous.addEventListener('click', () => {
        stopAutoplay();
        showFrame(activeIndex - 1);
    });
    next.addEventListener('click', () => {
        stopAutoplay();
        showFrame(activeIndex + 1);
    });
    toggle.addEventListener('click', () => {
        if (autoplayId === null) {
            startAutoplay();
            return;
        }
        stopAutoplay();
    });

    if (video instanceof HTMLVideoElement) {
        const params = new URLSearchParams(window.location.search);
        if (params.get('autoplay') === '1') {
            video.muted = true;
            video.play().catch(() => {
                video.muted = false;
            });
        }
    }
    showFrame(0);
})();
</script>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Safety notes</p>
        <h2 class="editorial-title">Provider and lore boundaries</h2>
    </div>
        <div class="route-choice-grid route-choice-grid--three">
        @foreach (var note in Model.DeliveryNotes)
        {
            <article class="route-choice-card">
                <span class="tag">Boundary</span>
                <p>@note</p>
            </article>
        }
    </div>
    <div class="stacked-actions">
        <a class="button-like button-like--secondary" href="@Model.Promo.ValidationHref">Open validation</a>
    </div>
</section>

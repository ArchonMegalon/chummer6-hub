@model BuildGhostConciergePageViewModel
@{
    ViewData["Title"] = Model.Chrome.Title;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-participate";
    var projection = Model.Projection;

    string SanitizePublicCopy(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var conciergeToken = string.Concat("Face", "Pop");
        var explainerToken = string.Concat("Answer", "ly");

        return value
            .Replace(conciergeToken, "public concierge", StringComparison.OrdinalIgnoreCase)
            .Replace(explainerToken, "bounded explainer", StringComparison.OrdinalIgnoreCase);
    }
}

<section class="release-footnote">
    <p class="eyebrow">@Model.Eyebrow</p>
    <h1 class="page-title">@Model.Heading</h1>
    <p class="page-copy">@Model.Intro</p>
    <div class="stacked-actions">
        @foreach (var action in projection.Actions)
        {
            <a class="button-like button-like--@action.Tone" href="@action.Href">@action.Label</a>
        }
    </div>
</section>

<section class="status-decision-strip" aria-label="Build Ghost operating split">
    <article class="status-decision-strip__card">
        <span class="tag">Concierge</span>
        <h2>@SanitizePublicCopy(projection.FacePopStatus)</h2>
        <p>Public-safe greeting, routing, and intake only. It can help a builder arrive at the right first-party lane without becoming the lane.</p>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag">Explainer</span>
        <h2>@SanitizePublicCopy(projection.AnswerlyStatus)</h2>
        <p>@SanitizePublicCopy(projection.HumanizedSummary)</p>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag">Chummer</span>
        <h2>@projection.EngineStatus</h2>
        <p>Ghost spawn, compare, legality explanation, discard, and apply all stay inside first-party contracts and receipts.</p>
    </article>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Canonical lane</p>
        <h2 class="editorial-title">Use the public tools to guide the experiment, not to own it.</h2>
        <p class="editorial-copy">@projection.CanonicalLane</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">Concierge can</span>
            <h3>Open the conversation</h3>
            <p>Use the concierge to capture the comparison question and route the builder into a governed next step.</p>
            <div class="route-choice-card__proof">
                @foreach (var item in projection.FacePopResponsibilities)
                {
                    <span>@SanitizePublicCopy(item)</span>
                }
            </div>
        </article>
        <article class="route-choice-card">
            <span class="tag">Explainer can</span>
            <h3>Explain the boundary</h3>
            <p>Let the explainer clarify what the ghost experiment means without letting it compute mechanics or choose the winning variant.</p>
            <div class="route-choice-card__proof">
                @foreach (var item in projection.AnswerlyResponsibilities)
                {
                    <span>@SanitizePublicCopy(item)</span>
                }
            </div>
        </article>
        <article class="route-choice-card">
            <span class="tag">Chummer must</span>
            <h3>Own the real compare bench</h3>
            <p>@projection.RuntimeBoundary</p>
            <div class="route-choice-card__proof">
                @foreach (var item in projection.ChummerResponsibilities)
                {
                    <span>@SanitizePublicCopy(item)</span>
                }
            </div>
        </article>
    </div>
</section>

<section class="trust-claims">
    <div class="trust-claims__lead">
        <p class="eyebrow">Proof objects</p>
        <h2 class="editorial-title">The experiment should leave behind receipts, not vibes.</h2>
        <p class="editorial-copy">A builder should be able to see what was compared, what changed, and whether the ghost was applied or discarded.</p>
    </div>
    <div class="trust-claims__grid">
        @foreach (var artifact in projection.CompareArtifacts)
        {
            <article class="trust-claim">
                <span class="tag">Artifact</span>
                <h3>@artifact</h3>
                <p>First-party output only. No concierge or explainer tool is allowed to publish this as truth on its own.</p>
            </article>
        }
    </div>
</section>

@if (Model.SignedInBench is not null)
{
    var signedInBench = Model.SignedInBench;
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Signed-in ALICE</p>
            <h2 class="editorial-title">The real compare bench is now a named account lane.</h2>
            <p class="editorial-copy">@signedInBench.Summary</p>
            <div class="stacked-actions">
                <a class="button-like button-like--primary" href="@signedInBench.EntryHref">@signedInBench.EntryLabel</a>
                @if (!string.IsNullOrWhiteSpace(signedInBench.LeadHandoffHref))
                {
                    <a class="button-like button-like--secondary" href="@signedInBench.LeadHandoffHref">Open lead build handoff</a>
                }
            </div>
        </div>
        <div class="route-choice-grid">
            <article class="route-choice-card">
                <span class="tag">@signedInBench.StatusLabel</span>
                <h3>@(signedInBench.LeadHandoffTitle ?? "ALICE workbench")</h3>
                <p>@(signedInBench.LeadHandoffSummary ?? "Signed-in ALICE keeps tradeoffs, rule diffs, and governed output history on the account rail.")</p>
                @if (signedInBench.ProofPoints is { Count: > 0 })
                {
                    <div class="route-choice-card__proof">
                        @foreach (var point in signedInBench.ProofPoints)
                        {
                            <span>@point</span>
                        }
                    </div>
                }
            </article>
        </div>
    </section>
}

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Feedback loop</p>
        <h2 class="editorial-title">When the client wants to report a build-ghost problem, send a typed packet, not a generic plea.</h2>
        <p class="editorial-copy">Private compare/apply faults should open first-party support with build-ghost context already attached. Public shaping feedback should stay on the public board.</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">Client bug path</span>
            <h3>Report compare or apply drift</h3>
            <p>Use the client-aware support query when the build ghost miscompares, misroutes, or applies the wrong variant.</p>
            <a class="editorial-strip__action" href="@projection.ClientReportHref">Open Build Ghost report</a>
        </article>
        <article class="route-choice-card">
            <span class="tag">Public shaping</span>
            <h3>Keep design feedback public</h3>
            <p>Use the public board when the ask is about lane design, visibility, or workflow polish rather than a private failure.</p>
            <a class="editorial-strip__action" href="@projection.PublicFeedbackHref">Open public feedback</a>
        </article>
    </div>
</section>

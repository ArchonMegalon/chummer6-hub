@model BuildGhostConciergePageViewModel
@{
    var publicHelperRoute = string.Equals(Model.Chrome.CurrentPath, "/alice", StringComparison.OrdinalIgnoreCase);
    var pageTitle = publicHelperRoute ? "Character help" : Model.Chrome.Title;
    var eyebrow = publicHelperRoute ? "Optional" : Model.Eyebrow;
    var heading = publicHelperRoute ? "Character help" : Model.Heading;
    var intro = publicHelperRoute
        ? "Use this page only when you want help before returning to Chummer."
        : Model.Intro;

    ViewData["Title"] = pageTitle;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-participate surface-minimal";
    var projection = Model.Projection;

    string SanitizePublicCopy(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var conciergeToken = string.Concat("Face", "Pop");
        var explainerToken = string.Concat("Answer", "ly");
        var supportRoleToken = string.Concat("opera", "tor");

        return value
            .Replace(conciergeToken, "public concierge", StringComparison.OrdinalIgnoreCase)
            .Replace(explainerToken, "plain-language explainer", StringComparison.OrdinalIgnoreCase)
            .Replace("ALICE", "character help", StringComparison.OrdinalIgnoreCase)
            .Replace("Build Ghost", "draft build", StringComparison.OrdinalIgnoreCase)
            .Replace("build-ghost", "draft build", StringComparison.OrdinalIgnoreCase)
            .Replace("governed", "guided", StringComparison.OrdinalIgnoreCase)
            .Replace("governor", "guide", StringComparison.OrdinalIgnoreCase)
            .Replace("bounded", "limited", StringComparison.OrdinalIgnoreCase)
            .Replace("receipts", "records", StringComparison.OrdinalIgnoreCase)
            .Replace("receipt", "record", StringComparison.OrdinalIgnoreCase)
            .Replace("artifact", "file", StringComparison.OrdinalIgnoreCase)
            .Replace(supportRoleToken, "support", StringComparison.OrdinalIgnoreCase);
    }
}

<section class="release-footnote">
    <p class="eyebrow">@SanitizePublicCopy(eyebrow)</p>
    <h1 class="page-title">@SanitizePublicCopy(heading)</h1>
    <p class="page-copy">@SanitizePublicCopy(intro)</p>
    <div class="stacked-actions">
        @foreach (var action in projection.Actions)
        {
            <a class="button-like button-like--@action.Tone" href="@action.Href">@SanitizePublicCopy(action.Label)</a>
        }
    </div>
</section>

<section class="status-decision-strip" aria-label="Character helper split">
    <article class="status-decision-strip__card">
        <span class="tag">Greeting</span>
        <h2>@SanitizePublicCopy(projection.FacePopStatus)</h2>
        <p>Short greeting, routing, and intake only. It helps a builder arrive at the right Chummer path without becoming the path.</p>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag">Guide</span>
        <h2>@SanitizePublicCopy(projection.AnswerlyStatus)</h2>
        <p>@SanitizePublicCopy(projection.HumanizedSummary)</p>
    </article>
    <article class="status-decision-strip__card">
        <span class="tag">Chummer</span>
        <h2>@SanitizePublicCopy(projection.EngineStatus)</h2>
        <p>Draft creation, compare, legality explanation, discard, and apply all stay inside Chummer.</p>
    </article>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Account path</p>
        <h2 class="editorial-title">Use this page to get oriented, then let Chummer do the work.</h2>
        <p class="editorial-copy">@SanitizePublicCopy(projection.CanonicalLane)</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">Start here</span>
            <h3>Open the guide</h3>
            <p>Capture the comparison question and route the builder into the right next step.</p>
            <div class="route-choice-card__details">
                @foreach (var item in projection.FacePopResponsibilities)
                {
                    <span>@SanitizePublicCopy(item)</span>
                }
            </div>
        </article>
        <article class="route-choice-card">
            <span class="tag">Explains</span>
            <h3>Explain the boundary</h3>
            <p>Clarify what the draft comparison means without computing mechanics or choosing the final character.</p>
            <div class="route-choice-card__details">
                @foreach (var item in projection.AnswerlyResponsibilities)
                {
                    <span>@SanitizePublicCopy(item)</span>
                }
            </div>
        </article>
        <article class="route-choice-card">
            <span class="tag">Chummer handles</span>
            <h3>Keep comparison inside Chummer</h3>
            <p>@SanitizePublicCopy(projection.RuntimeBoundary)</p>
            <div class="route-choice-card__details">
                @foreach (var item in projection.ChummerResponsibilities)
                {
                    <span>@SanitizePublicCopy(item)</span>
                }
            </div>
        </article>
    </div>
</section>

<section class="trust-claims">
    <div class="trust-claims__lead">
        <p class="eyebrow">What stays visible</p>
        <h2 class="editorial-title">Every change should stay easy to follow.</h2>
        <p class="editorial-copy">A builder should be able to see what was compared, what changed, and whether the draft was applied or discarded.</p>
    </div>
    <div class="trust-claims__grid">
        @foreach (var artifact in projection.CompareArtifacts)
        {
            <article class="trust-claim">
                <span class="tag">Detail</span>
                <h3>@SanitizePublicCopy(artifact)</h3>
                <p>Chummer keeps the final result. This page only prepares a draft.</p>
            </article>
        }
    </div>
</section>

@if (projection.Insights.Count > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Visual explanation</p>
            <h2 class="editorial-title">See the shape before you commit to the path.</h2>
            <p class="editorial-copy">These boards can make a recommendation easier to scan. They do not replace Chummer, and they do not decide what gets applied.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var insight in projection.Insights)
            {
                <article class="route-choice-card">
                    <span class="tag">Chart</span>
                    <h3>@SanitizePublicCopy(insight.Title)</h3>
                    <p>@SanitizePublicCopy(insight.Summary)</p>
                    <iframe
                        title="@SanitizePublicCopy(insight.Title)"
                        src="@insight.EmbedHref"
                        loading="lazy"
                        referrerpolicy="strict-origin-when-cross-origin"
                        style="width:100%;min-height:420px;border:1px solid rgba(255,255,255,.12);border-radius:.85rem;background:rgba(9,14,19,.72);"></iframe>
                    <a class="editorial-strip__action" href="@insight.OpenHref" target="_blank" rel="noreferrer">@SanitizePublicCopy(insight.ActionLabel)</a>
                </article>
            }
        </div>
    </section>
}

@if (Model.SignedInBench is not null)
{
    var signedInBench = Model.SignedInBench;
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Account view</p>
            <h2 class="editorial-title">The real comparison lives in your account.</h2>
            <p class="editorial-copy">@SanitizePublicCopy(signedInBench.Summary)</p>
            <div class="stacked-actions">
                <a class="button-like button-like--primary" href="@signedInBench.EntryHref">@SanitizePublicCopy(signedInBench.EntryLabel)</a>
                @if (!string.IsNullOrWhiteSpace(signedInBench.LeadHandoffHref))
                {
                    <a class="button-like button-like--secondary" href="@signedInBench.LeadHandoffHref">Open build setup</a>
                }
            </div>
        </div>
        <div class="route-choice-grid">
            <article class="route-choice-card">
                <span class="tag">@SanitizePublicCopy(signedInBench.StatusLabel)</span>
                <h3>@SanitizePublicCopy(signedInBench.LeadHandoffTitle ?? "Character help workspace")</h3>
                <p>@SanitizePublicCopy(signedInBench.LeadHandoffSummary ?? "The account page keeps tradeoffs, rule differences, and earlier results together.")</p>
                @if (signedInBench.ProofPoints is { Count: > 0 })
                {
                    <div class="route-choice-card__details">
                        @foreach (var point in signedInBench.ProofPoints)
                        {
                            <span>@SanitizePublicCopy(point)</span>
                        }
                    </div>
                }
            </article>
        </div>
    </section>
}

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Feedback loop</p>
        <h2 class="editorial-title">When comparison fails, send the useful details.</h2>
        <p class="editorial-copy">Private compare or apply faults should open support with the right context already attached. Design feedback should stay public.</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">Client bug path</span>
            <h3>Report compare or apply drift</h3>
            <p>Use the support query when the helper miscompares, misroutes, or applies the wrong variant.</p>
            <a class="editorial-strip__action" href="@projection.ClientReportHref">Open support</a>
        </article>
        <article class="route-choice-card">
            <span class="tag">Public feedback</span>
            <h3>Keep design feedback public</h3>
            <p>Use public feedback when the ask is about workflow design, visibility, or polish rather than a private failure.</p>
            <a class="editorial-strip__action" href="@projection.PublicFeedbackHref">Open feedback</a>
        </article>
    </div>
</section>

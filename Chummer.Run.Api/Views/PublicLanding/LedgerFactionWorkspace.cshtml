@model BlackLedgerFactionWorkspacePageViewModel
@{
    ViewData["Title"] = UndetectableHumanizerCopyAdapter.Humanize(Model.Heading);
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-ledger";
}

<section class="ledger-flagship ledger-flagship--workspace">
    <div class="ledger-flagship__copy">
        <p class="eyebrow">@UndetectableHumanizerCopyAdapter.Humanize(Model.Eyebrow)</p>
        <h1 class="page-title">@UndetectableHumanizerCopyAdapter.Humanize(Model.Heading)</h1>
        <p class="page-copy">@UndetectableHumanizerCopyAdapter.Humanize(Model.Intro)</p>
        <p class="ledger-flagship__support">The campaign city view starts with the globe, not a list. Hover factions, read pressure, then open the section you need.</p>
        <div class="trust-claim__details">
            <span>Account page</span>
            <span>Faction: @UndetectableHumanizerCopyAdapter.Humanize(Model.Faction.PublicName)</span>
            <span>Public page stays separate</span>
        </div>
        <div class="stacked-actions">
            <a class="button-like button-like--primary" href="@Model.PublicProfileHref">Open public faction file</a>
            <a class="button-like button-like--secondary" href="/ledger/map#ledger-map">Open public globe</a>
        </div>
    </div>
    <div class="ledger-flagship__stage">
        <div class="ledger-flagship__map-frame">
            <div
                class="ledger-flagship__geoscape"
                data-black-ledger-geoscape-root
                data-variant="workspace"
                data-map-url="/api/v1/ledger/worlds/emerald-sprawl-prelude/map?turn=1&amp;mode=influence"
                data-delta-url="/api/v1/ledger/worlds/emerald-sprawl-prelude/map/tick-delta/0/1"
                data-initial-mode="influence"
                data-selected-faction="@Model.Faction.Id.Replace('_', '-')"
                data-tick-headline="Turn 1 pressure live."
                data-primary-label="Open public file"
                data-primary-href="@Model.PublicProfileHref"
                data-secondary-label="Open manage"
                data-secondary-href="/account/ledger/factions/@Model.Faction.Id.Replace('_', '-')?section=manage"></div>
        </div>
        <div class="ledger-flagship__nav" aria-label="Faction sections">
            @foreach (var tab in Model.Tabs)
            {
                <a class="ledger-flagship__nav-card @(tab.Current ? "ledger-flagship__nav-card--current" : string.Empty)" href="@tab.Href">
                    <span class="tag">Tab</span>
                    <strong>@UndetectableHumanizerCopyAdapter.Humanize(tab.Label)</strong>
                <p>@(tab.Current ? "Current section." : "Open this section.")</p>
                </a>
            }
        </div>
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Sections</p>
        <h2 class="editorial-title">Faction management stays signed in.</h2>
        <p class="editorial-copy">@UndetectableHumanizerCopyAdapter.Humanize(Model.PrivacyNote)</p>
    </div>
    <div class="trust-claim__details" aria-label="Faction sections">
        @foreach (var tab in Model.Tabs)
        {
            <a class="inline-link" href="@tab.Href">@(tab.Current ? $"{UndetectableHumanizerCopyAdapter.Humanize(tab.Label)} (current)" : UndetectableHumanizerCopyAdapter.Humanize(tab.Label))</a>
        }
    </div>
</section>

@if (Model.ConnectedLanePacket is not null)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Connected section</p>
            <h2 class="editorial-title">@UndetectableHumanizerCopyAdapter.Humanize(Model.ConnectedLanePacket.Heading)</h2>
            <p class="editorial-copy">@UndetectableHumanizerCopyAdapter.Humanize(Model.ConnectedLanePacket.Summary)</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var cue in Model.ConnectedLanePacket.Cues)
            {
                <article class="route-choice-card">
                    <span class="tag">@UndetectableHumanizerCopyAdapter.Humanize(cue.StatusLabel)</span>
                    <h3>@UndetectableHumanizerCopyAdapter.Humanize(cue.Label)</h3>
                    <p>@UndetectableHumanizerCopyAdapter.Humanize(cue.Summary)</p>
                    <a class="editorial-strip__action" href="@cue.Href">Open</a>
                </article>
            }
        </div>
        <p class="editorial-copy">@UndetectableHumanizerCopyAdapter.Humanize(Model.ConnectedLanePacket.BoundaryLine)</p>
    </section>
}

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Faction state</p>
        <h2 class="editorial-title">@UndetectableHumanizerCopyAdapter.Humanize(Model.Faction.PublicName)</h2>
        <p class="editorial-copy">@UndetectableHumanizerCopyAdapter.Humanize(Model.Faction.Type) with account management kept off the public Ledger pages.</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">Signals</span>
            <h3>Current pressure markers</h3>
            <div class="route-choice-card__details">
                @foreach (var signal in Model.Faction.PublicSignals)
                {
                    <span>@UndetectableHumanizerCopyAdapter.Humanize(signal)</span>
                }
            </div>
        </article>
        <article class="route-choice-card">
            <span class="tag">District cover</span>
            <h3>Watched districts</h3>
            <p>@(Model.CoveredDistricts.Count == 0 ? "Cross-district state" : string.Join(", ", Model.CoveredDistricts))</p>
        </article>
        <article class="route-choice-card">
            <span class="tag">Stewards</span>
            <h3>Named roles</h3>
            <p>Leader: @Model.Faction.FactionLeader · GM: @Model.Faction.FieldGm · Intel: @Model.Faction.IntelProvider</p>
        </article>
    </div>
</section>

@if (string.Equals(Model.CurrentSection, "private-lore", StringComparison.OrdinalIgnoreCase))
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Private lore overlay</p>
            <h2 class="editorial-title">Private labels stay private.</h2>
            <p class="editorial-copy">These labels and notes may exist on account campaign pages. Public Ledger pages must never render them.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var label in Model.PrivateLabels)
            {
                <article class="route-choice-card">
                    <span class="tag">Private label</span>
                    <h3>@label</h3>
                    <p>Available only on account faction pages.</p>
                </article>
            }
            @foreach (var note in Model.PrivateLoreNotes)
            {
                <article class="route-choice-card">
                    <span class="tag">Boundary</span>
                    <p>@note</p>
                </article>
            }
        </div>
    </section>
}
else if (string.Equals(Model.CurrentSection, "stewards", StringComparison.OrdinalIgnoreCase))
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Stewardship</p>
            <h2 class="editorial-title">Roles stay explicit.</h2>
            <p class="editorial-copy">Public summary roles, campaign stewardship, and override paths do not blur together here.</p>
        </div>
        <div class="route-choice-grid">
            <article class="route-choice-card">
                <span class="tag">Faction leader</span>
                <h3>@Model.Faction.FactionLeader</h3>
                <p>Keeps faction-wide pressure readable and brings in another set of eyes when needed.</p>
            </article>
            <article class="route-choice-card">
                <span class="tag">Field GM</span>
                <h3>@Model.Faction.FieldGm</h3>
                <p>Keeps scenario movement tied to the faction path without exposing private narrative state.</p>
            </article>
            <article class="route-choice-card">
                <span class="tag">Intel role</span>
                <h3>@Model.Faction.IntelProvider</h3>
                <p>Summarizes dispatch context without exposing private labels or campaign-only details.</p>
            </article>
        </div>
    </section>
}
else if (string.Equals(Model.CurrentSection, "manage", StringComparison.OrdinalIgnoreCase))
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Management</p>
            <h2 class="editorial-title">Faction management stays readable.</h2>
            <p class="editorial-copy">Spend action points, sponsor package pressure, challenge districts, or publish a clean dispatch. Recent decisions stay easy to scan.</p>
        </div>
        <div class="route-choice-grid">
            <article class="route-choice-card">
                <span class="tag">District cover</span>
                <h3>Map-aware operations</h3>
                <p>@(Model.CoveredDistricts.Count == 0 ? "Cross-district state needs no extra public view." : string.Join(", ", Model.CoveredDistricts))</p>
            </article>
            <article class="route-choice-card">
                <span class="tag">Package path</span>
                <h3>Pressure, not shipment</h3>
                <p>Package heat can rise here without turning into a release promise or public roadmap noise.</p>
            </article>
            <article class="route-choice-card">
                <span class="tag">Private layer</span>
                <h3>Private lore stays private</h3>
                <p>The private lore overlay stays available only inside this account page and stays off public pages.</p>
            </article>
        </div>
        @if (Model.Allegiance is not null && Model.AvailableActions is not null)
        {
            <div class="route-choice-grid" style="margin-top:1.5rem;">
                @foreach (var action in Model.AvailableActions)
                {
                    <article class="route-choice-card">
                        <span class="tag">@action.Cost AP</span>
                        <h3>@UndetectableHumanizerCopyAdapter.Humanize(action.Label)</h3>
                        <p>@UndetectableHumanizerCopyAdapter.Humanize(action.Effect)</p>
                        <form method="post" action="/account/ledger/factions/@Model.Faction.Id.Replace('_', '-')/actions">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="actionId" value="@action.ActionId" />
                            <input type="hidden" name="targetDistrictId" value="emerald-core" />
                            <input type="hidden" name="targetFactionId" value="ashline_circle" />
                            <input type="hidden" name="stake" value="influence" />
                            <button class="button-like button-like--secondary" type="submit">@(action.ActionId == "sponsor-package" ? "Sponsor package" : action.ActionId == "challenge-faction" ? "Challenge faction" : "Spend action point")</button>
                        </form>
                    </article>
                }
            </div>
        }
        @if (Model.RecentActionReceipts is not null && Model.RecentActionReceipts.Count > 0)
        {
            <div class="route-choice-grid" style="margin-top:1.5rem;">
                @foreach (var receipt in Model.RecentActionReceipts)
                {
                    <article class="route-choice-card">
                        <span class="tag">@UndetectableHumanizerCopyAdapter.Humanize(receipt.ActionLabel)</span>
                        <h3>Latest change</h3>
                        <p>@UndetectableHumanizerCopyAdapter.Humanize(receipt.ResultSummary)</p>
                        <a class="editorial-strip__action" href="@receipt.Href">Open details</a>
                    </article>
                }
            </div>
        }
    </section>
}

@if (Model.Dispatches.Count > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Latest dispatches</p>
            <h2 class="editorial-title">Faction-linked dispatch history</h2>
            <p class="editorial-copy">Public dispatches remain visible, and this account path keeps the private faction page next to them.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var dispatch in Model.Dispatches.Take(3))
            {
                <article class="route-choice-card">
                    <span class="tag">@UndetectableHumanizerCopyAdapter.Humanize(dispatch.Type)</span>
                    <h3>@UndetectableHumanizerCopyAdapter.Humanize(dispatch.Title)</h3>
                    <p>@UndetectableHumanizerCopyAdapter.Humanize(dispatch.Summary)</p>
                    <a class="editorial-strip__action" href="@dispatch.Href">Open dispatch</a>
                </article>
            }
        </div>
    </section>
}

<script type="module" src="~/js/black-ledger-geoscape.js" asp-append-version="true"></script>

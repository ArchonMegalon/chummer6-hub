@model BlackLedgerFactionOnboardingViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Black Ledger onboarding";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-ledger";
    Func<string, string> logoHref = id => $"/media/ledger/factions/{id.Replace('_', '-').Replace("--", "-")}-logo.svg";
    Func<string, string> backgroundHref = id => $"/media/ledger/factions/{id.Replace('_', '-').Replace("--", "-")}-bg.svg";
    Func<string, string> introLine = id => id.Replace('_', '-').Replace("--", "-") switch
    {
        "glass-tower-compact" => "Welcome to calm. If you can afford it.",
        "rust-market-syndicate" => "Everything is available. Nothing is free.",
        "ashline-circle" => "Power is easy. Proof is hard.",
        "neon-docks-union" => "Routes move. Drones complain. We keep the city breathing.",
        "ghostline-network" => "If you heard it, verify it. If you verified it, redact it.",
        "barrens-free-wardens" => "Less nuyen. More backbone.",
        _ => "Pick a house and let the city answer back."
    };
    Func<string, string[]> ledgerLabels = id => id.Replace('_', '-').Replace("--", "-") switch
    {
        "glass-tower-compact" => ["License Polish", "Public Trust", "Contract Capture", "Debt Shield"],
        "rust-market-syndicate" => ["Debt Heat", "Gear Flow", "Favor Load", "Recovery Work"],
        "ashline-circle" => ["MysAd Density", "Magic Pressure", "Source Clarity", "Drain Risk"],
        "neon-docks-union" => ["Route Control", "Drone Load", "Cargo Pressure", "Maintenance Debt"],
        "ghostline-network" => ["Intel Confidence", "Rumor Noise", "Proof Trail", "Exposure Risk"],
        "barrens-free-wardens" => ["Closeout Witnesses", "Survival Pressure", "Public Trust", "Attrition Risk"],
        _ => ["Influence", "Heat", "Confidence", "Pressure"]
    };
}

<section class="ledger-flagship ledger-flagship--onboarding">
    <div class="ledger-flagship__copy">
        <p class="eyebrow">Black Ledger onboarding</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@Model.Intro</p>
        <p class="ledger-flagship__support">Choose on the globe first. The faction should feel like a country with pressure, territory, and visible consequence before you ever hit a form.</p>
        <div class="trust-claim__microproof" aria-label="Onboarding steps">
            @foreach (var step in Model.Steps)
            {
                <a class="inline-link" href="@step.Href">@(step.Current ? $"{step.Label} (current)" : step.Complete ? $"{step.Label} (complete)" : step.Label)</a>
            }
        </div>
        <div class="stacked-actions">
            @if (Model.HasActiveAllegiance && Model.CurrentAllegiance is not null)
            {
                <a class="button-like button-like--primary" href="/account/ledger/factions/@Model.CurrentAllegiance.ActiveFactionId.Replace('_', '-')">Open my faction</a>
            }
            else
            {
                <a class="button-like button-like--primary" href="/account/ledger/onboarding?step=factions">Choose a faction</a>
            }
            <a class="button-like button-like--secondary" href="/ledger/map#ledger-map">Open public globe</a>
        </div>
    </div>
    <div class="ledger-flagship__stage">
        <div class="ledger-flagship__map-frame">
            <div
                class="ledger-flagship__geoscape"
                data-black-ledger-geoscape-root
                data-variant="onboarding"
                data-map-url="/api/v1/ledger/worlds/emerald-sprawl-prelude/map"
                data-delta-url="/api/v1/ledger/worlds/emerald-sprawl-prelude/map/tick-delta/0/1"
                data-initial-mode="influence"
                data-tick-headline="Turn 1 pressure live."
                data-primary-label="Choose faction"
                data-primary-href="/account/ledger/onboarding?step=factions"
                data-secondary-label="Found new faction"
                data-secondary-href="/account/ledger/factions/create"></div>
        </div>
        <div class="ledger-flagship__nav" aria-label="Onboarding command lanes">
            <a class="ledger-flagship__nav-card ledger-flagship__nav-card--primary" href="/account/ledger/onboarding?step=factions">
                <span class="tag">Choose</span>
                <strong>Pick a faction country</strong>
                <p>Start with the globe, hover pressure, then commit to the side you actually want to carry.</p>
            </a>
            <a class="ledger-flagship__nav-card" href="/account/ledger/onboarding?step=choose-path">
                <span class="tag">Found</span>
                <strong>Choose a founder path</strong>
                <p>Major and challenger routes stay explicit and receipt-backed before you build the charter.</p>
            </a>
            <a class="ledger-flagship__nav-card" href="/account/ledger/factions/create?charterType=major">
                <span class="tag">Major</span>
                <strong>Found a major</strong>
                <p>Build a flagship faction with visible slot pressure and city-scale consequence.</p>
            </a>
            <a class="ledger-flagship__nav-card" href="/account/ledger/factions/create?charterType=challenger">
                <span class="tag">Challenger</span>
                <strong>Found a challenger</strong>
                <p>Launch a smaller but sharper country on the board and fight for relevance.</p>
            </a>
        </div>
    </div>
</section>

@if (string.Equals(Model.CurrentStep, "factions", StringComparison.OrdinalIgnoreCase))
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Faction selection</p>
            <h2 class="editorial-title">Pick a side on the globe, then commit.</h2>
            <p class="editorial-copy">@Model.ExistingFactionSummary</p>
        </div>
        <div class="faction-profile-grid">
            @foreach (var faction in Model.ExistingFactions)
            {
                var ledgers = ledgerLabels(faction.FactionId).Take(4).ToArray();
                <article class="faction-profile-card faction-profile-card--onboarding" id="faction-join-@faction.FactionId" data-onboarding-faction-card="@faction.FactionId">
                    <div class="faction-profile-card__hero" style="background-image:url('@backgroundHref(faction.FactionId)')">
                        <img class="faction-profile-card__logo" src="@logoHref(faction.FactionId)" alt="@($"{faction.PublicName} logo")" loading="lazy" />
                        <div class="faction-profile-card__hero-copy">
                            <span class="tag">@faction.Type</span>
                            <h3>@faction.PublicName</h3>
                            <p>@introLine(faction.FactionId)</p>
                        </div>
                    </div>
                    <div class="faction-profile-card__ledgers">
                        @foreach (var ledger in ledgers)
                        {
                            <article class="score-ledger">
                                <span class="score-ledger__label">@ledger</span>
                                <strong>@((ledgers.ToList().IndexOf(ledger) + 2).ToString(CultureInfo.InvariantCulture))</strong>
                                <small>live ledger</small>
                            </article>
                        }
                    </div>
                    <p class="muted-copy">@faction.Summary</p>
                    <div class="trust-claim__microproof">
                        <span>Safety: public-safe</span>
                        <span>Video: first-party motion</span>
                        <span>Join path: account-wide</span>
                    </div>
                    <div class="stacked-actions">
                        <form method="post" action="/account/ledger/onboarding/join">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="factionId" value="@faction.FactionId" />
                            <button class="button-like button-like--primary" type="submit">Join this faction</button>
                        </form>
                        <a class="editorial-strip__action" href="@faction.PromoHref">Open faction video</a>
                        <a class="editorial-strip__action" href="@faction.Href">Open faction file</a>
                    </div>
                </article>
            }
        </div>
    </section>
}
else if (string.Equals(Model.CurrentStep, "choose-path", StringComparison.OrdinalIgnoreCase))
{
    <section class="editorial-block">
        <div class="route-choice-grid route-choice-grid--two">
            <article class="route-choice-card">
                <span class="tag">Major founder path</span>
                <h3>Found a Major Faction</h3>
                <p>@Model.MajorFounderSummary</p>
                <p>Major slots available: @Model.MajorSlotsAvailable</p>
                <a class="button-like button-like--secondary" href="/account/ledger/factions/create?charterType=major">Found Major Faction</a>
            </article>
            <article class="route-choice-card">
                <span class="tag">Challenger founder path</span>
                <h3>Found a Challenger Faction</h3>
                <p>@Model.ChallengerFounderSummary</p>
                <a class="button-like button-like--secondary" href="/account/ledger/factions/create?charterType=challenger">Found Challenger</a>
            </article>
        </div>
    </section>
}
else
{
    <section class="workflow-band workflow-band--compact">
        <div class="workflow-band__lead">
            <p class="eyebrow">Account scope</p>
            <h2 class="editorial-title">One allegiance across current and future runners.</h2>
            <p class="editorial-copy">@Model.CurrentRunnerCount current runner@(Model.CurrentRunnerCount == 1 ? "" : "s") will inherit when you commit.</p>
        </div>
        <div class="flagship-gateway-grid flagship-gateway-grid--compact">
            <article class="gateway-card">
                <div class="gateway-card__header">
                    <span class="tag">Policy</span>
                    <h3>Account-wide allegiance</h3>
                </div>
                <p>Future runners inherit automatically. Defection is cooldown-bound and receipt-backed.</p>
            </article>
            <article class="gateway-card">
                <div class="gateway-card__header">
                    <span class="tag">Major slots</span>
                    <h3>@Model.MajorSlotsAvailable available</h3>
                </div>
                <p>@(string.IsNullOrWhiteSpace(Model.MajorSlotsWarning) ? "Major and challenger founding paths are both available." : Model.MajorSlotsWarning)</p>
            </article>
            <article class="gateway-card">
                <div class="gateway-card__header">
                    <span class="tag">Next</span>
                    <h3>Open the chooser</h3>
                </div>
                <p>Faction cards include globe position, score ledgers, and motion-video intros with storyboard fallback before commitment.</p>
                <a class="editorial-strip__action" href="/account/ledger/onboarding?step=factions">Open faction chooser</a>
            </article>
        </div>
    </section>
}

<script type="module" src="~/js/black-ledger-geoscape.js" asp-append-version="true"></script>

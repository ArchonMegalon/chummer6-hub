@using Chummer.Run.Api.Services
@model FaqPageViewModel
@{
    ViewData["Title"] = PublicFacingCopyHumanizer.Clean(Model.Heading);
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-faq surface-minimal";
    var accessPosture = Model.AccessPosture;
    var guestPreviewHref = !Model.Chrome.Authenticated && !string.IsNullOrWhiteSpace(Model.Chrome.PublicPrimaryCta?.Href)
        ? Model.Chrome.PublicPrimaryCta!.Href
        : "/downloads";
    var faqRouteChoices = new[]
    {
        new
        {
            Badge = "What works today",
            Title = "Check current status first",
            Summary = "Use this when you want to know what is ready now, what needs care, and what is still coming next.",
            Href = "/now",
            Label = "Open what works today",
            Highlights = new[] { "Ready now", "Needs care", "Coming next" }
        },
        new
        {
            Badge = "Downloads",
            Title = "Open downloads when you want to install",
            Summary = accessPosture?.AvailabilitySummary ?? "Downloads shows the current package and setup help without making you dig through a long answer first.",
            Href = "/downloads",
            Label = "Open downloads",
            Highlights = new[] { "Latest build", "Setup help", "Known issues" }
        },
        new
        {
            Badge = "Account",
            Title = Model.Chrome.Authenticated
                ? "Account keeps recovery, devices, and support together"
                : "Create an account when you want recovery and support history",
            Summary = Model.Chrome.Authenticated
                ? "Return to Account for devices, recovery, and support history."
                : accessPosture?.AccountValueSummary ?? "The download stays the same. An account helps you find linked installs, recovery, and support history later.",
            Href = Model.Chrome.Authenticated ? "/account" : "/signup?next=/home",
            Label = Model.Chrome.Authenticated ? "Open account" : "Create account",
            Highlights = new[] { "Linked installs", "Devices", "Support history" }
        },
        new
        {
            Badge = "Private help",
            Title = "Use support when the issue needs logs or account detail",
            Summary = "Install failures, crashes, account issues, and private campaign details belong in support, not in a public search box.",
            Href = "/contact#support-intake",
            Label = "Open support intake",
            Highlights = new[] { "Private reply", "Account optional", "Saved case" }
        }
    };

    string ContextualPreviewHref(string? href)
    {
        var resolvedHref = string.IsNullOrWhiteSpace(href) ? "/downloads" : href;
        if (string.Equals(resolvedHref, "/downloads", StringComparison.OrdinalIgnoreCase))
        {
            return guestPreviewHref;
        }

        return resolvedHref;
    }

    static TrustPageActionViewModel? FaqActionFor(string sectionTitle, string question, bool authenticated)
    {
        var combined = $"{sectionTitle} {question}".ToLowerInvariant();
        if (combined.Contains("account creation", StringComparison.Ordinal)
            || combined.Contains("outside account", StringComparison.Ordinal))
        {
            return authenticated
                ? new TrustPageActionViewModel("Open account", "/account", "secondary")
                : new TrustPageActionViewModel("Create account", "/signup?next=/home", "secondary");
        }

        if (combined.Contains("install", StringComparison.Ordinal)
            || combined.Contains("update", StringComparison.Ordinal)
            || combined.Contains("personalized installer", StringComparison.Ordinal)
            || combined.Contains("preview gated", StringComparison.Ordinal))
        {
            return new TrustPageActionViewModel("Open downloads", "/downloads", "secondary");
        }

        if (combined.Contains("report a bug", StringComparison.Ordinal)
            || combined.Contains("help", StringComparison.Ordinal)
            || combined.Contains("support", StringComparison.Ordinal))
        {
            return new TrustPageActionViewModel("Open support intake", "/contact#support-intake", "secondary");
        }

        if (combined.Contains("trust", StringComparison.Ordinal) || combined.Contains("use chummer right now", StringComparison.Ordinal))
        {
            return new TrustPageActionViewModel("See what works today", "/now", "secondary");
        }

        return null;
    }

    string PublicText(string? value) => PublicFacingCopyHumanizer.Clean(value);
}

<section class="minimal-page-hero">
    <div>
        <p class="minimal-kicker">@PublicText(Model.Eyebrow)</p>
        <h1>@PublicText(Model.Heading)</h1>
        <p>@PublicText(Model.Intro)</p>
    </div>
</section>

<section class="minimal-section minimal-section--tight">
    <div class="minimal-section__lead">
        <h2>Quick paths</h2>
        <p>Use the FAQ for normal questions. Use support when the answer depends on your device, account, logs, or campaign.</p>
    </div>
    <div class="route-choice-grid route-choice-grid--two route-choice-grid--compact">
        @foreach (var choice in faqRouteChoices)
        {
            <article class="route-choice-card">
                <span class="tag">@PublicText(choice.Badge)</span>
                <h3>@PublicText(choice.Title)</h3>
                <p>@PublicText(choice.Summary)</p>
                <div class="route-choice-card__highlights">
                    @foreach (var item in choice.Highlights)
                    {
                        <span>@PublicText(item)</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@ContextualPreviewHref(choice.Href)">@PublicText(choice.Label)</a>
            </article>
        }
    </div>
</section>

<section class="faq-stack minimal-section minimal-section--tight">
    <div class="trust-page-section">
        <p class="eyebrow">Search</p>
        <h2>Find the answer fast</h2>
        <p>Search when you know the topic, or scan the grouped sections below when the question is still broad.</p>
        <label class="field" for="faqFilter">
            <span>Search the FAQ</span>
            <input id="faqFilter" type="search" placeholder="account, install, update, recovery" data-faq-filter />
        </label>
    </div>
    @foreach (var faqSection in Model.Sections)
    {
        <article class="faq-block" data-faq-section>
            <p class="eyebrow">@PublicText(faqSection.Title)</p>
            <div class="faq-list">
                @foreach (var entry in faqSection.Entries)
                {
                    <details class="faq-item" data-faq-item data-faq-text="@($"{faqSection.Title} {entry.Question} {entry.Answer}")">
                        <summary>@PublicText(entry.Question)</summary>
                        <p>@PublicText(entry.Answer)</p>
                        @{
                            var answerAction = FaqActionFor(faqSection.Title, entry.Question, Model.Chrome.Authenticated);
                        }
                        @if (answerAction is not null)
                        {
                            <p><a class="inline-link" href="@ContextualPreviewHref(answerAction.Href)">@PublicText(answerAction.Label)</a></p>
                        }
                    </details>
                }
            </div>
        </article>
    }
</section>

<section class="minimal-section minimal-section--support">
    <div class="minimal-section__lead">
        <h2>Still stuck?</h2>
        <p>If the FAQ answered only part of the question, open support and keep the case in one place.</p>
    </div>
    <div class="minimal-actions">
        <a class="button-like button-like--secondary" href="/contact#support-intake">Open support</a>
        <a class="button-like button-like--ghost" href="/help">Open help</a>
    </div>
</section>

@model FeatureDetailPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-feature-detail";
    var roadmapDetail = string.Equals(Model.Eyebrow, "Roadmap", StringComparison.OrdinalIgnoreCase);
    var liveArtifact = string.Equals(Model.StatusLabel, "Available today", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.StatusLabel, "Live now", StringComparison.OrdinalIgnoreCase);
    var detailEyebrow = roadmapDetail ? "What this horizon is solving" : "What this artifact proves";
    var detailTitle = roadmapDetail
        ? "Why it matters, what it unlocks, and what to compare today"
        : liveArtifact
            ? "Why this live proof matters, what it unlocks, and how to verify it"
            : "Why this preview concept matters, what it is trying to unlock, and how to verify it";
    var detailCopy = roadmapDetail
        ? "Start with the current proof shelf, then use the deeper brief only when you need the longer roadmap rationale."
        : liveArtifact
            ? "Start with the live product path, then use support only when the artifact proof is not enough to move forward."
            : "Treat this as a preview concept until it moves onto the live proof shelf, and use the related roadmap only when you need the longer read.";
    var nextTitle = roadmapDetail
        ? "Compare this horizon with the live product path"
        : liveArtifact
            ? "Use this live proof next"
            : "Use the related roadmap before treating this as finished";
    var nextCopy = roadmapDetail
        ? "Start from the current proof or related preview surface before you leave the product shell for the deeper brief."
        : liveArtifact
            ? "Go to the live product surface first, then use support only when the proof path stops being enough."
            : "Preview concepts should route you toward a roadmap or support path, not pretend they are already finished artifacts.";
    var tailEyebrow = roadmapDetail ? "Track this horizon" : liveArtifact ? "Use this proof next" : "Follow this preview concept";
    var tailCopy = roadmapDetail
        ? "Current proof stays first. The related live surface tells you what exists now, support helps when the path is unclear, and the external brief stays optional."
        : liveArtifact
            ? "Downloads, proof, and support should stay inside the product shell before you fall back to deeper technical reading."
            : "Preview concepts should point back to a roadmap or support path, not trap you on a dead-end gallery card.";

    static string NormalizeDetailRoute(string href)
    {
        var trimmed = (href ?? string.Empty).Trim();
        var hash = trimmed.IndexOf('#');
        if (hash >= 0)
        {
            trimmed = trimmed[..hash];
        }

        var query = trimmed.IndexOf('?');
        if (query >= 0)
        {
            trimmed = trimmed[..query];
        }

        return string.IsNullOrWhiteSpace(trimmed) ? "/" : trimmed;
    }
}

<section class="story-cinematic">
    <div class="story-cinematic__copy">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@Model.Intro</p>
        <div class="stacked-actions">
            <a class="button-like button-like--primary" href="@Model.PrimaryAction.Href">@Model.PrimaryAction.Label</a>
            @if (Model.SecondaryAction is not null
                && !string.Equals(
                    NormalizeDetailRoute(Model.SecondaryAction.Href),
                    NormalizeDetailRoute(Model.PrimaryAction.Href),
                    StringComparison.OrdinalIgnoreCase))
            {
                <a class="button-like button-like--ghost" href="@Model.SecondaryAction.Href">@Model.SecondaryAction.Label</a>
            }
        </div>
    </div>
    @if (Model.Asset is not null)
    {
        <div class="story-cinematic__media">
            @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", Model.Asset)
        </div>
    }
</section>

<section class="trust-rail-section">
    <div class="editorial-block__lead">
        <p class="eyebrow">@Model.StatusEyebrow</p>
        <h2 class="editorial-title">@Model.StatusHeading</h2>
    </div>
    <div class="trust-rail-list">
        @foreach (var fact in Model.Facts)
        {
            <article class="trust-rail">
                <span class="tag">@fact.Label</span>
                <p>@fact.Body</p>
            </article>
        }
    </div>
</section>

@if (roadmapDetail)
{
    <section class="role-matrix">
        <div class="editorial-block__lead">
            <p class="eyebrow">@detailEyebrow</p>
            <h2 class="editorial-title">@detailTitle</h2>
            <p class="editorial-copy">@detailCopy</p>
        </div>
        <div class="role-matrix__grid">
            @if (!string.IsNullOrWhiteSpace(Model.Pain))
            {
                <article class="role-matrix__cell">
                    <span class="tag">User pain</span>
                    <p>@Model.Pain</p>
                </article>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Payoff))
            {
                <article class="role-matrix__cell">
                    <span class="tag">Expected unlock</span>
                    <p>@Model.Payoff</p>
                </article>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ProofNote))
            {
                <article class="role-matrix__cell">
                    <span class="tag">Related live proof</span>
                    <p>@Model.ProofNote</p>
                </article>
            }
            @if (Model.MicroProof.Count > 0)
            {
                <article class="role-matrix__cell">
                    <span class="tag">What to compare</span>
                    <div class="trust-claim__microproof">
                        @foreach (var item in Model.MicroProof)
                        {
                            <span>@item</span>
                        }
                    </div>
                </article>
            }
        </div>
    </section>
}
else
{
    <section class="role-matrix">
        <div class="editorial-block__lead">
            <p class="eyebrow">@detailEyebrow</p>
            <h2 class="editorial-title">@detailTitle</h2>
            <p class="editorial-copy">@detailCopy</p>
        </div>
        <div class="role-matrix__grid">
            @if (liveArtifact)
            {
                <article class="role-matrix__cell">
                    <span class="tag">Use it now</span>
                    <p>Start from the live product surface attached to this artifact, then keep support as the fallback instead of the first step.</p>
                </article>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Pain))
            {
                <article class="role-matrix__cell">
                    <span class="tag">Why it matters</span>
                    <p>@Model.Pain</p>
                </article>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Payoff))
            {
                <article class="role-matrix__cell">
                    <span class="tag">What it unlocks</span>
                    <p>@Model.Payoff</p>
                </article>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ProofNote))
            {
                <article class="role-matrix__cell">
                    <span class="tag">How to verify it</span>
                    <p>@Model.ProofNote</p>
                </article>
            }
            @if (Model.MicroProof.Count > 0)
            {
                <article class="role-matrix__cell">
                    <span class="tag">Verification markers</span>
                    <div class="trust-claim__microproof">
                        @foreach (var item in Model.MicroProof)
                        {
                            <span>@item</span>
                        }
                    </div>
                </article>
            }
        </div>
    </section>
}

<section class="story-guide-tail">
    <p class="eyebrow">@tailEyebrow</p>
    <h2 class="editorial-title">@nextTitle</h2>
    <p class="editorial-copy">@nextCopy</p>
    <div class="stacked-actions">
        <a class="button-like button-like--secondary" href="/contact#support-intake">Get help with this surface</a>
    </div>
    <p class="muted-copy">@tailCopy</p>
</section>

@model FeatureDetailPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-feature-detail";
    static string NormalizeDetailRoute(string href)
    {
        var trimmed = (href ?? string.Empty).Trim();
        var hash = trimmed.IndexOf('#');
        if (hash >= 0)
        {
            trimmed = trimmed[..hash];
        }

        var query = trimmed.IndexOf('?');
        if (query >= 0)
        {
            trimmed = trimmed[..query];
        }

        return string.IsNullOrWhiteSpace(trimmed) ? "/" : trimmed;
    }

    var routeChoices = new List<(string Badge, string Title, string Summary, string Href, string Label, string[] Proof)>();
    var seenRoutes = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    void AddRouteChoice(string badge, string title, string summary, string href, string label, params string[] proof)
    {
        var normalized = NormalizeDetailRoute(href);
        if (!seenRoutes.Add(normalized))
        {
            return;
        }

        routeChoices.Add((badge, title, summary, href, label, proof));
    }

    var primaryRouteTitle = Model.Family switch
    {
        "roadmap" => "Take the next practical step",
        "live-proof" => "Open the next useful page",
        "preview-concept" => "See what is available now",
        _ => "Continue from this feature"
    };
    var primaryRouteSummary = Model.Family switch
    {
        "roadmap" => $"{Model.PrimaryAction.Label} opens the next page for this work area.",
        "live-proof" => $"{Model.PrimaryAction.Label} opens the related product page.",
        "preview-concept" => $"{Model.PrimaryAction.Label} shows what you can use today.",
        _ => $"{Model.PrimaryAction.Label} continues from this feature."
    };
    var primaryRouteProof = Model.Family switch
    {
        "roadmap" => new[] { "Next step", "Current status", "Help nearby" },
        "live-proof" => new[] { "Product page", "Downloads nearby", "Help nearby" },
        "preview-concept" => new[] { "Available now", "Next step", "Help nearby" },
        _ => new[] { "Feature detail", "Next page", "Help nearby" }
    };

    var compareRoute = Model.Family switch
    {
        "roadmap" => (
            Href: "/now",
            Label: "Open what works today",
            Title: "Check what is available today",
            Summary: "Use the current status page when you want to know what is ready to use.",
            Proof: new[] { "Current status", "Download path", "Known limits" }),
        "live-proof" => (
            Href: "/downloads",
            Label: "Open downloads",
            Title: "Install or update Chummer",
            Summary: "Use downloads when you need the current Windows or Linux installer.",
            Proof: new[] { "Installer", "Platform choice", "Help nearby" }),
        "preview-concept" => (
            Href: "/now",
            Label: "Open what works today",
            Title: "Check what is available today",
            Summary: "Use the current status page before planning around an upcoming feature.",
            Proof: new[] { "Current status", "Downloads", "Help nearby" }),
        _ => (
            Href: "/now",
            Label: "Open what works today",
            Title: "Check what is available today",
            Summary: "Use the current status page when availability matters more than the feature brief.",
            Proof: new[] { "Current status", "Downloads", "Help nearby" })
    };

    var deeperRoute = Model.SecondaryAction is not null
        ? (
            Href: Model.SecondaryAction.Href,
            Label: Model.SecondaryAction.Label,
            Title: "Read the longer brief",
            Summary: $"{Model.SecondaryAction.Label} opens the broader context for this feature.",
            Proof: new[] { "More context", "Related pages", "Help nearby" })
        : Model.Family switch
        {
            "roadmap" => (
                Href: "/horizons",
                Label: "Open horizons",
                Title: "Open the broader roadmap",
                Summary: "Move to Horizons when you want the larger product picture.",
                Proof: new[] { "Roadmap", "Related work", "Current status" }),
            "live-proof" => (
                Href: "/artifacts",
                Label: "Open detail view",
                Title: "Open the related detail view",
                Summary: "Use the detail view when you want nearby items and history together.",
                Proof: new[] { "Details", "Related items", "History" }),
            "preview-concept" => (
                Href: "/artifacts",
                Label: "Open detail view",
                Title: "Open the related detail view",
                Summary: "Use the detail view when you want nearby items and availability context together.",
                Proof: new[] { "Details", "Related items", "Availability" }),
            _ => (
                Href: "/roadmap",
                Label: "Open roadmap",
                Title: "Open the broader roadmap",
                Summary: "Open the roadmap when you need surrounding context.",
                Proof: new[] { "Roadmap", "Related pages", "Current status" })
        };

    AddRouteChoice("Best next page", primaryRouteTitle, primaryRouteSummary, Model.PrimaryAction.Href, Model.PrimaryAction.Label, primaryRouteProof);
    AddRouteChoice(compareRoute.Title.Contains("Install or update", StringComparison.Ordinal) ? "Install" : "Status", compareRoute.Title, compareRoute.Summary, compareRoute.Href, compareRoute.Label, compareRoute.Proof);
    AddRouteChoice("Deeper context", deeperRoute.Title, deeperRoute.Summary, deeperRoute.Href, deeperRoute.Label, deeperRoute.Proof);
    AddRouteChoice(
        "Help",
        "Get help if this becomes a setup or account issue",
        "Use help for private account follow-up, install repair, logs, or campaign-specific recovery.",
        "/help",
        "Open help",
        "Support",
        "Private follow-up",
        "Setup help");
}

<section class="story-cinematic">
    <div class="story-cinematic__copy">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@Model.Intro</p>
        <div class="stacked-actions">
            <a class="button-like button-like--primary" href="@Model.PrimaryAction.Href">@Model.PrimaryAction.Label</a>
            @if (Model.SecondaryAction is not null
                && !string.Equals(
                    NormalizeDetailRoute(Model.SecondaryAction.Href),
                    NormalizeDetailRoute(Model.PrimaryAction.Href),
                    StringComparison.OrdinalIgnoreCase))
            {
                <a class="button-like button-like--ghost" href="@Model.SecondaryAction.Href">@Model.SecondaryAction.Label</a>
            }
        </div>
    </div>
    @if (Model.Asset is not null)
    {
        <div class="story-cinematic__media">
            @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", Model.Asset)
        </div>
    }
</section>

<section class="editorial-block" id="feature-route-map">
    <div class="editorial-block__lead">
        <p class="eyebrow">Where to go next</p>
        <h2 class="editorial-title">Where to go next.</h2>
        <p class="editorial-copy">Pick the next page for the job: install, check status, check detail, or get help.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var choice in routeChoices)
        {
            <article class="route-choice-card">
                <span class="tag">@choice.Badge</span>
                <h3>@choice.Title</h3>
                <p>@choice.Summary</p>
                <div class="route-choice-card__proof">
                    @foreach (var item in choice.Proof)
                    {
                        <span>@item</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@choice.Href">@choice.Label</a>
            </article>
        }
    </div>
</section>

<section class="trust-rail-section">
    <div class="editorial-block__lead">
        <p class="eyebrow">@Model.StatusEyebrow</p>
        <h2 class="editorial-title">@Model.StatusHeading</h2>
    </div>
    <div class="trust-rail-list">
        @foreach (var fact in Model.Facts)
        {
            <article class="trust-rail">
                <span class="tag">@fact.Label</span>
                <p>@fact.Body</p>
            </article>
        }
    </div>
</section>

@switch (Model.Family)
{
    case "roadmap":
        @await Html.PartialAsync("~/Views/PublicLanding/_FeatureDetailRoadmap.cshtml", Model)
        break;
    case "live-proof":
        @await Html.PartialAsync("~/Views/PublicLanding/_FeatureDetailLiveProof.cshtml", Model)
        break;
    case "preview-concept":
        @await Html.PartialAsync("~/Views/PublicLanding/_FeatureDetailPreviewConcept.cshtml", Model)
        break;
    default:
        @await Html.PartialAsync("~/Views/PublicLanding/_FeatureDetailPreviewConcept.cshtml", Model)
        break;
}

<section class="release-footnote">
    <p class="eyebrow">Next step</p>
    <h2 class="editorial-title">Use the feature detail to answer one question, then move to the page that owns the next job.</h2>
    <p class="editorial-copy">Take the explicit next action when the card is clear, compare against current release status when availability matters, and leave for help as soon as the issue becomes private, recovery-bound, or support-owned.</p>
    <div class="stacked-actions">
        <a class="cta-link cta-link--primary" href="@Model.PrimaryAction.Href">@Model.PrimaryAction.Label</a>
        <a class="cta-link cta-link--secondary" href="@deeperRoute.Href">@deeperRoute.Label</a>
        <a class="cta-link cta-link--ghost" href="/help">Open help</a>
    </div>
</section>

@model FeatureDetailPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-feature-detail";
    static string NormalizeDetailRoute(string href)
    {
        var trimmed = (href ?? string.Empty).Trim();
        var hash = trimmed.IndexOf('#');
        if (hash >= 0)
        {
            trimmed = trimmed[..hash];
        }

        var query = trimmed.IndexOf('?');
        if (query >= 0)
        {
            trimmed = trimmed[..query];
        }

        return string.IsNullOrWhiteSpace(trimmed) ? "/" : trimmed;
    }

    var routeChoices = new List<(string Badge, string Title, string Summary, string Href, string Label, string[] Proof)>();
    var seenRoutes = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    void AddRouteChoice(string badge, string title, string summary, string href, string label, params string[] proof)
    {
        var normalized = NormalizeDetailRoute(href);
        if (!seenRoutes.Add(normalized))
        {
            return;
        }

        routeChoices.Add((badge, title, summary, href, label, proof));
    }

    var primaryRouteTitle = Model.Family switch
    {
        "roadmap" => "Take the bounded next step without pretending the whole horizon is already shipped",
        "live-proof" => "Take the direct next action when this artifact already proved itself",
        "preview-concept" => "Follow the one truthful next action instead of treating preview copy like a live release",
        _ => "Take the direct next page once this detail answered the question"
    };
    var primaryRouteSummary = Model.Family switch
    {
        "roadmap" => $"{Model.PrimaryAction.Label} is the current next page for this horizon. Use it when the detail answered the question and you know which bounded action comes next.",
        "live-proof" => $"{Model.PrimaryAction.Label} stays available because this page is proving one user-visible artifact, not hiding the next action behind vague card copy.",
        "preview-concept" => $"{Model.PrimaryAction.Label} is the honest next move from this preview concept. It keeps the next step explicit about what is real now versus what is still opening next.",
        _ => $"{Model.PrimaryAction.Label} is the explicit next page for this feature detail once the bounded question is resolved."
    };
    var primaryRouteProof = Model.Family switch
    {
        "roadmap" => new[] { "Bounded action", "No fake ship claim", "Next step explicit" },
        "live-proof" => new[] { "User-visible proof", "Direct continuation", "No vague gallery loop" },
        "preview-concept" => new[] { "Preview stays honest", "Next move explicit", "No fake release claim" },
        _ => new[] { "Bounded detail", "Single next page", "Next step stays honest" }
    };

    var compareRoute = Model.Family switch
    {
        "roadmap" => (
            Href: "/now",
            Label: "Open what works today",
            Title: "Compare with live proof instead of treating a horizon as already shipped",
            Summary: "Roadmap detail keeps direction honest, but the live proof page still owns current user-available truth.",
            Proof: new[] { "Current proof shelf", "No fake ship claim", "Install truth stays separate" }),
        "live-proof" => (
            Href: "/downloads",
            Label: "Open downloads",
            Title: "Use downloads when the question becomes install or update posture",
            Summary: "This detail proves one artifact or flow. Downloads still owns build choice, platform posture, and known issues.",
            Proof: new[] { "Install path", "Known issues nearby", "One calmer device path" }),
        "preview-concept" => (
            Href: "/now",
            Label: "Open what works today",
            Title: "Compare with the live proof page before treating a preview as already available",
            Summary: "Preview concepts stay explicit about what is still opening next. The live proof page still answers what a user can start from today.",
            Proof: new[] { "Preview stays honest", "Current proof nearby", "No fake availability" }),
        _ => (
            Href: "/now",
            Label: "Open what works today",
            Title: "Check the live proof page when current availability matters more than the feature brief",
            Summary: "The feature detail answers one bounded question. The live proof page still owns current release truth.",
            Proof: new[] { "Current proof", "Availability first", "No mixed jobs" })
    };

    var deeperRoute = Model.SecondaryAction is not null
        ? (
            Href: Model.SecondaryAction.Href,
            Label: Model.SecondaryAction.Label,
            Title: "Open the deeper brief only when you need the longer rationale",
            Summary: $"{Model.SecondaryAction.Label} stays available for the larger comparison, fallback, or family context behind this card.",
            Proof: new[] { "Deeper context", "Fallback nearby", "One layer up" })
        : Model.Family switch
        {
            "roadmap" => (
                Href: "/horizons",
                Label: "Open horizons",
                Title: "Open the broader roadmap family only when you need the larger product picture",
                Summary: "Stay on this detail for the bounded feature question. Move to Horizons when you need the wider upcoming wave.",
                Proof: new[] { "Broader direction", "One layer up", "Still planned" }),
            "live-proof" => (
                Href: "/artifacts",
                Label: "Open artifacts shelf",
                Title: "Go back to the proof shelf when you need comparison instead of one isolated card",
                Summary: "The artifacts shelf keeps adjacent proof, provenance, and comparison together instead of turning this detail page into a dead end.",
                Proof: new[] { "Proof shelf", "Comparison nearby", "Same trust family" }),
            "preview-concept" => (
                Href: "/artifacts",
                Label: "Open artifacts shelf",
                Title: "Use the proof shelf when you want adjacent preview and live artifacts together",
                Summary: "Preview concepts become easier to read when the shelf keeps neighboring proof and availability context nearby.",
                Proof: new[] { "Preview and live together", "Proof shelf", "Comparison nearby" }),
            _ => (
                Href: "/roadmap",
                Label: "Open roadmap",
                Title: "Move to the larger page family only when the single feature card is not enough",
                Summary: "This detail page stays bounded on purpose. Open the broader page family when you need surrounding context.",
                Proof: new[] { "Broader context", "Still first-party", "Bounded detail stays bounded" })
        };

    AddRouteChoice("Best next page", primaryRouteTitle, primaryRouteSummary, Model.PrimaryAction.Href, Model.PrimaryAction.Label, primaryRouteProof);
    AddRouteChoice(compareRoute.Title.Contains("install or update posture", StringComparison.Ordinal) ? "Install path" : "Reality check", compareRoute.Title, compareRoute.Summary, compareRoute.Href, compareRoute.Label, compareRoute.Proof);
    AddRouteChoice("Deeper context", deeperRoute.Title, deeperRoute.Summary, deeperRoute.Href, deeperRoute.Label, deeperRoute.Proof);
    AddRouteChoice(
        "Help",
        "Leave feature detail for first-party help as soon as the issue becomes support or recovery",
        "If the question needs private account follow-up, install repair, logs, or campaign-specific recovery, stop using the feature brief as a support surface and move to help immediately.",
        "/help",
        "Open help",
        "Support-owned",
        "Private follow-up",
        "No page confusion");
}

<section class="story-cinematic">
    <div class="story-cinematic__copy">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h1 class="page-title">@Model.Heading</h1>
        <p class="page-copy">@Model.Intro</p>
        <div class="stacked-actions">
            <a class="button-like button-like--primary" href="@Model.PrimaryAction.Href">@Model.PrimaryAction.Label</a>
            @if (Model.SecondaryAction is not null
                && !string.Equals(
                    NormalizeDetailRoute(Model.SecondaryAction.Href),
                    NormalizeDetailRoute(Model.PrimaryAction.Href),
                    StringComparison.OrdinalIgnoreCase))
            {
                <a class="button-like button-like--ghost" href="@Model.SecondaryAction.Href">@Model.SecondaryAction.Label</a>
            }
        </div>
    </div>
    @if (Model.Asset is not null)
    {
        <div class="story-cinematic__media">
            @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", Model.Asset)
        </div>
    }
</section>

<section class="editorial-block" id="feature-route-map">
    <div class="editorial-block__lead">
        <p class="eyebrow">Where to go next</p>
        <h2 class="editorial-title">Keep feature detail, proof, installs, and help on their own pages.</h2>
        <p class="editorial-copy">This page should answer the bounded question behind one feature card. It should not pretend to be the whole roadmap, the install page, or private support.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var choice in routeChoices)
        {
            <article class="route-choice-card">
                <span class="tag">@choice.Badge</span>
                <h3>@choice.Title</h3>
                <p>@choice.Summary</p>
                <div class="route-choice-card__proof">
                    @foreach (var item in choice.Proof)
                    {
                        <span>@item</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@choice.Href">@choice.Label</a>
            </article>
        }
    </div>
</section>

<section class="trust-rail-section">
    <div class="editorial-block__lead">
        <p class="eyebrow">@Model.StatusEyebrow</p>
        <h2 class="editorial-title">@Model.StatusHeading</h2>
    </div>
    <div class="trust-rail-list">
        @foreach (var fact in Model.Facts)
        {
            <article class="trust-rail">
                <span class="tag">@fact.Label</span>
                <p>@fact.Body</p>
            </article>
        }
    </div>
</section>

@switch (Model.Family)
{
    case "roadmap":
        @await Html.PartialAsync("~/Views/PublicLanding/_FeatureDetailRoadmap.cshtml", Model)
        break;
    case "live-proof":
        @await Html.PartialAsync("~/Views/PublicLanding/_FeatureDetailLiveProof.cshtml", Model)
        break;
    case "preview-concept":
        @await Html.PartialAsync("~/Views/PublicLanding/_FeatureDetailPreviewConcept.cshtml", Model)
        break;
    default:
        @await Html.PartialAsync("~/Views/PublicLanding/_FeatureDetailPreviewConcept.cshtml", Model)
        break;
}

<section class="release-footnote">
    <p class="eyebrow">Next step</p>
    <h2 class="editorial-title">Use the feature detail to answer one question, then move to the page that owns the next job.</h2>
    <p class="editorial-copy">Take the explicit next action when the card is clear, compare against live proof when availability matters, and leave for help as soon as the issue becomes private, recovery-bound, or support-owned.</p>
    <div class="stacked-actions">
        <a class="cta-link cta-link--primary" href="@Model.PrimaryAction.Href">@Model.PrimaryAction.Label</a>
        <a class="cta-link cta-link--secondary" href="@deeperRoute.Href">@deeperRoute.Label</a>
        <a class="cta-link cta-link--ghost" href="/help">Open help</a>
    </div>
</section>

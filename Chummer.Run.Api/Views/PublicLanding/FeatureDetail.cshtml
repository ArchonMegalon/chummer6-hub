@using Chummer.Run.Api.Services
@model FeatureDetailPageViewModel
@{
    ViewData["Title"] = UndetectableHumanizerCopyAdapter.Humanize(Model.Heading);
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-feature-detail surface-minimal";
    static string NormalizeDetailRoute(string href)
    {
        var trimmed = (href ?? string.Empty).Trim();
        var hash = trimmed.IndexOf('#');
        if (hash >= 0)
        {
            trimmed = trimmed[..hash];
        }

        var query = trimmed.IndexOf('?');
        if (query >= 0)
        {
            trimmed = trimmed[..query];
        }

        return string.IsNullOrWhiteSpace(trimmed) ? "/" : trimmed;
    }

    static string PublicText(string? value) => UndetectableHumanizerCopyAdapter.Humanize(value);
    const string ReleaseDetailFamily = "release-detail";
    const string PreviewDetailFamily = "preview-detail";
    var displayFamily = string.Equals(Model.Family, "live-release", StringComparison.OrdinalIgnoreCase)
        ? ReleaseDetailFamily
        : string.Equals(Model.Family, "preview-detail", StringComparison.OrdinalIgnoreCase)
            ? PreviewDetailFamily
        : Model.Family;

    var routeChoices = new List<(string Badge, string Title, string Summary, string Href, string Label, string[] Details)>();
    var seenRoutes = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    void AddRouteChoice(string badge, string title, string summary, string href, string label, params string[] details)
    {
        var normalized = NormalizeDetailRoute(href);
        if (!seenRoutes.Add(normalized))
        {
            return;
        }

        routeChoices.Add((PublicText(badge), PublicText(title), PublicText(summary), href, PublicText(label), details.Select(PublicText).ToArray()));
    }

    var primaryRouteTitle = displayFamily switch
    {
        "roadmap" => "Open the next page",
        ReleaseDetailFamily => "Open the related page",
        PreviewDetailFamily => "Open current release",
        _ => "Continue"
    };
    var primaryRouteSummary = displayFamily switch
    {
        "roadmap" => $"{Model.PrimaryAction.Label} is the next useful page.",
        ReleaseDetailFamily => $"{Model.PrimaryAction.Label} opens the related page.",
        PreviewDetailFamily => $"{Model.PrimaryAction.Label} shows the current release.",
        _ => $"{Model.PrimaryAction.Label} is the next useful step."
    };
    var primaryRouteDetails = displayFamily switch
    {
        "roadmap" => new[] { "Next page", "Current status", "Help nearby" },
        ReleaseDetailFamily => new[] { "Related page", "Downloads nearby", "Help nearby" },
        PreviewDetailFamily => new[] { "Live now", "Next page", "Help nearby" },
        _ => new[] { "Feature page", "Next page", "Help nearby" }
    };

    var compareRoute = displayFamily switch
    {
        "roadmap" => (
            Href: "/now",
            Label: "Open current release",
            Title: "Open current release",
            Summary: "Use the current status page for the live product.",
            Details: new[] { "Current status", "Downloads", "Known limits" }),
        ReleaseDetailFamily => (
            Href: "/downloads",
            Label: "Open downloads",
            Title: "Open downloads",
            Summary: "Use downloads when you need the current Windows or Linux installer.",
            Details: new[] { "Installer", "Platform choice", "Help nearby" }),
        PreviewDetailFamily => (
            Href: "/now",
            Label: "Open current release",
            Title: "Open current release",
            Summary: "Use the current status page for the live product.",
            Details: new[] { "Current status", "Downloads", "Help nearby" }),
        _ => (
            Href: "/now",
            Label: "Open current release",
            Title: "Open current release",
            Summary: "Use the current status page for the live product.",
            Details: new[] { "Current status", "Downloads", "Help nearby" })
    };

    var deeperRoute = Model.SecondaryAction is not null
        ? (
            Href: Model.SecondaryAction.Href,
            Label: Model.SecondaryAction.Label,
            Title: "Read more",
            Summary: $"{Model.SecondaryAction.Label} opens the broader context for this feature.",
            Details: new[] { "More context", "Related pages", "Help nearby" })
        : displayFamily switch
        {
            "roadmap" => (
                Href: "/horizons",
                Label: "Open maintenance",
                Title: "Open maintenance",
                Summary: "Maintenance holds the broader product work.",
                Details: new[] { "Roadmap", "Related work", "Current status" }),
            ReleaseDetailFamily => (
                Href: "/artifacts",
                Label: "Open related pages",
                Title: "Open related pages",
                Summary: "Use related pages when you want nearby items and history together.",
                Details: new[] { "Related pages", "Nearby items", "History" }),
            PreviewDetailFamily => (
                Href: "/artifacts",
                Label: "Open related pages",
                Title: "Open related pages",
                Summary: "Use related pages when you want nearby items and current context together.",
                Details: new[] { "Related pages", "Nearby items", "Current context" }),
            _ => (
                Href: "/roadmap",
                Label: "Open roadmap",
                Title: "Open roadmap",
                Summary: "Open the roadmap when you need surrounding context.",
                Details: new[] { "Roadmap", "Related pages", "Current status" })
        };

    AddRouteChoice("Best next page", primaryRouteTitle, primaryRouteSummary, Model.PrimaryAction.Href, Model.PrimaryAction.Label, primaryRouteDetails);
    AddRouteChoice(compareRoute.Title.Contains("Install or update", StringComparison.Ordinal) ? "Install" : "Status", compareRoute.Title, compareRoute.Summary, compareRoute.Href, compareRoute.Label, compareRoute.Details);
    AddRouteChoice("Deeper context", deeperRoute.Title, deeperRoute.Summary, deeperRoute.Href, deeperRoute.Label, deeperRoute.Details);
    AddRouteChoice(
        "Help",
        "Use Chummer help for support or recovery",
        "Open help for setup, recovery, or private account issues.",
        "/help",
        "Open help",
        "Support",
        "Private follow-up",
        "Setup help");
}

@if (!Model.Chrome.Authenticated)
{
    <section class="minimal-page-hero feature-detail-compact">
        <div>
            <p class="minimal-kicker">@PublicText(Model.Eyebrow)</p>
            <h1>@PublicText(Model.Heading)</h1>
            <p>@PublicText(Model.Intro)</p>
            <div class="minimal-actions">
                <a class="button-like button-like--primary" href="@Model.PrimaryAction.Href">@PublicText(Model.PrimaryAction.Label)</a>
                @if (Model.SecondaryAction is not null
                    && !string.Equals(
                        NormalizeDetailRoute(Model.SecondaryAction.Href),
                        NormalizeDetailRoute(Model.PrimaryAction.Href),
                        StringComparison.OrdinalIgnoreCase))
                {
                    <a class="button-like button-like--ghost" href="@Model.SecondaryAction.Href">@PublicText(Model.SecondaryAction.Label)</a>
                }
            </div>
        </div>
        @if (Model.Asset is not null)
        {
            <div class="minimal-hero__visual minimal-hero__visual--screenshot feature-detail-compact__asset">
                @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", Model.Asset)
            </div>
        }
    </section>

    <section class="minimal-section minimal-section--tight">
        <div class="minimal-section__lead">
            <h2>Current state</h2>
        </div>
        <div class="minimal-platform-list">
            @foreach (var fact in Model.Facts.Take(3))
            {
                <article>
                    <h3>@PublicText(fact.Label)</h3>
                    <p>@PublicText(fact.Body)</p>
                </article>
            }
        </div>
    </section>

    <section class="minimal-section minimal-section--tight">
        <div class="minimal-section__lead">
            <h2>Next</h2>
            <p>Use the main action first. Open Chummer help only when setup, account, or private recovery detail is involved.</p>
        </div>
        <div class="minimal-download-strip">
            @foreach (var choice in routeChoices.Take(2))
            {
                <a class="minimal-download-strip__item" href="@choice.Href">
                    <span>@PublicText(choice.Badge)</span>
                    <strong>@PublicText(choice.Label)</strong>
                </a>
            }
            <a class="minimal-download-strip__item" href="/help">
                <span>Help</span>
                <strong>Open help</strong>
            </a>
        </div>
    </section>
}
else
{
<section class="story-cinematic">
    <div class="story-cinematic__copy">
        <p class="eyebrow">@PublicText(Model.Eyebrow)</p>
        <h1 class="page-title">@PublicText(Model.Heading)</h1>
        <p class="page-copy">@PublicText(Model.Intro)</p>
        <div class="stacked-actions">
            <a class="button-like button-like--primary" href="@Model.PrimaryAction.Href">@PublicText(Model.PrimaryAction.Label)</a>
            @if (Model.SecondaryAction is not null
                && !string.Equals(
                    NormalizeDetailRoute(Model.SecondaryAction.Href),
                    NormalizeDetailRoute(Model.PrimaryAction.Href),
                    StringComparison.OrdinalIgnoreCase))
            {
                <a class="button-like button-like--ghost" href="@Model.SecondaryAction.Href">@PublicText(Model.SecondaryAction.Label)</a>
            }
        </div>
    </div>
    @if (Model.Asset is not null)
    {
        <div class="story-cinematic__media">
            @await Html.PartialAsync("~/Views/Shared/_SceneAsset.cshtml", Model.Asset)
        </div>
    }
</section>

<section class="editorial-block" id="feature-route-map">
    <div class="editorial-block__lead">
        <p class="eyebrow">Where next</p>
        <h2 class="editorial-title">Choose the next step.</h2>
        <p class="editorial-copy">Open the page that matches the job: install, status, details, or help.</p>
    </div>
    <div class="route-choice-grid">
        @foreach (var choice in routeChoices)
        {
            <article class="route-choice-card">
                <span class="tag">@PublicText(choice.Badge)</span>
                <h3>@PublicText(choice.Title)</h3>
                <p>@PublicText(choice.Summary)</p>
                <div class="route-choice-card__details">
                    @foreach (var item in choice.Details)
                    {
                        <span>@PublicText(item)</span>
                    }
                </div>
                <a class="editorial-strip__action" href="@choice.Href">@PublicText(choice.Label)</a>
            </article>
        }
    </div>
</section>

<section class="trust-rail-section">
    <div class="editorial-block__lead">
        <p class="eyebrow">@PublicText(Model.StatusEyebrow)</p>
        <h2 class="editorial-title">@PublicText(Model.StatusHeading)</h2>
    </div>
    <div class="trust-rail-list">
        @foreach (var fact in Model.Facts)
        {
            <article class="trust-rail">
                <span class="tag">@PublicText(fact.Label)</span>
                <p>@PublicText(fact.Body)</p>
            </article>
        }
    </div>
</section>

@switch (displayFamily)
{
    case "roadmap":
        @await Html.PartialAsync("~/Views/PublicLanding/_FeatureDetailRoadmap.cshtml", Model)
        break;
    case ReleaseDetailFamily:
        @await Html.PartialAsync("~/Views/PublicLanding/_FeatureDetailLiveProof.cshtml", Model)
        break;
    case PreviewDetailFamily:
        @await Html.PartialAsync("~/Views/PublicLanding/_FeatureDetailPreviewConcept.cshtml", Model)
        break;
    default:
        @await Html.PartialAsync("~/Views/PublicLanding/_FeatureDetailPreviewConcept.cshtml", Model)
        break;
}

<section class="release-footnote">
    <p class="eyebrow">Next</p>
    <h2 class="editorial-title">Move on once this is clear.</h2>
    <p class="editorial-copy">Take the direct action when it is clear. Open status for the live product, or Help for support.</p>
    <div class="stacked-actions">
        <a class="cta-link cta-link--primary" href="@Model.PrimaryAction.Href">@PublicText(Model.PrimaryAction.Label)</a>
        <a class="cta-link cta-link--secondary" href="@deeperRoute.Href">@PublicText(deeperRoute.Label)</a>
        <a class="cta-link cta-link--ghost" href="/help">Open help</a>
    </div>
</section>
}

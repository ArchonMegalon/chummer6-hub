@model LeaderboardsPageViewModel
@{
    ViewData["Title"] = "Leaderboards";
    ViewData["Chrome"] = Model.Chrome;
}

<section class="section-band">
    <div class="page-lead">
        <p class="eyebrow">Community utility</p>
        <h1 class="page-title">Community recognition</h1>
        <p class="page-copy">This is an optional community surface, not a normal product requirement. It keeps recognition visible without exposing private account details.</p>
    </div>

    <div class="settings-grid">
        <section class="settings-block">
            <h2>Individuals</h2>
            <div class="table-shell">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Rank</th>
                            <th scope="col">Runner</th>
                            <th scope="col">Points</th>
                            <th scope="col">Contributions</th>
                            <th scope="col">Landed</th>
                            <th scope="col">Tokens</th>
                            <th scope="col">Badges</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Individuals)
                    {
                        <tr>
                            <td>@row.Rank</td>
                            <td>@row.DisplayName</td>
                            <td>@row.Points</td>
                            <td>@row.ContributionCount</td>
                            <td>@row.LandedSlices</td>
                            <td>@row.ParticipantTotalTokens</td>
                            <td>@row.BadgeCount</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="settings-block">
            <h2>Current contribution standing</h2>
            <div class="table-shell">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Rank</th>
                            <th scope="col">Runner</th>
                            <th scope="col">Access tier</th>
                            <th scope="col">Current score</th>
                            <th scope="col">Lifetime points</th>
                            <th scope="col">Confirmed</th>
                            <th scope="col">Tokens</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.SponsorRank)
                    {
                        <tr>
                            <td>@row.Rank</td>
                            <td>@row.DisplayName</td>
                            <td>@row.CurrentAuthorizationTier</td>
                            <td>@row.CurrentRankScore</td>
                            <td>@row.LifetimePoints</td>
                            <td>@row.VerifiedSlices</td>
                            <td>@row.ParticipantTotalTokens</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="settings-block">
            <h2>Contribution usage</h2>
            <p class="muted-copy">Public contribution handles show how much confirmed product work each volunteer path actually carried.</p>
            <div class="table-shell">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Rank</th>
                            <th scope="col">Runner</th>
                            <th scope="col">Contribution code</th>
                            <th scope="col">Usage</th>
                            <th scope="col">Entries</th>
                            <th scope="col">Landed</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.CodexUsage)
                    {
                        <tr>
                            <td>@row.Rank</td>
                            <td>@row.DisplayName</td>
                            <td>@(row.ParticipantCodexCode ?? "Private")</td>
                            <td>@row.ParticipantTotalTokens</td>
                            <td>@row.ReceiptCount</td>
                            <td>@row.LandedSlices</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="settings-block">
            <h2>Groups</h2>
            <div class="table-shell">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Rank</th>
                            <th scope="col">Group</th>
                            <th scope="col">Points</th>
                            <th scope="col">Landed</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Groups)
                    {
                        <tr>
                            <td>@row.Rank</td>
                            <td>@row.GroupName</td>
                            <td>@row.Points</td>
                            <td>@row.LandedSlices</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="settings-block">
            <h2>Active contribution goals</h2>
            <div class="check-grid">
            @foreach (var quest in Model.Quests)
            {
                <article class="rail-item">
                    <h3>@quest.Title</h3>
                    <p>@quest.Description</p>
                    <p class="muted-copy">@quest.CurrentProgress / @quest.TargetProgress · @quest.Status.Replace('_', ' ')</p>
                </article>
            }
            </div>
        </section>
    </div>
</section>

                                        <span>@HumanizeStatus(action.Authority, "hub_entitlement_ledger")</span>
                                        <span>Next: @DescribeRecoveryRouteAction(action.Route)</span>
                                        <span>@HumanizeStatus(action.ContinuePosture, action.BlocksContinue ? "Continue blocked" : "Review before continuing")</span>
                                        @if (IsNavigableAccountRoute(action.Route))
                                        {
                                            <span><a href="@action.Route">@DescribeRecoveryRouteAction(action.Route)</a></span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        @if (IsNavigableAccountRoute(entitlementSyncReceipts.ReceiptStatus.RecoveryRoute))

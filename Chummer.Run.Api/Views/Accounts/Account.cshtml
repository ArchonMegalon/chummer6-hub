        method: "POST",
        json: {
          installationId: installationSelect.value,
          note: noteInput?.value.trim() || null
        }
      });
      window.location.href = `${workspaceDetailHref(selectedWorkspaceId)}#travel-prefetches`;
    } catch (error) {

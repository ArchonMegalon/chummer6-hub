                                                    <span> @sponsorSession.StatusSummary</span>
                                                    @if (!string.IsNullOrWhiteSpace(sponsorSession.LatestEventSummary))
                                                    {
                                                        <span> Latest: @sponsorSession.LatestEventSummary</span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                </details>
                            </details>
                            <details id="community-op-guidance-@op.GroupId" class="details-drawer">

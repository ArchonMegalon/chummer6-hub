                                    <div class="settings-summary-row">
                                        <span>Recent sponsor sessions</span>
                                        <strong>@(op.RecentSponsorSessions.Count == 0 ? "Quiet" : $"{op.RecentSponsorSessions.Count} recent")</strong>
                                    </div>
                                </div>
                                <p class="muted-copy">Community invites, sponsorship entry, and stale-code recovery stay in the same account view instead of getting pushed into chat folklore.</p>
                                <div class="grid-split">

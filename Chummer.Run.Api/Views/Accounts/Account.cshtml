                                    <article class="app-rail__item">
                                        <span class="tag">Current release</span>
                                        <div class="app-rail__copy">
                                            <h3>Current release status</h3>
                                            <p>Point members to the live release, current recommendation, and known caution state without translating repo status by hand.</p>
                                        </div>
                                        <a class="inline-link" href="/now">Open current release</a>
                                    </article>
                                    <article class="app-rail__item">
                                        <span class="tag">Member downloads</span>
                                        <div class="app-rail__copy">
                                            <h3>Install and update</h3>
                                            <p>Use the real downloads page when members need the current installer, update path, or claim path instead of passing around stale links.</p>
                                        </div>
                                        <a class="inline-link" href="/downloads">Open downloads</a>
                                    </article>
                                    <article class="app-rail__item">
                                        <span class="tag">Help &amp; trust</span>
                                        <div class="app-rail__copy">
                                            <h3>Help and privacy</h3>
                                            <p>Help, contact, and privacy-boundary guidance stay on the same first-party surface so organizers can point members to the real recovery path.</p>
                                        </div>
                                        <a class="inline-link" href="/help">Open help and trust</a>
                                    </article>
                                    <article class="app-rail__item">
                                        <span class="tag">Support closure</span>
                                        <div class="app-rail__copy">
                                            <h3>@(openSupportCases == 0 ? "Quiet support" : "Tracked support continuity")</h3>
                                            <p>@(openSupportCases == 0 ? "No tracked support case is blocking organizer guidance right now, so members can stay on the public release and help pages." : $"{openSupportCases} tracked support case(s) are still visible on this account if member guidance needs a real closure reference.")</p>
                                            <p class="muted-copy">@op.SupportEscalationSummary</p>
                                        </div>
                                        <a class="inline-link" href="/account/support">Open support closure</a>
                                    </article>
                                </div>
                            </details>
                            @if (op.Capabilities.Count > 0)
                            {
                                <details class="details-drawer">
                                    <summary>Permissions</summary>
                                    <ul class="muted-copy">
                                        @foreach (var capability in op.Capabilities)
                                        {
                                            <li>@capability</li>
                                        }
                                    </ul>
                                </details>
                            }
                            @if (op.CampaignNames.Count > 0)
                            {
                                <details class="details-drawer">
                                    <summary>Visible campaigns</summary>
                                    <ul class="muted-copy">
                                        @foreach (var name in op.CampaignNames)
                                        {
                                            <li>@name</li>
                                        }
                                    </ul>
                                </details>
                            }
                            @if (op.RecentRosterTransfers is { Count: > 0 })
                            {
                                <details class="details-drawer">
                                    <summary>Recent roster moves</summary>
                                    <ul class="muted-copy">
                                        @foreach (var transfer in op.RecentRosterTransfers)
                                        {
                                            <li>
                                                <strong>@transfer.RunnerHandle:</strong> @transfer.Summary
                                                <span> @transfer.TransferredAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</span>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                        </details>
                    }
                    <p class="muted-copy">Recognition, badges, and sponsor motion stay secondary to campaign ownership, permissions, and real support closure.</p>
                }
            </section>
            </details>
            }

            @if (showSettingsSection)
            {
            <details class="details-drawer">
                <summary>Privacy</summary>
                <section id="privacy" class="settings-section" data-account-panel>
                    <div class="settings-section__header">
                        <h2>Privacy</h2>
                        <p>Choose what stays visible while deeper identifiers remain tucked away.</p>
                    </div>
                    <div class="settings-summary-list">
                        <div class="settings-summary-row">
                            <span>Visibility</span>
                            <strong>@HumanizeStatus(Model.User.Visibility, "Private")</strong>
                        </div>
                        <div class="settings-summary-row">
                            <span>Recovery status</span>
                            <strong>@HumanizeStatus(Model.Links.RecoveryPosture, "Single method")</strong>
                        </div>
                    </div>
                    @if (Model.PrivacyBoundary is not null)
                    {
                        @await Html.PartialAsync("~/Views/Shared/_PrivacyBoundaryPanel.cshtml", Model.PrivacyBoundary)
                    }
                </section>
            </details>
            }

            @if (showParticipationSettings && showParticipationSection)
            {
            <details class="details-drawer" @(showParticipationPage ? "open" : null)>
            <summary>@(showParticipationPage ? "Participation dashboard" : "Participation")</summary>
            <section id="participation" class="settings-section" data-account-panel>
                <div class="settings-section__header">
                    <h2>Participation</h2>
                    <p>Return to followed work, guided contribution history, and privacy-safe recognition without turning votes into shipping decisions.</p>
                </div>
                <div class="settings-summary-list">
                    <div class="settings-summary-row">
                        <span>Participation state</span>
                        <strong id="participationOverviewState">@(showParticipationSection ? "Configured" : "Available")</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Contribution cred</span>
                        <strong>@((participationRecognition?.LifetimePoints ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Guided contribution</span>
                        <strong>@(participationSession is null ? "Not started" : HumanizeStatus(participationSession.Status, "Active"))</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Public participation profile</span>
                        <strong>@(Model.Experience.PublicContributionProfileOptIn ? "Opted in" : "Off")</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Impact closeout notifications</span>
                        <strong>@(Model.Experience.ImpactCloseoutNotifications ? "Enabled" : "Off")</strong>
                    </div>
                </div>
                @if (participationBadges.Length > 0)
                {
                    <div class="route-choice-card__details">
                        @foreach (var badge in participationBadges)
                        {
                            <span>@badge.Label</span>
                        }
                    </div>
                }
                <p class="muted-copy">Contribution credit follows useful closeout and continuity. Votes show demand; only finished work ships. Public recognition stays off unless you opt in.</p>
                <p class="muted-copy">Recovery codes stay below as a fallback, not the first instruction.</p>
                <section class="compact-rail">
                    <article class="compact-rail__item">
                        <div class="compact-rail__copy">
                            <h3>Followed work</h3>
                            <p>@packageFollowCount package follow@(packageFollowCount == 1 ? string.Empty : "s"), @packageVoteCount package vote@(packageVoteCount == 1 ? string.Empty : "s"), and @(Model.Experience.FollowHorizons ? "roadmap updates enabled" : "roadmap updates off").</p>
                        </div>
                        <a class="editorial-strip__action" href="/packages">Open packages</a>
                    </article>
                    <article class="compact-rail__item">
                        <div class="compact-rail__copy">
                            <h3>KARMA FORGE</h3>
                            <p>@participationKarmaSubmissions.Length recent submission@(participationKarmaSubmissions.Length == 1 ? string.Empty : "s"). Guided discovery stays separate from support and only moves after review.</p>
                        </div>
                        <a class="editorial-strip__action" href="/participate/karma-forge">Open KARMA FORGE</a>
                    </article>
                    <article class="compact-rail__item">
                        <div class="compact-rail__copy">
                            <h3>Guided contribution history</h3>
                            <p>@participationReceipts.Length recent event@(participationReceipts.Length == 1 ? string.Empty : "s"), @(participationRecognition?.LandedSlices ?? 0) landed slice@(participationRecognition?.LandedSlices == 1 ? string.Empty : "s"), and @(participationRecognition?.ActiveSessionCount ?? 0) active session@(participationRecognition?.ActiveSessionCount == 1 ? string.Empty : "s").</p>
                        </div>
                        <a class="editorial-strip__action" href="/participate/codex">Open guided contribution</a>
                    </article>
                </section>
                <section class="compact-rail">
                    @if (participationPackageReceipts.Length == 0 && participationKarmaSubmissions.Length == 0 && participationReceipts.Length == 0 && participationActivityReceipts.Length == 0)
                    {
                        <article class="compact-rail__item">
                            <div class="compact-rail__copy">
                                <h3>Participation journal</h3>
                                <p>Follow a package, join the beta waitlist, or start guided contribution to make this journal useful without exposing anything publicly by default.</p>
                            </div>
                        </article>
                    }
                    else
                    {
                        @foreach (var receipt in participationPackageReceipts)
                        {
                            <article class="compact-rail__item">
                                <div class="compact-rail__copy">
                                    <h3>Package @HumanizeStatus(receipt.ActionKind)</h3>
                                    <p>@receipt.RouteSummary</p>
                                    <p><strong>@receipt.PackageId</strong> · @receipt.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture)</p>
                                </div>
                            </article>
                        }
                        @foreach (var submission in participationKarmaSubmissions)
                        {
                            <article class="compact-rail__item">
                                <div class="compact-rail__copy">
                                    <h3>KARMA FORGE packet</h3>
                                    <p>@submission.QueueSummary</p>
                                    <p><strong>@submission.Packet.Title</strong> · @submission.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture)</p>
                                </div>
                                <a class="editorial-strip__action" href="/participate/karma-forge/submitted/@submission.SubmissionId">Open submission</a>
                            </article>
                        }
                        @foreach (var receipt in participationReceipts)
                        {
                            <article class="compact-rail__item">
                                <div class="compact-rail__copy">
                                    <h3>Contribution event</h3>
                                    <p>@HumanizeStatus(receipt.EventKind) · @receipt.ProjectId · @receipt.AuthorizationTierAtReceipt</p>
                                    <p>@((receipt.EndedAtUtc ?? receipt.LandedAtUtc ?? receipt.StartedAtUtc) is DateTimeOffset occurredAtUtc
                                        ? occurredAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture)
                                        : "Awaiting timestamp")</p>
                                </div>
                            </article>
                        }
                        @foreach (var activity in participationActivityReceipts)
                        {
                            <article class="compact-rail__item">
                                <div class="compact-rail__copy">
                                    <h3>Impact journal</h3>
                                    <p>@(activity.Summary ?? "A participation event was saved.")</p>
                                    <p><strong>@HumanizeStatus(activity.EventType)</strong> · @activity.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture)</p>
                                </div>
                            </article>
                        }
                    }
                </section>
                <form id="experienceForm" class="settings-form">
                    <div class="check-grid">
                        <label class="check-row"><input type="checkbox" value="player" @(laneInterests.Contains("player") ? "checked" : null) /> <span>Player</span></label>
                        <label class="check-row"><input type="checkbox" value="gm" @(laneInterests.Contains("gm") ? "checked" : null) /> <span>GM</span></label>
                        <label class="check-row"><input type="checkbox" value="creator" @(laneInterests.Contains("creator") ? "checked" : null) /> <span>Creator</span></label>
                        <label class="check-row"><input id="followHorizons" type="checkbox" @(Model.Experience.FollowHorizons ? "checked" : null) /> <span>Follow roadmap updates</span></label>
                        <label class="check-row"><input id="betaInterest" type="checkbox" @(Model.Experience.BetaInterest ? "checked" : null) /> <span>Invite me when the right beta opens</span></label>
                        <label class="check-row"><input id="impactCloseoutNotifications" type="checkbox" @(Model.Experience.ImpactCloseoutNotifications ? "checked" : null) /> <span>Send me closeout updates when something I followed actually changes</span></label>
                        <label class="check-row"><input id="publicContributionProfileOptIn" type="checkbox" @(Model.Experience.PublicContributionProfileOptIn ? "checked" : null) /> <span>Allow public participation recognition if my account visibility is already public</span></label>
                    </div>
                    <button class="button-like button-like--primary" type="submit">Save participation settings</button>
                    <p id="experienceStatusNotice" class="muted-copy" hidden></p>
                </form>
            </section>
            </details>
            }

            @if (showSettingsSection)
            {
            <details class="details-drawer">
                <summary>Help and policy</summary>
                <section class="settings-section" data-account-panel id="help-policy">
                    <div class="settings-section__header">
                        <h2>Help and policy</h2>
                        <p>When you need support, privacy, or preview-use guidance, use the first-party pages instead of guessing.</p>
                    </div>
                    <div class="stacked-actions">
                        <a class="button-like button-like--secondary" href="/help">Open help</a>
                        <a class="button-like button-like--ghost" href="/privacy">Read privacy</a>
                        <a class="button-like button-like--ghost" href="/terms">Read terms</a>
                        <a class="button-like button-like--ghost" href="/contact">Contact Chummer</a>
                    </div>
                </section>
            </details>
            }
            </div>
            }
        </div>
    </div>

    @if (showAdvancedSection)
    {
    <details class="details-drawer">
        <summary>Advanced account details</summary>
        <dl class="detail-grid detail-grid--account">
            <div>
                <dt>Hub account id</dt>
                <dd class="mono-receipt">@Model.User.UserId</dd>
            </div>
            <div>
                <dt>Primary auth</dt>
                <dd>@HumanizeStatus(Model.Links.RecommendedPrimaryAuth, "Choose one")</dd>
            </div>
            <div>
                <dt>Linked identities</dt>
                <dd>@Model.Links.LinkedIdentities.Count</dd>
            </div>
            <div>
                <dt>Linked channels</dt>
                <dd>@Model.Links.ChannelLinks.Count</dd>
            </div>
            <div>
                <dt>Recovery status</dt>
                <dd>@PublicText(Model.Links.RecoveryPosture)</dd>
            </div>
            <div>
                <dt>Follow horizons</dt>
                <dd>@(Model.Experience.FollowHorizons ? "Yes" : "No")</dd>
            </div>
        </dl>
    </details>
    }
</section>

@section Scripts {
<script>
(() => {
  const ui = window.ChummerUi;
  const subjectId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.User.SubjectId));
  const rosterTransferPlan = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedWorkspaceRosterTransferPlan));
  const prepLaunchPackets = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedWorkspaceServerPlane?.PrepLibrary.Packets ?? Array.Empty<Chummer.Run.Api.Contracts.GovernedPrepPacketSummary>()));
  const prepLaunchRuns = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedWorkspace?.Runs ?? Array.Empty<Chummer.Campaign.Contracts.RunProjection>()));
  const aftermathPackageRuns = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedWorkspace?.Runs ?? Array.Empty<Chummer.Campaign.Contracts.RunProjection>()));
  const travelModeDevices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedWorkspaceServerPlane?.TravelMode.Devices ?? Array.Empty<Chummer.Run.Api.Contracts.TravelModeDeviceReadinessCue>()));
  const travelPrefetchInventorySummary = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedWorkspaceServerPlane?.TravelMode.PrefetchInventorySummary));
  const selectedWorkspaceId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedWorkspace?.WorkspaceId));
  const workspaceDetailHref = (workspaceId) => `/account/work/workspaces/${encodeURIComponent(workspaceId)}`;
  const starterWorkspaceButton = document.getElementById("seedStarterWorkspaceFromAccount");
  const starterWorkspaceNotice = document.getElementById("starterWorkspaceAccountNotice");
  const setStarterWorkspaceNotice = (message, isError = false) => {
    if (!starterWorkspaceNotice) {
      return;
    }

    ui.setNotice(starterWorkspaceNotice, message, isError);
  };
  const revealHashTarget = () => {
    const hash = window.location.hash;
    if (!hash) return;
    const target = document.querySelector(hash);
    if (!target) return;
    let node = target.parentElement;
    while (node) {
      if (node.tagName === "DETAILS") {
        node.open = true;
      }
      node = node.parentElement;
    }
  };

  revealHashTarget();
  window.addEventListener("hashchange", revealHashTarget);
  document.querySelectorAll("[data-account-tab]").forEach((link) => {
    link.addEventListener("click", () => window.setTimeout(revealHashTarget, 0));
  });
  starterWorkspaceButton?.addEventListener("click", async () => {
    ui.clearNotice(starterWorkspaceNotice);
    ui.setButtonBusy(starterWorkspaceButton, true, "Starting...");
    try {
      const payload = await ui.requestJson("/api/v1/campaign-spine/me/workspaces/starter", {
        method: "POST"
      });
      const workspaceId = payload?.workspaceId || payload?.WorkspaceId;
      if (typeof workspaceId === "string" && workspaceId.length > 0) {
        window.location.href = workspaceDetailHref(workspaceId);
        return;
      }

      setStarterWorkspaceNotice("Starter workspace is not ready yet. Open Home > Work to continue.", true);
    } catch (error) {
      setStarterWorkspaceNotice(ui.describeError(error, "Starter workspace could not be seeded right now."), true);
    } finally {
      ui.setButtonBusy(starterWorkspaceButton, false, "Starting...");
    }
  });

  const bindSubmit = (formId, handler) => {
    const form = document.getElementById(formId);
    if (!form) {
      return;
    }

    form.addEventListener("submit", handler);
  };

  const syncRosterTransferInputs = () => {
    const dossierSelect = document.getElementById("rosterTransferDossier");
    const groupSelect = document.getElementById("rosterTransferGroup");
    const ownerSelect = document.getElementById("rosterTransferOwner");
    const campaignInput = document.getElementById("rosterTransferCampaignTitle");
    if (!dossierSelect || !groupSelect || !ownerSelect || !campaignInput) {
      return;
    }

    const dossiers = Array.isArray(rosterTransferPlan?.DossierOptions) ? rosterTransferPlan.DossierOptions : [];
    const targetGroups = Array.isArray(rosterTransferPlan?.TargetGroups) ? rosterTransferPlan.TargetGroups : [];
    const selectedDossier = dossiers.find((item) => item.DossierId === dossierSelect.value) || dossiers[0];
    const selectedGroup = targetGroups.find((item) => item.GroupId === groupSelect.value) || targetGroups[0];
    ownerSelect.innerHTML = "";

    const keepOwnerOption = document.createElement("option");
    keepOwnerOption.value = "";
    keepOwnerOption.textContent = selectedDossier?.CurrentOwnerDisplayName
      ? `Keep current owner (${selectedDossier.CurrentOwnerDisplayName})`
      : "Keep current owner";
    ownerSelect.appendChild(keepOwnerOption);

    const ownerOptions = Array.isArray(selectedGroup?.OwnerOptions) ? selectedGroup.OwnerOptions : [];
    ownerOptions
      .filter((item) => item.UserId !== selectedDossier?.CurrentOwnerUserId)
      .forEach((item) => {
        const option = document.createElement("option");
        option.value = item.UserId;
        option.textContent = `${item.DisplayName} (${ui.humanizeStatus(item.Role, "member")})`;
        ownerSelect.appendChild(option);
      });

    campaignInput.placeholder = selectedGroup?.SuggestedCampaignTitle || "Use the target group's active campaign or create a transfer campaign";
  };

  syncRosterTransferInputs();
  document.getElementById("rosterTransferDossier")?.addEventListener("change", syncRosterTransferInputs);
  document.getElementById("rosterTransferGroup")?.addEventListener("change", syncRosterTransferInputs);

  const syncPrepLaunchTargets = () => {
    const runSelect = document.getElementById("prepLaunchRun");
    const sceneSelect = document.getElementById("prepLaunchScene");
    const packetSelect = document.getElementById("prepLaunchPacket");
    const preview = document.getElementById("prepLaunchTargetPreview");
    if (!packetSelect || !preview) {
      return;
    }

    const packet = Array.isArray(prepLaunchPackets)
      ? prepLaunchPackets.find((item) => item && item.PacketId === packetSelect.value)
      : null;
    const run = runSelect && Array.isArray(prepLaunchRuns)
      ? prepLaunchRuns.find((item) => item && item.RunId === runSelect.value) || prepLaunchRuns[0]
      : null;
    const scenes = Array.isArray(run?.Scenes) ? run.Scenes : [];

    if (sceneSelect) {
      const previousSceneId = sceneSelect.value;
      sceneSelect.innerHTML = "";
      for (const scene of scenes) {
        const option = document.createElement("option");
        option.value = scene.SceneId;
        option.textContent = scene.Title;
        sceneSelect.appendChild(option);
      }

      const preferredScene = scenes.find((item) => item.SceneId === (run?.ActiveSceneId || previousSceneId)) || scenes[0];
      if (preferredScene) {
        sceneSelect.value = preferredScene.SceneId;
      }
    }

    const scene = sceneSelect && scenes.length > 0
      ? scenes.find((item) => item.SceneId === sceneSelect.value) || scenes[0]
      : null;
    const rows = [
      ["Packet", packet?.Title || "Select a prep packet"],
      ["Binding status", packet?.BindingSummary || "Packet stays reusable."],
      ["Target", run ? `${run.Title}${scene ? ` / ${scene.Title}` : ""}` : "Campaign-wide launch"],
      ["Search terms", Array.isArray(packet?.SearchTerms) && packet.SearchTerms.length > 0 ? packet.SearchTerms.slice(0, 4).join(", ") : "Packet metadata"]
    ];

    preview.hidden = false;
    preview.innerHTML = rows.map(([label, value]) => `
      <div class="settings-summary-row">
        <span>${label}</span>
        <strong>${value}</strong>
      </div>`).join("");
  };

  syncPrepLaunchTargets();
  document.getElementById("prepLaunchRun")?.addEventListener("change", syncPrepLaunchTargets);
  document.getElementById("prepLaunchPacket")?.addEventListener("change", syncPrepLaunchTargets);
  document.getElementById("prepLaunchScene")?.addEventListener("change", syncPrepLaunchTargets);

  const syncTravelPrefetchPreview = () => {
    const installationSelect = document.getElementById("travelPrefetchInstallation");
    const preview = document.getElementById("travelPrefetchPreview");
    if (!installationSelect || !preview) {
      return;
    }

    const device = Array.isArray(travelModeDevices)
      ? travelModeDevices.find((item) => item && item.InstallationId === installationSelect.value) || travelModeDevices[0]
      : null;
    const rows = [
      ["Device", device ? `${device.DeviceRole} · ${device.Platform} / ${device.HeadId} / ${device.Channel}` : "Select a claimed device"],
      ["Status", device?.Status ? ui.humanizeStatus(device.Status, "Review") : "Review"],
      ["Restore status", device?.Summary || "Travel data will be staged against the claimed device."],
      ["Prefetch inventory", travelPrefetchInventorySummary || "Prefetch inventory stays on the shared workspace."]
    ];

    preview.hidden = false;
    preview.innerHTML = rows.map(([label, value]) => `
      <div class="settings-summary-row">
        <span>${label}</span>
        <strong>${value}</strong>
      </div>`).join("");
  };

  syncTravelPrefetchPreview();
  document.getElementById("travelPrefetchInstallation")?.addEventListener("change", syncTravelPrefetchPreview);

  const defaultAftermathTitle = () => {
    const runSelect = document.getElementById("aftermathPackageRun");
    const kindSelect = document.getElementById("aftermathPackageKind");
    const run = Array.isArray(aftermathPackageRuns)
      ? aftermathPackageRuns.find((item) => item && item.RunId === runSelect?.value) || aftermathPackageRuns[0]
      : null;
    const scopeLabel = run?.Title || "Campaign";
    switch (kindSelect?.value) {
      case "replay_timeline":
        return `${scopeLabel} replay timeline`;
      case "after_action_report":
        return `${scopeLabel} after-action report`;
      case "downtime_brief":
        return `${scopeLabel} downtime brief`;
      case "runboard_state":
        return `${scopeLabel} runboard state`;
      case "resolution_report_draft":
        return `${scopeLabel} ResolutionReport draft`;
      default:
        return `${scopeLabel} session recap`;
    }
  };

  const defaultAftermathPackagePosture = (run, packageKind) => {
    const scopeLabel = run?.Title || "Campaign return";
    switch (packageKind) {
      case "replay_timeline":
        return `${scopeLabel} keeps contested-turn review in the same replay timeline.`;
      case "after_action_report":
        return `${scopeLabel} keeps after-action review and consequence continuity on the shared return path.`;
      case "downtime_brief":
        return `${scopeLabel} keeps downtime obligations and next-session readiness grounded on the shared return path.`;
      case "runboard_state":
        return `${scopeLabel} keeps the GM runboard and turn review in the same place.`;
      case "resolution_report_draft":
        return `${scopeLabel} keeps the ResolutionReport draft continuous without turning hub into the engine-math owner.`;
      default:
        return `${scopeLabel} keeps recap and next-session return on the same packet.`;
    }
  };

  const syncAftermathPackagePreview = () => {
    const runSelect = document.getElementById("aftermathPackageRun");
    const kindSelect = document.getElementById("aftermathPackageKind");
    const titleInput = document.getElementById("aftermathPackageTitle");
    const preview = document.getElementById("aftermathPackagePreview");
    if (!kindSelect || !titleInput || !preview) {
      return;
    }

    const run = Array.isArray(aftermathPackageRuns)
      ? aftermathPackageRuns.find((item) => item && item.RunId === runSelect?.value) || aftermathPackageRuns[0]
      : null;
    if (!titleInput.value.trim()) {
      titleInput.value = defaultAftermathTitle();
    }

    const rows = [
      ["Run scope", run ? `${run.Title} · ${ui.humanizeStatus(run.Status, "Active")}` : "Campaign-wide aftermath"],
      ["Package kind", ui.humanizeStatus(kindSelect.value.replaceAll("_", " "), "Aftermath package")],
      ["Package title", titleInput.value.trim() || defaultAftermathTitle()],
      ["Package status", defaultAftermathPackagePosture(run, kindSelect.value)]
    ];

    preview.hidden = false;
    preview.innerHTML = rows.map(([label, value]) => `
      <div class="settings-summary-row">
        <span>${label}</span>

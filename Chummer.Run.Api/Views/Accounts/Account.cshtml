                        </article>
                    </div>
                </section>
            </details>
        </section>
    }
    else
    {
        <section class="account-rail-snapshot" aria-label="Account continuity">
            <div class="account-rail-snapshot__lead">
                <p class="eyebrow">Account return</p>
                <h2>@accountRailHeadline</h2>
                <p>@accountRailSummary</p>
                <div class="stacked-actions">
                    <a class="button-like button-like--primary" href="@installRailPrimaryHref">@installRailPrimaryLabel</a>
                    <a class="button-like button-like--secondary" href="/account/access">Open Devices &amp; access</a>
                    <a class="button-like button-like--ghost" href="@installRailSecondaryHref">@installRailSecondaryLabel</a>
                </div>
            </div>
            <div class="account-rail-snapshot__panel">
                <article class="account-rail-snapshot__fact">
                    <span>Primary sign-in</span>
                    <strong>@HumanizeStatus(Model.Links.RecommendedPrimaryAuth, "Choose one")</strong>
                    <p>@(emailLink is null ? "Add an email recovery path if you want a calmer return path later." : "Recovery identity is attached and ready when the install or browser callback needs it.")</p>
                </article>
                <article class="account-rail-snapshot__fact">
                    <span>Linked install path</span>
                    <strong>@accountRailInstallSummary</strong>
                    <p>The download stays the same for everyone; the account-aware piece is account return, claim history, and support history.</p>
                </article>
                <article class="account-rail-snapshot__fact">
                    <span>Support and release</span>
                    <strong>@accountRailSupportSummary</strong>
                            <p>@TrustRowValue(Model.SignedInTrustStatus, "Current caution", "Open what works today for the latest notes.")</p>
                </article>
                <article class="account-rail-snapshot__fact">
                    <span>Recovery reserve</span>
                    <strong>@accountRailRecoverySummary</strong>
                    <p>Devices &amp; access exists for relink, reclaim, and recovery after the installer or app does the real work.</p>
                </article>
            </div>
        </section>
    }


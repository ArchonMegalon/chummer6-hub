                                {
                                    <li>
                                        <strong>@HumanizeStatus(receipt.Severity, "Warning"):</strong>
                                        @PublicText(receipt.Summary)
                                        <span>Updated: @receipt.ObservedAtUtc.UtcDateTime.ToString("u")</span>
                                        <span>Conflict status: @HumanizeStatus(receipt.ConflictPosture, "Reviewable conflict")</span>
                                        <span>Recovery: @HumanizeStatus(receipt.RecoverabilityPosture, "Recoverable by account access")</span>

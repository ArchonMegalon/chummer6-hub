                                        </div>
                                        <a class="inline-link" href="/help">Open help and trust</a>
                                    </article>
                                    <article class="app-rail__item">
                                        <span class="tag">Support closure</span>
                                        <div class="app-rail__copy">
                                            <h3>@(openSupportCases == 0 ? "Quiet support posture" : "Tracked support follow-through")</h3>
                                            <p>@(openSupportCases == 0 ? "No tracked support case is blocking organizer guidance right now, so members can stay on the public release and help routes." : $"{openSupportCases} tracked support case(s) are still visible on this account if member guidance needs a real closure reference.")</p>
                                        </div>
                                        <a class="inline-link" href="/account/support">Open support closure</a>
                                    </article>
                                </div>
                            </details>
                            @if (op.Capabilities.Count > 0)
                            {
                                <details class="details-drawer">
                                    <summary>Permissions</summary>
                                    <ul class="muted-copy">
                                        @foreach (var capability in op.Capabilities)
                                        {
                                            <li>@capability</li>
                                        }
                                    </ul>
                                </details>
                            }
                            @if (op.CampaignNames.Count > 0)
                            {
                                <details class="details-drawer">
                                    <summary>Visible campaigns</summary>
                                    <ul class="muted-copy">
                                        @foreach (var name in op.CampaignNames)
                                        {
                                            <li>@name</li>
                                        }
                                    </ul>
                                </details>
                            }
                            @if (op.RecentRosterTransfers is { Count: > 0 })
                            {
                                <details class="details-drawer">
                                    <summary>Recent governed roster moves</summary>
                                    <ul class="muted-copy">
                                        @foreach (var transfer in op.RecentRosterTransfers)
                                        {
                                            <li>
                                                <strong>@transfer.RunnerHandle:</strong> @transfer.Summary
                                                <span> @transfer.TransferredAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</span>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                        </details>
                    }
                    <p class="muted-copy">Recognition, badges, and sponsor motion stay secondary to campaign ownership, permissions, and real support closure.</p>
                }
            </section>
            </details>
            }

            @if (showSettingsSection)
            {
            <details class="details-drawer">
                <summary>Privacy</summary>
                <section id="privacy" class="settings-section" data-account-panel>
                    <div class="settings-section__header">
                        <h2>Privacy</h2>
                        <p>Choose what stays visible while deeper identifiers remain tucked away.</p>
                    </div>
                    <div class="settings-summary-list">
                        <div class="settings-summary-row">
                            <span>Visibility</span>
                            <strong>@HumanizeStatus(Model.User.Visibility, "Private")</strong>
                        </div>
                        <div class="settings-summary-row">
                            <span>Recovery posture</span>
                            <strong>@HumanizeStatus(Model.Links.RecoveryPosture, "Single method")</strong>
                        </div>
                    </div>
                    @if (Model.PrivacyBoundary is not null)
                    {
                        @await Html.PartialAsync("~/Views/Shared/_PrivacyBoundaryPanel.cshtml", Model.PrivacyBoundary)
                    }
                </section>
            </details>
            }

            @if (showSettingsSection && showParticipationSection)
            {
            <details class="details-drawer">
            <summary>Participation</summary>
            <section id="participation" class="settings-section" data-account-panel>
                <div class="settings-section__header">
                    <h2>Participation</h2>
                    <p>Tell Chummer which lanes matter to you and which updates you actually want to hear about.</p>
                </div>
                <form id="experienceForm" class="settings-form">
                    <div class="check-grid">
                        <label class="check-row"><input type="checkbox" value="player" @(laneInterests.Contains("player") ? "checked" : null) /> <span>Player</span></label>
                        <label class="check-row"><input type="checkbox" value="gm" @(laneInterests.Contains("gm") ? "checked" : null) /> <span>GM</span></label>
                        <label class="check-row"><input type="checkbox" value="creator" @(laneInterests.Contains("creator") ? "checked" : null) /> <span>Creator</span></label>
                        <label class="check-row"><input id="followHorizons" type="checkbox" @(Model.Experience.FollowHorizons ? "checked" : null) /> <span>Follow roadmap updates</span></label>
                        <label class="check-row"><input id="betaInterest" type="checkbox" @(Model.Experience.BetaInterest ? "checked" : null) /> <span>Invite me when the right beta opens</span></label>
                    </div>
                    <button class="button-like button-like--primary" type="submit">Save participation settings</button>
                    <p id="experienceStatusNotice" class="muted-copy" hidden></p>
                </form>
            </section>
            </details>
            }

            @if (showSettingsSection)
            {
            <details class="details-drawer">
                <summary>Help and policy</summary>
                <section class="settings-section" data-account-panel id="help-policy">
                    <div class="settings-section__header">
                        <h2>Help and policy</h2>
                        <p>When you need support, privacy, or preview-use guidance, use the first-party pages instead of guessing.</p>
                    </div>
                    <div class="stacked-actions">
                        <a class="button-like button-like--secondary" href="/help">Open help</a>
                        <a class="button-like button-like--ghost" href="/privacy">Read privacy</a>
                        <a class="button-like button-like--ghost" href="/terms">Read terms</a>
                        <a class="button-like button-like--ghost" href="/contact">Contact Chummer</a>
                    </div>
                </section>
            </details>
            }
            </details>
            }
        </div>
    </div>

    @if (showAdvancedSection)
    {
    <details class="details-drawer" open>
        <summary>Advanced account details</summary>
        <dl class="detail-grid detail-grid--account">
            <div>
                <dt>Hub account id</dt>
                <dd class="mono-receipt">@Model.User.UserId</dd>
            </div>
            <div>
                <dt>Primary auth</dt>
                <dd>@HumanizeStatus(Model.Links.RecommendedPrimaryAuth, "Choose one")</dd>
            </div>
            <div>
                <dt>Linked identities</dt>
                <dd>@Model.Links.LinkedIdentities.Count</dd>
            </div>
            <div>
                <dt>Linked channels</dt>
                <dd>@Model.Links.ChannelLinks.Count</dd>
            </div>
            <div>
                <dt>Recovery posture</dt>
                <dd>@Model.Links.RecoveryPosture</dd>
            </div>
            <div>
                <dt>Follow horizons</dt>
                <dd>@(Model.Experience.FollowHorizons ? "Yes" : "No")</dd>
            </div>
        </dl>
    </details>
    }
</section>

@section Scripts {
<script>
(() => {
  const ui = window.ChummerUi;
  const subjectId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.User.SubjectId));
  const rosterTransferPlan = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedWorkspaceRosterTransferPlan));
  const prepLaunchPackets = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedWorkspaceServerPlane?.PrepLibrary.Packets ?? Array.Empty<Chummer.Run.Api.Contracts.GovernedPrepPacketSummary>()));
  const prepLaunchRuns = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedWorkspace?.Runs ?? Array.Empty<Chummer.Campaign.Contracts.RunProjection>()));
  const aftermathPackageRuns = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedWorkspace?.Runs ?? Array.Empty<Chummer.Campaign.Contracts.RunProjection>()));
  const travelModeDevices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedWorkspaceServerPlane?.TravelMode.Devices ?? Array.Empty<Chummer.Run.Api.Contracts.TravelModeDeviceReadinessCue>()));
  const travelPrefetchInventorySummary = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedWorkspaceServerPlane?.TravelMode.PrefetchInventorySummary));
  const selectedWorkspaceId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedWorkspace?.WorkspaceId));
  const workspaceDetailHref = (workspaceId) => `/account/work/workspaces/${encodeURIComponent(workspaceId)}`;
  const revealHashTarget = () => {
    const hash = window.location.hash;
    if (!hash) return;
    const target = document.querySelector(hash);
    if (!target) return;
    let node = target.parentElement;
    while (node) {
      if (node.tagName === "DETAILS") {
        node.open = true;
      }
      node = node.parentElement;
    }
  };

  revealHashTarget();
  window.addEventListener("hashchange", revealHashTarget);
  document.querySelectorAll("[data-account-tab]").forEach((link) => {
    link.addEventListener("click", () => window.setTimeout(revealHashTarget, 0));
  });

  const bindSubmit = (formId, handler) => {
    const form = document.getElementById(formId);
    if (!form) {
      return;
    }

    form.addEventListener("submit", handler);
  };

  const syncRosterTransferInputs = () => {
    const dossierSelect = document.getElementById("rosterTransferDossier");
    const groupSelect = document.getElementById("rosterTransferGroup");
    const ownerSelect = document.getElementById("rosterTransferOwner");
    const campaignInput = document.getElementById("rosterTransferCampaignTitle");
    if (!dossierSelect || !groupSelect || !ownerSelect || !campaignInput) {
      return;
    }

    const dossiers = Array.isArray(rosterTransferPlan?.DossierOptions) ? rosterTransferPlan.DossierOptions : [];
    const targetGroups = Array.isArray(rosterTransferPlan?.TargetGroups) ? rosterTransferPlan.TargetGroups : [];
    const selectedDossier = dossiers.find((item) => item.DossierId === dossierSelect.value) || dossiers[0];
    const selectedGroup = targetGroups.find((item) => item.GroupId === groupSelect.value) || targetGroups[0];
    ownerSelect.innerHTML = "";

    const keepOwnerOption = document.createElement("option");
    keepOwnerOption.value = "";
    keepOwnerOption.textContent = selectedDossier?.CurrentOwnerDisplayName
      ? `Keep current owner (${selectedDossier.CurrentOwnerDisplayName})`
      : "Keep current owner";
    ownerSelect.appendChild(keepOwnerOption);

    const ownerOptions = Array.isArray(selectedGroup?.OwnerOptions) ? selectedGroup.OwnerOptions : [];
    ownerOptions
      .filter((item) => item.UserId !== selectedDossier?.CurrentOwnerUserId)
      .forEach((item) => {
        const option = document.createElement("option");
        option.value = item.UserId;
        option.textContent = `${item.DisplayName} (${ui.humanizeStatus(item.Role, "member")})`;
        ownerSelect.appendChild(option);
      });

    campaignInput.placeholder = selectedGroup?.SuggestedCampaignTitle || "Use the target group's active campaign or create a transfer campaign";
  };

  syncRosterTransferInputs();
  document.getElementById("rosterTransferDossier")?.addEventListener("change", syncRosterTransferInputs);
  document.getElementById("rosterTransferGroup")?.addEventListener("change", syncRosterTransferInputs);

  const syncPrepLaunchTargets = () => {
    const runSelect = document.getElementById("prepLaunchRun");
    const sceneSelect = document.getElementById("prepLaunchScene");
    const packetSelect = document.getElementById("prepLaunchPacket");
    const preview = document.getElementById("prepLaunchTargetPreview");
    if (!packetSelect || !preview) {
      return;
    }

    const packet = Array.isArray(prepLaunchPackets)
      ? prepLaunchPackets.find((item) => item && item.PacketId === packetSelect.value)
      : null;
    const run = runSelect && Array.isArray(prepLaunchRuns)
      ? prepLaunchRuns.find((item) => item && item.RunId === runSelect.value) || prepLaunchRuns[0]
      : null;
    const scenes = Array.isArray(run?.Scenes) ? run.Scenes : [];

    if (sceneSelect) {
      const previousSceneId = sceneSelect.value;
      sceneSelect.innerHTML = "";
      for (const scene of scenes) {
        const option = document.createElement("option");
        option.value = scene.SceneId;
        option.textContent = scene.Title;
        sceneSelect.appendChild(option);
      }

      const preferredScene = scenes.find((item) => item.SceneId === (run?.ActiveSceneId || previousSceneId)) || scenes[0];
      if (preferredScene) {
        sceneSelect.value = preferredScene.SceneId;
      }
    }

    const scene = sceneSelect && scenes.length > 0
      ? scenes.find((item) => item.SceneId === sceneSelect.value) || scenes[0]
      : null;
    const rows = [
      ["Packet", packet?.Title || "Select a governed packet"],
      ["Binding posture", packet?.BindingSummary || "Packet stays governed and reusable."],
      ["Target", run ? `${run.Title}${scene ? ` / ${scene.Title}` : ""}` : "Campaign-wide launch"],
      ["Search terms", Array.isArray(packet?.SearchTerms) && packet.SearchTerms.length > 0 ? packet.SearchTerms.slice(0, 4).join(", ") : "Governed packet metadata"]
    ];

    preview.hidden = false;
    preview.innerHTML = rows.map(([label, value]) => `
      <div class="settings-summary-row">
        <span>${label}</span>
        <strong>${value}</strong>
      </div>`).join("");
  };

  syncPrepLaunchTargets();
  document.getElementById("prepLaunchRun")?.addEventListener("change", syncPrepLaunchTargets);
  document.getElementById("prepLaunchPacket")?.addEventListener("change", syncPrepLaunchTargets);
  document.getElementById("prepLaunchScene")?.addEventListener("change", syncPrepLaunchTargets);

  const syncTravelPrefetchPreview = () => {
    const installationSelect = document.getElementById("travelPrefetchInstallation");
    const preview = document.getElementById("travelPrefetchPreview");
    if (!installationSelect || !preview) {
      return;
    }

    const device = Array.isArray(travelModeDevices)
      ? travelModeDevices.find((item) => item && item.InstallationId === installationSelect.value) || travelModeDevices[0]
      : null;
    const rows = [
      ["Device", device ? `${device.DeviceRole} · ${device.Platform} / ${device.HeadId} / ${device.Channel}` : "Select a claimed device"],
      ["Status", device?.Status ? ui.humanizeStatus(device.Status, "Review") : "Review"],
      ["Restore posture", device?.Summary || "Travel posture will be staged against the claimed device."],
      ["Prefetch inventory", travelPrefetchInventorySummary || "Prefetch inventory stays governed on the shared workspace."]
    ];

    preview.hidden = false;
    preview.innerHTML = rows.map(([label, value]) => `
      <div class="settings-summary-row">
        <span>${label}</span>
        <strong>${value}</strong>
      </div>`).join("");
  };

  syncTravelPrefetchPreview();
  document.getElementById("travelPrefetchInstallation")?.addEventListener("change", syncTravelPrefetchPreview);

  const defaultAftermathTitle = () => {
    const runSelect = document.getElementById("aftermathPackageRun");
    const kindSelect = document.getElementById("aftermathPackageKind");
    const run = Array.isArray(aftermathPackageRuns)
      ? aftermathPackageRuns.find((item) => item && item.RunId === runSelect?.value) || aftermathPackageRuns[0]
      : null;
    const scopeLabel = run?.Title || "Campaign";
    switch (kindSelect?.value) {
      case "after_action_report":
        return `${scopeLabel} after-action report`;
      case "downtime_brief":
        return `${scopeLabel} downtime brief`;
      default:
        return `${scopeLabel} session recap`;
    }
  };

  const syncAftermathPackagePreview = () => {
    const runSelect = document.getElementById("aftermathPackageRun");
    const kindSelect = document.getElementById("aftermathPackageKind");
    const titleInput = document.getElementById("aftermathPackageTitle");
    const preview = document.getElementById("aftermathPackagePreview");
    if (!kindSelect || !titleInput || !preview) {
      return;
    }

    const run = Array.isArray(aftermathPackageRuns)
      ? aftermathPackageRuns.find((item) => item && item.RunId === runSelect?.value) || aftermathPackageRuns[0]
      : null;
    if (!titleInput.value.trim()) {
      titleInput.value = defaultAftermathTitle();
    }

    const rows = [
      ["Run scope", run ? `${run.Title} · ${ui.humanizeStatus(run.Status, "Active")}` : "Campaign-wide aftermath"],
      ["Package kind", ui.humanizeStatus(kindSelect.value.replaceAll("_", " "), "Session recap")],
      ["Package title", titleInput.value.trim() || defaultAftermathTitle()],
      ["Return posture", run?.Summary || "Pins the next-session return lane to a governed recap package."]
    ];

    preview.hidden = false;
    preview.innerHTML = rows.map(([label, value]) => `
      <div class="settings-summary-row">
        <span>${label}</span>
        <strong>${value}</strong>
      </div>`).join("");
  };

  syncAftermathPackagePreview();
  document.getElementById("aftermathPackageRun")?.addEventListener("change", syncAftermathPackagePreview);
  document.getElementById("aftermathPackageKind")?.addEventListener("change", () => {
    const titleInput = document.getElementById("aftermathPackageTitle");
    if (titleInput && !titleInput.value.trim()) {
      titleInput.value = defaultAftermathTitle();
    }
    syncAftermathPackagePreview();
  });
  document.getElementById("aftermathPackageTitle")?.addEventListener("input", syncAftermathPackagePreview);

  const formatUtcLabel = (value, fallback = "Not scheduled") => {
    if (!value) {
      return fallback;
    }

    const parsed = new Date(value);
    return Number.isNaN(parsed.getTime())
      ? value
      : `${parsed.toISOString().slice(0, 16).replace("T", " ")} UTC`;
  };

  document.querySelectorAll("[data-join-code-form]").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const notice = form.querySelector("[data-join-code-notice]");
      const result = form.querySelector("[data-join-code-result]");
      const button = form.querySelector("button[type='submit']");
      const role = form.querySelector("select[name='role']");
      const ttl = form.querySelector("select[name='ttl']");
      const groupId = form.dataset.groupId;
      if (!groupId || !role || !ttl) {
        return;
      }

      ui.clearNotice(notice);
      if (result) {
        result.hidden = true;
        result.innerHTML = "";
      }
      ui.setButtonBusy(button, true, "Issuing...");
      try {
        const payload = await ui.requestJson(`/api/v1/groups/${encodeURIComponent(groupId)}/join-codes`, {
          method: "POST",
          json: {
            subjectId,
            role: role.value,
            ttl: ttl.value || null
          }
        });
        if (result) {
          result.hidden = false;
          result.innerHTML = `
            <div class="settings-summary-row"><span>Join code</span><strong>${payload.code || ""}</strong></div>
            <div class="settings-summary-row"><span>Role</span><strong>${ui.humanizeStatus(payload.role, "Member")}</strong></div>
            <div class="settings-summary-row"><span>Expires</span><strong>${formatUtcLabel(payload.expiresAtUtc, "No expiry")}</strong></div>`;
        }
        ui.setNotice(notice, "Governed join code issued. Resend the member-guidance rail with it.");
      } catch (error) {
        ui.setNotice(notice, ui.describeError(error, "Join code could not be issued right now."), true);
      } finally {
        ui.setButtonBusy(button, false, "Issuing...");
      }
    });
  });

  document.querySelectorAll("[data-boost-code-form]").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const notice = form.querySelector("[data-boost-code-notice]");
      const result = form.querySelector("[data-boost-code-result]");
      const button = form.querySelector("button[type='submit']");
      const campaign = form.querySelector("select[name='campaignId']");
      const label = form.querySelector("input[name='label']");
      const groupId = form.dataset.groupId;
      if (!groupId || !label) {
        return;
      }

      ui.clearNotice(notice);
      if (result) {
        result.hidden = true;
        result.innerHTML = "";
      }
      ui.setButtonBusy(button, true, "Issuing...");
      try {
        const payload = await ui.requestJson("/api/v1/boost-codes", {
          method: "POST",
          json: {
            subjectId,
            groupId,
            campaignId: campaign?.value || null,
            label: label.value.trim() || "community_operator"
          }
        });
        const selectedCampaign = campaign?.options?.[campaign.selectedIndex]?.textContent?.trim() || payload.campaignId || "Governed lane";
        if (result) {
          result.hidden = false;
          result.innerHTML = `
            <div class="settings-summary-row"><span>Boost code</span><strong>${payload.code || ""}</strong></div>
            <div class="settings-summary-row"><span>Campaign lane</span><strong>${selectedCampaign}</strong></div>
            <div class="settings-summary-row"><span>Status</span><strong>${ui.humanizeStatus(payload.status, "Active")}</strong></div>`;
        }
        ui.setNotice(notice, "Governed boost code issued. Keep sponsorship on this same operator rail.");
      } catch (error) {
        ui.setNotice(notice, ui.describeError(error, "Boost code could not be issued right now."), true);
      } finally {
        ui.setButtonBusy(button, false, "Issuing...");
      }
    });
  });

  bindSubmit("profileForm", async (event) => {
    event.preventDefault();
    const notice = document.getElementById("profileStatusNotice");
    const button = event.currentTarget.querySelector("button[type='submit']");
    ui.clearNotice(notice);
    ui.setButtonBusy(button, true, "Saving...");
    try {
      const profile = await ui.requestJson("/api/v1/accounts/me/profile", {
        method: "POST",
        json: {
        subjectId,
        displayName: document.getElementById("displayName").value,
        handle: document.getElementById("handle").value,
        timezone: document.getElementById("timezone").value,
        visibility: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.User.Visibility))
        }
      });
      document.getElementById("displayName").value = profile.displayName || "";
      document.getElementById("handle").value = profile.handle || "";
      document.getElementById("timezone").value = profile.timezone || "";
      ui.setNotice(notice, "Profile saved.");
    } catch (error) {
      ui.setNotice(notice, ui.describeError(error, "Profile could not be saved right now."), true);
    } finally {
      ui.setButtonBusy(button, false, "Saving...");
    }
  });

  bindSubmit("recoveryForm", async (event) => {
    event.preventDefault();
    const notice = document.getElementById("recoveryStatusNotice");
    const button = event.currentTarget.querySelector("button[type='submit']");
    ui.clearNotice(notice);
    ui.setButtonBusy(button, true, "Starting...");
    try {
      const data = await ui.requestJson("/api/v1/accounts/me/links/email/start", {
        method: "POST",
        json: {
        subjectId,
        email: document.getElementById("recoveryEmail").value,
        nextPath: "/account"
        }
      });
      document.getElementById("recoveryEmailStatus").textContent = ui.humanizeStatus(data.linkStatus, "Verification sent");
      ui.setNotice(notice, data.previewNote || "Check your email to finish verifying the recovery address.");
      if (data.previewHref) {
        window.location.href = data.previewHref;
      }
    } catch (error) {
      ui.setNotice(notice, ui.describeError(error, "Recovery email could not be started right now."), true);
    } finally {
      ui.setButtonBusy(button, false, "Starting...");
    }
  });

  bindSubmit("telegramForm", async (event) => {
    event.preventDefault();
    const notice = document.getElementById("telegramStatusNotice");
    const button = event.currentTarget.querySelector("button[type='submit']");
    ui.clearNotice(notice);
    ui.setButtonBusy(button, true, "Saving...");
    try {
      await ui.requestJson("/api/v1/accounts/me/channels", {
        method: "POST",
        json: {
        subjectId,
        channelKind: "telegram_official_bot",
        channelHandle: document.getElementById("telegramHandle").value,
        notificationsEnabled: true
        }
      });
      ui.setNotice(notice, "Telegram companion settings saved.");
    } catch (error) {
      ui.setNotice(notice, ui.describeError(error, "Telegram companion settings could not be saved."), true);
    } finally {
      ui.setButtonBusy(button, false, "Saving...");
    }
  });

  bindSubmit("experienceForm", async (event) => {
    event.preventDefault();
    const notice = document.getElementById("experienceStatusNotice");
    const laneInterests = Array.from(document.querySelectorAll("#experienceForm input[type='checkbox'][value]:checked")).map((input) => input.value);
    const button = event.currentTarget.querySelector("button[type='submit']");
    ui.clearNotice(notice);
    ui.setButtonBusy(button, true, "Saving...");
    try {
      await ui.requestJson("/api/v1/accounts/me/preferences", {
        method: "POST",
        json: {
        subjectId,
        laneInterests,
        followHorizons: document.getElementById("followHorizons").checked,
        betaInterest: document.getElementById("betaInterest").checked,
        onboardingCompleted: true
        }
      });
      const participationOverview = document.getElementById("participationOverviewState");
      if (participationOverview) {
        participationOverview.textContent = "Configured";
      }
      ui.setNotice(notice, "Participation settings saved.");
    } catch (error) {
      ui.setNotice(notice, ui.describeError(error, "Participation settings could not be saved."), true);
    } finally {
      ui.setButtonBusy(button, false, "Saving...");
    }
  });

  bindSubmit("rosterTransferForm", async (event) => {
    event.preventDefault();
    const notice = document.getElementById("rosterTransferStatusNotice");
    const button = event.currentTarget.querySelector("button[type='submit']");
    const dossierSelect = document.getElementById("rosterTransferDossier");
    const groupSelect = document.getElementById("rosterTransferGroup");
    const ownerSelect = document.getElementById("rosterTransferOwner");
    const campaignTitleInput = document.getElementById("rosterTransferCampaignTitle");
    const noteInput = document.getElementById("rosterTransferNote");
    if (!dossierSelect || !groupSelect || !ownerSelect || !campaignTitleInput || !noteInput) {
      return;
    }

    ui.clearNotice(notice);
    ui.setButtonBusy(button, true, "Moving...");
    try {
      await ui.requestJson("/api/v1/campaign-spine/me/roster-transfers", {
        method: "POST",
        json: {
          dossierId: dossierSelect.value,
          targetGroupId: groupSelect.value,
          targetCampaignTitle: campaignTitleInput.value.trim() || null,
          targetOwnerUserId: ownerSelect.value || null,
          note: noteInput.value.trim() || null
        }
      });
      window.location.href = "/account/work#community-ops";
    } catch (error) {
      ui.setNotice(notice, ui.describeError(error, "Roster transfer could not be recorded right now."), true);
    } finally {
      ui.setButtonBusy(button, false, "Moving...");
    }
  });

  bindSubmit("prepLaunchForm", async (event) => {
    event.preventDefault();
    const notice = document.getElementById("prepLaunchStatusNotice");
    const button = event.currentTarget.querySelector("button[type='submit']");
    const packetSelect = document.getElementById("prepLaunchPacket");
    const runSelect = document.getElementById("prepLaunchRun");
    const sceneSelect = document.getElementById("prepLaunchScene");
    const noteInput = document.getElementById("prepLaunchNote");
    if (!packetSelect || !selectedWorkspaceId) {
      return;
    }

    ui.clearNotice(notice);
    ui.setButtonBusy(button, true, "Launching...");
    try {
      await ui.requestJson(`/api/v1/campaign-spine/me/workspaces/${encodeURIComponent(selectedWorkspaceId)}/prep-library/launches`, {
        method: "POST",
        json: {
          packetId: packetSelect.value,
          targetRunId: runSelect?.value || null,
          targetSceneId: sceneSelect?.value || null,
          note: noteInput?.value.trim() || null
        }
      });
      window.location.href = `${workspaceDetailHref(selectedWorkspaceId)}#prep-launches`;
    } catch (error) {
      ui.setNotice(notice, ui.describeError(error, "Governed prep launch could not be recorded right now."), true);
    } finally {
      ui.setButtonBusy(button, false, "Launching...");
    }
  });

  bindSubmit("travelPrefetchForm", async (event) => {

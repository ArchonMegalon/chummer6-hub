                                    <span>Draft state</span>
                                    <strong>@HumanizeStatus(selectedCreatorPublicationDraftDetail.Draft.State, "Draft")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Draft kind</span>
                                    <strong>@HumanizeStatus(selectedCreatorPublicationDraftDetail.Draft.ProjectKind, "Publication packet")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Review state</span>
                                    <strong>@HumanizeStatus(selectedCreatorPublicationReceipt?.ReviewState, "Not required")</strong>
                                </div>
                                @if (selectedCreatorPublicationDraftDetail.Moderation is not null)
                                {
                                    <div class="settings-summary-row">
                                        <span>Moderation case</span>
                                        <strong>@selectedCreatorPublicationDraftDetail.Moderation.CaseId</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>Moderation status</span>
                                        <strong>@HumanizeStatus(selectedCreatorPublicationDraftDetail.Moderation.State, "Pending review")</strong>
                                    </div>
                                }
                                @if (selectedCreatorPublicationReceipt is not null)
                                {
                                    <div class="settings-summary-row">
                                        <span>Registry status</span>
                                        <strong>@HumanizeStatus(selectedCreatorPublicationReceipt.PublicationStatus, "Draft")</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>Visibility</span>
                                        <strong>@HumanizeStatus(selectedCreatorPublicationReceipt.Visibility, "Campaign-shared")</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>File detail</span>
                                        <strong>@selectedCreatorPublicationReceipt.Artifact.Kind · @selectedCreatorPublicationReceipt.Artifact.ArtifactId · @selectedCreatorPublicationReceipt.Artifact.Version</strong>
                                    </div>
                                    @if (selectedCreatorPublicationReceipt.PublishedAtUtc is not null)
                                    {
                                        <div class="settings-summary-row">
                                            <span>Published</span>
                                            <strong>@selectedCreatorPublicationReceipt.PublishedAtUtc.Value.ToString("yyyy-MM-dd HH:mm 'UTC'")</strong>
                                        </div>
                                    }
                                }
                                @if (!string.IsNullOrWhiteSpace(selectedCreatorPublicationDraftDetail.LatestModerationNotes))
                                {
                                    <div class="settings-summary-row">
                                        <span>Latest moderation note</span>
                                        <strong>@selectedCreatorPublicationDraftDetail.LatestModerationNotes</strong>
                                    </div>
                                }
                            </div>
                            <details class="details-drawer">
                                <summary>Decision history</summary>
                                <ul class="muted-copy">
                                    <li>
                                        <strong>Draft state:</strong> @HumanizeStatus(selectedCreatorPublicationDraftDetail.Draft.State, "Draft")
                                        <span> · @PublicationDecisionOutcomeSummary(selectedCreatorPublicationReceipt?.PublicationStatus, selectedCreatorPublicationReceipt?.ReviewState, selectedCreatorPublicationDraftDetail.Moderation?.State)</span>
                                    </li>
                                    @if (selectedCreatorPublicationDraftDetail.Moderation is not null)
                                    {
                                        <li>
                                            <strong>Moderation case @selectedCreatorPublicationDraftDetail.Moderation.CaseId:</strong> @HumanizeStatus(selectedCreatorPublicationDraftDetail.Moderation.State, "Pending review")
                                        </li>
                                    }
                                    @if (selectedCreatorPublicationReceipt is not null)
                                    {
                                        <li>
                                            <strong>Registry review:</strong> @HumanizeStatus(selectedCreatorPublicationReceipt.ReviewState, "Not required")
                                        </li>
                                        <li>
                                            <strong>Publication status:</strong> @HumanizeStatus(selectedCreatorPublicationReceipt.PublicationStatus, "Draft")
                                            @if (selectedCreatorPublicationReceipt.PublishedAtUtc is not null)
                                            {
                                                <span> · published @FormatUtc(selectedCreatorPublicationReceipt.PublishedAtUtc.Value)</span>
                                            }
                                            else
                                            {
                                                <span> · last updated @FormatUtc(selectedCreatorPublication.UpdatedAtUtc)</span>
                                            }
                                        </li>
                                    }
                                    <li>
                                        <strong>Resumability:</strong> @PublicationResumabilitySummary(selectedCreatorPublicationReceipt?.PublicationStatus, selectedCreatorPublicationReceipt?.ReviewState, selectedCreatorPublicationDraftDetail.Moderation?.State)
                                    </li>
                                </ul>
                            </details>
                            @if (!string.Equals(selectedCreatorPublicationReceipt?.ReviewState, Chummer.Hub.Registry.Contracts.HubReviewStates.PendingReview, StringComparison.OrdinalIgnoreCase)
                                && !string.Equals(selectedCreatorPublicationReceipt?.ReviewState, Chummer.Hub.Registry.Contracts.HubReviewStates.Approved, StringComparison.OrdinalIgnoreCase)
                                && !string.Equals(selectedCreatorPublicationDraftDetail.Draft.State, Chummer.Hub.Registry.Contracts.HubPublicationStates.Archived, StringComparison.OrdinalIgnoreCase))
                            {
                                var correctionResubmission = string.Equals(selectedCreatorPublicationReceipt?.ReviewState, Chummer.Hub.Registry.Contracts.HubReviewStates.Rejected, StringComparison.OrdinalIgnoreCase);
                                <form class="settings-form" method="post" action="/account/work/publications/@Uri.EscapeDataString(selectedCreatorPublication.PublicationId)/submit">
                                    @Html.AntiForgeryToken()
                                    <label for="creatorPublicationSubmitNotes">@(correctionResubmission ? "Correction notes" : "Submission notes")</label>
                                    <textarea id="creatorPublicationSubmitNotes" name="notes" rows="3" placeholder="@(correctionResubmission
                                        // .Replace( M115 source marker: State what changed so this corrected packet can re-enter governed moderation without losing provenance or lineage. )
                                        ? "State what changed so this corrected packet can be reviewed without losing its history."
                                        : "Explain why this publication is ready for review.")"></textarea>
                                    <div class="stacked-actions">
                                        <button class="button-like button-like--primary" type="submit">@(correctionResubmission ? "Resubmit corrected packet" : "Submit for review")</button>
                                    </div>
                                </form>
                            }
                            @if (selectedCreatorPublicationDraftDetail.Moderation is not null
                                && string.Equals(selectedCreatorPublicationDraftDetail.Moderation.State, Chummer.Hub.Registry.Contracts.HubModerationStates.PendingReview, StringComparison.OrdinalIgnoreCase))
                            {
                                <form class="settings-form" method="post" action="/account/work/publications/@Uri.EscapeDataString(selectedCreatorPublication.PublicationId)/approve">
                                    @Html.AntiForgeryToken()
                                    <label for="creatorPublicationApproveNotes">Approval notes</label>
                                    <textarea id="creatorPublicationApproveNotes" name="notes" rows="3" placeholder="Record the source history and reason this is safe to advance."></textarea>
                                    <div class="stacked-actions">
                                        <button class="button-like button-like--primary" type="submit">Approve review</button>
                                    </div>
                                </form>
                                <form class="settings-form" method="post" action="/account/work/publications/@Uri.EscapeDataString(selectedCreatorPublication.PublicationId)/reject">
                                    @Html.AntiForgeryToken()
                                    <label for="creatorPublicationRejectNotes">Revision notes</label>
                                    <textarea id="creatorPublicationRejectNotes" name="notes" rows="3" placeholder="State what needs to change before this draft returns to review."></textarea>
                                    <div class="stacked-actions">
                                        <button class="button-like button-like--secondary" type="submit">Request changes</button>
                                    </div>
                                </form>
                            }
                            @if (string.Equals(selectedCreatorPublicationReceipt?.ReviewState, Chummer.Hub.Registry.Contracts.HubReviewStates.Approved, StringComparison.OrdinalIgnoreCase)
                                && !string.Equals(selectedCreatorPublicationReceipt?.PublicationStatus, Chummer.Hub.Registry.Contracts.HubPublicationStates.Published, StringComparison.OrdinalIgnoreCase)
                                && !string.Equals(selectedCreatorPublicationDraftDetail.Draft.State, Chummer.Hub.Registry.Contracts.HubPublicationStates.Archived, StringComparison.OrdinalIgnoreCase))
                            {
                                <form class="settings-form" method="post" action="/account/work/publications/@Uri.EscapeDataString(selectedCreatorPublication.PublicationId)/publish">
                                    @Html.AntiForgeryToken()
                                    <label for="creatorPublicationPublishNotes">Publish notes</label>
                                    <textarea id="creatorPublicationPublishNotes" name="notes" rows="3" placeholder="State why this publication is ready for public discovery and shared continuity."></textarea>
                                    <div class="stacked-actions">
                                        <button class="button-like button-like--primary" type="submit">Publish publicly</button>
                                    </div>
                                </form>
                            }
                        }
                        @if (!string.IsNullOrWhiteSpace(selectedCreatorPublication.BuildHandoffId))
                        {
                            <a class="inline-link" href="@BuildHandoffDetailHref(selectedCreatorPublication.BuildHandoffId)">Open build path for @selectedCreatorPublication.Title</a>
                        }
                        @if (IsDiscoverablePublicCreatorPublication(selectedCreatorPublication))
                        {
                            <a class="inline-link" href="@PublicCreatorPublicationHref(selectedCreatorPublication.PublicationId)">@CreatorPublicationLinkLabel(selectedCreatorPublication)</a>
                        }
                    </article>
                }
                @if (Model.CampaignSpine.Workspaces.Count == 0)
                {
                    <p class="muted-copy">No campaign workspace yet. Use the starter path to seed the first playable session before you come back for deeper work continuity.</p>
                    <div class="stacked-actions">
                        <button id="seedStarterWorkspaceFromAccount" class="button-like button-like--primary" type="button">Start first playable session</button>
                        <a class="inline-link" href="/home/work">Open starter lane on Home</a>
                    </div>
                    <p id="starterWorkspaceAccountNotice" class="muted-copy" aria-live="polite"></p>
                }
                else
                {
                    @foreach (var workspace in Model.CampaignSpine.Workspaces)
                    {
                        <details class="details-drawer">
                            <summary>@workspace.CampaignName · Campaign workspace</summary>
                            <div class="settings-summary-list">
                                <div class="settings-summary-row">
                                    <span>Visibility</span>
                                    <strong>@HumanizeStatus(workspace.Visibility, "Private")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Rule environment</span>
                                    <strong>@RuleEnvironmentSummary(workspace.RuleEnvironment)</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Current return</span>
                                    <strong>@(workspace.LatestContinuity?.Summary ?? workspace.ReturnSummary)</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Live run state</span>
                                    <strong>@(workspace.Runs.Count == 0 ? "No active run" : $"{workspace.Runs.Count} tracked")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Active scene</span>
                                    <strong>@(workspace.ActiveSceneSummary ?? "No scene pinned yet")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>First playable session</span>
                                    <strong>@(workspace.FirstPlayableSession is null ? "Pending" : workspace.FirstPlayableSession.CampaignStartSummary)</strong>
                                </div>
                                @if (workspace.FirstPlayableSession is not null)
                                {
                                    <div class="settings-summary-row">
                                        <span>Legal runner</span>
                                        <strong>@workspace.FirstPlayableSession.RuleReadySummary</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>Understandable return</span>
                                        <strong>@PublicText(workspace.FirstPlayableSession.ReturnLaneSummary)</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>Campaign-ready status</span>
                                        <strong>@workspace.FirstPlayableSession.CampaignReadySummary</strong>
                                    </div>
                                }
                                <div class="settings-summary-row">
                                    <span>Next safe action</span>
                                    <strong>@(workspace.NextSafeAction ?? "Open the campaign workspace and confirm the current return path before you continue.")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Next-session carry-forward</span>
                                    <strong>@(workspace.NextSessionCarryForward is null ? "Pending" : workspace.NextSessionCarryForward.Summary)</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Campaign memory</span>
                                    <strong>@(workspace.CampaignMemory is null ? "Pending" : workspace.CampaignMemory.Summary)</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Recent recap</span>
                                    <strong>@(workspace.RecapShelf.Count == 0 ? "Pending" : $"{workspace.RecapShelf.Count} ready")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Consequence ledger</span>
                                    <strong>@(workspace.Consequences is { Count: > 0 } ? $"{workspace.Consequences.Count} tracked" : "Pending")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Roster transfer history</span>
                                    <strong>@(workspace.RosterTransfers is { Count: > 0 } ? $"{workspace.RosterTransfers.Count} move(s)" : "No recent moves")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Prep launch history</span>
                                    <strong>@(workspace.PrepLaunches is { Count: > 0 } ? $"{workspace.PrepLaunches.Count} launch(es)" : "No recent launches")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Travel prefetch history</span>
                                    <strong>@(workspace.TravelPrefetches is { Count: > 0 } ? $"{workspace.TravelPrefetches.Count} prefetch(es)" : "No recent prefetches")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Aftermath and replay history</span>
                                    <strong>@(workspace.AftermathPackages is { Count: > 0 } ? $"{workspace.AftermathPackages.Count} package(s)" : "No reviewed packages")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Downtime brief</span>
                                    <strong>@(workspace.AftermathPackages?.Any(item => string.Equals(item.PackageKind, "downtime_brief", StringComparison.OrdinalIgnoreCase)) == true ? "Ready" : "Pending")</strong>
                                </div>
                            </div>
                            <div class="stacked-actions">
                                <a class="button-like button-like--ghost" href="@WorkspaceDetailHref(workspace.WorkspaceId)">Open campaign workspace</a>
                                @if (workspace.Runs.Count > 0)
                                {
                                    <a class="button-like button-like--secondary" href="@RunDetailHref(workspace.Runs[0].RunId)">Open run context</a>
                                }
                            </div>

                            <div class="settings-summary-list">
                                @foreach (var crew in workspace.Crews)
                                {
                                    <div class="settings-summary-row">
                                        <span>@crew.Name roster</span>
                                        <strong>@crew.Members.Count members · @HumanizeStatus(crew.Visibility, "Private")</strong>
                                    </div>
                                    @foreach (var member in crew.Members)
                                    {
                                        var memberDossier = workspace.Dossiers.FirstOrDefault(dossier => string.Equals(dossier.DossierId, member.DossierId, StringComparison.OrdinalIgnoreCase));
                                        <div class="settings-summary-row">
                                            <span>@(memberDossier?.DisplayName ?? member.DossierId)</span>
                                            <strong>@HumanizeStatus(member.Role, "Member") · @HumanizeStatus(member.Availability, "Ready")</strong>
                                        </div>
                                    }
                                }
                            </div>

                            @if (workspace.RosterTransfers is { Count: > 0 })
                            {
                                <details class="details-drawer">
                                    <summary>Roster transfer history</summary>
                                    <ul class="muted-copy">
                                        @foreach (var transfer in workspace.RosterTransfers)
                                        {
                                            <li><strong>@transfer.RunnerHandle:</strong> @transfer.Summary</li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (workspace.PrepLaunches is { Count: > 0 })
                            {
                                <details class="details-drawer">
                                    <summary>Reviewed prep launch history</summary>
                                    <ul class="muted-copy">
                                        @foreach (var launch in workspace.PrepLaunches)
                                        {
                                            <li><strong>@launch.PacketTitle:</strong> @PublicText(launch.Summary) <span> Updated: @FormatUtc(launch.LaunchedAtUtc).</span> <span> Outcome: @AutomationOutcomeSummary(launch.Summary)</span> <span> Resumability: @AutomationResumabilitySummary(launch.Summary)</span></li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (workspace.TravelPrefetches is { Count: > 0 })
                            {
                                <details class="details-drawer">
                                    <summary>Travel prefetch history</summary>
                                    <ul class="muted-copy">
                                        @foreach (var receipt in workspace.TravelPrefetches)
                                        {
                                            <li><strong>@receipt.DeviceRole:</strong> @PublicText(receipt.PrefetchSummary) <span> Updated: @FormatUtc(receipt.StagedAtUtc).</span> <span> Outcome: @AutomationOutcomeSummary(receipt.PrefetchSummary)</span> <span> Resumability: @AutomationResumabilitySummary(receipt.PrefetchSummary)</span></li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (workspace.AftermathPackages is { Count: > 0 })
                            {
                                <details class="details-drawer">
                                    <summary>Aftermath and replay history</summary>
                                    <ul class="muted-copy">
                                        @foreach (var package in workspace.AftermathPackages)
                                        {
                                            <li><strong>@package.Title:</strong> @PublicText(package.Summary) <span> Updated: @FormatUtc(package.GeneratedAtUtc).</span> <span> Outcome: @AutomationOutcomeSummary(package.Summary)</span> <span> Resumability: @AutomationResumabilitySummary(package.Summary)</span></li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (workspace.AftermathPackages?.Any(item => string.Equals(item.PackageKind, "downtime_brief", StringComparison.OrdinalIgnoreCase)) == true)
                            {
                                var downtimeBrief = workspace.AftermathPackages.First(item => string.Equals(item.PackageKind, "downtime_brief", StringComparison.OrdinalIgnoreCase));
                                <details class="details-drawer">
                                    <summary>Downtime brief</summary>
                                    <ul class="muted-copy">
                                        <li><strong>@downtimeBrief.Title:</strong> @downtimeBrief.Summary</li>
                                        @if (downtimeBrief.EvidenceLines.Count > 0)
                                        {
                                            <li><strong>Details:</strong> @PublicText(downtimeBrief.EvidenceLines[0])</li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (workspace.NextSessionCarryForward is not null)
                            {
                                <details class="details-drawer">
                                    <summary>Next-session carry-forward</summary>
                                    <ul class="muted-copy">
                                        <li><strong>Summary:</strong> @workspace.NextSessionCarryForward.Summary</li>
                                        <li><strong>Return:</strong> @workspace.NextSessionCarryForward.ReturnSummary</li>
                                        <li><strong>Next:</strong> @workspace.NextSessionCarryForward.NextSafeAction</li>
                                        @if (workspace.NextSessionCarryForward.EvidenceLines.Count > 0)
                                        {
                                            <li><strong>Details:</strong> @PublicText(workspace.NextSessionCarryForward.EvidenceLines[0])</li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (workspace.CampaignMemory is not null)
                            {
                                <details class="details-drawer">
                                    <summary>Campaign memory</summary>
                                    <ul class="muted-copy">
                                        <li><strong>Summary:</strong> @workspace.CampaignMemory.Summary</li>
                                        <li><strong>Return:</strong> @workspace.CampaignMemory.ReturnSummary</li>
                                        <li><strong>Next:</strong> @workspace.CampaignMemory.NextSafeAction</li>
                                        @if (workspace.CampaignMemory.EvidenceLines.Count > 0)
                                        {
                                            <li><strong>Details:</strong> @PublicText(workspace.CampaignMemory.EvidenceLines[0])</li>
                                        }
                                    </ul>
                                </details>
                            }

                            <div class="settings-summary-list">
                                @foreach (var run in workspace.Runs)
                                {
                                    <div class="settings-summary-row">
                                        <span>@run.Title</span>
                                        <strong>@HumanizeStatus(run.Status, "Active") · @(run.ActiveSceneId is null ? "No active scene" : "Scene live") · @run.Objectives.Count objectives</strong>
                                    </div>
                                    @foreach (var objective in run.Objectives)
                                    {
                                        <div class="settings-summary-row">
                                            <span>@objective.Title</span>
                                            <strong>@HumanizeStatus(objective.Status, "Open") · @objective.Pressure pressure</strong>
                                        </div>
                                    }
                                    @foreach (var scene in run.Scenes)
                                    {
                                        <div class="settings-summary-row">
                                            <span>@scene.Title</span>
                                            <strong>@HumanizeStatus(scene.Status, "Ready") · @scene.Revision</strong>
                                        </div>
                                    }
                                }
                            </div>

                            @if (workspace.ReadinessCues.Count > 0)
                            {
                                <details class="details-drawer">
                                    <summary>GM readiness</summary>
                                    <ul class="muted-copy">
                                        @foreach (var cue in workspace.ReadinessCues)
                                        {
                                            <li><strong>@HumanizeStatus(cue.Severity, "Ready"):</strong> @cue.Title. @cue.Summary</li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (workspace.RecapShelf.Count > 0)
                            {
                                <details class="details-drawer">
                                    <summary>Recap files</summary>
                                    <ul class="muted-copy">
                                        @foreach (var item in workspace.RecapShelf)
                                        {
                                            var linkedPublication = !string.IsNullOrWhiteSpace(item.CreatorPublicationId)
                                                ? Model.CampaignSpine.CreatorPublications.FirstOrDefault(publication => string.Equals(publication.PublicationId, item.CreatorPublicationId, StringComparison.OrdinalIgnoreCase))
                                                : null;
                                            <li>
                                                <strong>@PublicText(item.Label)</strong>: @PublicText(item.Summary)
                                                <span> Audience: @PublicSurfaceStatus.AudienceLabel(item.Audience).</span>
                                                @if (!string.IsNullOrWhiteSpace(item.OwnershipSummary))
                                                {
                                                    <span> Ownership: @PublicText(item.OwnershipSummary)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.ProvenanceSummary))
                                                {
                                                    <span> Details: @PublicText(item.ProvenanceSummary)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.AuditSummary))
                                                {
                                                    <span> Note: @PublicFacingCopyHumanizer.Clean(item.AuditSummary)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.CompatibilitySummary))
                                                {
                                                    <span> Compatibility: @PublicText(item.CompatibilitySummary)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.LineageSummary))
                                                {
                                                    <span> Lineage: @PublicText(item.LineageSummary)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.PublicationState))
                                                {
                                                    <span> Publication: @HumanizeStatus(item.PublicationState, "Ready").</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.TrustBand))
                                                {
                                                    <span> Status: @HumanizeStatus(item.TrustBand, "Draft").</span>
                                                    <span> Discoverable now: @(item.Discoverable ? "Eligible now" : "Still bounded").</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.PublicationSummary))
                                                {
                                                    <span> @PublicText(item.PublicationSummary)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(linkedPublication?.Visibility))
                                                {
                                                    <span> Visibility: @HumanizeStatus(linkedPublication.Visibility, "Shared").</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(linkedPublication?.DiscoverySummary))
                                                {
                                                    <span> Discovery: @PublicText(linkedPublication.DiscoverySummary)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(linkedPublication?.TrustSummary))
                                                {
                                                    <span> Trust: @PublicText(linkedPublication.TrustSummary)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(linkedPublication?.ComparisonSummary))
                                                {
                                                    <span> Compare by: @PublicText(linkedPublication.ComparisonSummary)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(linkedPublication?.LineageSummary))
                                                {
                                                    <span> Lineage: @PublicText(linkedPublication.LineageSummary)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(linkedPublication?.CampaignReturnSummary))
                                                {
                                                    <span> Return: @PublicText(linkedPublication.CampaignReturnSummary)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(linkedPublication?.SupportClosureSummary))
                                                {
                                                    <span> Support: @PublicText(linkedPublication.SupportClosureSummary)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(linkedPublication?.ModerationSummary))
                                                {
                                                    <span> Moderation: @PublicText(linkedPublication.ModerationSummary)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.NextSafeAction))
                                                {
                                                    <span> Next: @PublicText(item.NextSafeAction)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.ArtifactId))
                                                {
                                                    <span> (@item.ArtifactId)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(linkedPublication?.BuildHandoffId))
                                                {
                                                    <a class="inline-link" href="@BuildHandoffDetailHref(linkedPublication.BuildHandoffId)">Open build path for @linkedPublication.Title</a>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.CreatorPublicationId))
                                                {
                                                    <a class="inline-link" href="@PublicationDetailHref(item.CreatorPublicationId)">Open publication status</a>
                                                    @if (IsDiscoverablePublicCreatorPublication(linkedPublication))
                                                    {

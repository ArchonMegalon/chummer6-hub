                                        {
                                            <span><a href="@receipt.RecoveryRoute">@DescribeRecoveryRouteAction(receipt.RecoveryRoute)</a></span>
                                        }
                                        <span>@receipt.RecoveryHint</span>
                                        <span>@receipt.RecoverySummary</span>
                                        <span>@HumanizeStatus(receipt.ContinuePosture, receipt.BlocksContinue ? "Continue blocked" : "Review before continuing")</span>
                                        @if (receipt.BlocksContinue)
                                        {
                                            <span>Continue is blocked until this item is resolved.</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </details>

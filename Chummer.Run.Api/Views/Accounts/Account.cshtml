                                    {
                                        <span> Tradeoffs: @string.Join(" ", handoff.TradeoffLines.Take(2)).</span>
                                    }
                                    @if (handoff.ProgressionOutcomes.Count > 0)
                                    {
                                        <span> Outcome: @handoff.ProgressionOutcomes[0].</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(handoff.PlannerCoverageSummary))
                                    {
                                        <span> Coverage: @handoff.PlannerCoverageSummary.</span>
                                    }
                                    @if (handoff.PlannerCoverageLines is { Count: > 0 })
                                    {
                                        foreach (var plannerLine in handoff.PlannerCoverageLines.Take(2))
                                        {
                                            <span> Planner note: @plannerLine</span>
                                        }
                                    }
                                    @if (!string.IsNullOrWhiteSpace(handoff.CrewFitSummary))
                                    {
                                        <span> Crew fit: @handoff.CrewFitSummary.</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(handoff.SourceHintSummary))
                                    {
                                        <span> Linked hints: @handoff.SourceHintSummary.</span>
                                    }
                                    @if (handoff.SourceHintLines is { Count: > 0 })
                                    {
                                        foreach (var sourceHintLine in handoff.SourceHintLines.Take(2))
                                        {
                                            <span> Hint: @sourceHintLine</span>
                                        }
                                    }
                                    @if (handoff.RuleEnvironmentDiff is not null)
                                    {
                                        <span> Rule diff: @handoff.RuleEnvironmentDiff.Summary</span>
                                    }
                                    @if (handoff.Outputs.Count > 0)
                                    {
                                        <span> Outputs: @string.Join(", ", handoff.Outputs.Select(item => item.Label)).</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(handoff.NextSafeAction))
                                    {
                                        <span> Next safe action: @handoff.NextSafeAction</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(handoff.RuntimeCompatibilitySummary))
                                    {
                                        <span> Runtime: @handoff.RuntimeCompatibilitySummary</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(handoff.CampaignReturnSummary))
                                    {
                                        <span> Return: @handoff.CampaignReturnSummary</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(handoff.SupportClosureSummary))
                                    {
                                        <span> Closure: @handoff.SupportClosureSummary</span>
                                    }
                                    @if (handoff.Watchouts is { Count: > 0 })
                                    {
                                        <span> Watchouts: @string.Join(" ", handoff.Watchouts.Take(2)).</span>
                                    }
                                </li>
                            }
                        </ul>
                    </details>
                }
                @if (Model.CampaignSpine.RulesNavigator.Count > 0)
                {
                    <details class="details-drawer">
                        <summary>Rules answers</summary>
                        <ul class="muted-copy">
                            @foreach (var answer in Model.CampaignSpine.RulesNavigator)
                            {
                                <li>
                                    <strong><a class="inline-link" href="@RulesDetailHref(answer.EntryId)">@answer.Question</a></strong>: @answer.ShortAnswer
                                    <span> Before: @answer.BeforeSummary. After: @answer.AfterSummary.</span>
                                    <span> Details: @PublicText(answer.ProvenanceLabel).</span>
                                    @if (answer.Studio is not null)
                                    {
                                        <span> Lifecycle: @answer.Studio.CurrentStageLabel -> @answer.Studio.PromotionTargetLabel.</span>
                                        <span> Rollback: @answer.Studio.RollbackSummary.</span>
                                    }
                                    @if (answer.EvidenceLines.Count > 0)
                                    {
                                        <span> Details: @PublicText(answer.EvidenceLines[0]).</span>
                                    }
                                    @if (answer.SupportReuseHints.Count > 0)
                                    {
                                        <span> Support reuse: @answer.SupportReuseHints[0].</span>
                                    }
                                </li>
                            }
                        </ul>
                    </details>
                }
                @if (Model.CampaignSpine.MigrationReceipts.Count > 0)
                {
                    <details class="details-drawer">
                        <summary>Legacy migration history</summary>
                        <ul class="muted-copy">
                            @foreach (var receipt in Model.CampaignSpine.MigrationReceipts)
                            {
                                <li>
                                    <strong>@PublicText(receipt.SourceKind)</strong>: @PublicText(receipt.Summary)
                                    <span> Fields: @string.Join(", ", receipt.Fields.Select(field => $"{field.Label}={field.Status}")).</span>
                                </li>
                            }
                        </ul>
                    </details>
                }
                @if (Model.CampaignSpine.CreatorPublications.Count > 0)
                {
                    <details class="details-drawer">
                        <summary>Shared publications</summary>
                        <ul class="muted-copy">
                            @foreach (var publication in Model.CampaignSpine.CreatorPublications)
                            {
                                <li>
                                    <strong><a class="inline-link" href="@PublicationDetailHref(publication.PublicationId)">@publication.Title</a></strong>: @publication.Summary
                                    <span> Details: @PublicText(publication.ProvenanceSummary). Visibility: @HumanizeStatus(publication.Visibility, "Shared"). Status: @HumanizeStatus(publication.TrustBand, "Draft"). Discovery: @PublicText(publication.DiscoverySummary) Available: @(publication.Discoverable ? "Eligible now" : "Still bounded"). Status: @HumanizeStatus(publication.PublicationStatus, "Published").</span>
                                    @if (!string.IsNullOrWhiteSpace(publication.TrustSummary))
                                    {
                                        <span> Status: @publication.TrustSummary</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(publication.ComparisonSummary))
                                    {
                                        <span> Compare by: @publication.ComparisonSummary</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(publication.LineageSummary))
                                    {
                                        <span> Lineage: @publication.LineageSummary</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(publication.NextSafeAction))
                                    {
                                        <span> Next: @publication.NextSafeAction.</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(publication.CampaignReturnSummary))
                                    {
                                        <span> Return: @publication.CampaignReturnSummary.</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(publication.SupportClosureSummary))
                                    {
                                        <span> Support: @publication.SupportClosureSummary.</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(publication.ModerationSummary))
                                    {
                                        <span> Moderation: @publication.ModerationSummary</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(publication.BuildHandoffId))
                                    {
                                        <a class="inline-link" href="@BuildHandoffDetailHref(publication.BuildHandoffId)">Open build path for @publication.Title</a>
                                    }
                                    @if (IsDiscoverablePublicCreatorPublication(publication))
                                    {
                                        <a class="inline-link" href="@PublicCreatorPublicationHref(publication.PublicationId)">@CreatorPublicationLinkLabel(publication)</a>
                                    }
                                </li>
                            }
                        </ul>
                    </details>
                }
            </section>
            </details>
            }

            @if (showWorkSection && showTeamsSection)
            {

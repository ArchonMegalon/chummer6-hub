                                    <li>
                                        <strong>@surface.Label:</strong> @PublicText(surface.Status.Summary)
                                        <span>Next: @PublicText(surface.Status.LeadRecoveryHint)</span>
                                        <span>Updated: @surface.Status.LatestReceiptObservedAtUtc.UtcDateTime.ToString("u")</span>
                                        <span>@PublicText(surface.Status.RecoverySummary)</span>
                                        <span>Needs refresh: @surface.Status.RefreshBeforeContinueCount</span>
                                        <span>Blocking conflicts: @surface.Status.BlockingConflictCount</span>
                                        @if (IsNavigableAccountRoute(surface.Status.RecoveryRoute))
                                        {
                                            <span><a href="@surface.Status.RecoveryRoute">@DescribeRecoveryRouteAction(surface.Status.RecoveryRoute)</a></span>
                                        }
                                        <span>@HumanizeStatus(surface.Status.ContinuePosture, "Safe to continue")</span>
                                    </li>
                                }
                            </ul>
                        }
                        @if (entitlementSyncReceipts.ReceiptStatus.RecoveryActions.Count > 0)

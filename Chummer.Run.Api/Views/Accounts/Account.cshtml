                        <div id="ruleGhostAnswer" class="stacked-copy" hidden></div>
                        <div id="ruleGhostFollowUps" class="stacked-actions" hidden></div>
                        <div id="ruleGhostCitations" class="settings-summary-list" hidden></div>
                    </form>
                </details>
                <form id="supportCaseForm" class="settings-form">
                    <div class="field">
                        <label for="supportCaseKind">Case type</label>
                        <select id="supportCaseKind">
                            <option value="bug_report" selected="@(string.Equals(supportCaseDefaultKind, "bug_report", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Bug report</option>
                            <option value="feedback" selected="@(string.Equals(supportCaseDefaultKind, "feedback", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Feedback</option>
                            <option value="install_help" selected="@(string.Equals(supportCaseDefaultKind, "install_help", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">Install or update help</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="supportCaseInstallation">Related install</label>
                        <select id="supportCaseInstallation">
                            <option value="">No specific install</option>
                            @foreach (var installation in Model.InstallLinking.ClaimedInstallations ?? Array.Empty<Chummer.Hub.Registry.Contracts.InstallLinking.ClaimedInstallationDto>())
                            {
                                <option
                                    value="@installation.InstallationId"
                                    data-version="@installation.Version"
                                    data-channel="@installation.Channel"
                                    data-head="@installation.HeadId"
                                    data-platform="@installation.Platform"
                                    data-arch="@installation.Arch"
                                    selected="@(string.Equals(selectedSupportInstallationId, installation.InstallationId, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@((installation.HostLabel ?? installation.InstallationId) + $" · {installation.Version} · {installation.Channel}")</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="supportCaseTitle">Short title</label>
                        <input id="supportCaseTitle" maxlength="160" placeholder="Update prompt was unclear on Linux" value="@supportCaseDefaultTitle" />
                    </div>
                    <div class="field">
                        <label for="supportCaseSummary">One-line summary</label>
                        <input id="supportCaseSummary" maxlength="280" placeholder="The updater offered a restart but did not explain what was staged." value="@supportCaseDefaultSummary" />
                    </div>
                    <div class="field">
                        <label for="supportCaseDetail">What happened</label>
                        <textarea id="supportCaseDetail" rows="6" placeholder="Tell Chummer what you expected, what actually happened, and anything that would help close the fix faster.">@supportCaseDefaultDetail</textarea>
                    </div>
                    <div class="field">
                        <label for="supportCaseAttachments">Attachments</label>
                        <input id="supportCaseAttachments" type="file" multiple accept=".png,.jpg,.jpeg,.webp,.txt,.log,.json,.zip,.md" />

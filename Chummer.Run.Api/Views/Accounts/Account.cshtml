                                                <li>
                                                    <strong>@joinCode.Code</strong>: @HumanizeStatus(joinCode.Role, "Member") · @HumanizeStatus(joinCode.Status, "Active")
                                                    <span> @joinCode.StatusSummary</span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </details>
                                <details class="details-drawer">
                                    <summary>Recent boost codes</summary>
                                    @if (op.RecentBoostCodes.Count == 0)

                            <p class="muted-copy">
                                <a href="@entitlementSyncReceipts.ReceiptStatus.RecoveryRoute">@DescribeRecoveryRouteAction(entitlementSyncReceipts.ReceiptStatus.RecoveryRoute)</a>
                            </p>
                        }
                        @if (entitlementSyncReceipts.ProvenanceRecoveryReceipts.Count == 0)

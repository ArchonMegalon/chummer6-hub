                                <strong>@entitlementSyncReceipts.ReceiptStatus.RefreshBeforeContinueCount</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Blocking conflicts</span>
                                <strong>@entitlementSyncReceipts.ReceiptStatus.BlockingConflictCount</strong>
                            </div>
                        </div>
                        @if (entitlementSyncReceipts.ReceiptSurfaces.Count > 0)

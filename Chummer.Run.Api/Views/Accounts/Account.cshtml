                                            <li>@leagueLine</li>
                                        }
                                    }
                                </ul>
                            </details>
                            <details id="community-op-events-@op.GroupId" class="details-drawer">
                                <summary>Season &amp; event activity</summary>
                                <ul class="muted-copy">
                                    <li>@op.SeasonEventSummary</li>

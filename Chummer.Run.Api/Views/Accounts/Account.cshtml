@using Chummer.Run.Api.Services
@model AccountPageViewModel
@{
    var pageTitle = Model.CurrentSection switch
    {
        "participation" => "Account · Participation",
        "support" => "Account · Support",
        "access" => "Account · Devices & access",
        "work" => "Account · Work",
        "settings" => "Account · Settings",
        "advanced" => "Account · Advanced",
        _ => "Account"
    };
    var sectionTitle = Model.CurrentSection switch
    {
        "participation" => "Participation",
        "support" => "Support",
        "access" => "Devices & access",
        "work" => "Work",
        "settings" => "Settings",
        "advanced" => "Advanced account details",
        _ => "Account"
    };
    var sectionCopy = Model.CurrentSection switch
    {
        "participation" => "Return to followed work, guided contribution history, and privacy-safe recognition from one calmer account page.",
        "support" => "Open, track, and close support without leaving the account surface.",
        "access" => "Keep linked installs, access rights, and claimed copies in one calmer place.",
        "work" => "Campaign return, recent activity, and shared context stay here when you explicitly need them.",
        "settings" => "Preferences, participation, and linked channels stay out of the customer core until you ask for them.",
        "advanced" => "Account identifiers and deeper account details stay behind the advanced page.",
        _ => "Keep sign-in, recovery, devices, support, and account preferences in one calmer product settings surface."
    };
    ViewData["Title"] = pageTitle;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-account";
    ViewData["ContextSidebarHeading"] = "Account";
    ViewData["ContextSidebarSummary"] = "Move between profile, access, support, and work from the shared side panel instead of a second inline account area.";
    // .Replace( legacy source marker: <strong>Table Pulse Live command-to-fallout lane</strong> )
    // .Replace( legacy source marker: <strong>Table Pulse Aftermath return lane</strong> )
    // .Replace( legacy source marker: Open aftermath rail )
    ViewData["ContextSidebarLinks"] = Model.CoreSections
        .Concat(Model.SecondarySections)
        .Select(static item => new PublicNavigationLink(item.Label, item.Href))
        .ToArray();
    var emailLink = Model.Links.LinkedIdentities.FirstOrDefault(link => string.Equals(link.Provider, "email", StringComparison.OrdinalIgnoreCase));
    var googleLink = Model.Links.LinkedIdentities.FirstOrDefault(link => string.Equals(link.Provider, "google", StringComparison.OrdinalIgnoreCase));
    var telegramChannel = Model.Links.ChannelLinks.FirstOrDefault(link => string.Equals(link.ChannelKind, "telegram_official_bot", StringComparison.OrdinalIgnoreCase));
    var whatsappChannel = Model.Links.ChannelLinks.FirstOrDefault(link => string.Equals(link.ChannelKind, "whatsapp_official_business", StringComparison.OrdinalIgnoreCase));
    var laneInterests = Model.Experience.LaneInterests.ToHashSet(StringComparer.OrdinalIgnoreCase);
    var claimedInstallations = Model.InstallLinking.ClaimedInstallations?.Count ?? 0;
    var activeAccessRights = Model.InstallLinking.ActiveGrants?.Count ?? 0;
    var pendingClaims = Model.InstallLinking.PendingClaimTickets.Count;
    var openSupportCases = Model.SupportCases.Count(item => !string.Equals(item.Status, "user_notified", StringComparison.OrdinalIgnoreCase));
    var linkedInstallations = Model.InstallLinking.ClaimedInstallations ?? Array.Empty<Chummer.Hub.Registry.Contracts.InstallLinking.ClaimedInstallationDto>();
    var activeGrants = Model.InstallLinking.ActiveGrants ?? Array.Empty<Chummer.Hub.Registry.Contracts.InstallLinking.InstallationGrantDto>();
    var pendingClaimTickets = Model.InstallLinking.PendingClaimTickets.OrderByDescending(static item => item.CreatedAtUtc).ToArray();
    var installRailSupportCases = Model.SupportCaseSummaries
        .Where(item =>
            string.Equals(item.Case.Kind, "install_help", StringComparison.OrdinalIgnoreCase)
            || !string.IsNullOrWhiteSpace(item.Case.InstallationId)
            || !string.IsNullOrWhiteSpace(item.Case.ReleaseChannel)
            || !string.IsNullOrWhiteSpace(item.Case.Platform))
        .OrderByDescending(item => item.Case.UpdatedAtUtc)
        .ToArray();
    var leadInstallation = linkedInstallations.OrderByDescending(static item => item.UpdatedAtUtc).FirstOrDefault();
    var leadGrant = leadInstallation is null
        ? activeGrants.OrderByDescending(static item => item.IssuedAtUtc).FirstOrDefault()
        : activeGrants
            .Where(item => string.Equals(item.InstallationId, leadInstallation.InstallationId, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(static item => item.IssuedAtUtc)
            .FirstOrDefault()
            ?? activeGrants.OrderByDescending(static item => item.IssuedAtUtc).FirstOrDefault();
    var leadPendingClaim = pendingClaimTickets.FirstOrDefault();
    var leadInstallRailSupport = installRailSupportCases.FirstOrDefault();
    var dossierCount = Model.CampaignSpine.Dossiers.Count;
    var campaignCount = Model.CampaignSpine.Campaigns.Count;
    var runCount = Model.CampaignSpine.Runs.Count;
    var workspaceCount = Model.CampaignSpine.Workspaces.Count;
    var recapProjectionCount = Model.CampaignSpine.Workspaces.SelectMany(item => item.RecapShelf).Count();
    var communityOpsCount = Model.CampaignSpine.CommunityOperations.Count;
    var restoreConflicts = Model.CampaignSpine.Restore.ConflictSummaries.Count;
    var restoreArtifactCount = Model.CampaignSpine.Restore.RecentArtifacts.Count;
    var restoreEntitlementCount = Model.CampaignSpine.Restore.Entitlements.Count;
    var restoreDeviceCount = Model.CampaignSpine.Restore.ClaimedDevices.Count;
    var buildLabHandoffCount = Model.CampaignSpine.BuildLabHandoffs.Count;
    var rulesNavigatorCount = Model.CampaignSpine.RulesNavigator.Count;
    var migrationReceiptCount = Model.CampaignSpine.MigrationReceipts.Count;
    var creatorPublicationCount = Model.CampaignSpine.CreatorPublications.Count;
    var organizerGuidanceSummary = openSupportCases == 0
        ? "Current public release, member downloads, and help stay in one calmer account view."
        : $"{openSupportCases} tracked support case(s), current public release status, and member downloads stay in one calmer account view.";
    var showCampaignSection = dossierCount > 0 || campaignCount > 0 || runCount > 0 || workspaceCount > 0 || restoreConflicts > 0;
    var showTeamsSection = communityOpsCount > 0;
    var showChannelsSection = string.Equals(Model.CurrentSection, "settings", StringComparison.OrdinalIgnoreCase)
        || telegramChannel is not null
        || whatsappChannel is not null;
    var participationRecognition = Model.ParticipationRecognition;
    var participationSession = Model.ParticipationSession;
    var participationReceipts = (Model.ParticipationReceipts ?? Array.Empty<Chummer.Run.Contracts.Ledger.ContributionReceiptDto>()).Take(6).ToArray();
    var participationPackageReceipts = (Model.ParticipationPackageReceipts ?? Array.Empty<Chummer.Run.Api.Services.PublicPackageReceipt>()).Take(6).ToArray();
    var participationKarmaSubmissions = (Model.ParticipationKarmaSubmissions ?? Array.Empty<Chummer.Run.Api.Services.KarmaForge.KarmaForgeSubmissionProjection>()).Take(4).ToArray();
    var participationActivityReceipts = (Model.ParticipationActivityReceipts ?? Array.Empty<Chummer.Run.Api.Services.Community.ParticipationOperatorNotificationReceipt>()).Take(6).ToArray();
    var participationBadges = ((participationRecognition?.CurrentStatusBadges ?? Array.Empty<Chummer.Run.Contracts.Leaderboards.BadgeDto>())
            .Concat(participationRecognition?.PersistentBadges ?? Array.Empty<Chummer.Run.Contracts.Leaderboards.BadgeDto>()))
        .GroupBy(static badge => badge.Key, StringComparer.OrdinalIgnoreCase)
        .Select(static group => group.First())
        .Take(6)
        .ToArray();
    var packageFollowCount = participationPackageReceipts.Count(receipt => string.Equals(receipt.ActionKind, "follow", StringComparison.OrdinalIgnoreCase));
    var packageVoteCount = participationPackageReceipts.Count(receipt => string.Equals(receipt.ActionKind, "vote", StringComparison.OrdinalIgnoreCase));
    var showParticipationPage = string.Equals(Model.CurrentSection, "participation", StringComparison.OrdinalIgnoreCase);
    var showParticipationSection = showParticipationPage
        || Model.Experience.OnboardingCompleted
        || laneInterests.Count > 0
        || Model.Experience.FollowHorizons
        || Model.Experience.BetaInterest
        || Model.Experience.ImpactCloseoutNotifications
        || Model.Experience.PublicContributionProfileOptIn
        || participationPackageReceipts.Length > 0
        || participationKarmaSubmissions.Length > 0
        || participationReceipts.Length > 0
        || participationActivityReceipts.Length > 0
        || (participationRecognition?.LifetimePoints ?? 0) > 0;
    var showProfileSection = string.Equals(Model.CurrentSection, "profile", StringComparison.OrdinalIgnoreCase);
    var showSupportSection = string.Equals(Model.CurrentSection, "support", StringComparison.OrdinalIgnoreCase);
    var showAccessSection = string.Equals(Model.CurrentSection, "access", StringComparison.OrdinalIgnoreCase);
    var showWorkSection = string.Equals(Model.CurrentSection, "work", StringComparison.OrdinalIgnoreCase);
    var showSettingsSection = string.Equals(Model.CurrentSection, "settings", StringComparison.OrdinalIgnoreCase);
    var showParticipationSettings = showParticipationPage || showSettingsSection;
    var showAdvancedSection = string.Equals(Model.CurrentSection, "advanced", StringComparison.OrdinalIgnoreCase);
    var showInlineAccountStatus = showAccessSection || showSupportSection;
    var showAccountStatusDrawer = Model.SignedInTrustStatus is not null && !showInlineAccountStatus;
    var selectedSupportCase = Model.SelectedSupportCase;
    var selectedSupportCaseSummary = Model.SelectedSupportCaseSummary;
    var supportQuery = Context.Request.Query;
    var supportCaseDefaultKind = supportQuery.TryGetValue("kind", out var supportKindValues) ? supportKindValues.ToString() : string.Empty;
    var supportCaseDefaultTitle = supportQuery.TryGetValue("title", out var supportTitleValues) ? supportTitleValues.ToString() : string.Empty;
    var supportCaseDefaultSummary = supportQuery.TryGetValue("summary", out var supportSummaryValues) ? supportSummaryValues.ToString() : string.Empty;
    var supportCaseDefaultDetail = supportQuery.TryGetValue("detail", out var supportDetailValues) ? supportDetailValues.ToString() : string.Empty;
    var selectedSupportInstallationId = selectedSupportCase?.InstallationId
        ?? (supportQuery.TryGetValue("installationId", out var supportInstallationValues) ? supportInstallationValues.ToString() : null);
    var entitlementSyncReceipts = Model.EntitlementSyncReceipts;
    var selectedWorkspace = Model.SelectedWorkspace;
    var selectedWorkspaceServerPlane = Model.SelectedWorkspaceServerPlane;
    var selectedWorkspacePortableExchangeNotice = selectedWorkspaceServerPlane?.DecisionNotices.FirstOrDefault(notice => string.Equals(notice.Kind, "portable_exchange", StringComparison.OrdinalIgnoreCase));
    var selectedWorkspaceDecisionNotices = (selectedWorkspaceServerPlane?.DecisionNotices ?? Array.Empty<Chummer.Control.Contracts.Support.DecisionNotice>())
        .Where(notice => !WorkspaceNoticeSafety.LooksLikeInternalWorkspaceLeak(notice.Summary))
        .ToArray();
    var selectedWorkspacePortableExchangeSummary = !WorkspaceNoticeSafety.LooksLikeInternalWorkspaceLeak(selectedWorkspacePortableExchangeNotice?.Summary)
        ? selectedWorkspacePortableExchangeNotice?.Summary
        : null;
    var selectedWorkspaceRosterTransferPlan = Model.SelectedWorkspaceRosterTransferPlan;
    var selectedWorkspacePrepLibrarySearch = Model.SelectedWorkspacePrepLibrarySearch;
    var selectedWorkspacePrepLibraryQuery = Model.SelectedWorkspacePrepLibraryQuery;
    var selectedWorkspacePrepLibraryQueryHistory = selectedWorkspace is null
        ? Array.Empty<Chummer.Run.Contracts.Community.WorkspacePrepLibrarySearchHistoryItem>()
        : (Model.Experience.WorkspacePrepLibrarySearchHistory ?? Array.Empty<Chummer.Run.Contracts.Community.WorkspacePrepLibrarySearchHistoryItem>())
            .Where(item => string.Equals(item.WorkspaceId, selectedWorkspace.WorkspaceId, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(item => item.LastUsedUtc)
            .Take(8)
            .ToArray();
    var selectedWorkspaceFirstPlayableSession = selectedWorkspaceServerPlane?.FirstPlayableSession ?? selectedWorkspace?.FirstPlayableSession;
    var selectedWorkspaceFirstPlayableEvidence = selectedWorkspaceFirstPlayableSession?.EvidenceLines.FirstOrDefault();
    var selectedWorkspaceNextSessionCarryForward = selectedWorkspaceServerPlane?.NextSessionCarryForward;
    var selectedWorkspacePrepLaunches = selectedWorkspaceServerPlane?.PrepLaunches ?? Array.Empty<Chummer.Campaign.Contracts.GovernedPrepLaunchProjection>();
    var selectedWorkspaceTravelPrefetches = selectedWorkspaceServerPlane?.TravelPrefetches ?? Array.Empty<Chummer.Campaign.Contracts.TravelPrefetchReceiptProjection>();
    var selectedWorkspaceAftermathPackages = selectedWorkspaceServerPlane?.AftermathPackages ?? Array.Empty<Chummer.Campaign.Contracts.AftermathRecapPackageProjection>();
    var selectedWorkspaceConsequences = selectedWorkspaceServerPlane?.Consequences ?? selectedWorkspace?.Consequences ?? Array.Empty<Chummer.Campaign.Contracts.CampaignConsequenceProjection>();
    var selectedWorkspaceLeadConsequence = selectedWorkspaceConsequences.FirstOrDefault();
    var selectedWorkspaceLeadAftermathPackage = selectedWorkspaceAftermathPackages
        .FirstOrDefault(item => !string.Equals(item.PackageKind, "downtime_brief", StringComparison.OrdinalIgnoreCase));
    var selectedWorkspaceDowntimePackage = selectedWorkspaceAftermathPackages
        .FirstOrDefault(item => string.Equals(item.PackageKind, "downtime_brief", StringComparison.OrdinalIgnoreCase));
    var selectedWorkspaceCampaignMemory = selectedWorkspaceServerPlane?.CampaignMemory ?? selectedWorkspace?.CampaignMemory;
    var selectedWorkspaceCampaignMemoryEvidence = selectedWorkspaceCampaignMemory?.EvidenceLines.FirstOrDefault();
    var selectedWorkspaceAftermathHref = selectedWorkspace is null
        ? "/account/work#aftermath-packages"
        : $"/account/work/workspaces/{Uri.EscapeDataString(selectedWorkspace.WorkspaceId)}#aftermath-packages";
    var selectedWorkspaceCarryForwardHref = selectedWorkspace is null
        ? "/account/work#selected-next-session-carry-forward"
        : $"/account/work/workspaces/{Uri.EscapeDataString(selectedWorkspace.WorkspaceId)}#selected-next-session-carry-forward";
    var selectedWorkspaceMemoryHref = selectedWorkspace is null
        ? "/account/work#selected-campaign-memory"
        : $"/account/work/workspaces/{Uri.EscapeDataString(selectedWorkspace.WorkspaceId)}#selected-campaign-memory";
    var selectedWorkspaceTablePulseSummary = selectedWorkspaceServerPlane is null
        ? "This workspace is not attached to a reviewed server plane yet, so Table Pulse Live continuity stays armed but cannot write command-to-fallout status here."
        : selectedWorkspaceLeadConsequence is not null
            ? $"Table Pulse Live is already carrying {selectedWorkspaceConsequences.Count} reviewed consequence cue(s) on this workspace, so inbox reactions, Signal Deck pressure, and Table Pulse Aftermath continuity are attached to real campaign return instead of flavor-only recap copy."
            : "Table Pulse Live is armed on this workspace even before the next reaction resolves, so the next signed-in inbox packet can return through carry-forward, memory, and Table Pulse Aftermath on the same reviewed path.";
    var selectedWorkspaceLivingNewsroomSummary = selectedWorkspaceNextSessionCarryForward is not null
        ? $"Living Newsroom framing is anchored by next-session carry-forward: {selectedWorkspaceNextSessionCarryForward.Summary}"
        : selectedWorkspaceCampaignMemory is not null
            ? $"Living Newsroom framing is currently anchored by campaign memory: {selectedWorkspaceCampaignMemory.Summary}"
            : "Living Newsroom watch framing is armed, but this workspace has not attached a current carry-forward or memory packet yet.";
    var selectedWorkspaceRunnerPassportSummary = selectedWorkspaceLeadConsequence is not null
        ? "Runner Passport continuity is now attached to real command fallout on this workspace instead of sitting as a detached trust card."
        : "Runner Passport is ready to stamp bounded trust continuity the moment the next reviewed reaction lands on this workspace.";
    var selectedRun = Model.SelectedRun;
    var selectedRunWorkspace = selectedRun is null
        ? null
        : Model.CampaignSpine.Workspaces.FirstOrDefault(item => string.Equals(item.CampaignId, selectedRun.CampaignId, StringComparison.OrdinalIgnoreCase));
    var selectedRunWorkspaceHref = selectedRunWorkspace is null
        ? "/account/work"
        : $"/account/work/workspaces/{Uri.EscapeDataString(selectedRunWorkspace.WorkspaceId)}";
    var selectedRunAftermathHref = selectedRunWorkspace is null
        ? "/account/work#aftermath-packages"
        : $"/account/work/workspaces/{Uri.EscapeDataString(selectedRunWorkspace.WorkspaceId)}#aftermath-packages";
    var selectedRunCarryForwardHref = selectedRunWorkspace is null
        ? "/account/work#selected-next-session-carry-forward"
        : $"/account/work/workspaces/{Uri.EscapeDataString(selectedRunWorkspace.WorkspaceId)}#selected-next-session-carry-forward";
    var selectedRunTablePulseSummary = selectedRun is null
        ? string.Empty
        : selectedRun.LatestContinuity is not null
            ? $"This run already has live continuity, so the next Table Pulse Live reaction should return through the same reviewed workspace path instead of splitting into a separate Table Pulse Aftermath story."
            : "This run is ready to bind the next reviewed reaction, carry-forward detail, and aftermath package on the shared command path.";
    var selectedBuildLabHandoff = Model.SelectedBuildLabHandoff;
    var selectedRulesNavigatorAnswer = Model.SelectedRulesNavigatorAnswer;
    var selectedCreatorPublication = Model.SelectedCreatorPublication;
    var selectedCreatorPublicationDraftDetail = Model.SelectedCreatorPublicationDraftDetail;
    var selectedCreatorPublicationReceipt = Model.SelectedCreatorPublicationReceipt;
    var openCampaignDetailSection = selectedWorkspace is not null
        || selectedRun is not null
        || selectedBuildLabHandoff is not null
        || selectedRulesNavigatorAnswer is not null
        || selectedCreatorPublication is not null;
    var installRailHeading = "Start the next linked install from this account";
    var installRailSummary = "Open Downloads while signed in to keep the next install, update path, and support history attached to this account from the first successful launch.";
    var installRailPrimaryLabel = "Open downloads";
    var installRailPrimaryHref = "/downloads";
    var installRailSecondaryLabel = "Open install help";
    var installRailSecondaryHref = "/contact?kind=install_help";

    if (leadInstallRailSupport is not null)
    {
        installRailHeading = "Tracked install next steps";
        installRailSummary = $"{leadInstallRailSupport.NextSafeAction} {leadInstallRailSupport.InstallReadinessSummary}";
        installRailPrimaryLabel = leadInstallRailSupport.PrimaryActionLabel;
        installRailPrimaryHref = leadInstallRailSupport.PrimaryActionHref;
        installRailSecondaryLabel = "Open tracked support";
        installRailSecondaryHref = leadInstallRailSupport.DetailHref;
    }
    else if (leadPendingClaim is not null)
    {
        installRailHeading = "Finish the pending install on that device";
        installRailSummary = "The next safe action is still inside Chummer on the already-downloaded device. Only use the recovery code if that copy explicitly enters recovery mode. Claim, update, rollback, recovery, and support stay on this same account page once the install is linked.";
        installRailPrimaryLabel = "Open downloads";
        installRailPrimaryHref = "/downloads";
        installRailSecondaryLabel = "Open tracked support";
        installRailSecondaryHref = "/account/support";
        @* Claim, update, rollback, recovery, and support stay on this same account path once the install is linked. *@
        @* Use Devices & access only to relink or reclaim that copy, and treat browser routes as backup help instead of the normal path. *@
    }
    else if (leadInstallation is not null)
    {
        installRailHeading = "This linked install is your default return path";
        installRailSummary = "Continue claim, update, rollback, recovery, and support from the claimed desktop install first. Use Devices & access only to relink or reclaim that copy, and keep browser pages as backup help instead of the normal path.";
        installRailPrimaryLabel = "Open downloads";
        installRailPrimaryHref = "/downloads";
        installRailSecondaryLabel = "Open tracked support";
        installRailSecondaryHref = "/account/support";
        @* Claim, update, rollback, recovery, and support stay on this same account path once the install is linked. *@
        @* Use Devices & access only to relink or reclaim that copy, and treat browser routes as backup help instead of the normal path. *@
    }

    static string HumanizeStatus(string? value, string fallback = "Not connected")
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return PublicText(fallback);
        }

        var label = value.Trim().ToLowerInvariant() switch
        {
            "active" => "Ready",
            "linked" => "Ready",
            "pending" => "Pending",
            "pending_verification" => "Confirmation sent",
            "ea_linked" => "EA linked",
            "verified" => "Confirmed",
            "published" => "Published",
            "campaign_approved" => "Campaign-approved",
            "sandbox" => "Sandbox",
            "approved" => "Approved",
            "self_service" => "Self-service",
            "current" => "Current",
            "next" => "Next",
            "completed" => "Completed",
            "review" => "Needs review",
            "warning" => "Needs attention",
            "attention" => "Needs attention",
            "ready" => "Ready",
            "revoked" => "Revoked",
            _ => System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(value.Replace('_', ' '))
        };

        return PublicText(label);
    }

    static string PublicText(string? value)
        => PublicFacingCopyHumanizer.Clean(value);

    static string RuleEnvironmentLifecycleLabel(Chummer.Campaign.Contracts.RuleEnvironmentRef environment)
        => environment.ApprovalState.Trim().ToLowerInvariant() switch
        {
            "published" => "Published",
            "approved" => "Campaign-approved",
            "self_service" => "Sandbox",
            _ => HumanizeStatus(environment.ApprovalState, "Review")
        };

    static bool IsNavigableAccountRoute(string? route)
        => !string.IsNullOrWhiteSpace(route)
            && route.StartsWith("/", StringComparison.Ordinal)
            && !route.StartsWith("//", StringComparison.Ordinal)
            && !route.Contains('\\', StringComparison.Ordinal)
            && !route.Contains('?', StringComparison.Ordinal)
            && !route.Contains('#', StringComparison.Ordinal);

    static string DescribeRecoveryRouteAction(string? route)
        => route switch
        {
            "/account/access" => "Open account access",
            "/account/work" => "Open campaign workspace",
            "/downloads" => "Open downloads",
            _ when IsNavigableAccountRoute(route) => $"Open {route}",
            _ => "Review this page"
        };

    static string RuleEnvironmentSummary(Chummer.Campaign.Contracts.RuleEnvironmentRef environment)
        => $"{environment.OwnerScope} scope · {environment.CompatibilityFingerprint} · {RuleEnvironmentLifecycleLabel(environment)}";

    static string InstallationLabelFor(
        IReadOnlyList<Chummer.Hub.Registry.Contracts.InstallLinking.ClaimedInstallationDto>? installations,
        string installationId)
    {
        var installation = installations?.FirstOrDefault(item => string.Equals(item.InstallationId, installationId, StringComparison.OrdinalIgnoreCase));
        if (installation is null)
        {
            return "Linked install";
        }

        return installation.HostLabel
            ?? installation.HeadId
            ?? installation.ArtifactId
            ?? "Linked install";
    }

    static string InstallationReleaseFor(
        IReadOnlyList<Chummer.Hub.Registry.Contracts.InstallLinking.ClaimedInstallationDto>? installations,
        string installationId)
    {
        var installation = installations?.FirstOrDefault(item => string.Equals(item.InstallationId, installationId, StringComparison.OrdinalIgnoreCase));
        if (installation is null)
        {
            return "Current preview";
        }

        return $"{installation.Version} on {installation.Channel}";
    }

    static string PlatformSummary(string? platform, string? arch)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(platform))
        {
            parts.Add(platform.Trim());
        }

        if (!string.IsNullOrWhiteSpace(arch))
        {
            parts.Add(arch.Trim());
        }

        return parts.Count == 0 ? "Current device" : string.Join(" · ", parts);
    }

    static string BuildLabOutputLaneLabel(string? kind)
        => kind?.Trim().ToLowerInvariant() switch
        {
            "character_template" => "Character template",
            "json_exchange" => "JSON exchange",
            "foundry_exchange" => "Foundry exchange",
            "sheet_viewer" => "Sheet viewer",
            "print_pdf_export" => "Print/PDF export",
            "replay_timeline" => "Replay timeline",
            "session_recap" => "Session recap",
            "runboard_state" => "Runboard state",
            "resolution_report_draft" => "ResolutionReport draft",
            "run_module" => "Run module",
            _ => HumanizeStatus(kind, "Output")
        };

    static string SponsorLifecycleStateLabel(string? status)
        => status?.Trim().ToLowerInvariant() switch
        {
            "intent_created" => "Intent recorded",
            "consented" => "Consent recorded",
            "pending_auth" => "Waiting for authorization",
            "fleet_lane_created" => "Activation requested",
            "lane_pending" => "Activation in progress",
            "waiting_for_slot" => "Queued for capacity",
            "active" => "Active",
            "stopped" => "Stopped",
            "revoked" => "Revoked",
            _ => HumanizeStatus(status, "Tracked")
        };

    static string SponsorNextSafeAction(string? status)
        => status?.Trim().ToLowerInvariant() switch
        {
            "intent_created" => "Save consent to continue this access request.",
            "consented" => "Start device authorization from the participation flow.",
            "pending_auth" => "Open the ChatGPT confirmation page and enter the one-time code.",
            "fleet_lane_created" => "Wait for activation confirmation before assigning work.",
            "lane_pending" => "Keep this page open while activation completes.",
            "waiting_for_slot" => "Stay on this page and retry for a fresh code if authorization expires.",
            "active" => "Assign bounded contribution work and track progress.",
            "stopped" => "Start a new invite when the participant is ready again.",
            "revoked" => "Open a new invite with fresh consent and authorization.",
            _ => "Open participation details and choose the latest recovery action."
        };

    static string WorkspaceDetailHref(string workspaceId) => $"/account/work/workspaces/{Uri.EscapeDataString(workspaceId)}";
    static string RunDetailHref(string runId) => $"/account/work/runs/{Uri.EscapeDataString(runId)}";
    static string BuildHandoffDetailHref(string handoffId) => $"/account/work/build-handoffs/{Uri.EscapeDataString(handoffId)}";
    static string RulesDetailHref(string entryId) => $"/account/work/rules/{Uri.EscapeDataString(entryId)}";
    static string PublicationDetailHref(string publicationId) => $"/account/work/publications/{Uri.EscapeDataString(publicationId)}";
    static string WorkspacePrepLibrarySearchHref(string workspaceId, string query) => $"/account/work/workspaces/{Uri.EscapeDataString(workspaceId)}?prepQuery={Uri.EscapeDataString(query)}";
    static string PublicCreatorPublicationHref(string publicationId) => $"/artifacts/publications/{Uri.EscapeDataString(publicationId)}";
    static bool IsDiscoverablePublicCreatorPublication(Chummer.Campaign.Contracts.CreatorPublicationProjection? publication)
        => publication is not null
            && publication.Discoverable
            && string.Equals(publication.PublicationStatus, "published", StringComparison.OrdinalIgnoreCase);
    static string CreatorPublicationLinkLabel(Chummer.Campaign.Contracts.CreatorPublicationProjection? publication)
        => IsDiscoverablePublicCreatorPublication(publication)
            ? "Open public publication"
            : "Open publication status";

    static string TrustRowValue(
        SignedInTrustStatusPanelViewModel? panel,
        string label,
        string fallback)
        => panel?.Rows.FirstOrDefault(row => string.Equals(row.Label, label, StringComparison.Ordinal))?.Value ?? fallback;

    static string FormatUtc(DateTimeOffset value)
        => value.ToUniversalTime().ToString("yyyy-MM-dd HH:mm 'UTC'");

    static string PublicationDecisionOutcomeSummary(string? publicationStatus, string? reviewState, string? moderationState)
    {
        string publication = publicationStatus?.Trim().ToLowerInvariant() ?? string.Empty;
        string review = reviewState?.Trim().ToLowerInvariant() ?? string.Empty;
        string moderation = moderationState?.Trim().ToLowerInvariant() ?? string.Empty;

        if (publication is "published")
        {
            return "Published: moderation and review are complete for this publication.";
        }

        if (publication is "archived" or "delisted")
        {
            return "Canceled: publication is not active on discovery pages.";
        }

        if (review is "rejected")
        {
            return "Paused for revision: review requested changes before this can continue.";
        }

        if (review is "pending_review" || moderation is "pending_review")
        {
            return "Paused on moderation: waiting for a review decision.";
        }

        if (review is "approved")
        {
            return "Ready to publish: review passed and waiting on explicit publish confirmation.";
        }

        return "Tracked: draft and moderation history are attached to this publication.";
    }

    static string PublicationResumabilitySummary(string? publicationStatus, string? reviewState, string? moderationState)
    {
        string publication = publicationStatus?.Trim().ToLowerInvariant() ?? string.Empty;
        string review = reviewState?.Trim().ToLowerInvariant() ?? string.Empty;
        string moderation = moderationState?.Trim().ToLowerInvariant() ?? string.Empty;

        if (publication is "archived" or "delisted")
        {
            return "Not resumable in this draft. Create a new draft when this publication should return.";
        }

        if (review is "rejected")
        {
            return "Resumable after edits. Update notes, then submit for review again.";
        }

        if (review is "pending_review" || moderation is "pending_review")
        {
            return "Resumable after moderation decision. Keep this draft open and avoid duplicate submissions.";
        }

        if (review is "approved" && publication is not "published")
        {
            return "Resumable immediately. Use Publish on the public listing to complete this draft.";
        }

        return "No recovery action needed right now.";
    }

    static string AutomationOutcomeSummary(string? summary)
    {
        string normalized = summary?.Trim().ToLowerInvariant() ?? string.Empty;
        if (normalized.Length == 0)
        {
            return "Tracked: no additional action required.";
        }

        if (normalized.Contains("retry", StringComparison.Ordinal)
            || normalized.Contains("relaunch", StringComparison.Ordinal)
            || normalized.Contains("refresh", StringComparison.Ordinal))
        {
            return "Retried: this automation has an explicit retry or resume signal.";
        }

        if (normalized.Contains("pending", StringComparison.Ordinal)
            || normalized.Contains("queued", StringComparison.Ordinal)
            || normalized.Contains("hydrate", StringComparison.Ordinal)
            || normalized.Contains("catch up", StringComparison.Ordinal))
        {
            return "Paused: waiting on downstream updates before final closure.";
        }

        if (normalized.Contains("cancel", StringComparison.Ordinal)
            || normalized.Contains("revoked", StringComparison.Ordinal)
            || normalized.Contains("stopped", StringComparison.Ordinal))
        {
            return "Canceled: this action is closed and needs a new explicit request to continue.";
        }

        return "Completed: action is attached to campaign continuity.";
    }

    static string AutomationResumabilitySummary(string? summary)
    {
        string normalized = summary?.Trim().ToLowerInvariant() ?? string.Empty;
        if (normalized.Contains("cancel", StringComparison.Ordinal)
            || normalized.Contains("revoked", StringComparison.Ordinal)
            || normalized.Contains("stopped", StringComparison.Ordinal))
        {
            return "Not resumable from this action. Start a fresh automation action if still needed.";
        }

        if (normalized.Contains("retry", StringComparison.Ordinal)
            || normalized.Contains("relaunch", StringComparison.Ordinal)
            || normalized.Contains("refresh", StringComparison.Ordinal)
            || normalized.Contains("pending", StringComparison.Ordinal)
            || normalized.Contains("queued", StringComparison.Ordinal)
            || normalized.Contains("hydrate", StringComparison.Ordinal)
            || normalized.Contains("catch up", StringComparison.Ordinal))
        {
            return "Resumable. Retry from this workspace and keep the work on the same account view.";
        }

        return "No resume action needed right now.";
    }

    var accountRailHeadline = showAccessSection
        ? "Devices and access remain the calm recovery path"
        : showSupportSection
            ? "Support and account return stay attached to this account"
            : installRailHeading;
    var accountRailSummary = showAccessSection
        ? "Relink, reclaim, recovery, and active grant review stay here after the installer or app does the real work. Do not turn this into a browser-first claim ritual."
        : showSupportSection
            ? "Tracked support stays attached to the affected install so release status, closure, and recovery never split across separate surfaces."
            : installRailSummary;
    var accountRailInstallSummary = leadInstallation is not null
        ? $"{InstallationLabelFor(Model.InstallLinking.ClaimedInstallations, leadInstallation.InstallationId)} · {PlatformSummary(leadInstallation.Platform, leadInstallation.Arch)} · {InstallationReleaseFor(Model.InstallLinking.ClaimedInstallations, leadInstallation.InstallationId)}"
        : pendingClaims > 0
            ? $"{pendingClaims} pending claim ticket(s) are still waiting on their original device."
            : "No linked install is attached yet. Open Downloads while signed in to start with the same binary and a calmer return path.";
    var accountRailRecoverySummary = leadPendingClaim is not null
        ? $"{PublicText(leadPendingClaim.ArtifactLabel)} is already staged. Use the pending code only if that copy explicitly opens in recovery mode."
        : "Recovery codes stay in reserve. The default path remains installer or in-app linking on the affected device.";
    var accountRailSupportSummary = openSupportCases > 0
        ? $"{openSupportCases} active support case(s) stay attached to this account."
        : "No active support case is blocking the next install or return path right now.";
}

<section class="account-stage">

                                    }
                                    @foreach (var conflict in selectedWorkspaceServerPlane.ContinuityConflicts)
                                    {
                                        <li><strong>@HumanizeStatus(conflict.Severity, "Info"):</strong> @conflict.Summary <span>@conflict.ResolutionAction</span></li>
                                    }
                                </ul>

                        </div>
                        <div class="settings-summary-row">
                            <span>Entitlement recovery path</span>
                            <strong>@entitlementSyncReceipts.ReceiptStatus.RecoveryRoute</strong>
                        </div>
                        <div class="settings-summary-row">
                            <span>Blocking sync conflicts</span>
                            <strong>@entitlementSyncReceipts.ReceiptStatus.BlockingConflictCount</strong>
                        </div>
                    }
                </div>
                @if (entitlementSyncReceipts is not null)
                {
                    <details class="details-drawer">
                        <summary>Entitlement sync history</summary>
                        <div class="settings-summary-list">
                            <div class="settings-summary-row">
                                <span>Status summary</span>
                                <strong>@PublicText(entitlementSyncReceipts.ReceiptStatus.Summary)</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Details</span>
                                <strong>@PublicText(entitlementSyncReceipts.ReceiptStatus.ProvenanceSummary)</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Conflict summary</span>
                                <strong>@PublicText(entitlementSyncReceipts.ReceiptStatus.ConflictSummary)</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Next step</span>
                                <strong>@PublicText(entitlementSyncReceipts.ReceiptStatus.LeadRecoveryHint)</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Recovery summary</span>
                                <strong>@PublicText(entitlementSyncReceipts.ReceiptStatus.RecoverySummary)</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Updated</span>
                                <strong>@entitlementSyncReceipts.ReceiptStatus.LatestReceiptObservedAtUtc.UtcDateTime.ToString("u")</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Access history</span>
                                <strong>@entitlementSyncReceipts.ReceiptStatus.EntitlementSyncProvenanceCount</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Access conflicts</span>
                                <strong>@entitlementSyncReceipts.ReceiptStatus.EntitlementSyncConflictCount</strong>

                        </div>
                        <div class="settings-summary-row">
                            <span>Who can get it now</span>
                            <strong>@TrustRowValue(Model.SignedInTrustStatus, "Who can get it now", "Open downloads to confirm live access.")</strong>
                        </div>
                        <div class="settings-summary-row">
                            <span>Fix availability</span>
                            <strong>@TrustRowValue(Model.SignedInTrustStatus, "Fix availability", "Open downloads to confirm whether the current linked install already has the fix.")</strong>
                        </div>
                        <div class="settings-summary-row">
                            <span>Current caution</span>
                            <strong>@TrustRowValue(Model.SignedInTrustStatus, "Current caution", "Use the current release page when you need the newest caution before you continue this install.")</strong>
                        </div>
                        @if (leadInstallation is not null)
                        {
                            <div class="settings-summary-row">

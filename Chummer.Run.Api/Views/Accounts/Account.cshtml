                                        <button class="button-like button-like--ghost" type="submit">Issue join code</button>
                                        <p class="status-copy" data-join-code-notice hidden></p>
                                        <div class="settings-summary-list" data-join-code-result hidden></div>
                                    </form>
                                    <form class="settings-form" data-boost-code-form data-group-id="@op.GroupId">
                                        <h3>Issue governed boost code</h3>
                                        @if (op.InviteCampaigns.Count > 0)
                                        {
                                            <label>
                                                Campaign lane
                                                <select name="campaignId">
                                                    @foreach (var campaign in op.InviteCampaigns)
                                                    {
                                                        <option value="@campaign.CampaignId">@campaign.CampaignName · @HumanizeStatus(campaign.Status, "Active")</option>
                                                    }
                                                </select>
                                            </label>
                                        }
                                        <label>
                                            Sponsor label
                                            <input name="label" type="text" value="community_operator" />
                                        </label>
                                        <button class="button-like button-like--ghost" type="submit">Issue boost code</button>
                                        <p class="status-copy" data-boost-code-notice hidden></p>
                                        <div class="settings-summary-list" data-boost-code-result hidden></div>
                                    </form>
                                </div>
                                <details class="details-drawer">
                                    <summary>Code recovery guide</summary>
                                    <ul class="muted-copy">
                                        <li>If a member reports a stale join code, issue a fresh code here and resend the same member guidance rail for downloads, help, and closure.</li>
                                        <li>If a sponsor code was redeemed on the wrong lane or already spent, issue a fresh boost code for the governed campaign lane instead of reusing stale sponsor state.</li>
                                        <li>Keep release, install, and support guidance on the member-guidance rail so invite recovery never depends on repo trivia.</li>

  const setRateLimitNotice = (noticeNode, error, prefix, nextSafeAction) => {
    const payload = error?.payload && typeof error.payload === "object" ? error.payload : null;
    const status = payload?.status;
    if (status !== 429) {
      return false;
    }

    const retryAfter = Number.isFinite(payload?.retryAfterSeconds) && payload.retryAfterSeconds > 0
      ? payload.retryAfterSeconds
      : null;
    const waitLabel = retryAfter
      ? `${retryAfter} second${retryAfter === 1 ? "" : "s"}`
      : "a short cooldown";
    ui.setNotice(
      noticeNode,
      `${prefix} Retry after ${waitLabel}. Next safe action: ${nextSafeAction}`,
      true);
    return true;
  };

  bindSubmit("supportAssistantForm", async (event) => {
    event.preventDefault();
    const notice = document.getElementById("supportAssistantStatusNotice");
    const button = event.currentTarget.querySelector("button[type='submit']");
    const answer = document.getElementById("supportAssistantAnswer");
    const actions = document.getElementById("supportAssistantActions");
    const citations = document.getElementById("supportAssistantCitations");
    ui.clearNotice(notice);
    answer.hidden = true;
    actions.hidden = true;
    citations.hidden = true;
    answer.textContent = "";
    actions.innerHTML = "";
    citations.innerHTML = "";
    ui.setButtonBusy(button, true, "Loading...");
    try {
      const payload = await ui.requestJson("/api/v1/support/cases/assistant", {
        method: "POST",
        json: {
          query: document.getElementById("supportAssistantQuery").value,
          installationId: document.getElementById("supportAssistantInstallation").value || null
        }
      });

      answer.textContent = payload.answer || "";
      answer.hidden = !answer.textContent;

      const actionItems = Array.isArray(payload.actions) ? payload.actions : [];
      if (actionItems.length > 0) {
        actions.hidden = false;
        for (const item of actionItems) {
          const label = (item.label || item.actionId || "").trim();
          if (!label) {
            continue;
          }

          const link = document.createElement("a");
          link.className = "button-like button-like--ghost";
          link.href = item.href || "#";
          link.textContent = label.replaceAll("_", " ");
          link.title = item.reason || "";
          actions.appendChild(link);
        }
      }

      const citationItems = Array.isArray(payload.citations) ? payload.citations : [];
      if (citationItems.length > 0) {
        citations.hidden = false;
        for (const item of citationItems) {
          const row = document.createElement("div");
          row.className = "settings-summary-row";
          const label = document.createElement("span");
          label.textContent = item.label || item.sourceKind || "source";
          const summary = document.createElement("strong");
          summary.textContent = item.summary || "";
          row.appendChild(label);
          row.appendChild(summary);
          citations.appendChild(row);
        }
      }

      const confidence = payload.confidence ? ` (${payload.confidence.replaceAll("_", " ")})` : "";
      ui.setNotice(notice, `Grounded guidance loaded${confidence}.`);
    } catch (error) {
      const rateLimited = setRateLimitNotice(
        notice,
        error,
        "Grounded guidance is pacing requests so review status timelines stay readable.",
        "Wait for the timer, then retry with one focused question or open Account > Support."
      );
      if (!rateLimited) {
        ui.setNotice(notice, ui.describeError(error, "Grounded guidance could not be loaded right now."), true);
      }
    } finally {
      ui.setButtonBusy(button, false, "Loading...");
    }
  });

  bindSubmit("supportCaseForm", async (event) => {
    event.preventDefault();
    const notice = document.getElementById("supportCaseStatusNotice");
    const button = event.currentTarget.querySelector("button[type='submit']");
    const installationSelect = document.getElementById("supportCaseInstallation");
    const attachmentsField = document.getElementById("supportCaseAttachments");
    const contextPreview = document.getElementById("supportCaseContextPreview");
    const installationOption = installationSelect.options[installationSelect.selectedIndex];
    ui.clearNotice(notice);
    ui.setButtonBusy(button, true, "Submitting...");
    try {
      const formData = new FormData();
      formData.set("kind", document.getElementById("supportCaseKind").value);
      formData.set("title", document.getElementById("supportCaseTitle").value);
      formData.set("summary", document.getElementById("supportCaseSummary").value);
      formData.set("detail", document.getElementById("supportCaseDetail").value);
      if (installationSelect.value) formData.set("installationId", installationSelect.value);
      if (installationOption?.dataset?.version) formData.set("applicationVersion", installationOption.dataset.version);
      if (installationOption?.dataset?.channel) formData.set("releaseChannel", installationOption.dataset.channel);
      if (installationOption?.dataset?.head) formData.set("headId", installationOption.dataset.head);
      if (installationOption?.dataset?.platform) formData.set("platform", installationOption.dataset.platform);
      if (installationOption?.dataset?.arch) formData.set("arch", installationOption.dataset.arch);
      Array.from(attachmentsField.files || []).forEach((file) => formData.append("attachments", file, file.name));

      const response = await fetch("/api/v1/support/cases/form", {
        method: "POST",
        headers: {
          "RequestVerificationToken": ui.getRequestVerificationToken()
        },
        body: formData,
        credentials: "same-origin"
      });

      const payload = await ui.readJsonResponse(response, "Support case could not be submitted right now.");
      window.location.href = `/account/support/${encodeURIComponent(payload.caseId)}`;
    } catch (error) {
      const rateLimited = setRateLimitNotice(
        notice,
        error,
        "Support intake is pacing requests to keep queue and closure timelines trustworthy.",
        "Wait for the timer, then submit one updated case instead of rapid retries."
      );
      if (!rateLimited) {
        ui.setNotice(notice, ui.describeError(error, "Support case could not be submitted right now."), true);
      }
    } finally {
      ui.setButtonBusy(button, false, "Submitting...");
    }
  });

  bindSubmit("ruleGhostForm", async (event) => {
    event.preventDefault();
    const notice = document.getElementById("ruleGhostStatusNotice");
    const button = event.currentTarget.querySelector("button[type='submit']");
    const answer = document.getElementById("ruleGhostAnswer");
    const followUps = document.getElementById("ruleGhostFollowUps");
    const citations = document.getElementById("ruleGhostCitations");
    ui.clearNotice(notice);
    answer.hidden = true;
    followUps.hidden = true;
    citations.hidden = true;
    answer.textContent = "";
    followUps.innerHTML = "";
    citations.innerHTML = "";
    ui.setButtonBusy(button, true, "Summarizing...");
    try {
      const payload = await ui.requestJson("/api/v1/rule-ghost/ask", {
        method: "POST",
        json: {
          query: document.getElementById("ruleGhostQuery").value,
          preferredRuleset: document.getElementById("ruleGhostRuleset").value || null
        }
      });

      answer.textContent = payload.answer || "";
      answer.hidden = !answer.textContent;

      const followUpItems = Array.isArray(payload.safeFollowUps) ? payload.safeFollowUps : [];
      if (followUpItems.length > 0) {
        followUps.hidden = false;
        for (const item of followUpItems) {
          const chip = document.createElement("span");
          chip.className = "button-like button-like--ghost";
          chip.textContent = item;
          followUps.appendChild(chip);
        }
      }

      const citationItems = Array.isArray(payload.citations) ? payload.citations : [];
      if (citationItems.length > 0) {
        citations.hidden = false;
        for (const item of citationItems) {
          const row = document.createElement("div");
          row.className = "settings-summary-row";
          const label = document.createElement("span");
          label.textContent = item.sourceLabel || "owned rulebook";
          const summary = document.createElement("strong");
          summary.textContent = [item.sectionHint, item.summary].filter(Boolean).join(" · ");
          row.appendChild(label);
          row.appendChild(summary);
          citations.appendChild(row);
        }
      }

      const confidence = payload.confidence ? ` (${payload.confidence.replaceAll("_", " ")})` : "";
      const posture = payload.refused
        ? "Rule Ghost returned a safe refusal."
        : payload.clarificationNeeded
          ? "Rule Ghost needs one more detail before it should go narrower."
          : "Rule Ghost loaded a safe summary.";
      ui.setNotice(notice, `${posture}${confidence}`);
    } catch (error) {
      const rateLimited = setRateLimitNotice(
        notice,
        error,
        "Rule Ghost is pacing requests so answers stay grounded and readable.",
        "Wait for the timer, then retry with one mechanic and one edition."
      );
      if (!rateLimited) {
        ui.setNotice(notice, ui.describeError(error, "Rule Ghost could not load right now."), true);
      }
    } finally {
      ui.setButtonBusy(button, false, "Summarizing...");
    }
  });

  const supportInstallation = document.getElementById("supportCaseInstallation");
  const supportContextPreview = document.getElementById("supportCaseContextPreview");
  const syncSupportContextPreview = () => {
    if (!supportInstallation || !supportContextPreview) return;
    const option = supportInstallation.options[supportInstallation.selectedIndex];
    if (!option || !option.value) {
      supportContextPreview.hidden = true;
      supportContextPreview.innerHTML = "";
      return;
    }

    const rows = [
      ["Linked install", option.textContent?.trim() || option.value],
      ["Version", option.dataset.version || "Unknown"],
      ["Channel", option.dataset.channel || "Unknown"],
      ["Platform", [option.dataset.platform, option.dataset.arch].filter(Boolean).join(" / ") || "Unknown"]
    ];

    supportContextPreview.hidden = false;
    supportContextPreview.innerHTML = rows.map(([label, value]) => `
      <div class="settings-summary-row">
        <span>${label}</span>
        <strong>${value}</strong>
      </div>`).join("");
  };

  syncSupportContextPreview();
  supportInstallation?.addEventListener("change", syncSupportContextPreview);

  document.querySelectorAll("[data-support-verification-outcome]").forEach((button) => {
    button.addEventListener("click", async () => {
      const notice = document.getElementById("supportVerificationStatusNotice");
      const outcome = button.getAttribute("data-support-verification-outcome");
      const caseId = button.getAttribute("data-support-case-id");
      if (!outcome || !caseId) {
        return;
      }

      let note = "";
      if (outcome === "still_broken") {
        const response = window.prompt("What still looks broken on this install? Optional, but it helps support reopen the right issue.", "");
        if (response === null) {
          return;
        }

        note = response.trim();
      }

      ui.clearNotice(notice);
      const siblingButtons = Array.from(document.querySelectorAll(`[data-support-case-id="${caseId}"]`));
      siblingButtons.forEach((item) => ui.setButtonBusy(item, true, "Saving..."));
      try {
        await ui.requestJson(`/api/v1/support/cases/${encodeURIComponent(caseId)}/verify`, {
          method: "POST",
          json: {
            outcome,
            note: note || null
          }
        });
        ui.setNotice(
          notice,
          outcome === "confirmed_fixed"
            ? "Thanks. The tracked case now shows that the fix worked on this install."
            : "Thanks. The tracked case reopened for follow-up on this install.");
        window.location.reload();
      } catch (error) {
        const rateLimited = setRateLimitNotice(
          notice,
          error,
          "Fix status is pacing repeated submissions to preserve one reliable decision timeline.",
          "Wait for the timer, then submit only the final result for this install."
        );
        if (!rateLimited) {
          ui.setNotice(notice, ui.describeError(error, "Fix status could not be recorded right now."), true);
        }
      } finally {
        siblingButtons.forEach((item) => ui.setButtonBusy(item, false, "Saving..."));
      }
    });
  });
})();
</script>
}

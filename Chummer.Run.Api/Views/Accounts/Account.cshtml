                                        <div class="field">
                                            <label for="rosterTransferNote">Operator note</label>
                                            <textarea id="rosterTransferNote" rows="3" placeholder="Why is this dossier moving between rosters, campaigns, or owners?"></textarea>
                                        </div>
                                        <button class="button-like button-like--secondary" type="submit">Transfer governed roster state</button>
                                        <p id="rosterTransferStatusNotice" class="muted-copy" hidden></p>
                                    </form>
                                </details>
                            }

                            <details class="details-drawer">

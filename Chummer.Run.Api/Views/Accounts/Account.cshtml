                                        <span>State: @HumanizeStatus(receipt.StalenessPosture, "Current")</span>
                                        <span>Recovery: @HumanizeStatus(receipt.RecoverabilityPosture, "Recoverable")</span>
                                        @if (IsNavigableAccountRoute(receipt.RecoveryRoute))
                                        {
                                            <span><a href="@receipt.RecoveryRoute">@DescribeRecoveryRouteAction(receipt.RecoveryRoute)</a></span>
                                        }
                                        <span>@receipt.RecoveryHint</span>
                                        <span>@receipt.RecoverySummary</span>
                                        <span>@HumanizeStatus(receipt.ContinuePosture, "Safe to continue")</span>
                                    </li>
                                }
                            </ul>
                        }
                        @if (entitlementSyncReceipts.ConflictReceipts.Count == 0)

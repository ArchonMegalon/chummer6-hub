                            <details class="details-drawer">
                                <summary>GM prep library and travel mode</summary>
                                <div class="settings-summary-list">
                                    <div class="settings-summary-row">
                                        <span>Governed prep packets</span>
                                        <strong>@selectedWorkspaceServerPlane.PrepLibrary.Packets.Count</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>Reusable packets</span>
                                        <strong>@selectedWorkspaceServerPlane.PrepLibrary.ReusablePacketCount</strong>
                                    </div>

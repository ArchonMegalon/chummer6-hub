                                    <span>Recent launches</span>
                                    <strong>@(selectedWorkspacePrepLaunches.Count == 0 ? "No governed binds yet" : $"{selectedWorkspacePrepLaunches.Count} receipts")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Travel-safe devices</span>
                                    <strong>@(selectedWorkspaceServerPlane.TravelMode.TravelReadyDeviceCount == 0 ? "None yet" : $"{selectedWorkspaceServerPlane.TravelMode.TravelReadyDeviceCount} ready")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Travel prefetch receipts</span>
                                    <strong>@(selectedWorkspaceTravelPrefetches.Count == 0 ? "No staged receipts yet" : $"{selectedWorkspaceTravelPrefetches.Count} staged")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Aftermath recap packages</span>
                                    <strong>@(selectedWorkspaceAftermathPackages.Count == 0 ? "No governed packages yet" : $"{selectedWorkspaceAftermathPackages.Count} packaged")</strong>
                                </div>
                            </div>
                            <p><strong>GM prep library:</strong> @selectedWorkspaceServerPlane.PrepLibrary.Summary</p>
                            <p><strong>Binding posture:</strong> @selectedWorkspaceServerPlane.PrepLibrary.BindingSummary</p>
                            <p><strong>Safehouse / travel mode:</strong> @selectedWorkspaceServerPlane.TravelMode.Summary</p>
                            <p><strong>Prefetch inventory:</strong> @selectedWorkspaceServerPlane.TravelMode.PrefetchInventorySummary</p>
                            @if (selectedWorkspaceServerPlane.TravelMode.Devices.Count > 0)
                            {
                                <form id="travelPrefetchForm" class="settings-form">
                                    <div class="field">
                                        <label for="travelPrefetchInstallation">Claimed device</label>
                                        <select id="travelPrefetchInstallation" required>
                                            @foreach (var device in selectedWorkspaceServerPlane.TravelMode.Devices)
                                            {
                                                <option value="@device.InstallationId">@device.DeviceRole · @device.Platform / @device.HeadId / @device.Channel</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="field">
                                        <label for="travelPrefetchNote">Operator note</label>
                                        <textarea id="travelPrefetchNote" rows="3" placeholder="Why are you staging this travel-safe prefetch set?"></textarea>
                                    </div>
                                    <div id="travelPrefetchPreview" class="settings-summary-list" hidden></div>
                                    <button class="button-like button-like--secondary" type="submit">Stage travel prefetch</button>
                                    <p id="travelPrefetchStatusNotice" class="muted-copy" hidden></p>
                                </form>
                            }
                            else
                            {
                                <div class="settings-form">
                                    <p><strong>Stage travel prefetch</strong></p>
                                    <p class="muted-copy">Claim a device from Downloads or Devices &amp; access first. The staged packet stays bounded to dossiers, campaigns, rule environments, recent artifacts, and governed prep packets while secrets and runtime caches stay install-local.</p>
                                    <div class="stacked-actions">
                                        <a class="button-like button-like--secondary" href="/downloads">Claim a device from Downloads</a>
                                        <a class="button-like button-like--ghost" href="/account/access">Open Devices &amp; access</a>
                                    </div>
                                </div>
                            }
                            @if (selectedWorkspaceServerPlane.PrepLibrary.Packets.Count > 0)
                            {
                                <form id="prepLaunchForm" class="settings-form">
                                    <div class="field">
                                        <label for="prepLaunchPacket">Governed packet</label>
                                        <select id="prepLaunchPacket" required>
                                            @foreach (var packet in selectedWorkspaceServerPlane.PrepLibrary.Packets)
                                            {
                                                <option value="@packet.PacketId">@packet.Title</option>
                                            }
                                        </select>
                                    </div>
                                    @if (selectedWorkspace!.Runs.Count > 0)
                                    {
                                        <div class="field">
                                            <label for="prepLaunchRun">Target run</label>
                                            <select id="prepLaunchRun">
                                                @foreach (var run in selectedWorkspace.Runs)
                                                {
                                                    <option value="@run.RunId">@run.Title</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="field">
                                            <label for="prepLaunchScene">Target scene</label>
                                            <select id="prepLaunchScene"></select>
                                        </div>
                                    }
                                    <div class="field">
                                        <label for="prepLaunchNote">Operator note</label>
                                        <textarea id="prepLaunchNote" rows="3" placeholder="Why are you launching this governed prep packet now?"></textarea>
                                    </div>
                                    <div id="prepLaunchTargetPreview" class="settings-summary-list" hidden></div>
                                    <button class="button-like button-like--secondary" type="submit">Launch governed prep packet</button>
                                    <p id="prepLaunchStatusNotice" class="muted-copy" hidden></p>
                                </form>
                            }
                            <form class="stacked-copy" method="get" action="@WorkspaceDetailHref(selectedWorkspace!.WorkspaceId)">
                                <div class="field">
                                    <label for="prepQuery">Search governed prep packets</label>
                                    <input id="prepQuery" name="prepQuery" type="search" value="@selectedWorkspacePrepLibraryQuery" placeholder="opposition, scene, safehouse, dossier..." />
                                    </div>
                                    <div class="stacked-actions">
                                        <button class="button-like button-like--secondary" type="submit">Search prep library</button>
                                        @if (!string.IsNullOrWhiteSpace(selectedWorkspacePrepLibraryQuery))
                                        {
                                            <a class="button-like button-like--ghost" href="@WorkspaceDetailHref(selectedWorkspace.WorkspaceId)">Clear search</a>
                                        }
                                    </div>
                                </form>
                                @if (!string.IsNullOrWhiteSpace(selectedWorkspacePrepLibraryQuery))
                                {
                                    <p><strong>Search results:</strong> @(selectedWorkspacePrepLibrarySearch?.TotalCount ?? 0) match(es) for "@selectedWorkspacePrepLibraryQuery".</p>
                                    @if (selectedWorkspacePrepLibrarySearch?.Items.Count > 0)
                                    {
                                        <ul class="muted-copy">
                                            @foreach (var packet in selectedWorkspacePrepLibrarySearch.Items)
                                            {
                                                <li><strong>@packet.Title:</strong> @packet.Summary <span>@packet.BindingSummary</span></li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <p class="muted-copy">No governed prep packet matched that search yet. Try campaign, scene, opposition, dossier, or safehouse terms.</p>
                                    }
                                }
                            @if (selectedWorkspaceServerPlane.PrepLibrary.Packets.Count > 0)
                            {
                                <ul class="muted-copy">
                                    @foreach (var packet in selectedWorkspaceServerPlane.PrepLibrary.Packets)
                                    {
                                        <li><strong>@packet.Title:</strong> @packet.Summary <span>@packet.BindingSummary</span></li>
                                    }
                                </ul>
                            }
                            @if (selectedWorkspacePrepLaunches.Count > 0)
                            {
                                <details class="details-drawer" id="prep-launches">
                                    <summary>Recent governed prep launches</summary>
                                    <ul class="muted-copy">
                                        @foreach (var launch in selectedWorkspacePrepLaunches)
                                        {
                                            <li><strong>@launch.PacketTitle:</strong> @launch.Summary</li>
                                        }
                                    </ul>
                                </details>
                            }
                            @if (selectedWorkspaceTravelPrefetches.Count > 0)
                            {
                                <details class="details-drawer" id="travel-prefetches">
                                    <summary>Recent travel prefetch receipts</summary>
                                    <ul class="muted-copy">
                                        @foreach (var receipt in selectedWorkspaceTravelPrefetches)
                                        {
                                            <li><strong>@receipt.DeviceRole:</strong> @receipt.PrefetchSummary</li>
                                        }
                                    </ul>
                                </details>
                            }
                            @if (selectedWorkspaceServerPlane.TravelMode.Devices.Count > 0)
                            {
                                    <ul class="muted-copy">
                                        @foreach (var device in selectedWorkspaceServerPlane.TravelMode.Devices)
                                        {
                                            <li><strong>@device.DeviceRole:</strong> @device.Platform / @device.HeadId / @device.Channel. @device.Summary</li>
                                        }
                                    </ul>
                                }
                            @if (selectedWorkspaceServerPlane.TravelMode.Boundaries.Count > 0)
                            {
                                    <ul class="muted-copy">
                                        @foreach (var boundary in selectedWorkspaceServerPlane.TravelMode.Boundaries)
                                        {
                                            <li>@boundary</li>
                                        }
                                    </ul>
                                }
                            </details>

                            <details class="details-drawer">
                                <summary>Aftermath and recap</summary>
                                <div class="settings-summary-list">
                                    <div class="settings-summary-row">
                                        <span>Publication-safe outputs</span>
                                        <strong>@selectedWorkspaceServerPlane.RecapShelf.Count</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>Aftermath recap packages</span>
                                        <strong>@(selectedWorkspaceAftermathPackages.Count == 0 ? "No governed packages yet" : $"{selectedWorkspaceAftermathPackages.Count} receipts")</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>Publication posture</span>
                                        <strong>@selectedWorkspaceServerPlane.CampaignSummary.PublicationSummary</strong>
                                    </div>
                                </div>
                                <p><strong>Return lane:</strong> @selectedWorkspace.ReturnSummary</p>
                                @if (selectedWorkspace!.Runs.Count > 0)
                                {
                                    <form id="aftermathPackageForm" class="settings-form">
                                        <div class="field">
                                            <label for="aftermathPackageRun">Run scope</label>
                                            <select id="aftermathPackageRun">
                                                @foreach (var run in selectedWorkspace.Runs)
                                                {
                                                    <option value="@run.RunId">@run.Title</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="field">
                                            <label for="aftermathPackageKind">Package kind</label>
                                            <select id="aftermathPackageKind" required>
                                                <option value="session_recap">Session recap</option>
                                                <option value="after_action_report">After-action report</option>
                                                <option value="downtime_brief">Downtime brief</option>
                                            </select>
                                        </div>
                                        <div class="field">
                                            <label for="aftermathPackageTitle">Package title</label>
                                            <input id="aftermathPackageTitle" maxlength="128" placeholder="Generated from run and package kind by default" />
                                        </div>
                                        <div class="field">
                                            <label for="aftermathPackageNote">Operator note</label>
                                            <textarea id="aftermathPackageNote" rows="3" placeholder="What aftermath or next-session follow-through should stay grounded in this package?"></textarea>
                                        </div>
                                        <div id="aftermathPackagePreview" class="settings-summary-list" hidden></div>
                                        <button class="button-like button-like--secondary" type="submit">Generate aftermath recap package</button>
                                        <p id="aftermathPackageStatusNotice" class="muted-copy" hidden></p>
                                    </form>
                                }
                                else
                                {
                                    <p class="muted-copy">Generate aftermath recap package becomes available once the workspace has a tracked run to pin into the return lane.</p>
                                }
                                @if (selectedWorkspaceAftermathPackages.Count > 0)
                                {
                                    <details class="details-drawer" id="aftermath-packages">
                                        <summary>Recent aftermath recap packages</summary>
                                        <ul class="muted-copy">
                                            @foreach (var package in selectedWorkspaceAftermathPackages)
                                            {
                                                <li><strong>@package.Title:</strong> @package.Summary</li>
                                            }
                                        </ul>
                                    </details>
                                }
                            </details>
                        }
                    </article>
                }
                else if (selectedRun is not null)
                {
                    <article class="app-action-card app-action-card--primary" id="run-@selectedRun.RunId">
                        <span class="tag">Run context</span>
                        <h3>@selectedRun.Title</h3>
                        <p>@selectedRun.Summary</p>
                        <div class="settings-summary-list">
                            <div class="settings-summary-row">
                                <span>Status</span>
                                <strong>@HumanizeStatus(selectedRun.Status, "Active")</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Active scene</span>
                                <strong>@(selectedRun.ActiveSceneId ?? "No active scene")</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Objectives</span>
                                <strong>@selectedRun.Objectives.Count</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Scenes</span>
                                <strong>@selectedRun.Scenes.Count</strong>
                            </div>
                        </div>
                        @if (selectedRun.LatestContinuity is not null)
                        {
                            <p><strong>Continuity:</strong> @selectedRun.LatestContinuity.Summary</p>
                        }
                    </article>
                }
                else if (selectedBuildLabHandoff is not null)
                {
                    <article class="app-action-card app-action-card--primary" id="build-handoff-@selectedBuildLabHandoff.HandoffId">
                        <span class="tag">Build follow-through</span>
                        <h3>@selectedBuildLabHandoff.Title</h3>
                        <p>@selectedBuildLabHandoff.Summary</p>
                        <div class="settings-summary-list">
                            <div class="settings-summary-row">
                                <span>Variant</span>
                                <strong>@selectedBuildLabHandoff.VariantLabel</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Progression</span>
                                <strong>@selectedBuildLabHandoff.ProgressionLabel</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Next safe action</span>
                                <strong>@(selectedBuildLabHandoff.NextSafeAction ?? "Review the grounded progression outcomes before you return to play.")</strong>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(selectedBuildLabHandoff.RuntimeCompatibilitySummary))
                            {
                                <div class="settings-summary-row">
                                    <span>Runtime</span>
                                    <strong>@selectedBuildLabHandoff.RuntimeCompatibilitySummary</strong>
                                </div>
                            }
                        </div>
                        @if (selectedBuildLabHandoff.TradeoffLines.Count > 0)
                        {
                            <p><strong>Tradeoffs:</strong> @string.Join(" ", selectedBuildLabHandoff.TradeoffLines)</p>
                        }
                        @if (selectedBuildLabHandoff.Outputs.Count > 0)
                        {
                            <p><strong>Outputs:</strong> @string.Join(", ", selectedBuildLabHandoff.Outputs.Select(item => item.Label))</p>
                        }
                        @if (selectedBuildLabHandoff.Watchouts is { Count: > 0 })
                        {
                            <p><strong>Watchouts:</strong> @string.Join(" ", selectedBuildLabHandoff.Watchouts)</p>
                        }
                    </article>
                }
                else if (selectedRulesNavigatorAnswer is not null)
                {
                    <article class="app-action-card app-action-card--primary" id="rules-answer-@selectedRulesNavigatorAnswer.EntryId">
                        <span class="tag">Grounded rule answer</span>
                        <h3>@selectedRulesNavigatorAnswer.Question</h3>
                        <p>@selectedRulesNavigatorAnswer.ShortAnswer</p>
                        <div class="settings-summary-list">
                            <div class="settings-summary-row">
                                <span>Before</span>
                                <strong>@selectedRulesNavigatorAnswer.BeforeSummary</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>After</span>
                                <strong>@selectedRulesNavigatorAnswer.AfterSummary</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Provenance</span>
                                <strong>@selectedRulesNavigatorAnswer.ProvenanceLabel</strong>
                            </div>
                        </div>
                        @if (selectedRulesNavigatorAnswer.EvidenceLines.Count > 0)
                        {
                            <p><strong>Evidence:</strong> @string.Join(" ", selectedRulesNavigatorAnswer.EvidenceLines.Take(3))</p>
                        }
                        @if (selectedRulesNavigatorAnswer.Diffs is { Count: > 0 })
                        {
                            <div class="settings-summary-list">
                                @foreach (var diff in selectedRulesNavigatorAnswer.Diffs.Take(2))
                                {
                                    <div class="settings-summary-row">
                                        <span>@diff.Label</span>
                                        <strong>@diff.AfterSummary</strong>
                                    </div>
                                    <p class="muted-copy">Before: @diff.BeforeSummary Why: @diff.ReasonSummary</p>
                                }
                            </div>
                        }
                    </article>
                }
                else if (selectedCreatorPublication is not null)
                {
                    <article class="app-action-card app-action-card--primary" id="publication-@selectedCreatorPublication.PublicationId">
                        <span class="tag">Publication status</span>
                        <h3>@selectedCreatorPublication.Title</h3>
                        <p>@selectedCreatorPublication.Summary</p>
                        <div class="settings-summary-list">
                            <div class="settings-summary-row">
                                <span>Trust</span>
                                <strong>@selectedCreatorPublication.ProvenanceSummary</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Discovery</span>
                                <strong>@selectedCreatorPublication.DiscoverySummary</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Status</span>
                                <strong>@HumanizeStatus(selectedCreatorPublication.PublicationStatus, "Published")</strong>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(selectedCreatorPublication.NextSafeAction))
                            {
                                <div class="settings-summary-row">
                                    <span>Next step</span>
                                    <strong>@selectedCreatorPublication.NextSafeAction</strong>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(selectedCreatorPublication.CampaignReturnSummary))
                            {
                                <div class="settings-summary-row">
                                    <span>Return</span>
                                    <strong>@selectedCreatorPublication.CampaignReturnSummary</strong>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(selectedCreatorPublication.SupportClosureSummary))
                            {
                                <div class="settings-summary-row">
                                    <span>Support</span>
                                    <strong>@selectedCreatorPublication.SupportClosureSummary</strong>
                                </div>
                            }
                        </div>
                        @if (selectedCreatorPublication.Watchouts is { Count: > 0 })
                        {
                            <p><strong>Watchouts:</strong> @string.Join(" ", selectedCreatorPublication.Watchouts.Take(3))</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(selectedCreatorPublication.BuildHandoffId))
                        {
                            <a class="inline-link" href="@BuildHandoffDetailHref(selectedCreatorPublication.BuildHandoffId)">Open related build path</a>
                        }
                    </article>
                }
                @if (Model.CampaignSpine.Workspaces.Count == 0)
                {
                    <p class="muted-copy">No shared campaign view yet. The first claimed install or campaign handoff will seed the long-lived runner identity and the first shared run view.</p>
                }
                else
                {
                    @foreach (var workspace in Model.CampaignSpine.Workspaces)
                    {
                        <details class="details-drawer">
                            <summary>@workspace.CampaignName · Campaign workspace</summary>
                            <div class="settings-summary-list">
                                <div class="settings-summary-row">
                                    <span>Visibility</span>
                                    <strong>@HumanizeStatus(workspace.Visibility, "Private")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Rule environment</span>
                                    <strong>@RuleEnvironmentSummary(workspace.RuleEnvironment)</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Current return</span>
                                    <strong>@(workspace.LatestContinuity?.Summary ?? workspace.ReturnSummary)</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Live run state</span>
                                    <strong>@(workspace.Runs.Count == 0 ? "No active run" : $"{workspace.Runs.Count} tracked")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Active scene</span>
                                    <strong>@(workspace.ActiveSceneSummary ?? "No scene pinned yet")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Next safe action</span>
                                    <strong>@(workspace.NextSafeAction ?? "Open the shared campaign view and confirm the current return lane before you continue.")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Next-session carry-forward</span>
                                    <strong>@(workspace.NextSessionCarryForward is null ? "Pending" : workspace.NextSessionCarryForward.Summary)</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Recent recap</span>
                                    <strong>@(workspace.RecapShelf.Count == 0 ? "Pending" : $"{workspace.RecapShelf.Count} ready")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Consequence ledger</span>
                                    <strong>@(workspace.Consequences is { Count: > 0 } ? $"{workspace.Consequences.Count} tracked" : "Pending")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Roster transfer audit</span>
                                    <strong>@(workspace.RosterTransfers is { Count: > 0 } ? $"{workspace.RosterTransfers.Count} receipts" : "No recent moves")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Prep launch audit</span>
                                    <strong>@(workspace.PrepLaunches is { Count: > 0 } ? $"{workspace.PrepLaunches.Count} receipts" : "No recent launches")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Travel prefetch audit</span>
                                    <strong>@(workspace.TravelPrefetches is { Count: > 0 } ? $"{workspace.TravelPrefetches.Count} receipts" : "No recent prefetches")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Aftermath recap audit</span>
                                    <strong>@(workspace.AftermathPackages is { Count: > 0 } ? $"{workspace.AftermathPackages.Count} receipts" : "No recap packages")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Downtime brief</span>
                                    <strong>@(workspace.AftermathPackages?.Any(item => string.Equals(item.PackageKind, "downtime_brief", StringComparison.OrdinalIgnoreCase)) == true ? "Ready" : "Pending")</strong>
                                </div>
                            </div>
                            <div class="stacked-actions">
                                <a class="button-like button-like--ghost" href="@WorkspaceDetailHref(workspace.WorkspaceId)">Open shared campaign view</a>
                                @if (workspace.Runs.Count > 0)
                                {
                                    <a class="button-like button-like--secondary" href="@RunDetailHref(workspace.Runs[0].RunId)">Open run context</a>
                                }
                            </div>

                            <div class="settings-summary-list">
                                @foreach (var crew in workspace.Crews)
                                {
                                    <div class="settings-summary-row">
                                        <span>@crew.Name roster</span>
                                        <strong>@crew.Members.Count members · @HumanizeStatus(crew.Visibility, "Private")</strong>
                                    </div>
                                    @foreach (var member in crew.Members)
                                    {
                                        var memberDossier = workspace.Dossiers.FirstOrDefault(dossier => string.Equals(dossier.DossierId, member.DossierId, StringComparison.OrdinalIgnoreCase));

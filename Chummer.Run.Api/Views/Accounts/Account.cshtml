@model AccountPageViewModel
@{
    var pageTitle = Model.CurrentSection switch
    {
        "support" => "Account · Support",
        "access" => "Account · Devices & access",
        "work" => "Account · Work",
        "settings" => "Account · Settings",
        "advanced" => "Account · Advanced",
        _ => "Account"
    };
    var sectionTitle = Model.CurrentSection switch
    {
        "support" => "Support",
        "access" => "Devices & access",
        "work" => "Work",
        "settings" => "Settings",
        "advanced" => "Advanced account details",
        _ => "Account"
    };
    var sectionCopy = Model.CurrentSection switch
    {
        "support" => "Open, track, and close support without leaving the account surface.",
        "access" => "Keep linked installs, access rights, and claim handoff in one calmer route.",
        "work" => "Campaign return, recent activity, and shared context stay here when you explicitly need them.",
        "settings" => "Preferences, participation, and linked channels stay out of the customer core until you ask for them.",
        "advanced" => "Account identifiers and deeper account details stay behind the advanced route.",
        _ => "Keep sign-in, recovery, devices, support, and account preferences in one calmer product settings surface."
    };
    ViewData["Title"] = pageTitle;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-account";
    var emailLink = Model.Links.LinkedIdentities.FirstOrDefault(link => string.Equals(link.Provider, "email", StringComparison.OrdinalIgnoreCase));
    var googleLink = Model.Links.LinkedIdentities.FirstOrDefault(link => string.Equals(link.Provider, "google", StringComparison.OrdinalIgnoreCase));
    var telegramChannel = Model.Links.ChannelLinks.FirstOrDefault(link => string.Equals(link.ChannelKind, "telegram_official_bot", StringComparison.OrdinalIgnoreCase));
    var laneInterests = Model.Experience.LaneInterests.ToHashSet(StringComparer.OrdinalIgnoreCase);
    var claimedInstallations = Model.InstallLinking.ClaimedInstallations?.Count ?? 0;
    var activeAccessRights = Model.InstallLinking.ActiveGrants?.Count ?? 0;
    var pendingClaims = Model.InstallLinking.PendingClaimTickets.Count;
    var openSupportCases = Model.SupportCases.Count(item => !string.Equals(item.Status, "user_notified", StringComparison.OrdinalIgnoreCase));
    var dossierCount = Model.CampaignSpine.Dossiers.Count;
    var campaignCount = Model.CampaignSpine.Campaigns.Count;
    var runCount = Model.CampaignSpine.Runs.Count;
    var workspaceCount = Model.CampaignSpine.Workspaces.Count;
    var recapProjectionCount = Model.CampaignSpine.Workspaces.SelectMany(item => item.RecapShelf).Count();
    var communityOpsCount = Model.CampaignSpine.CommunityOperations.Count;
    var restoreConflicts = Model.CampaignSpine.Restore.ConflictSummaries.Count;
    var restoreArtifactCount = Model.CampaignSpine.Restore.RecentArtifacts.Count;
    var restoreEntitlementCount = Model.CampaignSpine.Restore.Entitlements.Count;
    var restoreDeviceCount = Model.CampaignSpine.Restore.ClaimedDevices.Count;
    var buildLabHandoffCount = Model.CampaignSpine.BuildLabHandoffs.Count;
    var rulesNavigatorCount = Model.CampaignSpine.RulesNavigator.Count;
    var migrationReceiptCount = Model.CampaignSpine.MigrationReceipts.Count;
    var creatorPublicationCount = Model.CampaignSpine.CreatorPublications.Count;
    var organizerGuidanceSummary = openSupportCases == 0
        ? "Current preview, member downloads, and help stay on one calmer operator rail."
        : $"{openSupportCases} tracked support case(s), current preview truth, and member downloads stay on one calmer operator rail.";
    var showCampaignSection = dossierCount > 0 || campaignCount > 0 || runCount > 0 || workspaceCount > 0 || restoreConflicts > 0;
    var showTeamsSection = communityOpsCount > 0;
    var showChannelsSection = telegramChannel is not null;
    var showParticipationSection = Model.Experience.OnboardingCompleted || laneInterests.Count > 0 || Model.Experience.FollowHorizons || Model.Experience.BetaInterest;
    var showProfileSection = string.Equals(Model.CurrentSection, "profile", StringComparison.OrdinalIgnoreCase);
    var showSupportSection = string.Equals(Model.CurrentSection, "support", StringComparison.OrdinalIgnoreCase);
    var showAccessSection = string.Equals(Model.CurrentSection, "access", StringComparison.OrdinalIgnoreCase);
    var showWorkSection = string.Equals(Model.CurrentSection, "work", StringComparison.OrdinalIgnoreCase);
    var showSettingsSection = string.Equals(Model.CurrentSection, "settings", StringComparison.OrdinalIgnoreCase);
    var showAdvancedSection = string.Equals(Model.CurrentSection, "advanced", StringComparison.OrdinalIgnoreCase);
    var selectedSupportCase = Model.SelectedSupportCase;
    var selectedSupportCaseSummary = Model.SelectedSupportCaseSummary;
    var selectedSupportInstallationId = selectedSupportCase?.InstallationId;
    var selectedWorkspace = Model.SelectedWorkspace;
    var selectedWorkspaceServerPlane = Model.SelectedWorkspaceServerPlane;
    var selectedWorkspaceRosterTransferPlan = Model.SelectedWorkspaceRosterTransferPlan;
    var selectedWorkspacePrepLibrarySearch = Model.SelectedWorkspacePrepLibrarySearch;
    var selectedWorkspacePrepLibraryQuery = Model.SelectedWorkspacePrepLibraryQuery;
    var selectedWorkspaceNextSessionCarryForward = selectedWorkspaceServerPlane?.NextSessionCarryForward;
    var selectedWorkspacePrepLaunches = selectedWorkspaceServerPlane?.PrepLaunches ?? Array.Empty<Chummer.Campaign.Contracts.GovernedPrepLaunchProjection>();
    var selectedWorkspaceTravelPrefetches = selectedWorkspaceServerPlane?.TravelPrefetches ?? Array.Empty<Chummer.Campaign.Contracts.TravelPrefetchReceiptProjection>();
    var selectedWorkspaceAftermathPackages = selectedWorkspaceServerPlane?.AftermathPackages ?? Array.Empty<Chummer.Campaign.Contracts.AftermathRecapPackageProjection>();
    var selectedWorkspaceLeadAftermathPackage = selectedWorkspaceAftermathPackages
        .FirstOrDefault(item => !string.Equals(item.PackageKind, "downtime_brief", StringComparison.OrdinalIgnoreCase));
    var selectedWorkspaceDowntimePackage = selectedWorkspaceAftermathPackages
        .FirstOrDefault(item => string.Equals(item.PackageKind, "downtime_brief", StringComparison.OrdinalIgnoreCase));
    var selectedRun = Model.SelectedRun;
    var selectedBuildLabHandoff = Model.SelectedBuildLabHandoff;
    var selectedRulesNavigatorAnswer = Model.SelectedRulesNavigatorAnswer;
    var selectedCreatorPublication = Model.SelectedCreatorPublication;
    var openCampaignDetailSection = selectedWorkspace is not null
        || selectedRun is not null
        || selectedBuildLabHandoff is not null
        || selectedRulesNavigatorAnswer is not null
        || selectedCreatorPublication is not null;

    static string HumanizeStatus(string? value, string fallback = "Not connected")
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallback;
        }

        return value.Trim().ToLowerInvariant() switch
        {
            "active" => "Ready",
            "linked" => "Ready",
            "pending" => "Pending",
            "pending_verification" => "Verification sent",
            "verified" => "Verified",
            "approved" => "Approved",
            "self_service" => "Self-service",
            "review" => "Needs review",
            "warning" => "Needs attention",
            "attention" => "Needs attention",
            "ready" => "Ready",
            "revoked" => "Revoked",
            _ => System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(value.Replace('_', ' '))
        };
    }

    static string RuleEnvironmentSummary(Chummer.Campaign.Contracts.RuleEnvironmentRef environment)
        => $"{environment.OwnerScope} scope · {environment.CompatibilityFingerprint} · {HumanizeStatus(environment.ApprovalState, "Review")}";

    static string InstallationLabelFor(
        IReadOnlyList<Chummer.Hub.Registry.Contracts.InstallLinking.ClaimedInstallationDto>? installations,
        string installationId)
    {
        var installation = installations?.FirstOrDefault(item => string.Equals(item.InstallationId, installationId, StringComparison.OrdinalIgnoreCase));
        if (installation is null)
        {
            return "Linked install";
        }

        return installation.HostLabel
            ?? installation.HeadId
            ?? installation.ArtifactId
            ?? "Linked install";
    }

    static string InstallationReleaseFor(
        IReadOnlyList<Chummer.Hub.Registry.Contracts.InstallLinking.ClaimedInstallationDto>? installations,
        string installationId)
    {
        var installation = installations?.FirstOrDefault(item => string.Equals(item.InstallationId, installationId, StringComparison.OrdinalIgnoreCase));
        if (installation is null)
        {
            return "Current preview";
        }

        return $"{installation.Version} on {installation.Channel}";
    }

    static string PlatformSummary(string? platform, string? arch)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(platform))
        {
            parts.Add(platform.Trim());
        }

        if (!string.IsNullOrWhiteSpace(arch))
        {
            parts.Add(arch.Trim());
        }

        return parts.Count == 0 ? "Current device" : string.Join(" · ", parts);
    }

    static string WorkspaceDetailHref(string workspaceId) => $"/account/work/workspaces/{Uri.EscapeDataString(workspaceId)}";
    static string RunDetailHref(string runId) => $"/account/work/runs/{Uri.EscapeDataString(runId)}";
    static string BuildHandoffDetailHref(string handoffId) => $"/account/work/build-handoffs/{Uri.EscapeDataString(handoffId)}";
    static string RulesDetailHref(string entryId) => $"/account/work/rules/{Uri.EscapeDataString(entryId)}";
    static string PublicationDetailHref(string publicationId) => $"/account/work/publications/{Uri.EscapeDataString(publicationId)}";
}

<section class="account-stage">
    <div class="sr-only" aria-hidden="true">
        @Html.AntiForgeryToken()
    </div>
    <div class="account-stage__lead">
        <p class="eyebrow">Account</p>
        <h1 class="page-title">@sectionTitle</h1>
        <p class="page-copy">@sectionCopy</p>
    </div>

    @if (showProfileSection)
    {
        <div class="account-overview">
            <article class="account-overview__card">
                <span class="tag">Primary sign-in</span>
                <strong>@HumanizeStatus(Model.Links.RecommendedPrimaryAuth, "Choose one")</strong>
            </article>
            <article class="account-overview__card">
                <span class="tag">Recovery</span>
                <strong>@(emailLink is null ? "Add one" : HumanizeStatus(emailLink.Status, "Add one"))</strong>
            </article>
            <article class="account-overview__card">
                <span class="tag">Devices &amp; access</span>
                <strong>@(activeAccessRights > 0 ? $"{activeAccessRights} active" : claimedInstallations > 0 ? $"{claimedInstallations} linked" : "Ready to link")</strong>
            </article>
            <article class="account-overview__card">
                <span class="tag">Support</span>
                <strong>@(openSupportCases == 0 ? "Quiet" : $"{openSupportCases} active")</strong>
            </article>
        </div>
    }

    <div class="account-shell">
        <aside class="account-nav" aria-label="Account sections">
            <p class="eyebrow">Core settings</p>
            @foreach (var navItem in Model.CoreSections)
            {
                <a href="@navItem.Href" aria-current="@(navItem.Current ? "page" : "false")">@navItem.Label</a>
            }
            <details class="details-drawer">
                <summary>More settings</summary>
                <div class="stacked-actions">
                    @foreach (var navItem in Model.SecondarySections)
                    {
                        <a href="@navItem.Href" aria-current="@(navItem.Current ? "page" : "false")">@navItem.Label</a>
                    }
                </div>
            </details>
        </aside>

        <div class="account-pane">
            @if (showProfileSection)
            {
            <section id="profile" class="settings-section" data-account-panel>
                <div class="settings-section__header">
                    <h2>Profile</h2>
                    <p>Keep the visible identity clear, stable, and easy to recognize.</p>
                </div>
                <form id="profileForm" class="settings-form">
                    <div class="field">
                        <label for="displayName">Display name</label>
                        <input id="displayName" value="@Model.User.DisplayName" />
                    </div>
                    <div class="field">
                        <label for="handle">Handle</label>
                        <input id="handle" value="@Model.User.Handle" />
                    </div>
                    <div class="field">
                        <label for="timezone">Timezone</label>
                        <input id="timezone" value="@Model.User.Timezone" />
                    </div>
                    <button class="button-like button-like--primary" type="submit">Save profile</button>
                    <p id="profileStatusNotice" class="muted-copy" hidden></p>
                </form>
            </section>

            <details class="details-drawer">
                <summary>Primary sign-in</summary>
                <section id="sign-in" class="settings-section" data-account-panel>
                    <div class="settings-section__header">
                        <h2>Primary sign-in</h2>
                        <p>Keep the daily sign-in path visible here without turning the profile route into a second full settings page.</p>
                    </div>
                    <div class="settings-summary-list">
                        <div class="settings-summary-row">
                            <span>Primary sign-in</span>
                            <strong>@HumanizeStatus(Model.Links.RecommendedPrimaryAuth, "Choose one")</strong>
                        </div>
                        <div class="settings-summary-row">
                            <span>Google</span>
                            <strong>@(googleLink is null ? (Model.GoogleAvailable ? "Not linked" : "Unavailable on this host") : $"Connected ({HumanizeStatus(googleLink.Status, "Ready")})")</strong>
                        </div>
                        <div class="settings-summary-row">
                            <span>Email</span>
                            <strong>@(emailLink is null ? "Not linked" : $"{emailLink.DisplayLabel} ({HumanizeStatus(emailLink.Status, "Ready")})")</strong>
                        </div>
                    </div>
                    @if (Model.GoogleAvailable)
                    {
                        <div class="stacked-actions">
                            <a class="button-like button-like--secondary" href="/auth/google/link?next=/account/profile">@(googleLink is null ? "Link Google" : "Refresh Google link")</a>
                        </div>
                    }
                </section>
            </details>

            <details class="details-drawer">
                <summary>Recovery email</summary>
                <section id="recovery" class="settings-section" data-account-panel>
                    <div class="settings-section__header">
                        <h2>Recovery email</h2>
                        <p>Add a verified backup path so one sign-in method is never the whole story.</p>
                    </div>
                    <div class="settings-summary-row">
                        <span>Status</span>
                        <strong id="recoveryEmailStatus">@(emailLink is null ? "Missing" : HumanizeStatus(emailLink.Status, "Missing"))</strong>
                    </div>
                    <form id="recoveryForm" class="settings-form">
                        <div class="field">
                            <label for="recoveryEmail">Recovery email</label>
                            <input id="recoveryEmail" type="email" placeholder="runner@example.com" />
                        </div>
                        <button class="button-like button-like--secondary" type="submit">Start verification</button>
                        <p id="recoveryStatusNotice" class="muted-copy" hidden></p>
                    </form>
                </section>
            </details>
            }

            @if (showSettingsSection && showChannelsSection)
            {
                <details class="details-drawer">
                    <summary>Linked channels</summary>
                    <section id="channels" class="settings-section" data-account-panel>
                        <div class="settings-section__header">
                            <h2>Linked channels</h2>
                            <p>Companion channels stay separate from account access and recovery.</p>
                        </div>
                        <div class="settings-summary-row">
                            <span>Telegram companion</span>
                            <strong>@(telegramChannel is null ? "Not connected" : $"{telegramChannel.DisplayLabel} ({HumanizeStatus(telegramChannel.Status, "Ready")})")</strong>
                        </div>
                        <form id="telegramForm" class="settings-form">
                            <div class="field">
                                <label for="telegramHandle">Telegram handle</label>
                                <input id="telegramHandle" placeholder="@@hubbrain" value="@(telegramChannel?.DisplayLabel ?? string.Empty)" />
                            </div>
                            <button class="button-like button-like--secondary" type="submit">Connect Telegram</button>
                            <p id="telegramStatusNotice" class="muted-copy" hidden></p>
                        </form>
                    </section>
                </details>
            }

            @if (showSupportSection)
            {
            <section id="support" class="settings-section" data-account-panel>
                <div class="settings-section__header">
                    <h2>Support</h2>
                    <p>Report a bug, confusing copy, install trouble, or product feedback without leaving the account surface. Visible status stays attached to the case instead of disappearing into email.</p>
                </div>
                @if (selectedSupportCase is not null)
                {
                    <article class="app-action-card app-action-card--primary" id="case-@selectedSupportCase.CaseId">
                        <span class="tag">Tracked case</span>
                        <h3>@selectedSupportCase.Title</h3>
                        <p>@selectedSupportCase.Summary</p>
                        <div class="settings-summary-list">
                            <div class="settings-summary-row">
                                <span>Case id</span>
                                <strong>@selectedSupportCase.CaseId</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Status</span>
                                <strong>@(selectedSupportCaseSummary?.StatusLabel ?? HumanizeStatus(selectedSupportCase.Status, "New"))</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Current stage</span>
                                <strong>@(selectedSupportCaseSummary?.StageLabel ?? "Tracked case")</strong>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(selectedSupportCaseSummary?.FixedReleaseLabel))
                            {
                                <div class="settings-summary-row">
                                    <span>Reporter-ready release</span>
                                    <strong>@selectedSupportCaseSummary.FixedReleaseLabel</strong>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(selectedSupportCaseSummary?.AffectedInstallSummary))
                            {
                                <div class="settings-summary-row">
                                    <span>Affected install</span>
                                    <strong>@selectedSupportCaseSummary.AffectedInstallSummary</strong>
                                </div>
                            }
                            <div class="settings-summary-row">
                                <span>Follow-up lane</span>
                                <strong>@(selectedSupportCaseSummary?.FollowUpLaneSummary ?? "Follow-up stays attached to this case id.")</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Updated</span>
                                <strong>@(selectedSupportCaseSummary?.UpdatedLabel ?? selectedSupportCase.UpdatedAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") + " UTC")</strong>
                            </div>
                        </div>
                        @if (selectedSupportCaseSummary is not null)
                        {
                            <div class="stacked-copy">
                                <p><strong>Next safe action:</strong> @selectedSupportCaseSummary.NextSafeAction</p>
                                <p><strong>Closure:</strong> @selectedSupportCaseSummary.ClosureSummary</p>
                                <p><strong>Release progress:</strong> @selectedSupportCaseSummary.ReleaseProgressSummary</p>
                                <p><strong>Linked install state:</strong> @selectedSupportCaseSummary.InstallReadinessSummary</p>
                                <p><strong>Fix confirmation:</strong> @selectedSupportCaseSummary.VerificationSummary</p>
                            </div>
                            <div class="stacked-actions">
                                @if (string.Equals(selectedSupportCaseSummary.PrimaryActionHref, "/downloads", StringComparison.OrdinalIgnoreCase))
                                {
                                    <a class="button-like button-like--secondary" href="@selectedSupportCaseSummary.PrimaryActionHref">@selectedSupportCaseSummary.PrimaryActionLabel</a>
                                }
                                @if (selectedSupportCaseSummary.CanVerifyFix)
                                {
                                    <button class="button-like button-like--primary" type="button" data-support-verification-outcome="confirmed_fixed" data-support-case-id="@selectedSupportCase.CaseId">Fix worked here</button>
                                    <button class="button-like button-like--ghost" type="button" data-support-verification-outcome="still_broken" data-support-case-id="@selectedSupportCase.CaseId">Still broken</button>
                                }
                            </div>
                            @if (selectedSupportCaseSummary.CanVerifyFix)
                            {
                                <p id="supportVerificationStatusNotice" class="muted-copy" hidden></p>
                            }
                        }
                        @if (selectedSupportCase.Attachments is { Count: > 0 })
                        {
                            <details class="details-drawer">
                                <summary>Saved attachments</summary>
                                <div class="settings-summary-list">
                                    @foreach (var attachment in selectedSupportCase.Attachments)
                                    {
                                        <div class="settings-summary-row">
                                            <span>@attachment.FileName</span>
                                            <strong>
                                                @($"{attachment.SizeBytes / 1024.0:F1} KB")
                                                @if (!string.IsNullOrWhiteSpace(attachment.DownloadHref))
                                                {
                                                    <a class="inline-link" href="@attachment.DownloadHref">Download</a>
                                                }
                                            </strong>
                                        </div>
                                    }
                                </div>
                            </details>
                        }
                        @if (selectedSupportCaseSummary?.TimelineHighlights is { Count: > 0 })
                        {
                            <details class="details-drawer">
                                <summary>Case timeline</summary>
                                <div class="settings-summary-list">
                                    @foreach (var eventItem in selectedSupportCaseSummary.TimelineHighlights)
                                    {
                                        <div class="settings-summary-row">
                                            <span>@eventItem.OccurredLabel · @eventItem.Label</span>
                                            <strong>@eventItem.Summary</strong>
                                        </div>
                                    }
                                </div>
                            </details>
                        }
                    </article>
                }
                <div class="settings-summary-list">
                    <div class="settings-summary-row">
                        <span>Open or active cases</span>
                        <strong>@openSupportCases</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Total recent cases</span>
                        <strong>@Model.SupportCases.Count</strong>
                    </div>
                </div>
                <details class="details-drawer">
                    <summary>Need routing help first?</summary>
                    <form id="supportAssistantForm" class="settings-form">
                        <div class="field">
                            <label for="supportAssistantQuery">Ask the grounded support assistant</label>
                            <textarea id="supportAssistantQuery" rows="4" placeholder="What changed, what still hurts, or what do you need help understanding?"></textarea>
                        </div>
                        <div class="field">
                            <label for="supportAssistantInstallation">Related install</label>
                            <select id="supportAssistantInstallation">
                                <option value="" selected="@(string.IsNullOrWhiteSpace(selectedSupportInstallationId) ? "selected" : null)">Any install or no install yet</option>
                                @foreach (var installation in Model.InstallLinking.ClaimedInstallations ?? Array.Empty<Chummer.Hub.Registry.Contracts.InstallLinking.ClaimedInstallationDto>())
                                {
                                    <option value="@installation.InstallationId" selected="@(string.Equals(selectedSupportInstallationId, installation.InstallationId, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@((installation.HostLabel ?? installation.InstallationId) + $" · {installation.Version} · {installation.Channel}")</option>
                                }
                            </select>
                        </div>
                        <button class="button-like button-like--secondary" type="submit">Check guidance</button>
                        <p id="supportAssistantStatusNotice" class="muted-copy" hidden></p>
                        <div id="supportAssistantAnswer" class="stacked-copy" hidden></div>
                        <div id="supportAssistantActions" class="stacked-actions" hidden></div>
                        <div id="supportAssistantCitations" class="settings-summary-list" hidden></div>
                    </form>
                </details>
                <form id="supportCaseForm" class="settings-form">
                    <div class="field">
                        <label for="supportCaseKind">Case type</label>
                        <select id="supportCaseKind">
                            <option value="bug_report">Bug report</option>
                            <option value="feedback">Feedback</option>
                            <option value="install_help">Install or update help</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="supportCaseInstallation">Related install</label>
                        <select id="supportCaseInstallation">
                            <option value="">No specific install</option>
                            @foreach (var installation in Model.InstallLinking.ClaimedInstallations ?? Array.Empty<Chummer.Hub.Registry.Contracts.InstallLinking.ClaimedInstallationDto>())
                            {
                                <option
                                    value="@installation.InstallationId"
                                    data-version="@installation.Version"
                                    data-channel="@installation.Channel"
                                    data-head="@installation.HeadId"
                                    data-platform="@installation.Platform"
                                    data-arch="@installation.Arch">@((installation.HostLabel ?? installation.InstallationId) + $" · {installation.Version} · {installation.Channel}")</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="supportCaseTitle">Short title</label>
                        <input id="supportCaseTitle" maxlength="160" placeholder="Update prompt was unclear on Linux" />
                    </div>
                    <div class="field">
                        <label for="supportCaseSummary">One-line summary</label>
                        <input id="supportCaseSummary" maxlength="280" placeholder="The updater offered a restart but did not explain what was staged." />
                    </div>
                    <div class="field">
                        <label for="supportCaseDetail">What happened</label>
                        <textarea id="supportCaseDetail" rows="6" placeholder="Tell Chummer what you expected, what actually happened, and anything that would help route the fix."></textarea>
                    </div>
                    <div class="field">
                        <label for="supportCaseAttachments">Attachments</label>
                        <input id="supportCaseAttachments" type="file" multiple accept=".png,.jpg,.jpeg,.webp,.txt,.log,.json,.zip,.md" />
                        <p class="muted-copy">Attach screenshots, logs, or a small archive when that will route the case faster.</p>
                    </div>
                    <div id="supportCaseContextPreview" class="settings-summary-list" hidden></div>
                    <button class="button-like button-like--primary" type="submit">Submit support case</button>
                    <p id="supportCaseStatusNotice" class="muted-copy" hidden></p>
                </form>
                @if (Model.SupportCases.Count == 0)
                {
                    <p class="muted-copy">No support cases yet. New reports will show up here with routing, release, and notification state.</p>
                }
                else
                {
                    <div class="settings-summary-list">
                        @foreach (var supportCase in Model.SupportCaseSummaries)
                        {
                            <div class="settings-summary-row">
                                <span>
                                    <a class="inline-link" href="@supportCase.DetailHref">@supportCase.Case.Title</a>
                                    <span class="muted-copy">@supportCase.ClosureSummary</span>
                                </span>
                                <strong>
                                    @supportCase.StatusLabel · @supportCase.UpdatedLabel
                                </strong>
                            </div>
                        }
                    </div>
                }
            </section>
            }

            @if (showAccessSection)
            {
            <section id="devices-access" class="settings-section" data-account-panel>
                <div class="settings-section__header">
                    <h2>Devices &amp; access</h2>
                    <p>Keep linked installs, preview access, and download handoff in one place. Technical claim details stay available, but they do not need to be the first thing you read.</p>
                </div>
                <div class="settings-summary-list">
                    <div class="settings-summary-row">
                        <span>Recent install handoffs</span>
                        <strong>@Model.InstallLinking.RecentReceipts.Count</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Waiting to finish on another device</span>
                        <strong>@Model.InstallLinking.PendingClaimTickets.Count</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Claimed installs</span>
                        <strong>@claimedInstallations</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Access rights</span>
                        <strong>@activeAccessRights</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Cross-device recovery</span>
                        <strong>@(restoreArtifactCount == 0 && restoreEntitlementCount == 0 ? "Ready to seed" : $"{restoreArtifactCount} artifacts · {restoreEntitlementCount} entitlements")</strong>
                    </div>
                </div>
                @if (Model.InstallLinking.RecentReceipts.Count == 0)
                {
                    <p class="muted-copy">No account-linked downloads yet. Start from the recommended installer while signed in if you want this account attached to the next copy you install.</p>
                }
                else
                {
                    <div class="settings-summary-list">
                        @foreach (var receipt in Model.InstallLinking.RecentReceipts)
                        {
                            <div class="settings-summary-row">
                                <span>@receipt.ArtifactLabel</span>
                                <strong>@receipt.Version on @receipt.Channel · @receipt.IssuedAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</strong>
                            </div>
                        }
                    </div>
                }
                @if (claimedInstallations > 0)
                {
                    <details class="details-drawer">
                        <summary>Linked installs</summary>
                        <div class="settings-summary-list">
                            @foreach (var installation in Model.InstallLinking.ClaimedInstallations!)
                            {
                                <div class="settings-summary-row">
                                    <span>@(installation.HostLabel ?? installation.HeadId ?? installation.ArtifactId)</span>
                                    <strong>@installation.Version on @installation.Channel · @PlatformSummary(installation.Platform, installation.Arch) · @HumanizeStatus(installation.Status, "Active")</strong>
                                </div>
                            }
                        </div>
                    </details>
                }
                @if (activeAccessRights > 0)
                {
                    <details class="details-drawer">
                        <summary>Access rights</summary>
                        <div class="settings-summary-list">
                            @foreach (var grant in Model.InstallLinking.ActiveGrants!)
                            {
                                <div class="settings-summary-row">
                                    <span>@InstallationLabelFor(Model.InstallLinking.ClaimedInstallations, grant.InstallationId)</span>
                                    <strong>Preview access on @InstallationReleaseFor(Model.InstallLinking.ClaimedInstallations, grant.InstallationId) until @grant.ExpiresAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</strong>
                                </div>
                            }
                        </div>
                    </details>
                }
                @if (pendingClaims > 0)
                {
                    <details class="details-drawer">
                        <summary>Finish on another device</summary>
                        <p class="muted-copy">Use these codes only on the device that is opening the already-downloaded build for the first time.</p>
                        <div class="settings-summary-list">
                            @foreach (var ticket in Model.InstallLinking.PendingClaimTickets)
                            {
                                <div class="settings-summary-row">
                                    <span>@ticket.ArtifactLabel</span>
                                    <strong>
                                        <code class="mono-receipt" id="claim-code-@ticket.ClaimCode">@ticket.ClaimCode</code>
                                        · use before @ticket.ExpiresAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC
                                        <button class="button-like button-like--ghost" type="button" data-copy-source="claim-code-@ticket.ClaimCode">Copy</button>
                                    </strong>
                                </div>
                            }
                        </div>
                    </details>
                }
                <div class="stacked-actions">
                    <a class="button-like button-like--secondary" href="/downloads">Open downloads</a>
                    <a class="button-like button-like--ghost" href="/help#install-update">How install linking works</a>
                </div>
                <details class="details-drawer">
                    <summary>Advanced device recovery</summary>
                    <div class="settings-summary-list">
                        <div class="settings-summary-row">
                            <span>Recovery devices</span>
                            <strong>@(restoreDeviceCount == 0 ? "None yet" : restoreDeviceCount.ToString())</strong>
                        </div>
                        <div class="settings-summary-row">
                            <span>Rules snapshots</span>
                            <strong>@(Model.CampaignSpine.Restore.RecentRuleEnvironments.Count == 0 ? "Pending" : Model.CampaignSpine.Restore.RecentRuleEnvironments.Count.ToString())</strong>
                        </div>
                        <div class="settings-summary-row">
                            <span>Artifacts</span>
                            <strong>@(restoreArtifactCount == 0 ? "Pending" : restoreArtifactCount.ToString())</strong>
                        </div>
                        <div class="settings-summary-row">
                            <span>Entitlements</span>
                            <strong>@(restoreEntitlementCount == 0 ? "Pending" : restoreEntitlementCount.ToString())</strong>
                        </div>
                    </div>
                    @if (Model.CampaignSpine.Restore.ClaimedDevices.Count > 0)
                    {
                        <details class="details-drawer">
                            <summary>Offline-ready return</summary>
                            <ul class="muted-copy">
                                @foreach (var device in Model.CampaignSpine.Restore.ClaimedDevices)
                                {
                                    <li><strong>@device.DeviceRole</strong>: @device.Platform / @device.HeadId / @device.Channel. @device.RestoreSummary</li>
                                }
                            </ul>
                        </details>
                    }
                    @if (Model.CampaignSpine.Restore.RecentRuleEnvironments.Count > 0)
                    {
                        <details class="details-drawer">
                            <summary>Rules snapshots</summary>
                            <ul class="muted-copy">
                                @foreach (var environment in Model.CampaignSpine.Restore.RecentRuleEnvironments)
                                {
                                    <li>@RuleEnvironmentSummary(environment)</li>
                                }
                            </ul>
                        </details>
                    }
                    @if (Model.CampaignSpine.Restore.RecentArtifacts.Count > 0)
                    {
                        <details class="details-drawer">
                            <summary>Artifacts and reconnect receipts</summary>
                            <ul class="muted-copy">
                                @foreach (var artifact in Model.CampaignSpine.Restore.RecentArtifacts)
                                {
                                    <li><strong>@artifact.Label</strong>: @artifact.Summary</li>
                                }
                            </ul>
                        </details>
                    }
                    @if (Model.CampaignSpine.Restore.Entitlements.Count > 0)
                    {
                        <details class="details-drawer">
                            <summary>Entitlements</summary>
                            <ul class="muted-copy">
                                @foreach (var entitlement in Model.CampaignSpine.Restore.Entitlements)
                                {
                                    <li><strong>@entitlement.Label</strong>: @entitlement.Summary</li>
                                }
                            </ul>
                        </details>
                    }
                    <details class="details-drawer">
                        <summary>What stays on this device</summary>
                        <ul class="muted-copy">
                            @foreach (var note in Model.CampaignSpine.Restore.LocalOnlyNotes)
                            {
                                <li>@note</li>
                            }
                        </ul>
                    </details>
                </details>
            </section>
            }

            @if (showWorkSection || showSettingsSection)
            {
            <details class="details-drawer" open>
                <summary>@(showWorkSection ? "Work" : "More settings and policy")</summary>

            @if (showWorkSection && !showCampaignSection && !showTeamsSection)
            {
                <section class="settings-section" data-account-panel id="workspaces-empty">
                    <div class="settings-section__header">
                        <h2>Work</h2>
                        <p>No campaign return, team role, or shared activity is attached to this account yet. When that changes, this route keeps the deeper work surfaces separate from the customer core.</p>
                    </div>
                    <div class="stacked-actions">
                        <a class="button-like button-like--secondary" href="/home">Return to home</a>
                        <a class="button-like button-like--ghost" href="/downloads">Open downloads</a>
                    </div>
                </section>
            }

            @if (showWorkSection && showCampaignSection)
            {
            <details class="details-drawer"@Html.Raw(openCampaignDetailSection ? " open" : string.Empty)>
            <summary>Campaigns &amp; dossiers</summary>
            <section id="campaigns" class="settings-section" data-account-panel>
                <div class="settings-section__header">
                    <h2>Campaigns &amp; dossiers</h2>
                    <p>Shared campaign views, living dossiers, rules answers, live runs, recap material, and recovery signals stay tied together here instead of falling back to one-off files.</p>
                </div>
                <div class="settings-summary-list">
                    <div class="settings-summary-row">
                        <span>Living dossiers</span>
                        <strong>@dossierCount</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Shared campaign views</span>
                        <strong>@(workspaceCount == 0 ? "Ready to seed" : workspaceCount.ToString())</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Active runs</span>
                        <strong>@(runCount == 0 ? "Quiet" : runCount.ToString())</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Recent recaps</span>
                        <strong>@(recapProjectionCount == 0 ? "None yet" : recapProjectionCount.ToString())</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Restore conflicts</span>
                        <strong>@(restoreConflicts == 0 ? "None" : restoreConflicts.ToString())</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Open support cases</span>
                        <strong>@(openSupportCases == 0 ? "None" : openSupportCases.ToString())</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Build paths</span>
                        <strong>@(buildLabHandoffCount == 0 ? "Pending" : buildLabHandoffCount.ToString())</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Grounded rule answers</span>
                        <strong>@(rulesNavigatorCount == 0 ? "Pending" : rulesNavigatorCount.ToString())</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Legacy migration receipts</span>
                        <strong>@(migrationReceiptCount == 0 ? "None yet" : migrationReceiptCount.ToString())</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Creator publication shelf</span>
                        <strong>@(creatorPublicationCount == 0 ? "Pending" : creatorPublicationCount.ToString())</strong>
                    </div>
                </div>
                @if (selectedWorkspace is not null)
                {
                    <article class="app-action-card app-action-card--primary" id="workspace-@selectedWorkspace.WorkspaceId">
                        <span class="tag">Shared campaign view</span>
                        <h3>@selectedWorkspace.CampaignName</h3>
                        <p>@(selectedWorkspaceServerPlane?.CampaignSummary.SessionReadinessSummary ?? selectedWorkspace.ReturnSummary)</p>
                        <div class="settings-summary-list">
                            <div class="settings-summary-row">
                                <span>Visibility</span>
                                <strong>@HumanizeStatus(selectedWorkspace.Visibility, "Private")</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Reference context</span>
                                <strong>@RuleEnvironmentSummary(selectedWorkspace.RuleEnvironment)</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Device role</span>
                                <strong>@(selectedWorkspaceServerPlane?.Workspace.DeviceRoleSummary ?? "No claimed device role is attached yet.")</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Live runs</span>
                                <strong>@(selectedWorkspace.Runs.Count == 0 ? "No active run" : $"{selectedWorkspace.Runs.Count} tracked")</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Active scene</span>
                                <strong>@(selectedWorkspace.ActiveSceneSummary ?? "No active scene summary yet")</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Support follow-through</span>
                                <strong>@(selectedWorkspaceServerPlane?.Workspace.SupportClosureSummary ?? "Support follow-through stays attached to the linked install and release lane that reopen this shared campaign view.")</strong>
                            </div>
                            <div class="settings-summary-row">
                                <span>Next safe action</span>
                                <strong>
                                    @if (!string.IsNullOrWhiteSpace(selectedWorkspaceServerPlane?.NextSafeAction.Label))
                                    {
                                        @selectedWorkspaceServerPlane.NextSafeAction.Label
                                    }
                                    else if (!string.IsNullOrWhiteSpace(selectedWorkspace.NextSafeAction))
                                    {
                                        @selectedWorkspace.NextSafeAction
                                    }
                                    else
                                    {
                                        <text>Open the shared campaign view and confirm the current return lane before you continue.</text>
                                    }
                                </strong>
                            </div>
                        </div>
                        <div class="stacked-copy">
                            @if (selectedWorkspace.LatestContinuity is not null)
                            {
                                <p><strong>Current return:</strong> @selectedWorkspace.LatestContinuity.Summary</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(selectedWorkspaceServerPlane?.CampaignSummary.RestoreSummary))
                            {
                                <p><strong>Restore posture:</strong> @selectedWorkspaceServerPlane.CampaignSummary.RestoreSummary</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(selectedWorkspaceServerPlane?.NextSafeAction.Summary))
                            {
                                <p><strong>Follow-through:</strong> @selectedWorkspaceServerPlane.NextSafeAction.Summary</p>
                            }
                            @if (selectedWorkspaceServerPlane is not null)
                            {
                                <p><strong>GM prep:</strong> @selectedWorkspaceServerPlane.PrepLibrary.Summary</p>
                                <p><strong>Travel mode:</strong> @selectedWorkspaceServerPlane.TravelMode.Summary</p>
                            }
                            @if (selectedWorkspace.RecapShelf.Count > 0)
                            {
                                <p><strong>Recent recap:</strong> @selectedWorkspace.RecapShelf[0].Summary</p>
                            }
                            @if (selectedWorkspaceLeadAftermathPackage is not null)
                            {
                                <p><strong>Lead aftermath package:</strong> @selectedWorkspaceLeadAftermathPackage.Summary</p>
                            }
                            @if (selectedWorkspaceDowntimePackage is not null)
                            {
                                <p><strong>Downtime brief:</strong> @selectedWorkspaceDowntimePackage.Summary</p>
                            }
                            @if (selectedWorkspaceNextSessionCarryForward is not null)
                            {
                                <p><strong>Next-session carry-forward:</strong> @selectedWorkspaceNextSessionCarryForward.Summary</p>
                            }
                            @if (selectedWorkspace.ChangePackets is { Count: > 0 })
                            {
                                <p><strong>Recent change:</strong> @selectedWorkspace.ChangePackets[0].Label — @selectedWorkspace.ChangePackets[0].Summary</p>
                            }
                            @if (selectedWorkspace.Consequences is { Count: > 0 })
                            {
                                <p><strong>Lead consequence:</strong> @selectedWorkspace.Consequences[0].Label — @selectedWorkspace.Consequences[0].Summary</p>
                            }
                            @if (selectedWorkspace.RosterTransfers is { Count: > 0 })
                            {
                                <p><strong>Lead transfer:</strong> @selectedWorkspace.RosterTransfers[0].Summary</p>
                            }
                        </div>
                        @if (selectedWorkspaceServerPlane is not null)
                        {
                            <details class="details-drawer" open>
                                <summary>What changed for me</summary>
                                <div class="settings-summary-list">
                                    <div class="settings-summary-row">
                                        <span>Workspace state</span>
                                        <strong>@selectedWorkspaceServerPlane.WorkspaceState.Label</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>Why it changed</span>
                                        <strong>@selectedWorkspaceServerPlane.WorkspaceState.Summary</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>Roster readiness</span>
                                        <strong>@selectedWorkspaceServerPlane.RosterReadiness.Summary</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>Publication summary</span>
                                        <strong>@selectedWorkspaceServerPlane.CampaignSummary.PublicationSummary</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>Next safe action</span>
                                        <strong>@selectedWorkspaceServerPlane.NextSafeAction.Label · @selectedWorkspaceServerPlane.NextSafeAction.Summary</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>Next-session carry-forward</span>
                                        <strong>@(selectedWorkspaceNextSessionCarryForward is null ? "Pending" : $"{selectedWorkspaceNextSessionCarryForward.Label} · {selectedWorkspaceNextSessionCarryForward.Summary}")</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>Recent change</span>
                                        <strong>@(selectedWorkspaceServerPlane.ChangePackets.Count == 0 ? "No recent packet" : $"{selectedWorkspaceServerPlane.ChangePackets[0].Label} · {selectedWorkspaceServerPlane.ChangePackets[0].Summary}")</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>Transfer audit</span>
                                        <strong>@(selectedWorkspaceServerPlane.RosterTransfers.Count == 0 ? "No recent moves" : $"{selectedWorkspaceServerPlane.RosterTransfers.Count} receipts")</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>Aftermath packages</span>
                                        <strong>@(selectedWorkspaceAftermathPackages.Count == 0 ? "No governed packages yet" : $"{selectedWorkspaceAftermathPackages.Count} receipts")</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>Downtime brief</span>
                                        <strong>@(selectedWorkspaceDowntimePackage is null ? "Pending" : selectedWorkspaceDowntimePackage.Summary)</strong>
                                    </div>
                                </div>
                                @if (selectedWorkspaceServerPlane.WorkspaceState.EvidenceLines.Count > 0)
                                {
                                    <ul class="muted-copy">
                                        @foreach (var evidence in selectedWorkspaceServerPlane.WorkspaceState.EvidenceLines)
                                        {
                                            <li>@evidence</li>
                                        }
                                    </ul>
                                }
                                @if (selectedWorkspaceServerPlane.SupportClosures.Count > 0)
                                {
                                    <ul class="muted-copy">
                                        @foreach (var closure in selectedWorkspaceServerPlane.SupportClosures)
                                        {
                                            <li><strong>@closure.StageLabel:</strong> @closure.Summary <span>Next: @closure.NextSafeAction</span></li>
                                        }
                                    </ul>
                                }
                                @if (selectedWorkspaceServerPlane.KnownIssues.Count > 0)
                                {
                                    <ul class="muted-copy">
                                        @foreach (var issue in selectedWorkspaceServerPlane.KnownIssues)
                                        {
                                            <li><strong>@HumanizeStatus(issue.Severity, "Info"):</strong> @issue.Summary</li>
                                        }
                                    </ul>
                                }
                                @if (selectedWorkspaceServerPlane.DecisionNotices.Count > 0)
                                {
                                    <ul class="muted-copy">
                                        @foreach (var notice in selectedWorkspaceServerPlane.DecisionNotices)
                                        {
                                            <li><strong>@notice.ActionLabel:</strong> @notice.Summary</li>
                                        }
                                    </ul>
                                }
                            </details>

                            @if (selectedWorkspaceNextSessionCarryForward is not null)
                            {
                                <details id="selected-next-session-carry-forward" class="details-drawer" open>
                                    <summary>Next-session carry-forward</summary>
                                    <div class="settings-summary-list">
                                        <div class="settings-summary-row">
                                            <span>Carry-forward summary</span>
                                            <strong>@selectedWorkspaceNextSessionCarryForward.Summary</strong>
                                        </div>
                                        <div class="settings-summary-row">
                                            <span>Return lane</span>
                                            <strong>@selectedWorkspaceNextSessionCarryForward.ReturnSummary</strong>
                                        </div>
                                        <div class="settings-summary-row">
                                            <span>Next step</span>
                                            <strong>@selectedWorkspaceNextSessionCarryForward.NextSafeAction</strong>
                                        </div>
                                    </div>
                                    @if (selectedWorkspaceNextSessionCarryForward.EvidenceLines.Count > 0)
                                    {
                                        <ul class="muted-copy">
                                            @foreach (var evidence in selectedWorkspaceNextSessionCarryForward.EvidenceLines)
                                            {
                                                <li>@evidence</li>
                                            }
                                        </ul>
                                    }
                                </details>
                            }

                            @if (selectedWorkspaceDowntimePackage is not null)
                            {
                                <details id="selected-downtime-brief" class="details-drawer">
                                    <summary>Downtime brief</summary>
                                    <div class="settings-summary-list">
                                        <div class="settings-summary-row">
                                            <span>Downtime summary</span>
                                            <strong>@selectedWorkspaceDowntimePackage.Summary</strong>
                                        </div>
                                        @if (selectedWorkspaceNextSessionCarryForward is not null)
                                        {
                                            <div class="settings-summary-row">
                                                <span>Next-session return</span>
                                                <strong>@selectedWorkspaceNextSessionCarryForward.Summary</strong>
                                            </div>
                                        }
                                    </div>
                                    @if (selectedWorkspaceDowntimePackage.EvidenceLines.Count > 0)
                                    {
                                        <ul class="muted-copy">
                                            @foreach (var evidence in selectedWorkspaceDowntimePackage.EvidenceLines)
                                            {
                                                <li>@evidence</li>
                                            }
                                        </ul>
                                    }
                                </details>
                            }

                            <details class="details-drawer">
                                <summary>Roster readiness and dossier freshness</summary>
                                <ul class="muted-copy">
                                    @foreach (var highlight in selectedWorkspaceServerPlane.RosterReadiness.Highlights)
                                    {
                                        <li>@highlight</li>
                                    }
                                    @foreach (var dossierCue in selectedWorkspaceServerPlane.DossierFreshness)
                                    {
                                        <li><strong>@dossierCue.RunnerHandle:</strong> @dossierCue.Summary</li>
                                    }
                                </ul>
                            </details>

                            @if (selectedWorkspaceServerPlane.RosterTransfers.Count > 0)
                            {
                                <details class="details-drawer">
                                    <summary>Roster transfer audit</summary>
                                    <ul class="muted-copy">
                                        @foreach (var transfer in selectedWorkspaceServerPlane.RosterTransfers)
                                        {
                                            <li>
                                                <strong>@transfer.RunnerHandle:</strong> @transfer.Summary
                                                @foreach (var auditLine in transfer.AuditLines)
                                                {
                                                    <span> @auditLine</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (selectedWorkspaceRosterTransferPlan is not null
                                && selectedWorkspaceRosterTransferPlan.DossierOptions.Count > 0
                                && selectedWorkspaceRosterTransferPlan.TargetGroups.Count > 0)
                            {
                                <details class="details-drawer">
                                    <summary>Move governed roster state</summary>
                                    <div class="settings-summary-list">
                                        <div class="settings-summary-row">
                                            <span>Movable dossiers</span>
                                            <strong>@selectedWorkspaceRosterTransferPlan.DossierOptions.Count</strong>
                                        </div>
                                        <div class="settings-summary-row">
                                            <span>Target operator groups</span>
                                            <strong>@selectedWorkspaceRosterTransferPlan.TargetGroups.Count</strong>
                                        </div>
                                        <div class="settings-summary-row">
                                            <span>Source campaign</span>
                                            <strong>@selectedWorkspaceRosterTransferPlan.SourceCampaignName</strong>
                                        </div>
                                    </div>
                                    <p><strong>Roster transfer:</strong> @selectedWorkspaceRosterTransferPlan.Summary</p>
                                    <form id="rosterTransferForm" class="settings-form">
                                        <div class="field">
                                            <label for="rosterTransferDossier">Dossier</label>
                                            <select id="rosterTransferDossier">
                                                @foreach (var dossier in selectedWorkspaceRosterTransferPlan.DossierOptions)
                                                {
                                                    <option value="@dossier.DossierId">@dossier.DisplayName · @dossier.RunnerHandle · owner @dossier.CurrentOwnerDisplayName</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="field">
                                            <label for="rosterTransferGroup">Target group</label>
                                            <select id="rosterTransferGroup">
                                                @foreach (var target in selectedWorkspaceRosterTransferPlan.TargetGroups)
                                                {
                                                    <option value="@target.GroupId">@target.GroupName · @HumanizeStatus(target.OperatorRole, "Operator")</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="field">
                                            <label for="rosterTransferOwner">Target owner</label>
                                            <select id="rosterTransferOwner"></select>
                                        </div>
                                        <div class="field">
                                            <label for="rosterTransferCampaignTitle">Target campaign title</label>
                                            <input id="rosterTransferCampaignTitle" placeholder="Use the target group's active campaign or create a transfer campaign" />

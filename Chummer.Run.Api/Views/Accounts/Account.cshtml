    } finally {
      ui.setButtonBusy(button, false, "Staging...");
    }
  });

  bindSubmit("aftermathPackageForm", async (event) => {
    event.preventDefault();
    const notice = document.getElementById("aftermathPackageStatusNotice");
    const button = event.currentTarget.querySelector("button[type='submit']");
    const runSelect = document.getElementById("aftermathPackageRun");
    const kindSelect = document.getElementById("aftermathPackageKind");
    const titleInput = document.getElementById("aftermathPackageTitle");
    const noteInput = document.getElementById("aftermathPackageNote");
    if (!kindSelect || !selectedWorkspaceId) {
      return;
    }

    ui.clearNotice(notice);
    ui.setButtonBusy(button, true, "Packaging...");

@model AccountPageViewModel
@{
    var pageTitle = Model.CurrentSection switch
    {
        "support" => "Account · Support",
        "access" => "Account · Devices & access",
        "work" => "Account · Workspaces",
        "settings" => "Account · Settings",
        "advanced" => "Account · Advanced",
        _ => "Account"
    };
    var sectionTitle = Model.CurrentSection switch
    {
        "support" => "Support",
        "access" => "Devices & access",
        "work" => "Workspaces and continuity",
        "settings" => "Settings",
        "advanced" => "Advanced account details",
        _ => "Account"
    };
    var sectionCopy = Model.CurrentSection switch
    {
        "support" => "Open, track, and close support without leaving the signed-in shell.",
        "access" => "Keep linked installs, access rights, and claim handoff in one calmer route.",
        "work" => "Campaign continuity, work-return surfaces, and team posture stay here when you explicitly need them.",
        "settings" => "Preferences, participation, and linked channels stay out of the customer core until you ask for them.",
        "advanced" => "Raw identifiers and technical account detail stay behind an explicit advanced route.",
        _ => "Keep sign-in, recovery, devices, support, and account preferences in one calmer product settings surface."
    };
    ViewData["Title"] = pageTitle;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-account";
    var emailLink = Model.Links.LinkedIdentities.FirstOrDefault(link => string.Equals(link.Provider, "email", StringComparison.OrdinalIgnoreCase));
    var googleLink = Model.Links.LinkedIdentities.FirstOrDefault(link => string.Equals(link.Provider, "google", StringComparison.OrdinalIgnoreCase));
    var telegramChannel = Model.Links.ChannelLinks.FirstOrDefault(link => string.Equals(link.ChannelKind, "telegram_official_bot", StringComparison.OrdinalIgnoreCase));
    var laneInterests = Model.Experience.LaneInterests.ToHashSet(StringComparer.OrdinalIgnoreCase);
    var claimedInstallations = Model.InstallLinking.ClaimedInstallations?.Count ?? 0;
    var activeAccessRights = Model.InstallLinking.ActiveGrants?.Count ?? 0;
    var pendingClaims = Model.InstallLinking.PendingClaimTickets.Count;
    var openSupportCases = Model.SupportCases.Count(item => !string.Equals(item.Status, "user_notified", StringComparison.OrdinalIgnoreCase));
    var dossierCount = Model.CampaignSpine.Dossiers.Count;
    var campaignCount = Model.CampaignSpine.Campaigns.Count;
    var runCount = Model.CampaignSpine.Runs.Count;
    var workspaceCount = Model.CampaignSpine.Workspaces.Count;
    var recapProjectionCount = Model.CampaignSpine.Workspaces.SelectMany(item => item.RecapShelf).Count();
    var communityOpsCount = Model.CampaignSpine.CommunityOperations.Count;
    var restoreConflicts = Model.CampaignSpine.Restore.ConflictSummaries.Count;
    var restoreArtifactCount = Model.CampaignSpine.Restore.RecentArtifacts.Count;
    var restoreEntitlementCount = Model.CampaignSpine.Restore.Entitlements.Count;
    var restoreDeviceCount = Model.CampaignSpine.Restore.ClaimedDevices.Count;
    var buildLabHandoffCount = Model.CampaignSpine.BuildLabHandoffs.Count;
    var rulesNavigatorCount = Model.CampaignSpine.RulesNavigator.Count;
    var migrationReceiptCount = Model.CampaignSpine.MigrationReceipts.Count;
    var creatorPublicationCount = Model.CampaignSpine.CreatorPublications.Count;
    var showCampaignSection = dossierCount > 0 || campaignCount > 0 || runCount > 0 || workspaceCount > 0 || restoreConflicts > 0;
    var showTeamsSection = communityOpsCount > 0;
    var showChannelsSection = telegramChannel is not null;
    var showParticipationSection = Model.Experience.OnboardingCompleted || laneInterests.Count > 0 || Model.Experience.FollowHorizons || Model.Experience.BetaInterest;
    var showProfileSection = string.Equals(Model.CurrentSection, "profile", StringComparison.OrdinalIgnoreCase);
    var showSupportSection = string.Equals(Model.CurrentSection, "support", StringComparison.OrdinalIgnoreCase);
    var showAccessSection = string.Equals(Model.CurrentSection, "access", StringComparison.OrdinalIgnoreCase);
    var showWorkSection = string.Equals(Model.CurrentSection, "work", StringComparison.OrdinalIgnoreCase);
    var showSettingsSection = string.Equals(Model.CurrentSection, "settings", StringComparison.OrdinalIgnoreCase);
    var showAdvancedSection = string.Equals(Model.CurrentSection, "advanced", StringComparison.OrdinalIgnoreCase);

    static string HumanizeStatus(string? value, string fallback = "Not connected")
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallback;
        }

        return value.Trim().ToLowerInvariant() switch
        {
            "active" => "Ready",
            "linked" => "Ready",
            "pending" => "Pending",
            "pending_verification" => "Verification sent",
            "verified" => "Verified",
            "approved" => "Approved",
            "self_service" => "Self-service",
            "review" => "Needs review",
            "warning" => "Needs attention",
            "attention" => "Needs attention",
            "ready" => "Ready",
            "revoked" => "Revoked",
            _ => System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(value.Replace('_', ' '))
        };
    }

    static string RuleEnvironmentSummary(Chummer.Campaign.Contracts.RuleEnvironmentRef environment)
        => $"{environment.OwnerScope} scope · {environment.CompatibilityFingerprint} · {HumanizeStatus(environment.ApprovalState, "Review")}";
}

<section class="account-stage">
    <div class="sr-only" aria-hidden="true">
        @Html.AntiForgeryToken()
    </div>
    <div class="account-stage__lead">
        <p class="eyebrow">Account</p>
        <h1 class="page-title">@sectionTitle</h1>
        <p class="page-copy">@sectionCopy</p>
    </div>

    @if (showProfileSection)
    {
        <div class="account-overview">
            <article class="account-overview__card">
                <span class="tag">Primary sign-in</span>
                <strong>@HumanizeStatus(Model.Links.RecommendedPrimaryAuth, "Choose one")</strong>
            </article>
            <article class="account-overview__card">
                <span class="tag">Recovery</span>
                <strong>@(emailLink is null ? "Add one" : HumanizeStatus(emailLink.Status, "Add one"))</strong>
            </article>
            <article class="account-overview__card">
                <span class="tag">Devices &amp; access</span>
                <strong>@(activeAccessRights > 0 ? $"{activeAccessRights} active" : claimedInstallations > 0 ? $"{claimedInstallations} linked" : "Ready to link")</strong>
            </article>
            <article class="account-overview__card">
                <span class="tag">Support</span>
                <strong>@(openSupportCases == 0 ? "Quiet" : $"{openSupportCases} active")</strong>
            </article>
        </div>
    }

    <div class="account-shell">
        <aside class="account-nav" aria-label="Account sections">
            <p class="eyebrow">Core settings</p>
            @foreach (var navItem in Model.CoreSections)
            {
                <a href="@navItem.Href" aria-current="@(navItem.Current ? "page" : "false")">@navItem.Label</a>
            }
            <details class="details-drawer">
                <summary>More settings</summary>
                <div class="stacked-actions">
                    @foreach (var navItem in Model.SecondarySections)
                    {
                        <a href="@navItem.Href" aria-current="@(navItem.Current ? "page" : "false")">@navItem.Label</a>
                    }
                </div>
            </details>
        </aside>

        <div class="account-pane">
            @if (showProfileSection)
            {
            <section id="profile" class="settings-section" data-account-panel>
                <div class="settings-section__header">
                    <h2>Profile</h2>
                    <p>Keep the visible identity clear, stable, and easy to recognize.</p>
                </div>
                <form id="profileForm" class="settings-form">
                    <div class="field">
                        <label for="displayName">Display name</label>
                        <input id="displayName" value="@Model.User.DisplayName" />
                    </div>
                    <div class="field">
                        <label for="handle">Handle</label>
                        <input id="handle" value="@Model.User.Handle" />
                    </div>
                    <div class="field">
                        <label for="timezone">Timezone</label>
                        <input id="timezone" value="@Model.User.Timezone" />
                    </div>
                    <button class="button-like button-like--primary" type="submit">Save profile</button>
                    <p id="profileStatusNotice" class="muted-copy" hidden></p>
                </form>
            </section>

            <section id="sign-in" class="settings-section" data-account-panel>
                <div class="settings-section__header">
                    <h2>Primary sign-in</h2>
                    <p>Choose the sign-in path that feels stable for daily use, then keep recovery separate.</p>
                </div>
                <div class="settings-summary-list">
                    <div class="settings-summary-row">
                        <span>Primary sign-in</span>
                        <strong>@HumanizeStatus(Model.Links.RecommendedPrimaryAuth, "Choose one")</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Google</span>
                        <strong>@(googleLink is null ? (Model.GoogleAvailable ? "Not linked" : "Unavailable on this host") : $"Connected ({HumanizeStatus(googleLink.Status, "Ready")})")</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Email</span>
                        <strong>@(emailLink is null ? "Not linked" : $"{emailLink.DisplayLabel} ({HumanizeStatus(emailLink.Status, "Ready")})")</strong>
                    </div>
                </div>
                @if (Model.GoogleAvailable)
                {
                    <a class="button-like button-like--secondary" href="/auth/google/link?next=/account">@(googleLink is null ? "Link Google" : "Refresh Google link")</a>
                }
            </section>

            <section id="recovery" class="settings-section" data-account-panel>
                <div class="settings-section__header">
                    <h2>Recovery email</h2>
                    <p>Add a verified backup path so one sign-in method is never the whole story.</p>
                </div>
                <div class="settings-summary-row">
                    <span>Status</span>
                    <strong id="recoveryEmailStatus">@(emailLink is null ? "Missing" : HumanizeStatus(emailLink.Status, "Missing"))</strong>
                </div>
                <form id="recoveryForm" class="settings-form">
                    <div class="field">
                        <label for="recoveryEmail">Recovery email</label>
                        <input id="recoveryEmail" type="email" placeholder="runner@example.com" />
                    </div>
                    <button class="button-like button-like--secondary" type="submit">Start verification</button>
                    <p id="recoveryStatusNotice" class="muted-copy" hidden></p>
                </form>
            </section>
            }

            @if (showSettingsSection && showChannelsSection)
            {
                <details class="details-drawer">
                    <summary>Linked channels</summary>
                    <section id="channels" class="settings-section" data-account-panel>
                        <div class="settings-section__header">
                            <h2>Linked channels</h2>
                            <p>Companion channels stay separate from account access and recovery.</p>
                        </div>
                        <div class="settings-summary-row">
                            <span>Telegram companion</span>
                            <strong>@(telegramChannel is null ? "Not connected" : $"{telegramChannel.DisplayLabel} ({HumanizeStatus(telegramChannel.Status, "Ready")})")</strong>
                        </div>
                        <form id="telegramForm" class="settings-form">
                            <div class="field">
                                <label for="telegramHandle">Telegram handle</label>
                                <input id="telegramHandle" placeholder="@@hubbrain" value="@(telegramChannel?.DisplayLabel ?? string.Empty)" />
                            </div>
                            <button class="button-like button-like--secondary" type="submit">Connect Telegram</button>
                            <p id="telegramStatusNotice" class="muted-copy" hidden></p>
                        </form>
                    </section>
                </details>
            }

            @if (showSupportSection)
            {
            <section id="support" class="settings-section" data-account-panel>
                <div class="settings-section__header">
                    <h2>Support</h2>
                    <p>Report a bug, confusing copy, install trouble, or product feedback without leaving the account surface. Visible status stays attached to the case instead of disappearing into email.</p>
                </div>
                <div class="settings-summary-list">
                    <div class="settings-summary-row">
                        <span>Open or active cases</span>
                        <strong>@openSupportCases</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Total recent cases</span>
                        <strong>@Model.SupportCases.Count</strong>
                    </div>
                </div>
                <form id="supportAssistantForm" class="settings-form">
                    <div class="field">
                        <label for="supportAssistantQuery">Ask the grounded support assistant</label>
                        <textarea id="supportAssistantQuery" rows="4" placeholder="What changed, what still hurts, or what do you need help understanding?"></textarea>
                    </div>
                    <div class="field">
                        <label for="supportAssistantInstallation">Related install</label>
                        <select id="supportAssistantInstallation">
                            <option value="">Any install or no install yet</option>
                            @foreach (var installation in Model.InstallLinking.ClaimedInstallations ?? Array.Empty<Chummer.Hub.Registry.Contracts.InstallLinking.ClaimedInstallationDto>())
                            {
                                <option value="@installation.InstallationId">@((installation.HostLabel ?? installation.InstallationId) + $" · {installation.Version} · {installation.Channel}")</option>
                            }
                        </select>
                    </div>
                    <button class="button-like button-like--secondary" type="submit">Check guidance</button>
                    <p id="supportAssistantStatusNotice" class="muted-copy" hidden></p>
                    <div id="supportAssistantAnswer" class="stacked-copy" hidden></div>
                    <div id="supportAssistantActions" class="stacked-actions" hidden></div>
                    <div id="supportAssistantCitations" class="settings-summary-list" hidden></div>
                </form>
                <form id="supportCaseForm" class="settings-form">
                    <div class="field">
                        <label for="supportCaseKind">Case type</label>
                        <select id="supportCaseKind">
                            <option value="bug_report">Bug report</option>
                            <option value="feedback">Feedback</option>
                            <option value="install_help">Install or update help</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="supportCaseInstallation">Related install</label>
                        <select id="supportCaseInstallation">
                            <option value="">No specific install</option>
                            @foreach (var installation in Model.InstallLinking.ClaimedInstallations ?? Array.Empty<Chummer.Hub.Registry.Contracts.InstallLinking.ClaimedInstallationDto>())
                            {
                                <option
                                    value="@installation.InstallationId"
                                    data-version="@installation.Version"
                                    data-channel="@installation.Channel"
                                    data-head="@installation.HeadId"
                                    data-platform="@installation.Platform"
                                    data-arch="@installation.Arch">@((installation.HostLabel ?? installation.InstallationId) + $" · {installation.Version} · {installation.Channel}")</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="supportCaseTitle">Short title</label>
                        <input id="supportCaseTitle" maxlength="160" placeholder="Update prompt was unclear on Linux" />
                    </div>
                    <div class="field">
                        <label for="supportCaseSummary">One-line summary</label>
                        <input id="supportCaseSummary" maxlength="280" placeholder="The updater offered a restart but did not explain what was staged." />
                    </div>
                    <div class="field">
                        <label for="supportCaseDetail">What happened</label>
                        <textarea id="supportCaseDetail" rows="6" placeholder="Tell Chummer what you expected, what actually happened, and anything that would help route the fix."></textarea>
                    </div>
                    <button class="button-like button-like--primary" type="submit">Submit support case</button>
                    <p id="supportCaseStatusNotice" class="muted-copy" hidden></p>
                </form>
                @if (Model.SupportCases.Count == 0)
                {
                    <p class="muted-copy">No support cases yet. New reports will show up here with routing, release, and notification state.</p>
                }
                else
                {
                    <div class="settings-summary-list">
                        @foreach (var supportCase in Model.SupportCases)
                        {
                            <div class="settings-summary-row">
                                <span>@supportCase.Title</span>
                                <strong>@HumanizeStatus(supportCase.Status, "New") · @supportCase.UpdatedAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</strong>
                            </div>
                        }
                    </div>
                }
            </section>
            }

            @if (showAccessSection)
            {
            <section id="devices-access" class="settings-section" data-account-panel>
                <div class="settings-section__header">
                    <h2>Devices &amp; access</h2>
                    <p>Keep linked installs, preview access, and download handoff in one place. Technical claim details stay available, but they do not need to be the first thing you read.</p>
                </div>
                <div class="settings-summary-list">
                    <div class="settings-summary-row">
                        <span>Recent download receipts</span>
                        <strong>@Model.InstallLinking.RecentReceipts.Count</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Pending claim tickets</span>
                        <strong>@Model.InstallLinking.PendingClaimTickets.Count</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Claimed installs</span>
                        <strong>@claimedInstallations</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Access rights</span>
                        <strong>@activeAccessRights</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Roaming restore packet</span>
                        <strong>@(restoreArtifactCount == 0 && restoreEntitlementCount == 0 ? "Ready to seed" : $"{restoreArtifactCount} artifacts · {restoreEntitlementCount} entitlements")</strong>
                    </div>
                </div>
                @if (Model.InstallLinking.RecentReceipts.Count == 0)
                {
                    <p class="muted-copy">No account-linked downloads yet. Start from the recommended installer while signed in if you want this account attached to the next copy you install.</p>
                }
                else
                {
                    <div class="settings-summary-list">
                        @foreach (var receipt in Model.InstallLinking.RecentReceipts)
                        {
                            <div class="settings-summary-row">
                                <span>@receipt.ArtifactLabel</span>
                                <strong>@receipt.Version on @receipt.IssuedAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</strong>
                            </div>
                        }
                    </div>
                }
                @if (claimedInstallations > 0)
                {
                    <details class="details-drawer">
                        <summary>Linked installs</summary>
                        <div class="settings-summary-list">
                            @foreach (var installation in Model.InstallLinking.ClaimedInstallations!)
                            {
                                <div class="settings-summary-row">
                                    <span>@(installation.HostLabel ?? installation.HeadId ?? installation.ArtifactId)</span>
                                    <strong>@installation.Version on @installation.Channel (@HumanizeStatus(installation.Status, "Active"))</strong>
                                </div>
                            }
                        </div>
                    </details>
                }
                @if (activeAccessRights > 0)
                {
                    <details class="details-drawer">
                        <summary>Access rights</summary>
                        <div class="settings-summary-list">
                            @foreach (var grant in Model.InstallLinking.ActiveGrants!)
                            {
                                <div class="settings-summary-row">
                                    <span>@grant.InstallationId</span>
                                    <strong>@HumanizeStatus(grant.Status, "Active") until @grant.ExpiresAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</strong>
                                </div>
                            }
                        </div>
                    </details>
                }
                @if (pendingClaims > 0)
                {
                    <details class="details-drawer">
                        <summary>Technical handoff details and claim codes</summary>
                        <p class="muted-copy">Use these codes only when you are linking an already-downloaded copy back to this account on first launch.</p>
                        <div class="settings-summary-list">
                            @foreach (var ticket in Model.InstallLinking.PendingClaimTickets)
                            {
                                <div class="settings-summary-row">
                                    <span>@ticket.ArtifactLabel</span>
                                    <strong>
                                        <code class="mono-receipt" id="claim-code-@ticket.ClaimCode">@ticket.ClaimCode</code>
                                        until @ticket.ExpiresAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC
                                        <button class="button-like button-like--ghost" type="button" data-copy-source="claim-code-@ticket.ClaimCode">Copy</button>
                                    </strong>
                                </div>
                            }
                        </div>
                    </details>
                }
                <div class="stacked-actions">
                    <a class="button-like button-like--secondary" href="/downloads">Open downloads</a>
                    <a class="button-like button-like--ghost" href="/help#install-update">How install linking works</a>
                </div>
                <details class="details-drawer">
                    <summary>Advanced continuity and restore</summary>
                    <div class="settings-summary-list">
                        <div class="settings-summary-row">
                            <span>Claimed restore devices</span>
                            <strong>@(restoreDeviceCount == 0 ? "None yet" : restoreDeviceCount.ToString())</strong>
                        </div>
                        <div class="settings-summary-row">
                            <span>Rule environments</span>
                            <strong>@(Model.CampaignSpine.Restore.RecentRuleEnvironments.Count == 0 ? "Pending" : Model.CampaignSpine.Restore.RecentRuleEnvironments.Count.ToString())</strong>
                        </div>
                        <div class="settings-summary-row">
                            <span>Artifacts</span>
                            <strong>@(restoreArtifactCount == 0 ? "Pending" : restoreArtifactCount.ToString())</strong>
                        </div>
                        <div class="settings-summary-row">
                            <span>Entitlements</span>
                            <strong>@(restoreEntitlementCount == 0 ? "Pending" : restoreEntitlementCount.ToString())</strong>
                        </div>
                    </div>
                    @if (Model.CampaignSpine.Restore.ClaimedDevices.Count > 0)
                    {
                        <details class="details-drawer">
                            <summary>Claimed second-device restore posture</summary>
                            <ul class="muted-copy">
                                @foreach (var device in Model.CampaignSpine.Restore.ClaimedDevices)
                                {
                                    <li><strong>@device.DeviceRole</strong>: @device.Platform / @device.HeadId / @device.Channel. @device.RestoreSummary</li>
                                }
                            </ul>
                        </details>
                    }
                    @if (Model.CampaignSpine.Restore.RecentRuleEnvironments.Count > 0)
                    {
                        <details class="details-drawer">
                            <summary>Rule environments</summary>
                            <ul class="muted-copy">
                                @foreach (var environment in Model.CampaignSpine.Restore.RecentRuleEnvironments)
                                {
                                    <li>@RuleEnvironmentSummary(environment)</li>
                                }
                            </ul>
                        </details>
                    }
                    @if (Model.CampaignSpine.Restore.RecentArtifacts.Count > 0)
                    {
                        <details class="details-drawer">
                            <summary>Artifacts and reconnect receipts</summary>
                            <ul class="muted-copy">
                                @foreach (var artifact in Model.CampaignSpine.Restore.RecentArtifacts)
                                {
                                    <li><strong>@artifact.Label</strong>: @artifact.Summary</li>
                                }
                            </ul>
                        </details>
                    }
                    @if (Model.CampaignSpine.Restore.Entitlements.Count > 0)
                    {
                        <details class="details-drawer">
                            <summary>Entitlements</summary>
                            <ul class="muted-copy">
                                @foreach (var entitlement in Model.CampaignSpine.Restore.Entitlements)
                                {
                                    <li><strong>@entitlement.Label</strong>: @entitlement.Summary</li>
                                }
                            </ul>
                        </details>
                    }
                    <details class="details-drawer">
                        <summary>Install-local guardrails</summary>
                        <ul class="muted-copy">
                            @foreach (var note in Model.CampaignSpine.Restore.LocalOnlyNotes)
                            {
                                <li>@note</li>
                            }
                        </ul>
                    </details>
                </details>
            </section>
            }

            @if (showWorkSection || showSettingsSection)
            {
            <details class="details-drawer" open>
                <summary>@(showWorkSection ? "Workspaces and teams" : "More settings and policy")</summary>

            @if (showWorkSection && !showCampaignSection && !showTeamsSection)
            {
                <section class="settings-section" data-account-panel id="workspaces-empty">
                    <div class="settings-section__header">
                        <h2>Workspaces and teams</h2>
                        <p>No campaign workspace, team operator role, or return-path load is attached to this account yet. When that changes, this route keeps the work surface separate from the customer core.</p>
                    </div>
                    <div class="stacked-actions">
                        <a class="button-like button-like--secondary" href="/home">Return to home</a>
                        <a class="button-like button-like--ghost" href="/downloads">Open downloads</a>
                    </div>
                </section>
            }

            @if (showWorkSection && showCampaignSection)
            {
            <details class="details-drawer">
            <summary>Campaigns &amp; dossiers</summary>
            <section id="campaigns" class="settings-section" data-account-panel>
                <div class="settings-section__header">
                    <h2>Campaigns &amp; dossiers</h2>
                    <p>Living dossiers, crew context, rules checks, live run state, recap material, and restore signals stay tied together here instead of falling back to one-off build files.</p>
                </div>
                <div class="settings-summary-list">
                    <div class="settings-summary-row">
                        <span>Living dossiers</span>
                        <strong>@dossierCount</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Campaign workspaces</span>
                        <strong>@(workspaceCount == 0 ? "Ready to seed" : workspaceCount.ToString())</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Active runs</span>
                        <strong>@(runCount == 0 ? "Quiet" : runCount.ToString())</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Recap shelf items</span>
                        <strong>@(recapProjectionCount == 0 ? "None yet" : recapProjectionCount.ToString())</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Restore conflicts</span>
                        <strong>@(restoreConflicts == 0 ? "None" : restoreConflicts.ToString())</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Support blockers</span>
                        <strong>@(openSupportCases == 0 ? "None" : openSupportCases.ToString())</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Build comparisons</span>
                        <strong>@(buildLabHandoffCount == 0 ? "Pending" : buildLabHandoffCount.ToString())</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Rules answers</span>
                        <strong>@(rulesNavigatorCount == 0 ? "Pending" : rulesNavigatorCount.ToString())</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Legacy migration receipts</span>
                        <strong>@(migrationReceiptCount == 0 ? "None yet" : migrationReceiptCount.ToString())</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Creator publication shelf</span>
                        <strong>@(creatorPublicationCount == 0 ? "Pending" : creatorPublicationCount.ToString())</strong>
                    </div>
                </div>
                @if (Model.CampaignSpine.Workspaces.Count == 0)
                {
                    <p class="muted-copy">No campaign workspace yet. The first claimed install or campaign handoff will seed the long-lived runner identity and the first shared live run view.</p>
                }
                else
                {
                    @foreach (var workspace in Model.CampaignSpine.Workspaces)
                    {
                        <details class="details-drawer">
                            <summary>@workspace.CampaignName · live run view</summary>
                            <div class="settings-summary-list">
                                <div class="settings-summary-row">
                                    <span>Visibility</span>
                                    <strong>@HumanizeStatus(workspace.Visibility, "Private")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Rule environment</span>
                                    <strong>@RuleEnvironmentSummary(workspace.RuleEnvironment)</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Continuity</span>
                                    <strong>@(workspace.LatestContinuity?.Summary ?? workspace.ReturnSummary)</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Live run state</span>
                                    <strong>@(workspace.Runs.Count == 0 ? "No active run" : $"{workspace.Runs.Count} tracked")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Recap shelf</span>
                                    <strong>@(workspace.RecapShelf.Count == 0 ? "Pending" : $"{workspace.RecapShelf.Count} ready")</strong>
                                </div>
                            </div>

                            <div class="settings-summary-list">
                                @foreach (var crew in workspace.Crews)
                                {
                                    <div class="settings-summary-row">
                                        <span>@crew.Name roster</span>
                                        <strong>@crew.Members.Count members · @HumanizeStatus(crew.Visibility, "Private")</strong>
                                    </div>
                                    @foreach (var member in crew.Members)
                                    {
                                        var memberDossier = workspace.Dossiers.FirstOrDefault(dossier => string.Equals(dossier.DossierId, member.DossierId, StringComparison.OrdinalIgnoreCase));
                                        <div class="settings-summary-row">
                                            <span>@(memberDossier?.DisplayName ?? member.DossierId)</span>
                                            <strong>@HumanizeStatus(member.Role, "Member") · @HumanizeStatus(member.Availability, "Ready")</strong>
                                        </div>
                                    }
                                }
                            </div>

                            <div class="settings-summary-list">
                                @foreach (var run in workspace.Runs)
                                {
                                    <div class="settings-summary-row">
                                        <span>@run.Title</span>
                                        <strong>@HumanizeStatus(run.Status, "Active") · @(run.ActiveSceneId is null ? "No active scene" : "Scene live") · @run.Objectives.Count objectives</strong>
                                    </div>
                                    @foreach (var objective in run.Objectives)
                                    {
                                        <div class="settings-summary-row">
                                            <span>@objective.Title</span>
                                            <strong>@HumanizeStatus(objective.Status, "Open") · @objective.Pressure pressure</strong>
                                        </div>
                                    }
                                    @foreach (var scene in run.Scenes)
                                    {
                                        <div class="settings-summary-row">
                                            <span>@scene.Title</span>
                                            <strong>@HumanizeStatus(scene.Status, "Ready") · @scene.Revision</strong>
                                        </div>
                                    }
                                }
                            </div>

                            @if (workspace.ReadinessCues.Count > 0)
                            {
                                <details class="details-drawer">
                                    <summary>GM readiness</summary>
                                    <ul class="muted-copy">
                                        @foreach (var cue in workspace.ReadinessCues)
                                        {
                                            <li><strong>@HumanizeStatus(cue.Severity, "Ready"):</strong> @cue.Title. @cue.Summary</li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (workspace.RecapShelf.Count > 0)
                            {
                                <details class="details-drawer">
                                    <summary>Recap and artifact shelf</summary>
                                    <ul class="muted-copy">
                                        @foreach (var item in workspace.RecapShelf)
                                        {
                                            <li>
                                                <strong>@item.Label</strong>: @item.Summary
                                                @if (!string.IsNullOrWhiteSpace(item.ArtifactId))
                                                {
                                                    <span> (@item.ArtifactId)</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                        </details>
                    }
                }
                @if (Model.CampaignSpine.Restore.ConflictSummaries.Count > 0)
                {
                    <details class="details-drawer">
                        <summary>Restore and continuity notes</summary>
                        <ul class="muted-copy">
                            @foreach (var note in Model.CampaignSpine.Restore.ConflictSummaries)
                            {
                                <li>@note</li>
                            }
                        </ul>
                    </details>
                }
                @if (Model.CampaignSpine.BuildLabHandoffs.Count > 0)
                {
                    <details class="details-drawer">
                        <summary>Build comparisons</summary>
                        <ul class="muted-copy">
                            @foreach (var handoff in Model.CampaignSpine.BuildLabHandoffs)
                            {
                                <li>
                                    <strong>@handoff.Title</strong>: @handoff.Summary
                                    <span> Variant: @handoff.VariantLabel. Progression: @handoff.ProgressionLabel.</span>
                                    @if (handoff.Outputs.Count > 0)
                                    {
                                        <span> Outputs: @string.Join(", ", handoff.Outputs.Select(item => item.Label)).</span>
                                    }
                                </li>
                            }
                        </ul>
                    </details>
                }
                @if (Model.CampaignSpine.RulesNavigator.Count > 0)
                {
                    <details class="details-drawer">
                        <summary>Rules answers</summary>
                        <ul class="muted-copy">
                            @foreach (var answer in Model.CampaignSpine.RulesNavigator)
                            {
                                <li>
                                    <strong>@answer.Question</strong>: @answer.ShortAnswer
                                    <span> Before: @answer.BeforeSummary. After: @answer.AfterSummary.</span>
                                </li>
                            }
                        </ul>
                    </details>
                }
                @if (Model.CampaignSpine.MigrationReceipts.Count > 0)
                {
                    <details class="details-drawer">
                        <summary>Legacy migration receipts</summary>
                        <ul class="muted-copy">
                            @foreach (var receipt in Model.CampaignSpine.MigrationReceipts)
                            {
                                <li>
                                    <strong>@receipt.SourceKind</strong>: @receipt.Summary
                                    <span> Fields: @string.Join(", ", receipt.Fields.Select(field => $"{field.Label}={field.Status}")).</span>
                                </li>
                            }
                        </ul>
                    </details>
                }
                @if (Model.CampaignSpine.CreatorPublications.Count > 0)
                {
                    <details class="details-drawer">
                        <summary>Creator publication</summary>
                        <ul class="muted-copy">
                            @foreach (var publication in Model.CampaignSpine.CreatorPublications)
                            {
                                <li>
                                    <strong>@publication.Title</strong>: @publication.Summary
                                    <span> Provenance: @publication.ProvenanceSummary. Discovery: @publication.DiscoverySummary.</span>
                                </li>
                            }
                        </ul>
                    </details>
                }
            </section>
            </details>
            }

            @if (showWorkSection && showTeamsSection)
            {
            <details class="details-drawer">
            <summary>Teams &amp; permissions</summary>
            <section id="community-ops" class="settings-section" data-account-panel>
                <div class="settings-section__header">
                    <h2>Teams &amp; permissions</h2>
                    <p>Organizer work stays on the same account/control model as the player path: group ownership, permissions, roster state, campaign visibility, and governed rule posture stay explicit without inventing a second operator system.</p>
                </div>
                <div class="settings-summary-list">
                    <div class="settings-summary-row">
                        <span>Operator groups</span>
                        <strong>@communityOpsCount</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Recent restore generation</span>
                        <strong>@Model.CampaignSpine.Restore.GeneratedAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</strong>
                    </div>
                </div>
                @if (communityOpsCount == 0)
                {
                    <p class="muted-copy">You are not currently the operator for a campaign, creator team, or community group on this account.</p>
                }
                else
                {
                    @foreach (var op in Model.CampaignSpine.CommunityOperations)
                    {
                        <details class="details-drawer">
                            <summary>@op.GroupName · @HumanizeStatus(op.OperatorRole, "Member")</summary>
                            <div class="settings-summary-list">
                                <div class="settings-summary-row">
                                    <span>Group type</span>
                                    <strong>@HumanizeStatus(op.GroupType, "Group")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Visibility</span>
                                    <strong>@HumanizeStatus(op.Visibility, "Private")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Campaign visibility</span>
                                    <strong>@op.CampaignVisibilitySummary</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Rule environment</span>
                                    <strong>@RuleEnvironmentSummary(op.RuleEnvironment)</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Roster state</span>
                                    <strong>@op.MemberCount members · @op.ActiveCampaignCount campaigns</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Sponsor sessions</span>
                                    <strong>@(op.ActiveSponsorSessionCount == 0 ? "Quiet" : op.ActiveSponsorSessionCount.ToString())</strong>
                                </div>
                            </div>
                            @if (op.Capabilities.Count > 0)
                            {
                                <details class="details-drawer">
                                    <summary>Permissions</summary>
                                    <ul class="muted-copy">
                                        @foreach (var capability in op.Capabilities)
                                        {
                                            <li>@capability</li>
                                        }
                                    </ul>
                                </details>
                            }
                            @if (op.CampaignNames.Count > 0)
                            {
                                <details class="details-drawer">
                                    <summary>Visible campaigns</summary>
                                    <ul class="muted-copy">
                                        @foreach (var name in op.CampaignNames)
                                        {
                                            <li>@name</li>
                                        }
                                    </ul>
                                </details>
                            }
                        </details>
                    }
                    <p class="muted-copy">Recognition, badges, and sponsor motion stay secondary to campaign ownership, permissions, and real support closure.</p>
                }
            </section>
            </details>
            }

            @if (showSettingsSection)
            {
            <details class="details-drawer">
                <summary>Privacy</summary>
                <section id="privacy" class="settings-section" data-account-panel>
                    <div class="settings-section__header">
                        <h2>Privacy</h2>
                        <p>Choose what stays visible while deeper identifiers remain tucked away.</p>
                    </div>
                    <div class="settings-summary-list">
                        <div class="settings-summary-row">
                            <span>Visibility</span>
                            <strong>@HumanizeStatus(Model.User.Visibility, "Private")</strong>
                        </div>
                        <div class="settings-summary-row">
                            <span>Recovery posture</span>
                            <strong>@HumanizeStatus(Model.Links.RecoveryPosture, "Single method")</strong>
                        </div>
                    </div>
                </section>
            </details>
            }

            @if (showSettingsSection && showParticipationSection)
            {
            <details class="details-drawer">
            <summary>Participation</summary>
            <section id="participation" class="settings-section" data-account-panel>
                <div class="settings-section__header">
                    <h2>Participation</h2>
                    <p>Tell Chummer which lanes matter to you and which updates you actually want to hear about.</p>
                </div>
                <form id="experienceForm" class="settings-form">
                    <div class="check-grid">
                        <label class="check-row"><input type="checkbox" value="player" @(laneInterests.Contains("player") ? "checked" : null) /> <span>Player</span></label>
                        <label class="check-row"><input type="checkbox" value="gm" @(laneInterests.Contains("gm") ? "checked" : null) /> <span>GM</span></label>
                        <label class="check-row"><input type="checkbox" value="creator" @(laneInterests.Contains("creator") ? "checked" : null) /> <span>Creator</span></label>
                        <label class="check-row"><input id="followHorizons" type="checkbox" @(Model.Experience.FollowHorizons ? "checked" : null) /> <span>Follow roadmap updates</span></label>
                        <label class="check-row"><input id="betaInterest" type="checkbox" @(Model.Experience.BetaInterest ? "checked" : null) /> <span>Invite me when the right beta opens</span></label>
                    </div>
                    <button class="button-like button-like--primary" type="submit">Save participation settings</button>
                    <p id="experienceStatusNotice" class="muted-copy" hidden></p>
                </form>
            </section>
            </details>
            }

            @if (showSettingsSection)
            {
            <details class="details-drawer">
                <summary>Help and policy</summary>
                <section class="settings-section" data-account-panel id="help-policy">
                    <div class="settings-section__header">
                        <h2>Help and policy</h2>
                        <p>When you need support, privacy, or preview-use guidance, use the first-party pages instead of guessing.</p>
                    </div>
                    <div class="stacked-actions">
                        <a class="button-like button-like--secondary" href="/help">Open help</a>
                        <a class="button-like button-like--ghost" href="/privacy">Read privacy</a>
                        <a class="button-like button-like--ghost" href="/terms">Read terms</a>
                        <a class="button-like button-like--ghost" href="/contact">Contact Chummer</a>
                    </div>
                </section>
            </details>
            }
            </details>
            }
        </div>
    </div>

    @if (showAdvancedSection)
    {
    <details class="details-drawer" open>
        <summary>Advanced account details</summary>
        <dl class="detail-grid detail-grid--account">
            <div>
                <dt>Hub account id</dt>
                <dd class="mono-receipt">@Model.User.UserId</dd>
            </div>
            <div>
                <dt>Primary auth</dt>
                <dd>@HumanizeStatus(Model.Links.RecommendedPrimaryAuth, "Choose one")</dd>
            </div>
            <div>
                <dt>Linked identities</dt>
                <dd>@Model.Links.LinkedIdentities.Count</dd>
            </div>
            <div>
                <dt>Linked channels</dt>
                <dd>@Model.Links.ChannelLinks.Count</dd>
            </div>
            <div>
                <dt>Recovery posture</dt>
                <dd>@Model.Links.RecoveryPosture</dd>
            </div>
            <div>
                <dt>Follow horizons</dt>
                <dd>@(Model.Experience.FollowHorizons ? "Yes" : "No")</dd>
            </div>
        </dl>
    </details>
    }
</section>

@section Scripts {
<script>
(() => {
  const ui = window.ChummerUi;
  const subjectId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.User.SubjectId));
  const revealHashTarget = () => {
    const hash = window.location.hash;
    if (!hash) return;
    const target = document.querySelector(hash);
    if (!target) return;
    let node = target.parentElement;
    while (node) {
      if (node.tagName === "DETAILS") {
        node.open = true;
      }
      node = node.parentElement;
    }
  };

  revealHashTarget();
  window.addEventListener("hashchange", revealHashTarget);
  document.querySelectorAll("[data-account-tab]").forEach((link) => {
    link.addEventListener("click", () => window.setTimeout(revealHashTarget, 0));
  });

  document.getElementById("profileForm").addEventListener("submit", async (event) => {
    event.preventDefault();
    const notice = document.getElementById("profileStatusNotice");
    const button = event.currentTarget.querySelector("button[type='submit']");
    ui.clearNotice(notice);
    ui.setButtonBusy(button, true, "Saving...");
    try {
      const profile = await ui.requestJson("/api/v1/accounts/me/profile", {
        method: "POST",
        json: {
        subjectId,
        displayName: document.getElementById("displayName").value,
        handle: document.getElementById("handle").value,
        timezone: document.getElementById("timezone").value,
        visibility: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.User.Visibility))
        }
      });
      document.getElementById("displayName").value = profile.displayName || "";
      document.getElementById("handle").value = profile.handle || "";
      document.getElementById("timezone").value = profile.timezone || "";
      ui.setNotice(notice, "Profile saved.");
    } catch (error) {
      ui.setNotice(notice, ui.describeError(error, "Profile could not be saved right now."), true);
    } finally {
      ui.setButtonBusy(button, false, "Saving...");
    }
  });

  document.getElementById("recoveryForm").addEventListener("submit", async (event) => {
    event.preventDefault();
    const notice = document.getElementById("recoveryStatusNotice");
    const button = event.currentTarget.querySelector("button[type='submit']");
    ui.clearNotice(notice);
    ui.setButtonBusy(button, true, "Starting...");
    try {
      const data = await ui.requestJson("/api/v1/accounts/me/links/email/start", {
        method: "POST",
        json: {
        subjectId,
        email: document.getElementById("recoveryEmail").value,
        nextPath: "/account"
        }
      });
      document.getElementById("recoveryEmailStatus").textContent = ui.humanizeStatus(data.linkStatus, "Verification sent");
      ui.setNotice(notice, data.previewNote || "Check your email to finish verifying the recovery address.");
      if (data.previewHref) {
        window.location.href = data.previewHref;
      }
    } catch (error) {
      ui.setNotice(notice, ui.describeError(error, "Recovery email could not be started right now."), true);
    } finally {
      ui.setButtonBusy(button, false, "Starting...");
    }
  });

  document.getElementById("telegramForm").addEventListener("submit", async (event) => {
    event.preventDefault();
    const notice = document.getElementById("telegramStatusNotice");
    const button = event.currentTarget.querySelector("button[type='submit']");
    ui.clearNotice(notice);
    ui.setButtonBusy(button, true, "Saving...");
    try {
      await ui.requestJson("/api/v1/accounts/me/channels", {
        method: "POST",
        json: {
        subjectId,
        channelKind: "telegram_official_bot",
        channelHandle: document.getElementById("telegramHandle").value,
        notificationsEnabled: true
        }
      });
      ui.setNotice(notice, "Telegram companion settings saved.");
    } catch (error) {
      ui.setNotice(notice, ui.describeError(error, "Telegram companion settings could not be saved."), true);
    } finally {
      ui.setButtonBusy(button, false, "Saving...");
    }
  });

  document.getElementById("experienceForm").addEventListener("submit", async (event) => {
    event.preventDefault();
    const notice = document.getElementById("experienceStatusNotice");
    const laneInterests = Array.from(document.querySelectorAll("#experienceForm input[type='checkbox'][value]:checked")).map((input) => input.value);
    const button = event.currentTarget.querySelector("button[type='submit']");
    ui.clearNotice(notice);
    ui.setButtonBusy(button, true, "Saving...");
    try {
      await ui.requestJson("/api/v1/accounts/me/preferences", {
        method: "POST",
        json: {
        subjectId,
        laneInterests,
        followHorizons: document.getElementById("followHorizons").checked,
        betaInterest: document.getElementById("betaInterest").checked,
        onboardingCompleted: true
        }
      });
      const participationOverview = document.getElementById("participationOverviewState");
      if (participationOverview) {
        participationOverview.textContent = "Configured";
      }
      ui.setNotice(notice, "Participation settings saved.");
    } catch (error) {
      ui.setNotice(notice, ui.describeError(error, "Participation settings could not be saved."), true);
    } finally {
      ui.setButtonBusy(button, false, "Saving...");
    }
  });

  document.getElementById("supportAssistantForm").addEventListener("submit", async (event) => {
    event.preventDefault();
    const notice = document.getElementById("supportAssistantStatusNotice");
    const button = event.currentTarget.querySelector("button[type='submit']");
    const answer = document.getElementById("supportAssistantAnswer");
    const actions = document.getElementById("supportAssistantActions");
    const citations = document.getElementById("supportAssistantCitations");
    ui.clearNotice(notice);
    answer.hidden = true;
    actions.hidden = true;
    citations.hidden = true;
    answer.textContent = "";
    actions.innerHTML = "";
    citations.innerHTML = "";
    ui.setButtonBusy(button, true, "Checking...");
    try {
      const payload = await ui.requestJson("/api/v1/support/cases/assistant", {
        method: "POST",
        json: {
          query: document.getElementById("supportAssistantQuery").value,
          installationId: document.getElementById("supportAssistantInstallation").value || null
        }
      });

      answer.textContent = payload.answer || "";
      answer.hidden = !answer.textContent;

      const actionItems = Array.isArray(payload.actions) ? payload.actions : [];
      if (actionItems.length > 0) {
        actions.hidden = false;
        for (const item of actionItems) {
          const label = (item.label || item.actionId || "").trim();
          if (!label) {
            continue;
          }

          const link = document.createElement("a");
          link.className = "button-like button-like--ghost";
          link.href = item.href || "#";
          link.textContent = label.replaceAll("_", " ");
          link.title = item.reason || "";
          actions.appendChild(link);
        }
      }

      const citationItems = Array.isArray(payload.citations) ? payload.citations : [];
      if (citationItems.length > 0) {
        citations.hidden = false;
        for (const item of citationItems) {
          const row = document.createElement("div");
          row.className = "settings-summary-row";
          const label = document.createElement("span");
          label.textContent = item.label || item.sourceKind || "source";
          const summary = document.createElement("strong");
          summary.textContent = item.summary || "";
          row.appendChild(label);
          row.appendChild(summary);
          citations.appendChild(row);
        }
      }

      const confidence = payload.confidence ? ` (${payload.confidence.replaceAll("_", " ")})` : "";
      ui.setNotice(notice, `Grounded guidance loaded${confidence}.`);
    } catch (error) {
      ui.setNotice(notice, ui.describeError(error, "Grounded guidance could not be loaded right now."), true);
    } finally {
      ui.setButtonBusy(button, false, "Checking...");
    }
  });

  document.getElementById("supportCaseForm").addEventListener("submit", async (event) => {
    event.preventDefault();
    const notice = document.getElementById("supportCaseStatusNotice");
    const button = event.currentTarget.querySelector("button[type='submit']");
    const installationSelect = document.getElementById("supportCaseInstallation");
    const installationOption = installationSelect.options[installationSelect.selectedIndex];
    ui.clearNotice(notice);
    ui.setButtonBusy(button, true, "Submitting...");
    try {
      await ui.requestJson("/api/v1/support/cases", {
        method: "POST",
        json: {
          kind: document.getElementById("supportCaseKind").value,
          title: document.getElementById("supportCaseTitle").value,
          summary: document.getElementById("supportCaseSummary").value,
          detail: document.getElementById("supportCaseDetail").value,
          installationId: installationSelect.value || null,
          applicationVersion: installationOption?.dataset?.version || null,
          releaseChannel: installationOption?.dataset?.channel || null,
          headId: installationOption?.dataset?.head || null,
          platform: installationOption?.dataset?.platform || null,
          arch: installationOption?.dataset?.arch || null,
          source: "hub_account"
        }
      });
      document.getElementById("supportCaseTitle").value = "";
      document.getElementById("supportCaseSummary").value = "";
      document.getElementById("supportCaseDetail").value = "";
      installationSelect.selectedIndex = 0;
      ui.setNotice(notice, "Support case submitted. Refresh the page in a moment to see the new status entry.");
    } catch (error) {
      ui.setNotice(notice, ui.describeError(error, "Support case could not be submitted right now."), true);
    } finally {
      ui.setButtonBusy(button, false, "Submitting...");
    }
  });
})();
</script>
}

                                </details>
                                <details class="details-drawer">
                                    <summary>Recent join codes</summary>
                                    @if (op.RecentJoinCodes.Count == 0)
                                    {
                                        <p class="muted-copy">No governed join codes have been issued on this operator rail yet.</p>
                                    }
                                    else
                                    {
                                        <ul class="muted-copy">
                                            @foreach (var joinCode in op.RecentJoinCodes)

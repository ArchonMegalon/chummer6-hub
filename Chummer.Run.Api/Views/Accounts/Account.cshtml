                                            <span>@(memberDossier?.DisplayName ?? member.DossierId)</span>
                                            <strong>@HumanizeStatus(member.Role, "Member") · @HumanizeStatus(member.Availability, "Ready")</strong>
                                        </div>
                                    }
                                }
                            </div>

                            @if (workspace.RosterTransfers is { Count: > 0 })
                            {
                                <details class="details-drawer">
                                    <summary>Roster transfer audit</summary>
                                    <ul class="muted-copy">
                                        @foreach (var transfer in workspace.RosterTransfers)
                                        {
                                            <li><strong>@transfer.RunnerHandle:</strong> @transfer.Summary</li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (workspace.PrepLaunches is { Count: > 0 })
                            {
                                <details class="details-drawer">
                                    <summary>Governed prep launch audit</summary>
                                    <ul class="muted-copy">
                                        @foreach (var launch in workspace.PrepLaunches)
                                        {
                                            <li><strong>@launch.PacketTitle:</strong> @launch.Summary</li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (workspace.TravelPrefetches is { Count: > 0 })
                            {
                                <details class="details-drawer">
                                    <summary>Travel prefetch audit</summary>
                                    <ul class="muted-copy">
                                        @foreach (var receipt in workspace.TravelPrefetches)
                                        {
                                            <li><strong>@receipt.DeviceRole:</strong> @receipt.PrefetchSummary</li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (workspace.AftermathPackages is { Count: > 0 })
                            {
                                <details class="details-drawer">
                                    <summary>Aftermath recap audit</summary>
                                    <ul class="muted-copy">
                                        @foreach (var package in workspace.AftermathPackages)
                                        {
                                            <li><strong>@package.Title:</strong> @package.Summary</li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (workspace.AftermathPackages?.Any(item => string.Equals(item.PackageKind, "downtime_brief", StringComparison.OrdinalIgnoreCase)) == true)
                            {
                                var downtimeBrief = workspace.AftermathPackages.First(item => string.Equals(item.PackageKind, "downtime_brief", StringComparison.OrdinalIgnoreCase));
                                <details class="details-drawer">
                                    <summary>Downtime brief</summary>
                                    <ul class="muted-copy">
                                        <li><strong>@downtimeBrief.Title:</strong> @downtimeBrief.Summary</li>
                                        @if (downtimeBrief.EvidenceLines.Count > 0)
                                        {
                                            <li><strong>Evidence:</strong> @downtimeBrief.EvidenceLines[0]</li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (workspace.NextSessionCarryForward is not null)
                            {
                                <details class="details-drawer">
                                    <summary>Next-session carry-forward</summary>
                                    <ul class="muted-copy">
                                        <li><strong>Summary:</strong> @workspace.NextSessionCarryForward.Summary</li>
                                        <li><strong>Return:</strong> @workspace.NextSessionCarryForward.ReturnSummary</li>
                                        <li><strong>Next:</strong> @workspace.NextSessionCarryForward.NextSafeAction</li>
                                        @if (workspace.NextSessionCarryForward.EvidenceLines.Count > 0)
                                        {
                                            <li><strong>Evidence:</strong> @workspace.NextSessionCarryForward.EvidenceLines[0]</li>
                                        }
                                    </ul>
                                </details>
                            }

                            <div class="settings-summary-list">
                                @foreach (var run in workspace.Runs)
                                {
                                    <div class="settings-summary-row">
                                        <span>@run.Title</span>
                                        <strong>@HumanizeStatus(run.Status, "Active") · @(run.ActiveSceneId is null ? "No active scene" : "Scene live") · @run.Objectives.Count objectives</strong>
                                    </div>
                                    @foreach (var objective in run.Objectives)
                                    {
                                        <div class="settings-summary-row">
                                            <span>@objective.Title</span>
                                            <strong>@HumanizeStatus(objective.Status, "Open") · @objective.Pressure pressure</strong>
                                        </div>
                                    }
                                    @foreach (var scene in run.Scenes)
                                    {
                                        <div class="settings-summary-row">
                                            <span>@scene.Title</span>
                                            <strong>@HumanizeStatus(scene.Status, "Ready") · @scene.Revision</strong>
                                        </div>
                                    }
                                }
                            </div>

                            @if (workspace.ReadinessCues.Count > 0)
                            {
                                <details class="details-drawer">
                                    <summary>GM readiness</summary>
                                    <ul class="muted-copy">
                                        @foreach (var cue in workspace.ReadinessCues)
                                        {
                                            <li><strong>@HumanizeStatus(cue.Severity, "Ready"):</strong> @cue.Title. @cue.Summary</li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (workspace.RecapShelf.Count > 0)
                            {
                                <details class="details-drawer">
                                    <summary>Recap and artifact shelf</summary>
                                    <ul class="muted-copy">
                                        @foreach (var item in workspace.RecapShelf)
                                        {
                                            <li>
                                                <strong>@item.Label</strong>: @item.Summary
                                                @if (!string.IsNullOrWhiteSpace(item.ArtifactId))
                                                {
                                                    <span> (@item.ArtifactId)</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (workspace.ChangePackets is { Count: > 0 })
                            {
                                <details class="details-drawer">
                                    <summary>Recent change packets</summary>
                                    <ul class="muted-copy">
                                        @foreach (var packet in workspace.ChangePackets)
                                        {
                                            <li><strong>@packet.Label</strong>: @packet.Summary</li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (workspace.Consequences is { Count: > 0 })
                            {
                                <details class="details-drawer">
                                    <summary>Consequence ledger</summary>
                                    <ul class="muted-copy">
                                        @foreach (var consequence in workspace.Consequences)
                                        {
                                            <li>
                                                <strong>@consequence.Label</strong>: @HumanizeStatus(consequence.State, "Tracked"). @consequence.Summary
                                                @if (consequence.EvidenceLines.Count > 0)
                                                {
                                                    <span> Evidence: @consequence.EvidenceLines[0]</span>
                                                }
                                                @if (consequence.Receipts.Count > 0)
                                                {
                                                    <span> Receipt: @consequence.Receipts[0].SourceKind @consequence.Receipts[0].ReceiptId</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                        </details>
                    }
                }
                @if (Model.CampaignSpine.Restore.ConflictSummaries.Count > 0)
                {
                    <details class="details-drawer">
                        <summary>Recovery notes</summary>
                        <ul class="muted-copy">
                            @foreach (var note in Model.CampaignSpine.Restore.ConflictSummaries)
                            {
                                <li>@note</li>
                            }
                        </ul>
                    </details>
                }
                @if (Model.CampaignSpine.BuildLabHandoffs.Count > 0)
                {
                    <details class="details-drawer">
                        <summary>Build paths</summary>
                        <ul class="muted-copy">
                            @foreach (var handoff in Model.CampaignSpine.BuildLabHandoffs)
                            {
                                <li>
                                    <strong><a class="inline-link" href="@BuildHandoffDetailHref(handoff.HandoffId)">@handoff.Title</a></strong>: @handoff.Summary
                                    <span> Variant: @handoff.VariantLabel. Progression: @handoff.ProgressionLabel.</span>
                                    @if (handoff.TradeoffLines.Count > 0)
                                    {
                                        <span> Tradeoffs: @string.Join(" ", handoff.TradeoffLines.Take(2)).</span>
                                    }
                                    @if (handoff.ProgressionOutcomes.Count > 0)
                                    {
                                        <span> Outcome: @handoff.ProgressionOutcomes[0].</span>
                                    }
                                    @if (handoff.Outputs.Count > 0)
                                    {
                                        <span> Outputs: @string.Join(", ", handoff.Outputs.Select(item => item.Label)).</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(handoff.NextSafeAction))
                                    {
                                        <span> Next safe action: @handoff.NextSafeAction</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(handoff.RuntimeCompatibilitySummary))
                                    {
                                        <span> Runtime: @handoff.RuntimeCompatibilitySummary</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(handoff.CampaignReturnSummary))
                                    {
                                        <span> Return: @handoff.CampaignReturnSummary</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(handoff.SupportClosureSummary))
                                    {
                                        <span> Closure: @handoff.SupportClosureSummary</span>
                                    }
                                    @if (handoff.Watchouts is { Count: > 0 })
                                    {
                                        <span> Watchouts: @string.Join(" ", handoff.Watchouts.Take(2)).</span>
                                    }
                                </li>
                            }
                        </ul>
                    </details>
                }
                @if (Model.CampaignSpine.RulesNavigator.Count > 0)
                {
                    <details class="details-drawer">
                        <summary>Grounded rule answers</summary>
                        <ul class="muted-copy">
                            @foreach (var answer in Model.CampaignSpine.RulesNavigator)
                            {
                                <li>
                                    <strong><a class="inline-link" href="@RulesDetailHref(answer.EntryId)">@answer.Question</a></strong>: @answer.ShortAnswer
                                    <span> Before: @answer.BeforeSummary. After: @answer.AfterSummary.</span>
                                    <span> Source: @answer.ProvenanceLabel.</span>
                                    @if (answer.EvidenceLines.Count > 0)
                                    {
                                        <span> Evidence: @answer.EvidenceLines[0].</span>
                                    }
                                    @if (answer.SupportReuseHints.Count > 0)
                                    {
                                        <span> Support reuse: @answer.SupportReuseHints[0].</span>
                                    }
                                </li>
                            }
                        </ul>
                    </details>
                }
                @if (Model.CampaignSpine.MigrationReceipts.Count > 0)
                {
                    <details class="details-drawer">
                        <summary>Legacy migration receipts</summary>
                        <ul class="muted-copy">
                            @foreach (var receipt in Model.CampaignSpine.MigrationReceipts)
                            {
                                <li>
                                    <strong>@receipt.SourceKind</strong>: @receipt.Summary
                                    <span> Fields: @string.Join(", ", receipt.Fields.Select(field => $"{field.Label}={field.Status}")).</span>
                                </li>
                            }
                        </ul>
                    </details>
                }
                @if (Model.CampaignSpine.CreatorPublications.Count > 0)
                {
                    <details class="details-drawer">
                        <summary>Creator publication</summary>
                        <ul class="muted-copy">
                            @foreach (var publication in Model.CampaignSpine.CreatorPublications)
                            {
                                <li>
                                    <strong><a class="inline-link" href="@PublicationDetailHref(publication.PublicationId)">@publication.Title</a></strong>: @publication.Summary
                                    <span> Source: @publication.ProvenanceSummary. Discovery: @publication.DiscoverySummary.</span>
                                    @if (!string.IsNullOrWhiteSpace(publication.NextSafeAction))
                                    {
                                        <span> Next: @publication.NextSafeAction.</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(publication.CampaignReturnSummary))
                                    {
                                        <span> Return: @publication.CampaignReturnSummary.</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(publication.SupportClosureSummary))
                                    {
                                        <span> Support: @publication.SupportClosureSummary.</span>
                                    }
                                </li>
                            }
                        </ul>
                    </details>
                }
            </section>
            </details>
            }

            @if (showWorkSection && showTeamsSection)
            {
            <details class="details-drawer">
            <summary>Teams &amp; permissions</summary>
            <section id="community-ops" class="settings-section" data-account-panel>
                <div class="settings-section__header">
                    <h2>Teams &amp; permissions</h2>
                    <p>Organizer work stays on the same account path as the player path: group ownership, permissions, roster state, campaign visibility, and grounded rules stay explicit without splitting into a second admin system.</p>
                </div>
                <div class="settings-summary-list">
                    <div class="settings-summary-row">
                        <span>Operator groups</span>
                        <strong>@communityOpsCount</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Recent restore generation</span>
                        <strong>@Model.CampaignSpine.Restore.GeneratedAtUtc.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</strong>
                    </div>
                </div>
                @if (communityOpsCount == 0)
                {
                    <p class="muted-copy">You are not currently the operator for a campaign, creator team, or community group on this account.</p>
                }
                else
                {
                    @foreach (var op in Model.CampaignSpine.CommunityOperations)
                    {
                        var inviteSummary = op.RecentJoinCodes.Count == 0 && op.RecentBoostCodes.Count == 0
                            ? "Issue governed member and sponsor entry from one calmer operator rail."
                            : $"{op.RecentJoinCodes.Count} join code(s) and {op.RecentBoostCodes.Count} sponsor code(s) stay on one governed rail.";
                        <details id="community-op-@op.GroupId" class="details-drawer">
                            <summary>@op.GroupName · @HumanizeStatus(op.OperatorRole, "Member")</summary>
                            <div class="settings-summary-list">
                                <div class="settings-summary-row">
                                    <span>Group type</span>
                                    <strong>@HumanizeStatus(op.GroupType, "Group")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Visibility</span>
                                    <strong>@HumanizeStatus(op.Visibility, "Private")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Campaign visibility</span>
                                    <strong>@op.CampaignVisibilitySummary</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Reference context</span>
                                    <strong>@RuleEnvironmentSummary(op.RuleEnvironment)</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Roster state</span>
                                    <strong>@op.MemberCount members · @op.ActiveCampaignCount campaigns</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Sponsor sessions</span>
                                    <strong>@(op.ActiveSponsorSessionCount == 0 ? "Quiet" : op.ActiveSponsorSessionCount.ToString())</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Operations pulse</span>
                                    <strong>@op.OperationsSummary</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Campaign return pulse</span>
                                    <strong>@op.CampaignReturnSummary</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Season / event pulse</span>
                                    <strong>@op.SeasonEventSummary</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Season board</span>
                                    <strong>
                                        @if (op.SeasonBoardEntries.Count == 0)
                                        {
                                            @:Pending
                                        }
                                        else
                                        {
                                            @op.SeasonBoardEntries.Count @:campaign lanes
                                        }
                                    </strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Launch &amp; closure</span>
                                    <strong>@organizerGuidanceSummary</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Invite / sponsorship</span>
                                    <strong>@inviteSummary</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Sponsor session rail</span>
                                    <strong>@(op.RecentSponsorSessions.Count == 0 ? "Quiet" : $"{op.RecentSponsorSessions.Count} recent")</strong>
                                </div>
                                <div class="settings-summary-row">
                                    <span>Operator watchouts</span>
                                    <strong>@(op.Watchouts.Count == 0 ? "Quiet" : op.Watchouts[0])</strong>
                                </div>
                            </div>
                            <details class="details-drawer">
                                <summary>Operations pulse</summary>
                                <ul class="muted-copy">
                                    @foreach (var returnSummary in op.RecentReturnSummaries)
                                    {
                                        <li>@returnSummary</li>
                                    }
                                    @foreach (var watchout in op.Watchouts)
                                    {
                                        <li><strong>Watchout:</strong> @watchout</li>
                                    }
                                </ul>
                            </details>
                            <details id="community-op-events-@op.GroupId" class="details-drawer">
                                <summary>Season &amp; event rail</summary>
                                <ul class="muted-copy">
                                    <li>@op.SeasonEventSummary</li>
                                    @if (op.RecentEventSummaries.Count == 0)
                                    {
                                        <li>No governed season or event receipts are attached yet.</li>
                                    }
                                    else
                                    {
                                        @foreach (var eventSummary in op.RecentEventSummaries)
                                        {
                                            <li>@eventSummary</li>
                                        }
                                    }
                                </ul>
                            </details>
                            <details id="community-op-board-@op.GroupId" class="details-drawer">
                                <summary>Season board</summary>
                                @if (op.SeasonBoardEntries.Count == 0)
                                {
                                    <p class="muted-copy">No governed campaign lanes are attached yet.</p>
                                }
                                else
                                {
                                    <ul class="muted-copy">
                                        @foreach (var entry in op.SeasonBoardEntries)
                                        {
                                            <li>
                                                <strong>@entry.CampaignName</strong>: @entry.RunTitle. @entry.LatestEventSummary
                                                <span> Next: @entry.NextSafeAction</span>
                                                @if (!string.IsNullOrWhiteSpace(entry.WatchoutSummary))
                                                {
                                                    <span> Watchout: @entry.WatchoutSummary</span>
                                                }
                                                <a class="inline-link" href="@($"/account/work/workspaces/{Uri.EscapeDataString(entry.WorkspaceId)}")">Open shared campaign view</a>
                                            </li>
                                        }
                                    </ul>
                                }
                            </details>
                            <details id="community-op-invites-@op.GroupId" class="details-drawer">
                                <summary>Invite &amp; sponsorship rail</summary>
                                <div class="settings-summary-list">
                                    <div class="settings-summary-row">
                                        <span>Join codes</span>
                                        <strong>@(op.RecentJoinCodes.Count == 0 ? "Quiet" : $"{op.RecentJoinCodes.Count} recent")</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>Boost codes</span>
                                        <strong>@(op.RecentBoostCodes.Count == 0 ? "Quiet" : $"{op.RecentBoostCodes.Count} recent")</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>Active sponsor sessions</span>
                                        <strong>@(op.ActiveSponsorSessionCount == 0 ? "Quiet" : op.ActiveSponsorSessionCount.ToString())</strong>
                                    </div>
                                    <div class="settings-summary-row">
                                        <span>Recent sponsor sessions</span>
                                        <strong>@(op.RecentSponsorSessions.Count == 0 ? "Quiet" : $"{op.RecentSponsorSessions.Count} recent")</strong>
                                    </div>
                                </div>
                                <p class="muted-copy">Community invites, sponsorship entry, and stale-code recovery stay on the same governed operator rail instead of getting pushed into chat folklore.</p>
                                <div class="grid-split">
                                    <form class="settings-form" data-join-code-form data-group-id="@op.GroupId">
                                        <h3>Issue governed join code</h3>
                                        <label>
                                            Member role
                                            <select name="role">
                                                <option value="member">Member</option>
                                                <option value="booster">Booster</option>
                                            </select>
                                        </label>
                                        <label>
                                            Time to live
                                            <select name="ttl">
                                                <option value="7.00:00:00">7 days</option>
                                                <option value="1.00:00:00">24 hours</option>
                                                <option value="30.00:00:00">30 days</option>
                                                <option value="">No expiry</option>
                                            </select>

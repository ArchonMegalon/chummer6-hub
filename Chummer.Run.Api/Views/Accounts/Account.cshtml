                        @if (leadPendingClaim is not null)
                        {
                            <div class="settings-summary-row">
                                <span>Recovery reserve</span>
                                <strong>@PublicText(leadPendingClaim.ArtifactLabel) · use the pending code only if that device explicitly opens in recovery mode.</strong>
                            </div>
                        }
                        @if (leadInstallRailSupport is not null)
                        {
                            <div class="settings-summary-row">
                                <span>Tracked support</span>
                                <strong>@leadInstallRailSupport.StageLabel · @leadInstallRailSupport.ClosureSummary</strong>
                            </div>
                        }
                    </div>
                    <div class="stacked-actions">
                        <a class="button-like button-like--primary" href="@installRailPrimaryHref">@installRailPrimaryLabel</a>
                        <a class="button-like button-like--secondary" href="@installRailSecondaryHref">@installRailSecondaryLabel</a>
                    </div>
                    <p class="muted-copy">Devices &amp; access is the calmer return path after the installer or app does the real work. Recovery codes stay below as a reserve option, not the first instruction.</p>
                </article>
                <div class="settings-summary-list">
                    <div class="settings-summary-row">
                        <span>Recent install steps</span>
                        <strong>@Model.InstallLinking.RecentReceipts.Count</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Waiting to finish on another device</span>
                        <strong>@Model.InstallLinking.PendingClaimTickets.Count</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Claimed installs</span>
                        <strong>@claimedInstallations</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Access rights</span>
                        <strong>@activeAccessRights</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Cross-device recovery</span>
                            <strong>@(restoreArtifactCount == 0 && restoreEntitlementCount == 0 ? "Ready to seed" : $"{restoreArtifactCount} files · {restoreEntitlementCount} entitlements")</strong>
                    </div>
                    @if (entitlementSyncReceipts is not null)
                    {
                        <div class="settings-summary-row">
                            <span>Entitlement status</span>

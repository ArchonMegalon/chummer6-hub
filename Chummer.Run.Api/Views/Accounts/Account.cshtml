                            @if (selectedWorkspaceServerPlane.Runboard is not null)
                            {
                                <details class="details-drawer">
                                    <summary>Runboard follow-through</summary>
                                    <div class="settings-summary-list">
                                        <div class="settings-summary-row">
                                            <span>Status</span>
                                            <strong>@HumanizeStatus(selectedWorkspaceServerPlane.Runboard.Status, "Active")</strong>
                                        </div>
                                        <div class="settings-summary-row">
                                            <span>Objective pressure</span>
                                            <strong>@selectedWorkspaceServerPlane.Runboard.ObjectiveSummary</strong>
                                        </div>
                                        <div class="settings-summary-row">
                                            <span>Current return</span>
                                            <strong>@selectedWorkspaceServerPlane.Runboard.ReturnSummary</strong>
                                        </div>
                                    </div>
                                    @if (selectedWorkspaceServerPlane.Runboard.Blockers.Count > 0)
                                    {
                                        <ul class="muted-copy">
                                            @foreach (var blocker in selectedWorkspaceServerPlane.Runboard.Blockers)
                                            {
                                                <li>@blocker</li>
                                            }
                                        </ul>
                                    }
                                </details>

@model Chummer.Run.Api.ViewModels.OriginDossierPublicationDetailPageViewModel
@{
    ViewData["Title"] = Model.Publication.Title;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-minimal";
    var publication = Model.Publication;
    var canShowCover = publication.StorySceneCoverUsesSelectedCharacterFace
        && !string.IsNullOrWhiteSpace(publication.StorySceneCoverUrl);
    var canRead = publication.GoldReady
        && !string.IsNullOrWhiteSpace(publication.AudiobookshelfDossierShareUrl);
    var canOpenBook = publication.GoldReady
        && publication.BookArtifactVerified
        && !string.IsNullOrWhiteSpace(publication.BookArtifactUrl);
    var canListen = publication.GoldReady
        && publication.AudiobookshelfPlaybackVerified
        && !string.IsNullOrWhiteSpace(publication.AudiobookshelfAudiobookShareUrl);
    var canWatch = publication.GoldReady
        && publication.DossierVideoVerified
        && !string.IsNullOrWhiteSpace(publication.DossierVideoUrl);
    const string rightsTooltip = "Not legal advice. Your strongest copyright claim is in the parts you chose, wrote, edited, and approved. Pure model-only wording may be harder to protect by itself in some jurisdictions, so Chummer keeps the canon, outline, and approvals tied to you.";
}

<section class="minimal-page-hero" data-origin-dossier-detail>
    <div>
        <p class="minimal-kicker">Private Origin Dossier</p>
        <h1>@Clean(publication.Title)</h1>
        <p>@Clean(publication.RunnerAlias) · @Humanize(publication.PublicationState)</p>
        @if (!string.IsNullOrWhiteSpace(publication.OriginEditionNamespace))
        {
            <p class="muted-copy">@Clean(publication.OriginEditionNamespace)</p>
        }
    </div>
</section>

<section class="minimal-section minimal-section--tight" id="origin-dossier-edition">
    <div class="product-proof__grid">
        <article class="app-action-card app-action-card--primary"
                 data-origin-dossier-gold-ready="@publication.GoldReady.ToString().ToLowerInvariant()"
                 data-story-scene-cover-uses-selected-character-face="@publication.StorySceneCoverUsesSelectedCharacterFace.ToString().ToLowerInvariant()"
                 data-audiobookshelf-playback-verified="@publication.AudiobookshelfPlaybackVerified.ToString().ToLowerInvariant()"
                 data-book-artifact-verified="@publication.BookArtifactVerified.ToString().ToLowerInvariant()"
                 data-dossier-video-verified="@publication.DossierVideoVerified.ToString().ToLowerInvariant()"
                 data-telegram-share-delivered="@publication.TelegramShareDelivered.ToString().ToLowerInvariant()">
            <span class="tag">@(publication.GoldReady ? "Ready" : "Building")</span>
            <h2>Cover</h2>
            @if (canShowCover)
            {
                <figure class="product-proof__media">
                    <span class="scene-picture">
                        <img src="@publication.StorySceneCoverUrl" alt="Rendered Origin Dossier story scene cover for @Clean(publication.RunnerAlias)" loading="eager" />
                    </span>
                    <figcaption class="muted-copy">Selected cover is ready.</figcaption>
                </figure>
            }
            else
            {
                <p class="muted-copy">Cover unlocks after the portrait is ready.</p>
            }
        </article>
        <article class="app-action-card">
            <span class="tag">Edition</span>
            <h2>Edition status</h2>
            <div class="settings-summary-list">
                <div class="settings-summary-row">
                    <span>Story draft</span>
                    <strong>@(publication.ProviderAuthoredManuscriptImported ? "Ready" : "Waiting")</strong>
                </div>
                <div class="settings-summary-row">
                    <span>Story polish</span>
                    <strong>@(publication.UndetectableHumanizerApplied ? "Ready" : "Waiting")</strong>
                </div>
                <div class="settings-summary-row">
                    <span>Book</span>
                    <strong>@(publication.BookArtifactVerified ? "Ready" : "Waiting")</strong>
                </div>
                <div class="settings-summary-row">
                    <span>Cover</span>
                    <strong>@(publication.StorySceneCoverUsesSelectedCharacterFace ? "Ready" : "Waiting")</strong>
                </div>
                <div class="settings-summary-row">
                    <span>Audio</span>
                    <strong>@(publication.AudiobookshelfPlaybackVerified ? "Ready" : "Waiting")</strong>
                </div>
                <div class="settings-summary-row">
                    <span>Video</span>
                    <strong>@(publication.DossierVideoVerified ? "Ready" : "Waiting")</strong>
                </div>
                <div class="settings-summary-row">
                    <span>Share</span>
                    <strong>@(publication.TelegramShareDelivered ? "Delivered" : "Waiting")</strong>
                </div>
                @if (publication.ArtifactCapability is not null)
                {
                    <div class="settings-summary-row">
                        <span>@Clean(publication.ArtifactCapability.PublicLabel)</span>
                        <strong>@Clean(publication.ArtifactCapability.Status)</strong>
                    </div>
                    <div class="settings-summary-row">
                        <span>Format</span>
                        <strong>@Clean(publication.ArtifactCapability.CapabilitySlot.Replace("_", " ", StringComparison.OrdinalIgnoreCase))</strong>
                    </div>
                }
            </div>
            @if (publication.MissingGoldRequirements.Count > 0)
            {
                <details class="details-drawer">
                    <summary>Still missing</summary>
                    <ul class="muted-copy">
                        @foreach (var requirement in publication.MissingGoldRequirements)
                        {
                            <li>@Clean(requirement)</li>
                        }
                    </ul>
                </details>
            }
        </article>
    </div>
</section>

<section class="minimal-section minimal-section--tight" id="origin-edition-tabs" data-origin-edition-tabs>
    <article class="app-action-card">
        <span class="tag">Owner links</span>
        <h2>Edition</h2>
        <p>Read, listen, and video open here when this account is cleared for them.</p>
        <nav class="minimal-actions" aria-label="Origin Edition tabs">
            <a class="button-like button-like--ghost" href="#origin-edition-read">Read</a>
            <a class="button-like button-like--ghost" href="#origin-edition-listen">Listen</a>
            <a class="button-like button-like--ghost" href="#origin-edition-watch">Watch</a>
            <a class="button-like button-like--ghost" href="#origin-edition-canon-audit">Canon notes</a>
        </nav>
    </article>
</section>

<section class="minimal-section minimal-section--tight" id="origin-edition-read" data-origin-edition-tab="read">
    <article class="app-action-card">
        <span class="tag">Read</span>
        <h2>Dossier ebook</h2>
        <p>Read the private book edition here.</p>
        <div class="minimal-actions" aria-label="Origin Edition read actions">
            @if (canRead)
            {
                <a class="button-like button-like--primary" href="@publication.AudiobookshelfDossierShareUrl" target="_blank" rel="noopener">Read in Audiobookshelf</a>
            }
            else
            {
                <span class="button-like button-like--disabled" aria-disabled="true">Dossier ebook share locked</span>
            }
            @if (canOpenBook)
            {
                <a class="button-like button-like--secondary" href="@publication.BookArtifactUrl">Open archived book</a>
            }
            else
            {
                <span class="button-like button-like--disabled" aria-disabled="true">Archived book locked</span>
            }
        </div>
    </article>
</section>

<section class="minimal-section minimal-section--tight" id="origin-edition-listen" data-origin-edition-tab="listen">
    <article class="app-action-card">
        <span class="tag">Listen</span>
        <h2>Audiobook</h2>
        <p>Listen here when the audiobook is ready.</p>
        <div class="minimal-actions" aria-label="Origin Edition listen actions">
            @if (canListen)
            {
                <a class="button-like button-like--primary" href="@publication.AudiobookshelfAudiobookShareUrl" target="_blank" rel="noopener">Listen in Audiobookshelf</a>
            }
            else
            {
                <span class="button-like button-like--disabled" aria-disabled="true">Audiobookshelf share locked</span>
            }
        </div>
    </article>
</section>

<section class="minimal-section minimal-section--tight" id="origin-edition-watch" data-origin-edition-tab="watch">
    <article class="app-action-card">
        <span class="tag">Watch</span>
        <h2>Story scene movie</h2>
        <p>Watch the selected scene here when the video is ready.</p>
        <div class="minimal-actions" aria-label="Origin Edition watch actions">
            @if (canWatch)
            {
                <a class="button-like button-like--primary" href="@publication.DossierVideoUrl" target="_blank" rel="noopener">Watch scene movie</a>
            }
            else
            {
                <span class="button-like button-like--disabled" aria-disabled="true">Dossier film locked</span>
            }
        </div>
    </article>
</section>

<section class="minimal-section minimal-section--tight"
         id="origin-edition-canon-audit"
         data-origin-edition-tab="canon-audit"
         data-chummer-owns-canon="true"
         data-provider-created-facts-auto-canon="false"
         data-canon-privacy-receipts-present="@((publication.ProviderAuthoredManuscriptImported && publication.UndetectableHumanizerApplied).ToString().ToLowerInvariant())"
         data-no-fallback-media-verified="@publication.GoldReady.ToString().ToLowerInvariant()">
    <article class="app-action-card">
        <span class="tag">Canon notes</span>
        <h2 class="heading-with-help">
            <span>Access notes</span>
            <span class="inline-help-dot" tabindex="0" role="note" title="@rightsTooltip" aria-label="@rightsTooltip">?</span>
        </h2>
        <p>Chummer keeps the canon. Book, audio, video, cover, and share links stay locked until the edition is ready.</p>
        <div class="settings-summary-list">
            <div class="settings-summary-row">
                <span>Namespace</span>
                <strong>@Clean(publication.OriginEditionNamespace)</strong>
            </div>
            <div class="settings-summary-row">
                <span>Canon and privacy</span>
                <strong>@(publication.ProviderAuthoredManuscriptImported && publication.UndetectableHumanizerApplied ? "Ready" : "Waiting")</strong>
            </div>
            <div class="settings-summary-row">
                <span>Media links</span>
                <strong>@(publication.GoldReady ? "Ready" : "Waiting")</strong>
            </div>
        </div>
        <div class="minimal-actions">
            <a class="button-like button-like--ghost" href="@Model.LibraryHref">Back to Origin Dossier library</a>
        </div>
    </article>
</section>

@functions {
    private static string Clean(string? value)
        => Chummer.Run.Api.Services.PublicFacingCopyHumanizer.Clean(value);

    private static string Humanize(string? value)
        => Clean(string.IsNullOrWhiteSpace(value)
            ? "Building edition"
            : value.Replace('_', ' '));
}

@model ParticipationConsolePageViewModel
@{
    ViewData["Title"] = "Participate";
    ViewData["Chrome"] = Model.Chrome;
}

<section class="participation-entry">
    <div class="sr-only" aria-hidden="true">
        @Html.AntiForgeryToken()
    </div>

    <section class="participation-hero">
        <div class="participation-hero__content">
            <p class="eyebrow">Participation</p>
            <h1 class="hero-brand">Help Chummer improve.</h1>
            <h2 class="hero-headline">Start a temporary contribution session only when you want to use it.</h2>
            <p class="participation-lead">Use the guided contribution flow only when you want to help with specific Chummer tasks through ChatGPT. Work is reviewed before it counts, and authorization by itself does not create contribution credit.</p>
            <div class="stacked-actions">
                <button id="openParticipationWizardButton" class="button-like button-like--primary" type="button">Start contribution</button>
                <a class="button-like button-like--ghost" href="/account">Open account</a>
            </div>
            <p class="privacy-note">Signed in as @Model.User.DisplayName. Codes expire quickly, so Chummer only generates a fresh one when you explicitly ask for it.</p>
        </div>
    </section>

    <section class="participation-answer-grid" aria-label="Participation questions">
        <article class="participation-answer">
            <p class="participation-answer__eyebrow">What you are authorizing</p>
            <h3>A temporary contribution session</h3>
            <p>Chummer opens a short-lived session in ChatGPT only for the contribution you start here. It cannot act on your behalf anywhere else.</p>
        </article>
        <article class="participation-answer">
            <p class="participation-answer__eyebrow">What you need ready</p>
            <h3>Your browser and ChatGPT</h3>
            <p>When you start, Chummer requests a fresh one-time code, opens the ChatGPT confirmation page, and waits for the browser to finish. If the code expires, you can request a new one from the wizard.</p>
        </article>
        <article class="participation-answer">
            <p class="participation-answer__eyebrow">What Chummer stores</p>
            <h3>Consent and participation history</h3>
            <p>Chummer keeps participation history, your public handle if you submit one, and badge state. One-time codes expire quickly and are not shown on your account page.</p>
        </article>
        <article class="participation-answer">
            <p class="participation-answer__eyebrow">When credit appears</p>
            <h3>After accepted work lands</h3>
            <p>Authorization gets you ready to contribute, but it is not scored as contribution credit. Recognition, badges, and leaderboard visibility only appear after accepted work lands.</p>
        </article>
    </section>

    <section class="participation-journey" aria-label="How participation works">
        <div class="participation-journey__intro">
            <p class="eyebrow">How it works</p>
            <h2 class="page-title">One decision, one code, one clean handoff</h2>
            <p>Read the terms here, then open the wizard only when you are ready. Chummer generates a fresh code on demand, walks you through authorization, and leaves you with a clean account trail.</p>
        </div>
        <div class="participation-journey__steps">
            <article class="participation-step">
                <span class="participation-step__index">1</span>
                <div>
                    <h3>Decide to participate</h3>
                    <p>Start from this page only when you want a fresh authorization challenge.</p>
                </div>
            </article>
            <article class="participation-step">
                <span class="participation-step__index">2</span>
                <div>
                    <h3>Authorize in ChatGPT</h3>
                    <p>Use the one-time code Chummer generates for that session in ChatGPT and keep the wizard open while confirmation lands.</p>
                </div>
            </article>
            <article class="participation-step">
                <span class="participation-step__index">3</span>
                <div>
                    <h3>Leave with a clear status</h3>
                    <p>You end with a ready state, a queue state, or a clean stop. The flow should always leave you with a clear answer.</p>
                </div>
            </article>
        </div>
    </section>
</section>

<div id="participationWizardDialog" class="participation-dialog" hidden>
    <div class="participation-dialog__backdrop" data-close-participation-dialog></div>
    <section class="participation-dialog__panel auth-panel participation-panel" role="dialog" aria-modal="true" aria-labelledby="participationHeading">
        <button id="closeParticipationWizardButton" class="participation-dialog__close" type="button" aria-label="Close participation wizard">Close</button>

        <div class="wizard-shell wizard-shell--modal">
            <div class="wizard-intro">
                <p id="stateTag" class="tag">Ready</p>
                <p id="wizardStepLabel" class="wizard-step-label">Fresh authorization on demand</p>
            </div>

            <ol class="wizard-rail" aria-label="Contribution steps">
                <li id="wizardStepStart" class="wizard-step wizard-step--current">
                    <span class="wizard-step__index">1</span>
                    <div>
                        <strong>Open the session</strong>
                        <p>Ask Chummer for a fresh authorization challenge only when you need it.</p>
                    </div>
                </li>
                <li id="wizardStepAuthorize" class="wizard-step">
                    <span class="wizard-step__index">2</span>
                    <div>
                        <strong>Authorize in ChatGPT</strong>
                        <p>Open the confirmation page and enter the one-time code.</p>
                    </div>
                </li>
                <li id="wizardStepComplete" class="wizard-step">
                    <span class="wizard-step__index">3</span>
                    <div>
                        <strong>You're set</strong>
                        <p>Chummer keeps the history and waits for accepted work.</p>
                    </div>
                </li>
            </ol>
        </div>

        <h2 id="participationHeading">Authorize a fresh contribution session</h2>
        <p id="stateSupport">Chummer only generates a one-time code after you explicitly start, because those codes expire quickly.</p>
        <div id="stateLine" class="wizard-status" aria-live="polite"></div>
        <div id="lifecycleStateLine" class="wizard-status muted-copy" aria-live="polite"></div>
        <details id="lifecycleSteps" class="details-drawer" hidden>
            <summary>Participant lifecycle states</summary>
            <ul id="lifecycleStepsList" class="muted-copy"></ul>
        </details>
        <details id="decisionBreadcrumbs" class="details-drawer" hidden>
            <summary>Consent and decision breadcrumbs</summary>
            <ul id="decisionBreadcrumbList" class="muted-copy"></ul>
        </details>
        <details id="failureGuidance" class="details-drawer" hidden>
            <summary>Failure guidance</summary>
            <p id="failureGuidanceSummary" class="muted-copy"></p>
            <p id="failureGuidanceNext" class="muted-copy"></p>
        </details>

        <div id="startState" class="state-stack">
            <div class="wizard-card">
                <p class="wizard-card__eyebrow">Step 1</p>
                <h3>Generate a fresh code</h3>
                <p>When you continue, Chummer will request a new one-time ChatGPT code for this session. If you do not use it in time, ask for another one here.</p>
            </div>
            <label class="field-shell" for="participantCodexCodeInput">
                <span class="field-label">Public contribution code</span>
                <input id="participantCodexCodeInput" class="field-input" type="text" maxlength="48" autocomplete="off" placeholder="shadowrunner-archon" />
                <span class="muted-copy">Optional public handle. If you opt into public visibility, Chummer attaches this code to your contribution session and can show it on badges and leaderboards.</span>
            </label>
            <div class="stacked-actions">
                <button id="startContributionButton" class="button-like button-like--primary" type="button">Generate fresh code</button>
                <button id="closeStartStateButton" class="inline-link inline-link--button" type="button">Not now</button>
            </div>
            <p class="privacy-note">You can stop later. Final contribution credit appears only after accepted work lands.</p>
        </div>

        <div id="authorizeState" class="state-stack" hidden>
            <div class="wizard-card">
                <p class="wizard-card__eyebrow">Step 2</p>
                <h3>Authorize in ChatGPT</h3>
                <p>Open the authorization page, sign in to ChatGPT, and enter the one-time code shown below. If the code expires, ask for a fresh one.</p>
            </div>
            <div class="stacked-actions">
                <button id="openAuthorizationLink" class="button-like button-like--primary" type="button" disabled>Open authorization page</button>
                <button id="copyCodeButton" class="button-like button-like--secondary" type="button">Copy code</button>
                <button id="refreshAuthorizationButton" class="button-like button-like--ghost" type="button">Get a fresh code</button>
            </div>
            <div class="code-panel">
                <span class="code-panel__label">One-time code</span>
                <div id="authorizationCode" class="code-panel__value mono-receipt">A fresh code will appear here after you start.</div>
            </div>
            <div class="wizard-note-band">
                <strong>Keep this page open.</strong>
                <span>Chummer waits for confirmation and moves you forward automatically when the session is ready.</span>
            </div>
            <button id="cancelContributionButton" class="inline-link inline-link--button" type="button">Stop this contribution for now</button>
        </div>

        <div id="completeState" class="state-stack" hidden>
            <div class="wizard-card">
                <p class="wizard-card__eyebrow">Step 3</p>
                <h3>Thanks, you're set</h3>
                <p>Your contribution session is ready. Chummer uses it only for the Chummer task you started here, and recognition still depends on accepted work.</p>
            </div>
            <div id="badgeReveal" class="badge-reveal" hidden>
                <span class="tag">Thank you</span>
                <h3 id="badgeLabel">Contributor Ready</h3>
                <p id="badgeNote" class="muted-copy">This is a thank-you marker only. Contribution credit appears later after accepted work.</p>
            </div>
            <div class="stacked-actions">
                <a class="button-like button-like--primary" href="/home">Back to home</a>
                <a class="button-like button-like--ghost" href="/account">Open account</a>
            </div>
        </div>

        <div id="unavailableState" class="state-stack" hidden>
            <div class="wizard-card wizard-card--soft">
                <p class="wizard-card__eyebrow">Unavailable</p>
                <h3>Participation is unavailable right now</h3>
                <p>Chummer could not open or refresh a contribution session on this host. Your account and participation history are still intact.</p>
            </div>
            <div class="stacked-actions">
                <a id="unavailableHomeLink" class="button-like button-like--primary" href="/home">Back to home</a>
                <a id="unavailableAccountLink" class="button-like button-like--ghost" href="/account">Open account</a>
                <a id="unavailableExplainLink" class="inline-link" href="/partizipate">How it works</a>
            </div>
        </div>

        <details id="technicalDetails" class="details-drawer" hidden>
            <summary>Session details</summary>
            <dl class="detail-grid">
                <div>
                    <dt>Contribution</dt>
                    <dd id="detailContributionId">None</dd>
                </div>
                <div>
                    <dt>Session</dt>
                    <dd id="detailFleetLaneId">Not created yet</dd>
                </div>
                <div>
                    <dt>Sign-in status</dt>
                    <dd id="detailAuthStatus">Not started</dd>
                </div>
                <div>
                    <dt>Ready at</dt>
                    <dd id="detailAuthReadyAt">Not yet</dd>
                </div>
                <div>
                    <dt>Access level</dt>
                    <dd id="detailAuthorizationTier">Unknown</dd>
                </div>
                <div>
                    <dt>Contribution code</dt>
                    <dd id="detailParticipantCodexCode">Not set</dd>
                </div>
                <div>
                    <dt>Role</dt>
                    <dd id="detailLaneRole">Coding</dd>
                </div>
            </dl>
            <div class="stacked-actions">
                <button id="stopContributionButton" class="button-like button-like--secondary" type="button">Stop</button>
                <button id="revokeContributionButton" class="button-like button-like--ghost" type="button">Revoke</button>
            </div>
        </details>
    </section>
</div>

@section Scripts {
<script>
let currentContributionId = "";
let pollHandle = 0;
const dialog = document.getElementById("participationWizardDialog");
const ui = window.ChummerUi;
const nodes = {
  openWizardButton: document.getElementById("openParticipationWizardButton"),
  closeWizardButton: document.getElementById("closeParticipationWizardButton"),
  closeStartButton: document.getElementById("closeStartStateButton"),
  backdrop: document.querySelector("[data-close-participation-dialog]"),
  startContributionButton: document.getElementById("startContributionButton"),
  refreshAuthorizationButton: document.getElementById("refreshAuthorizationButton"),
  stopContributionButton: document.getElementById("stopContributionButton"),
  revokeContributionButton: document.getElementById("revokeContributionButton"),
  cancelContributionButton: document.getElementById("cancelContributionButton"),
  copyCodeButton: document.getElementById("copyCodeButton"),
  authorizationLink: document.getElementById("openAuthorizationLink"),
  authorizationCode: document.getElementById("authorizationCode"),
  participantCodexCodeInput: document.getElementById("participantCodexCodeInput"),
  technicalDetails: document.getElementById("technicalDetails"),
  badgeReveal: document.getElementById("badgeReveal"),
  stateTag: document.getElementById("stateTag"),
  heading: document.getElementById("participationHeading"),
  support: document.getElementById("stateSupport"),
  statusLine: document.getElementById("stateLine"),
  lifecycleStateLine: document.getElementById("lifecycleStateLine"),
  lifecycleSteps: document.getElementById("lifecycleSteps"),
  lifecycleStepsList: document.getElementById("lifecycleStepsList"),
  decisionBreadcrumbs: document.getElementById("decisionBreadcrumbs"),
  decisionBreadcrumbList: document.getElementById("decisionBreadcrumbList"),
  failureGuidance: document.getElementById("failureGuidance"),
  failureGuidanceSummary: document.getElementById("failureGuidanceSummary"),
  failureGuidanceNext: document.getElementById("failureGuidanceNext"),
  wizardStepLabel: document.getElementById("wizardStepLabel"),
  unavailableHomeLink: document.getElementById("unavailableHomeLink"),
  unavailableAccountLink: document.getElementById("unavailableAccountLink"),
  unavailableExplainLink: document.getElementById("unavailableExplainLink"),
  badgeLabel: document.getElementById("badgeLabel"),
  badgeNote: document.getElementById("badgeNote"),
  details: {
    contributionId: document.getElementById("detailContributionId"),
    fleetLaneId: document.getElementById("detailFleetLaneId"),
    authStatus: document.getElementById("detailAuthStatus"),
    authReadyAt: document.getElementById("detailAuthReadyAt"),
    authorizationTier: document.getElementById("detailAuthorizationTier"),
    participantCodexCode: document.getElementById("detailParticipantCodexCode"),
    laneRole: document.getElementById("detailLaneRole")
  },
  steps: {
    start: document.getElementById("wizardStepStart"),
    authorize: document.getElementById("wizardStepAuthorize"),
    complete: document.getElementById("wizardStepComplete")
  },
  states: {
    start: document.getElementById("startState"),
    authorize: document.getElementById("authorizeState"),
    complete: document.getElementById("completeState"),
    unavailable: document.getElementById("unavailableState")
  }
};

function stopPolling() {
  if (pollHandle) {
    window.clearTimeout(pollHandle);
    pollHandle = 0;
  }
}

function schedulePoll(delayMs) {
  stopPolling();
  pollHandle = window.setTimeout(() => {
    refreshCurrent().catch(renderError);
  }, delayMs);
}

function formatDate(value) {
  if (!value) return "Not yet";
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? value : date.toLocaleString();
}

function setDialogOpen(open) {
  dialog.hidden = !open;
  document.body.classList.toggle("dialog-open", open);
  if (!open) {
    stopPolling();
  }
}

function toggleState(phase) {
  ui.toggleExclusive(nodes.states, phase);
}

function setWizardStep(phase, status) {
  const completedSteps = {
    start: ["start"],
    authorize: ["start", "authorize"],
    complete: ["start", "authorize", "complete"],
    unavailable: []
  };
  const currentStep = {
    start: "start",
    authorize: "authorize",
    complete: "complete",
    unavailable: ""
  };
  let label = {
    start: "Step 1 of 3",
    authorize: "Step 2 of 3",
    complete: "Step 3 of 3",
    unavailable: "Flow unavailable"
  }[phase] || "Preparing contribution flow";

  if (status === "waiting_for_slot") {
    label = "Waiting for an available slot";
  } else if (status === "pending_auth") {
    label = "Fresh code ready";
  }

  ui.setText(nodes.wizardStepLabel, label);
  for (const [key, element] of Object.entries(nodes.steps)) {
    const done = (completedSteps[phase] || []).includes(key);
    element.classList.toggle("wizard-step--complete", done && key !== currentStep[phase]);
    element.classList.toggle("wizard-step--current", key === currentStep[phase]);
    element.classList.toggle("wizard-step--pending", !done);
  }
}

function normalizeParticipationError(error) {
  if (error && error.payload && typeof error.payload === "object" && error.payload.phase) {
    return error.payload;
  }

  const message = error?.message || "Participation is unavailable right now.";
  if (message.includes("Participation is unavailable")) {
    return {
      unavailable: true,
      status: "unavailable",
      phase: "unavailable",
      heading: "Participation is unavailable right now",
      support: message,
      statusLine: "Try again later. Your account and saved participation history are still intact.",
      auth: {},
      badge: null,
      details: null,
      actions: {
        explainHref: "/partizipate",
        homeHref: "/home",
        accountHref: "/account"
      }
    };
  }

  return null;
}

function showPreparingState() {
  currentContributionId = "";
  setWizardStep("start", "starting");
  toggleState("start");
  ui.setText(nodes.stateTag, "Preparing");
  ui.setText(nodes.heading, "Preparing a fresh authorization code");
  ui.setText(nodes.support, "Chummer is opening a fresh participation challenge for this session.");
  ui.setText(nodes.statusLine, "Codes are only generated after you explicitly start.");
  ui.setText(nodes.lifecycleStateLine, "Preparing a new session.");
  nodes.lifecycleSteps.hidden = true;
  nodes.decisionBreadcrumbs.hidden = true;
  nodes.failureGuidance.hidden = true;
  nodes.technicalDetails.hidden = true;
  nodes.badgeReveal.hidden = true;
}

function renderError(error) {
  const unavailable = normalizeParticipationError(error);
  if (unavailable) {
    render(unavailable);
    return;
  }

  stopPolling();
  currentContributionId = "";
  setDialogOpen(true);
  ui.setText(nodes.stateTag, "Attention");
  ui.setText(nodes.heading, "The contribution flow could not continue");
  ui.setText(nodes.support, error?.message || "Something interrupted the current request.");
  ui.setText(nodes.statusLine, "Try again in a moment.");
  ui.setText(nodes.lifecycleStateLine, "Lifecycle: temporary interruption.");
  nodes.lifecycleSteps.hidden = true;
  nodes.decisionBreadcrumbs.hidden = true;
  nodes.failureGuidance.hidden = false;
  ui.setText(nodes.failureGuidanceSummary, "The request failed before a stable session status was confirmed.");
  ui.setText(nodes.failureGuidanceNext, "Next safe action: retry this flow. If retries fail, open Account > Support with the approximate time of this attempt.");
  nodes.technicalDetails.hidden = true;
  setWizardStep("start", "error");
  toggleState("start");
}

function syncAuthorization(auth, status) {
  nodes.authorizationLink.dataset.href = auth.verificationUri || "";
  nodes.authorizationLink.disabled = !auth.verificationUri;
  nodes.authorizationLink.setAttribute("aria-disabled", auth.verificationUri ? "false" : "true");
  nodes.authorizationLink.classList.toggle("button-like--disabled", !auth.verificationUri);
  nodes.copyCodeButton.disabled = !auth.userCode;
  ui.setText(
    nodes.authorizationCode,
    auth.userCode
      || (status === "waiting_for_slot"
        ? "No code yet. Chummer is waiting for a contribution slot to open."
        : "A fresh code will appear here as soon as Chummer receives it.")
  );
}

function syncUnavailableActions(actions) {
  nodes.unavailableHomeLink.href = actions.homeHref || "/home";
  nodes.unavailableAccountLink.href = actions.accountHref || "/account";
  nodes.unavailableExplainLink.href = actions.explainHref || "/partizipate";
}

function syncBadge(phase, badge) {
  nodes.badgeReveal.hidden = !(phase === "complete" && badge);
  ui.setText(nodes.badgeLabel, badge?.label || "Contributor Ready");
  ui.setText(nodes.badgeNote, badge?.note || "This is a thank-you marker only. Contribution credit appears later after accepted work.");
}

function syncTechnicalDetails(contribution, details) {
  nodes.technicalDetails.hidden = !contribution;
  ui.setText(nodes.details.contributionId, details?.contributionId || "None");
  ui.setText(nodes.details.fleetLaneId, details?.fleetLaneId || "Not created yet");
  ui.setText(nodes.details.authStatus, details?.authStatus || "Not started");
  ui.setText(nodes.details.authReadyAt, formatDate(details?.authReadyAtUtc));
  ui.setText(nodes.details.authorizationTier, details?.authorizationTier || "Unknown");
  ui.setText(nodes.details.participantCodexCode, details?.participantCodexCode || "Not set");
  ui.setText(nodes.details.laneRole, details?.requestedLaneRole || "coding");
}

function syncContributionActions(phase, status) {
  const canCloseContribution = !!currentContributionId && phase !== "unavailable" && status !== "stopped" && status !== "revoked";
  nodes.stopContributionButton.disabled = !canCloseContribution;
  nodes.revokeContributionButton.disabled = !canCloseContribution;
  nodes.cancelContributionButton.hidden = !currentContributionId || phase === "unavailable";
}

function syncLifecycle(lifecycle) {
  if (!lifecycle) {
    ui.setText(nodes.lifecycleStateLine, "");
    nodes.lifecycleSteps.hidden = true;
    nodes.lifecycleStepsList.innerHTML = "";
    return;
  }

  const stateLabel = lifecycle.currentState || "Tracked";
  ui.setText(nodes.lifecycleStateLine, `Lifecycle: ${stateLabel}`);
  const steps = Array.isArray(lifecycle.steps) ? lifecycle.steps : [];
  nodes.lifecycleStepsList.innerHTML = "";
  if (steps.length === 0) {
    nodes.lifecycleSteps.hidden = true;
    return;
  }

  for (const step of steps) {
    const li = document.createElement("li");
    const label = step.label || "Step";
    const state = (step.state || "pending").split("_").join(" ");
    const summary = step.summary || "No summary available.";
    const when = step.happenedAtUtc ? ` (${formatDate(step.happenedAtUtc)})` : "";
    li.textContent = `${label} · ${state}: ${summary}${when}`;
    nodes.lifecycleStepsList.appendChild(li);
  }

  nodes.lifecycleSteps.hidden = false;
}

function syncDecisionBreadcrumbs(breadcrumbs) {
  const entries = Array.isArray(breadcrumbs) ? breadcrumbs : [];
  nodes.decisionBreadcrumbList.innerHTML = "";
  if (entries.length === 0) {
    nodes.decisionBreadcrumbs.hidden = true;
    return;
  }

  for (const entry of entries) {
    const li = document.createElement("li");
    const label = entry.label || "Decision event";
    const message = entry.message || "No detail recorded.";
    const when = formatDate(entry.createdAtUtc);
    li.textContent = `${label}: ${message} (${when})`;
    nodes.decisionBreadcrumbList.appendChild(li);
  }

  nodes.decisionBreadcrumbs.hidden = false;
}

function syncFailureGuidance(guidance) {
  if (!guidance || !guidance.summary) {
    nodes.failureGuidance.hidden = true;
    return;
  }

  nodes.failureGuidance.hidden = false;
  ui.setText(nodes.failureGuidanceSummary, guidance.title ? `${guidance.title}: ${guidance.summary}` : guidance.summary);
  ui.setText(nodes.failureGuidanceNext, guidance.nextSafeAction ? `Next safe action: ${guidance.nextSafeAction}` : "");
}

function render(data) {
  const contribution = data.contribution || null;
  const details = data.details || null;
  const auth = data.auth || {};
  const badge = data.badge || null;
  const lifecycle = data.lifecycle || null;
  const breadcrumbs = data.breadcrumbs || [];
  const failureGuidance = data.failureGuidance || null;
  const phase = data.phase || "start";
  const status = data.status || "ready_to_start";
  const actions = data.actions || {};
  currentContributionId = contribution?.contributionId || "";

  setDialogOpen(true);
  ui.setText(nodes.stateTag, status === "waiting_for_slot"
    ? "Queued"
    : phase === "complete"
      ? "Ready"
      : phase === "authorize"
        ? "Authorize"
        : phase === "unavailable"
          ? "Unavailable"
          : "Start");
  ui.setText(nodes.heading, data.heading || "Open a fresh contribution session");
  ui.setText(nodes.support, data.support || "");
  ui.setText(nodes.statusLine, data.statusLine || "");
  setWizardStep(phase, status);
  toggleState(phase);
  syncAuthorization(auth, status);
  syncUnavailableActions(actions);
  syncBadge(phase, badge);
  syncLifecycle(lifecycle);
  syncDecisionBreadcrumbs(breadcrumbs);
  syncFailureGuidance(failureGuidance);
  syncTechnicalDetails(contribution, details);
  syncContributionActions(phase, status);

  if (phase === "authorize" && currentContributionId) {
    schedulePoll(auth.pollAfterMs || 3000);
    return;
  }

  stopPolling();
}

async function refreshCurrent() {
  const data = currentContributionId
    ? await ui.requestJson(`/api/v1/participation/contributions/${currentContributionId}`)
    : await ui.requestJson("/api/v1/participation/contributions/current");
  render(data);
}

async function startContribution() {
  setDialogOpen(true);
  showPreparingState();
  await ui.withBusyState([nodes.startContributionButton, nodes.refreshAuthorizationButton], "Preparing...", async () => {
    const data = await ui.requestJson("/api/v1/participation/contributions/start", {
      method: "POST",
      body: JSON.stringify({ codexCode: (nodes.participantCodexCodeInput?.value || "").trim() })
    });
    render(data);
  });
}

async function stopContribution(revoke) {
  if (!currentContributionId) return;
  const button = revoke
    ? nodes.revokeContributionButton
    : nodes.stopContributionButton;
  await ui.withBusyState(button, revoke ? "Revoking..." : "Stopping...", async () => {
    const path = revoke
      ? `/api/v1/participation/contributions/${currentContributionId}/revoke`
      : `/api/v1/participation/contributions/${currentContributionId}/stop`;
    const data = await ui.requestJson(path, { method: "POST" });
    render(data);
  });
}

async function copyCode() {
  const code = nodes.authorizationCode.textContent || "";
  if (!code || code.startsWith("A fresh code will appear") || code.startsWith("No code yet")) return;
  await ui.copyToClipboard(code, nodes.copyCodeButton);
}

nodes.openWizardButton.addEventListener("click", () => {
  startContribution().catch(renderError);
});
nodes.startContributionButton.addEventListener("click", () => {
  startContribution().catch(renderError);
});
nodes.refreshAuthorizationButton.addEventListener("click", () => {
  startContribution().catch(renderError);
});
nodes.copyCodeButton.addEventListener("click", () => {
  copyCode().catch(renderError);
});
nodes.cancelContributionButton.addEventListener("click", () => {
  stopContribution(false).catch(renderError);
});
nodes.stopContributionButton.addEventListener("click", () => {
  stopContribution(false).catch(renderError);
});
nodes.revokeContributionButton.addEventListener("click", () => {
  stopContribution(true).catch(renderError);
});
nodes.closeWizardButton.addEventListener("click", () => {
  setDialogOpen(false);
});
nodes.closeStartButton.addEventListener("click", () => {
  setDialogOpen(false);
});
nodes.backdrop.addEventListener("click", () => {
  setDialogOpen(false);
});
nodes.authorizationLink.addEventListener("click", (event) => {
  const href = event.currentTarget.dataset.href;
  if (!href) {
    return;
  }

  window.open(href, "_blank", "noopener,noreferrer");
});
document.addEventListener("keydown", (event) => {
  if (event.key === "Escape" && !dialog.hidden) {
    setDialogOpen(false);
  }
});
</script>
}

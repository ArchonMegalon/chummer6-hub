@model AuthMessagePageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-auth surface-minimal surface-auth-message";
    ViewData["HideAuthChrome"] = true;
}

<section class="auth-entry auth-entry--lean" aria-labelledby="auth-message-title">
    <div class="auth-panel auth-panel--entry auth-panel--message">
        <div class="auth-panel__intro auth-panel__intro--masthead">
            @if (!string.IsNullOrWhiteSpace(Model.StateLabel))
            {
                <p class="auth-panel__eyebrow">@Model.StateLabel</p>
            }
            <h1 id="auth-message-title">@Model.Heading</h1>
            <p class="auth-panel__hint">@Model.SupportLine</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notice))
        {
            <p class="auth-panel__notice">@Model.Notice</p>
        }
        @if (Model.Highlights is { Count: > 0 })
        {
            <ul class="auth-benefits auth-benefits--message">
                @foreach (var item in Model.Highlights.Take(3))
                {
                    <li>@item</li>
                }
            </ul>
        }
        <div class="stacked-actions">
            <a class="button-like button-like--primary auth-panel__primary" href="@Model.PrimaryHref">@Model.PrimaryLabel</a>
            <a class="button-like button-like--secondary auth-panel__primary" href="@Model.SecondaryHref">@Model.SecondaryLabel</a>
        </div>
    </div>
</section>

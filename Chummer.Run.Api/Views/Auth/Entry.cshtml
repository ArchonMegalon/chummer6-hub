@model AuthPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-auth";
    var accessPosture = Model.AccessPosture;
    var isInstallLinkReturn = Model.NextPath.StartsWith("/account/access/install-link", StringComparison.OrdinalIgnoreCase);
    var installLinkReturnsToLocalApp = false;
    static bool IsLoopbackCallbackUri(string candidate)
    {
        return Uri.TryCreate(candidate, UriKind.Absolute, out var parsedCallback)
            && parsedCallback.IsLoopback
            && (string.Equals(parsedCallback.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)
                || string.Equals(parsedCallback.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase));
    }

    if (isInstallLinkReturn)
    {
        var parsedNextPath = new Uri($"https://chummer.run{Model.NextPath}", UriKind.Absolute);
        var nextQuery = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(parsedNextPath.Query);
        if (nextQuery.TryGetValue("installLinkCallbackUri", out var callbackValues))
        {
            var callbackUri = callbackValues.ToString();
            installLinkReturnsToLocalApp = IsLoopbackCallbackUri(callbackUri);
        }
    }
    var nextTarget = isInstallLinkReturn
        ? "this copy"
        : Model.NextPath.StartsWith("/downloads", StringComparison.OrdinalIgnoreCase)
        ? "Downloads"
        : Model.NextPath.StartsWith("/account", StringComparison.OrdinalIgnoreCase)
            ? "Account"
            : Model.NextPath.StartsWith("/home", StringComparison.OrdinalIgnoreCase)
                ? "Home"
                : "the account area";
}

<section class="auth-entry">
    <div class="auth-entry__story auth-entry__story--visual">
        <p class="eyebrow">Account</p>
        <h1 class="hero-brand">CHUMMER</h1>
        <h2 class="hero-headline">@(isInstallLinkReturn ? "Claim your copy" : Model.Heading)</h2>
        <p class="auth-entry__copy">@(isInstallLinkReturn ? "Use your email or Google account to connect this install to you. The app returns when that is done." : Model.SupportLine)</p>
        <div class="auth-value-strip" aria-label="Immediate account value">
            <article class="auth-value-strip__fact">
                <span>Linked installs</span>
                <strong>Keep this copy attached to your account.</strong>
            </article>
            <article class="auth-value-strip__fact">
                <span>Devices and access</span>
                <strong>Reconnect, replace, or recover from one place.</strong>
            </article>
            <article class="auth-value-strip__fact">
                <span>Support history</span>
                <strong>Tracked help stays attached to the same account.</strong>
            </article>
        </div>
        <p class="auth-entry__trust">@(isInstallLinkReturn ? "The download stays the same. Claiming only connects this copy to your account." : (accessPosture?.AccountValueSummary ?? "The download stays the same for everyone. An account adds device return and support history when you want them."))</p>
    </div>

    <div class="auth-entry__panel auth-panel auth-panel--entry">
        <div class="auth-panel__mode-row">
            @if (Model.CreateAccount)
            {
                <span class="action-pill action-pill--current">Create account</span>
                <a class="action-pill action-pill--ghost" href="/login?next=@Uri.EscapeDataString(Model.NextPath)">Sign in</a>
            }
            else
            {
                <span class="action-pill action-pill--current">Sign in</span>
                <a class="action-pill action-pill--ghost" href="/signup?next=@Uri.EscapeDataString(Model.NextPath)">Create account</a>
            }
        </div>

        @if (Model.CreateAccount)
        {
            <div class="auth-panel__intro">
                <h3>@(isInstallLinkReturn ? "Claim with email" : "Email first")</h3>
                <p>@(isInstallLinkReturn ? "Enter the email you want attached to this copy. Google is available if that is how you normally sign in." : "Create the account first, then finish setup. Email keeps the first step simple. Google is available too.")</p>
            </div>
            <div class="auth-benefits">
                <span class="tag">What you get right away</span>
                <ul>
                    <li>An account that can link downloads, install history, and future device return.</li>
                    <li>A place to keep support history and device return in one account home.</li>
                    <li>A simple way back when this install, your account, or your support case needs attention.</li>
                </ul>
            </div>
            <p class="muted-copy">After you confirm the email, you return to @nextTarget.</p>
            @if (isInstallLinkReturn)
            {
                <p class="muted-copy">@(installLinkReturnsToLocalApp
                    ? "Keep Chummer open while the browser connects this copy."
                    : "If the browser cannot return to Chummer, open this page again from the app.")</p>
            }
            <form class="auth-form" method="post" action="/auth/email/start">
                @Html.AntiForgeryToken()
                <input type="hidden" name="next" value="@Model.NextPath" />
                <div class="field">
                    <label for="email">Email</label>
                    <input id="email" name="email" type="email" placeholder="runner@example.com" required />
                </div>
                <button class="button-like button-like--primary" type="submit">Continue with email</button>
            </form>

            <div class="auth-divider"><span>Or use Google</span></div>
            @if (Model.GoogleAvailable)
            {
                <a class="button-like button-like--secondary auth-panel__primary" href="@Model.GoogleStartHref">Continue with Google</a>
            }
            else
            {
                <button class="button-like button-like--ghost auth-panel__primary" type="button" disabled>Google unavailable</button>
                <p class="muted-copy">@Model.GoogleUnavailableReason</p>
            }
        }
        else
        {
            <div class="auth-panel__intro">
                <h3>@(isInstallLinkReturn ? "Claim with your account" : "Fastest way back in")</h3>
                <p>@(isInstallLinkReturn ? "Sign in with the account that should own this copy." : "Sign in to reopen downloads, devices and access, and support history.")</p>
            </div>
            <div class="auth-benefits">
                <span class="tag">What opens after sign-in</span>
                <ul>
                    <li>Your home and account pages for return, recovery, and the next step.</li>
                    <li>Account-linked downloads, connected copies, and device return.</li>
                    <li>Support history already on the account.</li>
                </ul>
            </div>
            <p class="muted-copy">After you confirm the sign-in, you return to @nextTarget.</p>
            @if (isInstallLinkReturn)
            {
                <p class="muted-copy">@(installLinkReturnsToLocalApp
                    ? "Keep Chummer open while the browser connects this copy."
                    : "If the browser cannot return to Chummer, open this page again from the app.")</p>
            }

            <form class="auth-form" method="post" action="/auth/email/start">
                @Html.AntiForgeryToken()
                <input type="hidden" name="next" value="@Model.NextPath" />
                <div class="field">
                    <label for="email">Email</label>
                    <input id="email" name="email" type="email" placeholder="runner@example.com" required />
                </div>
                <button class="button-like button-like--primary auth-panel__primary" type="submit">Send magic link</button>
            </form>

            <div class="auth-divider"><span>Or use Google</span></div>
            @if (Model.GoogleAvailable)
            {
                <a class="button-like button-like--secondary auth-panel__primary" href="@Model.GoogleStartHref">Continue with Google</a>
            }
            else
            {
                <button class="button-like button-like--ghost auth-panel__primary" type="button" disabled>Google unavailable</button>
                <p class="muted-copy">@Model.GoogleUnavailableReason</p>
            }
        }
        <p class="privacy-note">The account keeps downloads, updates, linked installs, devices and access, and support history together.</p>
    </div>
</section>

@model AuthPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-auth";
    var accessPosture = Model.AccessPosture;
    var isInstallLinkReturn = Model.NextPath.StartsWith("/account/access/install-link", StringComparison.OrdinalIgnoreCase);
    var nextTarget = isInstallLinkReturn
        ? "Chummer"
        : Model.NextPath.StartsWith("/downloads", StringComparison.OrdinalIgnoreCase)
        ? "Downloads"
        : Model.NextPath.StartsWith("/account", StringComparison.OrdinalIgnoreCase)
            ? "Account"
            : Model.NextPath.StartsWith("/home", StringComparison.OrdinalIgnoreCase)
                ? "Home"
                : "the signed-in product";
}

<section class="auth-entry">
    <div class="auth-entry__story auth-entry__story--visual">
        <p class="eyebrow">Campaign OS preview</p>
        <h1 class="hero-brand">CHUMMER</h1>
        <h2 class="hero-headline">@Model.Heading</h2>
        <p class="auth-entry__copy">@Model.SupportLine</p>
        <div class="auth-value-strip" aria-label="Immediate account value">
            <article class="auth-value-strip__fact">
                <span>Linked installs</span>
                <strong>Keep the handoff attached to this return path.</strong>
            </article>
            <article class="auth-value-strip__fact">
                <span>Devices and access</span>
                <strong>Relink, reclaim, and recover from one calmer place.</strong>
            </article>
            <article class="auth-value-strip__fact">
                <span>Support continuity</span>
                <strong>Tracked help stays attached to the same account story.</strong>
            </article>
        </div>
        <p class="auth-entry__trust">@(accessPosture?.AccountValueSummary ?? "The binary stays the same for everyone. The account adds continuity, device return, and support continuity when you want it.")</p>
    </div>

    <div class="auth-entry__panel auth-panel auth-panel--entry">
        <div class="auth-panel__mode-row">
            @if (Model.CreateAccount)
            {
                <span class="action-pill action-pill--current">Create account</span>
                <a class="action-pill action-pill--ghost" href="/login?next=@Uri.EscapeDataString(Model.NextPath)">Sign in</a>
            }
            else
            {
                <span class="action-pill action-pill--current">Sign in</span>
                <a class="action-pill action-pill--ghost" href="/signup?next=@Uri.EscapeDataString(Model.NextPath)">Create account</a>
            }
        </div>

        @if (Model.CreateAccount)
        {
            <div class="auth-panel__intro">
                <h3>Email first</h3>
                <p>Create the account first, then shape the profile in setup. Email keeps the first step simple; Google stays available if you want the faster return path later.</p>
            </div>
            <div class="auth-benefits">
                <span class="tag">What you get right away</span>
                <ul>
                    <li>An account that can link downloads, install receipts, and future device return.</li>
                    <li>A place to keep support history, roadmap follows, and preview interest in one account home.</li>
                    <li>A calmer return path the next time this install, your account, or your support story needs attention.</li>
                </ul>
            </div>
            <p class="muted-copy">After verification you land in @nextTarget.</p>
            @if (isInstallLinkReturn)
            {
                <p class="muted-copy">The next page opens Chummer to finish linking this install, with a manual open button if the browser blocks the app handoff.</p>
            }
            <form class="auth-form" method="post" action="/auth/email/start">
                @Html.AntiForgeryToken()
                <input type="hidden" name="next" value="@Model.NextPath" />
                <div class="field">
                    <label for="email">Email</label>
                    <input id="email" name="email" type="email" placeholder="runner@example.com" required />
                </div>
                <button class="button-like button-like--primary" type="submit">Continue with email</button>
            </form>

            <div class="auth-divider"><span>Or use Google</span></div>
            @if (Model.GoogleAvailable)
            {
                <a class="button-like button-like--secondary auth-panel__primary" href="@Model.GoogleStartHref">Continue with Google</a>
            }
            else
            {
                <button class="button-like button-like--ghost auth-panel__primary" type="button" disabled>Google unavailable</button>
                <p class="muted-copy">@Model.GoogleUnavailableReason</p>
            }
        }
        else
        {
            <div class="auth-panel__intro">
                <h3>Fastest way back in</h3>
                <p>Sign in to reopen your downloads, devices and access, support history, roadmap follows, and any optional participation state already attached to your account.</p>
            </div>
            <div class="auth-benefits">
                <span class="tag">What opens after sign-in</span>
                <ul>
                    <li>Your signed-in home and account pages for continuity, recovery, and the next safe action.</li>
                    <li>Account-linked download receipts, claim tickets, and device continuity.</li>
                    <li>Any beta interest, update follows, support history, or optional participation state already on the account.</li>
                </ul>
            </div>
            <p class="muted-copy">After verification you return to @nextTarget.</p>
            @if (isInstallLinkReturn)
            {
                <p class="muted-copy">The next page opens Chummer to finish linking this install, with a manual open button if the browser blocks the app handoff.</p>
            }

            <form class="auth-form" method="post" action="/auth/email/start">
                @Html.AntiForgeryToken()
                <input type="hidden" name="next" value="@Model.NextPath" />
                <div class="field">
                    <label for="email">Email</label>
                    <input id="email" name="email" type="email" placeholder="runner@example.com" required />
                </div>
                <button class="button-like button-like--primary auth-panel__primary" type="submit">Send magic link</button>
            </form>

            <div class="auth-divider"><span>Or use Google</span></div>
            @if (Model.GoogleAvailable)
            {
                <a class="button-like button-like--secondary auth-panel__primary" href="@Model.GoogleStartHref">Continue with Google</a>
            }
            else
            {
                <button class="button-like button-like--ghost auth-panel__primary" type="button" disabled>Google unavailable</button>
                <p class="muted-copy">@Model.GoogleUnavailableReason</p>
            }
        }
        <p class="privacy-note">The account keeps release access, updates, linked installs, devices and access, and support history together.</p>
    </div>
</section>

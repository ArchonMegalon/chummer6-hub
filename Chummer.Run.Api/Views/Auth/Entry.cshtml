@model AuthPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-auth surface-minimal";
    var accessPosture = Model.AccessPosture;
    var isInstallLinkReturn = Model.NextPath.StartsWith("/account/access/install-link", StringComparison.OrdinalIgnoreCase);
    var installLinkReturnsToLocalApp = false;
    static bool IsLoopbackCallbackUri(string candidate)
    {
        return Uri.TryCreate(candidate, UriKind.Absolute, out var parsedCallback)
            && parsedCallback.IsLoopback
            && (string.Equals(parsedCallback.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)
                || string.Equals(parsedCallback.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase));
    }

    if (isInstallLinkReturn)
    {
        var parsedNextPath = new Uri($"https://chummer.run{Model.NextPath}", UriKind.Absolute);
        var nextQuery = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(parsedNextPath.Query);
        if (nextQuery.TryGetValue("installLinkCallbackUri", out var callbackValues))
        {
            var callbackUri = callbackValues.ToString();
            installLinkReturnsToLocalApp = IsLoopbackCallbackUri(callbackUri);
        }
    }
    var nextTarget = isInstallLinkReturn
        ? "this copy"
        : Model.NextPath.StartsWith("/downloads", StringComparison.OrdinalIgnoreCase)
        ? "Downloads"
        : Model.NextPath.StartsWith("/account", StringComparison.OrdinalIgnoreCase)
            ? "Account"
            : Model.NextPath.StartsWith("/home", StringComparison.OrdinalIgnoreCase)
                ? "Home"
                : "the account area";
}

<section class="auth-entry" aria-labelledby="auth-title">
    <div class="auth-entry__panel auth-panel auth-panel--entry">
        <div class="auth-panel__intro auth-panel__intro--masthead">
            <p class="eyebrow">Account</p>
            <h1 id="auth-title">@(isInstallLinkReturn ? "Claim your copy" : Model.CreateAccount ? "Create account" : "Sign in")</h1>
            <p>@(isInstallLinkReturn ? "Connect this install to your account. The download stays the same for everyone." : "Use email or Google. You can download Chummer without an account.")</p>
        </div>

        <div class="auth-panel__mode-row">
            @if (Model.CreateAccount)
            {
                <span class="action-pill action-pill--current">Create account</span>
                <a class="action-pill action-pill--ghost" href="/login?next=@Uri.EscapeDataString(Model.NextPath)">Sign in</a>
            }
            else
            {
                <span class="action-pill action-pill--current">Sign in</span>
                <a class="action-pill action-pill--ghost" href="/signup?next=@Uri.EscapeDataString(Model.NextPath)">Create account</a>
            }
        </div>

        @if (Model.CreateAccount)
        {
            <div class="auth-panel__intro">
                <h2>@(isInstallLinkReturn ? "Claim with email" : "Email")</h2>
                <p>@(isInstallLinkReturn ? "Use the email that should own this install." : "We send one link. No password.")</p>
            </div>
            <p class="muted-copy">After you confirm the email, you return to @nextTarget.</p>
            @if (isInstallLinkReturn)
            {
                <p class="muted-copy">@(installLinkReturnsToLocalApp
                    ? "Keep Chummer open while the browser connects this copy."
                    : "If the browser cannot return to Chummer, open this page again from the app.")</p>
            }
            <form class="auth-form" method="post" action="/auth/email/start">
                @Html.AntiForgeryToken()
                <input type="hidden" name="next" value="@Model.NextPath" />
                <div class="field">
                    <label for="email">Email</label>
                    <input id="email" name="email" type="email" placeholder="runner@example.com" required />
                </div>
                <button class="button-like button-like--primary" type="submit">@(isInstallLinkReturn ? "Claim with email" : "Continue with email")</button>
            </form>

            <div class="auth-divider"><span>or</span></div>
            @if (Model.GoogleAvailable)
            {
                <a class="button-like button-like--secondary auth-panel__primary" href="@Model.GoogleStartHref">Continue with Google</a>
            }
            else
            {
                <button class="button-like button-like--ghost auth-panel__primary" type="button" disabled>Google unavailable</button>
                <p class="muted-copy">@Model.GoogleUnavailableReason</p>
            }
        }
        else
        {
            <div class="auth-panel__intro">
                <h2>@(isInstallLinkReturn ? "Claim with your account" : "Email")</h2>
                <p>@(isInstallLinkReturn ? "Use the account that should own this install." : $"We send one link, then return you to {nextTarget}.")</p>
            </div>
            @if (isInstallLinkReturn)
            {
                <p class="muted-copy">@(installLinkReturnsToLocalApp
                    ? "Keep Chummer open while the browser connects this copy."
                    : "If the browser cannot return to Chummer, open this page again from the app.")</p>
            }

            <form class="auth-form" method="post" action="/auth/email/start">
                @Html.AntiForgeryToken()
                <input type="hidden" name="next" value="@Model.NextPath" />
                <div class="field">
                    <label for="email">Email</label>
                    <input id="email" name="email" type="email" placeholder="runner@example.com" required />
                </div>
                <button class="button-like button-like--primary auth-panel__primary" type="submit">Send magic link</button>
            </form>

            <div class="auth-divider"><span>or</span></div>
            @if (Model.GoogleAvailable)
            {
                <a class="button-like button-like--secondary auth-panel__primary" href="@Model.GoogleStartHref">Continue with Google</a>
            }
            else
            {
                <button class="button-like button-like--ghost auth-panel__primary" type="button" disabled>Google unavailable</button>
                <p class="muted-copy">@Model.GoogleUnavailableReason</p>
            }
        }
        <p class="privacy-note">Accounts are optional unless a private page or install claim needs one.</p>
    </div>
</section>

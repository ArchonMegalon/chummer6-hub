@model AuthPageViewModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = Model.CreateAccount ? "surface-auth surface-minimal" : "surface-auth surface-minimal surface-auth-login";
    ViewData["HideAuthChrome"] = !Model.CreateAccount;

    var introCopy = Model.CreateAccount
        ? "Use email to create your account."
        : (string.IsNullOrWhiteSpace(Model.SupportLine) ? "Use your email to continue." : Model.SupportLine);
    var pageHeading = Model.CreateAccount ? "Get started" : "Sign in";
}

<section class="auth-entry auth-entry--lean" aria-labelledby="auth-title">
    <div class="auth-panel auth-panel--entry">
        <div class="auth-panel__intro auth-panel__intro--masthead">
            <h1 id="auth-title">@pageHeading</h1>
            <p class="auth-panel__hint">@introCopy</p>
        </div>

        <form class="auth-form" method="post" action="/auth/email/start">
            @Html.AntiForgeryToken()
            <input type="hidden" name="next" value="@Model.NextPath" />
            <div class="field">
                <label for="email" class="field-label">Email</label>
                <input
                    id="email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    placeholder="runner@example.com"
                    inputmode="email"
                    required />
            </div>
            <button class="button-like button-like--primary auth-panel__primary" type="submit">Continue</button>
        </form>

        @if (Model.GoogleAvailable)
        {
            <div class="auth-divider"><span>or</span></div>
            <a class="button-like button-like--secondary auth-panel__primary" href="@Model.GoogleStartHref">Continue with Google</a>
        }
    </div>
</section>

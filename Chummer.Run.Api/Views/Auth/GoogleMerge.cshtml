@model GoogleMergePageViewModel
@{
    ViewData["Title"] = "Confirm Google account link";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-auth surface-minimal surface-auth-message";
    ViewData["HideAuthChrome"] = true;
}

<section class="auth-entry auth-entry--lean" aria-labelledby="auth-merge-title">
    <div class="auth-panel auth-panel--entry">
        <div class="auth-panel__intro auth-panel__intro--masthead">
            <p class="auth-panel__eyebrow">Confirm account link</p>
            <h1 id="auth-merge-title">Use the existing account</h1>
            <p class="auth-panel__hint"><strong>@Model.VerifiedEmail</strong> already belongs to <strong>@Model.ExistingDisplayName</strong>.</p>
        </div>
        <form method="post" action="/auth/google/merge" class="auth-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="mergeToken" value="@Model.MergeToken" />
            <button class="button-like button-like--primary auth-panel__primary" type="submit">Use existing account</button>
        </form>
        <div class="stacked-actions">
            <a class="button-like button-like--secondary auth-panel__primary" href="/login?next=@Uri.EscapeDataString(Model.NextPath)">Cancel</a>
        </div>
    </div>
</section>

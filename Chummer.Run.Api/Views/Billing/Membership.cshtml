@model BillingMembershipPageViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Billing";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-billing surface-minimal";
    var free = Model.FreePlan;
    var supporter = Model.SupporterPlan;
    var hasUserId = !string.IsNullOrWhiteSpace(Model.UserId);
    var usingSignedInAccount = Model.UsingSignedInAccount && hasUserId;
    var quota = Model.CurrentOriginAuthoringAllowance;
    var hasManageMembershipHref = !string.IsNullOrWhiteSpace(Model.ManageMembershipHref);
    var antiForgery = Antiforgery.GetAndStoreTokens(Context);
    var signedInLabel = string.IsNullOrWhiteSpace(Model.SignedInLabel) ? Model.Email ?? Model.UserId : Model.SignedInLabel;
}
<section class="minimal-page-hero">
    <div>
        <p class="eyebrow">Membership</p>
        <h1>@Model.Heading</h1>
        <p>@Model.Summary</p>
        <ul class="minimal-hero__points">
            <li>Same app.</li>
            <li>Origin Books: 1/month on Free. 2/month on Supporter.</li>
            @if (usingSignedInAccount)
            {
                <li>Signed in as @signedInLabel</li>
            }
            @if (quota is not null)
            {
                <li>This month: @quota.WindowUsed / @quota.WindowLimit books</li>
            }
        </ul>
    </div>
</section>

@if (Model.Unavailable)
{
    <section class="minimal-section minimal-section--tight">
        <div class="minimal-lane-grid minimal-platform-list">
            <article class="minimal-lane-card billing-plan-card">
                <span class="tag">Unavailable</span>
                <h2>Free access stays the same</h2>
                <p>Supporter checkout is unavailable right now.</p>
                <div class="minimal-actions">
                    @if (!hasUserId)
                    {
                        <a class="button-like button-like--secondary" href="/login?next=%2Faccount%2Fbilling">Continue with email</a>
                    }
                    <a class="button-like button-like--primary" href="/downloads">Downloads</a>
                </div>
            </article>
        </div>
    </section>
}
else
{
    <section class="minimal-section">
        <div class="minimal-section__lead">
            <p class="eyebrow">Plans</p>
            <h2>Only the book allowance changes</h2>
            <p>No extra app features right now.</p>
        </div>
        <div class="minimal-lane-grid minimal-platform-list">
            @if (free is not null)
            {
                <article class="minimal-lane-card billing-plan-card">
                    <span class="tag">Free</span>
                    <h2>@free.Name</h2>
                    <p>Default plan. Same app. 1 Origin Book each month.</p>
                    <div class="route-choice-card__details">
                        <span>Default</span>
                        <span>1 book/month</span>
                        <span>Everything else stays the same</span>
                    </div>
                </article>
            }
            @if (supporter is not null)
            {
                <article class="minimal-lane-card billing-plan-card">
                    <span class="tag">Supporter</span>
                    <h2>@supporter.Name</h2>
                    <p>Same app. 2 Origin Books each month. Supporter helps pay for Chummer.</p>
                    <div class="route-choice-card__details">
                        <span>2 books/month</span>
                        <span>Same app</span>
                    </div>
                    <form class="billing-plan-form" method="post" action="/account/billing/supporter">
                        <input type="hidden" name="__RequestVerificationToken" value="@antiForgery.RequestToken">
                        @if (hasUserId)
                        {
                            <input type="hidden" name="userId" value="@Model.UserId">
                            @if (!string.IsNullOrWhiteSpace(Model.Email))
                            {
                                <input type="hidden" name="email" value="@Model.Email">
                            }
                            <p class="muted-copy">Checkout stays attached to this account.</p>
                        }
                        else
                        {
                            <p class="muted-copy">Continue with email first. Chummer attaches supporter status after sign-in.</p>
                        }
                        <p class="muted-copy">Supporter only changes the monthly Origin Book limit.</p>
                        <div class="minimal-actions">
                            @if (hasUserId)
                            {
                                <button class="button-like button-like--primary" type="submit">Support Chummer</button>
                            }
                            else
                            {
                                <a class="button-like button-like--primary" href="/login?next=%2Faccount%2Fbilling">Continue with email</a>
                            }
                            @if (hasManageMembershipHref)
                            {
                                <a class="button-like button-like--ghost" href="@Model.ManageMembershipHref">Manage billing</a>
                            }
                        </div>
                    </form>
                </article>
            }
        </div>
    </section>
}

@model BillingMembershipPageViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Membership";
    ViewData["Chrome"] = Model.Chrome;
    ViewData["SurfaceClass"] = "surface-billing surface-minimal";
    var hasUserId = !string.IsNullOrWhiteSpace(Model.UserId);
    var usingSignedInAccount = Model.UsingSignedInAccount && hasUserId;
    var quota = Model.CurrentOriginAuthoringAllowance;
    var hasManageMembershipHref = !string.IsNullOrWhiteSpace(Model.ManageMembershipHref);
    var supporterActive = quota?.SupporterActive == true;
    var showManageSupporterAction = usingSignedInAccount && supporterActive && hasManageMembershipHref;
    var antiForgery = Antiforgery.GetAndStoreTokens(Context);
    var signedInLabel = string.IsNullOrWhiteSpace(Model.SignedInLabel) ? Model.Email ?? Model.UserId : Model.SignedInLabel;
    var primaryActionLabel = !hasUserId
        ? "Continue with email"
        : supporterActive
            ? showManageSupporterAction
                ? "Manage supporter"
                : null
            : "Become supporter";
    var primaryActionHref = !hasUserId
        ? "/login?next=%2Faccount%2Fbilling"
        : showManageSupporterAction
            ? Model.ManageMembershipHref
            : null;
}
<section class="minimal-page-hero">
    <div>
        <p class="eyebrow">Supporter</p>
        <h1>@Model.Heading</h1>
        <p>@Model.Summary</p>
        <ul class="minimal-hero__points">
            <li>1 book/month on Free. 2/month on Supporter.</li>
            @if (usingSignedInAccount)
            {
                <li>@signedInLabel</li>
            }
            @if (quota is not null)
            {
                <li>@quota.WindowUsed / @quota.WindowLimit used this month</li>
            }
        </ul>
        <div class="minimal-actions">
            @if (!string.IsNullOrWhiteSpace(primaryActionLabel))
            {
                if (hasUserId && !supporterActive && !Model.Unavailable)
                {
                    <form class="billing-plan-form" method="post" action="/account/billing/supporter">
                        <input type="hidden" name="__RequestVerificationToken" value="@antiForgery.RequestToken">
                        <input type="hidden" name="userId" value="@Model.UserId">
                        @if (!string.IsNullOrWhiteSpace(Model.Email))
                        {
                            <input type="hidden" name="email" value="@Model.Email">
                        }
                        <button class="button-like button-like--primary" type="submit">@primaryActionLabel</button>
                    </form>
                }
                else if (!string.IsNullOrWhiteSpace(primaryActionHref))
                {
                    <a class="button-like button-like--primary" href="@primaryActionHref">@primaryActionLabel</a>
                }
            }
            <a class="button-like button-like--ghost" href="/account">Back to account</a>
        </div>
    </div>
</section>

<section class="minimal-section minimal-section--tight">
    <article class="minimal-lane-card billing-plan-card">
        <span class="tag">Membership</span>
        <h2>Only the book limit changes</h2>
        <p>No extra app features today.</p>
        <div class="route-choice-card__details">
            <span>Free · 1 book/month</span>
            <span>Supporter · 2 books/month</span>
            <span>Same app</span>
        </div>
        @if (Model.Unavailable)
        {
            <p class="muted-copy">Supporter is not open right now.</p>
        }
        else if (hasUserId)
        {
            <p class="muted-copy">@(supporterActive ? "Supporter is already attached to this account." : "Checkout stays attached to this account.")</p>
        }
        else
        {
            <p class="muted-copy">Email first. Supporter status attaches after sign-in.</p>
        }
    </article>
</section>

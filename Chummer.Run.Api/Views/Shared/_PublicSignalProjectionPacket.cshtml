@model PublicSignalProjectionPacketViewModel
@{
    string FormatProjectionLabel(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        string normalized = value.Trim();
        int slash = normalized.LastIndexOf('/');
        if (slash >= 0 && slash < normalized.Length - 1)
        {
            normalized = normalized[(slash + 1)..];
        }

        normalized = normalized
            .Replace(".md", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace(".yaml", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace(".yml", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace('_', ' ')
            .Replace('-', ' ');

        return System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(normalized.ToLowerInvariant());
    }

    string SanitizeProjectionText(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value
            .Replace("Canonical Roadmap Truth", "Roadmap decisions", StringComparison.OrdinalIgnoreCase)
            .Replace("Release Truth", "Release status", StringComparison.OrdinalIgnoreCase)
            .Replace("Support Case Truth", "Support cases", StringComparison.OrdinalIgnoreCase)
            .Replace("Implementation Priority", "Implementation priority", StringComparison.OrdinalIgnoreCase)
            .Replace("Public Signal To Canon Pipeline", "Public Signal Review Pipeline", StringComparison.OrdinalIgnoreCase)
            .Replace("Canon is decided by Chummer", "Product decisions happen in Chummer", StringComparison.OrdinalIgnoreCase)
            .Replace("canonical patch or milestone", "product record or milestone", StringComparison.OrdinalIgnoreCase)
            .Replace("canonical", "product record", StringComparison.OrdinalIgnoreCase)
            .Replace("canon", "product decisions", StringComparison.OrdinalIgnoreCase)
            .Replace("projection-only", "public-view only", StringComparison.OrdinalIgnoreCase)
            .Replace("projection", "public view", StringComparison.OrdinalIgnoreCase)
            .Replace("Product Governor", "product decision", StringComparison.OrdinalIgnoreCase)
            .Replace("ProductLift", "public feedback board", StringComparison.OrdinalIgnoreCase)
            .Replace("EA synthesis", "product review", StringComparison.OrdinalIgnoreCase)
            .Replace("productlift_idea_clustered", "public feedback signal", StringComparison.OrdinalIgnoreCase)
            .Replace("Icanpreneur", "guided synthesis lane", StringComparison.OrdinalIgnoreCase)
            .Replace("Deftform", "structured pre-screen", StringComparison.OrdinalIgnoreCase)
            .Replace("FacePop", "public invitation", StringComparison.OrdinalIgnoreCase)
            .Replace("Lunacal", "scheduled follow-up", StringComparison.OrdinalIgnoreCase)
            .Replace("Emailit", "delivery adapter", StringComparison.OrdinalIgnoreCase);
    }

    var authorityFlow = Model.AuthorityFlow.Take(4).ToArray();
    var decisionRoutes = Model.DecisionRoutes.Take(4).ToArray();
    var forbidden = Model.Forbidden.Take(4).ToArray();
    var canonicalSources = Model.CanonicalSources
        .Select(FormatProjectionLabel)
        .Select(SanitizeProjectionText)
        .Where(static item => !string.IsNullOrWhiteSpace(item))
        .Take(4)
        .ToArray();
    var boardTargets = Model.BoardTargets
        .Select(SanitizeProjectionText)
        .Take(6)
        .ToArray();
    var journeyProofEvents = Model.JourneyProofEventRefs
        .Take(4)
        .ToArray();
    var sourceReceipts = new[]
    {
        FormatProjectionLabel(Model.PolicySource),
        FormatProjectionLabel(Model.PipelineSource),
        FormatProjectionLabel(Model.RegistrySource)
    }
    .Select(SanitizeProjectionText)
    .Where(static item => !string.IsNullOrWhiteSpace(item))
    .Distinct(StringComparer.Ordinal)
    .ToArray();
}

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">@SanitizeProjectionText(Model.Eyebrow)</p>
        <h2 class="editorial-title">@SanitizeProjectionText(Model.Heading)</h2>
        <p class="editorial-copy">@SanitizeProjectionText(Model.Summary)</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">@SanitizeProjectionText(Model.Vendor)</span>
            <h3>Open first-party fallback</h3>
            <p>@SanitizeProjectionText(Model.PolicyStatus)</p>
            <div class="route-choice-card__proof">
                <span>Role: @Model.Role</span>
                <span>Public page: @Model.PublicPath</span>
                <span>Chummer path: @Model.FallbackPath</span>
                <span>@SanitizeProjectionText(Model.TruthPosture)</span>
            </div>
            <a class="editorial-strip__action" href="@Model.FallbackPath">Open Chummer path</a>
        </article>
        <article class="route-choice-card">
            <span class="tag">Core rule</span>
            <h3>@Model.CoreRule</h3>
            <p>The public board can collect visible demand, but Chummer review still decides what changes.</p>
            @if (authorityFlow.Length > 0)
            {
                <div class="compact-rail">
                    @for (var i = 0; i < authorityFlow.Length; i++)
                    {
                        <article class="compact-rail__item">
                            <div class="compact-rail__copy">
                                <h3>Stage @(i + 1)</h3>
                                <p>@SanitizeProjectionText(authorityFlow[i])</p>
                            </div>
                        </article>
                    }
                </div>
            }
        </article>
        <article class="route-choice-card">
            <span class="tag">Boundary conditions</span>
            <h3>Decision paths stay explicit.</h3>
            <p>Public signal can move into review tracks, but it cannot become support, roadmap, or release status by itself.</p>
            @if (decisionRoutes.Length > 0)
            {
                <div class="route-choice-card__proof">
                    @foreach (var route in decisionRoutes)
                    {
                        <span>@SanitizeProjectionText(route)</span>
                    }
                </div>
            }
            @if (forbidden.Length > 0)
            {
                <div class="compact-rail">
                    <article class="compact-rail__item">
                        <div class="compact-rail__copy">
                            <h3>Not handled here</h3>
                            <p>@string.Join(" / ", forbidden.Select(SanitizeProjectionText))</p>
                        </div>
                    </article>
                </div>
            }
            <div class="compact-rail">
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <h3>Required public warning</h3>
                        <p>@SanitizeProjectionText(Model.PublicWarning)</p>
                    </div>
                </article>
            </div>
        </article>
        <article class="route-choice-card">
            <span class="tag">Review signals</span>
            <h3>Product records and shipped-update checks stay behind the public board.</h3>
            <p>These records keep the public board connected to real product review while the page handles visibility and follow-up.</p>
            @if (sourceReceipts.Length > 0)
            {
                <div class="route-choice-card__proof">
                    @foreach (var receipt in sourceReceipts)
                    {
                        <span>@receipt</span>
                    }
                </div>
            }
            <div class="compact-rail">
                @if (canonicalSources.Length > 0)
                {
                    <article class="compact-rail__item">
                        <div class="compact-rail__copy">
                        <h3>Canonical sources</h3>
                        <p>@string.Join(" / ", canonicalSources)</p>
                        </div>
                    </article>
                }
                @if (boardTargets.Length > 0)
                {
                    <article class="compact-rail__item">
                        <div class="compact-rail__copy">
                            <h3>First board set</h3>
                            <p>@string.Join(" / ", boardTargets)</p>
                        </div>
                    </article>
                }
                @if (Model.CloseoutRequirements.Count > 0)
                {
                    <article class="compact-rail__item">
                        <div class="compact-rail__copy">
                        <h3>Shipped closeout gate</h3>
                        <p>@string.Join(" / ", Model.CloseoutRequirements.Select(SanitizeProjectionText))</p>
                        </div>
                    </article>
                }
                @if (journeyProofEvents.Length > 0)
                {
                    <article class="compact-rail__item">
                        <div class="compact-rail__copy">
                            <h3>Journey refs</h3>
                            <p>@string.Join(" / ", journeyProofEvents.Select(item => SanitizeProjectionText(item.EventKey)))</p>
                        </div>
                    </article>
                }
            </div>
        </article>
    </div>
</section>

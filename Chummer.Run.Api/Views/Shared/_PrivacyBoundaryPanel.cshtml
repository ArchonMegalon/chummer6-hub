@model PrivacyBoundaryPanelViewModel
@{
    static string PublicPrivacyText(string? value) => UndetectableHumanizerCopyAdapter.Humanize(value);
}

<section class="release-shelf" aria-label="Privacy boundaries">
    <article class="app-action-card">
        <span class="tag">@PublicPrivacyText(Model.Eyebrow)</span>
        <h2>@PublicPrivacyText(Model.Heading)</h2>
        <p>@PublicPrivacyText(Model.Summary)</p>
        @if (Model.MicroProof.Count > 0)
        {
            <div class="trust-claim__details">
                @foreach (var item in Model.MicroProof)
                {
                    <span>@PublicPrivacyText(item)</span>
                }
            </div>
        }
        <div class="stacked-actions">
            <a class="button-like button-like--@Model.PrimaryAction.Tone" href="@Model.PrimaryAction.Href">@PublicPrivacyText(Model.PrimaryAction.Label)</a>
            @if (Model.SecondaryAction is not null)
            {
                <a class="button-like button-like--@Model.SecondaryAction.Tone" href="@Model.SecondaryAction.Href">@PublicPrivacyText(Model.SecondaryAction.Label)</a>
            }
        </div>
    </article>

    <div class="workflow-grid">
        @foreach (var domain in Model.Domains)
        {
            <article class="workflow-card">
                <div class="workflow-card__copy">
                    <h3>@PublicPrivacyText(domain.Label)</h3>
                    <p>@PublicPrivacyText(domain.PublicProjection)</p>
                    <p class="muted-copy">@PublicPrivacyText(domain.SignedInProjection)</p>
                </div>
            </article>
        }
    </div>
</section>

@model PublicTrustPulsePanelViewModel

<section class="release-shelf" aria-label="Weekly trust pulse">
    <article class="app-action-card">
        <span class="tag">@Model.Eyebrow</span>
        <h2>@Model.Heading</h2>
        @await Html.PartialAsync("~/Views/Shared/_PublicTrustPulseBody.cshtml", Model)
        <div class="stacked-actions">
            <a class="button-like button-like--@Model.PrimaryAction.Tone" href="@Model.PrimaryAction.Href">@Model.PrimaryAction.Label</a>
            @if (Model.SecondaryAction is not null)
            {
                <a class="button-like button-like--@Model.SecondaryAction.Tone" href="@Model.SecondaryAction.Href">@Model.SecondaryAction.Label</a>
            }
        </div>
    </article>
</section>

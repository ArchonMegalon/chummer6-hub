@{
    var pageTitle = ViewData["Title"] as string ?? "Install Chummer Play";
    var manifestHref = ViewData["MobileManifestHref"] as string ?? "/manifest.play.webmanifest";
    var appleAppTitle = ViewData["MobileAppleAppTitle"] as string ?? "Chummer Play";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f1b26" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="@appleAppTitle" />
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet,noimageindex" />
    <title>@pageTitle</title>
    <link rel="manifest" href="@manifestHref" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="stylesheet" href="/mobile.css" />
</head>
<body>
    @RenderBody()
    <script src="/js/mobile-app-handoff.js" defer></script>
    <script src="/mobile-install-shell.js" defer></script>
</body>
</html>

                <article class="route-choice-card">
                    <span class="tag">@run.Status</span>
                    <h3>@run.DispatchReceiptsCreated recovered dispatch receipt@(run.DispatchReceiptsCreated == 1 ? string.Empty : "s")</h3>
                    <p>@run.Summary</p>
                    <div class="route-choice-card__proof">
                        <span>@run.RunReceiptId</span>
                        <span>@run.CandidateReceiptCount candidate receipt@(run.CandidateReceiptCount == 1 ? string.Empty : "s")</span>
                        <span>@run.ReadyCandidateCount recovered</span>
                        <span>@run.ReplayCandidateCount suppressed hold@(run.ReplayCandidateCount == 1 ? string.Empty : "s")</span>
                        <span>@run.JourneyReceiptsRecorded blocked</span>
                        <span>@run.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (recentDispatchReceipts.Length > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Outbound delivery</p>
            <h2 class="editorial-title">Ready ProductLift closeout candidates now become first-party queued or sent delivery receipts instead of staying theoretical.</h2>
            <p class="editorial-copy">These rows keep raw email out of stored state. Hub stores recipient refs, address hashes, template ids, idempotency keys, and provider-safe delivery posture only.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var receipt in recentDispatchReceipts)
            {
                <article class="route-choice-card">
                    <span class="tag">@receipt.StatusLabel</span>
                    <h3>@receipt.TemplateId · @receipt.DeliveryState</h3>
                    <p>@receipt.Summary</p>
                    @if (!string.IsNullOrWhiteSpace(receipt.Error))
                    {
                        <p class="muted-copy">@receipt.Error</p>
                    }
                    <div class="route-choice-card__proof">
                        <span>@receipt.ReceiptId</span>
                        <span>@receipt.DeliveryId</span>
                        <span>@receipt.RecipientRef</span>
                        <span>@receipt.AddressHash</span>
                        <span>@receipt.TemplateVersion</span>
                        <span>@receipt.ConsentSourceRef</span>
                        <span>@receipt.SuppressionCheck</span>
                        <span>@receipt.GovernorDecisionRef</span>
                        <span>@receipt.ReleaseProofReceiptId</span>
                        <span>@receipt.RequestedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        @if (receipt.AcceptedAtUtc is { } acceptedAtUtc)
                        {
                            <span>@acceptedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        }
                        @if (receipt.LastRecoveryAtUtc is { } lastRecoveryAtUtc)
                        {
                            <span>@lastRecoveryAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(receipt.ProviderMessageId))
                        {
                            <span>@receipt.ProviderMessageId</span>
                        }
                        @if (receipt.RecoveryAttemptCount > 0)
                        {
                            <span>@receipt.RecoveryAttemptCount recovery attempt@(receipt.RecoveryAttemptCount == 1 ? string.Empty : "s")</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(receipt.LastRecoveryStatus))
                        {
                            <span>@receipt.LastRecoveryStatus</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(receipt.LastProviderState))
                        {
                            <span>@receipt.LastProviderState</span>
                        }
                        @if (receipt.NextAutomaticRetryAtUtc is { } nextAutomaticRetryAtUtc)
                        {
                            <span>@nextAutomaticRetryAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        }
                        @if (receipt.LastOutcomeAtUtc is { } lastOutcomeAtUtc)
                        {
                            <span>@lastOutcomeAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        }
                        @if (!receipt.PublicClaimAllowed)
                        {
                            <span>No public send claim</span>
                        }
                    </div>
                    <a class="editorial-strip__action" href="@ThreadDetailHref(receipt.ReceiptId, ResolveDispatchContextFilterKey(receipt.DeliveryState, receipt.SuppressionCheck, receipt.LastOutcomeAtUtc is not null))">Open thread detail</a>
                </article>
            }
        </div>
    </section>
}

@if (recentJourneyReceipts.Length > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Journey writeback</p>
            <h2 class="editorial-title">The ProductLift closeout rail now writes bounded voter-notified journey evidence only after the first-party send path completes.</h2>
            <p class="editorial-copy">This stays on the Hub side of the boundary: ProductLift says something shipped, but Chummer records the notification event only after governor truth, release proof, and the first-party outbound lane line up.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var receipt in recentJourneyReceipts)
            {
                <article class="route-choice-card">
                    <span class="tag">@receipt.StatusLabel</span>
                    <h3>@receipt.EventKey</h3>
                    <p>@receipt.Summary</p>
                    <div class="route-choice-card__proof">
                        <span>@receipt.ReceiptId</span>
                        <span>@receipt.GovernorDecisionRef</span>
                        <span>@receipt.ReleaseProofReceiptId</span>
                        <span>@receipt.SentCount of @receipt.RecipientCount sent</span>
                        <span>@receipt.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        @if (!receipt.PublicClaimAllowed)
                        {
                            <span>No public journey claim</span>
                        }
                    </div>
                    <a class="editorial-strip__action" href="@SourceDetailHref(receipt.SourceReceiptId, "sent")">Open source detail</a>
                </article>
            }
        </div>
    </section>
}

@if (recentQueueReceipts.Length > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Outbox candidates</p>
            <h2 class="editorial-title">Shipped ProductLift items now materialize bounded Hub outbox candidate receipts from governor truth and current changelog proof.</h2>
            <p class="editorial-copy">These rows still do not claim a send or a voter_notified journey receipt. They show whether Chummer can hand a shipped ProductLift closeout into the Hub-owned outbox contract without letting provider state become notification truth.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var receipt in recentQueueReceipts)
            {
                <article class="route-choice-card">
                    <span class="tag">@receipt.StatusLabel</span>
                    <h3>@receipt.QueueLane</h3>
                    <p>@receipt.Summary</p>
                    <p class="muted-copy">@receipt.QueueReason</p>
                    <div class="route-choice-card__proof">
                        <span>@receipt.ReceiptId</span>
                        <span>@receipt.QueueState</span>
                        <span>@receipt.DispatchTool</span>
                        <span>@receipt.DispatchAction</span>
                        <span>@receipt.JourneyEventKey</span>
                        <span>@(!string.IsNullOrWhiteSpace(receipt.GovernorDecisionRef) ? receipt.GovernorDecisionRef : "Governor pending")</span>
                        <span>@receipt.ReleaseProofRoute</span>
                        <span>@(!string.IsNullOrWhiteSpace(receipt.ReleaseProofReceiptId) ? receipt.ReleaseProofReceiptId : "Release proof pending")</span>
                        <span>@receipt.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        @if (receipt.ReadyForOutbox)
                        {
                            <span>Ready for Hub outbox</span>
                        }
                        else
                        {
                            <span>Outbox blocked</span>
                        }
                        @if (!receipt.PublicClaimAllowed)
                        {
                            <span>No public send claim</span>
                        }
                    </div>
                    <a class="editorial-strip__action" href="/feedback/operations/source/@Uri.EscapeDataString(receipt.SourceReceiptId)">Open source detail</a>
                </article>
            }
        </div>
    </section>
}

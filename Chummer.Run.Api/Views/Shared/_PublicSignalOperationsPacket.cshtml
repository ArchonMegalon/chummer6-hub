@model PublicSignalOperationsPacketViewModel
@{
    var hostedRoutes = Model.HostedRoutes.ToArray();
    var deliveryOutcomeIngresses = Model.DeliveryOutcomeIngresses.ToArray();
    var categories = Model.Categories.Take(6).ToArray();
    var recentReceipts = Model.RecentReceipts.Take(6).ToArray();
    var recentRoutingReceipts = Model.RecentRoutingReceipts.Take(6).ToArray();
    var recentCloseoutReceipts = Model.RecentCloseoutReceipts.Take(6).ToArray();
    var recentQueueReceipts = Model.RecentQueueReceipts.Take(6).ToArray();
    var recentDispatchReceipts = Model.RecentDispatchReceipts.Take(6).ToArray();
    var recentJourneyReceipts = Model.RecentJourneyReceipts.Take(6).ToArray();
    var recentDeliveryOutcomes = Model.RecentDeliveryOutcomes.Take(6).ToArray();
    var recentRecipientThreads = Model.RecentRecipientThreads.Take(6).ToArray();
    var recentReconcileRuns = Model.RecentReconcileRuns.Take(6).ToArray();
    var recentRecoveryRuns = Model.RecentRecoveryRuns.Take(6).ToArray();
    var recentRetryExpiryRuns = Model.RecentRetryExpiryRuns.Take(6).ToArray();
    var rules = Model.Rules.Take(4).ToArray();
    string AppendDetailFilter(string baseHref, string filterKey)
        => string.Equals(filterKey, "all", StringComparison.Ordinal)
            ? baseHref
            : $"{baseHref}?filter={Uri.EscapeDataString(filterKey)}";
    string ResolveDispatchContextFilterKey(string deliveryState, string suppressionCheck, bool hasOutcomeReceipt)
    {
        if (hasOutcomeReceipt && string.Equals(deliveryState, "sent", StringComparison.OrdinalIgnoreCase))
        {
            return "sent";
        }

        if (string.Equals(deliveryState, "retrying", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(suppressionCheck, "suppressed", StringComparison.OrdinalIgnoreCase))
        {
            return "retrying";
        }

        if (string.Equals(suppressionCheck, "suppressed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(deliveryState, "suppressed", StringComparison.OrdinalIgnoreCase))
        {
            return "suppressed";
        }

        if (!hasOutcomeReceipt)
        {
            return "callback_pending";
        }

        return "all";
    }
    string ResolveThreadContextFilterKey(PublicSignalRecipientThreadViewModel thread)
        => ResolveDispatchContextFilterKey(
            thread.DispatchState,
            string.Equals(thread.OutcomeStatusLabel, "Provider suppression", StringComparison.OrdinalIgnoreCase)
                ? "suppressed"
                : "passed",
            !string.IsNullOrWhiteSpace(thread.OutcomeReceiptId));
    string ResolveOutcomeContextFilterKey(PublicSignalDeliveryOutcomeReceiptViewModel receipt)
    {
        if (string.Equals(receipt.SuppressionCheck, "suppressed", StringComparison.OrdinalIgnoreCase))
        {
            return "suppressed";
        }

        if (receipt.RetryAtUtc is not null
            || receipt.ProviderState.Contains("retry", StringComparison.OrdinalIgnoreCase)
            || receipt.ProviderState.Contains("soft bounced", StringComparison.OrdinalIgnoreCase)
            || receipt.StatusLabel.Contains("retry", StringComparison.OrdinalIgnoreCase))
        {
            return "retrying";
        }

        if (receipt.ProviderState.Contains("delivered", StringComparison.OrdinalIgnoreCase)
            || receipt.ProviderState.Contains("sent", StringComparison.OrdinalIgnoreCase)
            || receipt.StatusLabel.Contains("confirmed sent", StringComparison.OrdinalIgnoreCase))
        {
            return "sent";
        }

        return "all";
    }
    string ThreadDetailHref(string dispatchReceiptId, string filterKey)
        => AppendDetailFilter($"/feedback/operations/thread/{Uri.EscapeDataString(dispatchReceiptId)}", filterKey);
    string SourceDetailHref(string sourceReceiptId, string filterKey)
        => AppendDetailFilter($"/feedback/operations/source/{Uri.EscapeDataString(sourceReceiptId)}", filterKey);
}

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">@Model.Eyebrow</p>
        <h2 class="editorial-title">@Model.Heading</h2>
        <p class="editorial-copy">@Model.Summary</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">Hosted route promotion</span>
            <h3>@(Model.HostedProjectionReady ? "Hosted ProductLift public routes are ready for a bounded domain split." : "Hosted ProductLift public routes are still pending on this instance.")</h3>
            <p>@Model.HostedProjectionSummary</p>
            <div class="route-choice-card__proof">
                <span>@Model.HostedDomainLabel</span>
                <span>@(Model.HostedProjectionReady ? "Ready for promotion" : "First-party default remains live")</span>
            </div>
            <div class="compact-rail">
                @foreach (var route in hostedRoutes)
                {
                    <article class="compact-rail__item">
                        <div class="compact-rail__copy">
                            <h3>@route.Label · @route.StatusLabel</h3>
                            <p>@route.Summary</p>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(route.HostedHref))
                        {
                            <a class="editorial-strip__action" href="@route.HostedHref" rel="noreferrer noopener" target="_blank">Inspect hosted route</a>
                        }
                        else
                        {
                            <span class="tag">@route.PublicPath</span>
                        }
                    </article>
                }
            </div>
        </article>
        <article class="route-choice-card">
            <span class="tag">Ingress and closeout</span>
            <h3>Webhook receipts and voter follow-up stay first-party-governed before promotion.</h3>
            <p>Hosted projection is not enough by itself. Chummer still needs receipt verification and a first-party closeout lane before a public board can become operationally real.</p>
            <div class="route-choice-card__proof">
                <span>@Model.WebhookStatusLabel</span>
                <span>@Model.VoterCloseoutStatusLabel</span>
                <span>@Model.RecipientProjectionStatusLabel</span>
                <span>@Model.QueueStatusLabel</span>
                <span>@Model.GovernorStatusLabel</span>
                <span>@Model.ReleaseProofStatusLabel</span>
                <span>@Model.ReceiptCount bounded receipt@(Model.ReceiptCount == 1 ? string.Empty : "s")</span>
                <span>@Model.RoutingReceiptCount routed follow-up@(Model.RoutingReceiptCount == 1 ? string.Empty : "s")</span>
            </div>
            <div class="compact-rail">
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <h3>@Model.WebhookStatusLabel</h3>
                        <p>@Model.WebhookSummary</p>
                    </div>
                </article>
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <h3>@Model.VoterCloseoutStatusLabel</h3>
                        <p>@Model.VoterCloseoutSummary</p>
                    </div>
                </article>
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <h3>@Model.RecipientProjectionStatusLabel</h3>
                        <p>@Model.RecipientProjectionSummary</p>
                    </div>
                    <div class="route-choice-card__proof">
                        <span>@Model.RecipientProjectionOwner</span>
                        <span>@Model.ProjectedRecipientCount projected follower@(Model.ProjectedRecipientCount == 1 ? string.Empty : "s")</span>
                        <span>@Model.ProjectionSourceRef</span>
                    </div>
                </article>
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <h3>@Model.ConsentStatusLabel</h3>
                        <p>@Model.ConsentSummary</p>
                    </div>
                    <span class="tag">@Model.ConsentSourceRef</span>
                    <a class="editorial-strip__action" href="@Model.FollowSettingsPath">Open follow settings</a>
                </article>
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <h3>@Model.QueueStatusLabel</h3>
                        <p>@Model.QueueSummary</p>
                    </div>
                </article>
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <h3>@Model.GovernorStatusLabel</h3>
                        <p>@Model.GovernorSummary</p>
                    </div>
                    <span class="tag">@(!string.IsNullOrWhiteSpace(Model.GovernorDecisionRef) ? Model.GovernorDecisionRef : "product_governor pending")</span>
                </article>
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <h3>@Model.ReleaseProofStatusLabel</h3>
                        <p>@Model.ReleaseProofSummary</p>
                    </div>
                    <div class="route-choice-card__proof">
                        <span>@Model.ReleaseProofRoute</span>
                        <span>@(!string.IsNullOrWhiteSpace(Model.ReleaseProofReceiptId) ? Model.ReleaseProofReceiptId : "No current proof receipt")</span>
                    </div>
                </article>
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <h3>@Model.CloseoutReceiptCount closeout candidate@(Model.CloseoutReceiptCount == 1 ? string.Empty : "s")</h3>
                        <p>
                            @if (Model.LastReceiptAtUtc is { } lastReceiptAtUtc)
                            {
                                @:Latest bounded provider receipt landed at @lastReceiptAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'"). Only route-safe metadata and the payload hash are retained.
                            }
                            else
                            {
                                @:No bounded ProductLift webhook receipts have been materialized on this instance yet.
                            }
                        </p>
                    </div>
                </article>
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <h3>@Model.CloseoutDeliveryCandidateCount delivery candidate@(Model.CloseoutDeliveryCandidateCount == 1 ? string.Empty : "s")</h3>
                        <p>@Model.CloseoutDeliveryReceiptCount first-party closeout receipt@(Model.CloseoutDeliveryReceiptCount == 1 ? string.Empty : "s") now track whether shipped ProductLift items can move toward Chummer-owned follow-up instead of stopping at the vendor state.</p>
                    </div>
                </article>
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <h3>@Model.CloseoutQueueReadyCount outbox candidate@(Model.CloseoutQueueReadyCount == 1 ? string.Empty : "s") ready</h3>
                        <p>@Model.CloseoutQueueReceiptCount bounded outbox queue receipt@(Model.CloseoutQueueReceiptCount == 1 ? string.Empty : "s") now show whether shipped ProductLift items can materialize a Hub-owned outbox candidate before any send or journey closeout is claimed.</p>
                    </div>
                </article>
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <h3>@Model.CloseoutDispatchSentCount sent closeout receipt@(Model.CloseoutDispatchSentCount == 1 ? string.Empty : "s")</h3>
                        <p>@Model.CloseoutDispatchReceiptCount bounded delivery receipt@(Model.CloseoutDispatchReceiptCount == 1 ? string.Empty : "s") now track whether a ready outbox candidate actually became a first-party queued or sent closeout instead of stopping at readiness.</p>
                    </div>
                </article>
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <h3>@Model.JourneyReceiptCount journey receipt@(Model.JourneyReceiptCount == 1 ? string.Empty : "s")</h3>
                        <p>Bounded @("voter_notified") evidence now lands only after the first-party closeout send path finishes instead of being implied by ProductLift vendor state.</p>
                    </div>
                </article>
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <h3>@Model.ReplayCandidateCount replay candidate@(Model.ReplayCandidateCount == 1 ? string.Empty : "s")</h3>
                        <p>@Model.ReconcileRunCount bounded replay run@(Model.ReconcileRunCount == 1 ? string.Empty : "s") now cover governor-proof backfill without broadening the stored audience beyond the original closeout receipt.</p>
                    </div>
                    <div class="route-choice-card__proof">
                        <span>@(Model.LastReconcileAtUtc is { } lastReconcileAtUtc ? lastReconcileAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'") : "No replay run yet")</span>
                    </div>
                </article>
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <h3>@Model.DeliveryRecoveryCandidateCount delivery recovery candidate@(Model.DeliveryRecoveryCandidateCount == 1 ? string.Empty : "s")</h3>
                        <p>@Model.DeliveryRecoveryRunCount bounded recovery run@(Model.DeliveryRecoveryRunCount == 1 ? string.Empty : "s") now reconcile accepted, failed, or expired retry-window dispatch receipts, while @Model.SuppressedDispatchCount suppressed dispatch hold@(Model.SuppressedDispatchCount == 1 ? string.Empty : "s") stay out of retry.</p>
                    </div>
                    <div class="route-choice-card__proof">
                        <span>@(Model.LastDeliveryRecoveryAtUtc is { } lastDeliveryRecoveryAtUtc ? lastDeliveryRecoveryAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'") : "No delivery recovery run yet")</span>
                    </div>
                </article>
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <h3>@Model.DeliveryOutcomeReceiptCount provider outcome callback@(Model.DeliveryOutcomeReceiptCount == 1 ? string.Empty : "s")</h3>
                        <p>@Model.AutomaticRetryPendingCount automatic provider retry hold@(Model.AutomaticRetryPendingCount == 1 ? string.Empty : "s") now keep retrying deliveries out of manual recovery until the provider retry window closes.</p>
                    </div>
                    <div class="route-choice-card__proof">
                        <span>@(Model.LastDeliveryOutcomeAtUtc is { } lastDeliveryOutcomeAtUtc ? lastDeliveryOutcomeAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'") : "No provider callback yet")</span>
                    </div>
                </article>
                <article class="compact-rail__item">
                    <div class="compact-rail__copy">
                        <h3>@Model.RetryExpiryCandidateCount expired retry window@(Model.RetryExpiryCandidateCount == 1 ? string.Empty : "s")</h3>
                        <p>@Model.RetryExpiryRunCount automatic retry sweep run@(Model.RetryExpiryRunCount == 1 ? string.Empty : "s") now let expired provider retry holds reenter bounded recovery without waiting for an operator-triggered recover call.</p>
                    </div>
                    <div class="route-choice-card__proof">
                        <span>@(Model.LastRetryExpiryAtUtc is { } lastRetryExpiryAtUtc ? lastRetryExpiryAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'") : "No automatic retry sweep yet")</span>
                    </div>
                </article>
            </div>
        </article>
        <article class="route-choice-card">
            <span class="tag">Category routing</span>
            <h3>@Model.CategoryCount categories route public demand without turning the board into support or private intake.</h3>
            <p>@Model.MisrouteLikelyCount category@(Model.MisrouteLikelyCount == 1 ? string.Empty : "ies") are likely to attract install, crash, or account misroutes. @Model.PrivacySensitiveCount category@(Model.PrivacySensitiveCount == 1 ? string.Empty : "ies") carry tighter privacy pressure.</p>
            @if (rules.Length > 0)
            {
                <div class="route-choice-card__proof">
                    @foreach (var rule in rules)
                    {
                        <span>@rule</span>
                    }
                </div>
            }
        </article>
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Operator lookup</p>
        <h2 class="editorial-title">Search bounded source receipts and recipient threads when the aggregate rail gets noisy.</h2>
        <p class="editorial-copy">This lookup stays on the first-party side of the boundary. It only searches stored receipt ids, recipient refs, address hashes, delivery ids, provider message ids, and item references.</p>
    </div>
    <div class="status-decision-strip">
        <article class="status-decision-strip__card">
            <span class="tag">Search bounded drilldowns</span>
            <h2>Jump to one source or one thread without scanning every card below.</h2>
            <form class="auth-form" method="get" action="/feedback/operations/lookup">
                <label class="field" for="feedbackOperationsQuickLookup">
                    <span>Lookup query</span>
                    <input id="feedbackOperationsQuickLookup" name="q" type="search" placeholder="plsend_..., plreceipt_..., usr-..., delivery-1, item-slug" />
                </label>
                <label class="field" for="feedbackOperationsQuickScope">
                    <span>Scope</span>
                    <select id="feedbackOperationsQuickScope" name="scope">
                        <option value="all">Sources and threads</option>
                        <option value="source">Source receipts only</option>
                        <option value="thread">Recipient threads only</option>
                    </select>
                </label>
                <div class="stacked-actions">
                    <button class="button-like button-like--secondary" type="submit">Open bounded lookup</button>
                    <a class="button-like button-like--ghost" href="/feedback/operations/lookup">Browse recent drilldowns</a>
                </div>
            </form>
        </article>
        <article class="status-decision-strip__card">
            <span class="tag">Stored identifiers</span>
            <h2>Search uses the bounded receipt spine, not raw provider payloads.</h2>
            <p>Supported lookup keys include source receipt ids, dispatch receipt ids, recipient refs, address hashes, delivery ids, provider message ids, and item references.</p>
        </article>
    </div>
</section>

@if (deliveryOutcomeIngresses.Length > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Provider-auth ingress</p>
            <h2 class="editorial-title">Emailit and EA callbacks now declare their own authenticity rails instead of hiding behind one generic operations secret.</h2>
            <p class="editorial-copy">This keeps ProductLift closeout delivery truth honest: provider callbacks should prove themselves on provider-specific ingress before they can influence first-party retry, suppression, or shipped-notification state.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var ingress in deliveryOutcomeIngresses)
            {
                <article class="route-choice-card">
                    <span class="tag">@ingress.StatusLabel</span>
                    <h3>@ingress.Label</h3>
                    <p>@ingress.Summary</p>
                    <div class="route-choice-card__proof">
                        <span>@ingress.SecretHeader</span>
                        @foreach (var route in ingress.Routes.Take(2))
                        {
                            <span>@route</span>
                        }
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (categories.Length > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Routing board</p>
            <h2 class="editorial-title">The first public categories and follow-up lanes are now sourced from canon instead of living only in fallback prose.</h2>
            <p class="editorial-copy">This keeps public signal classification visible before the hosted board is promoted and makes the misroute boundaries concrete for install, account, crash, and privacy-sensitive topics.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var category in categories)
            {
                <article class="route-choice-card">
                    <span class="tag">@category.OwnerRepo</span>
                    <h3>@category.Label</h3>
                    <p>@category.Summary</p>
                    <div class="route-choice-card__proof">
                        <span>@category.FollowUpLane</span>
                        @if (category.SupportMisrouteLikely)
                        {
                            <span>Support misroute likely</span>
                        }
                        @if (category.PrivacySensitive)
                        {
                            <span>Privacy sensitive</span>
                        }
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (recentReceipts.Length > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Provider receipts</p>
            <h2 class="editorial-title">Hosted ProductLift callbacks now land as bounded first-party receipts instead of vanishing into route-level copy.</h2>
            <p class="editorial-copy">These rows show only public-board metadata, closeout posture, timestamps, and durable receipt ids. Raw user prose and provider payload bodies stay out of the stored first-party loop.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var receipt in recentReceipts)
            {
                <article class="route-choice-card">
                    <span class="tag">@receipt.ActionLabel</span>
                    <h3>@receipt.BoardLabel · @receipt.StatusLabel</h3>
                    <p>@receipt.CategoryLabel · @receipt.ItemReference · @receipt.EventType</p>
                    <div class="route-choice-card__proof">
                        <span>@receipt.ReceiptId</span>
                        <span>@receipt.ReceivedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        <span>@receipt.HotFilterLabel · @receipt.HotFilterCount thread@(receipt.HotFilterCount == 1 ? string.Empty : "s")</span>
                        @if (receipt.CloseoutCandidate)
                        {
                            <span>Closeout candidate</span>
                        }
                        @if (receipt.VoterNotificationAllowed)
                        {
                            <span>Voter follow-up allowed</span>
                        }
                    </div>
                    <p class="muted-copy">@receipt.HotFilterSummary</p>
                    <div class="stacked-actions">
                        <a class="button-like button-like--secondary" href="@SourceDetailHref(receipt.ReceiptId, receipt.HotFilterKey)">
                            @(receipt.HotFilterCount > 0 && !string.Equals(receipt.HotFilterKey, "all", StringComparison.Ordinal)
                                ? $"Open {receipt.HotFilterLabel.ToLowerInvariant()}"
                                : "Open source detail")
                        </a>
                        <a class="button-like button-like--ghost" href="@AppendDetailFilter($"/api/v1/public/feedback/operations/source/{Uri.EscapeDataString(receipt.ReceiptId)}", receipt.HotFilterKey)">Open source artifact</a>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (recentRoutingReceipts.Length > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Routing receipts</p>
            <h2 class="editorial-title">Support and moderation handoffs now materialize as first-party routing receipts instead of depending on someone to remember the boundary copy.</h2>
            <p class="editorial-copy">This is where install, crash, account, and privacy-sensitive drift stops being a public-board problem and becomes a Chummer-owned return path.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var receipt in recentRoutingReceipts)
            {
                <article class="route-choice-card">
                    <span class="tag">@receipt.StatusLabel</span>
                    <h3>@receipt.RouteKind.Replace('_', ' ')</h3>
                    <p>@receipt.Summary</p>
                    <div class="route-choice-card__proof">
                        <span>@receipt.ReceiptId</span>
                        <span>@receipt.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        <span>@receipt.TargetPath</span>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (recentCloseoutReceipts.Length > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Closeout follow-up</p>
            <h2 class="editorial-title">Shipped ProductLift items now create bounded first-party closeout delivery receipts instead of relying on vendor state alone.</h2>
            <p class="editorial-copy">These receipts do not claim that mail already went out. They show whether Chummer has enough canon and adapter posture to move toward first-party voter follow-up once release proof is real.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var receipt in recentCloseoutReceipts)
            {
                <article class="route-choice-card">
                    <span class="tag">@receipt.StatusLabel</span>
                    <h3>@receipt.DeliveryLane</h3>
                    <p>@receipt.Summary</p>
                    <p class="muted-copy">@receipt.DeliveryReason</p>
                    <div class="route-choice-card__proof">
                        <span>@receipt.ReceiptId</span>
                        <span>@receipt.DeliveryState</span>
                        <span>@receipt.TemplateId</span>
                        <span>@receipt.RecipientScopeRef</span>
                        <span>@receipt.ConsentSourceRef</span>
                        <span>@receipt.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        @if (receipt.RecipientScopeCount > 0)
                        {
                            <span>@receipt.RecipientScopeCount projected recipient@(receipt.RecipientScopeCount == 1 ? string.Empty : "s")</span>
                        }
                        else
                        {
                            <span>Recipient projection pending</span>
                        }
                        @if (receipt.VoterNotificationAllowed)
                        {
                            <span>Voter follow-up allowed</span>
                        }
                        else
                        {
                            <span>Voter follow-up blocked</span>
                        }
                        @if (!receipt.PublicClaimAllowed)
                        {
                            <span>No public delivery claim</span>
                        }
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (recentDeliveryOutcomes.Length > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Provider outcome callbacks</p>
            <h2 class="editorial-title">Provider-originated delivery truth now lands as bounded callback receipts instead of depending only on operator-triggered recovery.</h2>
            <p class="editorial-copy">These rows keep vendor payload bodies out of first-party storage while still preserving the callback state, retry window, matched dispatch receipt, and bounded recipient proof needed for recovery discipline.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var receipt in recentDeliveryOutcomes)
            {
                <article class="route-choice-card">
                    <span class="tag">@receipt.StatusLabel</span>
                    <h3>@receipt.Provider · @receipt.ProviderState</h3>
                    <p>@receipt.Summary</p>
                    @if (!string.IsNullOrWhiteSpace(receipt.Reason))
                    {
                        <p class="muted-copy">@receipt.Reason</p>
                    }
                    <div class="route-choice-card__proof">
                        <span>@receipt.ReceiptId</span>
                        <span>@receipt.DispatchReceiptId</span>
                        <span>@receipt.DeliveryId</span>
                        <span>@receipt.RecipientRef</span>
                        <span>@receipt.AddressHash</span>
                        <span>@receipt.IdentityMatchMode</span>
                        <span>@receipt.SuppressionCheck</span>
                        <span>@receipt.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        <span>@receipt.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        @if (receipt.RetryAtUtc is { } retryAtUtc)
                        {
                            <span>@retryAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(receipt.ProviderMessageId))
                        {
                            <span>@receipt.ProviderMessageId</span>
                        }
                        @if (!receipt.PublicClaimAllowed)
                        {
                            <span>No public outcome claim</span>
                        }
                    </div>
                    <a class="editorial-strip__action" href="@ThreadDetailHref(receipt.DispatchReceiptId, ResolveOutcomeContextFilterKey(receipt))">Open thread detail</a>
                </article>
            }
        </div>
    </section>
}

@if (recentRecipientThreads.Length > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Recipient closeout threads</p>
            <h2 class="editorial-title">Each bounded closeout recipient now has one joined first-party thread instead of forcing manual cross-reading across queue, dispatch, callback, and journey rails.</h2>
            <p class="editorial-copy">Dispatch receipts remain the spine. Chummer now projects the matching queue state, latest provider callback, and journey writeback evidence for the same recipient ref into one compact operations thread.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var thread in recentRecipientThreads)
            {
                <article class="route-choice-card">
                    <span class="tag">@thread.CurrentStageLabel</span>
                    <h3>@thread.RecipientRef</h3>
                    <p>@thread.Summary</p>
                    <div class="route-choice-card__proof">
                        <span>@thread.SourceLabel</span>
                        <span>@thread.AddressHash</span>
                        <span>@thread.QueueStatusLabel</span>
                        <span>@thread.DispatchStatusLabel</span>
                        @if (!string.IsNullOrWhiteSpace(thread.OutcomeStatusLabel))
                        {
                            <span>@thread.OutcomeStatusLabel</span>
                        }
                        else
                        {
                            <span>Provider callback pending</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(thread.JourneyStatusLabel))
                        {
                            <span>@thread.JourneyStatusLabel</span>
                        }
                        else
                        {
                            <span>Journey proof pending</span>
                        }
                        <span>@thread.SourceReceiptId</span>
                        <span>@thread.QueueReceiptId</span>
                        <span>@thread.DispatchReceiptId</span>
                        <span>@thread.DispatchRequestedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        @if (thread.OutcomeRecordedAtUtc is { } outcomeRecordedAtUtc)
                        {
                            <span>@outcomeRecordedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(thread.OutcomeProvider))
                        {
                            <span>@thread.OutcomeProvider</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(thread.OutcomeProviderState))
                        {
                            <span>@thread.OutcomeProviderState</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(thread.OutcomeIdentityMatchMode))
                        {
                            <span>@thread.OutcomeIdentityMatchMode</span>
                        }
                        @if (thread.JourneyRecordedAtUtc is { } journeyRecordedAtUtc)
                        {
                            <span>@journeyRecordedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(thread.JourneyEventKey))
                        {
                            <span>@thread.JourneyEventKey</span>
                        }
                        <span>@thread.LastTouchedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                        @if (!thread.PublicClaimAllowed)
                        {
                            <span>No public thread claim</span>
                        }
                    </div>
                    <a class="editorial-strip__action" href="@ThreadDetailHref(thread.DispatchReceiptId, ResolveThreadContextFilterKey(thread))">Open thread detail</a>
                </article>
            }
        </div>
    </section>
}

@if (recentRetryExpiryRuns.Length > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Automatic retry expiry</p>
            <h2 class="editorial-title">Expired provider retry windows now reenter bounded recovery on a timer-driven lane instead of sitting until an operator notices them.</h2>
            <p class="editorial-copy">These runs stay narrow. They only touch dispatch receipts whose provider retry window has already expired, reuse stored recipient scope, and keep suppressed deliveries out of the automatic sweep.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var run in recentRetryExpiryRuns)
            {
                <article class="route-choice-card">
                    <span class="tag">@run.Status</span>
                    <h3>@run.DispatchReceiptsCreated recovered retry hold@(run.DispatchReceiptsCreated == 1 ? string.Empty : "s")</h3>
                    <p>@run.Summary</p>
                    <div class="route-choice-card__proof">
                        <span>@run.RunReceiptId</span>
                        <span>@run.CandidateReceiptCount candidate receipt@(run.CandidateReceiptCount == 1 ? string.Empty : "s")</span>
                        <span>@run.ReadyCandidateCount recovered</span>
                        <span>@run.ReplayCandidateCount suppressed hold@(run.ReplayCandidateCount == 1 ? string.Empty : "s")</span>
                        <span>@run.JourneyReceiptsRecorded blocked</span>
                        <span>@run.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (recentReconcileRuns.Length > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Replay and backfill</p>
            <h2 class="editorial-title">Ready ProductLift closeout receipts can now be replayed through a bounded first-party reconcile lane when governor or proof gates arrive late.</h2>
            <p class="editorial-copy">Replay stays narrow: it reuses the audience captured on the original closeout receipt, records a bounded run receipt, and does not broaden notification scope from later public-board state.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var run in recentReconcileRuns)
            {
                <article class="route-choice-card">
                    <span class="tag">@run.Status</span>
                    <h3>@run.ReplayCandidateCount replay candidate@(run.ReplayCandidateCount == 1 ? string.Empty : "s")</h3>
                    <p>@run.Summary</p>
                    <div class="route-choice-card__proof">
                        <span>@run.RunReceiptId</span>
                        <span>@run.CandidateReceiptCount candidate receipt@(run.CandidateReceiptCount == 1 ? string.Empty : "s")</span>
                        <span>@run.ReadyCandidateCount ready</span>
                        <span>@run.DispatchReceiptsCreated dispatch receipt@(run.DispatchReceiptsCreated == 1 ? string.Empty : "s")</span>
                        <span>@run.JourneyReceiptsRecorded journey receipt@(run.JourneyReceiptsRecorded == 1 ? string.Empty : "s")</span>
                        <span>@run.RecordedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</span>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (recentRecoveryRuns.Length > 0)
{
    <section class="editorial-block">
        <div class="editorial-block__lead">
            <p class="eyebrow">Delivery recovery</p>
            <h2 class="editorial-title">Accepted or retryable closeout dispatch receipts can now be recovered without treating suppression or provider state as public truth.</h2>
            <p class="editorial-copy">This lane is narrower than replay. It reconciles existing bounded dispatch receipts, reuses the stored recipient scope when needed, and leaves suppressed deliveries out of automatic retry.</p>
        </div>
        <div class="route-choice-grid">
            @foreach (var run in recentRecoveryRuns)

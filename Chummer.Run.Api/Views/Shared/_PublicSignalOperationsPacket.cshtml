@model PublicSignalOperationsPacketViewModel
@{
    bool followThroughReady = Model.CloseoutDispatchSentCount > 0 && !string.IsNullOrWhiteSpace(Model.ReleaseProofReceiptId);
    bool publicSignalLive = Model.ReceiptCount > 0 || Model.CategoryCount > 0;
    string followThroughHeading = followThroughReady
        ? "Chummer follow-up examples are visible now."
        : "First-party follow-up is not posted here yet.";
    string followThroughSummary = followThroughReady
        ? $"{Model.CloseoutDispatchSentCount} follow-up update(s) have already landed, and shipped updates stay tied to /changelog."
        : Model.CloseoutQueueReadyCount > 0
            ? $"{Model.CloseoutQueueReadyCount} follow-up candidate(s) are ready, but nothing is posted as sent until the shipped update path is ready."
            : "Public feedback can still show demand, but account-backed follow-up waits until the shipped path is available on this host.";
    string readinessTag = followThroughReady ? "Posted follow-up examples" : "Pending follow-up";
}

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Public loop status</p>
        <h2 class="editorial-title">Keep signal, planning, shipped updates, and private help on separate pages.</h2>
        <p class="editorial-copy">This page shows public demand clearly, leaves private follow-up to Help, and waits for Changelog before it treats anything as shipped.</p>
    </div>
    <div class="route-choice-grid">
        <article class="route-choice-card">
            <span class="tag">Public board</span>
            <h3>@(publicSignalLive ? "Public signal is live on Chummer pages." : "Public signal is still warming up on this host.")</h3>
            <p>@Model.CategoryCount category@(Model.CategoryCount == 1 ? string.Empty : "ies") keep ideas, safe public bugs, and likely private issues separated before they blur into support or roadmap copy.</p>
            <div class="route-choice-card__details">
                <span>@Model.CategoryCount public category@(Model.CategoryCount == 1 ? string.Empty : "ies")</span>
                <span>@Model.MisrouteLikelyCount likely private support handoff@(Model.MisrouteLikelyCount == 1 ? string.Empty : "s")</span>
                <span>@Model.PrivacySensitiveCount private support item@(Model.PrivacySensitiveCount == 1 ? string.Empty : "s")</span>
            </div>
            <a class="editorial-strip__action" href="/roadmap">Open roadmap</a>
        </article>
        <article class="route-choice-card">
            <span class="tag">Follow-up</span>
            <h3>@followThroughHeading</h3>
            <p>@followThroughSummary</p>
            <div class="route-choice-card__details">
                <span>@Model.CloseoutDispatchSentCount posted follow-up update@(Model.CloseoutDispatchSentCount == 1 ? string.Empty : "s")</span>
                <span>@Model.CloseoutQueueReadyCount ready follow-up candidate@(Model.CloseoutQueueReadyCount == 1 ? string.Empty : "s")</span>
                <span>@Model.JourneyReceiptCount follow-up signals</span>
            </div>
            <a class="editorial-strip__action" href="/changelog">Open changelog</a>
        </article>
        <article class="route-choice-card">
            <span class="tag">Private help</span>
            <h3>Private help still leaves this page immediately.</h3>
            <p>Crashes, installs, logs, account repair, and private campaign detail should move to Help or Contact before they become public board noise.</p>
            <div class="route-choice-card__details">
                <span>Help for private follow-up</span>
                <span>Roadmap for planned movement</span>
                <span>Changelog for shipped updates</span>
            </div>
            <a class="editorial-strip__action" href="/contact#support-intake">Open private support</a>
        </article>
    </div>
</section>

<section class="editorial-block">
    <div class="editorial-block__lead">
        <p class="eyebrow">Feedback sorting</p>
        <h2 class="editorial-title">Public feedback stays easy to sort.</h2>
        <p class="editorial-copy">Ideas, safe bugs, private help, and shipped updates each have a clear place.</p>
    </div>
    <p class="muted-copy">Public feedback stays visible; private follow-up goes through Help.</p>
</section>

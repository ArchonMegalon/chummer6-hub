@using Chummer.Run.Api.ViewModels
@{
    var chrome = ViewData["Chrome"] as SiteChromeViewModel ?? throw new InvalidOperationException("Site chrome was not provided to the layout.");
    var pageTitle = ViewData["Title"] as string ?? chrome.Title;
    var routeKey = string.IsNullOrWhiteSpace(chrome.CurrentPath) || string.Equals(chrome.CurrentPath, "/", StringComparison.Ordinal)
        ? "landing"
        : chrome.CurrentPath.Trim('/').Replace("/", "-", StringComparison.Ordinal).Replace("?", "-", StringComparison.Ordinal).Replace("&", "-", StringComparison.Ordinal).Replace("=", "-", StringComparison.Ordinal).Replace(".", "-", StringComparison.Ordinal);
    var surfaceClass = ViewData["SurfaceClass"] as string ?? string.Empty;
    var authSurface = string.Equals(surfaceClass, "surface-auth", StringComparison.Ordinal);
    var headerClass = routeKey is "landing" or "login" or "signup" ? "site-header site-header--immersive" : "site-header";
    var bodyClass = $"shell-body {(chrome.Authenticated ? "shell-authenticated" : "shell-public")} route-{routeKey} {surfaceClass}".Trim();
    var supportLinks = chrome.SecondaryNavigation.Where(link =>
        link.Href is "/help" or "/faq" or "/privacy" or "/terms" or "/contact").ToArray();
    var productLinks = chrome.SecondaryNavigation.Except(supportLinks).ToArray();
    var publicSignalLinks = chrome.PublicSignalNavigation?.ToArray() ?? Array.Empty<PublicNavigationLink>();
    Func<string?, string> normalizeHeaderActionPath = href =>
    {
        if (string.IsNullOrWhiteSpace(href))
        {
            return string.Empty;
        }

        var candidate = href!;
        int queryIndex = candidate.IndexOf('?');
        if (queryIndex >= 0)
        {
            candidate = candidate[..queryIndex];
        }

        if (Uri.TryCreate(candidate, UriKind.Absolute, out Uri? uri))
        {
            candidate = uri.AbsolutePath;
        }

        return candidate.Trim().TrimEnd('/');
    };
    var normalizedCurrentPath = normalizeHeaderActionPath(chrome.CurrentPath);
    Func<string?, bool> isContextualRouteCurrent = href =>
    {
        var candidate = normalizeHeaderActionPath(href);
        return candidate switch
        {
            "/what-is-chummer" => string.Equals(normalizedCurrentPath, "/what-is-chummer", StringComparison.OrdinalIgnoreCase),
            "/downloads" => normalizedCurrentPath is "/downloads" || normalizedCurrentPath.StartsWith("/downloads/", StringComparison.OrdinalIgnoreCase),
            "/now" => string.Equals(normalizedCurrentPath, "/now", StringComparison.OrdinalIgnoreCase),
            "/horizons" => normalizedCurrentPath is "/horizons" or "/roadmap" || normalizedCurrentPath.StartsWith("/roadmap/", StringComparison.OrdinalIgnoreCase),
            "/artifacts" => normalizedCurrentPath is "/artifacts" || normalizedCurrentPath.StartsWith("/artifacts/", StringComparison.OrdinalIgnoreCase),
            "/participate" => normalizedCurrentPath is "/participate" || normalizedCurrentPath.StartsWith("/participate/", StringComparison.OrdinalIgnoreCase),
            "/status" => string.Equals(normalizedCurrentPath, "/status", StringComparison.OrdinalIgnoreCase),
            "/help" => string.Equals(normalizedCurrentPath, "/help", StringComparison.OrdinalIgnoreCase),
            "/faq" => string.Equals(normalizedCurrentPath, "/faq", StringComparison.OrdinalIgnoreCase),
            "/privacy" => string.Equals(normalizedCurrentPath, "/privacy", StringComparison.OrdinalIgnoreCase),
            "/terms" => string.Equals(normalizedCurrentPath, "/terms", StringComparison.OrdinalIgnoreCase),
            "/contact" => normalizedCurrentPath is "/contact" || normalizedCurrentPath.StartsWith("/contact/", StringComparison.OrdinalIgnoreCase),
            _ => string.Equals(normalizedCurrentPath, candidate, StringComparison.OrdinalIgnoreCase)
        };
    };
    Func<string?, bool> isPublicSignalCurrent = href =>
    {
        var candidate = normalizeHeaderActionPath(href);
        return candidate switch
        {
            "/feedback" => normalizedCurrentPath is "/feedback",
            "/roadmap" => normalizedCurrentPath is "/roadmap" or "/horizons" || normalizedCurrentPath.StartsWith("/roadmap/", StringComparison.OrdinalIgnoreCase),
            "/changelog" => normalizedCurrentPath is "/changelog",
            _ => isContextualRouteCurrent(candidate)
        };
    };

    Func<string?, bool> isBuildAction = href =>
    {
        return string.Equals(normalizeHeaderActionPath(href), "/downloads/release-upload", StringComparison.OrdinalIgnoreCase);
    };

    var buildAction = chrome.HeaderActions.FirstOrDefault(action => isBuildAction(action.Href));
    var nonBuildHeaderActions = chrome.HeaderActions.Where(action => !isBuildAction(action.Href)).ToArray();
    var isBuildCurrent = string.Equals(chrome.CurrentPath, "/downloads/release-upload", StringComparison.OrdinalIgnoreCase)
        || chrome.CurrentPath.StartsWith("/downloads/release-upload/", StringComparison.OrdinalIgnoreCase);
    var compactFooter = routeKey is "landing" or "what-is-chummer" or "now" or "horizons" or "roadmap" or "artifacts" or "downloads" or "participate" or "feedback" or "changelog" or "help" or "faq" or "privacy" or "terms" or "contact"
        || routeKey.StartsWith("artifacts-", StringComparison.Ordinal)
        || routeKey.StartsWith("roadmap-", StringComparison.Ordinal);
    var compactProductLinks = productLinks
        .Where(link => link.Href is "/what-is-chummer" or "/now" or "/downloads" or "/artifacts")
        .ToArray();
    var footerProductLinks = compactFooter && compactProductLinks.Length > 0
        ? compactProductLinks
        : productLinks;
    var supplementalSignalLinks = publicSignalLinks
        .Where(link => !string.Equals(link.Href, "/roadmap", StringComparison.OrdinalIgnoreCase))
        .ToArray();
    var compactDrawerLinks = chrome.PrimaryNavigation
        .Concat(supplementalSignalLinks)
        .Concat(supportLinks.Where(link => link.Href is "/help" or "/contact"))
        .GroupBy(link => link.Href, StringComparer.OrdinalIgnoreCase)
        .Select(group => group.First())
        .ToArray();
    var footerLinks = (compactFooter ? footerProductLinks : footerProductLinks.Concat(supplementalSignalLinks))
        .Concat(supportLinks.Where(link => link.Href is "/help" or "/contact"))
        .GroupBy(link => link.Href, StringComparer.OrdinalIgnoreCase)
        .Select(group => group.First())
        .ToArray();
    var utilityLink = chrome.UtilityNavigation.FirstOrDefault();
}
<!doctype html>
<html lang="en" data-theme="hub-front-door">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle · Chummer</title>
    <meta name="description" content="@chrome.Description" />
    <meta name="theme-color" content="#07131c" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <link rel="manifest" href="~/manifest.json" asp-append-version="true" />
    <link rel="icon" href="~/pwa-icon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@bodyClass">
    <a class="skip-link" href="#main">Skip to content</a>
    @if (authSurface)
    {
        <header class="@headerClass" data-site-header>
            <div class="site-header__inner site-header__inner--auth">
                <a class="site-brand" href="/" aria-label="Chummer home">
                    <span class="site-brand__wordmark">CHUMMER</span>
                    <span class="site-brand__surface">Shadowrun character and campaign companion</span>
                </a>
                <div class="site-actions site-actions--quiet">
                    <a class="site-actions__link" href="/help">Help</a>
                    <a class="site-actions__link" href="/faq">FAQ</a>
                    <a class="site-actions__link" href="/contact">Contact</a>
                    @if (buildAction is not null)
                    {
                        if (isBuildCurrent)
                        {
                            <span class="site-actions__label">Build</span>
                        }
                        else
                        {
                            <a class="site-actions__link" href="@buildAction.Href">@buildAction.Label</a>
                        }
                    }
                </div>
            </div>
        </header>
    }
    else
    {
        <header class="@headerClass" data-site-header>
            <div class="site-header__inner">
                <a class="site-brand" href="/" aria-label="Chummer home">
                    <span class="site-brand__wordmark">CHUMMER</span>
                    <span class="site-brand__surface">Shadowrun character and campaign companion</span>
                </a>
                <nav class="site-nav" aria-label="Primary navigation">
                    @foreach (var link in chrome.PrimaryNavigation)
                    {
                        var current = isContextualRouteCurrent(link.Href);
                        if (current)
                        {
                            <span class="site-nav__current">@link.Label</span>
                        }
                        else
                        {
                            <a href="@link.Href">@link.Label</a>
                        }
                    }
                </nav>
                <button
                    class="site-nav__toggle button-like button-like--ghost"
                    type="button"
                    data-nav-toggle
                    aria-expanded="false"
                    aria-controls="site-nav-sheet">
                    Menu
                </button>
                <div class="site-actions">
                    @if (chrome.Authenticated && !string.IsNullOrWhiteSpace(chrome.SignedInLabel))
                    {
                        <span class="site-actions__label">@chrome.SignedInLabel</span>
                    }
                    @foreach (var action in nonBuildHeaderActions)
                    {
                        if (string.Equals(action.Href, "/logout", StringComparison.OrdinalIgnoreCase))
                        {
                            <form method="post" action="/logout" class="action-form">
                                @Html.AntiForgeryToken()
                                <button class="action-pill action-pill--@action.Tone" type="submit">@action.Label</button>
                            </form>
                        }
                        else if (action.Current)
                        {
                            <span class="action-pill action-pill--current">@action.Label</span>
                        }
                        else
                        {
                            var actionClass = string.Equals(action.Tone, "link", StringComparison.OrdinalIgnoreCase)
                                ? "site-actions__link"
                                : $"action-pill action-pill--{action.Tone}";
                            <a class="@actionClass" href="@action.Href">@action.Label</a>
                        }
                    }
                    @if (buildAction is not null)
                    {
                        if (buildAction.Current)
                        {
                            <span class="action-pill action-pill--current">@buildAction.Label</span>
                        }
                        else
                        {
                            <a class="action-pill action-pill--secondary" href="@buildAction.Href">@buildAction.Label</a>
                        }
                    }
                </div>
            </div>
            <div class="site-nav-sheet" id="site-nav-sheet" data-nav-sheet hidden inert aria-hidden="true">
                <div class="site-nav-sheet__panel">
                    <div class="site-nav-sheet__section">
                        <nav aria-label="Compact navigation">
                            @foreach (var link in compactDrawerLinks)
                            {
                                var current = publicSignalLinks.Contains(link)
                                    ? isPublicSignalCurrent(link.Href)
                                    : isContextualRouteCurrent(link.Href);
                                if (current)
                                {
                                    <span class="site-nav__current">@link.Label</span>
                                }
                                else
                                {
                                    <a href="@link.Href">@link.Label</a>
                                }
                            }
                        </nav>
                        @if (chrome.Authenticated || nonBuildHeaderActions.Length > 0 || buildAction is not null)
                        {
                            <div class="site-nav-sheet__actions" role="group" aria-label="Account and quick actions">
                                @foreach (var action in nonBuildHeaderActions)
                                {
                                    if (string.Equals(action.Href, "/logout", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <form method="post" action="/logout" class="action-form">
                                            @Html.AntiForgeryToken()
                                            <button class="action-pill action-pill--@action.Tone" type="submit">@action.Label</button>
                                        </form>
                                    }
                                    else if (action.Current)
                                    {
                                        <span class="action-pill action-pill--current">@action.Label</span>
                                    }
                                    else
                                    {
                                        var actionClass = string.Equals(action.Tone, "link", StringComparison.OrdinalIgnoreCase)
                                            ? "site-actions__link"
                                            : $"action-pill action-pill--{action.Tone}";
                                        <a class="@actionClass" href="@action.Href">@action.Label</a>
                                    }
                                }
                                @if (buildAction is not null)
                                {
                                    if (buildAction.Current)
                                    {
                                        <span class="action-pill action-pill--current">@buildAction.Label</span>
                                    }
                                    else
                                    {
                                        <a class="action-pill action-pill--secondary" href="@buildAction.Href">@buildAction.Label</a>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </header>
    }

    <main id="main" class="site-main">
        @RenderBody()
    </main>

    @if (!authSurface)
    {
        <footer class="site-footer @(compactFooter ? "site-footer--compact" : string.Empty)">
            <div class="site-footer__inner">
                <div class="site-footer__brand">
                    <a class="site-footer__wordmark" href="/">CHUMMER</a>
                    <p class="site-footer__copy">Shadowrun character and campaign companion with clear install, help, and proof pages.</p>
                </div>
                <nav class="site-footer__nav" aria-label="Footer navigation">
                    <div class="site-footer__link-group">
                        <p class="site-footer__heading">Explore</p>
                        <div class="site-footer__links">
                            @foreach (var link in footerLinks)
                            {
                                var current = publicSignalLinks.Contains(link)
                                    ? isPublicSignalCurrent(link.Href)
                                    : isContextualRouteCurrent(link.Href);
                                if (current)
                                {
                                    <span class="site-footer__current">@link.Label</span>
                                }
                                else
                                {
                                    <a href="@link.Href">@link.Label</a>
                                }
                            }
                        </div>
                    </div>
                </nav>
                <div class="site-footer__meta">
                    @if (chrome.Authenticated && !string.IsNullOrWhiteSpace(chrome.SignedInLabel))
                    {
                        <p>Signed in as @chrome.SignedInLabel.</p>
                    }
                    else
                    {
                        <p>Preview product. Honest install and support guidance.</p>
                    }
                    <p class="site-footer__provenance">Use <a class="quiet-link" href="/now">what works today</a> for customer-facing proof and <a class="quiet-link" href="/status">status</a> for current cautions.</p>
                    @if (utilityLink is not null)
                    {
                        <p><a class="quiet-link" href="@utilityLink.Href">@utilityLink.Label</a> is the external source fallback.</p>
                    }
                </div>
            </div>
        </footer>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            if (!("serviceWorker" in navigator)) {
                return;
            }

            window.addEventListener("load", function () {
                navigator.serviceWorker.register("/service-worker.js", { scope: "/" }).catch(function () {
                });
            });
        })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>

@using Chummer.Run.Api.ViewModels
@{
    var chrome = ViewData["Chrome"] as SiteChromeViewModel ?? throw new InvalidOperationException("Site chrome was not provided to the layout.");
    var pageTitle = ViewData["Title"] as string ?? chrome.Title;
    var routeKey = string.IsNullOrWhiteSpace(chrome.CurrentPath) || string.Equals(chrome.CurrentPath, "/", StringComparison.Ordinal)
        ? "landing"
        : chrome.CurrentPath.Trim('/').Replace("/", "-", StringComparison.Ordinal).Replace("?", "-", StringComparison.Ordinal).Replace("&", "-", StringComparison.Ordinal).Replace("=", "-", StringComparison.Ordinal).Replace(".", "-", StringComparison.Ordinal);
    var surfaceClass = ViewData["SurfaceClass"] as string ?? string.Empty;
    var surfaceTokens = surfaceClass.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var minimalSurface = surfaceTokens.Contains("surface-minimal", StringComparer.Ordinal);
    var authSurface = surfaceTokens.Contains("surface-auth", StringComparer.Ordinal);
    var hideAuthChrome = (ViewData["HideAuthChrome"] as bool?) == true;
    var headerClass = !minimalSurface && (routeKey is "landing" or "login" or "signup") ? "site-header site-header--immersive" : "site-header";
    var supportLinks = chrome.SecondaryNavigation.Where(link =>
        link.Href is "/help" or "/faq" or "/privacy" or "/terms" or "/contact").ToArray();
    var productLinks = chrome.SecondaryNavigation.Except(supportLinks).ToArray();
    var publicSignalLinks = chrome.PublicSignalNavigation?.ToArray() ?? Array.Empty<PublicNavigationLink>();
    Func<string?, string> normalizeHeaderActionPath = href =>
    {
        if (string.IsNullOrWhiteSpace(href))
        {
            return string.Empty;
        }

        var candidate = href!;
        int queryIndex = candidate.IndexOf('?');
        if (queryIndex >= 0)
        {
            candidate = candidate[..queryIndex];
        }

        if (Uri.TryCreate(candidate, UriKind.Absolute, out Uri? uri))
        {
            candidate = uri.AbsolutePath;
        }

        return candidate.Trim().TrimEnd('/');
    };
    Func<string?, bool> isExternalNavigationHref = href =>
        Uri.TryCreate(href, UriKind.Absolute, out Uri? uri)
        && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp);
    var normalizedCurrentPath = normalizeHeaderActionPath(chrome.CurrentPath);
    Func<string?, bool> isContextualRouteCurrent = href =>
    {
        if (isExternalNavigationHref(href))
        {
            return false;
        }

        var candidate = normalizeHeaderActionPath(href);
        return candidate switch
        {
            "" => string.IsNullOrEmpty(normalizedCurrentPath),
            "/what-is-chummer" => string.Equals(normalizedCurrentPath, "/what-is-chummer", StringComparison.OrdinalIgnoreCase),
            "/downloads" => normalizedCurrentPath is "/downloads" || normalizedCurrentPath.StartsWith("/downloads/", StringComparison.OrdinalIgnoreCase),
            "/now" => string.Equals(normalizedCurrentPath, "/now", StringComparison.OrdinalIgnoreCase),
            "/horizons" => normalizedCurrentPath is "/horizons" or "/roadmap" || normalizedCurrentPath.StartsWith("/roadmap/", StringComparison.OrdinalIgnoreCase),
            "/artifacts" => normalizedCurrentPath is "/artifacts" || normalizedCurrentPath.StartsWith("/artifacts/", StringComparison.OrdinalIgnoreCase),
            "/participate" => normalizedCurrentPath is "/participate" or "/partizipate"
                || normalizedCurrentPath.StartsWith("/participate/", StringComparison.OrdinalIgnoreCase)
                || normalizedCurrentPath.StartsWith("/partizipate/", StringComparison.OrdinalIgnoreCase),
            "/status" => string.Equals(normalizedCurrentPath, "/status", StringComparison.OrdinalIgnoreCase),
            "/help" => string.Equals(normalizedCurrentPath, "/help", StringComparison.OrdinalIgnoreCase),
            "/faq" => string.Equals(normalizedCurrentPath, "/faq", StringComparison.OrdinalIgnoreCase),
            "/privacy" => string.Equals(normalizedCurrentPath, "/privacy", StringComparison.OrdinalIgnoreCase),
            "/terms" => string.Equals(normalizedCurrentPath, "/terms", StringComparison.OrdinalIgnoreCase),
            "/contact" => normalizedCurrentPath is "/contact" || normalizedCurrentPath.StartsWith("/contact/", StringComparison.OrdinalIgnoreCase),
            _ => string.Equals(normalizedCurrentPath, candidate, StringComparison.OrdinalIgnoreCase)
        };
    };
    Func<string?, bool> isPublicSignalCurrent = href =>
    {
        var candidate = normalizeHeaderActionPath(href);
        return candidate switch
        {
            "/feedback" => normalizedCurrentPath is "/feedback",
            "/roadmap" => normalizedCurrentPath is "/roadmap" or "/horizons" || normalizedCurrentPath.StartsWith("/roadmap/", StringComparison.OrdinalIgnoreCase),
            "/changelog" => normalizedCurrentPath is "/changelog",
            _ => isContextualRouteCurrent(candidate)
        };
    };

    Func<string?, bool> isBuildAction = href =>
    {
        return normalizeHeaderActionPath(href).StartsWith("/downloads/release-upload", StringComparison.OrdinalIgnoreCase);
    };

    var buildAction = chrome.HeaderActions.FirstOrDefault(action => isBuildAction(action.Href));
    var suppressHeaderActionsForPublicParticipate = false;
    var nonBuildHeaderActions = chrome.HeaderActions.Where(action => !isBuildAction(action.Href)).ToArray();
    var visibleHeaderActions = nonBuildHeaderActions
        .Where(action => !suppressHeaderActionsForPublicParticipate)
        .Where(action => !(minimalSurface && normalizeHeaderActionPath(action.Href).StartsWith("/downloads", StringComparison.OrdinalIgnoreCase)))
        .Where(action => routeKey is not "landing" || !normalizeHeaderActionPath(action.Href).StartsWith("/downloads", StringComparison.OrdinalIgnoreCase))
        .ToArray();
    var accountMenuBuildAction = chrome.Authenticated ? buildAction : null;
    var accountMenuActions = chrome.Authenticated
        ? chrome.HeaderActions.Where(action => !isBuildAction(action.Href)).ToArray()
        : visibleHeaderActions
            .Concat(buildAction is null ? Array.Empty<SiteChromeActionViewModel>() : new[] { buildAction })
            .ToArray();
    var showPrimaryNavInHeader = !minimalSurface && routeKey is not "landing";
    const string launcherDesktopLabel = "Desktop";
    const string launcherWebLabel = "Web";
    var bodyClass = $"shell-body {(chrome.Authenticated ? "shell-authenticated" : "shell-public")} route-{routeKey} {surfaceClass}".Trim();
    var compactFooter = routeKey is "landing" or "what-is-chummer" or "now" or "horizons" or "roadmap" or "artifacts" or "downloads" or "participate" or "feedback" or "changelog" or "help" or "faq" or "privacy" or "terms" or "contact"
        || routeKey.StartsWith("artifacts-", StringComparison.Ordinal)
        || routeKey.StartsWith("roadmap-", StringComparison.Ordinal);
    var compactProductLinks = productLinks
        .Where(link => minimalSurface ? link.Href is "/" or "/downloads" : link.Href is "/" or "/downloads" or "/now")
        .ToArray();
    var footerProductLinks = compactFooter && compactProductLinks.Length > 0
        ? compactProductLinks
        : productLinks;
    var supplementalSignalLinks = publicSignalLinks
        .Where(link => !string.Equals(link.Href, "/roadmap", StringComparison.OrdinalIgnoreCase))
        .ToArray();
    var primarySiteLinks = chrome.PrimaryNavigation
        .Where(link => !minimalSurface || !string.Equals(link.Href, "/downloads", StringComparison.OrdinalIgnoreCase))
        .ToArray();
    var footerLinks = (compactFooter ? footerProductLinks : footerProductLinks.Concat(supplementalSignalLinks))
        .Concat(supportLinks.Where(link => link.Href is "/help" or "/contact"))
        .GroupBy(link => link.Href, StringComparer.OrdinalIgnoreCase)
        .Select(group => group.First())
        .ToArray();
    if (minimalSurface)
    {
        footerLinks = footerLinks
            .Where(link => link.Href is "/help" or "/contact")
            .ToArray();
        if (routeKey is "landing" && !footerLinks.Any(link => string.Equals(link.Href, "/status", StringComparison.OrdinalIgnoreCase)))
        {
            footerLinks = footerLinks
                .Concat(new[] { new PublicNavigationLink("Status", "/status") })
                .ToArray();
        }
    }
    var utilityLink = chrome.UtilityNavigation.FirstOrDefault();
    var contextSidebarHeading = ViewData["ContextSidebarHeading"] as string;
    var contextSidebarSummary = ViewData["ContextSidebarSummary"] as string;
    var contextSidebarLinks = ViewData["ContextSidebarLinks"] as IReadOnlyList<PublicNavigationLink> ?? Array.Empty<PublicNavigationLink>();
    var requestHost = Context?.Request?.Host.Host?.Trim().TrimEnd('.').ToLowerInvariant() ?? string.Empty;
    var clickRankSiteId = requestHost is "chummer.run" or "www.chummer.run"
        ? (System.Environment.GetEnvironmentVariable("CLICKRANK_AI_CHUMMER_RUN_SITE_ID") ?? string.Empty).Trim()
        : string.Empty;
    var configuredRybbitScriptUrl = (System.Environment.GetEnvironmentVariable("RYBBIT_CHUMMER_RUN_SCRIPT_URL") ?? string.Empty).Trim();
    var configuredRybbitScriptOrigin = (System.Environment.GetEnvironmentVariable("RYBBIT_CHUMMER_RUN_SCRIPT_ORIGIN") ?? "https://app.rybbit.io").Trim().TrimEnd('/');
    var rybbitAllowSameHostProxy = string.Equals(
        (System.Environment.GetEnvironmentVariable("RYBBIT_CHUMMER_RUN_ALLOW_SAME_HOST_PROXY") ?? string.Empty).Trim(),
        "true",
        StringComparison.OrdinalIgnoreCase);
    var rybbitScriptUrl = string.Empty;
    if (requestHost is "chummer.run" or "www.chummer.run")
    {
        if (rybbitAllowSameHostProxy
            && Uri.TryCreate(configuredRybbitScriptUrl, UriKind.Relative, out Uri? relativeRybbitScriptUrl)
            && !relativeRybbitScriptUrl.IsAbsoluteUri
            && configuredRybbitScriptUrl.StartsWith('/'))
        {
            rybbitScriptUrl = configuredRybbitScriptUrl;
        }
        else if (Uri.TryCreate(configuredRybbitScriptUrl, UriKind.Absolute, out Uri? parsedRybbitScriptUrl)
            && (parsedRybbitScriptUrl.Scheme == Uri.UriSchemeHttps || parsedRybbitScriptUrl.Scheme == Uri.UriSchemeHttp)
            && (rybbitAllowSameHostProxy || !string.Equals(parsedRybbitScriptUrl.Host.Trim().TrimEnd('.').ToLowerInvariant(), requestHost, StringComparison.Ordinal)))
        {
            rybbitScriptUrl = parsedRybbitScriptUrl.ToString();
        }
        else if (Uri.TryCreate(configuredRybbitScriptOrigin, UriKind.Absolute, out Uri? parsedRybbitOrigin)
            && (parsedRybbitOrigin.Scheme == Uri.UriSchemeHttps || parsedRybbitOrigin.Scheme == Uri.UriSchemeHttp)
            && (rybbitAllowSameHostProxy || !string.Equals(parsedRybbitOrigin.Host.Trim().TrimEnd('.').ToLowerInvariant(), requestHost, StringComparison.Ordinal)))
        {
            rybbitScriptUrl = $"{parsedRybbitOrigin.GetLeftPart(UriPartial.Authority).TrimEnd('/')}/api/script.js";
        }
    }
    var rybbitSiteId = requestHost is "chummer.run" or "www.chummer.run"
        ? (System.Environment.GetEnvironmentVariable("RYBBIT_CHUMMER_RUN_SITE_ID") ?? string.Empty).Trim()
        : string.Empty;
    var requestScheme = Context?.Request?.Scheme ?? "https";
    var requestHostValue = Context?.Request?.Host.Value ?? string.Empty;
    var resolvedRequestHost = requestHost is "chummer.run" or "www.chummer.run"
        ? "https://chummer.run"
        : string.IsNullOrWhiteSpace(requestHostValue)
            ? string.Empty
            : $"{requestScheme}://{requestHostValue}";
    var requestPathBase = Context?.Request?.PathBase.Value ?? string.Empty;
    var requestPath = Context?.Request?.Path.Value ?? string.Empty;
    var requestQuery = Context?.Request?.QueryString.Value ?? string.Empty;
    var normalizedRequestPath = string.IsNullOrWhiteSpace(requestPath) ? "/" : requestPath.TrimEnd('/');
    var requestPathSegments = normalizedRequestPath.AsSpan();
    var clickRankEligible = !authSurface
        && !chrome.Authenticated
        && !string.IsNullOrWhiteSpace(clickRankSiteId)
        && (
            routeKey is "landing" or "what-is-chummer" or "now" or "roadmap" or "downloads" or "participate" or "feedback" or "changelog" or "help" or "faq" or "contact" or "artifacts" or "status"
            || routeKey.StartsWith("artifacts-", StringComparison.Ordinal)
            || routeKey.StartsWith("roadmap-", StringComparison.Ordinal));
    var requestPathIsRoot = string.Equals(normalizedRequestPath, "/", StringComparison.Ordinal);
    var requestPathIndexable = requestPathIsRoot
        || normalizedRequestPath is "/now" or "/downloads" or "/status" or "/changelog" or "/what-is-chummer" or "/help" or "/faq" or "/contact" or "/privacy" or "/terms"
        || routeKey is "landing" or "what-is-chummer" or "now" or "downloads" or "changelog" || routeKey is "help" or "faq" || routeKey is "contact" or "privacy" or "terms" or "status"
        || routeKey is "roadmap" or "artifacts" || routeKey is "participate" or "feedback";
    var indexablePublicRoute = !authSurface
        && !chrome.Authenticated
        && requestPathIndexable;
    var rybbitEligible = !authSurface
        && !chrome.Authenticated
        && !string.IsNullOrWhiteSpace(rybbitSiteId)
        && !string.IsNullOrWhiteSpace(rybbitScriptUrl)
        && (
            routeKey is "landing" or "what-is-chummer" or "now" or "roadmap" or "downloads" or "participate" or "feedback" or "changelog" or "help" or "faq" or "contact" or "artifacts" or "status"
            || routeKey.StartsWith("artifacts-", StringComparison.Ordinal)
            || routeKey.StartsWith("roadmap-", StringComparison.Ordinal));
    var robotsPolicy = indexablePublicRoute
        ? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        : "noindex, nofollow, noarchive, nosnippet, noimageindex";
    var canonicalPath = string.Equals(normalizedRequestPath, "/", StringComparison.Ordinal)
        ? string.Empty
        : normalizedRequestPath;
    var canonicalUrl = string.Empty;
    var absoluteRequestUrl = string.IsNullOrWhiteSpace(resolvedRequestHost)
        ? string.Empty
        : $"{resolvedRequestHost}{requestPathBase}{(string.IsNullOrWhiteSpace(requestPath) ? "/" : requestPath)}{requestQuery}";
    if (indexablePublicRoute)
    {
        var canonicalHost = requestHost is "chummer.run" or "www.chummer.run" ? "https://chummer.run" : resolvedRequestHost;
        canonicalUrl = $"{canonicalHost}{canonicalPath}";
    }
    var socialUrl = string.IsNullOrWhiteSpace(canonicalUrl) ? absoluteRequestUrl : canonicalUrl;
    object? publicSchema = null;
    if (indexablePublicRoute)
    {
        if (routeKey is "landing" or "what-is-chummer" or "downloads")
        {
            var softwareApplicationOperatingSystem = (ViewData["SoftwareApplicationOperatingSystem"] as string)?.Trim();
            if (string.IsNullOrWhiteSpace(softwareApplicationOperatingSystem))
            {
                softwareApplicationOperatingSystem = "Linux";
            }

            publicSchema = new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "SoftwareApplication",
                ["name"] = "Chummer",
                ["operatingSystem"] = softwareApplicationOperatingSystem,
                ["applicationCategory"] = "GameApplication",
                ["url"] = canonicalUrl,
                ["description"] = chrome.Description
            };
        }
        else
        {
            publicSchema = new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "WebPage",
                ["name"] = pageTitle,
                ["url"] = canonicalUrl,
                ["description"] = chrome.Description
            };
        }
    }
}
<!doctype html>
<html lang="en" data-theme="hub-front-door">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle · Chummer</title>
    <meta name="description" content="@chrome.Description" />
    <meta name="theme-color" content="#0f1110" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Chummer" />
    <meta property="og:title" content="@pageTitle · Chummer" />
    <meta property="og:description" content="@chrome.Description" />
    @if (!string.IsNullOrWhiteSpace(socialUrl))
    {
        <meta property="og:url" content="@socialUrl" />
        <meta name="twitter:url" content="@socialUrl" />
    }
    <meta property="og:site_name" content="Chummer" />
    <meta property="og:image" content="/favicon.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle · Chummer" />
    <meta name="twitter:description" content="@chrome.Description" />
    <meta name="twitter:image" content="/favicon.svg" />
    <meta name="robots" content="@robotsPolicy" />
    <meta name="googlebot" content="@robotsPolicy" />
    @if (!string.IsNullOrWhiteSpace(canonicalUrl))
    {
        <link rel="canonical" href="@canonicalUrl" />
    }
    <link rel="manifest" href="~/manifest.json" asp-append-version="true" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
    @if (publicSchema is not null)
    {
        <script type="application/ld+json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(publicSchema))</script>
    }
    @if (rybbitEligible)
    {
        <script>
            (function () {
                var doNotTrack = window.doNotTrack === "1"
                    || navigator.doNotTrack === "1"
                    || navigator.msDoNotTrack === "1"
                    || navigator.globalPrivacyControl === true;
                if (doNotTrack || document.querySelector("script[data-rybbit='analytics']")) {
                    return;
                }

                var loadRybbit = function () {
                    if (document.querySelector("script[data-rybbit='analytics']")) {
                        return;
                    }

                    var rybbit = document.createElement("script");
                    rybbit.src = "@rybbitScriptUrl";
                    rybbit.async = true;
                    rybbit.dataset.siteId = "@rybbitSiteId";
                    rybbit.dataset.rybbit = "analytics";
                    rybbit.dataset.tag = "hub_public_shell";
                    rybbit.dataset.skipPatterns = '["/account/**","/downloads/file/**","/downloads/files/**","/downloads/get/**","/downloads/install/**","/downloads/release-upload/**","/ledger/newsroom/**","/login","/signup"]';
                    rybbit.referrerPolicy = "strict-origin-when-cross-origin";
                    document.head.appendChild(rybbit);
                };

                if ("requestIdleCallback" in window) {
                    window.requestIdleCallback(loadRybbit, { timeout: 1500 });
                    return;
                }

                window.setTimeout(loadRybbit, 250);
            })();
        </script>
    }
    @if (clickRankEligible)
    {
        <script>
            (function () {
                var doNotTrack = window.doNotTrack === "1"
                    || navigator.doNotTrack === "1"
                    || navigator.msDoNotTrack === "1"
                    || navigator.globalPrivacyControl === true;
                if (doNotTrack || document.querySelector("script[data-clickrank='seo']")) {
                    return;
                }

                var loadClickRank = function () {
                    if (document.querySelector("script[data-clickrank='seo']")) {
                        return;
                    }

                    var clickRankScript = document.createElement("script");
                    clickRankScript.src = "https://js.clickrank.ai/seo/@clickRankSiteId/script";
                    clickRankScript.async = true;
                    clickRankScript.defer = true;
                    clickRankScript.dataset.clickrank = "seo";
                    clickRankScript.referrerPolicy = "strict-origin-when-cross-origin";
                    document.head.appendChild(clickRankScript);
                };

                if ("requestIdleCallback" in window) {
                    window.requestIdleCallback(loadClickRank, { timeout: 1500 });
                    return;
                }

                window.setTimeout(loadClickRank, 250);
            })();
        </script>
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (authSurface && minimalSurface)
    {
        <link rel="stylesheet" href="~/css/auth-compact.css" asp-append-version="true" />
    }
</head>
<body class="@bodyClass" data-route-key="@routeKey" data-surface-class="@surfaceClass">
    <a class="skip-link" href="#main">Skip to content</a>
    @if (authSurface)
    {
        if (!hideAuthChrome)
        {
            <header class="@headerClass" data-site-header>
                <div class="site-header__inner site-header__inner--auth">
                    <a class="site-brand" href="/" aria-label="Chummer home">
                        <span class="site-brand__wordmark">CHUMMER</span>
                        <span class="site-brand__surface">Shadowrun character manager</span>
                    </a>
                    @if (!minimalSurface)
                    {
                        <nav class="site-nav" aria-label="Primary navigation">
                            @foreach (var link in primarySiteLinks)
                            {
                                var current = isContextualRouteCurrent(link.Href);
                                if (current)
                                {
                                    <span class="site-nav__current">@link.Label</span>
                                }
                                else
                                {
                                    <a href="@link.Href">@link.Label</a>
                                }
                            }
                        </nav>
                        <div class="site-actions site-actions--quiet">
                            @if (chrome.Authenticated)
                            {
                                <a class="site-actions__link" href="/help">Help</a>
                                <details class="site-account-menu">
                                    <summary class="site-account-menu__summary">
                                        <span class="site-account-menu__label">Account</span>
                                    </summary>
                                    <div class="site-account-menu__panel">
                                        @if (!string.IsNullOrWhiteSpace(chrome.SignedInLabel))
                                        {
                                            <p class="site-account-menu__meta">@chrome.SignedInLabel</p>
                                        }
                                        @if (accountMenuBuildAction is not null)
                                        {
                                            <a class="site-account-menu__link" href="@accountMenuBuildAction.Href">@accountMenuBuildAction.Label</a>
                                        }
                                        @foreach (var action in accountMenuActions)
                                        {
                                            if (string.Equals(action.Label, "Open Chummer", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <details class="site-account-menu site-open-chummer-menu">
                                                    <summary class="site-account-menu__summary">
                                                        <span class="site-account-menu__label">@action.Label</span>
                                                    </summary>
                                                    <div class="site-account-menu__panel">
                                                        <a class="site-open-chummer-menu__button site-account-menu__button" href="@action.Href">@launcherDesktopLabel</a>
                                                        <a class="site-open-chummer-menu__button site-account-menu__button" href="/mobile">@launcherWebLabel</a>
                                                    </div>
                                                </details>
                                            }
                                            else
                                            {
                                                var renderedActionLabel = action.Label;
                                                if (string.Equals(action.Href, "/logout", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <form method="post" action="/logout" class="site-account-menu__form">
                                                        @Html.AntiForgeryToken()
                                                        <button class="site-account-menu__button" type="submit">@renderedActionLabel</button>
                                                    </form>
                                                }
                                                else if (action.Current)
                                                {
                                                    <span class="site-account-menu__current">@renderedActionLabel</span>
                                                }
                                                else
                                                {
                                                    <a class="site-account-menu__link" href="@action.Href">@renderedActionLabel</a>
                                                }
                                            }
                                        }
                                    </div>
                                </details>
                            }
                            else
                            {
                                @foreach (var action in visibleHeaderActions)
                                {
                                    if (string.Equals(action.Label, "Open Chummer", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <details class="site-account-menu site-open-chummer-menu">
                                            <summary class="site-account-menu__summary">
                                                <span class="site-account-menu__label">@action.Label</span>
                                            </summary>
                                            <div class="site-account-menu__panel">
                                                <a class="site-open-chummer-menu__button site-account-menu__button" href="@action.Href">@launcherDesktopLabel</a>
                                                <a class="site-open-chummer-menu__button site-account-menu__button" href="/mobile">@launcherWebLabel</a>
                                            </div>
                                        </details>
                                    }
                                    else
                                    {
                                        var renderedActionLabel = action.Label;
                                        if (string.Equals(action.Href, "/logout", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <form method="post" action="/logout" class="action-form">
                                                @Html.AntiForgeryToken()
                                                <button class="action-pill action-pill--@action.Tone" type="submit">@renderedActionLabel</button>
                                            </form>
                                        }
                                        else if (action.Current)
                                        {
                                            <span class="action-pill action-pill--current">@renderedActionLabel</span>
                                        }
                                        else
                                        {
                                            var actionClass = string.Equals(action.Tone, "link", StringComparison.OrdinalIgnoreCase)
                                                ? "site-actions__link"
                                                : $"action-pill action-pill--{action.Tone}";
                                            <a class="@actionClass" href="@action.Href">@renderedActionLabel</a>
                                        }
                                    }
                                }
                            }
                        </div>
                    }
                </div>
            </header>
        }
    }
    else
    {
        <header class="@headerClass" data-site-header>
            <div class="site-header__inner">
                <a class="site-brand" href="/" aria-label="Chummer home">
                    <span class="site-brand__wordmark">CHUMMER</span>
                    <span class="site-brand__surface">Shadowrun character manager</span>
                </a>
                @if (showPrimaryNavInHeader)
                {
                    <nav class="site-nav" aria-label="Primary navigation">
                        @foreach (var link in primarySiteLinks)
                        {
                            var current = isContextualRouteCurrent(link.Href);
                            if (current)
                            {
                                <span class="site-nav__current">@link.Label</span>
                            }
                            else
                            {
                                <a href="@link.Href">@link.Label</a>
                            }
                        }
                    </nav>
                }
                <div class="site-actions">
                    @if (chrome.Authenticated)
                    {
                        <details class="site-account-menu">
                            <summary class="site-account-menu__summary">
                                <span class="site-account-menu__label">Account</span>
                            </summary>
                            <div class="site-account-menu__panel">
                                @if (!string.IsNullOrWhiteSpace(chrome.SignedInLabel))
                                {
                                    <p class="site-account-menu__meta">@chrome.SignedInLabel</p>
                                }
                                        @if (accountMenuBuildAction is not null)
                                        {
                                            <a class="site-account-menu__link" href="@accountMenuBuildAction.Href">@accountMenuBuildAction.Label</a>
                                        }
                                        @foreach (var action in accountMenuActions)
                                        {
                                            if (string.Equals(action.Label, "Open Chummer", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <details class="site-account-menu site-open-chummer-menu">
                                                    <summary class="site-account-menu__summary">
                                                        <span class="site-account-menu__label">@action.Label</span>
                                                    </summary>
                                                    <div class="site-account-menu__panel">
                                                        <a class="site-open-chummer-menu__button site-account-menu__button" href="@action.Href">@launcherDesktopLabel</a>
                                                        <a class="site-open-chummer-menu__button site-account-menu__button" href="/mobile">@launcherWebLabel</a>
                                                    </div>
                                                </details>
                                            }
                                            else
                                            {
                                                var renderedActionLabel = action.Label;
                                                if (string.Equals(action.Href, "/logout", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <form method="post" action="/logout" class="site-account-menu__form">
                                                        @Html.AntiForgeryToken()
                                                        <button class="site-account-menu__button" type="submit">@renderedActionLabel</button>
                                                    </form>
                                                }
                                                else if (action.Current)
                                                {
                                                    <span class="site-account-menu__current">@renderedActionLabel</span>
                                                }
                                                else
                                                {
                                                    <a class="site-account-menu__link" href="@action.Href">@renderedActionLabel</a>
                                                }
                                            }
                                        }
                                    </div>
                                </details>
                    }
                    else
                    {
                        @foreach (var action in visibleHeaderActions)
                        {
                            if (string.Equals(action.Label, "Open Chummer", StringComparison.OrdinalIgnoreCase))
                            {
                                <details class="site-account-menu site-open-chummer-menu">
                                    <summary class="site-account-menu__summary">
                                        <span class="site-account-menu__label">@action.Label</span>
                                    </summary>
                                    <div class="site-account-menu__panel">
                                        <a class="site-open-chummer-menu__button site-account-menu__button" href="@action.Href">@launcherDesktopLabel</a>
                                        <a class="site-open-chummer-menu__button site-account-menu__button" href="/mobile">@launcherWebLabel</a>
                                    </div>
                                </details>
                            }
                            else
                            {
                                var renderedActionLabel = routeKey is "landing"
                                    && normalizeHeaderActionPath(action.Href).StartsWith("/downloads", StringComparison.OrdinalIgnoreCase)
                                    ? "Download"
                                    : action.Label;
                                if (string.Equals(action.Href, "/logout", StringComparison.OrdinalIgnoreCase))
                                {
                                    <form method="post" action="/logout" class="action-form">
                                        @Html.AntiForgeryToken()
                                        <button class="action-pill action-pill--@action.Tone" type="submit">@renderedActionLabel</button>
                                    </form>
                                }
                                else if (action.Current)
                                {
                                    <span class="action-pill action-pill--current">@renderedActionLabel</span>
                                }
                                else
                                {
                                    var actionClass = string.Equals(action.Tone, "link", StringComparison.OrdinalIgnoreCase)
                                        ? "site-actions__link"
                                        : $"action-pill action-pill--{action.Tone}";
                                    <a class="@actionClass" href="@action.Href">@renderedActionLabel</a>
                                }
                            }
                        }
                    }
                </div>
            </div>
        </header>
    }

    @if (contextSidebarLinks.Count > 0 && !string.IsNullOrWhiteSpace(contextSidebarHeading))
    {
        <div class="site-context-nav" aria-label="@contextSidebarHeading">
            <div class="site-context-nav__inner">
                <span class="site-context-nav__heading">@contextSidebarHeading</span>
                <nav class="site-context-nav__links" aria-label="@contextSidebarHeading">
                    @foreach (var link in contextSidebarLinks)
                    {
                        var current = isContextualRouteCurrent(link.Href);
                        if (current)
                        {
                            <span class="site-context-nav__current">@link.Label</span>
                        }
                        else
                        {
                            <a href="@link.Href">@link.Label</a>
                        }
                    }
                </nav>
            </div>
        </div>
    }

    <main id="main" class="site-main">
        @RenderBody()
    </main>

    @if (!authSurface)
    {
        <footer class="site-footer @(compactFooter ? "site-footer--compact" : string.Empty)">
            <div class="site-footer__inner">
                <div class="site-footer__brand">
                    <a class="site-footer__wordmark" href="/">CHUMMER</a>
                    <p class="site-footer__copy">Shadowrun character manager.</p>
                </div>
                <nav class="site-footer__nav" aria-label="Footer navigation">
                    <div class="site-footer__link-group">
                        <p class="site-footer__heading sr-only">Links</p>
                        <div class="site-footer__links">
                            @foreach (var link in footerLinks)
                            {
                                var current = publicSignalLinks.Contains(link)
                                    ? isPublicSignalCurrent(link.Href)
                                    : isContextualRouteCurrent(link.Href);
                                if (current)
                                {
                                    <span class="site-footer__current">@link.Label</span>
                                }
                                else
                                {
                                    <a href="@link.Href">@link.Label</a>
                                }
                            }
                        </div>
                    </div>
                </nav>
                <div class="site-footer__meta">
                    @if (utilityLink is not null && !Uri.TryCreate(utilityLink.Href, UriKind.Absolute, out _))
                    {
                        <p><a class="quiet-link" href="@utilityLink.Href">@utilityLink.Label</a></p>
                    }
                </div>
            </div>
        </footer>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            if (!("serviceWorker" in navigator)) {
                return;
            }

            window.addEventListener("load", function () {
                navigator.serviceWorker.register("/service-worker.js", { scope: "/" }).catch(function () {
                });
            });
        })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>

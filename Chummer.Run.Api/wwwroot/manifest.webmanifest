{
  "name": "Chummer Turn Companion",
  "short_name": "Chummer Play",
  "id": "/mobile",
  "description": "Mobile play companion for Shadowrun sessions: track continuity, heat, roles, reconnects, and safe Black Ledger updates.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/mobile/player",
  "scope": "/mobile/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#0f1b26",
  "theme_color": "#0f1b26",
  "categories": [
    "games",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/pwa-screenshot-mobile.svg",
      "sizes": "1179x2556",
      "type": "image/svg+xml",
      "form_factor": "narrow",
      "label": "Mobile continuity dashboard with role entry, install status, and session return cues."
    },
    {
      "src": "/pwa-screenshot-wide.svg",
      "sizes": "1512x982",
      "type": "image/svg+xml",
      "form_factor": "wide",
      "label": "Tablet and desktop view with player, GM, and observer entry in one mobile workspace."
    }
  ],
  "shortcuts": [
    {
      "name": "Player Companion",
      "short_name": "Player",
      "description": "Open the public player install shell.",
      "url": "/mobile/player"
    },
    {
      "name": "GM Companion",
      "short_name": "GM",
      "description": "Open the public GM install shell. This shortcut grants no GM authority.",
      "url": "/mobile/gm"
    },
    {
      "name": "Observer Companion",
      "short_name": "Observer",
      "description": "Open the public observer install shell. This shortcut grants no table access.",
      "url": "/mobile/observer"
    }
  ]
}

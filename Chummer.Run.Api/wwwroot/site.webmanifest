{
  "name": "Chummer",
  "short_name": "Chummer",
  "id": "/mobile",
  "description": "Mobile play companion for Shadowrun sessions: track continuity, heat, roles, reconnects, and safe Black Ledger updates.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/mobile",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#0f1110",
  "theme_color": "#0f1110",
  "categories": [
    "games",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/pwa-icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/pwa-screenshot-mobile.svg",
      "sizes": "1179x2556",
      "type": "image/svg+xml",
      "form_factor": "narrow",
      "label": "Mobile continuity dashboard with role entry, install status, and session return cues."
    },
    {
      "src": "/pwa-screenshot-wide.svg",
      "sizes": "1512x982",
      "type": "image/svg+xml",
      "form_factor": "wide",
      "label": "Tablet and desktop view with player, GM, and observer entry in one mobile workspace."
    }
  ],
  "shortcuts": [
    {
      "name": "Open mobile workspace",
      "short_name": "Mobile",
      "url": "/mobile"
    },
    {
      "name": "Open play",
      "short_name": "Play",
      "url": "/play"
    },
    {
      "name": "Open continuity",
      "short_name": "Continuity",
      "url": "/play/continuity"
    },
    {
      "name": "Open packages",
      "short_name": "Packages",
      "url": "/packages"
    }
  ]
}

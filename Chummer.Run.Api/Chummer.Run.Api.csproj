<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RunBrowserSurfaceProxyTimeoutApiOnly Condition="'$(RunBrowserSurfaceProxyTimeoutApiOnly)' == ''">false</RunBrowserSurfaceProxyTimeoutApiOnly>
    <EnableDefaultCompileItems Condition="'$(RunBrowserSurfaceProxyTimeoutApiOnly)' == 'true'">false</EnableDefaultCompileItems>
    <OutputType Condition="'$(RunBrowserSurfaceProxyTimeoutApiOnly)' == 'true'">Library</OutputType>
    <AddRazorSupportForMvc Condition="'$(RunBrowserSurfaceProxyTimeoutApiOnly)' == 'true'">false</AddRazorSupportForMvc>
    <EnableDefaultRazorGenerateItems Condition="'$(RunBrowserSurfaceProxyTimeoutApiOnly)' == 'true'">false</EnableDefaultRazorGenerateItems>
    <RazorCompileOnBuild Condition="'$(RunBrowserSurfaceProxyTimeoutApiOnly)' == 'true'">false</RazorCompileOnBuild>
    <RazorCompileOnPublish Condition="'$(RunBrowserSurfaceProxyTimeoutApiOnly)' == 'true'">false</RazorCompileOnPublish>
    <RestorePackagesWithLockFile Condition="'$(ChummerUseLocalCompatibilityTree)' != 'true'">true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ChummerUseLocalCompatibilityTree)' != 'true' and '$(RestoreLockedMode)' == ''">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup Condition="'$(RunBrowserSurfaceProxyTimeoutApiOnly)' != 'true' and '$(ChummerUseLocalCompatibilityTree)' == 'true'">
    <ProjectReference Include="..\..\chummer-core-engine\Chummer.Contracts\Chummer.Contracts.csproj" />
    <ProjectReference Include="..\..\chummer-hub-registry\Chummer.Hub.Registry.Contracts\Chummer.Hub.Registry.Contracts.csproj" />
    <ProjectReference Include="..\..\chummer-hub-registry\Chummer.Run.Registry\Chummer.Run.Registry.csproj">
      <ExcludeAssets>contentFiles</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="'$(RunBrowserSurfaceProxyTimeoutApiOnly)' != 'true' and '$(ChummerUseLocalCompatibilityTree)' != 'true'">
    <PackageReference Include="Chummer.Engine.Contracts" Version="$(ChummerPackagePlaneVersion)" />
    <PackageReference Include="Chummer.Hub.Registry.Contracts" Version="$(ChummerPackagePlaneVersion)" />
    <PackageReference Include="Chummer.Run.Registry" Version="$(ChummerPackagePlaneVersion)">
      <ExcludeAssets>contentFiles</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(RunBrowserSurfaceProxyTimeoutApiOnly)' != 'true'">
    <ProjectReference Include="..\Chummer.Campaign.Contracts\Chummer.Campaign.Contracts.csproj" />
    <ProjectReference Include="..\Chummer.Control.Contracts\Chummer.Control.Contracts.csproj" />
    <ProjectReference Include="..\Chummer.Run.Contracts\Chummer.Run.Contracts.csproj" />
    <ProjectReference Include="..\Chummer.World.Contracts\Chummer.World.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(RunBrowserSurfaceProxyTimeoutApiOnly)' != 'true'">
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(RunBrowserSurfaceProxyTimeoutApiOnly)' != 'true'">
    <EmbeddedResource Include="Services/Community/Postgres/Migrations/*.sql" />
    <EmbeddedResource Include="Services/InstallLinking/Postgres/Migrations/*.sql" />
  </ItemGroup>

  <ItemGroup Condition="'$(RunBrowserSurfaceProxyTimeoutApiOnly)' != 'true'">
    <Content Remove="wwwroot\**\*.audio-rebuild.tmp.*" />
    <None Include="wwwroot\**\*.audio-rebuild.tmp.*" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(RunBrowserSurfaceProxyTimeoutApiOnly)' == 'true'">
    <Compile Include="Controllers\LegacySurfaceRedirectController.cs" />
    <Compile Include="HubApiGuardrailOptions.cs" />
    <Compile Include="HubApiGuardrailPolicy.cs" />
    <Compile Include="HubApiRateLimiterFactory.cs" />
    <Compile Include="HubApiRequestGuardrailMiddleware.cs" />
    <Compile Include="HubApiRuntimeGuardrailExtensions.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Services\IPublicPlaySessionAccessPolicy.cs" />
    <Compile Include="Services\PublicCanonicalOriginPolicy.cs" />
    <Compile Include="Services\PublicPlayPrivateRouteDelegator.cs" />
    <Compile Include="Services\PublicPlayProxyGateway.cs" />
    <Compile Include="Services\PublicProxyRedirectPolicy.cs" />
    <Compile Include="Services\PublicPlayUpstreamNetworkPolicy.cs" />
  </ItemGroup>
</Project>

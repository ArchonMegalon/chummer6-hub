@Chummer.Run.Api_HostAddress = http://localhost:0

GET {{Chummer.Run.Api_HostAddress}}/
Accept: text/html

###

GET {{Chummer.Run.Api_HostAddress}}/login?next=/home
Accept: text/html

###

GET {{Chummer.Run.Api_HostAddress}}/status
Accept: text/html

###

GET {{Chummer.Run.Api_HostAddress}}/participate
Accept: text/html

###

GET {{Chummer.Run.Api_HostAddress}}/v1/models
Authorization: Bearer {{$processEnv ANSWERLY_OPENAI_COMPAT_API_TOKEN}}
Accept: application/json

###

GET {{Chummer.Run.Api_HostAddress}}/api/v1/models
Authorization: Bearer {{$processEnv ANSWERLY_OPENAI_COMPAT_API_TOKEN}}
Accept: application/json

###

POST {{Chummer.Run.Api_HostAddress}}/v1/chat/completions
Authorization: Bearer {{$processEnv ANSWERLY_OPENAI_COMPAT_API_TOKEN}}
Content-Type: application/json

{
  "model": "answerly-support-assistant",
  "messages": [
    {
      "role": "user",
      "content": "How do I install the Windows desktop build?"
    }
  ]
}


<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.3" />
    <ProjectReference Include="../../Chummer.Run.Api/Chummer.Run.Api.csproj" />
  </ItemGroup>
  <Target Name="RequirePackagedHost" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ChummerUseLocalCompatibilityTree)' != 'false'" Text="Registry host integration requires the packaged Hub, not compatibility source references." />
  </Target>
</Project>
